// Freestanding (--no-libc) lowering probe: every barrier, cache, TLB and
// pipeline-hint intrinsic, plus this architecture's system registers.
// Compiled to an object (so the inline asm is assembled), not run.
func probe(_ buf: Span[UInt8], _ z: MutSpan[UInt8]) using Asm, RawMemory {
    memoryBarrier(.full, .loadLoad)
    memoryBarrier(.inner, .storeStore)
    memoryBarrier(.outer, .loadStore)
    memoryBarrier(.nonShareable, .full)
    syncBarrier(.full)
    syncBarrier(.inner)
    syncBarrier(.outer)
    syncBarrier(.nonShareable)
    instructionBarrier()
    waitForInterrupt()
    relax()
    nop()
    compilerFence(.acqRel)
    cleanData(buf)
    invalidateData(buf)
    cleanInvalidateData(buf)
    zeroData(z)
    publishInstructions(buf)
    invalidateAllInstructions()
    tlbInvalidateAll(.currentEL)
    tlbInvalidateAll(.innerShareable)
    tlbInvalidatePage(0x1000, false, .currentEL)
    tlbInvalidateAsid(3, .currentEL)
}
func x86(_ v: UInt64) using Asm -> UInt64 {
    Sysreg.ia32_efer.write(v)
    Sysreg.ia32_fs_base.write(v)
    Sysreg.ia32_kernel_gs_base.write(v)
    return Sysreg.ia32_lstar.read() + Sysreg.ia32_tsc_aux.read()
}
// §14.14 a fresh task and a swap into it.
@noinit static mainTask: Context
@noinit static workerTask: Context
@noinit static workerStack: [512]UInt64
func worker() using Asm, RawMemory -> Never {
    let me: MutPtr[Context] = MutPtr.unchecked(fromAddress: (&workerTask).address)
    let main: Ptr[Context] = &mainTask
    Scheduler.swapContext(saving: me, loading: main)
    while true { }
}
func startWorker() using Asm, RawMemory {
    // A static holds an immutable value (§4): write the storage through its
    // address (Annex §4.5).
    let w: MutPtr[Context] = MutPtr.unchecked(fromAddress: (&workerTask).address)
    w.value = Context.start(entry: worker, stack: (&workerStack).address + 4096)
    let m: MutPtr[Context] = MutPtr.unchecked(fromAddress: (&mainTask).address)
    Scheduler.swapContext(saving: m, loading: w)
}
