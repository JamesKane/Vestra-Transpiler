// §6 a deinit type's special members (live flag, positional constructor,
// moves) compile freestanding.
static tally: Atomic[Int32] = 0

struct Guard {
    var id: Int32
    deinit {
        let prev = tally.fetchAdd(self.id, .relaxed)
    }
}

func scoped(_ i: Int32) -> Int32 {
    let g = Guard(id: i)
    let h = g
    var k = Guard(id: 2)
    k = Guard(id: 3)
    return h.id + k.id
}
