fn isEven(x) = mod(x, 2) == 0;
fn fizzbuzz(n) = if mod(n, 15) == 0 then "FizzBuzz" else if mod(n, 3) == 0 then "Fizz" else if mod(n, 5) == 0 then "Buzz" else toStr(n);
print "abs neg:", abs(0 - 7);
print "abs pos:", abs(5);
print "mod:", mod(17, 5);
print "mod0:", mod(10, 0);
print "evens:", join(filterList(range(10), "isEven"), ",");
nums = listNew();
i = 1;
while i < 16 do { nums = push(nums, i); i = i + 1 };
print "fizzbuzz:", join(mapList(nums, "fizzbuzz"), " ");
print "done"
