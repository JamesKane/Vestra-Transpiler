// §12.4 `$(f.type)` splices a field type whole: `[4]Int32` and `Int32?` used to
// make the per-field quote vanish from the expansion.

comptime func getters(_ d: Decl) -> [Decl] {
    var out: [Decl] = quote { $d }
    for f in d.fields {
        out += quote {
            func $(f.name + "_of")(_ v: $(d.name)) -> $(f.type) { return copy v.$(f.name) }
        }
    }
    return out
}

@getters
struct S {
    var a: Int32
    var b: [4]Int32
    var c: Int32?
}

func main() -> Int32 { return 0 }
