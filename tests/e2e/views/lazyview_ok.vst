// §10 a lazy iterator over owned values escapes freely, and one over a view
// is fine where the view is: consumed in place, or captured only by a
// closure that runs before the call returns.

struct Counter {
    var n: Int32
    inout func next() -> Int32? {
        if self.n <= 0 { return nil }
        let v = self.n
        self.n = self.n - 1
        return v
    }
}

func run(_ f: () -> Int32) -> Int32 { return f() }

func plain(_ k: Int32) -> () -> Int32 {
    var c = Counter(n: 3)
    var it = map(c, { x => x + k })
    return { => if let v = it.next() { v } else { 0 } }
}

func inPlace() using Alloc -> Int32 {
    let text: String = "a b c"
    let parts: Vec[Str] = text.split(" ")
    var total: Int32 = 0
    var c = Counter(n: 3)
    for v in map(c, { x => x + parts.len().toWrapping[Int32]() }) {
        total = total + v
    }
    return total
}

func main() -> Int32 { return 0 }
