// §11.4 a view held across an `await`.
async func tick() -> Int32 { return 1 }
func len(_ s: Span[Int32]) -> Int32 { return 1 }
async func after(_ s: Span[Int32]) -> Int32 {
    let t = await tick()
    return len(s) + t
}
async func local() -> Int32 {
    let a: [4]Int32 = [1, 2, 3, 4]
    let v: Span[Int32] = a
    let t = await tick()
    return len(v) + t
}
