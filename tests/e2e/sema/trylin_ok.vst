// §19.6 a `try` with no linear value live: nothing leaks if it throws.
linear struct H {
    let id: Int32
}
enum No {
    case bad
}
func close(_ h: sink H) { }
func mk() -> H { return H(id: 1) }
func mayfail() throws(No) -> Int32 { return 1 }
func mkOr() throws(No) -> H { return H(id: 2) }
func fine() throws(No) {
    let x = try mayfail()
    let h = H(id: 1)
    close(h)
}
