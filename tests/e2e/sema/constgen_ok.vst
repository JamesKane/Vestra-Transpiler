// §7 a const generic `N` is a value of its declared type (an `Int` by
// default) in the body: returned, compared, and used in arithmetic.
func count[const N: Int](_ a: [N]Int32) -> Int {
    return N
}

func sum[const N: Int](_ a: [N]Int32) -> Int32 {
    var s: Int32 = 0
    var i: Int = 0
    while i < N {
        s = s + a[i]
        i = i + 1
    }
    return s
}

func main() -> Int32 {
    let a: [4]Int32 = [1, 2, 3, 4]
    return sum(a) + count(a).toWrapping[Int32]()
}
