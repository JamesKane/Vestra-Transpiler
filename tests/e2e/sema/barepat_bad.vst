// §17.6 a bare name in a match pattern matches an existing value; it used to
// bind a fresh name instead, so the arm always matched.

enum Key { case down(Int32)  case up(Int32)  case none }

func code(_ k: Key) -> Int32 {
    return match k {
        case .down(n) | .up(n): n
        case .none: 0
    }
}

func pick(_ v: Int32, _ limit: Int32) -> Int32 {
    return match v {
        case limit: 1
        default: 0
    }
}

func main() -> Int32 { return 0 }
