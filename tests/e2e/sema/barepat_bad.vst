// §17.6 a bare name in a match pattern matches an existing value; it used to
// bind a fresh name instead, so the arm always matched. A user enum's payload
// doesn't test sub-patterns yet, so a bare name there is still rejected, and
// one that names nothing in scope is an error.

enum Key { case down(Int32)  case up(Int32)  case none }

func code(_ k: Key) -> Int32 {
    return match k {
        case .down(n) | .up(n): n
        case .none: 0
    }
}

func pick(_ v: Int32, _ limit: Int32) -> Int32 {
    return match v {
        case limt: 1
        default: 0
    }
}

enum Dir { case north  case south }

func near(_ d: Dir, _ cur: Dir) -> Int32 {
    return match d {
        case cur: 1
        case .north: 2
    }
}

func main() -> Int32 { return 0 }
