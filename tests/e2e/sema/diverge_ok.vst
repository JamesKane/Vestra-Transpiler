// Bodies that return on every path, or can't complete (F9, F22).
func a(_ x: Int32) -> Int32 {
    if x > 0 { return 1 } else { return 2 }
}
func b(_ x: Int32) -> Int32 {
    while true {
        if x > 0 { return x }
    }
}
func c() -> Never {
    panic("stop")
}
func d() -> Never {
    while true { }
}
func ee(_ x: Int32) -> Int32 {
    if x > 0 { return 1 }
    return 0
}
func f(_ x: Int32) -> Int32 { x + 1 }
func g(_ x: Bool) -> Int32 {
    if x { panic("no") }
    return 3
}
enum K {
    case p
    case q
}
func h(_ k: K) -> Int32 {
    match k {
        case .p: { return 1 }
        case .q: { return 2 }
    }
}
@naked
func n() -> Never {
}
