// A number literal fits any integer type it is expected as, including inside
// (nested) array literals; a fixed array is indexable.
func f(_ k: UInt8) -> UInt8 {
    let a: [3]UInt8 = [1, 2, 3]
    let g: [2][3]UInt8 = [[1, 2, 3], [4, 5, 6]]
    let x: UInt8 = g[1][2]
    var y: UInt16 = 7
    y = 9
    let z: Float64 = 1.5
    return a[0] + x + k
}
