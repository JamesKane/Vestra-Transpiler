m1 = mapNew();
m1 = put(m1, "a", 1);
m1 = put(m1, "b", 2);
m2 = mapNew();
m2 = put(m2, "b", 20);
m2 = put(m2, "c", 30);
m = merge(m1, m2);
print "a:", get(m, "a");
print "b:", get(m, "b");
print "c:", get(m, "c");
print "nkeys:", len(keys(m));
print "m1 b:", get(m1, "b");
print "sorted:", join(sort(keys(m)), ",");
print "total:", sum(values(m));
print "empty merge:", len(keys(merge(m1, mapNew())));
print "done"
