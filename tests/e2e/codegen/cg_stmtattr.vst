// Annex §14.9.3 `@allow_weak_cas` and §14.12.3 `@no_auto_barrier` on a
// statement. The first admits the weak CAS sites of the statement after it
// (the audit-visible escape); the second, inside `@kernel_init`, drops the
// auto-emitted post-write barrier from that statement's sysreg writes only.

static a: Atomic[UInt32] = 0

func once() -> Bool {
    @allow_weak_cas
    let r = a.compareExchangeWeak(0, 1, .seqCst, .acquire)
    return r.succeeded
}

@kernel_init
func bringUp(_ ttbr: UInt64, _ sctlr: UInt64) using Asm {
    @no_auto_barrier
    Sysreg.ttbr0_el1.write(ttbr)
    Sysreg.sctlr_el1.write(sctlr)
}

func main() -> Int32 { return 0 }
