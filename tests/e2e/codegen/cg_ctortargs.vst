// §7 construction may name a generic type's arguments in brackets: a type
// for a type parameter, an integer (or a const that folds to one) for a const
// parameter. The binding needs no annotation.

const LEN: Int = 3

struct Buf[const N: Int] {
    var data: [N]UInt8
    func size() -> Int { return N }
}

struct Cell[T] {
    var v: T
}

func main() using Log, Alloc -> Int32 {
    let b = Buf[4](data: [1, 2, 3, 4])
    let k = Buf[LEN](data: [5, 6, 7])
    let c = Cell[Int32](v: 7)
    print("\(b.size()) \(k.size()) \(c.v)")
    return 0
}
