// §14.9.3 `repeat { B } while C` runs B before the first test of C, and is
// the third admitted weak-CAS retry-loop shape. It lowers to C++'s do-while,
// whose `continue` jumps to the test as Vestra's does.

static a: Atomic[UInt32] = 5

func bump() -> UInt32 {
    var r = a.compareExchange(0, 0, .seqCst, .acquire)
    repeat {
        r = a.compareExchangeWeak(r.actual, r.actual + 1, .seqCst, .acquire)
    } while !r.succeeded
    return a.load(.seqCst)
}

func main() using Log, Alloc -> Int32 {
    var n: Int32 = 0
    repeat {
        n = n + 1
    } while false
    var i: Int32 = 0
    var odd: Int32 = 0
    repeat {
        i = i + 1
        if i % 2 == 0 { continue }
        odd = odd + 1
    } while i < 7
    var k: Int32 = 0
    repeat {
        k = k + 1
        if k == 3 { break }
    } while true
    print("n=\(n) i=\(i) odd=\(odd) k=\(k) cas=\(bump())")
    return 0
}
