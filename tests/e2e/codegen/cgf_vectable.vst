// §14.5.3 a compiler-emitted vector table and the link-time panic hook,
// lowered under --no-libc (the selfhost differential runs vgen --no-libc).
module trap

@repr(C)
public struct Frame {
    var x: [31]UInt64
    var sp: UInt64
    var elr: UInt64
    var spsr: UInt64
    var esr: UInt64
    var far: UInt64
    var vector: UInt64
}


@interrupt
func onAny(_ f: inout Frame) {
    f.elr = f.elr + 4
}

@section(".text.vectors") @align(2048)
public static table: [4]@interrupt(Frame) = [onAny, onAny, onAny, onAny]

public func vbar() -> UInt64 {
    return (&table).address
}

@panic_handler
func onPanic(_ message: Str, _ file: StrConst, _ line: Int) -> Never {
    while true { }
}

// §14.14 a fresh task's context, switched to with Scheduler.swapContext.
@noinit static bootCtx: Context
@noinit static pingCtx: Context
@align(16) @noinit static pingStack: [64]UInt64

func ping() using Asm, RawMemory -> Never {
    let me: MutPtr[Context] = MutPtr.unchecked(fromAddress: (&pingCtx).address)
    let boot: Ptr[Context] = &bootCtx
    while true {
        Scheduler.swapContext(saving: me, loading: boot)
    }
}

public func startPing() using Asm, RawMemory {
    let c: MutPtr[Context] = MutPtr.unchecked(fromAddress: (&pingCtx).address)
    c.value = Context.start(entry: ping, stack: (&pingStack).address + 512)
    let boot: MutPtr[Context] = MutPtr.unchecked(fromAddress: (&bootCtx).address)
    Scheduler.swapContext(saving: boot, loading: c)
}
