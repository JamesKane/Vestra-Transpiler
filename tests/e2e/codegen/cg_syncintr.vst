// §A5 (§14.10) the sync, cache and TLB intrinsics lower to their __vstr
// runtime shims, `nop` to `cpu_nop`. Each argument takes its builtin
// parameter type, so a leading-dot `Ordering` becomes a std::memory_order
// literal and a `BarrierScope` / `BarrierKind` / `TlbScope` case a scoped
// enumerator; spans, addresses and flags pass through.
static gate: Atomic[UInt32] = 0

func publish(_ v: UInt32) using Asm {
    gate.store(v, .release)
    memoryBarrier(.inner, .storeStore)
    syncBarrier(.full)
    compilerFence(.seqCst)
    instructionBarrier()
}

func idle() using Asm {
    relax()
    nop()
    signalEvent()
    waitForEvent()
    waitForInterrupt()
}

func flush(_ src: Span[UInt8], _ dst: MutSpan[UInt8]) using Asm {
    with RawMemory {
        cleanData(src)
        invalidateData(src)
        cleanInvalidateData(src)
        zeroData(dst)
        publishInstructions(src)
    }
    invalidateAllInstructions()
}

func shootdown(_ va: UInt64) using Asm {
    tlbInvalidateAll(.innerShareable)
    tlbInvalidatePage(va, true, .currentEL)
    tlbInvalidateAsid(3, .innerShareable)
}
