func f(_ a: Int32) -> Int32 {
  if a > 0 {
    return a
  } else {
    return 0
  }
}
func g(_ a: Int32) -> Int32 {
  var x = a
  if x > 0 {
    x = x - 1
  }
  return x
}
func h(_ a: Int32) -> Int32 {
  var x = a
  while x > 0 {
    if x > 5 {
      x = x - 2
    } else {
      x = x - 1
    }
  }
  return x
}
