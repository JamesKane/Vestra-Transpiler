// Codegen slice 64 (corpus burndown 10): `else if` chains. The parser stores
// an `else if` as a bare `ifE` in the else slot rather than a block wrapping
// one, and emitElse only handled the block case — so every else-if branch
// emitted as an empty `} else { }`, silently dropping the whole chain.
//
// The bootstrap does NOT flatten a chain into `else if`; it NESTS, emitting
// `} else { if (c) { ... } }` per level, so the run closes with one brace per
// level. Emitting the nested if at indent "" puts it on the `} else { ` line.

func classify(_ n: Int32) -> Int32 {
    if n < 0 {
        return 0
    } else if n == 0 {
        return 1
    } else if n < 10 {
        return 2
    } else {
        return 3
    }
}

// A chain with no trailing else still nests one level per `else if`.
func noTail(_ n: Int32) -> Int32 {
    var r: Int32 = 0
    if n == 1 {
        r = 10
    } else if n == 2 {
        r = 20
    } else if n == 3 {
        r = 30
    }
    return r
}

// Multi-statement branches, so the brace stack is not confused with the
// statement lines inside each branch.
func accumulate(_ n: Int32) -> Int32 {
    var total: Int32 = 0
    var step: Int32 = 1
    if n > 100 {
        step = 10
        total = total + step
    } else if n > 10 {
        step = 5
        total = total + step
        total = total + 1
    } else {
        step = 1
        total = total + step
    }
    return total
}

// A nested if INSIDE a branch, alongside the chain, so plain nesting and
// else-if nesting are distinguished.
func mixed(_ a: Int32, _ b: Int32) -> Int32 {
    if a > 0 {
        if b > 0 {
            return 1
        }
        return 2
    } else if a == 0 {
        return 3
    }
    return 4
}

// `else if let` — the optional-unwrap form in a chain position.
func chainLet(_ o: Int32?, _ p: Int32?) -> Int32 {
    if let v = o {
        return v
    } else if let w = p {
        return w
    }
    return 0
}
