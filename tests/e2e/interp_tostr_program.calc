sq = mapNew();
i = 1;
while i < 5 do { sq = put(sq, toStr(i), i * i); i = i + 1 };
print "sq3:", get(sq, "3");
print "sq4:", get(sq, toStr(4));
print "nkeys:", len(keys(sq));
print "int:", toStr(42);
print "bool:", toStr(true);
print "passthrough:", toStr("hi");
labels = listNew();
i = 1;
while i < 4 do { labels = push(labels, toStr(i * i)); i = i + 1 };
print "labels:", join(labels, ",");
print "rt:", toInt(toStr(123));
print "done"
