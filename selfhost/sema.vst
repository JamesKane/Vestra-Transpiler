// The dog-food compiler, phase 3: the Vestra semantic analyzer, written in Vestra.
// It reuses the self-hosted lexer + parser (the front of this file is a copy of
// selfhost/parser.vst), then runs name resolution over the AST and reports
// undefined identifiers, differentially tested against `vestra check`:
//
//   vsema <file.vst>   resolves names and prints "undefined name '<n>'" for each
//                      unresolved identifier (exit 1), else nothing (exit 0).
//
// The contract is the VERDICT plus the offending name: the e2e extracts the
// `undefined name '...'` messages from `vestra check` and compares them to vsema's
// (source positions and the caret rendering are deferred to a later slice). Sema is
// deeply cross-referential, so unlike the lexer / parser (validated on the whole
// example corpus) this is validated on a CURATED corpus of paired programs (valid
// and single-undefined-name variants) with a controlled vocabulary.
//
// Slice 1 scope: a two-pass resolver. Pass 1 collects top-level value names (func /
// struct / enum / const / static) plus a fixed builtin set. Pass 2 walks each
// function body with a scope stack (params, then nested let / var / for-pattern
// locals) and flags every bare IdentExpr that resolves to nothing. Constructs the
// parser leaves opaque (match arms, closures, `with` bodies) are not descended into,
// so the curated programs put undefined-name tests in plain free-function bodies.
// The AST and parser below are unchanged from selfhost/parser.vst.

// ---------------------------------------------------------------------------
// The real token kinds (mirrors include/vestra/lex/token.hpp).
// ---------------------------------------------------------------------------
enum TokKind {
    // bookkeeping
    case eof
    case error
    case newline
    // literals
    case intLit
    case floatLit
    case stringLit
    case byteStringLit
    case charLit
    case identifier
    case interpBegin
    case interpPart
    case interpEnd
    // punctuation
    case lparen
    case rparen
    case lbrace
    case rbrace
    case lbracket
    case rbracket
    case comma
    case semicolon
    case colon
    case dot
    case dotDot
    case dotDotLt
    case arrow
    case fatArrow
    case at
    case dollar
    case question
    case underscore
    // operators
    case plus
    case minus
    case star
    case slash
    case percent
    case ampPlus
    case ampMinus
    case ampStar
    case amp
    case pipe
    case caret
    case tilde
    case bang
    case shiftL
    case shiftR
    case assign
    case plusEq
    case minusEq
    case starEq
    case slashEq
    case percentEq
    case ampEq
    case pipeEq
    case caretEq
    case shiftLEq
    case shiftREq
    case eqEq
    case bangEq
    case lt
    case gt
    case ltEq
    case gtEq
    case ampAmp
    case pipePipe
    case questionQuestion
    // keywords
    case kwModule
    case kwImport
    case kwFunc
    case kwStruct
    case kwEnum
    case kwProtocol
    case kwExtension
    case kwOpaque
    case kwType
    case kwEmbed
    case kwDeinit
    case kwLet
    case kwVar
    case kwConst
    case kwStatic
    case kwReturn
    case kwIf
    case kwElse
    case kwMatch
    case kwCase
    case kwDefault
    case kwFor
    case kwIn
    case kwWhile
    case kwBreak
    case kwContinue
    case kwWhere
    case kwDo
    case kwCatch
    case kwThrow
    case kwThrows
    case kwWith
    case kwUsing
    case kwAsync
    case kwAwait
    case kwSpawn
    case kwSelect
    case kwOn
    case kwComptime
    case kwQuote
    case kwCopy
    case kwRead
    case kwInout
    case kwSink
    case kwNonescaping
    case kwSome
    case kwDyn
    case kwLinear
    case kwTry
    case kwTryQuestion
    case kwTryBang
    case kwAs
    case kwAsQuestion
    case kwDerive
    case kwTrue
    case kwFalse
    case kwNil
    case kwSelfLower
    case kwSelfUpper
    case kwPrivate
    case kwInternal
    case kwPackage
    case kwPublic
}

struct Token {
    let kind: TokKind
    let text: Str
}

// The scanner state, threaded by inout through the scan functions.
struct Lex {
    var src: Str
    var pos: Int
    var depth: Int
    var prevOp: Bool
}

// ---------------------------------------------------------------------------
// Token spelling — the exact strings the C++ `spelling()` returns (token.cpp).
// ---------------------------------------------------------------------------
func spelling(_ k: TokKind) -> Str {
    return match k {
        case .eof: "<eof>"
        case .error: "<error>"
        case .newline: "<newline>"
        case .intLit: "integer literal"
        case .floatLit: "float literal"
        case .stringLit: "string literal"
        case .byteStringLit: "byte string literal"
        case .charLit: "character literal"
        case .identifier: "identifier"
        case .interpBegin: "<interp string begin>"
        case .interpPart: "interp string fragment"
        case .interpEnd: "<interp string end>"
        case .lparen: "("
        case .rparen: ")"
        case .lbrace: "{"
        case .rbrace: "}"
        case .lbracket: "["
        case .rbracket: "]"
        case .comma: ","
        case .semicolon: ";"
        case .colon: ":"
        case .dot: "."
        case .dotDot: ".."
        case .dotDotLt: "..<"
        case .arrow: "->"
        case .fatArrow: "=>"
        case .at: "@"
        case .dollar: "$"
        case .question: "?"
        case .underscore: "_"
        case .plus: "+"
        case .minus: "-"
        case .star: "*"
        case .slash: "/"
        case .percent: "%"
        case .ampPlus: "&+"
        case .ampMinus: "&-"
        case .ampStar: "&*"
        case .amp: "&"
        case .pipe: "|"
        case .caret: "^"
        case .tilde: "~"
        case .bang: "!"
        case .shiftL: "<<"
        case .shiftR: ">>"
        case .assign: "="
        case .plusEq: "+="
        case .minusEq: "-="
        case .starEq: "*="
        case .slashEq: "/="
        case .percentEq: "%="
        case .ampEq: "&="
        case .pipeEq: "|="
        case .caretEq: "^="
        case .shiftLEq: "<<="
        case .shiftREq: ">>="
        case .eqEq: "=="
        case .bangEq: "!="
        case .lt: "<"
        case .gt: ">"
        case .ltEq: "<="
        case .gtEq: ">="
        case .ampAmp: "&&"
        case .pipePipe: "||"
        case .questionQuestion: "??"
        case .kwModule: "module"
        case .kwImport: "import"
        case .kwFunc: "func"
        case .kwStruct: "struct"
        case .kwEnum: "enum"
        case .kwProtocol: "protocol"
        case .kwExtension: "extension"
        case .kwOpaque: "opaque"
        case .kwType: "type"
        case .kwEmbed: "embed"
        case .kwDeinit: "deinit"
        case .kwLet: "let"
        case .kwVar: "var"
        case .kwConst: "const"
        case .kwStatic: "static"
        case .kwReturn: "return"
        case .kwIf: "if"
        case .kwElse: "else"
        case .kwMatch: "match"
        case .kwCase: "case"
        case .kwDefault: "default"
        case .kwFor: "for"
        case .kwIn: "in"
        case .kwWhile: "while"
        case .kwBreak: "break"
        case .kwContinue: "continue"
        case .kwWhere: "where"
        case .kwDo: "do"
        case .kwCatch: "catch"
        case .kwThrow: "throw"
        case .kwThrows: "throws"
        case .kwWith: "with"
        case .kwUsing: "using"
        case .kwAsync: "async"
        case .kwAwait: "await"
        case .kwSpawn: "spawn"
        case .kwSelect: "select"
        case .kwOn: "on"
        case .kwComptime: "comptime"
        case .kwQuote: "quote"
        case .kwCopy: "copy"
        case .kwRead: "read"
        case .kwInout: "inout"
        case .kwSink: "sink"
        case .kwNonescaping: "nonescaping"
        case .kwSome: "some"
        case .kwDyn: "dyn"
        case .kwLinear: "linear"
        case .kwTry: "try"
        case .kwTryQuestion: "try?"
        case .kwTryBang: "try!"
        case .kwAs: "as"
        case .kwAsQuestion: "as?"
        case .kwDerive: "derive"
        case .kwTrue: "true"
        case .kwFalse: "false"
        case .kwNil: "nil"
        case .kwSelfLower: "self"
        case .kwSelfUpper: "Self"
        case .kwPrivate: "private"
        case .kwInternal: "internal"
        case .kwPackage: "package"
        case .kwPublic: "public"
    }
}

// The §3 binary-operator set: a newline right after one of these is suppressed
// (mirrors is_binary_operator in lexer.cpp). Unary !, ~, ? are NOT included.
func isBinOp(_ k: TokKind) -> Bool {
    return match k {
        case .plus: true
        case .minus: true
        case .star: true
        case .slash: true
        case .percent: true
        case .ampPlus: true
        case .ampMinus: true
        case .ampStar: true
        case .amp: true
        case .pipe: true
        case .caret: true
        case .shiftL: true
        case .shiftR: true
        case .eqEq: true
        case .bangEq: true
        case .lt: true
        case .gt: true
        case .ltEq: true
        case .gtEq: true
        case .ampAmp: true
        case .pipePipe: true
        case .questionQuestion: true
        case .assign: true
        case .plusEq: true
        case .minusEq: true
        case .starEq: true
        case .slashEq: true
        case .percentEq: true
        case .ampEq: true
        case .pipeEq: true
        case .caretEq: true
        case .shiftLEq: true
        case .shiftREq: true
        case .arrow: true
        case .fatArrow: true
        case .comma: true
        case .colon: true
        case .dotDot: true
        case .dotDotLt: true
        default: false
    }
}

// The §17.1 keyword table. `try` / `as` map to their base kind here; the `?` / `!`
// suffixes are folded in by the identifier scanner.
func keywordKind(_ s: Str) -> TokKind {
    return match s {
        case "module": TokKind.kwModule
        case "import": TokKind.kwImport
        case "func": TokKind.kwFunc
        case "struct": TokKind.kwStruct
        case "enum": TokKind.kwEnum
        case "protocol": TokKind.kwProtocol
        case "extension": TokKind.kwExtension
        case "opaque": TokKind.kwOpaque
        case "type": TokKind.kwType
        case "embed": TokKind.kwEmbed
        case "deinit": TokKind.kwDeinit
        case "let": TokKind.kwLet
        case "var": TokKind.kwVar
        case "const": TokKind.kwConst
        case "static": TokKind.kwStatic
        case "return": TokKind.kwReturn
        case "if": TokKind.kwIf
        case "else": TokKind.kwElse
        case "match": TokKind.kwMatch
        case "case": TokKind.kwCase
        case "default": TokKind.kwDefault
        case "for": TokKind.kwFor
        case "in": TokKind.kwIn
        case "while": TokKind.kwWhile
        case "break": TokKind.kwBreak
        case "continue": TokKind.kwContinue
        case "where": TokKind.kwWhere
        case "do": TokKind.kwDo
        case "catch": TokKind.kwCatch
        case "throw": TokKind.kwThrow
        case "throws": TokKind.kwThrows
        case "with": TokKind.kwWith
        case "using": TokKind.kwUsing
        case "async": TokKind.kwAsync
        case "await": TokKind.kwAwait
        case "spawn": TokKind.kwSpawn
        case "select": TokKind.kwSelect
        case "on": TokKind.kwOn
        case "comptime": TokKind.kwComptime
        case "quote": TokKind.kwQuote
        case "copy": TokKind.kwCopy
        case "read": TokKind.kwRead
        case "inout": TokKind.kwInout
        case "sink": TokKind.kwSink
        case "nonescaping": TokKind.kwNonescaping
        case "some": TokKind.kwSome
        case "dyn": TokKind.kwDyn
        case "linear": TokKind.kwLinear
        case "try": TokKind.kwTry
        case "as": TokKind.kwAs
        case "derive": TokKind.kwDerive
        case "true": TokKind.kwTrue
        case "false": TokKind.kwFalse
        case "nil": TokKind.kwNil
        case "self": TokKind.kwSelfLower
        case "Self": TokKind.kwSelfUpper
        case "private": TokKind.kwPrivate
        case "internal": TokKind.kwInternal
        case "package": TokKind.kwPackage
        case "public": TokKind.kwPublic
        default: TokKind.identifier
    }
}

// ---------------------------------------------------------------------------
// ASCII character classes — written out to match the C++ predicates exactly
// (rather than relying on Char.isAlpha, which could differ on non-ASCII).
// ---------------------------------------------------------------------------
func isDigitC(_ c: Char) -> Bool { return c >= '0' && c <= '9' }
func isHexC(_ c: Char) -> Bool {
    return isDigitC(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}
func isOctC(_ c: Char) -> Bool { return c >= '0' && c <= '7' }
func isBinC(_ c: Char) -> Bool { return c == '0' || c == '1' }
func isIdStartC(_ c: Char) -> Bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}
func isIdContC(_ c: Char) -> Bool { return isIdStartC(c) || isDigitC(c) }

// Byte-wise string equality (avoids the Str-vs-StrConst operator mismatch).
func streq(_ a: Str, _ b: Str) -> Bool {
    if a.len() != b.len() { return false }
    var i: Int = 0
    while i < a.len() {
        if (a.byteAt(i) ?? 0) != (b.byteAt(i) ?? 0) { return false }
        i = i + 1
    }
    return true
}

// ---------------------------------------------------------------------------
// Cursor primitives over the Lex state.
// ---------------------------------------------------------------------------
func atC(_ src: Str, _ i: Int) -> Char {
    if i >= src.len() { return '\0' }
    return src.charAt(i) ?? '\0'
}
func curC(_ l: Lex) -> Char { return atC(l.src, l.pos) }
func aheadC(_ l: Lex, _ n: Int) -> Char { return atC(l.src, l.pos + n) }
func atEndL(_ l: Lex) -> Bool { return l.pos >= l.src.len() }
func advC(_ l: inout Lex) { l.pos = l.pos + 1 }
func bumpC(_ l: inout Lex) -> Char {
    let c = curC(l)
    l.pos = l.pos + 1
    return c
}
func eatC(_ l: inout Lex, _ expected: Char) -> Bool {
    if curC(l) == expected {
        l.pos = l.pos + 1
        return true
    }
    return false
}

// Emit a token spanning [start, pos); records whether it was a binary operator
// so the next newline knows whether to continue the statement.
func emitTok(_ toks: inout Vec[Token], _ l: inout Lex, _ k: TokKind, _ start: Int) using Alloc {
    let bin = isBinOp(k)
    toks.push(Token(kind: k, text: l.src.slice(start, l.pos)))
    l.prevOp = bin
}

// Does the next significant char (past horizontal whitespace, blank lines, and
// line comments) begin a binary operator? Then the pending newline continues.
func nextStartsWithOperator(_ src: Str, _ scanStart: Int) -> Bool {
    var scan: Int = scanStart
    var go: Bool = true
    while go && scan < src.len() {
        let d = atC(src, scan)
        if d == ' ' || d == '\t' || d == '\r' || d == '\n' {
            scan = scan + 1
        } else if d == '/' && atC(src, scan + 1) == '/' {
            while scan < src.len() && atC(src, scan) != '\n' { scan = scan + 1 }
        } else {
            go = false
        }
    }
    if scan < src.len() {
        let d = atC(src, scan)
        return d == '+' || d == '-' || d == '*' || d == '/' || d == '%'
            || d == '|' || d == '^' || d == '?' || d == '.'
    }
    return false
}

// /* ... */ with §3 nesting.
func scanBlockComment(_ l: inout Lex) {
    var depth: Int = 1
    while depth > 0 && !atEndL(l) {
        if curC(l) == '/' && aheadC(l, 1) == '*' {
            advC(&l)
            advC(&l)
            depth = depth + 1
        } else if curC(l) == '*' && aheadC(l, 1) == '/' {
            advC(&l)
            advC(&l)
            depth = depth - 1
        } else {
            advC(&l)
        }
    }
}

// Skip whitespace and comments, emitting Newline tokens where they terminate a
// statement (§3 continuation rules).
func skipTrivia(_ toks: inout Vec[Token], _ l: inout Lex) using Alloc {
    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        if c == ' ' || c == '\t' || c == '\r' {
            advC(&l)
        } else if c == '\n' {
            let nlStart = l.pos
            advC(&l)
            if l.depth > 0 || l.prevOp {
                // continuation: newline suppressed
            } else if !nextStartsWithOperator(l.src, l.pos) {
                toks.push(Token(kind: TokKind.newline, text: l.src.slice(nlStart, nlStart + 1)))
            }
        } else if c == '/' && aheadC(l, 1) == '/' {
            while !atEndL(l) && curC(l) != '\n' { advC(&l) }
        } else if c == '/' && aheadC(l, 1) == '*' {
            advC(&l)
            advC(&l)
            scanBlockComment(&l)
        } else {
            go = false
        }
    }
}

// Consume a run of digits (and `_` separators) in the given base.
func eatDigits(_ l: inout Lex, _ base: Int) {
    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        var ok: Bool = false
        if base == 16 { ok = isHexC(c) }
        else if base == 8 { ok = isOctC(c) }
        else if base == 2 { ok = isBinC(c) }
        else { ok = isDigitC(c) }
        if ok || c == '_' { advC(&l) } else { go = false }
    }
}

func scanNumber(_ toks: inout Vec[Token], _ l: inout Lex, _ start: Int) using Alloc {
    var isFloat: Bool = false
    let first = atC(l.src, start)
    let c1 = curC(l)
    if first == '0' && (c1 == 'x' || c1 == 'o' || c1 == 'b') {
        let base = bumpC(&l)
        if base == 'x' { eatDigits(&l, 16) }
        else if base == 'o' { eatDigits(&l, 8) }
        else { eatDigits(&l, 2) }
    } else {
        eatDigits(&l, 10)
        if curC(l) == '.' && isDigitC(aheadC(l, 1)) {
            isFloat = true
            advC(&l)
            eatDigits(&l, 10)
        }
        if curC(l) == 'e' || curC(l) == 'E' {
            isFloat = true
            advC(&l)
            if curC(l) == '+' || curC(l) == '-' { advC(&l) }
            eatDigits(&l, 10)
        }
    }
    var k: TokKind = TokKind.intLit
    if isFloat { k = TokKind.floatLit }
    emitTok(&toks, &l, k, start)
}

func scanIdentifier(_ toks: inout Vec[Token], _ l: inout Lex, _ start: Int) using Alloc {
    while !atEndL(l) && isIdContC(curC(l)) { advC(&l) }
    let lex = l.src.slice(start, l.pos)
    var kind = keywordKind(lex)
    if streq(lex, "try") {
        if curC(l) == '?' { advC(&l); kind = TokKind.kwTryQuestion }
        else if curC(l) == '!' { advC(&l); kind = TokKind.kwTryBang }
    } else if streq(lex, "as") && curC(l) == '?' {
        advC(&l)
        kind = TokKind.kwAsQuestion
    }
    if streq(lex, "_") { kind = TokKind.underscore }
    emitTok(&toks, &l, kind, start)
}

// §4 interpolation: pick up the next literal fragment after the opening `"` of an
// interpolated string or the `)` that closed a splice. Emit the fragment as an
// InterpStringPart, then either close on `"` (part + InterpStringEnd) or split on
// `\(` (part + LParen, push the splice's bracket depth, and return so the main loop
// runs the splice body). The `)` that closes the splice resumes us via the main
// loop. The splice-opening LParen carries the two-char lexeme `\(`, matching the
// C++ lexer; InterpStringBegin / End each carry the `"`.
func scanInterpContinue(_ toks: inout Vec[Token], _ l: inout Lex, _ splices: inout Vec[Int]) using Alloc {
    let fragStart = l.pos
    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        if c == '"' {
            emitTok(&toks, &l, TokKind.interpPart, fragStart)
            let endStart = l.pos
            advC(&l)
            emitTok(&toks, &l, TokKind.interpEnd, endStart)
            return
        }
        if c == '\\' && aheadC(l, 1) == '(' {
            emitTok(&toks, &l, TokKind.interpPart, fragStart)
            let markerStart = l.pos
            advC(&l)
            advC(&l)
            l.depth = l.depth + 1
            splices.push(l.depth)
            emitTok(&toks, &l, TokKind.lparen, markerStart)
            return
        }
        if c == '\\' {
            advC(&l)
            if !atEndL(l) { advC(&l) }
        } else if c == '\n' {
            emitTok(&toks, &l, TokKind.error, fragStart)
            return
        } else {
            advC(&l)
        }
    }
    emitTok(&toks, &l, TokKind.error, fragStart)
}

// String / byte string. Regular strings are pre-scanned for a `\(` splice: if one
// is present the literal lexes as InterpStringBegin + (Part / splice tokens)* +
// InterpStringEnd; otherwise it is a single StringLit. Byte strings (§17.1) never
// interpolate.
func scanString(_ toks: inout Vec[Token], _ l: inout Lex, _ splices: inout Vec[Int], _ start: Int, _ isByte: Bool) using Alloc {
    if !isByte {
        let saved = l.pos
        var hasSplice: Bool = false
        var scan: Bool = true
        while scan && !atEndL(l) {
            let c = curC(l)
            if c == '"' || c == '\n' {
                scan = false
            } else if c == '\\' {
                if aheadC(l, 1) == '(' {
                    hasSplice = true
                    scan = false
                } else {
                    advC(&l)
                    if !atEndL(l) { advC(&l) }
                }
            } else {
                advC(&l)
            }
        }
        l.pos = saved
        if hasSplice {
            emitTok(&toks, &l, TokKind.interpBegin, start)
            scanInterpContinue(&toks, &l, &splices)
            return
        }
    }

    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        if c == '"' {
            advC(&l)
            var k: TokKind = TokKind.stringLit
            if isByte { k = TokKind.byteStringLit }
            emitTok(&toks, &l, k, start)
            return
        }
        if c == '\\' {
            advC(&l)
            if !atEndL(l) { advC(&l) }
        } else if c == '\n' {
            emitTok(&toks, &l, TokKind.error, start)
            return
        } else {
            advC(&l)
        }
    }
    emitTok(&toks, &l, TokKind.error, start)
}

func scanChar(_ toks: inout Vec[Token], _ l: inout Lex, _ start: Int) using Alloc {
    if curC(l) == '\\' {
        advC(&l)
        if !atEndL(l) { advC(&l) }
    } else if !atEndL(l) && curC(l) != '\'' {
        advC(&l)
    }
    if curC(l) != '\'' {
        emitTok(&toks, &l, TokKind.error, start)
        return
    }
    advC(&l)
    emitTok(&toks, &l, TokKind.charLit, start)
}

// The main scan loop: skip trivia, dispatch on the first char, append Eof.
func tokenize(_ src: Str) using Alloc -> Vec[Token] {
    var l = Lex(src: src, pos: 0, depth: 0, prevOp: false)
    var toks: Vec[Token] = Vec.new()
    var splices: Vec[Int] = Vec.new()
    while !atEndL(l) {
        skipTrivia(&toks, &l)
        if atEndL(l) { return finish(&toks, &l) }
        let start = l.pos
        let c = bumpC(&l)
        if c == '(' { l.depth = l.depth + 1; emitTok(&toks, &l, TokKind.lparen, start) }
        else if c == ')' {
            l.depth = l.depth - 1
            emitTok(&toks, &l, TokKind.rparen, start)
            // §4: a `)` that drops bracket depth below the current splice's level
            // closes the splice and resumes the surrounding string fragment.
            if splices.len() > 0 && l.depth < (splices.get(splices.len() - 1) ?? 0) {
                let _ = splices.pop()
                scanInterpContinue(&toks, &l, &splices)
            }
        }
        else if c == '[' { l.depth = l.depth + 1; emitTok(&toks, &l, TokKind.lbracket, start) }
        else if c == ']' { l.depth = l.depth - 1; emitTok(&toks, &l, TokKind.rbracket, start) }
        else if c == '{' { l.depth = l.depth + 1; emitTok(&toks, &l, TokKind.lbrace, start) }
        else if c == '}' { l.depth = l.depth - 1; emitTok(&toks, &l, TokKind.rbrace, start) }
        else if c == ',' { emitTok(&toks, &l, TokKind.comma, start) }
        else if c == ';' { emitTok(&toks, &l, TokKind.semicolon, start) }
        else if c == '@' { emitTok(&toks, &l, TokKind.at, start) }
        else if c == '$' { emitTok(&toks, &l, TokKind.dollar, start) }
        else if c == '~' { emitTok(&toks, &l, TokKind.tilde, start) }
        else if c == ':' { emitTok(&toks, &l, TokKind.colon, start) }
        else if c == '.' {
            if eatC(&l, '.') {
                if eatC(&l, '<') { emitTok(&toks, &l, TokKind.dotDotLt, start) }
                else { emitTok(&toks, &l, TokKind.dotDot, start) }
            } else { emitTok(&toks, &l, TokKind.dot, start) }
        }
        else if c == '?' {
            if eatC(&l, '?') { emitTok(&toks, &l, TokKind.questionQuestion, start) }
            else { emitTok(&toks, &l, TokKind.question, start) }
        }
        else if c == '+' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.plusEq, start) }
            else { emitTok(&toks, &l, TokKind.plus, start) }
        }
        else if c == '-' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.minusEq, start) }
            else if eatC(&l, '>') { emitTok(&toks, &l, TokKind.arrow, start) }
            else { emitTok(&toks, &l, TokKind.minus, start) }
        }
        else if c == '*' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.starEq, start) }
            else { emitTok(&toks, &l, TokKind.star, start) }
        }
        else if c == '/' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.slashEq, start) }
            else { emitTok(&toks, &l, TokKind.slash, start) }
        }
        else if c == '%' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.percentEq, start) }
            else { emitTok(&toks, &l, TokKind.percent, start) }
        }
        else if c == '^' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.caretEq, start) }
            else { emitTok(&toks, &l, TokKind.caret, start) }
        }
        else if c == '&' {
            if eatC(&l, '&') { emitTok(&toks, &l, TokKind.ampAmp, start) }
            else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.ampEq, start) }
            else if eatC(&l, '+') { emitTok(&toks, &l, TokKind.ampPlus, start) }
            else if eatC(&l, '-') { emitTok(&toks, &l, TokKind.ampMinus, start) }
            else if eatC(&l, '*') { emitTok(&toks, &l, TokKind.ampStar, start) }
            else { emitTok(&toks, &l, TokKind.amp, start) }
        }
        else if c == '|' {
            if eatC(&l, '|') { emitTok(&toks, &l, TokKind.pipePipe, start) }
            else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.pipeEq, start) }
            else { emitTok(&toks, &l, TokKind.pipe, start) }
        }
        else if c == '=' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.eqEq, start) }
            else if eatC(&l, '>') { emitTok(&toks, &l, TokKind.fatArrow, start) }
            else { emitTok(&toks, &l, TokKind.assign, start) }
        }
        else if c == '!' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.bangEq, start) }
            else { emitTok(&toks, &l, TokKind.bang, start) }
        }
        else if c == '<' {
            if eatC(&l, '<') {
                if eatC(&l, '=') { emitTok(&toks, &l, TokKind.shiftLEq, start) }
                else { emitTok(&toks, &l, TokKind.shiftL, start) }
            } else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.ltEq, start) }
            else { emitTok(&toks, &l, TokKind.lt, start) }
        }
        else if c == '>' {
            if eatC(&l, '>') {
                if eatC(&l, '=') { emitTok(&toks, &l, TokKind.shiftREq, start) }
                else { emitTok(&toks, &l, TokKind.shiftR, start) }
            } else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.gtEq, start) }
            else { emitTok(&toks, &l, TokKind.gt, start) }
        }
        else if c == '"' { scanString(&toks, &l, &splices, start, false) }
        else if c == '\'' { scanChar(&toks, &l, start) }
        else if c == 'b' && curC(l) == '"' { advC(&l); scanString(&toks, &l, &splices, start, true) }
        else if isDigitC(c) { scanNumber(&toks, &l, start) }
        else if isIdStartC(c) { scanIdentifier(&toks, &l, start) }
        else { emitTok(&toks, &l, TokKind.error, start) }
    }
    return finish(&toks, &l)
}

// Append the final Eof token (empty lexeme) and hand back the stream.
func finish(_ toks: inout Vec[Token], _ l: inout Lex) using Alloc -> Vec[Token] {
    let n = l.src.len()
    toks.push(Token(kind: TokKind.eof, text: l.src.slice(n, n)))
    return toks
}

// ===========================================================================
// One self-recursive node type. Folding expressions, statements, types, patterns,
// params, and decls into a single enum avoids mutual recursion between separate
// enums (which the transpiler can't forward-declare); self-recursion through
// Vec[Nd] lowers cleanly. Children are boxed as one-element Vec[Nd]; lists are
// many-element Vec[Nd]. Operator / visibility tags are stored as their already-
// printable strings, so the printer just emits them.
// ===========================================================================
enum Nd {
    // expressions
    case intLit(String)
    case floatLit(String)
    case strLit(String)                     // text without the surrounding quotes
    case byteStrLit(String)                 // text without b"…"
    case charLit(String)                    // text without the quotes
    case boolLit(Bool)
    case nilLit
    case ident(String)
    case selfE
    case leadingDot(String)
    case paren(Vec[Nd])                     // inner (boxed)
    case unary(String, Vec[Nd])             // op string, operand
    case binary(String, Vec[Nd], Vec[Nd])
    case call(Vec[Nd], Vec[Nd])             // callee (boxed), args (each an .arg)
    case arg(String, Bool, Vec[Nd])         // label, is_inout, value (only as a call arg)
    case member(Vec[Nd], String, Bool)      // base, name, is_optional_chain
    case index(Vec[Nd], Vec[Nd])            // base (boxed), indices
    case ifE(String, Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd]) // letName, letInit, cond, then, else
    case block(Vec[Nd])                     // statements
    case asE(Vec[Nd], Vec[Nd], Bool)        // value, target type, is_optional
    case addrOf(Vec[Nd])
    case matchE(Vec[Nd], Vec[Nd])           // scrutinee (boxed), arms — still prints /*?expr*/ (no C++ printer case), but carries the match for sema
    case matchArm(Bool, Vec[Nd], Vec[Nd], Vec[Nd]) // isDefault, pattern (empty if default), guard (empty if none), body — all boxed
    case exoticE                            // comptime, closure, select, etc — /*?expr*/
    case vecLit(Vec[Nd])                    // [e1, e2, ...] array/vector literal — prints /*?expr*/ (no C++ case), carries elements for sema
    case tupleLit(Vec[Nd])                  // (e1, e2, ...) tuple literal — prints /*?expr*/ (no C++ case), carries elements for sema
    case closureE(Vec[Nd], Vec[Nd])         // { params => body } — params (ident nodes) + body stmts; prints /*?expr*/ (no C++ case), carries both for sema
    case interpE(Vec[String], Vec[Nd])      // "...\(e)..." interpolated string — prints /*?expr*/ (no C++ case), carries the embedded exprs for sema
    case throwE(Vec[Nd])                    // throw OPERAND — also prints /*?expr*/ (no C++ printer case), but carries the operand for sema
    case prefixE(String, Vec[Nd])           // copy / await / spawn / try (kw string), operand — printed fully
    case doCatchE(Vec[Nd], String, Vec[Nd], Vec[Nd]) // doBody, errName, errType?, catchBody
    case quoteE(Vec[Nd])                     // quote { EXPR } — printed fully
    case spliceE(Bool, Vec[Nd])              // isBareIdent, inner — $ident or $(expr)
    // statements
    case letS(Vec[Nd], Vec[Nd], Vec[Nd])    // pattern, type?, value
    case varS(Vec[Nd], Vec[Nd], Vec[Nd])
    case exprS(Vec[Nd])
    case retS(Vec[Nd])                       // value?
    case assignS(String, Vec[Nd], Vec[Nd])   // op, target, value
    case whileS(Vec[Nd], Vec[Nd])            // cond, body (block)
    case forS(Vec[Nd], Vec[Nd], Vec[Nd])     // pattern, iter, body (block)
    case breakS(String)                      // label ("" if none)
    case continueS(String)
    case withS(Vec[Nd], Vec[Nd], Vec[Nd])    // granted cap types, binding values, body (printed /*?stmt*/)
    // patterns
    case wildcard
    case identP(String)
    case bindP(String)
    case litP(Vec[Nd])                       // literal pattern (boxed expr)
    case enumP(String, Vec[Nd])              // case name, children patterns
    case tupleP(Vec[Nd])                     // printed /*?pat*/
    case rangeP(Vec[Nd], Vec[Nd], Bool)      // printed /*?pat*/
    case orP(Vec[Nd])                        // printed /*?pat*/
    // types
    case named(String, Bool, Vec[Nd])        // path, hasGenerics, type args
    case opt(Vec[Nd])                        // inner type (boxed)
    case someT(Vec[Nd])                      // some T
    case dynT(Vec[Nd])                       // dyn T
    case vecT(String, Vec[Nd])               // length (int or ident string), element
    case tupleT(Vec[Nd])                     // (T, U, ...)
    case fnT(Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd]) // params, usingCaps, throws?, result?
    // generic parameters (printed on funcs; parsed-and-dropped on structs/enums)
    case genConst(String, Vec[Nd])           // name, const type
    case genType(String, Vec[Nd])            // name, bounds (types joined by " & ")
    // a function parameter
    case param(Bool, String, String, Bool, String, Vec[Nd]) // labelOmitted, label, name, nonesc, mode, type
    // struct / enum members
    case field(String, String, Vec[Nd])     // kind ("let "/"var "/"embed "), name, type
    case enumCase(String, Vec[Nd])           // name, payload (payElem list)
    case payElem(String, Vec[Nd])            // label ("" if positional), type
    // declarations
    case importD(Bool, String)               // is_c_header, payload (joined path or header)
    case funcD(String, String, String, Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd])
    // visibilityPrefix, modifiers (async/recv), name, generics, params, usingCaps, throwsType?, result?, body?
    case structD(String, String, Vec[Nd], Vec[Nd], Vec[Nd], Bool, Vec[Nd]) // vis, name, fields, methods, deinit?, isLinear, generics
    case enumD(String, String, Vec[Nd], Vec[Nd], Vec[Nd])   // vis, name, cases, methods, generics
    case constD(String, String, Vec[Nd], Vec[Nd])           // vis, name, type?, value
    case staticD(String, String, Vec[Nd], Vec[Nd])          // vis, name, type, value?
    case opaqueD(String, String, Vec[Nd])                   // vis, name, underlying type
    case deriveD(Vec[Nd], Vec[Nd])                          // protocols, target type
}

struct NUnit {
    var hasMod: Bool
    var modPath: String
    var imports: Vec[Nd]
    var decls: Vec[Nd]
}

struct Ps {
    var toks: Vec[Token]
    var pos: Int
}

struct BP {
    let left: Int
    let right: Int
}

// ----- small constructors / helpers ----------------------------------------
func own(_ s: Str) using Alloc -> String { var r: String = ""; r.append(s); return r }
func bE(_ e: Nd) using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); v.push(e); return v }
func bT(_ t: Nd) using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); v.push(t); return v }
func noE() using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); return v }
func noT() using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); return v }
func errE() using Alloc -> Nd { return Nd.ident("?") }
func errT() using Alloc -> Nd { return Nd.named("?", false, noT()) }
func errP() using Alloc -> Nd { return Nd.wildcard }

func eofTok() -> Token { return Token(kind: TokKind.eof, text: "") }
func curT(_ p: inout Ps) -> Token { return p.toks.get(p.pos) ?? eofTok() }
func curKind(_ p: inout Ps) -> TokKind { let t = curT(p); return t.kind }
func aheadKindP(_ p: inout Ps, _ n: Int) -> TokKind { let t = p.toks.get(p.pos + n) ?? eofTok(); return t.kind }
func curRaw(_ p: inout Ps) -> Str { let t = curT(p); return t.text }
func curText(_ p: inout Ps) using Alloc -> String { return own(curRaw(p)) }
func advP(_ p: inout Ps) { p.pos = p.pos + 1 }
func isKind(_ p: inout Ps, _ k: TokKind) -> Bool { return streq(spelling(curKind(p)), spelling(k)) }
func isKindAt(_ p: inout Ps, _ n: Int, _ k: TokKind) -> Bool { return streq(spelling(aheadKindP(p, n)), spelling(k)) }
func eat(_ p: inout Ps, _ k: TokKind) -> Bool { if isKind(p, k) { advP(&p); return true } return false }
func eatV(_ p: inout Ps, _ k: TokKind) { if isKind(p, k) { advP(&p) } }
func atEndP(_ p: inout Ps) -> Bool { return isKind(p, TokKind.eof) }
func skipNL(_ p: inout Ps) { while isKind(p, TokKind.newline) || isKind(p, TokKind.semicolon) { advP(&p) } }

// ----- operator tables (token kind -> printable string / binding power) -----
func binOpStr(_ k: TokKind) -> Str {
    return match k {
        case .star: "*"
        case .slash: "/"
        case .percent: "%"
        case .ampStar: "&*"
        case .plus: "+"
        case .minus: "-"
        case .ampPlus: "&+"
        case .ampMinus: "&-"
        case .shiftL: "<<"
        case .shiftR: ">>"
        case .amp: "&"
        case .caret: "^"
        case .pipe: "|"
        case .dotDot: ".."
        case .dotDotLt: "..<"
        case .eqEq: "=="
        case .bangEq: "!="
        case .lt: "<"
        case .ltEq: "<="
        case .gt: ">"
        case .gtEq: ">="
        case .ampAmp: "&&"
        case .pipePipe: "||"
        case .questionQuestion: "??"
        default: "?"
    }
}

func infixBp(_ k: TokKind) -> BP {
    return match k {
        case .star: BP(left: 130, right: 131)
        case .slash: BP(left: 130, right: 131)
        case .percent: BP(left: 130, right: 131)
        case .ampStar: BP(left: 130, right: 131)
        case .plus: BP(left: 120, right: 121)
        case .minus: BP(left: 120, right: 121)
        case .ampPlus: BP(left: 120, right: 121)
        case .ampMinus: BP(left: 120, right: 121)
        case .shiftL: BP(left: 110, right: 111)
        case .shiftR: BP(left: 110, right: 111)
        case .amp: BP(left: 100, right: 101)
        case .caret: BP(left: 90, right: 91)
        case .pipe: BP(left: 80, right: 81)
        case .dotDot: BP(left: 70, right: 71)
        case .dotDotLt: BP(left: 70, right: 71)
        case .eqEq: BP(left: 60, right: 61)
        case .bangEq: BP(left: 60, right: 61)
        case .lt: BP(left: 60, right: 61)
        case .ltEq: BP(left: 60, right: 61)
        case .gt: BP(left: 60, right: 61)
        case .gtEq: BP(left: 60, right: 61)
        case .ampAmp: BP(left: 50, right: 51)
        case .pipePipe: BP(left: 40, right: 41)
        case .questionQuestion: BP(left: 30, right: 31)
        default: BP(left: 0, right: 0)
    }
}

func isAssignOp(_ k: TokKind) -> Bool {
    return match k {
        case .assign: true
        case .plusEq: true
        case .minusEq: true
        case .starEq: true
        case .slashEq: true
        case .percentEq: true
        case .ampEq: true
        case .pipeEq: true
        case .caretEq: true
        case .shiftLEq: true
        case .shiftREq: true
        default: false
    }
}

func assignOpStr(_ k: TokKind) -> Str {
    return match k {
        case .assign: "="
        case .plusEq: "+="
        case .minusEq: "-="
        case .starEq: "*="
        case .slashEq: "/="
        case .percentEq: "%="
        case .ampEq: "&="
        case .pipeEq: "|="
        case .caretEq: "^="
        case .shiftLEq: "<<="
        case .shiftREq: ">>="
        default: "?="
    }
}

// ----- parser ---------------------------------------------------------------
func parseUnit(_ p: inout Ps) using Alloc -> NUnit {
    var u = NUnit(hasMod: false, modPath: "", imports: Vec.new(), decls: Vec.new())
    skipNL(&p)
    if isKind(p, TokKind.kwModule) {
        advP(&p)
        u.hasMod = true
        u.modPath = parseDottedPath(&p)
        skipNL(&p)
    }
    while isKind(p, TokKind.kwImport) {
        u.imports.push(parseImport(&p))
        skipNL(&p)
    }
    while !atEndP(p) {
        u.decls.push(parseDecl(&p))
        skipNL(&p)
    }
    return u
}

func parseDottedPath(_ p: inout Ps) using Alloc -> String {
    var s: String = curText(p)
    advP(&p)
    while isKind(p, TokKind.dot) {
        advP(&p)
        s.append(".")
        s.append(curText(p))
        advP(&p)
    }
    return s
}

func parseImport(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'import'
    if isKind(p, TokKind.identifier) && streq(curRaw(p), "c") && isKindAt(p, 1, TokKind.stringLit) {
        advP(&p)  // 'c'
        let raw = curRaw(p)
        advP(&p)
        var body: String = ""
        if raw.len() >= 2 { body = own(raw.slice(1, raw.len() - 1)) }
        return Nd.importD(true, body)
    }
    return Nd.importD(false, parseDottedPath(&p))
}

func parseVisibility(_ p: inout Ps) -> Str {
    if isKind(p, TokKind.kwPrivate) { advP(&p); return "private " }
    if isKind(p, TokKind.kwPublic) { advP(&p); return "public " }
    if isKind(p, TokKind.kwPackage) { advP(&p); return "package " }
    if isKind(p, TokKind.kwInternal) { advP(&p); return "" }
    return ""
}

// Skip declaration attributes `@name` / `@name(...)` (the C++ printer does not emit
// them). Consumes any run of attributes, balancing parens in their argument lists.
func skipAttributes(_ p: inout Ps) { let _ = skipAttrsNaked(&p) }

// As skipAttributes, and says whether one was `@naked` or `@boot` (an asm body
// the divergence checks don't hold to their rules, as in the bootstrap).
func skipAttrsNaked(_ p: inout Ps) -> Bool {
    var naked: Bool = false
    while isKind(p, TokKind.at) {
        advP(&p)  // '@'
        if streq(curRaw(p), "naked") || streq(curRaw(p), "boot") { naked = true }
        advP(&p)  // name (identifier or reserved word)
        if isKind(p, TokKind.lparen) {
            var depth: Int = 0
            var go: Bool = true
            while go && !atEndP(p) {
                if isKind(p, TokKind.lparen) { depth = depth + 1 }
                else if isKind(p, TokKind.rparen) {
                    depth = depth - 1
                    if depth == 0 { advP(&p); go = false }
                }
                if go { advP(&p) }
            }
        }
        skipNL(&p)
    }
    return naked
}

// A `@naked` / `@boot` function carries this in its modifiers; the printer
// drops it.
func nakedMark() -> Str { return "@naked " }

func parseDecl(_ p: inout Ps) using Alloc -> Nd {
    let naked = skipAttrsNaked(&p)
    let vis = own(parseVisibility(&p))
    if isKind(p, TokKind.kwStruct) { return parseStruct(&p, vis, false) }
    // §5 `linear struct Foo { … }` — the modifier (admitted on structs in v0.5)
    // is captured on the node; the printer drops it, matching the C++ dump.
    if eat(p, TokKind.kwLinear) { return parseStruct(&p, vis, true) }
    if isKind(p, TokKind.kwEnum) { return parseEnum(&p, vis) }
    if isKind(p, TokKind.kwConst) { return parseConst(&p, vis) }
    if isKind(p, TokKind.kwStatic) { return parseStatic(&p, vis) }
    if isKind(p, TokKind.kwOpaque) { return parseOpaque(&p, vis) }
    if isKind(p, TokKind.kwDerive) { return parseDerive(&p) }
    var mods: String = ""
    if naked { mods.append(nakedMark()) }
    if eat(p, TokKind.kwComptime) { mods.append("comptime ") }
    if eat(p, TokKind.kwAsync) { mods.append("async ") }
    if eat(p, TokKind.kwInout) { mods.append("inout ") }
    else if eat(p, TokKind.kwSink) { mods.append("sink ") }
    return parseFunc(&p, vis, mods)
}

func parseConst(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'const'
    let name = curText(p)
    advP(&p)
    var ty: Vec[Nd] = Vec.new()
    if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
    eat(p, TokKind.assign)
    return Nd.constD(vis, name, ty, bE(parseExpr(&p)))
}

func parseStatic(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'static'
    let name = curText(p)
    advP(&p)
    var ty: Vec[Nd] = Vec.new()
    if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
    var val: Vec[Nd] = Vec.new()
    if eat(p, TokKind.assign) { val.push(parseExpr(&p)) }
    return Nd.staticD(vis, name, ty, val)
}

func parseOpaque(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'opaque'
    eat(p, TokKind.kwType)
    let name = curText(p)
    advP(&p)
    eat(p, TokKind.assign)
    return Nd.opaqueD(vis, name, bT(parseType(&p)))
}

func parseDerive(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'derive'
    eat(p, TokKind.lparen)
    var protocols: Vec[Nd] = Vec.new()
    if !isKind(p, TokKind.rparen) {
        protocols.push(parseType(&p))
        while eat(p, TokKind.comma) { protocols.push(parseType(&p)) }
    }
    eat(p, TokKind.rparen)
    eat(p, TokKind.kwFor)
    return Nd.deriveD(protocols, bT(parseType(&p)))
}

func parseStruct(_ p: inout Ps, _ vis: String, _ isLinear: Bool) using Alloc -> Nd {
    advP(&p)  // 'struct'
    let name = curText(p)
    advP(&p)  // name
    let g = parseGenerics(&p)
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var fields: Vec[Nd] = Vec.new()
    var methods: Vec[Nd] = Vec.new()
    var deinitB: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        let naked = skipAttrsNaked(&p)  // field / method attributes (e.g. @bits(4)) — printer drops them
        if isKind(p, TokKind.kwFunc) || isKind(p, TokKind.kwAsync)
            || isKind(p, TokKind.kwInout) || isKind(p, TokKind.kwSink) {
            var mods: String = ""
            if naked { mods.append(nakedMark()) }
            if eat(p, TokKind.kwAsync) { mods.append("async ") }
            if eat(p, TokKind.kwInout) { mods.append("inout ") }
            else if eat(p, TokKind.kwSink) { mods.append("sink ") }
            methods.push(parseFunc(&p, "", mods))
        } else if isKind(p, TokKind.kwDeinit) {
            advP(&p)
            deinitB.push(parseBlock(&p))
        } else {
            var kind: String = ""
            if eat(p, TokKind.kwLet) { kind = "let " }
            else if eat(p, TokKind.kwVar) { kind = "var " }
            else if eat(p, TokKind.kwEmbed) { kind = "embed " }
            else { advP(&p) }
            let fname = curText(p)
            advP(&p)
            eat(p, TokKind.colon)
            fields.push(Nd.field(kind, fname, bT(parseType(&p))))
        }
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.structD(vis, name, fields, methods, deinitB, isLinear, g)
}

func parseEnum(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'enum'
    let name = curText(p)
    advP(&p)  // name
    let g = parseGenerics(&p)
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var cases: Vec[Nd] = Vec.new()
    var methods: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        if eat(p, TokKind.kwCase) {
            let cname = curText(p)
            advP(&p)
            var payload: Vec[Nd] = Vec.new()
            if eat(p, TokKind.lparen) {
                if !isKind(p, TokKind.rparen) {
                    payload.push(parsePayElem(&p))
                    while eat(p, TokKind.comma) { payload.push(parsePayElem(&p)) }
                }
                eat(p, TokKind.rparen)
            }
            cases.push(Nd.enumCase(cname, payload))
        } else if isKind(p, TokKind.at) {
            skipAttributes(&p)  // member attributes — printer drops them
        } else if isKind(p, TokKind.kwFunc) {
            methods.push(parseFunc(&p, "", ""))
        } else {
            advP(&p)
        }
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.enumD(vis, name, cases, methods, g)
}

func parsePayElem(_ p: inout Ps) using Alloc -> Nd {
    var label: String = ""
    if isKind(p, TokKind.identifier) && isKindAt(p, 1, TokKind.colon) {
        label = curText(p)
        advP(&p)
        advP(&p)  // ':'
    }
    return Nd.payElem(label, bT(parseType(&p)))
}

func parseFunc(_ p: inout Ps, _ vis: String, _ mods: String) using Alloc -> Nd {
    advP(&p)  // 'func'
    let name = curText(p)
    advP(&p)  // name
    var generics = parseGenerics(&p)
    let params = parseParams(&p)
    var usingCaps: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.kwUsing) {
        advP(&p)
        usingCaps.push(parseType(&p))
        while eat(p, TokKind.comma) { usingCaps.push(parseType(&p)) }
    }
    var throwsT: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.kwThrows) {
        advP(&p)
        eat(p, TokKind.lparen)
        throwsT.push(parseType(&p))
        eat(p, TokKind.rparen)
    }
    var result: Vec[Nd] = Vec.new()
    if eat(p, TokKind.arrow) { result.push(parseType(&p)) }
    // A trailing `where T: P & Q` clause folds its bounds back into the generic
    // params, exactly as the C++ parser does (so they print inline as `[T: P & Q]`).
    generics = mergeWhere(generics, parseWhereClause(&p))
    var body: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.lbrace) { body.push(parseBlock(&p)) }
    return Nd.funcD(vis, mods, name, generics, params, usingCaps, throwsT, result, body)
}

func parseWhereClause(_ p: inout Ps) using Alloc -> Vec[Nd] {
    if !isKind(p, TokKind.kwWhere) { var empty: Vec[Nd] = Vec.new(); return empty }
    advP(&p)  // 'where'
    var out: Vec[Nd] = Vec.new()
    var more: Bool = true
    while more {
        let nm = curText(p)
        advP(&p)
        eat(p, TokKind.colon)
        var bounds: Vec[Nd] = Vec.new()
        bounds.push(parseType(&p))
        while eat(p, TokKind.amp) { bounds.push(parseType(&p)) }
        out.push(Nd.genType(nm, bounds))
        if !eat(p, TokKind.comma) { more = false }
    }
    return out
}

// Merge where-clause bounds (a list of genType entries) into the matching generic
// params by name, returning a fresh generics list.
func mergeWhere(_ gens: Vec[Nd], _ wheres: Vec[Nd]) using Alloc -> Vec[Nd] {
    var out: Vec[Nd] = Vec.new()
    var i: Int = 0
    while i < gens.len() {
        out.push(mergeOne(gens.get(i) ?? errT(), wheres))
        i = i + 1
    }
    return out
}

func mergeOne(_ g: Nd, _ wheres: Vec[Nd]) using Alloc -> Nd {
    return match g {
        case .genType(let name, let bounds): Nd.genType(name, boundsFor(name, bounds, wheres))
        default: g
    }
}

func boundsFor(_ name: String, _ bounds: Vec[Nd], _ wheres: Vec[Nd]) using Alloc -> Vec[Nd] {
    var nb: Vec[Nd] = Vec.new()
    var i: Int = 0
    while i < bounds.len() {
        nb.push(bounds.get(i) ?? errT())
        i = i + 1
    }
    var w: Int = 0
    while w < wheres.len() {
        appendWhereBounds(name, wheres.get(w) ?? errT(), &nb)
        w = w + 1
    }
    return nb
}

func appendWhereBounds(_ name: String, _ entry: Nd, _ nb: inout Vec[Nd]) using Alloc {
    match entry {
        case .genType(let wname, let wbounds): appendIfMatch(name, wname, wbounds, &nb)
        default: nb.push(entry)
    }
}

func appendIfMatch(_ name: String, _ wname: String, _ wbounds: Vec[Nd], _ nb: inout Vec[Nd]) using Alloc {
    if streq(name, wname) {
        var i: Int = 0
        while i < wbounds.len() {
            nb.push(wbounds.get(i) ?? errT())
            i = i + 1
        }
    }
}

func parseParams(_ p: inout Ps) using Alloc -> Vec[Nd] {
    var params: Vec[Nd] = Vec.new()
    eat(p, TokKind.lparen)
    if !isKind(p, TokKind.rparen) {
        params.push(parseParam(&p))
        while eat(p, TokKind.comma) { params.push(parseParam(&p)) }
    }
    eat(p, TokKind.rparen)
    return params
}

func parseParam(_ p: inout Ps) using Alloc -> Nd {
    var labelOmitted: Bool = false
    var label: String = ""
    var name: String = ""
    if isKind(p, TokKind.lparen) {
        // §6 tuple-destructuring parameter `(a, b): T` — the C++ printer renders it
        // as `_ : T` (label omitted, no name, pattern dropped). Consume the pattern.
        skipBalancedParens(&p)
        labelOmitted = true
    } else if isKind(p, TokKind.underscore) {
        advP(&p)
        labelOmitted = true
        // `_ name:` binds a name; bare `_:` is an anonymous parameter (no name).
        if !isKind(p, TokKind.colon) { name = curText(p); advP(&p) }
    } else if isKind(p, TokKind.identifier) && isKindAt(p, 1, TokKind.identifier) {
        label = curText(p)
        advP(&p)
        name = curText(p)
        advP(&p)
    } else {
        name = curText(p)
        advP(&p)
    }
    eat(p, TokKind.colon)
    var nonesc: Bool = false
    if isKind(p, TokKind.kwNonescaping) { advP(&p); nonesc = true }
    var mode: String = ""
    if isKind(p, TokKind.kwInout) { advP(&p); mode = "inout " }
    else if isKind(p, TokKind.kwSink) { advP(&p); mode = "sink " }
    else if isKind(p, TokKind.kwRead) { advP(&p) }
    let ty = bT(parseType(&p))
    return Nd.param(labelOmitted, label, name, nonesc, mode, ty)
}

func parseType(_ p: inout Ps) using Alloc -> Nd {
    var base = parseTypeBase(&p)
    while isKind(p, TokKind.question) {
        advP(&p)
        base = Nd.opt(bT(base))
    }
    return base
}

func parseTypeBase(_ p: inout Ps) using Alloc -> Nd {
    if eat(p, TokKind.kwSome) { return Nd.someT(bT(parseType(&p))) }
    if eat(p, TokKind.kwDyn) { return Nd.dynT(bT(parseType(&p))) }
    if isKind(p, TokKind.at) {
        // §A8 @interrupt(T) in type position — InterruptType prints /*?type*/.
        advP(&p)  // '@'
        advP(&p)  // 'interrupt'
        eatV(p, TokKind.lparen)
        let t = parseType(&p)
        eatV(p, TokKind.rparen)
        return Nd.exoticE
    }
    if isKind(p, TokKind.lbracket) { return parseVectorType(&p) }
    if isKind(p, TokKind.lparen) { return parseParenType(&p) }
    // named type: path (identifier or `Self`) with optional generic args
    var path: String = curText(p)
    advP(&p)
    while isKind(p, TokKind.dot) {
        advP(&p)
        path.append(".")
        path.append(curText(p))
        advP(&p)
    }
    var hasGen: Bool = false
    var args: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.lbracket) {
        advP(&p)
        hasGen = true
        if !isKind(p, TokKind.rbracket) {
            args.push(parseType(&p))
            while eat(p, TokKind.comma) { args.push(parseType(&p)) }
        }
        eat(p, TokKind.rbracket)
    }
    return Nd.named(path, hasGen, args)
}

func parseVectorType(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '['
    var lenStr: String = ""
    if isKind(p, TokKind.intLit) { lenStr = curText(p); advP(&p) }
    else if isKind(p, TokKind.identifier) { lenStr = curText(p); advP(&p) }
    eat(p, TokKind.rbracket)
    return Nd.vecT(lenStr, bT(parseType(&p)))
}

func parseParenType(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '('
    var parts: Vec[Nd] = Vec.new()
    if !isKind(p, TokKind.rparen) {
        parts.push(parseType(&p))
        while eat(p, TokKind.comma) { parts.push(parseType(&p)) }
    }
    eat(p, TokKind.rparen)
    if isKind(p, TokKind.kwUsing) || isKind(p, TokKind.kwThrows) || isKind(p, TokKind.arrow) {
        var caps: Vec[Nd] = Vec.new()
        if eat(p, TokKind.kwUsing) {
            caps.push(parseType(&p))
            while eat(p, TokKind.comma) { caps.push(parseType(&p)) }
        }
        var thr: Vec[Nd] = Vec.new()
        if eat(p, TokKind.kwThrows) {
            eat(p, TokKind.lparen)
            thr.push(parseType(&p))
            eat(p, TokKind.rparen)
        }
        var res: Vec[Nd] = Vec.new()
        if eat(p, TokKind.arrow) { res.push(parseType(&p)) }
        return Nd.fnT(parts, caps, thr, res)
    }
    if parts.len() == 1 { return parts.get(0) ?? errT() }
    return Nd.tupleT(parts)
}

// Generic parameter list `[T, U: A & B, const N: Int]`. Returned for funcs (which
// print them) and consumed-and-dropped for structs / enums (whose printer omits them).
func parseGenerics(_ p: inout Ps) using Alloc -> Vec[Nd] {
    if !isKind(p, TokKind.lbracket) { var empty: Vec[Nd] = Vec.new(); return empty }
    advP(&p)  // '['
    var out: Vec[Nd] = Vec.new()
    var more: Bool = true
    while more {
        if eat(p, TokKind.kwConst) {
            let nm = curText(p)
            advP(&p)
            eat(p, TokKind.colon)
            out.push(Nd.genConst(nm, bT(parseType(&p))))
        } else {
            let nm = curText(p)
            advP(&p)
            var bounds: Vec[Nd] = Vec.new()
            if eat(p, TokKind.colon) {
                bounds.push(parseType(&p))
                while eat(p, TokKind.amp) { bounds.push(parseType(&p)) }
            }
            out.push(Nd.genType(nm, bounds))
        }
        if !eat(p, TokKind.comma) { more = false }
    }
    eat(p, TokKind.rbracket)
    return out
}

func parseBlock(_ p: inout Ps) using Alloc -> Nd {
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var stmts: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        stmts.push(parseStmt(&p))
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.block(stmts)
}

func parseStmt(_ p: inout Ps) using Alloc -> Nd {
    if isKind(p, TokKind.kwLet) {
        advP(&p)
        let pat = bP(parsePattern(&p))
        var ty: Vec[Nd] = Vec.new()
        if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
        eat(p, TokKind.assign)
        return Nd.letS(pat, ty, bE(parseExpr(&p)))
    }
    if isKind(p, TokKind.kwVar) {
        advP(&p)
        let pat = bP(parsePattern(&p))
        var ty: Vec[Nd] = Vec.new()
        if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
        eat(p, TokKind.assign)
        return Nd.varS(pat, ty, bE(parseExpr(&p)))
    }
    if isKind(p, TokKind.kwReturn) {
        advP(&p)
        var v: Vec[Nd] = Vec.new()
        if !isKind(p, TokKind.newline) && !isKind(p, TokKind.semicolon)
            && !isKind(p, TokKind.rbrace) && !atEndP(p) {
            v.push(parseExpr(&p))
        }
        return Nd.retS(v)
    }
    if isKind(p, TokKind.kwWhile) {
        advP(&p)
        // §9 `while let x = e { B }` is `while true { if let x = e { B } else
        // { break } }`, as the bootstrap parser desugars it.
        if eat(p, TokKind.kwLet) { return parseWhileLet(&p) }
        let cond = bE(parseExpr(&p))
        let body = bE(parseBlock(&p))
        return Nd.whileS(cond, body)
    }
    if isKind(p, TokKind.kwFor) {
        advP(&p)
        let pat = bP(parsePattern(&p))
        eat(p, TokKind.kwIn)
        let iter = bE(parseExpr(&p))
        let body = bE(parseBlock(&p))
        return Nd.forS(pat, iter, body)
    }
    if isKind(p, TokKind.kwWith) { return parseWith(&p) }
    if isKind(p, TokKind.kwBreak) {
        advP(&p)
        var label: String = ""
        if isKind(p, TokKind.identifier) { label = curText(p); advP(&p) }
        return Nd.breakS(label)
    }
    if isKind(p, TokKind.kwContinue) {
        advP(&p)
        var label: String = ""
        if isKind(p, TokKind.identifier) { label = curText(p); advP(&p) }
        return Nd.continueS(label)
    }
    let e = parseExpr(&p)
    if isAssignOp(curKind(p)) {
        let op = own(assignOpStr(curKind(p)))
        advP(&p)
        return Nd.assignS(op, bE(e), bE(parseExpr(&p)))
    }
    return Nd.exprS(bE(e))
}

func bP(_ x: Nd) using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); v.push(x); return v }

func firstCharLower(_ s: Str) -> Bool {
    let c = s.charAt(0) ?? ' '
    return c >= 'a' && c <= 'z'
}

// §17.4 `with` capability block. The C++ printer has no WithStmt case, so it dumps
// as /*?stmt*/ (our default arm); we parse the bindings and body precisely to keep
// the token stream aligned. A binding is `name (: type)? = expr` when the leading
// identifier is lowercase and followed by `=` or `:`, otherwise `cap_type (= expr)?`.
func parseWith(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'with'
    var caps: Vec[Nd] = Vec.new()
    var vals: Vec[Nd] = Vec.new()
    var more: Bool = true
    while more {
        if isKind(p, TokKind.identifier)
            && (isKindAt(p, 1, TokKind.assign) || isKindAt(p, 1, TokKind.colon))
            && firstCharLower(curRaw(p)) {
            advP(&p)  // name (value binding, grants no capability)
            if eat(p, TokKind.colon) { let t = parseType(&p) }
            eat(p, TokKind.assign)
            vals.push(parseExpr(&p))
        } else {
            caps.push(parseType(&p))  // capability-typed binding
            if eat(p, TokKind.assign) { vals.push(parseExpr(&p)) }
        }
        if !eat(p, TokKind.comma) { more = false }
    }
    let body = parseBlock(&p)
    return Nd.withS(caps, vals, bE(body))
}

func parsePattern(_ p: inout Ps) using Alloc -> Nd {
    var alts: Vec[Nd] = Vec.new()
    alts.push(parsePatAlt(&p))
    if !isKind(p, TokKind.pipe) { return alts.get(0) ?? errP() }
    while eat(p, TokKind.pipe) { alts.push(parsePatAlt(&p)) }
    return Nd.orP(alts)
}

func parsePatAlt(_ p: inout Ps) using Alloc -> Nd {
    if isKind(p, TokKind.underscore) { advP(&p); return Nd.wildcard }
    if isKind(p, TokKind.lparen) {
        advP(&p)
        var elems: Vec[Nd] = Vec.new()
        if !isKind(p, TokKind.rparen) {
            elems.push(parsePattern(&p))
            while eat(p, TokKind.comma) { elems.push(parsePattern(&p)) }
        }
        eat(p, TokKind.rparen)
        if elems.len() == 1 { return elems.get(0) ?? errP() }
        return Nd.tupleP(elems)
    }
    if isKind(p, TokKind.kwLet) {
        advP(&p)
        let n = curText(p)
        advP(&p)
        return Nd.bindP(n)
    }
    if isKind(p, TokKind.dot) {
        advP(&p)
        let cname = curText(p)
        advP(&p)
        var children: Vec[Nd] = Vec.new()
        if eat(p, TokKind.lparen) {
            if !isKind(p, TokKind.rparen) {
                children.push(parsePattern(&p))
                while eat(p, TokKind.comma) { children.push(parsePattern(&p)) }
            }
            eat(p, TokKind.rparen)
        }
        return Nd.enumP(cname, children)
    }
    if isKind(p, TokKind.identifier) {
        let n = curText(p)
        advP(&p)
        return Nd.identP(n)
    }
    if isKind(p, TokKind.intLit) || isKind(p, TokKind.floatLit) || isKind(p, TokKind.stringLit)
        || isKind(p, TokKind.charLit) || isKind(p, TokKind.kwTrue) || isKind(p, TokKind.kwFalse) {
        let lit = parsePrimary(&p)
        if isKind(p, TokKind.dotDot) || isKind(p, TokKind.dotDotLt) {
            let incl = isKind(p, TokKind.dotDot)
            advP(&p)
            let high = parsePrimary(&p)
            return Nd.rangeP(bE(lit), bE(high), incl)
        }
        return Nd.litP(bE(lit))
    }
    return Nd.wildcard
}

func parseExpr(_ p: inout Ps) using Alloc -> Nd { return parseExprBp(&p, 0) }

func parseExprBp(_ p: inout Ps, _ minBp: Int) using Alloc -> Nd {
    var lhs = parsePrefix(&p)
    var go: Bool = true
    while go {
        if isKind(p, TokKind.kwAs) || isKind(p, TokKind.kwAsQuestion) {
            let isOpt = isKind(p, TokKind.kwAsQuestion)
            advP(&p)
            lhs = Nd.asE(bE(lhs), bT(parseType(&p)), isOpt)
        } else {
            let bp = infixBp(curKind(p))
            if bp.left < minBp || bp.left == 0 {
                go = false
            } else {
                let op = own(binOpStr(curKind(p)))
                advP(&p)
                let rhs = parseExprBp(&p, bp.right)
                lhs = Nd.binary(op, bE(lhs), bE(rhs))
            }
        }
    }
    return lhs
}

func parsePrefix(_ p: inout Ps) using Alloc -> Nd {
    // §17.7 prefix expressions. copy / await / spawn / try print fully; throw wraps
    // its operand but the C++ printer has no ThrowExpr case, so it dumps /*?expr*/.
    if eat(p, TokKind.kwCopy) { return Nd.prefixE("copy ", bE(parsePrefix(&p))) }
    if eat(p, TokKind.kwAwait) { return Nd.prefixE("await ", bE(parsePrefix(&p))) }
    if eat(p, TokKind.kwSpawn) { return Nd.prefixE("spawn ", bE(parsePrefix(&p))) }
    if eat(p, TokKind.kwThrow) { return Nd.throwE(bE(parsePrefix(&p))) }
    if isKind(p, TokKind.kwTry) || isKind(p, TokKind.kwTryQuestion) || isKind(p, TokKind.kwTryBang) {
        var form: String = "try "
        if isKind(p, TokKind.kwTryQuestion) { form = "try? " }
        else if isKind(p, TokKind.kwTryBang) { form = "try! " }
        advP(&p)
        return Nd.prefixE(form, bE(parsePrefix(&p)))
    }
    if eat(p, TokKind.minus) { return Nd.unary("-", bE(parsePrefix(&p))) }
    if eat(p, TokKind.bang) { return Nd.unary("!", bE(parsePrefix(&p))) }
    if eat(p, TokKind.tilde) { return Nd.unary("~", bE(parsePrefix(&p))) }
    if eat(p, TokKind.amp) { return Nd.addrOf(bE(parsePrefix(&p))) }
    let prim = parsePrimary(&p)
    return parsePostfix(&p, prim)
}

func parsePrimary(_ p: inout Ps) using Alloc -> Nd {
    if isKind(p, TokKind.intLit) { let t = curText(p); advP(&p); return Nd.intLit(t) }
    if isKind(p, TokKind.floatLit) { let t = curText(p); advP(&p); return Nd.floatLit(t) }
    if isKind(p, TokKind.stringLit) {
        let raw = curRaw(p); advP(&p)
        var inner: String = ""
        if raw.len() >= 2 { inner = own(raw.slice(1, raw.len() - 1)) }
        return Nd.strLit(inner)
    }
    if isKind(p, TokKind.byteStringLit) {
        let raw = curRaw(p); advP(&p)
        var inner: String = ""
        if raw.len() >= 3 { inner = own(raw.slice(2, raw.len() - 1)) }
        return Nd.byteStrLit(inner)
    }
    if isKind(p, TokKind.charLit) {
        let raw = curRaw(p); advP(&p)
        var inner: String = ""
        if raw.len() >= 2 { inner = own(raw.slice(1, raw.len() - 1)) }
        return Nd.charLit(inner)
    }
    if isKind(p, TokKind.kwTrue) { advP(&p); return Nd.boolLit(true) }
    if isKind(p, TokKind.kwFalse) { advP(&p); return Nd.boolLit(false) }
    if isKind(p, TokKind.kwNil) { advP(&p); return Nd.nilLit }
    if isKind(p, TokKind.kwSelfLower) { advP(&p); return Nd.selfE }
    if isKind(p, TokKind.identifier) { let t = curText(p); advP(&p); return Nd.ident(t) }
    if isKind(p, TokKind.dot) {
        advP(&p)
        let n = curText(p)
        advP(&p)
        return Nd.leadingDot(n)
    }
    if isKind(p, TokKind.lparen) {
        advP(&p)
        let first = parseExpr(&p)
        if eat(p, TokKind.comma) {
            // tuple literal: keep the elements (still printed as /*?expr*/).
            var elems: Vec[Nd] = Vec.new()
            elems.push(first)
            elems.push(parseExpr(&p))
            while eat(p, TokKind.comma) { elems.push(parseExpr(&p)) }
            eat(p, TokKind.rparen)
            return Nd.tupleLit(elems)
        }
        eat(p, TokKind.rparen)
        return Nd.paren(bE(first))
    }
    if isKind(p, TokKind.lbracket) {
        // array / vector literal: keep the elements (still printed as /*?expr*/).
        advP(&p)
        var elems: Vec[Nd] = Vec.new()
        if !isKind(p, TokKind.rbracket) {
            elems.push(parseExpr(&p))
            // A trailing comma before `]` is allowed, as in the bootstrap.
            while eat(p, TokKind.comma) {
                if isKind(p, TokKind.rbracket) { break }
                elems.push(parseExpr(&p))
            }
        }
        eat(p, TokKind.rbracket)
        return Nd.vecLit(elems)
    }
    if isKind(p, TokKind.kwIf) { return parseIf(&p) }
    if isKind(p, TokKind.kwMatch) { return parseMatch(&p) }
    if isKind(p, TokKind.kwSelect) {
        // §11 select { ... } — SelectExpr has no printer case (/*?expr*/); consume
        // the balanced body to stay token-aligned.
        advP(&p)
        skipBalancedBraces(&p)
        return Nd.exoticE
    }
    if isKind(p, TokKind.kwQuote) { return parseQuote(&p) }
    if isKind(p, TokKind.dollar) { return parseSplice(&p) }
    if isKind(p, TokKind.kwDo) { return parseDoCatch(&p) }
    if isKind(p, TokKind.kwComptime) {
        advP(&p)
        if isKind(p, TokKind.lbrace) { let b = parseBlock(&p) } else { let e = parseExpr(&p) }
        return Nd.exoticE
    }
    if isKind(p, TokKind.at) {
        // @embed(...) / @macro(...) — both print /*?expr*/ in the C++ printer.
        advP(&p)  // '@'
        advP(&p)  // intrinsic / macro name
        if isKind(p, TokKind.lparen) { skipBalancedParens(&p) }
        return Nd.exoticE
    }
    if isKind(p, TokKind.interpBegin) { return parseInterpString(&p) }
    if isKind(p, TokKind.lbrace) {
        if isClosureAhead(p) { return parseClosure(&p) }
        return parseBlock(&p)
    }
    // unsupported construct in this slice; emit a stub and advance.
    advP(&p)
    return Nd.ident("<error>")
}

// `do { body } catch (NAME: E) { handler }` (or bare `catch NAME`). Prints fully.
func parseDoCatch(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'do'
    let doBody = bE(parseBlock(&p))
    eat(p, TokKind.kwCatch)
    var errName: String = ""
    var errType: Vec[Nd] = Vec.new()
    if eat(p, TokKind.lparen) {
        errName = curText(p)
        advP(&p)
        eat(p, TokKind.colon)
        errType.push(parseType(&p))
        eatV(p, TokKind.rparen)
    } else if isKind(p, TokKind.identifier) {
        errName = curText(p)
        advP(&p)
    }
    if eat(p, TokKind.kwWhere) { let guard = parseExpr(&p) }
    let catchBody = bE(parseBlock(&p))
    return Nd.doCatchE(doBody, errName, errType, catchBody)
}

// §12.4 `quote { EXPR }` (expression form, printed fully) vs `quote { <decls> }` (a
// declaration-macro template, printed /*?expr*/). Disambiguated by a declaration
// keyword at brace depth 1.
func parseQuote(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'quote'  (now at '{')
    if isDeclQuoteAhead(p) {
        skipBalancedBraces(&p)
        return Nd.exoticE
    }
    eatV(p, TokKind.lbrace)
    skipNL(&p)
    let inner = parseExpr(&p)
    skipNL(&p)
    eatV(p, TokKind.rbrace)
    return Nd.quoteE(bE(inner))
}

func isDeclQuoteAhead(_ p: inout Ps) -> Bool {
    var i: Int = p.pos + 1
    var depth: Int = 1
    var found: Bool = false
    var go: Bool = true
    while go {
        let k = kindAtAbs(p, i)
        if isKind2(k, TokKind.eof) { go = false }
        else if isKind2(k, TokKind.lbrace) || isKind2(k, TokKind.lparen) || isKind2(k, TokKind.lbracket) {
            depth = depth + 1
        } else if isKind2(k, TokKind.rbrace) || isKind2(k, TokKind.rparen) || isKind2(k, TokKind.rbracket) {
            depth = depth - 1
            if depth == 0 { go = false }
        } else if depth == 1 && isDeclKw(k) {
            found = true
            go = false
        }
        i = i + 1
    }
    return found
}

func isDeclKw(_ k: TokKind) -> Bool {
    return isKind2(k, TokKind.kwFunc) || isKind2(k, TokKind.kwStruct) || isKind2(k, TokKind.kwEnum)
        || isKind2(k, TokKind.kwProtocol) || isKind2(k, TokKind.kwExtension)
        || isKind2(k, TokKind.kwConst) || isKind2(k, TokKind.kwStatic)
}

// §12.4 splice `$ident` / `$(expr)`. The C++ printer renders it bare when the inner
// is an identifier (so `$(x)` also prints `$x`), otherwise with parens.
func parseSplice(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '$'
    if eat(p, TokKind.lparen) {
        let inner = parseExpr(&p)
        eatV(p, TokKind.rparen)
        let bare = isIdentNode(inner)
        return Nd.spliceE(bare, bE(inner))
    }
    if isKind(p, TokKind.identifier) {
        let n = curText(p)
        advP(&p)
        return Nd.spliceE(true, bE(Nd.ident(n)))
    }
    return Nd.exoticE
}

func isIdentNode(_ e: Nd) -> Bool {
    return match e {
        case .ident(let n): true
        default: false
    }
}

func skipBalancedParens(_ p: inout Ps) {
    var depth: Int = 0
    var go: Bool = true
    while go && !atEndP(p) {
        if isKind(p, TokKind.lparen) { depth = depth + 1 }
        else if isKind(p, TokKind.rparen) {
            depth = depth - 1
            if depth == 0 { advP(&p); go = false }
        }
        if go { advP(&p) }
    }
}

func skipBalancedBraces(_ p: inout Ps) {
    var depth: Int = 0
    var go: Bool = true
    while go && !atEndP(p) {
        if isKind(p, TokKind.lbrace) { depth = depth + 1 }
        else if isKind(p, TokKind.rbrace) {
            depth = depth - 1
            if depth == 0 { advP(&p); go = false }
        }
        if go { advP(&p) }
    }
}

// An interpolated string `"...\(e)..."` lexes as InterpStringBegin (Part | LParen
// expr RParen)* InterpStringEnd; the C++ printer has no InterpStringExpr case, so
// it dumps /*?expr*/. We consume the sequence to stay token-aligned.
func parseInterpString(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // InterpStringBegin
    var parts: Vec[String] = Vec.new()
    var exprs: Vec[Nd] = Vec.new()
    var go: Bool = true
    while go && !isKind(p, TokKind.interpEnd) && !atEndP(p) {
        if isKind(p, TokKind.interpPart) { parts.push(curText(p)); advP(&p) }
        else if isKind(p, TokKind.lparen) {
            advP(&p)
            exprs.push(parseExpr(&p))
            eatV(p, TokKind.rparen)
        } else { advP(&p) }
    }
    eatV(p, TokKind.interpEnd)
    return Nd.interpE(parts, exprs)
}

// A `{ params => body }` closure (vs a block). The C++ printer has no ClosureExpr
// case, so it dumps /*?expr*/. Detect by scanning for a `=>` at brace depth 1.
func isClosureAhead(_ p: inout Ps) -> Bool {
    var i: Int = p.pos + 1
    var depth: Int = 1
    var found: Bool = false
    var go: Bool = true
    while go {
        let k = kindAtAbs(p, i)
        if isKind2(k, TokKind.eof) { go = false }
        else if isKind2(k, TokKind.lbrace) || isKind2(k, TokKind.lparen) || isKind2(k, TokKind.lbracket) {
            depth = depth + 1
        } else if isKind2(k, TokKind.rbrace) || isKind2(k, TokKind.rparen) || isKind2(k, TokKind.rbracket) {
            depth = depth - 1
            if depth == 0 { go = false }
        } else if depth == 1 && isKind2(k, TokKind.fatArrow) {
            found = true
            go = false
        }
        i = i + 1
    }
    return found
}

func kindAtAbs(_ p: inout Ps, _ i: Int) -> TokKind { let t = p.toks.get(i) ?? eofTok(); return t.kind }
func isKind2(_ a: TokKind, _ b: TokKind) -> Bool { return streq(spelling(a), spelling(b)) }

func parseClosure(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '{'
    var params: Vec[Nd] = Vec.new()
    if !isKind(p, TokKind.fatArrow) {
        if isKind(p, TokKind.identifier) {
            params.push(Nd.ident(curText(p)))
            advP(&p)
            while eat(p, TokKind.comma) {
                if isKind(p, TokKind.identifier) { params.push(Nd.ident(curText(p))); advP(&p) }
            }
        }
    }
    eat(p, TokKind.fatArrow)
    skipNL(&p)
    var body: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        body.push(parseStmt(&p))
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.closureE(params, body)
}

// A match expression. The C++ printer has no MatchExpr case, so it dumps as
// /*?expr*/; we still parse the arms (pattern / guard / body) precisely so the
// surrounding token stream stays aligned, then discard them.
func parseMatch(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'match'
    let scrut = parseExpr(&p)
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var arms: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        if eat(p, TokKind.kwDefault) {
            eat(p, TokKind.colon)
            arms.push(Nd.matchArm(true, Vec.new(), Vec.new(), bE(parseExpr(&p))))
        } else {
            eat(p, TokKind.kwCase)
            let pat = parsePattern(&p)
            var guard: Vec[Nd] = Vec.new()
            if eat(p, TokKind.kwWhere) { guard.push(parseExpr(&p)) }
            eat(p, TokKind.colon)
            arms.push(Nd.matchArm(false, bP(pat), guard, bE(parseExpr(&p))))
        }
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.matchE(bE(scrut), arms)
}

func parseWhileLet(_ p: inout Ps) using Alloc -> Nd {
    let letName = curText(p)
    advP(&p)
    eat(p, TokKind.assign)
    let letInit = bE(parseExpr(&p))
    let thenB = bE(parseBlock(&p))
    var brk: Vec[Nd] = Vec.new()
    brk.push(Nd.breakS(""))
    let els = bE(Nd.block(brk))
    let ifx = Nd.ifE(letName, letInit, Vec.new(), thenB, els)
    var body: Vec[Nd] = Vec.new()
    body.push(Nd.exprS(bE(ifx)))
    return Nd.whileS(bE(Nd.boolLit(true)), bE(Nd.block(body)))
}

func parseIf(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'if'
    var letName: String = ""
    var letInit: Vec[Nd] = Vec.new()
    var cond: Vec[Nd] = Vec.new()
    if eat(p, TokKind.kwLet) {
        letName = curText(p)
        advP(&p)
        eat(p, TokKind.assign)
        letInit.push(parseExpr(&p))
    } else {
        cond.push(parseExpr(&p))
    }
    let thenB = bE(parseBlock(&p))
    var els: Vec[Nd] = Vec.new()
    if eat(p, TokKind.kwElse) {
        if isKind(p, TokKind.kwIf) { els.push(parsePrimary(&p)) }
        else { els.push(parseBlock(&p)) }
    }
    return Nd.ifE(letName, letInit, cond, thenB, els)
}

func parsePostfix(_ p: inout Ps, _ start: Nd) using Alloc -> Nd {
    var lhs = start
    var go: Bool = true
    while go {
        if isKind(p, TokKind.lparen) {
            advP(&p)
            var args: Vec[Nd] = Vec.new()
            if !isKind(p, TokKind.rparen) {
                args.push(parseArg(&p))
                while eat(p, TokKind.comma) { args.push(parseArg(&p)) }
            }
            eat(p, TokKind.rparen)
            lhs = Nd.call(bE(lhs), args)
        } else if isKind(p, TokKind.dot)
                  || (isKind(p, TokKind.question) && isKindAt(p, 1, TokKind.dot)) {
            let isChain = isKind(p, TokKind.question)
            if isChain { advP(&p) }
            advP(&p)  // '.'
            let n = curText(p)
            advP(&p)
            lhs = Nd.member(bE(lhs), n, isChain)
        } else if isKind(p, TokKind.lbracket) {
            advP(&p)
            var idxs: Vec[Nd] = Vec.new()
            if !isKind(p, TokKind.rbracket) {
                idxs.push(parseExpr(&p))
                while eat(p, TokKind.comma) { idxs.push(parseExpr(&p)) }
            }
            eat(p, TokKind.rbracket)
            lhs = Nd.index(bE(lhs), idxs)
        } else if isKind(p, TokKind.bang) {
            advP(&p)
            lhs = Nd.unary("!", bE(lhs))
        } else {
            go = false
        }
    }
    return lhs
}

func parseArg(_ p: inout Ps) using Alloc -> Nd {
    var label: String = ""
    if isKind(p, TokKind.identifier) && isKindAt(p, 1, TokKind.colon) {
        label = curText(p)
        advP(&p)
        advP(&p)  // ':'
    }
    var isInout: Bool = false
    if eat(p, TokKind.amp) { isInout = true }
    return Nd.arg(label, isInout, bE(parseExpr(&p)))
}

// ----- printer (mirrors src/ast/printer.cpp exactly) ------------------------
func indentTo(_ n: Int) using Log {
    var i: Int = 0
    while i < n { print("    "); i = i + 1 }
}

func printUnit(_ u: NUnit) using Alloc, Log {
    if u.hasMod {
        print("module ")
        print(u.modPath)
        print("\n\n")
    }
    var i: Int = 0
    while i < u.imports.len() {
        printImport(u.imports.get(i) ?? Nd.importD(false, "?"))
        i = i + 1
    }
    if u.imports.len() > 0 { print("\n") }
    var j: Int = 0
    while j < u.decls.len() {
        printDecl(u.decls.get(j) ?? Nd.importD(false, "?"), 0)
        print("\n")
        j = j + 1
    }
}

func printImport(_ d: Nd) using Alloc, Log {
    match d {
        case .importD(let isC, let payload): printImportBody(isC, payload)
        default: print("")
    }
}

func printImportBody(_ isC: Bool, _ payload: String) using Log {
    if isC {
        print("import c \"")
        print(payload)
        print("\"\n")
    } else {
        print("import ")
        print(payload)
        print("\n")
    }
}

func printDecl(_ d: Nd, _ indent: Int) using Alloc, Log {
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body):
            printFunc(vis, mods, name, gens, params, caps, thr, res, body, indent)
        case .structD(let vis, let name, let fields, let methods, let deinitB, let isLinear, let generics):
            printStruct(vis, name, fields, methods, deinitB, indent)
        case .enumD(let vis, let name, let cases, let methods, let generics):
            printEnum(vis, name, cases, methods, indent)
        case .constD(let vis, let name, let ty, let val): printConst(vis, name, ty, val, indent)
        case .staticD(let vis, let name, let ty, let val): printStatic(vis, name, ty, val, indent)
        case .opaqueD(let vis, let name, let under): printOpaque(vis, name, under, indent)
        case .deriveD(let protocols, let target): printDerive(protocols, target, indent)
        default: print("")
    }
}

func printStruct(_ vis: String, _ name: String, _ fields: Vec[Nd], _ methods: Vec[Nd],
                 _ deinitB: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("struct ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < fields.len() {
        printField(fields.get(i) ?? errE(), indent + 1)
        i = i + 1
    }
    var m: Int = 0
    while m < methods.len() {
        printDecl(methods.get(m) ?? errE(), indent + 1)
        m = m + 1
    }
    if deinitB.len() > 0 {
        indentTo(indent + 1)
        print("deinit ")
        printExpr(deinitB.get(0) ?? errE())
        print("\n")
    }
    indentTo(indent)
    print("}\n")
}

func printField(_ f: Nd, _ indent: Int) using Alloc, Log {
    match f {
        case .field(let kind, let name, let ty): printFieldBody(kind, name, ty, indent)
        default: print("")
    }
}

func printFieldBody(_ kind: String, _ name: String, _ ty: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(kind)
    print(name)
    print(": ")
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
    print("\n")
}

func printEnum(_ vis: String, _ name: String, _ cases: Vec[Nd], _ methods: Vec[Nd],
               _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("enum ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < cases.len() {
        printEnumCase(cases.get(i) ?? errE(), indent + 1)
        i = i + 1
    }
    var m: Int = 0
    while m < methods.len() {
        printDecl(methods.get(m) ?? errE(), indent + 1)
        m = m + 1
    }
    indentTo(indent)
    print("}\n")
}

func printEnumCase(_ c: Nd, _ indent: Int) using Alloc, Log {
    match c {
        case .enumCase(let name, let payload): printEnumCaseBody(name, payload, indent)
        default: print("")
    }
}

func printEnumCaseBody(_ name: String, _ payload: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print("case ")
    print(name)
    if payload.len() > 0 {
        print("(")
        var i: Int = 0
        while i < payload.len() {
            if i > 0 { print(", ") }
            printPayElem(payload.get(i) ?? errE())
            i = i + 1
        }
        print(")")
    }
    print("\n")
}

func printPayElem(_ e: Nd) using Alloc, Log {
    match e {
        case .payElem(let label, let ty): printPayElemBody(label, ty)
        default: print("")
    }
}

func printPayElemBody(_ label: String, _ ty: Vec[Nd]) using Alloc, Log {
    if !streq(label, "") {
        print(label)
        print(": ")
    }
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
}

func printFunc(_ vis: String, _ mods: String, _ name: String, _ gens: Vec[Nd], _ params: Vec[Nd], _ caps: Vec[Nd],
               _ thr: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    if containsSub(mods, nakedMark()) { print(mods.slice(nakedMark().len(), mods.len())) } else { print(mods) }
    print("func ")
    print(name)
    printGenerics(gens)
    print("(")
    var i: Int = 0
    while i < params.len() {
        if i > 0 { print(", ") }
        printParam(params.get(i) ?? errParam())
        i = i + 1
    }
    print(")")
    if caps.len() > 0 {
        print(" using ")
        var c: Int = 0
        while c < caps.len() {
            if c > 0 { print(", ") }
            printType(caps.get(c) ?? errT())
            c = c + 1
        }
    }
    if thr.len() > 0 {
        print(" throws(")
        printType(thr.get(0) ?? errT())
        print(")")
    }
    if res.len() > 0 {
        print(" -> ")
        printType(res.get(0) ?? errT())
    }
    if body.len() > 0 {
        print(" ")
        printExpr(body.get(0) ?? errE())
    }
    print("\n")
}

func printConst(_ vis: String, _ name: String, _ ty: Vec[Nd], _ val: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("const ")
    print(name)
    if ty.len() > 0 {
        print(": ")
        printType(ty.get(0) ?? errT())
    }
    print(" = ")
    if val.len() > 0 { printExpr(val.get(0) ?? errE()) }
    print("\n")
}

func printStatic(_ vis: String, _ name: String, _ ty: Vec[Nd], _ val: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("static ")
    print(name)
    print(": ")
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
    print(" = ")
    if val.len() > 0 { printExpr(val.get(0) ?? errE()) }
    print("\n")
}

func printOpaque(_ vis: String, _ name: String, _ under: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("opaque type ")
    print(name)
    print(" = ")
    printType(under.get(0) ?? errT())
    print("\n")
}

func printDerive(_ protocols: Vec[Nd], _ target: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print("derive(")
    var i: Int = 0
    while i < protocols.len() {
        if i > 0 { print(", ") }
        printType(protocols.get(i) ?? errT())
        i = i + 1
    }
    print(") for ")
    printType(target.get(0) ?? errT())
    print("\n")
}

func printGenerics(_ gens: Vec[Nd]) using Alloc, Log {
    if gens.len() == 0 { return }
    print("[")
    var i: Int = 0
    while i < gens.len() {
        if i > 0 { print(", ") }
        printGenericParam(gens.get(i) ?? errT())
        i = i + 1
    }
    print("]")
}

func printGenericParam(_ g: Nd) using Alloc, Log {
    match g {
        case .genConst(let name, let ct): printGenConst(name, ct)
        case .genType(let name, let bounds): printGenType(name, bounds)
        default: print("")
    }
}

func printGenConst(_ name: String, _ ct: Vec[Nd]) using Alloc, Log {
    print("const ")
    print(name)
    print(": ")
    if ct.len() > 0 { printType(ct.get(0) ?? errT()) }
}

func printGenType(_ name: String, _ bounds: Vec[Nd]) using Alloc, Log {
    print(name)
    if bounds.len() > 0 {
        print(": ")
        var i: Int = 0
        while i < bounds.len() {
            if i > 0 { print(" & ") }
            printType(bounds.get(i) ?? errT())
            i = i + 1
        }
    }
}

func errParam() using Alloc -> Nd {
    return Nd.param(false, "", "?", false, "", noT())
}

func printParam(_ pm: Nd) using Alloc, Log {
    match pm {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): printParamBody(lo, lbl, nm, ne, md, ty)
        default: print("")
    }
}

func printParamBody(_ lo: Bool, _ lbl: String, _ nm: String, _ ne: Bool, _ md: String, _ ty: Vec[Nd]) using Alloc, Log {
    if lo {
        print("_ ")
    } else if !streq(lbl, "") && !streq(lbl, nm) {
        print(lbl)
        print(" ")
    }
    print(nm)
    print(": ")
    if ne { print("nonescaping ") }
    print(md)
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
}

func printType(_ t: Nd) using Alloc, Log {
    match t {
        case .named(let path, let hasGen, let args): printNamed(path, hasGen, args)
        case .opt(let inner): printOpt(inner)
        case .someT(let inner): printPrefixType("some ", inner)
        case .dynT(let inner): printPrefixType("dyn ", inner)
        case .vecT(let len, let elem): printVecType(len, elem)
        case .tupleT(let elems): printTupleType(elems)
        case .fnT(let params, let caps, let thr, let res): printFnType(params, caps, thr, res)
        default: print("/*?type*/")
    }
}

func printPrefixType(_ kw: Str, _ inner: Vec[Nd]) using Alloc, Log {
    print(kw)
    printType(inner.get(0) ?? errT())
}

func printVecType(_ len: String, _ elem: Vec[Nd]) using Alloc, Log {
    print("[")
    print(len)
    print("]")
    printType(elem.get(0) ?? errT())
}

func printTypeList(_ ts: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < ts.len() {
        if i > 0 { print(", ") }
        printType(ts.get(i) ?? errT())
        i = i + 1
    }
}

func printTupleType(_ elems: Vec[Nd]) using Alloc, Log {
    print("(")
    printTypeList(elems)
    print(")")
}

func printFnType(_ params: Vec[Nd], _ caps: Vec[Nd], _ thr: Vec[Nd], _ res: Vec[Nd]) using Alloc, Log {
    print("(")
    printTypeList(params)
    print(")")
    if caps.len() > 0 {
        print(" using ")
        printTypeList(caps)
    }
    if thr.len() > 0 {
        print(" throws(")
        printType(thr.get(0) ?? errT())
        print(")")
    }
    if res.len() > 0 {
        print(" -> ")
        printType(res.get(0) ?? errT())
    }
}

func printNamed(_ path: String, _ hasGen: Bool, _ args: Vec[Nd]) using Alloc, Log {
    print(path)
    if hasGen {
        print("[")
        var i: Int = 0
        while i < args.len() {
            if i > 0 { print(", ") }
            printType(args.get(i) ?? errT())
            i = i + 1
        }
        print("]")
    }
}

func printOpt(_ inner: Vec[Nd]) using Alloc, Log {
    printType(inner.get(0) ?? errT())
    print("?")
}

func printBlock(_ stmts: Vec[Nd], _ indent: Int) using Alloc, Log {
    print("{\n")
    var i: Int = 0
    while i < stmts.len() {
        printStmt(stmts.get(i) ?? Nd.exprS(noE()), indent + 1)
        i = i + 1
    }
    indentTo(indent)
    print("}")
}

func printStmt(_ s: Nd, _ indent: Int) using Alloc, Log {
    indentTo(indent)
    match s {
        case .letS(let pat, let ty, let value): printBinding("let ", pat, ty, value)
        case .varS(let pat, let ty, let value): printBinding("var ", pat, ty, value)
        case .exprS(let e): printExprStmt(e)
        case .retS(let v): printReturn(v)
        case .assignS(let op, let t, let v): printAssign(op, t, v)
        case .whileS(let c, let b): printWhile(c, b)
        case .forS(let pat, let iter, let b): printFor(pat, iter, b)
        case .breakS(let label): printBreakContinue("break", label)
        case .continueS(let label): printBreakContinue("continue", label)
        default: print("/*?stmt*/\n")
    }
}

func printFor(_ pat: Vec[Nd], _ iter: Vec[Nd], _ b: Vec[Nd]) using Alloc, Log {
    print("for ")
    printPat(pat.get(0) ?? errP())
    print(" in ")
    printExpr(iter.get(0) ?? errE())
    print(" ")
    printExpr(b.get(0) ?? errE())
    print("\n")
}

func printBreakContinue(_ kw: Str, _ label: String) using Log {
    print(kw)
    if !streq(label, "") {
        print(" ")
        print(label)
    }
    print("\n")
}

func printBinding(_ kw: Str, _ pat: Vec[Nd], _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    print(kw)
    printPat(pat.get(0) ?? errP())
    if ty.len() > 0 {
        print(": ")
        printType(ty.get(0) ?? errT())
    }
    print(" = ")
    if value.len() > 0 { printExpr(value.get(0) ?? errE()) }
    print("\n")
}

func printExprStmt(_ e: Vec[Nd]) using Alloc, Log {
    printExpr(e.get(0) ?? errE())
    print("\n")
}

func printReturn(_ v: Vec[Nd]) using Alloc, Log {
    print("return")
    if v.len() > 0 {
        print(" ")
        printExpr(v.get(0) ?? errE())
    }
    print("\n")
}

func printAssign(_ op: String, _ t: Vec[Nd], _ v: Vec[Nd]) using Alloc, Log {
    printExpr(t.get(0) ?? errE())
    print(" ")
    print(op)
    print(" ")
    printExpr(v.get(0) ?? errE())
    print("\n")
}

func printWhile(_ c: Vec[Nd], _ b: Vec[Nd]) using Alloc, Log {
    print("while ")
    printExpr(c.get(0) ?? errE())
    print(" ")
    printExpr(b.get(0) ?? errE())
    print("\n")
}

func printPat(_ p: Nd) using Alloc, Log {
    match p {
        case .wildcard: print("_")
        case .identP(let n): print(n)
        case .bindP(let n): printBind(n)
        case .litP(let inner): printExpr(inner.get(0) ?? errE())
        case .enumP(let cname, let children): printEnumPat(cname, children)
        default: print("/*?pat*/")
    }
}

func printBind(_ n: String) using Log { print("let "); print(n) }

func printEnumPat(_ cname: String, _ children: Vec[Nd]) using Alloc, Log {
    print(".")
    print(cname)
    if children.len() > 0 {
        print("(")
        var i: Int = 0
        while i < children.len() {
            if i > 0 { print(", ") }
            printPat(children.get(i) ?? errP())
            i = i + 1
        }
        print(")")
    }
}

func printExpr(_ e: Nd) using Alloc, Log {
    match e {
        case .intLit(let t): print(t)
        case .floatLit(let t): print(t)
        case .strLit(let t): printQuoted("\"", t, "\"")
        case .byteStrLit(let t): printQuoted("b\"", t, "\"")
        case .charLit(let t): printQuoted("'", t, "'")
        case .boolLit(let b): printBool(b)
        case .nilLit: print("/*?expr*/")
        case .ident(let n): print(n)
        case .selfE: print("self")
        case .leadingDot(let n): printLeadingDot(n)
        case .paren(let inner): printParen(inner)
        case .unary(let op, let operand): printUnary(op, operand)
        case .binary(let op, let l, let r): printBinary(op, l, r)
        case .call(let callee, let args): printCall(callee, args)
        case .arg(let label, let isInout, let val): printArg(label, isInout, val)
        case .member(let base, let n, let chain): printMember(base, n)
        case .index(let base, let idxs): printIndex(base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): printIf(ln, li, cond, thenB, els)
        case .block(let stmts): printBlock(stmts, 0)
        case .asE(let v, let target, let isOpt): printAs(v, target, isOpt)
        case .addrOf(let inner): print("/*?expr*/")
        case .prefixE(let kw, let inner): printPrefixExpr(kw, inner)
        case .doCatchE(let db, let en, let et, let cb): printDoCatch(db, en, et, cb)
        case .quoteE(let inner): printQuote(inner)
        case .spliceE(let bare, let inner): printSplice(bare, inner)
        default: print("/*?expr*/")
    }
}

func printQuote(_ inner: Vec[Nd]) using Alloc, Log {
    print("quote { ")
    printExpr(inner.get(0) ?? errE())
    print(" }")
}

func printSplice(_ bare: Bool, _ inner: Vec[Nd]) using Alloc, Log {
    print("$")
    if bare {
        printExpr(inner.get(0) ?? errE())
    } else {
        print("(")
        printExpr(inner.get(0) ?? errE())
        print(")")
    }
}

func printPrefixExpr(_ kw: String, _ inner: Vec[Nd]) using Alloc, Log {
    print(kw)
    printExpr(inner.get(0) ?? errE())
}

func printDoCatch(_ db: Vec[Nd], _ en: String, _ et: Vec[Nd], _ cb: Vec[Nd]) using Alloc, Log {
    print("do ")
    printExpr(db.get(0) ?? errE())
    print(" catch (")
    print(en)
    print(": ")
    if et.len() > 0 { printType(et.get(0) ?? errT()) }
    print(") ")
    printExpr(cb.get(0) ?? errE())
}

func printQuoted(_ open: Str, _ t: String, _ close: Str) using Log {
    print(open)
    print(t)
    print(close)
}

func printBool(_ b: Bool) using Log { if b { print("true") } else { print("false") } }
func printLeadingDot(_ n: String) using Log { print("."); print(n) }

func printParen(_ inner: Vec[Nd]) using Alloc, Log {
    print("(")
    printExpr(inner.get(0) ?? errE())
    print(")")
}

func printUnary(_ op: String, _ operand: Vec[Nd]) using Alloc, Log {
    print(op)
    printExpr(operand.get(0) ?? errE())
}

func printBinary(_ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc, Log {
    printExpr(l.get(0) ?? errE())
    print(" ")
    print(op)
    print(" ")
    printExpr(r.get(0) ?? errE())
}

func printCall(_ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log {
    printExpr(callee.get(0) ?? errE())
    print("(")
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        printExpr(args.get(i) ?? errE())
        i = i + 1
    }
    print(")")
}

func printArg(_ label: String, _ isInout: Bool, _ val: Vec[Nd]) using Alloc, Log {
    if !streq(label, "") {
        print(label)
        print(": ")
    }
    if isInout { print("&") }
    printExpr(val.get(0) ?? errE())
}

func printMember(_ base: Vec[Nd], _ n: String) using Alloc, Log {
    printExpr(base.get(0) ?? errE())
    print(".")
    print(n)
}

func printIndex(_ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc, Log {
    printExpr(base.get(0) ?? errE())
    print("[")
    var i: Int = 0
    while i < idxs.len() {
        if i > 0 { print(", ") }
        printExpr(idxs.get(i) ?? errE())
        i = i + 1
    }
    print("]")
}

func printIf(_ ln: String, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print("if ")
    if !streq(ln, "") {
        print("let ")
        print(ln)
        print(" = ")
        if li.len() > 0 { printExpr(li.get(0) ?? errE()) }
    } else if cond.len() > 0 {
        printExpr(cond.get(0) ?? errE())
    }
    print(" ")
    printExpr(thenB.get(0) ?? errE())
    if els.len() > 0 {
        print(" else ")
        printExpr(els.get(0) ?? errE())
    }
}

func printAs(_ v: Vec[Nd], _ target: Vec[Nd], _ isOpt: Bool) using Alloc, Log {
    printExpr(v.get(0) ?? errE())
    if isOpt { print(" as? ") } else { print(" as ") }
    printType(target.get(0) ?? errT())
}

// ===========================================================================
// Name resolution. A scope is a single growing Vec[String] of live bindings
// (permanent globals + builtins at the base, locals pushed / popped by block);
// `bad` collects the unresolved identifiers.
// ===========================================================================
struct Env {
    var names: Vec[String]
    var bad: Vec[String]
    var marks: Vec[Int]      // scope-start indices into `names` (one per live scope)
    var dups: Vec[String]    // "duplicate definition of '<n>'" full messages
    var curThrows: Bool      // does the function whose body we're walking declare `throws`?
    var throwBad: Vec[String] // "'throw' is only valid ..." full messages
    var modPaths: Vec[String]   // declared module paths of imported modules
    var modExpMod: Vec[String]  // member export rows: owning module path ...
    var modExpName: Vec[String] // ... -> public member name (func/const/static/type ctor)
    var modTypMod: Vec[String]  // type export rows: owning module path ...
    var modTypName: Vec[String] // ... -> public type name (struct/enum/opaque)
    var modBad: Vec[String]     // "module '<m>' has no public member '<x>'" messages
}

func noop() {}

func addName(_ env: inout Env, _ n: String) using Alloc { env.names.push(n) }

// Scope tracking for duplicate-definition detection: each scope records where it
// began in `names`; a binding clashes only with names introduced at the same
// level (params shadow nothing of the body block, nested blocks shadow outer).
func scopeEnter(_ env: inout Env) using Alloc { env.marks.push(env.names.len()) }

func scopeLeave(_ env: inout Env) { if env.marks.len() > 0 { let _ = env.marks.pop() } }

func curScopeStart(_ env: inout Env) -> Int {
    if env.marks.len() > 0 { return env.marks.get(env.marks.len() - 1) ?? 0 }
    return 0
}

func dupInScope(_ env: inout Env, _ n: String) -> Bool {
    var i: Int = curScopeStart(env)
    while i < env.names.len() {
        if let s = env.names.get(i) {
            if streq(s, n) { return true }
        }
        i = i + 1
    }
    return false
}

// Add a binding, first flagging it as a duplicate if a same-scope name matches.
func addBinding(_ env: inout Env, _ n: String) using Alloc {
    if streq(n, "") { return }
    if dupInScope(env, n) { env.dups.push(dupMsg(n)) }
    addName(env, n)
}

func dupMsg(_ n: String) using Alloc -> String {
    var s: String = "duplicate definition of '"
    s.append(n)
    s.append("'")
    return s
}

func inScope(_ env: inout Env, _ n: String) -> Bool {
    var i: Int = 0
    while i < env.names.len() {
        if let s = env.names.get(i) {
            if streq(s, n) { return true }
        }
        i = i + 1
    }
    return false
}

func popTo(_ env: inout Env, _ target: Int) {
    while env.names.len() > target { let _ = env.names.pop() }
}

func reportUndef(_ env: inout Env, _ n: String) using Alloc {
    if !inScope(env, n) { env.bad.push(n) }
}

func addBuiltins(_ env: inout Env) using Alloc {
    addName(env, "print")
    addName(env, "println")
    addName(env, "eprint")
    addName(env, "eprintln")
    addName(env, "args")
    addName(env, "readFile")
    addName(env, "writeFile")
    addName(env, "panic")
    addName(env, "assert")
    addName(env, "sin")
    addName(env, "cos")
    addName(env, "tan")
    addName(env, "sqrt")
    addName(env, "pi")
    addName(env, "tau")
    addName(env, "Vec")
    addName(env, "HashMap")
    addName(env, "Ptr")       // §14.1 Ptr.unchecked / MutPtr.unchecked
    addName(env, "MutPtr")
    addName(env, "Span")      // Annex §10.5 Span.raw / MutSpan.raw
    addName(env, "MutSpan")
    addName(env, "String")
    addName(env, "Str")
    addName(env, "Box")
    addName(env, "Span")
    addName(env, "Atomic")
    addName(env, "Option")
    addName(env, "Result")
    addName(env, "Char")
    addName(env, "Int")
    addName(env, "Int8")
    addName(env, "Int16")
    addName(env, "Int32")
    addName(env, "Int64")
    addName(env, "UInt8")
    addName(env, "UInt16")
    addName(env, "UInt32")
    addName(env, "UInt64")
    addName(env, "Float32")
    addName(env, "Float64")
    addName(env, "Bool")
}

// All top-level declarations share one namespace, so a repeated name (across any
// of func / struct / enum / const / static / opaque) is a duplicate. Builtins sit
// below the top-level mark, so a global never clashes with one.
// Is `d` a nominal type (struct / enum / opaque)? These are collected first, as
// the bootstrap does, so a signature can name a type declared later.
func isTypeDecl(_ d: Nd) -> Bool {
    return match d {
        case .structD: true
        case .enumD: true
        case .opaqueD: true
        default: false
    }
}

func collectGlobal(_ env: inout Env, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let pp, let c, let t, let r, let b): addBinding(env, name)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): addBinding(env, name)
        case .enumD(let vis, let name, let cs, let m, let generics): addBinding(env, name)
        case .constD(let vis, let name, let ty, let v): addBinding(env, name)
        case .staticD(let vis, let name, let ty, let v): addBinding(env, name)
        case .opaqueD(let vis, let name, let under): addBinding(env, name)
        default: noop()
    }
}

// Two passes over the compilation unit: collect top-level value names, then resolve
// every function (and method) body against the scope.
func resolve(_ env: inout Env, _ u: NUnit) using Alloc {
    scopeEnter(env)   // top-level scope (above the builtins added before resolve)
    var i: Int = 0
    while i < u.decls.len() {
        let d = u.decls.get(i) ?? Nd.wildcard
        if isTypeDecl(d) { collectGlobal(env, d) }
        i = i + 1
    }
    i = 0
    while i < u.decls.len() {
        let d = u.decls.get(i) ?? Nd.wildcard
        if !isTypeDecl(d) { collectGlobal(env, d) }
        i = i + 1
    }
    var j: Int = 0
    while j < u.decls.len() {
        resolveDecl(env, u.decls.get(j) ?? Nd.wildcard)
        j = j + 1
    }
}

func resolveDecl(_ env: inout Env, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body):
            resolveFunc(env, thr, params, body)
        case .structD(let vis, let name, let fields, let methods, let deinitB, let isLinear, let generics):
            resolveMethods(env, methods)
        case .enumD(let vis, let name, let cases, let methods, let generics):
            resolveMethods(env, methods)
        default: noop()
    }
}

func resolveMethods(_ env: inout Env, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        resolveDecl(env, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

// Set the throws context (a `throw` is valid only inside a `throws(E)` function),
// then resolve the body. Functions don't nest, so a plain set per function (no
// save/restore) suffices; methods reach here as their own decls.
func resolveFunc(_ env: inout Env, _ thr: Vec[Nd], _ params: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    env.curThrows = thr.len() > 0
    resolveFuncBody(env, params, body)
}

func resolveFuncBody(_ env: inout Env, _ params: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    let save = env.names.len()
    scopeEnter(env)
    bindParams(env, params)
    resolveBoxed(env, body)
    scopeLeave(env)
    popTo(env, save)
}

func bindParams(_ env: inout Env, _ params: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < params.len() {
        bindParam(env, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func bindParam(_ env: inout Env, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): bindIfName(env, nm)
        default: noop()
    }
}

func bindIfName(_ env: inout Env, _ nm: String) using Alloc {
    addBinding(env, nm)
}

func resolveBoxed(_ env: inout Env, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { resolveExpr(env, v.get(0) ?? Nd.wildcard) }
}

func resolveExpr(_ env: inout Env, _ e: Nd) using Alloc {
    match e {
        case .ident(let n): reportUndef(env, n)
        case .paren(let inner): resolveBoxed(env, inner)
        case .unary(let op, let operand): resolveBoxed(env, operand)
        case .binary(let op, let l, let r): resolvePair(env, l, r)
        case .call(let callee, let args): resolveCall(env, callee, args)
        case .arg(let label, let isInout, let val): resolveBoxed(env, val)
        case .member(let base, let n, let chain): resolveMember(env, base, n, chain)
        case .index(let base, let idxs): resolveIndex(env, base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): resolveIf(env, ln, li, cond, thenB, els)
        case .block(let stmts): resolveBlock(env, stmts)
        case .asE(let v, let target, let isOpt): resolveBoxed(env, v)
        case .addrOf(let inner): resolveBoxed(env, inner)
        case .prefixE(let kw, let inner): resolveBoxed(env, inner)
        case .throwE(let inner): resolveThrow(env, inner)
        case .matchE(let scrut, let arms): resolveMatch(env, scrut, arms)
        case .doCatchE(let db, let en, let et, let cb): resolveDoCatch(env, db, en, cb)
        case .vecLit(let elems): resolveExprList(env, elems)
        case .tupleLit(let elems): resolveExprList(env, elems)
        case .interpE(let parts, let exprs): resolveExprList(env, exprs)
        case .closureE(let params, let body): resolveClosure(env, params, body)
        default: noop()
    }
}

// Resolve each expression in a literal element list (array / tuple).
func resolveExprList(_ env: inout Env, _ elems: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < elems.len() {
        resolveExpr(env, elems.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

// A closure is one scope shared by its parameters and body statements: a body
// `let` that shadows a parameter clashes (duplicate definition), and the body
// resolves against the parameters plus the enclosing scope (captures).
func resolveClosure(_ env: inout Env, _ params: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    let save = env.names.len()
    scopeEnter(env)
    bindClosureParams(env, params)
    var i: Int = 0
    while i < body.len() {
        resolveStmt(env, body.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    scopeLeave(env)
    popTo(env, save)
}

func bindClosureParams(_ env: inout Env, _ params: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < params.len() {
        bindClosureParam(env, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func bindClosureParam(_ env: inout Env, _ p: Nd) using Alloc {
    match p {
        case .ident(let n): addBinding(env, n)
        default: noop()
    }
}

// Each match arm is its own scope: the pattern binds its variables, then the
// guard and body resolve against them (default / unguarded arms bind nothing).
func resolveMatch(_ env: inout Env, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    resolveBoxed(env, scrut)
    var i: Int = 0
    while i < arms.len() {
        resolveArm(env, arms.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func resolveArm(_ env: inout Env, _ a: Nd) using Alloc {
    match a {
        case .matchArm(let isDefault, let pat, let guard, let body): resolveArmParts(env, pat, guard, body)
        default: noop()
    }
}

func resolveArmParts(_ env: inout Env, _ pat: Vec[Nd], _ guard: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    let save = env.names.len()
    scopeEnter(env)
    bindPatBoxed(env, pat)
    resolveBoxed(env, guard)
    resolveBoxed(env, body)
    scopeLeave(env)
    popTo(env, save)
}

// §error-handling — `throw` resolves its operand and is legal only when the
// enclosing function declares `throws`. (A surrounding `do`/`catch` does not make
// it legal; only the function signature does.)
func resolveThrow(_ env: inout Env, _ inner: Vec[Nd]) using Alloc {
    resolveBoxed(env, inner)
    if !env.curThrows { env.throwBad.push(throwMsg()) }
}

func throwMsg() using Alloc -> String {
    return own("'throw' is only valid inside a function declared 'throws(E)'")
}

func resolvePair(_ env: inout Env, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc {
    resolveBoxed(env, l)
    resolveBoxed(env, r)
}

// Member access. A pure identifier/member chain `a.b.c` whose head is NOT a value
// in scope and whose leading segments name an imported module is a qualified
// module reference: the final segment must be a public export, else
// "module '<a.b>' has no public member '<c>'". The module head is then NOT
// resolved as an ordinary value. Everything else is an ordinary member access.
func resolveMember(_ env: inout Env, _ base: Vec[Nd], _ n: String, _ chain: Bool) using Alloc {
    if !chain && tryModRef(env, base, n) { return }
    resolveBoxed(env, base)
}

func tryModRef(_ env: inout Env, _ base: Vec[Nd], _ n: String) using Alloc -> Bool {
    let segs = modSegs(base, n)
    if segs.len() < 2 { return false }
    let head = segs.get(0) ?? own("")
    if inScope(env, head) { return false }            // head is a real value -> ordinary access
    let dotted = joinSegsButLast(segs)
    if !modKnown(env, dotted) { return false }         // not an imported module -> ordinary access
    let exportName = segs.get(segs.len() - 1) ?? own("")
    if !modHasExport(env, dotted, exportName) { env.modBad.push(moduleNoMemberMsg(dotted, exportName)) }
    return true
}

// Flatten `a.b.c` (member-of-member-of-ident) into segments [a, b, c]; empty if
// the chain is not a pure identifier/member path (or uses an optional `?.`).
func modSegs(_ base: Vec[Nd], _ n: String) using Alloc -> Vec[String] {
    var segs = modBaseSegs(base)
    if segs.len() == 0 { return Vec.new() }
    segs.push(n)
    return segs
}

func modBaseSegs(_ base: Vec[Nd]) using Alloc -> Vec[String] {
    if base.len() == 0 { return Vec.new() }
    return modSegsOf(base.get(0) ?? Nd.wildcard)
}

func modSegsOf(_ e: Nd) using Alloc -> Vec[String] {
    return match e {
        case .ident(let h): modSingle(h)
        case .member(let b2, let m2, let chain2): modNested(b2, m2, chain2)
        default: Vec.new()
    }
}

func modSingle(_ h: String) using Alloc -> Vec[String] {
    var v: Vec[String] = Vec.new()
    v.push(h)
    return v
}

func modNested(_ b2: Vec[Nd], _ m2: String, _ chain2: Bool) using Alloc -> Vec[String] {
    if chain2 { return Vec.new() }
    var inner = modBaseSegs(b2)
    if inner.len() == 0 { return Vec.new() }
    inner.push(m2)
    return inner
}

func joinSegsButLast(_ segs: Vec[String]) using Alloc -> String {
    var s: String = ""
    var i: Int = 0
    let stop = segs.len() - 1
    while i < stop {
        if i > 0 { s.append(".") }
        if let seg = segs.get(i) { s.append(seg) }
        i = i + 1
    }
    return s
}

func modKnown(_ env: inout Env, _ dotted: String) -> Bool {
    var i: Int = 0
    while i < env.modPaths.len() {
        if let m = env.modPaths.get(i) { if streq(m, dotted) { return true } }
        i = i + 1
    }
    return false
}

func modHasExport(_ env: inout Env, _ dotted: String, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.modExpMod.len() {
        if let m = env.modExpMod.get(i) {
            if streq(m, dotted) {
                if let nm = env.modExpName.get(i) { if streq(nm, name) { return true } }
            }
        }
        i = i + 1
    }
    return false
}

func moduleNoMemberMsg(_ dotted: String, _ name: String) using Alloc -> String {
    var s: String = "module '"
    s.append(dotted)
    s.append("' has no public member '")
    s.append(name)
    s.append("'")
    return s
}

func resolveCall(_ env: inout Env, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    resolveBoxed(env, callee)
    var i: Int = 0
    while i < args.len() {
        resolveExpr(env, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func resolveIndex(_ env: inout Env, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    resolveBoxed(env, base)
    var i: Int = 0
    while i < idxs.len() {
        resolveExpr(env, idxs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func resolveIf(_ env: inout Env, _ ln: String, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc {
    if !streq(ln, "") {
        resolveBoxed(env, li)
        let save = env.names.len()
        scopeEnter(env)
        addBinding(env, ln)
        resolveBoxed(env, thenB)
        scopeLeave(env)
        popTo(env, save)
    } else {
        resolveBoxed(env, cond)
        resolveBoxed(env, thenB)
    }
    resolveBoxed(env, els)
}

func resolveDoCatch(_ env: inout Env, _ db: Vec[Nd], _ en: String, _ cb: Vec[Nd]) using Alloc {
    resolveBoxed(env, db)
    let save = env.names.len()
    scopeEnter(env)
    addBinding(env, en)
    resolveBoxed(env, cb)
    scopeLeave(env)
    popTo(env, save)
}

func resolveBlock(_ env: inout Env, _ stmts: Vec[Nd]) using Alloc {
    let save = env.names.len()
    scopeEnter(env)
    var i: Int = 0
    while i < stmts.len() {
        resolveStmt(env, stmts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    scopeLeave(env)
    popTo(env, save)
}

func resolveStmt(_ env: inout Env, _ s: Nd) using Alloc {
    match s {
        case .letS(let pat, let ty, let value): resolveLet(env, pat, value)
        case .varS(let pat, let ty, let value): resolveLet(env, pat, value)
        case .exprS(let e): resolveBoxed(env, e)
        case .retS(let v): resolveBoxed(env, v)
        case .assignS(let op, let t, let v): resolvePair(env, t, v)
        case .whileS(let c, let b): resolvePair(env, c, b)
        case .forS(let pat, let iter, let b): resolveFor(env, pat, iter, b)
        default: noop()
    }
}

func resolveLet(_ env: inout Env, _ pat: Vec[Nd], _ value: Vec[Nd]) using Alloc {
    resolveBoxed(env, value)
    bindPatBoxed(env, pat)
}

func resolveFor(_ env: inout Env, _ pat: Vec[Nd], _ iter: Vec[Nd], _ b: Vec[Nd]) using Alloc {
    resolveBoxed(env, iter)
    let save = env.names.len()
    scopeEnter(env)
    bindPatBoxed(env, pat)
    resolveBoxed(env, b)
    scopeLeave(env)
    popTo(env, save)
}

func bindPatBoxed(_ env: inout Env, _ pat: Vec[Nd]) using Alloc {
    if pat.len() > 0 { bindPattern(env, pat.get(0) ?? Nd.wildcard) }
}

func bindPattern(_ env: inout Env, _ p: Nd) using Alloc {
    match p {
        case .identP(let n): addBinding(env, n)
        case .bindP(let n): addBinding(env, n)
        case .tupleP(let elems): bindPatList(env, elems)
        case .enumP(let cname, let children): bindPatList(env, children)
        default: noop()
    }
}

func bindPatList(_ env: inout Env, _ ps: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < ps.len() {
        bindPattern(env, ps.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

// ===========================================================================
// Type-name resolution (`unknown type '<n>'`). A type annotation must name a
// known type: a builtin, a user struct / enum / opaque, a generic parameter in
// scope, or `Self`. Mirrors the C++ resolver including its TWO-PHASE structure —
// a "declare" phase resolves free-function signatures and const / static
// annotations, then a "body" phase resolves them AGAIN plus locals and method
// signatures. So a free function's param / return types are reported TWICE, a
// const annotation once, and a method or local once; struct fields and enum
// payloads are NOT checked. Unknown types gate the later passes (so a downstream
// pass never treats the error type as concrete and piles on a mismatch).
// ===========================================================================
struct TnEnv {
    var types: Vec[String]            // known type names: builtins + user struct/enum/opaque
    var userTypes: Vec[String]        // just the user-declared type names (struct/enum/opaque)
    var genericUserTypes: Vec[String] // user types that take type parameters
    var tparams: Vec[String]          // generic parameters currently in scope (a stack)
    var tpMarks: Vec[Int]             // scope-start indices into tparams
    var modPaths: Vec[String]         // declared module paths of imported modules
    var modTypMod: Vec[String]        // type export rows: owning module path ...
    var modTypName: Vec[String]       // ... -> public type name
    var bad: Vec[String]              // "unknown type '<n>'" / "'<n>' is not a generic type"
}

// Copy the imported-module type-export tables (harvested during module loading)
// into the type-name environment so qualified type references can be checked.
func tnSeedModules(_ env: inout TnEnv, _ srcPaths: Vec[String],
                   _ srcTypMod: Vec[String], _ srcTypName: Vec[String]) using Alloc {
    var i: Int = 0
    while i < srcPaths.len() {
        if let p = srcPaths.get(i) { env.modPaths.push(own(p)) }
        i = i + 1
    }
    var j: Int = 0
    while j < srcTypMod.len() {
        if let m = srcTypMod.get(j) { env.modTypMod.push(own(m)) }
        if let n = srcTypName.get(j) { env.modTypName.push(own(n)) }
        j = j + 1
    }
}

func tnSeedBuiltins(_ env: inout TnEnv) using Alloc {
    env.types.push("Int"); env.types.push("Int8"); env.types.push("Int16")
    env.types.push("Int32"); env.types.push("Int64"); env.types.push("Int128")
    env.types.push("UInt"); env.types.push("UInt8"); env.types.push("UInt16")
    env.types.push("UInt32"); env.types.push("UInt64"); env.types.push("UInt128")
    env.types.push("Float32"); env.types.push("Float64"); env.types.push("Bool")
    env.types.push("Char"); env.types.push("Str"); env.types.push("String")
    env.types.push("Unit"); env.types.push("Vec"); env.types.push("HashMap")
    env.types.push("Box"); env.types.push("Span"); env.types.push("MutSpan")
    env.types.push("Option"); env.types.push("Result"); env.types.push("Atomic")
    env.types.push("Soa"); env.types.push("Channel"); env.types.push("Future")
    env.types.push("Duration"); env.types.push("Self"); env.types.push("Never")
    env.types.push("Ptr"); env.types.push("MutPtr")   // §14.1 raw pointers
    env.types.push("Padded"); env.types.push("PerCpu") // Annex §14.8
}

func tnCollectType(_ env: inout TnEnv, _ d: Nd) using Alloc {
    match d {
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): tnRecordType(env, name, generics)
        case .enumD(let vis, let name, let cs, let m, let generics): tnRecordType(env, name, generics)
        case .opaqueD(let vis, let name, let under): tnRecordType(env, name, Vec.new())
        default: noop()
    }
}

func tnRecordType(_ env: inout TnEnv, _ name: String, _ generics: Vec[Nd]) using Alloc {
    env.types.push(name)
    env.userTypes.push(name)
    if generics.len() > 0 { env.genericUserTypes.push(name) }
}

func tnCheck(_ env: inout TnEnv, _ u: NUnit, _ srcPaths: Vec[String],
             _ srcTypMod: Vec[String], _ srcTypName: Vec[String]) using Alloc {
    tnSeedBuiltins(env)
    tnSeedModules(env, srcPaths, srcTypMod, srcTypName)
    var c: Int = 0
    while c < u.decls.len() {
        tnCollectType(env, u.decls.get(c) ?? Nd.wildcard)
        c = c + 1
    }
    var i: Int = 0
    while i < u.decls.len() {           // phase 1 (declare)
        tnDeclare(env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    var j: Int = 0
    while j < u.decls.len() {           // phase 2 (body)
        tnBody(env, u.decls.get(j) ?? Nd.wildcard)
        j = j + 1
    }
}

// Phase 1: free-function signatures and const / static annotations.
func tnDeclare(_ env: inout TnEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body):
            tnSig(env, gens, params, res)
        case .constD(let vis, let name, let ty, let v): tnTypeBoxed(env, ty)
        case .staticD(let vis, let name, let ty, let v): tnTypeBoxed(env, ty)
        default: noop()
    }
}

// Phase 2: free-function signatures (again) + bodies; methods once, inside the
// owning struct / enum's generic scope.
func tnBody(_ env: inout TnEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body):
            tnFuncFull(env, gens, params, res, body)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): tnTypeMethods(env, generics, m)
        case .enumD(let vis, let name, let cs, let m, let generics): tnTypeMethods(env, generics, m)
        default: noop()
    }
}

func tnTypeMethods(_ env: inout TnEnv, _ ownerGens: Vec[Nd], _ methods: Vec[Nd]) using Alloc {
    tnEnterGens(env, ownerGens)
    var i: Int = 0
    while i < methods.len() {
        tnBody(env, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tnLeaveGens(env)
}

func tnSig(_ env: inout TnEnv, _ gens: Vec[Nd], _ params: Vec[Nd], _ res: Vec[Nd]) using Alloc {
    tnEnterGens(env, gens)
    tnParamTypes(env, params)
    tnTypeBoxed(env, res)
    tnLeaveGens(env)
}

func tnFuncFull(_ env: inout TnEnv, _ gens: Vec[Nd], _ params: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    tnEnterGens(env, gens)
    tnParamTypes(env, params)
    tnTypeBoxed(env, res)
    tnBodyLocals(env, body)
    tnLeaveGens(env)
}

func tnParamTypes(_ env: inout TnEnv, _ params: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < params.len() {
        tnParamType(env, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tnParamType(_ env: inout TnEnv, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): tnTypeBoxed(env, ty)
        default: noop()
    }
}

// ----- generic-parameter scope ----------------------------------------------
func tnEnterGens(_ env: inout TnEnv, _ gens: Vec[Nd]) using Alloc {
    env.tpMarks.push(env.tparams.len())
    var i: Int = 0
    while i < gens.len() {
        let nm = tnGenName(gens.get(i) ?? Nd.wildcard)
        if !streq(nm, "") { env.tparams.push(nm) }
        i = i + 1
    }
}

func tnLeaveGens(_ env: inout TnEnv) using Alloc {
    if env.tpMarks.len() > 0 {
        let target = env.tpMarks.pop() ?? 0
        while env.tparams.len() > target { let _ = env.tparams.pop() }
    }
}

func tnGenName(_ g: Nd) using Alloc -> String {
    return match g {
        case .genConst(let n, let ct): n
        case .genType(let n, let bounds): n
        default: own("")
    }
}

// ----- type-tree walk -------------------------------------------------------
func tnTypeBoxed(_ env: inout TnEnv, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { tnType(env, v.get(0) ?? errT()) }
}

func tnType(_ env: inout TnEnv, _ t: Nd) using Alloc {
    match t {
        case .named(let path, let hasG, let args): tnNamed(env, path, args)
        case .opt(let inner): tnTypeBoxed(env, inner)
        case .someT(let inner): tnTypeBoxed(env, inner)
        case .dynT(let inner): tnTypeBoxed(env, inner)
        case .vecT(let len, let elem): tnTypeBoxed(env, elem)
        case .tupleT(let elems): tnTypeList(env, elems)
        default: noop()
    }
}

// Resolve a named type head. An unknown head, or a known-but-non-generic user
// type applied to type arguments, is an error AND stops the walk (the C++ does
// not descend into the args in either case). Otherwise the args are resolved.
func tnNamed(_ env: inout TnEnv, _ path: String, _ args: Vec[Nd]) using Alloc {
    if tnLastDot(path) >= 0 { tnQualifiedNamed(env, path, args); return }
    if !tnKnown(env, path) { env.bad.push(unknownTypeMsg(path)); return }
    if args.len() > 0 && tnUserNonGeneric(env, path) { env.bad.push(notGenericMsg(path)); return }
    tnTypeList(env, args)
}

// A dotted type head `mod.Type` references a public type of an imported module.
// The leading segments must name an imported module and the final segment one of
// its public type exports; either failure stops the walk (as the C++ does).
func tnQualifiedNamed(_ env: inout TnEnv, _ path: String, _ args: Vec[Nd]) using Alloc {
    let d = tnLastDot(path)
    let head = own(path.slice(0, d))
    let last = own(path.slice(d + 1, path.len()))
    if !tnModKnown(env, head) { env.bad.push(notImportedModuleMsg(head)); return }
    if !tnModHasType(env, head, last) { env.bad.push(noPublicTypeMsg(head, last)); return }
    tnTypeList(env, args)
}

// Index of the last '.' (46) in path, or -1 if none.
func tnLastDot(_ path: Str) -> Int {
    var last: Int = -1
    var i: Int = 0
    while i < path.len() {
        if (path.byteAt(i) ?? 0) == 46 { last = i }
        i = i + 1
    }
    return last
}

func tnModKnown(_ env: inout TnEnv, _ head: String) -> Bool {
    var i: Int = 0
    while i < env.modPaths.len() {
        if let m = env.modPaths.get(i) { if streq(m, head) { return true } }
        i = i + 1
    }
    return false
}

func tnModHasType(_ env: inout TnEnv, _ head: String, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.modTypMod.len() {
        if let m = env.modTypMod.get(i) {
            if streq(m, head) {
                if let nm = env.modTypName.get(i) { if streq(nm, name) { return true } }
            }
        }
        i = i + 1
    }
    return false
}

func notImportedModuleMsg(_ head: String) using Alloc -> String {
    var s: String = "'"
    s.append(head)
    s.append("' is not an imported module")
    return s
}

func noPublicTypeMsg(_ head: String, _ name: String) using Alloc -> String {
    var s: String = "module '"
    s.append(head)
    s.append("' has no public type '")
    s.append(name)
    s.append("'")
    return s
}

// A user-declared type (struct / enum / opaque) that takes no type parameters.
func tnUserNonGeneric(_ env: inout TnEnv, _ path: String) -> Bool {
    return tnContains(env.userTypes, path) && !tnContains(env.genericUserTypes, path)
}

func tnContains(_ v: Vec[String], _ s: String) -> Bool {
    var i: Int = 0
    while i < v.len() {
        if let e = v.get(i) { if streq(e, s) { return true } }
        i = i + 1
    }
    return false
}

func notGenericMsg(_ n: String) using Alloc -> String {
    var s: String = "'"
    s.append(n)
    s.append("' is not a generic type")
    return s
}

func tnTypeList(_ env: inout TnEnv, _ ts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < ts.len() {
        tnType(env, ts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tnKnown(_ env: inout TnEnv, _ path: String) -> Bool {
    var i: Int = 0
    while i < env.tparams.len() {
        if let s = env.tparams.get(i) { if streq(s, path) { return true } }
        i = i + 1
    }
    var j: Int = 0
    while j < env.types.len() {
        if let s = env.types.get(j) { if streq(s, path) { return true } }
        j = j + 1
    }
    return false
}

func unknownTypeMsg(_ n: String) using Alloc -> String {
    var s: String = "unknown type '"
    s.append(n)
    s.append("'")
    return s
}

// ----- body walk for local (let / var) annotations --------------------------
func tnBodyLocals(_ env: inout TnEnv, _ body: Vec[Nd]) using Alloc {
    if body.len() > 0 { tnBlockNode(env, body.get(0) ?? Nd.wildcard) }
}

func tnBlockNode(_ env: inout TnEnv, _ n: Nd) using Alloc {
    match n {
        case .block(let stmts): tnStmts(env, stmts)
        default: noop()
    }
}

func tnStmts(_ env: inout TnEnv, _ stmts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < stmts.len() {
        tnStmt(env, stmts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tnStmt(_ env: inout TnEnv, _ s: Nd) using Alloc {
    match s {
        case .letS(let pat, let ty, let val): tnLetVar(env, ty, val)
        case .varS(let pat, let ty, let val): tnLetVar(env, ty, val)
        case .exprS(let e): tnNestedBoxed(env, e)
        case .retS(let v): tnNestedBoxed(env, v)
        case .whileS(let c, let b): tnNestedBoxed(env, b)
        case .forS(let pat, let it, let b): tnNestedBoxed(env, b)
        case .withS(let caps, let vals, let body): tnNestedBoxed(env, body)
        default: noop()
    }
}

func tnLetVar(_ env: inout TnEnv, _ ty: Vec[Nd], _ val: Vec[Nd]) using Alloc {
    tnTypeBoxed(env, ty)
    tnNestedBoxed(env, val)
}

// Descend into nested blocks (if / while / for bodies, parens, do/catch) so their
// local annotations are reached; other expressions carry no type annotations.
func tnNestedBoxed(_ env: inout TnEnv, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { tnNested(env, v.get(0) ?? Nd.wildcard) }
}

func tnNested(_ env: inout TnEnv, _ e: Nd) using Alloc {
    match e {
        case .block(let stmts): tnStmts(env, stmts)
        case .ifE(let ln, let li, let cond, let thenB, let els): tnIfBlocks(env, thenB, els)
        case .paren(let inner): tnNestedBoxed(env, inner)
        case .doCatchE(let db, let en, let et, let cb): tnDoCatchBlocks(env, db, cb)
        default: noop()
    }
}

func tnIfBlocks(_ env: inout TnEnv, _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc {
    tnNestedBoxed(env, thenB)
    tnNestedBoxed(env, els)
}

func tnDoCatchBlocks(_ env: inout TnEnv, _ db: Vec[Nd], _ cb: Vec[Nd]) using Alloc {
    tnNestedBoxed(env, db)
    tnNestedBoxed(env, cb)
}

// ===========================================================================
// Capability checking (§ effects). A scope stack of capability-name sets:
// `active` holds the names currently granted (the function's `using` row, plus
// any enclosing `with` grants). The (fcNames, fcCaps) parallel arrays map each
// user function to its declared capabilities (one row per (func, cap) pair);
// `userFuncs` distinguishes a user call from a builtin; `bad` collects the
// "missing capability '<Cap>'" diagnostics in walk order.
// ===========================================================================
struct CapEnv {
    var active: Vec[String]
    var fcNames: Vec[String]
    var fcCaps: Vec[String]
    var userFuncs: Vec[String]
    var bad: Vec[String]
}

func containsSub(_ s: String, _ sub: Str) -> Bool {
    let n = s.len()
    let m = sub.len()
    if m == 0 { return true }
    if m > n { return false }
    var i: Int = 0
    while i + m <= n {
        var j: Int = 0
        var ok: Bool = true
        while ok && j < m {
            if (s.byteAt(i + j) ?? 0) != (sub.byteAt(j) ?? 1) { ok = false }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

func capInScope(_ env: inout CapEnv, _ cap: String) -> Bool {
    var i: Int = 0
    while i < env.active.len() {
        if let c = env.active.get(i) {
            if streq(c, cap) { return true }
        }
        i = i + 1
    }
    return false
}

func userFuncContains(_ env: inout CapEnv, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.userFuncs.len() {
        if let c = env.userFuncs.get(i) {
            if streq(c, name) { return true }
        }
        i = i + 1
    }
    return false
}

func capMsg(_ cap: String) using Alloc -> String {
    var s: String = "missing capability '"
    s.append(cap)
    s.append("'")
    return s
}

func require(_ env: inout CapEnv, _ cap: String) using Alloc {
    if !capInScope(env, cap) { env.bad.push(capMsg(cap)) }
}

func popCapTo(_ env: inout CapEnv, _ target: Int) {
    while env.active.len() > target { let _ = env.active.pop() }
}

func pushCapName(_ env: inout CapEnv, _ t: Nd) using Alloc {
    match t {
        case .named(let path, let g, let a): env.active.push(path)
        default: noop()
    }
}

func pushCaps(_ env: inout CapEnv, _ caps: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < caps.len() {
        pushCapName(env, caps.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

// ----- pass 1: record each user function's declared capability row ----------
func checkCapabilities(_ env: inout CapEnv, _ u: NUnit) using Alloc {
    var i: Int = 0
    while i < u.decls.len() {
        collectFuncCaps(env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    var j: Int = 0
    while j < u.decls.len() {
        checkDeclCaps(env, u.decls.get(j) ?? Nd.wildcard)
        j = j + 1
    }
}

func collectFuncCaps(_ env: inout CapEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let pp, let caps, let t, let r, let b):
            recordFunc(env, name, mods, caps)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): collectMethodCaps(env, m)
        case .enumD(let vis, let name, let cs, let m, let generics): collectMethodCaps(env, m)
        default: noop()
    }
}

func collectMethodCaps(_ env: inout CapEnv, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        collectFuncCaps(env, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func recordFunc(_ env: inout CapEnv, _ name: String, _ mods: String, _ caps: Vec[Nd]) using Alloc {
    env.userFuncs.push(name)
    var i: Int = 0
    while i < caps.len() {
        capRowFor(env, name, caps.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    if containsSub(mods, "async") {
        env.fcNames.push(name)
        env.fcCaps.push("Async")
    }
}

func capRowFor(_ env: inout CapEnv, _ name: String, _ t: Nd) using Alloc {
    match t {
        case .named(let path, let g, let a): addRow(env, name, path)
        default: noop()
    }
}

func addRow(_ env: inout CapEnv, _ name: String, _ path: String) using Alloc {
    env.fcNames.push(name)
    env.fcCaps.push(path)
}

// ----- pass 2: walk bodies, discharging capability uses ---------------------
func checkDeclCaps(_ env: inout CapEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let pp, let caps, let t, let r, let b):
            checkFuncBody(env, mods, caps, b)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): checkMethodsCaps(env, m)
        case .enumD(let vis, let name, let cs, let m, let generics): checkMethodsCaps(env, m)
        default: noop()
    }
}

func checkMethodsCaps(_ env: inout CapEnv, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        checkDeclCaps(env, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func checkFuncBody(_ env: inout CapEnv, _ mods: String, _ caps: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    let save = env.active.len()
    pushCaps(env, caps)
    if containsSub(mods, "async") { env.active.push("Async") }
    checkCapBoxed(env, body)
    popCapTo(env, save)
}

func checkCapBoxed(_ env: inout CapEnv, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { checkCapExpr(env, v.get(0) ?? Nd.wildcard) }
}

func checkCapPair(_ env: inout CapEnv, _ a: Vec[Nd], _ b: Vec[Nd]) using Alloc {
    checkCapBoxed(env, a)
    checkCapBoxed(env, b)
}

func checkCapExpr(_ env: inout CapEnv, _ e: Nd) using Alloc {
    match e {
        case .call(let callee, let args): checkCall(env, callee, args)
        case .prefixE(let kw, let inner): checkPrefixCaps(env, kw, inner)
        case .paren(let x): checkCapBoxed(env, x)
        case .unary(let op, let x): checkCapBoxed(env, x)
        case .binary(let op, let l, let r): checkCapPair(env, l, r)
        case .member(let base, let n, let c): checkCapBoxed(env, base)
        case .index(let base, let idxs): checkCapIndex(env, base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): checkCapIf(env, li, cond, thenB, els)
        case .block(let stmts): checkCapBlock(env, stmts)
        case .asE(let v, let t, let o): checkCapBoxed(env, v)
        case .addrOf(let x): checkCapBoxed(env, x)
        case .arg(let l, let io, let v): checkCapBoxed(env, v)
        case .doCatchE(let db, let en, let et, let cb): checkCapPair(env, db, cb)
        default: noop()
    }
}

func checkCapIndex(_ env: inout CapEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    checkCapBoxed(env, base)
    var i: Int = 0
    while i < idxs.len() {
        checkCapExpr(env, idxs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func checkCapIf(_ env: inout CapEnv, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc {
    checkCapBoxed(env, cond)
    checkCapBoxed(env, li)
    checkCapBoxed(env, thenB)
    checkCapBoxed(env, els)
}

func checkCapBlock(_ env: inout CapEnv, _ stmts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < stmts.len() {
        checkCapStmt(env, stmts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func checkCapStmt(_ env: inout CapEnv, _ s: Nd) using Alloc {
    match s {
        case .letS(let p, let ty, let v): checkCapBoxed(env, v)
        case .varS(let p, let ty, let v): checkCapBoxed(env, v)
        case .exprS(let e): checkCapBoxed(env, e)
        case .retS(let v): checkCapBoxed(env, v)
        case .assignS(let op, let t, let v): checkCapPair(env, t, v)
        case .whileS(let c, let b): checkCapPair(env, c, b)
        case .forS(let pp, let it, let b): checkCapPair(env, it, b)
        case .withS(let caps, let vals, let body): checkWith(env, caps, vals, body)
        default: noop()
    }
}

func checkWith(_ env: inout CapEnv, _ caps: Vec[Nd], _ vals: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    // §17.4: binding values are evaluated in the OUTER scope (before the grant).
    var i: Int = 0
    while i < vals.len() {
        checkCapExpr(env, vals.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    let save = env.active.len()
    pushCaps(env, caps)
    checkCapBoxed(env, body)
    popCapTo(env, save)
}

func checkPrefixCaps(_ env: inout CapEnv, _ kw: String, _ inner: Vec[Nd]) using Alloc {
    if streq(kw, "await ") || streq(kw, "spawn ") { require(env, "Async") }
    checkCapBoxed(env, inner)
}

func checkCall(_ env: inout CapEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    checkCalleeCaps(env, callee.get(0) ?? Nd.wildcard, args)
    checkCapBoxed(env, callee)
    var i: Int = 0
    while i < args.len() {
        checkCapExpr(env, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func checkCalleeCaps(_ env: inout CapEnv, _ callee: Nd, _ args: Vec[Nd]) using Alloc {
    match callee {
        case .ident(let name): checkIdentCallee(env, name)
        case .member(let base, let m, let c): checkMemberCallee(env, base, m)
        default: noop()
    }
}

func checkIdentCallee(_ env: inout CapEnv, _ name: String) using Alloc {
    if userFuncContains(env, name) { requireFuncCaps(env, name) }
    else { requireBuiltinCap(env, name) }
}

func requireFuncCaps(_ env: inout CapEnv, _ name: String) using Alloc {
    var i: Int = 0
    while i < env.fcNames.len() {
        if let fn = env.fcNames.get(i) {
            if streq(fn, name) {
                if let cap = env.fcCaps.get(i) { require(env, cap) }
            }
        }
        i = i + 1
    }
}

func requireBuiltinCap(_ env: inout CapEnv, _ name: String) using Alloc {
    if streq(name, "print") || streq(name, "println") || streq(name, "eprint") || streq(name, "eprintln") {
        require(env, "Log")
    } else if streq(name, "readFile") || streq(name, "writeFile") {
        require(env, "Fs")
    } else if streq(name, "args") {
        require(env, "Alloc")
    }
}

func checkMemberCallee(_ env: inout CapEnv, _ base: Vec[Nd], _ member: String) using Alloc {
    if streq(member, "new") {
        match base.get(0) ?? Nd.wildcard {
            case .ident(let b): requireAllocCtor(env, b)
            default: noop()
        }
    }
}

func requireAllocCtor(_ env: inout CapEnv, _ b: String) using Alloc {
    if streq(b, "Box") || streq(b, "Vec") || streq(b, "String") || streq(b, "HashMap")
        || streq(b, "Soa") || streq(b, "PerCpu") {
        require(env, "Alloc")
    }
}

// ===========================================================================
// Exclusivity (§5.4 / §19.3, phase 1). At any program point the live accesses
// to a storage location must be all-read or a single inout. Phase 1 enforces
// this PER CALL: within one call's argument list no two arguments may produce
// overlapping accesses that conflict. A Place is a root variable name plus a
// path string of `.field` selectors ("" for a bare local); two places overlap
// iff they share a root and one path is a prefix of the other at a segment
// boundary. An argument is inout when the callee declares that parameter
// `inout` (recovered from sigName/sigIdx/sigMode, one row per (func, param))
// or the call site writes `&` (arg's is_inout flag); `sink` params consume, so
// they generate no borrow. Plus the signature-level §11 rule: an `async func`
// may not take an `inout` parameter (a mutable borrow cannot survive a
// suspension). Diagnostics are collected in walk order, matching `vestra check`.
//
// Deliberately not yet modeled (the C++ checker documents the same gaps, and
// vsema additionally lacks types and discards match/vector-literal payloads):
// builtin mutating-method receivers, partition sub-views, cross-statement
// liveness, index subviews, closures.
// ===========================================================================
struct Place {
    var ok: Bool
    var root: String
    var path: String
}

struct Borrows {
    var roots: Vec[String]
    var paths: Vec[String]
    var inouts: Vec[Bool]
}

struct ExEnv {
    var sigName: Vec[String]   // parallel rows: function name ...
    var sigIdx: Vec[Int]       // ... parameter index ...
    var sigMode: Vec[String]   // ... and that parameter's mode ("", "inout ", "sink ")
    var bad: Vec[String]
}

func exCheck(_ env: inout ExEnv, _ u: NUnit) using Alloc {
    var i: Int = 0
    while i < u.decls.len() {
        exCollectDecl(env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    var j: Int = 0
    while j < u.decls.len() {
        exCheckDecl(env, u.decls.get(j) ?? Nd.wildcard)
        j = j + 1
    }
}

// ----- pass 1: record each top-level function's parameter-mode row ----------
// Methods are not recorded: callees are looked up by bare-ident name only, and
// recording method names could shadow a free function of the same name.
func exCollectDecl(_ env: inout ExEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b):
            exRecordSig(env, name, params)
        default: noop()
    }
}

func exRecordSig(_ env: inout ExEnv, _ name: String, _ params: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < params.len() {
        exAddSigRow(env, name, i, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func exAddSigRow(_ env: inout ExEnv, _ name: String, _ idx: Int, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): exPushSig(env, name, idx, md)
        default: noop()
    }
}

func exPushSig(_ env: inout ExEnv, _ name: String, _ idx: Int, _ md: String) using Alloc {
    env.sigName.push(name)
    env.sigIdx.push(idx)
    env.sigMode.push(md)
}

func exModeOf(_ env: inout ExEnv, _ name: String, _ idx: Int) using Alloc -> String {
    var i: Int = 0
    while i < env.sigName.len() {
        if let n = env.sigName.get(i) {
            if streq(n, name) && (env.sigIdx.get(i) ?? -1) == idx {
                return env.sigMode.get(i) ?? own("")
            }
        }
        i = i + 1
    }
    return own("")
}

// ----- pass 2: walk bodies, gathering per-call borrows ----------------------
func exCheckDecl(_ env: inout ExEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b):
            exCheckFunc(env, mods, name, params, b)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): exCheckMethods(env, m)
        case .enumD(let vis, let name, let cs, let m, let generics): exCheckMethods(env, m)
        default: noop()
    }
}

func exCheckMethods(_ env: inout ExEnv, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        exCheckDecl(env, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func exCheckFunc(_ env: inout ExEnv, _ mods: String, _ name: String, _ params: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    exAsyncInout(env, mods, name, params)
    exBoxed(env, body)
}

func exAsyncInout(_ env: inout ExEnv, _ mods: String, _ name: String, _ params: Vec[Nd]) using Alloc {
    if !containsSub(mods, "async") { return }
    var i: Int = 0
    while i < params.len() {
        exCheckAsyncParam(env, name, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func exCheckAsyncParam(_ env: inout ExEnv, _ name: String, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): exAsyncParamRow(env, name, nm, lbl, md)
        default: noop()
    }
}

func exAsyncParamRow(_ env: inout ExEnv, _ name: String, _ nm: String, _ lbl: String, _ md: String) using Alloc {
    if containsSub(md, "inout") { env.bad.push(exAsyncMsg(name, exParamName(nm, lbl))) }
}

func exParamName(_ nm: String, _ lbl: String) -> String {
    if streq(nm, "") { return lbl }
    return nm
}

func exAsyncMsg(_ fn: String, _ pn: String) using Alloc -> String {
    var s: String = "async function '"
    s.append(fn)
    s.append("' cannot take an `inout` parameter ('")
    s.append(pn)
    s.append("') — a mutable borrow cannot survive a suspension (no borrow across await)")
    return s
}

func exBoxed(_ env: inout ExEnv, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { exExpr(env, v.get(0) ?? Nd.wildcard) }
}

func exPair(_ env: inout ExEnv, _ a: Vec[Nd], _ b: Vec[Nd]) using Alloc {
    exBoxed(env, a)
    exBoxed(env, b)
}

func exExpr(_ env: inout ExEnv, _ e: Nd) using Alloc {
    match e {
        case .call(let callee, let args): exCall(env, callee, args)
        case .prefixE(let kw, let inner): exBoxed(env, inner)
        case .paren(let x): exBoxed(env, x)
        case .unary(let op, let x): exBoxed(env, x)
        case .binary(let op, let l, let r): exPair(env, l, r)
        case .member(let base, let n, let c): exBoxed(env, base)
        case .index(let base, let idxs): exIndex(env, base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): exIf(env, li, cond, thenB, els)
        case .block(let stmts): exBlock(env, stmts)
        case .asE(let v, let t, let o): exBoxed(env, v)
        case .addrOf(let x): exBoxed(env, x)
        case .arg(let l, let io, let v): exBoxed(env, v)
        case .doCatchE(let db, let en, let et, let cb): exPair(env, db, cb)
        default: noop()
    }
}

func exIndex(_ env: inout ExEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    exBoxed(env, base)
    var i: Int = 0
    while i < idxs.len() {
        exExpr(env, idxs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func exIf(_ env: inout ExEnv, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc {
    exBoxed(env, cond)
    exBoxed(env, li)
    exBoxed(env, thenB)
    exBoxed(env, els)
}

func exBlock(_ env: inout ExEnv, _ stmts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < stmts.len() {
        exStmt(env, stmts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func exStmt(_ env: inout ExEnv, _ s: Nd) using Alloc {
    match s {
        case .letS(let p, let ty, let v): exBoxed(env, v)
        case .varS(let p, let ty, let v): exBoxed(env, v)
        case .exprS(let e): exBoxed(env, e)
        case .retS(let v): exBoxed(env, v)
        case .assignS(let op, let t, let v): exPair(env, t, v)
        case .whileS(let c, let b): exPair(env, c, b)
        case .forS(let pp, let it, let b): exPair(env, it, b)
        case .withS(let caps, let vals, let body): exWith(env, vals, body)
        default: noop()
    }
}

func exWith(_ env: inout ExEnv, _ vals: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < vals.len() {
        exExpr(env, vals.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    exBoxed(env, body)
}

// ----- the per-call borrow gather + pairwise conflict scan ------------------
func exCall(_ env: inout ExEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    // Recurse into callee + every argument first: nested calls' borrows have
    // ended by the time this call evaluates.
    exBoxed(env, callee)
    var r: Int = 0
    while r < args.len() {
        exExpr(env, args.get(r) ?? Nd.wildcard)
        r = r + 1
    }
    // Recover the callee's name for parameter-mode lookup (bare ident only;
    // member-expr callees default every parameter to read).
    let fname = exCalleeNameBoxed(callee)
    var bs = Borrows(roots: Vec.new(), paths: Vec.new(), inouts: Vec.new())
    var i: Int = 0
    while i < args.len() {
        exGatherArg(env, fname, i, args.get(i) ?? Nd.wildcard, &bs)
        i = i + 1
    }
    exConflictScan(env, &bs)
}

func exCalleeNameBoxed(_ callee: Vec[Nd]) using Alloc -> String {
    if callee.len() > 0 { return exCalleeName(callee.get(0) ?? Nd.wildcard) }
    return own("")
}

func exCalleeName(_ callee: Nd) using Alloc -> String {
    return match callee {
        case .ident(let nm): nm
        default: own("")
    }
}

func exGatherArg(_ env: inout ExEnv, _ fname: String, _ idx: Int, _ a: Nd, _ bs: inout Borrows) using Alloc {
    match a {
        case .arg(let label, let isInout, let val): exGatherArgVal(env, fname, idx, isInout, val, bs)
        default: noop()
    }
}

func exGatherArgVal(_ env: inout ExEnv, _ fname: String, _ idx: Int, _ isInout: Bool, _ val: Vec[Nd], _ bs: inout Borrows) using Alloc {
    var mode: String = exModeOf(env, fname, idx)
    if isInout { mode = "inout " }
    if streq(mode, "sink ") { return }
    let pl = exAsPlaceBoxed(val)
    if pl.ok { exPushBorrow(bs, pl.root, pl.path, streq(mode, "inout ")) }
}

func exPushBorrow(_ bs: inout Borrows, _ root: String, _ path: String, _ isInout: Bool) using Alloc {
    bs.roots.push(root)
    bs.paths.push(path)
    bs.inouts.push(isInout)
}

func exConflictScan(_ env: inout ExEnv, _ bs: inout Borrows) using Alloc {
    let n = bs.roots.len()
    var i: Int = 0
    while i < n {
        var j: Int = i + 1
        while j < n {
            exMaybeConflict(env, bs, i, j)
            j = j + 1
        }
        i = i + 1
    }
}

func exMaybeConflict(_ env: inout ExEnv, _ bs: inout Borrows, _ i: Int, _ j: Int) using Alloc {
    let rA = bs.roots.get(i) ?? own("")
    let rB = bs.roots.get(j) ?? own("")
    let pA = bs.paths.get(i) ?? own("")
    let pB = bs.paths.get(j) ?? own("")
    let inA = bs.inouts.get(i) ?? false
    let inB = bs.inouts.get(j) ?? false
    if exOverlap(rA, pA, rB, pB) && (inA || inB) {
        if streq(pA, pB) { env.bad.push(exBorrowTwice(rA, pA)) }
        else { env.bad.push(exOverlapMsg(rA, pA, rB, pB)) }
    }
}

func exOverlap(_ rA: String, _ pA: String, _ rB: String, _ pB: String) -> Bool {
    if !streq(rA, rB) { return false }
    return exPathPrefix(pA, pB) || exPathPrefix(pB, pA)
}

// Is `a` a path-prefix of `b`? The empty path is a prefix of everything; a
// non-empty prefix must end at a `.field` segment boundary so that `.x` is not
// treated as a prefix of `.xy`.
func exPathPrefix(_ a: String, _ b: String) -> Bool {
    if a.len() == 0 { return true }
    if a.len() > b.len() { return false }
    var i: Int = 0
    while i < a.len() {
        if (a.byteAt(i) ?? 0) != (b.byteAt(i) ?? 1) { return false }
        i = i + 1
    }
    if a.len() == b.len() { return true }
    return (b.byteAt(a.len()) ?? 0) == 46   // '.' starts the next segment
}

func exRenderPlace(_ root: String, _ path: String) using Alloc -> String {
    var s: String = "'"
    s.append(root)
    s.append(path)
    s.append("'")
    return s
}

func exBorrowTwice(_ root: String, _ path: String) using Alloc -> String {
    var s: String = exRenderPlace(root, path)
    s.append(" is borrowed twice with incompatible modes")
    return s
}

func exOverlapMsg(_ rA: String, _ pA: String, _ rB: String, _ pB: String) using Alloc -> String {
    var s: String = exRenderPlace(rA, pA)
    s.append(" and ")
    s.append(exRenderPlace(rB, pB))
    s.append(" overlap with incompatible borrow modes")
    return s
}

func exAsPlaceBoxed(_ v: Vec[Nd]) using Alloc -> Place {
    if v.len() > 0 { return exAsPlace(v.get(0) ?? Nd.wildcard) }
    return Place(ok: false, root: "", path: "")
}

func exAsPlace(_ e: Nd) using Alloc -> Place {
    return match e {
        case .paren(let inner): exAsPlaceBoxed(inner)
        case .ident(let name): Place(ok: true, root: name, path: "")
        case .member(let base, let m, let chain): exMemberPlace(base, m)
        default: Place(ok: false, root: "", path: "")
    }
}

func exMemberPlace(_ base: Vec[Nd], _ m: String) using Alloc -> Place {
    let b = exAsPlaceBoxed(base)
    if !b.ok { return Place(ok: false, root: "", path: "") }
    var pth: String = b.path
    pth.append(".")
    pth.append(m)
    return Place(ok: true, root: b.root, path: pth)
}

// ===========================================================================
// Ownership / move tracking (§5 / §19.2). Each non-trivial binding (a local or
// parameter whose declared type is not a fixed-width numeric / Bool / Char /
// Unit) carries a Live/Consumed state, held in the parallel (names, consumed)
// arrays and reset per function. A binding is consumed (moved) by `let`/`var`-
// binding it, `return`ing it, or passing it to a `sink` parameter or a struct/
// enum constructor argument. Using a consumed binding is `use of '<x>' after it
// was moved`; consuming it again is `'<x>' was already moved and cannot be moved
// again`. `copy x` is a read, not a move (the place lives in a non-ident node).
// A `var` reassignment revives its target. Diagnostics are collected in walk
// order, matching `vestra check`.
//
// Deliberately not yet modeled (vsema lacks types so triviality is read off the
// type ANNOTATION — an unannotated/inferred binding is treated as untracked, so
// curated tests annotate any binding they move): branch-aware flow merge across
// `if`/`match` (analysis is straight-line; `match` payloads are dropped anyway),
// field-level moves, and the linear `linear`-struct must-consume / leak check
// (the parser discards the `linear` modifier).
// ===========================================================================
struct OwnEnv {
    var names: Vec[String]      // tracked non-trivial binding names (per function)
    var consumed: Vec[Bool]     // parallel: has each name been moved?
    var sigName: Vec[String]    // global: function param-mode rows ...
    var sigIdx: Vec[Int]        // ... parameter index ...
    var sigMode: Vec[String]    // ... and that parameter's mode (for `sink`)
    var ctors: Vec[String]      // global: struct / enum names (constructor args are sinks)
    var bad: Vec[String]
    var linears: Vec[String]    // global: `linear struct` names (closed over fields)
    var isLin: Vec[Bool]        // parallel to names: is the binding of a linear type?
    var leakRep: Vec[String]    // per function: linear bindings already reported leaking
    var fieldOwner: Vec[String] // global: struct name of each field row ...
    var fieldTy: Vec[Nd]        // ... and that field's type
    var neverFns: Vec[String]   // global: functions whose result is Never
    var fnName: Vec[String]     // global: function name ...
    var fnRet: Vec[Nd]          // ... and its result type (wildcard when Unit)
    var fieldName: Vec[String]  // global: parallel to fieldOwner / fieldTy
    var staticName: Vec[String] // global: statics ...
    var staticTy: Vec[Nd]       // ... and their types
    var pName: Vec[String]      // per function: parameter name ...
    var pMode: Vec[String]      // ... mode ("", "inout ", "sink ") ...
    var pTy: Vec[Nd]            // ... and type
    var locName: Vec[String]    // per function: local name ...
    var locTy: Vec[Nd]          // ... and its declared (or constructed) type
    var selfTy: String          // per method: the owning type ("" outside one)
    var borrows: Vec[String]    // per function: `if let` bindings borrowed from a place
    var fKeys: Vec[String]      // per path: places known to be empty (encoded keys) ...
    var fIds: Vec[String]       // ... the locals their indices mention (" a b ") ...
    var fStatic: Vec[Bool]      // ... and whether the root is a static
}

// §19.6 a storage place: a field / element path from a root this function
// doesn't own outright (a static, `self`, a `read` / `inout` parameter, or a
// path below any binding). `key` encodes it part by part ("r:name|.f|#i").
struct OwnPlace {
    var ok: Bool
    var key: String
    var text: String       // as the bootstrap renders it: `k.slots[i]`
    var ids: String
    var isStatic: Bool
    var single: Bool       // a bare root, no field or element
    var ty: Vec[Nd]        // its type, empty when unknown
}

struct OwnFacts {
    var keys: Vec[String]
    var ids: Vec[String]
    var stat: Vec[Bool]
}

// One path's binding state, for the branch-aware merge (§10 / §5 phase 2).
struct OwnSt {
    var names: Vec[String]
    var consumed: Vec[Bool]
    var isLin: Vec[Bool]
}

func ownCheck(_ env: inout OwnEnv, _ u: NUnit) using Alloc {
    var i: Int = 0
    while i < u.decls.len() {
        ownCollectDecl(env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    ownCloseLinears(env)
    var j: Int = 0
    while j < u.decls.len() {
        ownCheckDecl(env, u.decls.get(j) ?? Nd.wildcard)
        j = j + 1
    }
}

// ----- pass 1: param-mode rows (for `sink`) and constructor names -----------
func ownCollectDecl(_ env: inout OwnEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b):
            ownCollectFunc(env, name, params, r)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): ownCollectStruct(env, name, isLinear, fl)
        case .enumD(let vis, let name, let cs, let m, let generics): env.ctors.push(name)
        case .staticD(let vis, let name, let ty, let v): ownCollectStatic(env, name, ty)
        default: noop()
    }
}

func ownCollectStatic(_ env: inout OwnEnv, _ name: String, _ ty: Vec[Nd]) using Alloc {
    env.staticName.push(name)
    env.staticTy.push(ty.get(0) ?? Nd.wildcard)
}

func ownCollectFunc(_ env: inout OwnEnv, _ name: String, _ params: Vec[Nd], _ r: Vec[Nd]) using Alloc {
    ownRecordSig(env, name, params)
    env.fnName.push(name)
    env.fnRet.push(r.get(0) ?? Nd.wildcard)
    if let t = r.get(0) {
        match t {
            case .named(let path, let g, let a): ownNoteNever(env, name, path)
            default: noop()
        }
    }
}

func ownNoteNever(_ env: inout OwnEnv, _ name: String, _ path: String) using Alloc {
    if streq(path, "Never") { env.neverFns.push(name) }
}

func ownCollectStruct(_ env: inout OwnEnv, _ name: String, _ isLinear: Bool, _ fields: Vec[Nd]) using Alloc {
    env.ctors.push(name)
    if isLinear { env.linears.push(name) }
    var i: Int = 0
    while i < fields.len() {
        ownCollectField(env, name, fields.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func ownCollectField(_ env: inout OwnEnv, _ owner: String, _ f: Nd) using Alloc {
    match f {
        case .field(let k, let n, let ty): ownPushField(env, owner, n, ty)
        default: noop()
    }
}

func ownPushField(_ env: inout OwnEnv, _ owner: String, _ name: String, _ ty: Vec[Nd]) using Alloc {
    env.fieldOwner.push(owner)
    env.fieldName.push(name)
    env.fieldTy.push(ty.get(0) ?? Nd.wildcard)
}

// §5 a struct with a field of a linear type is linear itself (the bootstrap's
// Linearity::decl_is_linear): close the set to a fixpoint.
func ownCloseLinears(_ env: inout OwnEnv) using Alloc {
    var changed: Bool = true
    while changed {
        changed = false
        var i: Int = 0
        while i < env.fieldOwner.len() {
            let owner = env.fieldOwner.get(i) ?? own("")
            if !ownIsLinearName(env, owner) && ownIsLinTy(env, env.fieldTy.get(i) ?? Nd.wildcard) {
                env.linears.push(owner)
                changed = true
            }
            i = i + 1
        }
    }
}

// Is a type linear: a linear struct, or an Optional / array / tuple / generic
// instance (Vec, Box, ...) over one (the bootstrap's Linearity::is_linear).
func ownIsLinTy(_ env: inout OwnEnv, _ t: Nd) -> Bool {
    return match t {
        case .named(let path, let g, let args): ownIsLinearName(env, path) || ownAnyLinTy(env, args)
        case .opt(let x): ownAnyLinTy(env, x)
        case .vecT(let n, let x): ownAnyLinTy(env, x)
        case .tupleT(let xs): ownAnyLinTy(env, xs)
        default: false
    }
}

func ownAnyLinTy(_ env: inout OwnEnv, _ ts: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < ts.len() {
        if ownIsLinTy(env, ts.get(i) ?? Nd.wildcard) { return true }
        i = i + 1
    }
    return false
}

func ownIsNeverFn(_ env: inout OwnEnv, _ name: String) -> Bool {
    if streq(name, "panic") || streq(name, "abort") || streq(name, "unreachable") { return true }
    var i: Int = 0
    while i < env.neverFns.len() {
        if let n = env.neverFns.get(i) {
            if streq(n, name) { return true }
        }
        i = i + 1
    }
    return false
}

// Does calling `name` give a linear value?
func ownFnRetLin(_ env: inout OwnEnv, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.fnName.len() {
        if let n = env.fnName.get(i) {
            if streq(n, name) { return ownIsLinTy(env, env.fnRet.get(i) ?? Nd.wildcard) }
        }
        i = i + 1
    }
    return false
}

func ownRecordSig(_ env: inout OwnEnv, _ name: String, _ params: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < params.len() {
        ownAddSigRow(env, name, i, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func ownAddSigRow(_ env: inout OwnEnv, _ name: String, _ idx: Int, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): ownPushSig(env, name, idx, md)
        default: noop()
    }
}

func ownPushSig(_ env: inout OwnEnv, _ name: String, _ idx: Int, _ md: String) using Alloc {
    env.sigName.push(name)
    env.sigIdx.push(idx)
    env.sigMode.push(md)
}

func ownModeOf(_ env: inout OwnEnv, _ name: String, _ idx: Int) using Alloc -> String {
    var i: Int = 0
    while i < env.sigName.len() {
        if let n = env.sigName.get(i) {
            if streq(n, name) && (env.sigIdx.get(i) ?? -1) == idx { return env.sigMode.get(i) ?? own("") }
        }
        i = i + 1
    }
    return own("")
}

func ownIsCtor(_ env: inout OwnEnv, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.ctors.len() {
        if let c = env.ctors.get(i) {
            if streq(c, name) { return true }
        }
        i = i + 1
    }
    return false
}

// ----- pass 2: per-function flow walk ---------------------------------------
func ownCheckDecl(_ env: inout OwnEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b):
            ownCheckFunc(env, params, b)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): ownCheckOwned(env, name, m)
        case .enumD(let vis, let name, let cs, let m, let generics): ownCheckOwned(env, name, m)
        default: noop()
    }
}

func ownCheckOwned(_ env: inout OwnEnv, _ owner: String, _ methods: Vec[Nd]) using Alloc {
    env.selfTy = own(owner)
    ownCheckMethods(env, methods)
    env.selfTy = own("")
}

func ownCheckMethods(_ env: inout OwnEnv, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        ownCheckDecl(env, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func ownCheckFunc(_ env: inout OwnEnv, _ params: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    ownResetBindings(env)
    ownRegisterParams(env, params)
    ownBoxed(env, body)
    ownReportLeaks(env)
}

func ownResetBindings(_ env: inout OwnEnv) using Alloc {
    while env.names.len() > 0 { let _ = env.names.pop() }
    while env.consumed.len() > 0 { let _ = env.consumed.pop() }
    while env.isLin.len() > 0 { let _ = env.isLin.pop() }
    while env.leakRep.len() > 0 { let _ = env.leakRep.pop() }
    while env.pName.len() > 0 { let _ = env.pName.pop() }
    while env.pMode.len() > 0 { let _ = env.pMode.pop() }
    while env.pTy.len() > 0 { let _ = env.pTy.pop() }
    while env.locName.len() > 0 { let _ = env.locName.pop() }
    while env.locTy.len() > 0 { let _ = env.locTy.pop() }
    while env.borrows.len() > 0 { let _ = env.borrows.pop() }
    ownClearFacts(env)
}

// §5 / §19.6 a linear binding still live at the end of the function leaks (the
// bootstrap's end-of-function check), unless a path leak already named it.
// Parameters carry no obligation.
func ownReportLeaks(_ env: inout OwnEnv) using Alloc {
    var i: Int = 0
    while i < env.names.len() {
        let n = env.names.get(i) ?? own("")
        if (env.isLin.get(i) ?? false) && !(env.consumed.get(i) ?? true) && !ownLeakSeen(env, n) {
            env.bad.push(ownLeakMsg(n))
        }
        i = i + 1
    }
}

func ownLeakSeen(_ env: inout OwnEnv, _ n: String) -> Bool {
    var i: Int = 0
    while i < env.leakRep.len() {
        if let m = env.leakRep.get(i) {
            if streq(m, n) { return true }
        }
        i = i + 1
    }
    return false
}

func ownLeakMsg(_ n: String) using Alloc -> String {
    var s: String = "linear value '"
    s.append(n)
    s.append("' is never consumed; a linear value must be moved to a sink parameter, returned, or destructured before its scope ends")
    return s
}

func ownIsLinearName(_ env: inout OwnEnv, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.linears.len() {
        if let c = env.linears.get(i) {
            if streq(c, name) { return true }
        }
        i = i + 1
    }
    return false
}

// Is the value a `let` binds linear? From its annotation, else from the
// initializer: a linear constructor, a function returning a linear type, a
// linear local, or `.take()` on one.
func ownInitLinear(_ env: inout OwnEnv, _ ty: Vec[Nd], _ v: Vec[Nd]) using Alloc -> Bool {
    if let t = ty.get(0) { return ownIsLinTy(env, t) }
    return ownExprLinear(env, v)
}

func ownExprLinear(_ env: inout OwnEnv, _ v: Vec[Nd]) using Alloc -> Bool {
    if let e = v.get(0) {
        return match e {
            case .call(let callee, let args): ownCallLinear(env, callee)
            case .ident(let n): ownLocalLinear(env, n)
            case .paren(let x): ownExprLinear(env, x)
            default: false
        }
    }
    return false
}

func ownCallLinear(_ env: inout OwnEnv, _ callee: Vec[Nd]) using Alloc -> Bool {
    if let c = callee.get(0) {
        return match c {
            case .ident(let n): ownIsLinearName(env, n) || ownFnRetLin(env, n)
            case .member(let base, let m, let ch): streq(m, "take") && (ownExprLinear(env, base) || ownPlaceLinear(env, base))
            default: false
        }
    }
    return false
}

func ownLocalLinear(_ env: inout OwnEnv, _ n: String) -> Bool {
    let idx = ownFind(env, n)
    if idx >= 0 && (env.isLin.get(idx) ?? false) { return true }
    // A parameter carries no obligation itself, but its type is still linear.
    let pi = ownFindIn(env.pName, n)
    return pi >= 0 && ownIsLinTy(env, env.pTy.get(pi) ?? Nd.wildcard)
}

func ownIsNilBoxed(_ v: Vec[Nd]) -> Bool {
    if let e = v.get(0) {
        return match e {
            case .nilLit: true
            case .paren(let x): ownIsNilBoxed(x)
            default: false
        }
    }
    return false
}

func ownRegisterParams(_ env: inout OwnEnv, _ params: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < params.len() {
        ownRegisterParam(env, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func ownRegisterParam(_ env: inout OwnEnv, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): ownRegisterParam2(env, nm, md, ty)
        default: noop()
    }
}

func ownRegisterParam2(_ env: inout OwnEnv, _ name: String, _ md: String, _ ty: Vec[Nd]) using Alloc {
    env.pName.push(name)
    env.pMode.push(md)
    env.pTy.push(ty.get(0) ?? Nd.wildcard)
    ownRegister(env, name, ty)
}

func ownRegister(_ env: inout OwnEnv, _ name: String, _ ty: Vec[Nd]) using Alloc {
    if ownNonTrivialBoxed(ty) { ownPush(env, name, false, false) }
}

func ownPush(_ env: inout OwnEnv, _ name: String, _ consumed: Bool, _ lin: Bool) using Alloc {
    env.names.push(name)
    env.consumed.push(consumed)
    env.isLin.push(lin)
}

// A `let` / `var` binding: tracked when its annotation is non-trivial or its
// value is linear; a linear one initialized to `nil` holds nothing yet.
func ownRegisterLet(_ env: inout OwnEnv, _ name: String, _ ty: Vec[Nd], _ v: Vec[Nd], _ lin: Bool, _ isNil: Bool) using Alloc {
    env.locName.push(name)
    env.locTy.push(ownDeclTy(ty, v))
    if lin { ownPush(env, name, isNil, true) }
    else if ownNonTrivialBoxed(ty) { ownPush(env, name, false, false) }
}

func ownFind(_ env: inout OwnEnv, _ name: String) -> Int {
    var i: Int = 0
    while i < env.names.len() {
        if let n = env.names.get(i) {
            if streq(n, name) { return i }
        }
        i = i + 1
    }
    return -1
}

func ownConsume(_ env: inout OwnEnv, _ name: String) using Alloc {
    let idx = ownFind(env, name)
    if idx < 0 { return }
    if env.consumed.get(idx) ?? false { env.bad.push(ownAlreadyMoved(name)) }
    else { env.consumed.set(idx, true) }
}

func ownUse(_ env: inout OwnEnv, _ name: String) using Alloc {
    let idx = ownFind(env, name)
    if idx >= 0 && (env.consumed.get(idx) ?? false) { env.bad.push(ownUseAfter(name)) }
}

func ownRevive(_ env: inout OwnEnv, _ name: String) {
    let idx = ownFind(env, name)
    if idx >= 0 { env.consumed.set(idx, false) }
}

func ownUseAfter(_ name: String) using Alloc -> String {
    var s: String = "use of '"
    s.append(name)
    s.append("' after it was moved")
    return s
}

func ownAlreadyMoved(_ name: String) using Alloc -> String {
    var s: String = "'"
    s.append(name)
    s.append("' was already moved and cannot be moved again")
    return s
}

func ownNonTrivialBoxed(_ ty: Vec[Nd]) -> Bool {
    if ty.len() == 0 { return false }   // inferred / unknown type: treated as untracked
    return ownNonTrivial(ty.get(0) ?? Nd.wildcard)
}

func ownNonTrivial(_ t: Nd) -> Bool {
    return match t {
        case .named(let path, let g, let a): !ownTrivialName(path)
        default: true
    }
}

func ownTrivialName(_ p: String) -> Bool {
    return streq(p, "Int") || streq(p, "Int8") || streq(p, "Int16") || streq(p, "Int32")
        || streq(p, "Int64") || streq(p, "Int128") || streq(p, "UInt") || streq(p, "UInt8")
        || streq(p, "UInt16") || streq(p, "UInt32") || streq(p, "UInt64") || streq(p, "UInt128")
        || streq(p, "Float32") || streq(p, "Float64") || streq(p, "Bool") || streq(p, "Char")
        || streq(p, "Unit")
}

func ownBoxed(_ env: inout OwnEnv, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { ownExpr(env, v.get(0) ?? Nd.wildcard) }
}

func ownPair(_ env: inout OwnEnv, _ a: Vec[Nd], _ b: Vec[Nd]) using Alloc {
    ownBoxed(env, a)
    ownBoxed(env, b)
}

func ownExpr(_ env: inout OwnEnv, _ e: Nd) using Alloc {
    match e {
        case .ident(let n): ownUse(env, n)
        case .call(let callee, let args): ownCall(env, callee, args)
        case .prefixE(let kw, let inner): ownBoxed(env, inner)
        case .paren(let x): ownBoxed(env, x)
        case .unary(let op, let x): ownBoxed(env, x)
        case .binary(let op, let l, let r): ownPair(env, l, r)
        case .member(let base, let n, let c): ownBoxed(env, base)
        case .index(let base, let idxs): ownIndex(env, base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): ownIf(env, ln, li, cond, thenB, els)
        case .matchE(let scr, let arms): ownMatch(env, scr, arms)
        case .block(let stmts): ownBlock(env, stmts)
        case .asE(let v, let t, let o): ownBoxed(env, v)
        case .addrOf(let x): ownBoxed(env, x)
        case .arg(let l, let io, let v): ownBoxed(env, v)
        case .doCatchE(let db, let en, let et, let cb): ownPair(env, db, cb)
        default: noop()
    }
}

func ownIndex(_ env: inout OwnEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    ownBoxed(env, base)
    var i: Int = 0
    while i < idxs.len() {
        ownExpr(env, idxs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

// ----- storage places (§19.6, the bootstrap's storage_place et al.) ---------
func ownNoPlace() using Alloc -> OwnPlace {
    return OwnPlace(ok: false, key: "", text: "", ids: "", isStatic: false, single: false, ty: Vec.new())
}

func ownPlace(_ env: inout OwnEnv, _ v: Vec[Nd]) using Alloc -> OwnPlace {
    if let n = v.get(0) {
        return match n {
            case .paren(let x): ownPlace(env, x)
            case .member(let base, let m, let ch): ownPlaceMember(env, base, m, ch)
            case .index(let base, let idxs): ownPlaceIndex(env, base, idxs)
            case .selfE: ownPlaceRoot(env, own("self"), true)
            case .ident(let x): ownPlaceRoot(env, x, true)
            default: ownNoPlace()
        }
    }
    return ownNoPlace()
}

// A root, bare (`single`) or under a path. A bare name is storage only when
// this function doesn't own it: a static, `self`, a read / inout parameter.
func ownPlaceRoot(_ env: inout OwnEnv, _ n: String, _ bare: Bool) using Alloc -> OwnPlace {
    var ty: Vec[Nd] = Vec.new()
    var known: Bool = false
    var storage: Bool = false
    var isStatic: Bool = false
    if streq(n, "self") {
        if streq(env.selfTy, "") { return ownNoPlace() }
        ty.push(Nd.named(own(env.selfTy), false, Vec.new()))
        known = true
        storage = true
    } else {
        let pi = ownFindIn(env.pName, n)
        let li = ownFindIn(env.locName, n)
        let si = ownFindIn(env.staticName, n)
        if li >= 0 { ty.push(env.locTy.get(li) ?? Nd.wildcard); known = true }
        else if pi >= 0 {
            ty.push(env.pTy.get(pi) ?? Nd.wildcard)
            known = true
            storage = !streq(env.pMode.get(pi) ?? own(""), "sink ")
        } else if si >= 0 {
            ty.push(env.staticTy.get(si) ?? Nd.wildcard)
            known = true
            storage = true
            isStatic = true
        }
    }
    if !known || (bare && !storage) { return ownNoPlace() }
    var key: String = "r:"
    key.append(n)
    return OwnPlace(ok: true, key: key, text: own(n), ids: "", isStatic: isStatic, single: bare, ty: ty)
}

func ownFindIn(_ xs: Vec[String], _ n: String) -> Int {
    var i: Int = xs.len() - 1
    while i >= 0 {
        if let x = xs.get(i) {
            if streq(x, n) { return i }
        }
        i = i - 1
    }
    return -1
}

func ownPlaceBase(_ env: inout OwnEnv, _ base: Vec[Nd]) using Alloc -> OwnPlace {
    if let n = base.get(0) {
        return match n {
            case .paren(let x): ownPlaceBase(env, x)
            case .ident(let x): ownPlaceRoot(env, x, false)
            case .selfE: ownPlaceRoot(env, own("self"), false)
            default: ownPlace(env, base)
        }
    }
    return ownNoPlace()
}

func ownPlaceMember(_ env: inout OwnEnv, _ base: Vec[Nd], _ m: String, _ chain: Bool) using Alloc -> OwnPlace {
    if chain { return ownNoPlace() }
    var b = ownPlaceBase(env, base)
    if !b.ok { return b }
    b.key.append("|.")
    b.key.append(m)
    b.text.append(".")
    b.text.append(m)
    b.single = false
    b.ty = ownFieldTy(env, b.ty, m)
    return b
}

func ownPlaceIndex(_ env: inout OwnEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc -> OwnPlace {
    if idxs.len() != 1 { return ownNoPlace() }
    var b = ownPlaceBase(env, base)
    if !b.ok { return b }
    var ids: String = ""
    let r = ownRenderIndex(idxs.get(0) ?? Nd.wildcard, ids)
    if streq(r, "") { return ownNoPlace() }
    b.key.append("|#")
    b.key.append(r)
    b.text.append("[")
    b.text.append(r)
    b.text.append("]")
    b.ids.append(ids)
    b.single = false
    b.ty = ownElemTy(b.ty)
    return b
}

// An index the bootstrap compares textually: names, integer literals, fields
// of those, + - * of those, and a one-argument conversion. "" otherwise.
func ownRenderIndex(_ e: Nd, _ ids: inout String) using Alloc -> String {
    return match e {
        case .ident(let n): ownRenderId(n, ids)
        case .intLit(let t): own(t)
        case .paren(let x): ownRenderIndex(x.get(0) ?? Nd.wildcard, ids)
        case .member(let base, let m, let ch): ownRenderMember(base, m, ids)
        case .binary(let op, let l, let r): ownRenderBin(op, l, r, ids)
        case .call(let callee, let args): ownRenderConv(callee, args, ids)
        default: own("")
    }
}

func ownRenderId(_ n: String, _ ids: inout String) using Alloc -> String {
    ids.append(" ")
    ids.append(n)
    ids.append(" ")
    return own(n)
}

func ownRenderMember(_ base: Vec[Nd], _ m: String, _ ids: inout String) using Alloc -> String {
    let b = ownRenderIndex(base.get(0) ?? Nd.wildcard, ids)
    if streq(b, "") { return own("") }
    var s = b
    s.append(".")
    s.append(m)
    return s
}

func ownRenderBin(_ op: String, _ l: Vec[Nd], _ r: Vec[Nd], _ ids: inout String) using Alloc -> String {
    if !streq(op, "+") && !streq(op, "-") && !streq(op, "*") { return own("") }
    let a = ownRenderIndex(l.get(0) ?? Nd.wildcard, ids)
    let b = ownRenderIndex(r.get(0) ?? Nd.wildcard, ids)
    if streq(a, "") || streq(b, "") { return own("") }
    var s: String = "("
    s.append(a)
    s.append(" ")
    s.append(op)
    s.append(" ")
    s.append(b)
    s.append(")")
    return s
}

func ownRenderConv(_ callee: Vec[Nd], _ args: Vec[Nd], _ ids: inout String) using Alloc -> String {
    let f = ownIdentName(callee)
    if streq(f, "") || args.len() != 1 { return own("") }
    let a = ownRenderIndex(ownArgValue(args.get(0) ?? Nd.wildcard).get(0) ?? Nd.wildcard, ids)
    if streq(a, "") { return own("") }
    var s = f
    s.append("(")
    s.append(a)
    s.append(")")
    return s
}

func ownFieldTy(_ env: inout OwnEnv, _ bt: Vec[Nd], _ m: String) using Alloc -> Vec[Nd] {
    var out: Vec[Nd] = Vec.new()
    let sn = ownTyHead(bt)
    if streq(sn, "") { return out }
    var i: Int = 0
    while i < env.fieldOwner.len() {
        if streq(env.fieldOwner.get(i) ?? own(""), sn) && streq(env.fieldName.get(i) ?? own(""), m) {
            out.push(env.fieldTy.get(i) ?? Nd.wildcard)
            return out
        }
        i = i + 1
    }
    return out
}

func ownTyHead(_ t: Vec[Nd]) using Alloc -> String {
    if let n = t.get(0) {
        return match n {
            case .named(let path, let g, let a): own(path)
            default: own("")
        }
    }
    return own("")
}

// The element of `[N]T` or `Vec[T]`.
func ownElemTy(_ t: Vec[Nd]) using Alloc -> Vec[Nd] {
    if let n = t.get(0) {
        return match n {
            case .vecT(let len, let e): e
            case .named(let path, let g, let args): ownVecArg(path, args)
            default: Vec.new()
        }
    }
    return Vec.new()
}

func ownVecArg(_ path: String, _ args: Vec[Nd]) using Alloc -> Vec[Nd] {
    var out: Vec[Nd] = Vec.new()
    if streq(path, "Vec") && args.len() > 0 { out.push(args.get(0) ?? Nd.wildcard) }
    return out
}

func ownTyLinear(_ env: inout OwnEnv, _ t: Vec[Nd]) -> Bool {
    if let n = t.get(0) { return ownIsLinTy(env, n) }
    return false
}

func ownTyIsOpt(_ t: Vec[Nd]) -> Bool {
    if let n = t.get(0) {
        return match n {
            case .opt(let x): true
            default: false
        }
    }
    return false
}

// Is the expression a storage place holding a linear value?
func ownPlaceLinear(_ env: inout OwnEnv, _ v: Vec[Nd]) using Alloc -> Bool {
    let pl = ownPlace(env, v)
    return pl.ok && ownTyLinear(env, pl.ty)
}

// A declared type, or the struct a constructor call builds.
func ownDeclTy(_ ty: Vec[Nd], _ v: Vec[Nd]) using Alloc -> Nd {
    if let t = ty.get(0) { return t }
    if let e = v.get(0) {
        return match e {
            case .call(let callee, let args): Nd.named(ownIdentName(callee), false, Vec.new())
            default: Nd.wildcard
        }
    }
    return Nd.wildcard
}

func ownIsBorrowed(_ env: inout OwnEnv, _ n: String) -> Bool {
    return !streq(n, "") && ownFindIn(env.borrows, n) >= 0
}

// Moving a linear value out of a storage place (or out of an `if let` that only
// borrows it) is an error; the place would still hold it.
func ownRejectMoveOut(_ env: inout OwnEnv, _ v: Vec[Nd]) using Alloc {
    let n = ownIdentName(v)
    if ownIsBorrowed(env, n) {
        var m: String = "'"
        m.append(n)
        m.append("' is borrowed from its place (an `if let` on a field or element doesn't move the value); move it out with `if let ")
        m.append(n)
        m.append(" = <place>.take()`")
        env.bad.push(m)
        return
    }
    let pl = ownPlace(env, v)
    if !pl.ok || !ownTyLinear(env, pl.ty) { return }
    var m: String = ""
    if pl.single && !pl.isStatic {
        m.append("can't move the linear value '")
        m.append(pl.text)
        m.append("': it's a `read` or `inout` parameter, so the caller still owns it; take it as `sink` to move it")
    } else if ownTyIsOpt(pl.ty) {
        m.append("can't move the linear value out of '")
        m.append(pl.text)
        m.append("': the place would still hold it; use '")
        m.append(pl.text)
        m.append(".take()', which moves it out and leaves the place empty")
    } else {
        m.append("can't move the linear value out of '")
        m.append(pl.text)
        m.append("': the place would still hold it; keep it in an Optional and move it out with '.take()', or move the value that owns the place")
    }
    env.bad.push(m)
}

// ----- empty-place facts -----------------------------------------------------
func ownClearFacts(_ env: inout OwnEnv) using Alloc {
    while env.fKeys.len() > 0 { let _ = env.fKeys.pop() }
    while env.fIds.len() > 0 { let _ = env.fIds.pop() }
    while env.fStatic.len() > 0 { let _ = env.fStatic.pop() }
}

func ownAddFact(_ env: inout OwnEnv, _ pl: OwnPlace) using Alloc {
    env.fKeys.push(own(pl.key))
    env.fIds.push(own(pl.ids))
    env.fStatic.push(pl.isStatic)
}

func ownKnownEmpty(_ env: inout OwnEnv, _ key: String) -> Bool {
    return ownFindIn(env.fKeys, key) >= 0
}

func ownFactsSnap(_ env: inout OwnEnv) using Alloc -> OwnFacts {
    var f = OwnFacts(keys: Vec.new(), ids: Vec.new(), stat: Vec.new())
    var i: Int = 0
    while i < env.fKeys.len() {
        f.keys.push(env.fKeys.get(i) ?? own(""))
        f.ids.push(env.fIds.get(i) ?? own(""))
        f.stat.push(env.fStatic.get(i) ?? false)
        i = i + 1
    }
    return f
}

func ownFactsLoad(_ env: inout OwnEnv, _ f: OwnFacts) using Alloc {
    ownClearFacts(env)
    ownFactsAdd(env, f)
}

func ownFactsAdd(_ env: inout OwnEnv, _ f: OwnFacts) using Alloc {
    var i: Int = 0
    while i < f.keys.len() {
        env.fKeys.push(f.keys.get(i) ?? own(""))
        env.fIds.push(f.ids.get(i) ?? own(""))
        env.fStatic.push(f.stat.get(i) ?? false)
        i = i + 1
    }
}

// Keep only the facts both exits agree on (in the then-exit's order).
func ownFactsMeet(_ env: inout OwnEnv, _ thenF: OwnFacts) using Alloc {
    let cur = ownFactsSnap(env)
    ownClearFacts(env)
    var i: Int = 0
    while i < thenF.keys.len() {
        let k = thenF.keys.get(i) ?? own("")
        if ownFindIn(cur.keys, k) >= 0 {
            env.fKeys.push(k)
            env.fIds.push(thenF.ids.get(i) ?? own(""))
            env.fStatic.push(thenF.stat.get(i) ?? false)
        }
        i = i + 1
    }
}

// Drop the facts matching `drop`: 0 = may alias `key`, 1 = mention local `key`,
// 2 = rooted at `key`, 3 = rooted at a static.
func ownKillWhere(_ env: inout OwnEnv, _ drop: Int, _ key: String) using Alloc {
    let cur = ownFactsSnap(env)
    ownClearFacts(env)
    var i: Int = 0
    while i < cur.keys.len() {
        let k = cur.keys.get(i) ?? own("")
        let ids = cur.ids.get(i) ?? own("")
        let st = cur.stat.get(i) ?? false
        var kill: Bool = false
        if drop == 0 { kill = ownMayAlias(k, key) }
        else if drop == 1 { kill = streq(ownKeyRoot(k), key) || containsSub(ids, ownSpaced(key)) }
        else if drop == 2 { kill = streq(ownKeyRoot(k), key) }
        else { kill = st }
        if !kill {
            env.fKeys.push(k)
            env.fIds.push(ids)
            env.fStatic.push(st)
        }
        i = i + 1
    }
}

func ownKillAliasing(_ env: inout OwnEnv, _ key: String) using Alloc { ownKillWhere(env, 0, key) }
func ownKillMentioning(_ env: inout OwnEnv, _ n: String) using Alloc { ownKillWhere(env, 1, n) }
func ownKillRooted(_ env: inout OwnEnv, _ n: String) using Alloc { ownKillWhere(env, 2, n) }
func ownKillStatics(_ env: inout OwnEnv) using Alloc { ownKillWhere(env, 3, own("")) }

func ownSpaced(_ n: String) using Alloc -> String {
    var s: String = " "
    s.append(n)
    s.append(" ")
    return s
}

// "r:k|.slots|#i" -> "k"
func ownKeyRoot(_ key: String) using Alloc -> String {
    var i: Int = 2
    while i < key.len() {
        if (key.byteAt(i) ?? 0) == 124 { return own(key.slice(2, i)) }   // '|'
        i = i + 1
    }
    return own(key.slice(2, key.len()))
}

// Two places may be the same storage: one is a prefix of the other, or they
// first differ at an element index (two different fields never are).
func ownMayAlias(_ a: String, _ b: String) using Alloc -> Bool {
    let pa = a.split("|")
    let pb = b.split("|")
    var n: Int = pa.len()
    if pb.len() < n { n = pb.len() }
    var i: Int = 0
    while i < n {
        let x = pa.get(i) ?? ""
        let y = pb.get(i) ?? ""
        let xi = (x.byteAt(0) ?? 0) == 35   // '#'
        let yi = (y.byteAt(0) ?? 0) == 35
        if xi != yi { return false }
        if !streq(own(x), own(y)) { return xi }
        i = i + 1
    }
    return true
}

// `if p == nil` (and `&&` chains of them) proves p empty in the then-branch;
// `if p != nil` proves it in the else-branch.
func ownNilFacts(_ env: inout OwnEnv, _ cond: Vec[Nd], _ wantNil: Bool, _ out: inout OwnFacts) using Alloc {
    if let n = cond.get(0) {
        match n {
            case .paren(let x): ownNilFacts(env, x, wantNil, out)
            case .binary(let op, let l, let r): ownNilBin(env, op, l, r, wantNil, out)
            default: noop()
        }
    }
}

func ownNilBin(_ env: inout OwnEnv, _ op: String, _ l: Vec[Nd], _ r: Vec[Nd], _ wantNil: Bool, _ out: inout OwnFacts) using Alloc {
    if wantNil && streq(op, "&&") {
        ownNilFacts(env, l, true, out)
        ownNilFacts(env, r, true, out)
        return
    }
    if wantNil && !streq(op, "==") { return }
    if !wantNil && !streq(op, "!=") { return }
    var other: Vec[Nd] = Vec.new()
    if ownIsNilBoxed(r) { other = l } else if ownIsNilBoxed(l) { other = r }
    if other.len() == 0 { return }
    let pl = ownPlace(env, other)
    if pl.ok {
        out.keys.push(own(pl.key))
        out.ids.push(own(pl.ids))
        out.stat.push(pl.isStatic)
    }
}

// A loop body runs again after its own writes: no empty-place fact crosses into
// it or out of it.
func ownLoop(_ env: inout OwnEnv, _ head: Vec[Nd], _ body: Vec[Nd], _ isFor: Bool) using Alloc {
    ownClearFacts(env)
    // A `while` condition runs every iteration; a `for` iterable once.
    var pre = ownSnap(env)
    ownBoxed(env, head)
    if isFor { pre = ownSnap(env) }
    ownBoxed(env, body)
    ownLoopMoves(env, pre, body)
    ownClearFacts(env)
}

// §5 / §19.2 a binding from outside the loop, live on entry and still moved at
// the end of the body, is used after the move by the next iteration. (A body
// that can't fall through never repeats.)
func ownLoopMoves(_ env: inout OwnEnv, _ pre: OwnSt, _ body: Vec[Nd]) using Alloc {
    if ownDiverges(env, body) { return }
    var i: Int = 0
    while i < pre.names.len() {
        if !(pre.consumed.get(i) ?? true) {
            let n = pre.names.get(i) ?? own("")
            let j = ownFind(env, n)
            if j >= 0 && (env.consumed.get(j) ?? false) {
                var m: String = "'"
                m.append(n)
                m.append("' is moved inside a loop, so the next iteration would use it after the move; move it on a path that leaves the loop, or reassign it before the loop repeats")
                env.bad.push(m)
            }
        }
        i = i + 1
    }
}

// ----- branch-aware flow (the bootstrap's §10/§5 phase 2) -------------------
func ownSnap(_ env: inout OwnEnv) using Alloc -> OwnSt {
    var st = OwnSt(names: Vec.new(), consumed: Vec.new(), isLin: Vec.new())
    var i: Int = 0
    while i < env.names.len() {
        st.names.push(env.names.get(i) ?? own(""))
        st.consumed.push(env.consumed.get(i) ?? false)
        st.isLin.push(env.isLin.get(i) ?? false)
        i = i + 1
    }
    return st
}

func ownLoad(_ env: inout OwnEnv, _ st: OwnSt) using Alloc {
    ownClearRows(env)
    var i: Int = 0
    while i < st.names.len() {
        ownPush(env, st.names.get(i) ?? own(""), st.consumed.get(i) ?? false, st.isLin.get(i) ?? false)
        i = i + 1
    }
}

func ownClearRows(_ env: inout OwnEnv) using Alloc {
    while env.names.len() > 0 { let _ = env.names.pop() }
    while env.consumed.len() > 0 { let _ = env.consumed.pop() }
    while env.isLin.len() > 0 { let _ = env.isLin.pop() }
}

func ownStFind(_ st: OwnSt, _ name: String) -> Int {
    var i: Int = 0
    while i < st.names.len() {
        if let n = st.names.get(i) {
            if streq(n, name) { return i }
        }
        i = i + 1
    }
    return -1
}

// Fold a branch's moves into the current state: a binding moved on any path
// reaching the join is moved after it.
func ownMergeIn(_ env: inout OwnEnv, _ br: OwnSt) using Alloc {
    var i: Int = 0
    while i < br.names.len() {
        if br.consumed.get(i) ?? false {
            let n = br.names.get(i) ?? own("")
            let j = ownFind(env, n)
            if j >= 0 { env.consumed.set(j, true) }
            else { ownPush(env, n, true, br.isLin.get(i) ?? false) }
        }
        i = i + 1
    }
}

// §5 / §19.6 a linear binding live before a branch must be consumed on every
// path through it, or on none.
func ownDivergence(_ env: inout OwnEnv, _ pre: OwnSt, _ brs: Vec[OwnSt]) using Alloc {
    var i: Int = 0
    while i < pre.names.len() {
        if (pre.isLin.get(i) ?? false) && !(pre.consumed.get(i) ?? true) {
            let n = pre.names.get(i) ?? own("")
            var anyC: Bool = false
            var allC: Bool = true
            var b: Int = 0
            while b < brs.len() {
                let st = brs.get(b) ?? OwnSt(names: Vec.new(), consumed: Vec.new(), isLin: Vec.new())
                let k = ownStFind(st, n)
                let c = k >= 0 && (st.consumed.get(k) ?? false)
                anyC = anyC || c
                allC = allC && c
                b = b + 1
            }
            if anyC && !allC { env.bad.push(ownBranchLeakMsg(n)) }
        }
        i = i + 1
    }
}

func ownBranchLeakMsg(_ n: String) using Alloc -> String {
    var s: String = "linear value '"
    s.append(n)
    s.append("' is consumed on some branches but leaks on the path(s) that do not consume it")
    return s
}

// A branch that leaves the function with a linear value still live leaks it.
func ownPathLeaks(_ env: inout OwnEnv, _ st: OwnSt) using Alloc {
    var i: Int = 0
    while i < st.names.len() {
        let n = st.names.get(i) ?? own("")
        if (st.isLin.get(i) ?? false) && !(st.consumed.get(i) ?? true) && !ownLeakSeen(env, n) {
            env.leakRep.push(n)
            var m: String = "linear value '"
            m.append(n)
            m.append("' leaks on this path, which leaves the function without consuming it")
            env.bad.push(m)
        }
        i = i + 1
    }
}

// Can't the branch fall through? (The bootstrap's block_diverges: a block
// ending in return / break / continue / throw / a Never call.)
func ownDiverges(_ env: inout OwnEnv, _ v: Vec[Nd]) -> Bool {
    if let n = v.get(0) {
        return match n {
            case .block(let stmts): ownLastDiverges(env, stmts)
            case .call(let callee, let args): ownNeverCallee(env, callee)
            default: false
        }
    }
    return false
}

func ownLastDiverges(_ env: inout OwnEnv, _ stmts: Vec[Nd]) -> Bool {
    if stmts.len() == 0 { return false }
    let last = stmts.get(stmts.len() - 1) ?? Nd.wildcard
    return match last {
        case .retS(let v): true
        case .breakS(let l): true
        case .continueS(let l): true
        case .exprS(let e): ownExprDiverges(env, e)
        default: false
    }
}

func ownExprDiverges(_ env: inout OwnEnv, _ e: Vec[Nd]) -> Bool {
    if let n = e.get(0) {
        return match n {
            case .throwE(let x): true
            case .call(let callee, let args): ownNeverCallee(env, callee)
            default: false
        }
    }
    return false
}

func ownNeverCallee(_ env: inout OwnEnv, _ callee: Vec[Nd]) -> Bool {
    if let c = callee.get(0) {
        return match c {
            case .ident(let n): ownIsNeverFn(env, n)
            default: false
        }
    }
    return false
}

// Does a diverging branch leave the function (rather than break / continue)?
func ownLeavesFn(_ env: inout OwnEnv, _ v: Vec[Nd]) -> Bool {
    if let n = v.get(0) {
        return match n {
            case .block(let stmts): ownLastNotLoopJump(stmts)
            default: ownDiverges(env, v)
        }
    }
    return false
}

func ownLastNotLoopJump(_ stmts: Vec[Nd]) -> Bool {
    if stmts.len() == 0 { return false }
    let last = stmts.get(stmts.len() - 1) ?? Nd.wildcard
    return match last {
        case .breakS(let l): false
        case .continueS(let l): false
        default: true
    }
}

// `if` / `if let`: each branch from the same state, then merged at the join.
// An `if let` over a linear local moves it into the binding, which the
// then-branch must move on.
func ownIf(_ env: inout OwnEnv, _ ln: String, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc {
    var letOwned: Bool = false
    var borrowed: Bool = false
    var thenF = OwnFacts(keys: Vec.new(), ids: Vec.new(), stat: Vec.new())
    var elseF = OwnFacts(keys: Vec.new(), ids: Vec.new(), stat: Vec.new())
    if cond.len() > 0 {
        ownBoxed(env, cond)
        ownNilFacts(env, cond, true, thenF)
        ownNilFacts(env, cond, false, elseF)
    }
    else if li.len() > 0 {
        ownBoxed(env, li)
        let lpl = ownPlace(env, li)
        if !streq(ln, "") && lpl.ok && ownTyLinear(env, lpl.ty) {
            env.borrows.push(own(ln))
            borrowed = true
        }
        else if !streq(ln, "") && (ownExprLinear(env, li) || ownPlaceLinear(env, li)) {
            if ownIsBorrowed(env, ownIdentName(li)) { ownRejectMoveOut(env, li) }
            ownConsumeBoxed(env, li)
            letOwned = true
        }
    }
    let preF = ownFactsSnap(env)
    let pre = ownSnap(env)
    ownFactsLoad(env, preF)
    ownFactsAdd(env, thenF)
    if letOwned { ownPush(env, ln, false, true) }
    ownBoxed(env, thenB)
    if letOwned { ownEndIfLet(env, ln, thenB) }
    // The binding (and so its borrow) is scoped to the then-branch.
    if borrowed { let _ = env.borrows.pop() }
    let thenSt = ownSnap(env)
    let thenExitF = ownFactsSnap(env)
    ownLoad(env, pre)
    ownFactsLoad(env, preF)
    ownFactsAdd(env, elseF)
    ownBoxed(env, els)
    let elseSt = ownSnap(env)
    let thenOut = ownDiverges(env, thenB)
    let elseOut = els.len() > 0 && ownDiverges(env, els)
    if elseOut && !thenOut { ownFactsLoad(env, thenExitF) }
    else if !thenOut { ownFactsMeet(env, thenExitF) }
    if thenOut && ownLeavesFn(env, thenB) { ownPathLeaks(env, thenSt) }
    if elseOut && ownLeavesFn(env, els) { ownPathLeaks(env, elseSt) }
    if !thenOut && !elseOut {
        var brs: Vec[OwnSt] = Vec.new()
        brs.push(ownSnapOf(thenSt))
        brs.push(ownSnapOf(elseSt))
        ownDivergence(env, pre, brs)
    }
    if elseOut && !thenOut { ownLoad(env, thenSt) }
    else if !thenOut { ownMergeIn(env, thenSt) }
}

func ownSnapOf(_ st: OwnSt) using Alloc -> OwnSt {
    var c = OwnSt(names: Vec.new(), consumed: Vec.new(), isLin: Vec.new())
    var i: Int = 0
    while i < st.names.len() {
        c.names.push(st.names.get(i) ?? own(""))
        c.consumed.push(st.consumed.get(i) ?? false)
        c.isLin.push(st.isLin.get(i) ?? false)
        i = i + 1
    }
    return c
}

// The `if let` binding goes out of scope after the then-branch: still live
// there (and the branch falls through), it was never consumed.
func ownEndIfLet(_ env: inout OwnEnv, _ ln: String, _ thenB: Vec[Nd]) using Alloc {
    let idx = ownFindLast(env, ln)
    if idx < 0 { return }
    if !(env.consumed.get(idx) ?? true) && !ownDiverges(env, thenB) {
        var m: String = "linear value '"
        m.append(ln)
        m.append("' is never consumed; `if let` moved it out of its Optional, so the then-branch must move it on")
        env.bad.push(m)
    }
    ownRemoveAt(env, idx)
}

func ownFindLast(_ env: inout OwnEnv, _ name: String) -> Int {
    var i: Int = env.names.len() - 1
    while i >= 0 {
        if let n = env.names.get(i) {
            if streq(n, name) { return i }
        }
        i = i - 1
    }
    return -1
}

func ownRemoveAt(_ env: inout OwnEnv, _ idx: Int) using Alloc {
    let st = ownSnap(env)
    ownClearRows(env)
    var i: Int = 0
    while i < st.names.len() {
        if i != idx { ownPush(env, st.names.get(i) ?? own(""), st.consumed.get(i) ?? false, st.isLin.get(i) ?? false) }
        i = i + 1
    }
}

// `match`: guards first (assume each ran), then every arm from that state,
// merged at the join; a linear binding is consumed in every arm or none.
func ownMatch(_ env: inout OwnEnv, _ scr: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    ownBoxed(env, scr)
    var i: Int = 0
    while i < arms.len() {
        ownArmGuard(env, arms.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    let pre = ownSnap(env)
    var merged = ownSnapOf(pre)
    var states: Vec[OwnSt] = Vec.new()
    var a: Int = 0
    while a < arms.len() {
        let body = ownArmBody(arms.get(a) ?? Nd.wildcard)
        if body.len() > 0 {
            ownLoad(env, pre)
            ownBoxed(env, body)
            let st = ownSnap(env)
            ownMergeSt(merged, st)
            states.push(st)
        }
        a = a + 1
    }
    if states.len() > 0 { ownDivergence(env, pre, states) }
    ownLoad(env, merged)
    ownClearFacts(env)
}

func ownArmGuard(_ env: inout OwnEnv, _ arm: Nd) using Alloc {
    match arm {
        case .matchArm(let d, let pat, let g, let body): ownBoxed(env, g)
        default: noop()
    }
}

func ownArmBody(_ arm: Nd) using Alloc -> Vec[Nd] {
    return match arm {
        case .matchArm(let d, let pat, let g, let body): body
        default: Vec.new()
    }
}

func ownMergeSt(_ dst: inout OwnSt, _ br: OwnSt) using Alloc {
    var i: Int = 0
    while i < br.names.len() {
        if br.consumed.get(i) ?? false {
            let n = br.names.get(i) ?? own("")
            let j = ownStFind(dst, n)
            if j >= 0 { dst.consumed.set(j, true) }
            else {
                dst.names.push(n)
                dst.consumed.push(true)
                dst.isLin.push(br.isLin.get(i) ?? false)
            }
        }
        i = i + 1
    }
}

func ownBlock(_ env: inout OwnEnv, _ stmts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < stmts.len() {
        ownStmt(env, stmts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func ownStmt(_ env: inout OwnEnv, _ s: Nd) using Alloc {
    match s {
        case .letS(let p, let ty, let v): ownLet(env, p, ty, v)
        case .varS(let p, let ty, let v): ownLet(env, p, ty, v)
        case .exprS(let e): ownBoxed(env, e)
        case .retS(let v): ownRet(env, v)
        case .assignS(let op, let t, let v): ownAssign(env, t, v)
        case .whileS(let c, let b): ownLoop(env, c, b, false)
        case .forS(let pp, let it, let b): ownLoop(env, it, b, true)
        case .withS(let caps, let vals, let body): ownWith(env, vals, body)
        default: noop()
    }
}

// `let`/`var`: evaluate the value (a use-check on any place it reads), then the
// value place is moved into the new binding, then register the binding itself.
func ownLet(_ env: inout OwnEnv, _ pat: Vec[Nd], _ ty: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    let lin = ownInitLinear(env, ty, v) || ownPlaceLinear(env, v)   // before the initializer's move
    ownBoxed(env, v)
    ownRejectMoveOut(env, v)
    ownConsumeBoxed(env, v)
    if let pn = pat.get(0) {
        match pn {
            case .identP(let n): ownRegisterLet(env, n, ty, v, lin, ownIsNilBoxed(v))
            case .bindP(let n): ownRegisterLet(env, n, ty, v, lin, ownIsNilBoxed(v))
            default: noop()
        }
    }
}

func ownRet(_ env: inout OwnEnv, _ v: Vec[Nd]) using Alloc {
    ownBoxed(env, v)
    ownRejectMoveOut(env, v)
    ownConsumeBoxed(env, v)
}

// `x = y`: a linear `y` moves; then the target. (The bootstrap's
// check_place_assign, for locals.)
func ownAssign(_ env: inout OwnEnv, _ t: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    ownBoxed(env, v)
    if ownExprLinear(env, v) || ownPlaceLinear(env, v) {
        ownRejectMoveOut(env, v)
        ownConsumeBoxed(env, v)
    }
    let pl = ownPlace(env, t)
    if pl.ok { ownAssignPlace(env, t, pl, ownIsNilBoxed(v)); return }
    ownAssignTarget(env, t, ownIsNilBoxed(v))
}

// Assigning to a storage place of a linear type drops what it holds, unless
// it's an Optional known to be empty here.
func ownAssignPlace(_ env: inout OwnEnv, _ t: Vec[Nd], _ pl: OwnPlace, _ isNil: Bool) using Alloc {
    ownBoxed(env, t)
    if ownTyLinear(env, pl.ty) {
        let opt = ownTyIsOpt(pl.ty)
        if !opt || !ownKnownEmpty(env, pl.key) {
            if opt { env.bad.push(ownCouldDropMsg(pl.text)) } else { env.bad.push(ownPlaceDropMsg(pl.text)) }
        }
    }
    ownKillAliasing(env, pl.key)
    if isNil { ownAddFact(env, pl) }
}

func ownCouldDropMsg(_ t: String) using Alloc -> String {
    var s: String = "assigning to '"
    s.append(t)
    s.append("' could drop the linear value it holds; assign only where it's known to be empty (inside `if ")
    s.append(t)
    s.append(" == nil`, or after '")
    s.append(t)
    s.append(".take()'), or use '")
    s.append(t)
    s.append(".put(v)', which checks at run time")
    return s
}

func ownPlaceDropMsg(_ t: String) using Alloc -> String {
    var s: String = "assigning to '"
    s.append(t)
    s.append("' drops the linear value it holds; move the old value out first")
    return s
}

func ownAssignTarget(_ env: inout OwnEnv, _ t: Vec[Nd], _ isNil: Bool) using Alloc {
    if t.len() > 0 { ownAssignTargetE(env, t.get(0) ?? Nd.wildcard, isNil) }
}

// A bare-ident target is a write that revives the binding (§19.2); over a
// linear one still holding its value it drops that value. Anything else
// (member / index) is walked as an ordinary use.
func ownAssignTargetE(_ env: inout OwnEnv, _ e: Nd, _ isNil: Bool) using Alloc {
    match e {
        case .ident(let n): ownAssignLocal(env, n, isNil)
        case .paren(let x): ownAssignTarget(env, x, isNil)
        default: ownExpr(env, e)
    }
}

func ownAssignLocal(_ env: inout OwnEnv, _ n: String, _ isNil: Bool) using Alloc {
    ownKillMentioning(env, n)
    let idx = ownFind(env, n)
    if idx < 0 { return }
    if env.isLin.get(idx) ?? false {
        if !(env.consumed.get(idx) ?? true) { env.bad.push(ownDropMsg(n)) }
        env.consumed.set(idx, isNil)
        return
    }
    env.consumed.set(idx, false)
}

func ownDropMsg(_ n: String) using Alloc -> String {
    var s: String = "assigning to '"
    s.append(n)
    s.append("' drops the linear value it still holds; move that value on first")
    return s
}

func ownWith(_ env: inout OwnEnv, _ vals: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < vals.len() {
        ownExpr(env, vals.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    ownBoxed(env, body)
}

func ownCall(_ env: inout OwnEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    if ownOptMethod(env, callee, args) { return }
    ownBoxed(env, callee)
    let fname = exCalleeNameBoxed(callee)
    let isCtor = ownIsCtor(env, fname)
    var i: Int = 0
    while i < args.len() {
        ownCallArg(env, fname, isCtor, i, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    ownKillStatics(env)   // any call may write a static
}

// `o.take()` empties a linear local Optional; `o.put(v)` fills it (moving a
// linear `v`). The bootstrap's check_optional_method, for locals.
func ownOptMethod(_ env: inout OwnEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc -> Bool {
    if let c = callee.get(0) {
        return match c {
            case .member(let base, let m, let ch): ownOptOn(env, base, m, args)
            default: false
        }
    }
    return false
}

func ownOptOn(_ env: inout OwnEnv, _ base: Vec[Nd], _ m: String, _ args: Vec[Nd]) using Alloc -> Bool {
    let isTake = streq(m, "take") && args.len() == 0
    let isPut = streq(m, "put") && args.len() == 1
    if !isTake && !isPut { return false }
    let pl = ownPlace(env, base)
    if pl.ok && ownTyIsOpt(pl.ty) { ownOptOnPlace(env, base, pl, isTake, args); return true }
    let bn = ownIdentName(base)
    if streq(bn, "") { return false }
    let idx = ownFind(env, bn)
    if idx < 0 || !(env.isLin.get(idx) ?? false) { return false }
    if isTake { env.consumed.set(idx, true); return true }
    let a = ownArgValue(args.get(0) ?? Nd.wildcard)
    ownBoxed(env, a)
    if ownExprLinear(env, a) { ownConsumeBoxed(env, a) }
    let j = ownFind(env, bn)
    if j >= 0 { env.consumed.set(j, false) }
    return true
}

func ownOptOnPlace(_ env: inout OwnEnv, _ base: Vec[Nd], _ pl: OwnPlace, _ isTake: Bool, _ args: Vec[Nd]) using Alloc {
    ownBoxed(env, base)
    if isTake {
        ownKillAliasing(env, pl.key)
        ownAddFact(env, pl)
        return
    }
    let a = ownArgValue(args.get(0) ?? Nd.wildcard)
    ownBoxed(env, a)
    if ownExprLinear(env, a) || ownPlaceLinear(env, a) {
        ownRejectMoveOut(env, a)
        ownConsumeBoxed(env, a)
    }
    ownKillAliasing(env, pl.key)
}

func ownIdentName(_ v: Vec[Nd]) using Alloc -> String {
    if let n = v.get(0) {
        return match n {
            case .ident(let x): own(x)
            case .paren(let x): ownIdentName(x)
            default: own("")
        }
    }
    return own("")
}

func ownArgValue(_ a: Nd) using Alloc -> Vec[Nd] {
    return match a {
        case .arg(let l, let io, let v): v
        default: Vec.new()
    }
}

func ownCallArg(_ env: inout OwnEnv, _ fname: String, _ isCtor: Bool, _ idx: Int, _ a: Nd) using Alloc {
    match a {
        case .arg(let label, let isInout, let val): ownArgAll(env, fname, isCtor, idx, isInout, val)
        default: noop()
    }
}

// A callee handed `&place` may fill or empty anything under it.
func ownArgAll(_ env: inout OwnEnv, _ fname: String, _ isCtor: Bool, _ idx: Int, _ isInout: Bool, _ val: Vec[Nd]) using Alloc {
    ownArgVal(env, fname, isCtor, idx, val)
    if !isCtor && (isInout || streq(ownModeOf(env, fname, idx), "inout ")) {
        let pl = ownPlace(env, val)
        if pl.ok { ownKillRooted(env, ownKeyRoot(pl.key)) }
        else {
            let n = ownIdentName(val)
            if !streq(n, "") { ownKillRooted(env, n) }
        }
    }
}

func ownArgVal(_ env: inout OwnEnv, _ fname: String, _ isCtor: Bool, _ idx: Int, _ val: Vec[Nd]) using Alloc {
    ownBoxed(env, val)
    var isSink: Bool = isCtor
    if !isSink && streq(ownModeOf(env, fname, idx), "sink ") { isSink = true }
    if isSink {
        ownRejectMoveOut(env, val)
        ownConsumeBoxed(env, val)
    }
}

func ownConsumeBoxed(_ env: inout OwnEnv, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { ownConsumeExpr(env, v.get(0) ?? Nd.wildcard) }
}

func ownConsumeExpr(_ env: inout OwnEnv, _ e: Nd) using Alloc {
    match e {
        case .ident(let n): ownConsume(env, n)
        case .paren(let inner): ownConsumeBoxed(env, inner)
        default: noop()
    }
}

func ownRegisterPat(_ env: inout OwnEnv, _ pat: Vec[Nd], _ ty: Vec[Nd]) using Alloc {
    if pat.len() > 0 { ownRegisterPatE(env, pat.get(0) ?? Nd.wildcard, ty) }
}

func ownRegisterPatE(_ env: inout OwnEnv, _ p: Nd, _ ty: Vec[Nd]) using Alloc {
    match p {
        case .identP(let n): ownRegister(env, n, ty)
        case .bindP(let n): ownRegister(env, n, ty)
        default: noop()
    }
}

// ===========================================================================
// Type checking (§17 et seq.), slice 1 — initializer / annotation mismatch.
// A binding or const with an explicit type whose initializer types as something
// not assignable to that type is `initializer of type <X> does not match
// annotation <Y>` (for `let`/`var`) or `const value of type <X> does not match
// annotation <Y>` (for `const`), matching `vestra check` (which type-checks
// inside name resolution, so type errors gate the flow passes just as undefined
// names do). vsema has no full inference engine yet; a type is modelled as its
// describe() SPELLING (a String), inference covers the foundational expressions
// — literals (int->Int, float->Float64, bool->Bool, char->Char, string->StrConst),
// identifiers (parameter / annotated-binding types), parenthesis, and direct
// calls (a function's declared return type, or a struct constructor's own type)
// — and `assignable` covers identity, the §17 Int/UInt natural-width rule, the §4
// string lattice (StrConst <= Str <= String), and T -> T? wrapping. An expression
// outside that subset, or a binding without an annotation, types as unknown and
// is not checked. (funcRet/structs are the global tables; symName/symType the
// per-function bindings.)
//
// Deliberately not yet modelled (later slices): call-argument and return-type
// checking, operator/condition typing, generics, and structural assignability
// beyond the lattices above. Curated tests stay inside the inferred subset.
// ===========================================================================
struct TyEnv {
    var funcName: Vec[String]   // global: function name ...
    var funcRet: Vec[String]    // ... -> return-type spelling ("Unit" if none) ...
    var funcArity: Vec[Int]     // ... -> declared parameter count
    var pFn: Vec[String]        // global: per-parameter rows — function name ...
    var pIdx: Vec[Int]          // ... parameter index ...
    var pType: Vec[String]      // ... -> parameter type spelling
    var structs: Vec[String]    // global: struct names (construction yields that type)
    var sFldStruct: Vec[String] // global: per-field rows — owning struct ...
    var sFldName: Vec[String]   // ... field name ...
    var sFldType: Vec[String]   // ... -> field type spelling (embeds excluded)
    var mStruct: Vec[String]    // global: per-method rows — owning struct/enum ...
    var mName: Vec[String]      // ... method name ...
    var mRet: Vec[String]       // ... -> result-type spelling ("Unit" if none, "Self"->owner)
    var eName: Vec[String]      // global: enum names (a bare `E.case` is a type ref)
    var ecEnum: Vec[String]     // global: per-case rows — owning enum ...
    var ecName: Vec[String]     // ... case name ...
    var ecArity: Vec[Int]       // ... -> payload field count
    var symName: Vec[String]    // per-function: binding name ...
    var symType: Vec[String]    // ... -> type spelling
    var curRet: String          // per-function: enclosing function's result spelling ("Unit" if none)
    var bad: Vec[String]
    var mInout: Vec[Bool]       // global: parallel to mStruct / mName — an `inout func`?
    var muName: Vec[String]     // per-function: §4 bindings in scope, innermost last ...
    var muFlag: Vec[Bool]       // ... may it be written? ...
    var muKind: Vec[Int]        // ... 0 local, 1 parameter
    var muMarks: Vec[Int]       // scope starts in muName
    var stName: Vec[String]     // global: statics ...
    var stAtomic: Vec[Bool]     // ... and whether each is an Atomic (the only writable kind)
}

func tyCheck(_ env: inout TyEnv, _ u: NUnit) using Alloc {
    var i: Int = 0
    while i < u.decls.len() {
        tyCollectDecl(env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    var j: Int = 0
    while j < u.decls.len() {
        tyCheckDecl(env, u.decls.get(j) ?? Nd.wildcard)
        j = j + 1
    }
}

// ----- pass 1: function return types and struct names -----------------------
func tyCollectDecl(_ env: inout TyEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b):
            tyRecordFunc(env, name, params, r)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): tyRecordStructDecl(env, name, fl, m)
        case .enumD(let vis, let name, let cs, let m, let generics): tyRecordEnumDecl(env, name, cs, m)
        case .staticD(let vis, let name, let ty, let v): tyRecordStatic(env, name, ty)
        default: noop()
    }
}

func tyRecordStatic(_ env: inout TyEnv, _ name: String, _ ty: Vec[Nd]) using Alloc {
    env.stName.push(own(name))
    let sp = tyAnnSpelling(ty)
    env.stAtomic.push(tyStartsWith(sp, "Atomic[") || tyStartsWith(sp, "AtomicTaggedPointer["))
}

func tyRecordEnumDecl(_ env: inout TyEnv, _ name: String, _ cases: Vec[Nd], _ methods: Vec[Nd]) using Alloc {
    env.eName.push(name)
    var i: Int = 0
    while i < cases.len() {
        tyRecordCase(env, name, cases.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyRecordMethods(env, name, methods)
}

func tyRecordCase(_ env: inout TyEnv, _ enumName: String, _ c: Nd) using Alloc {
    match c {
        case .enumCase(let cn, let pay): tyPushCase(env, enumName, cn, pay.len())
        default: noop()
    }
}

func tyPushCase(_ env: inout TyEnv, _ enumName: String, _ cn: String, _ arity: Int) using Alloc {
    env.ecEnum.push(enumName)
    env.ecName.push(cn)
    env.ecArity.push(arity)
}

func tyCaseArity(_ env: inout TyEnv, _ enumName: String, _ cn: String) -> Int {
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let e = env.ecEnum.get(i) {
            if streq(e, enumName) {
                if let c = env.ecName.get(i) {
                    if streq(c, cn) { return env.ecArity.get(i) ?? -1 }
                }
            }
        }
        i = i + 1
    }
    return -1
}

func tyIsEnum(_ env: inout TyEnv, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.eName.len() {
        if let n = env.eName.get(i) {
            if streq(n, name) { return true }
        }
        i = i + 1
    }
    return false
}

func tyEnumHasCase(_ env: inout TyEnv, _ enumName: String, _ caseName: String) -> Bool {
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let e = env.ecEnum.get(i) {
            if streq(e, enumName) {
                if let c = env.ecName.get(i) {
                    if streq(c, caseName) { return true }
                }
            }
        }
        i = i + 1
    }
    return false
}

func tyRecordStructDecl(_ env: inout TyEnv, _ name: String, _ fields: Vec[Nd], _ methods: Vec[Nd]) using Alloc {
    tyRecordStruct(env, name, fields)
    tyRecordMethods(env, name, methods)
}

// Record each user-declared method's result spelling under its owning type. A
// method with its OWN generic parameters is skipped (its result may name a type
// variable we can't resolve) so it stays unknown and tolerated, like a builtin.
func tyRecordMethods(_ env: inout TyEnv, _ owner: String, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        tyRecordMethod(env, owner, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRecordMethod(_ env: inout TyEnv, _ owner: String, _ m: Nd) using Alloc {
    match m {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b):
            tyPushMethodM(env, owner, name, g, r, containsSub(mods, "inout"))
        default: noop()
    }
}

func tyPushMethodM(_ env: inout TyEnv, _ owner: String, _ name: String, _ gens: Vec[Nd], _ result: Vec[Nd], _ isInout: Bool) using Alloc {
    if gens.len() > 0 { return }
    env.mInout.push(isInout)
    tyPushMethod(env, owner, name, gens, result)
}

func tyPushMethod(_ env: inout TyEnv, _ owner: String, _ name: String, _ gens: Vec[Nd], _ result: Vec[Nd]) using Alloc {
    if gens.len() > 0 { return }
    env.mStruct.push(owner)
    env.mName.push(name)
    env.mRet.push(tyRetSpelling(result))
}

func tyRecordStruct(_ env: inout TyEnv, _ name: String, _ fields: Vec[Nd]) using Alloc {
    env.structs.push(name)
    var i: Int = 0
    while i < fields.len() {
        tyRecordField(env, name, fields.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRecordField(_ env: inout TyEnv, _ structName: String, _ f: Nd) using Alloc {
    match f {
        case .field(let kind, let fname, let fty): tyPushField(env, structName, kind, fname, fty)
        default: noop()
    }
}

// Record a constructible field (`let`/`var`); embeds aren't set by label.
func tyPushField(_ env: inout TyEnv, _ structName: String, _ kind: String, _ fname: String, _ fty: Vec[Nd]) using Alloc {
    if containsSub(kind, "embed") { return }
    env.sFldStruct.push(structName)
    env.sFldName.push(fname)
    env.sFldType.push(tyAnnSpelling(fty))
}

func tyHasField(_ env: inout TyEnv, _ structName: String, _ label: String) -> Bool {
    var i: Int = 0
    while i < env.sFldStruct.len() {
        if let s = env.sFldStruct.get(i) {
            if streq(s, structName) {
                if let fn = env.sFldName.get(i) {
                    if streq(fn, label) { return true }
                }
            }
        }
        i = i + 1
    }
    return false
}

func tyFieldType(_ env: inout TyEnv, _ structName: String, _ label: String) using Alloc -> String {
    var i: Int = 0
    while i < env.sFldStruct.len() {
        if let s = env.sFldStruct.get(i) {
            if streq(s, structName) {
                if let fn = env.sFldName.get(i) {
                    if streq(fn, label) { return env.sFldType.get(i) ?? own("") }
                }
            }
        }
        i = i + 1
    }
    return own("")
}

func tyRecordFunc(_ env: inout TyEnv, _ name: String, _ params: Vec[Nd], _ result: Vec[Nd]) using Alloc {
    env.funcName.push(name)
    if result.len() == 0 { env.funcRet.push("Unit") }
    else { env.funcRet.push(typeSpelling(result.get(0) ?? Nd.wildcard)) }
    env.funcArity.push(params.len())
    var i: Int = 0
    while i < params.len() {
        tyRecordParam(env, name, i, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRecordParam(_ env: inout TyEnv, _ name: String, _ idx: Int, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): tyPushParam(env, name, idx, tyAnnSpelling(ty))
        default: noop()
    }
}

func tyPushParam(_ env: inout TyEnv, _ name: String, _ idx: Int, _ sp: String) using Alloc {
    env.pFn.push(name)
    env.pIdx.push(idx)
    env.pType.push(sp)
}

func tyArity(_ env: inout TyEnv, _ name: String) -> Int {
    var i: Int = 0
    while i < env.funcName.len() {
        if let n = env.funcName.get(i) {
            if streq(n, name) { return env.funcArity.get(i) ?? -1 }
        }
        i = i + 1
    }
    return -1
}

func tyParamType(_ env: inout TyEnv, _ name: String, _ idx: Int) using Alloc -> String {
    var i: Int = 0
    while i < env.pFn.len() {
        if let n = env.pFn.get(i) {
            if streq(n, name) && (env.pIdx.get(i) ?? -1) == idx { return env.pType.get(i) ?? own("") }
        }
        i = i + 1
    }
    return own("")
}

func tyFuncRet(_ env: inout TyEnv, _ name: String) using Alloc -> String {
    var i: Int = 0
    while i < env.funcName.len() {
        if let n = env.funcName.get(i) {
            if streq(n, name) { return env.funcRet.get(i) ?? own("") }
        }
        i = i + 1
    }
    return own("")
}

func tyIsStruct(_ env: inout TyEnv, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.structs.len() {
        if let s = env.structs.get(i) {
            if streq(s, name) { return true }
        }
        i = i + 1
    }
    return false
}

// ----- pass 2: per-function walk --------------------------------------------
func tyCheckDecl(_ env: inout TyEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b):
            tyCheckFuncAll(env, mods, name, params, r, b)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): tyCheckMethods(env, m)
        case .enumD(let vis, let name, let cs, let m, let generics): tyCheckMethods(env, m)
        case .constD(let vis, let name, let ty, let v): tyCheckConst(env, ty, v)
        default: noop()
    }
}

func tyCheckMethods(_ env: inout TyEnv, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        tyCheckDecl(env, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyCheckFunc(_ env: inout TyEnv, _ name: String, _ params: Vec[Nd], _ result: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    env.curRet = tyRetSpelling(result)
    tyResetSyms(env)
    tyRegisterParams(env, params)
    tyBoxed(env, body)
    tyCheckBodyProduces(env, name, body)
}

// §4 / §19 the bootstrap's two body-completion rules (F9, F22): a `-> Never`
// function can't complete normally, and a value-returning one can't fall off
// its end. A body-less declaration has nothing to check.
func tyCheckDivergence(_ env: inout TyEnv, _ name: String, _ body: Vec[Nd]) using Alloc {
    if body.len() == 0 || streq(env.curRet, "") || streq(env.curRet, "Unit") { return }
    if tyDiverges(env, body) { return }
    if streq(env.curRet, "Never") { env.bad.push(tyNeverMsg(name)); return }
    // An `if` with no `else` is Unit, whatever its branch yields.
    if !tyBodyEndsInElselessIf(body) {
        let bt = tyBodyType(env, body)
        if !streq(bt, "") && !streq(bt, "Unit") && tyAssignable(bt, env.curRet) { return }
        if streq(bt, "") && tyBodyEndsInExpr(body) { return }   // unknown value: don't pile on
    }
    env.bad.push(tyNoReturnMsg(name, env.curRet))
}

func tyBodyEndsInElselessIf(_ body: Vec[Nd]) -> Bool {
    if let b = body.get(0) {
        return match b {
            case .block(let stmts): tyLastIsElselessIf(stmts)
            default: false
        }
    }
    return false
}

func tyLastIsElselessIf(_ stmts: Vec[Nd]) -> Bool {
    if stmts.len() == 0 { return false }
    if let s = stmts.get(stmts.len() - 1) {
        return match s {
            case .exprS(let e): tyIsElselessIf(e)
            default: false
        }
    }
    return false
}

func tyIsElselessIf(_ e: Vec[Nd]) -> Bool {
    if let n = e.get(0) {
        return match n {
            case .ifE(let ln, let li, let c, let t, let el): el.len() == 0
            default: false
        }
    }
    return false
}

func tyBodyEndsInExpr(_ body: Vec[Nd]) -> Bool {
    if let b = body.get(0) {
        return match b {
            case .block(let stmts): tyLastIsExpr(stmts)
            default: false
        }
    }
    return false
}

func tyLastIsExpr(_ stmts: Vec[Nd]) -> Bool {
    if stmts.len() == 0 { return false }
    if let s = stmts.get(stmts.len() - 1) {
        return match s {
            case .exprS: true
            default: false
        }
    }
    return false
}

func tyNeverMsg(_ name: String) using Alloc -> String {
    var s: String = "function '"
    s.append(name)
    s.append("' returns Never but its body can complete normally; end it with a call to a Never function, `panic(...)`, or a loop that doesn't exit")
    return s
}

func tyNoReturnMsg(_ name: String, _ ret: String) using Alloc -> String {
    var s: String = "function '"
    s.append(name)
    s.append("' can reach the end of its body without returning its ")
    s.append(ret)
    s.append(" result; return on every path")
    return s
}

// Can `e` not complete normally? (The bootstrap's expr_diverges.)
func tyDiverges(_ env: inout TyEnv, _ e: Vec[Nd]) using Alloc -> Bool {
    if tyIsNeverCall(e) { return true }
    if streq(tyInferBoxed(env, e), "Never") { return true }
    if let n = e.get(0) {
        return match n {
            case .block(let stmts): tyStmtsDiverge(env, stmts)
            case .paren(let x): tyDiverges(env, x)
            case .ifE(let ln, let li, let c, let t, let el): el.len() > 0 && tyDiverges(env, t) && tyDiverges(env, el)
            case .matchE(let scr, let arms): tyArmsDiverge(env, arms)
            default: false
        }
    }
    return false
}

// `panic(...)` / `abort()` / `unreachable()`, the built-in Never functions.
func tyIsNeverCall(_ e: Vec[Nd]) -> Bool {
    if let n = e.get(0) {
        return match n {
            case .call(let callee, let args): tyIsNeverName(callee)
            default: false
        }
    }
    return false
}

func tyIsNeverName(_ callee: Vec[Nd]) -> Bool {
    if let n = callee.get(0) {
        return match n {
            case .ident(let nm): streq(nm, "panic") || streq(nm, "abort") || streq(nm, "unreachable")
            default: false
        }
    }
    return false
}

func tyStmtsDiverge(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc -> Bool {
    var i: Int = 0
    while i < stmts.len() {
        if tyStmtDiverges(env, stmts.get(i) ?? Nd.wildcard) { return true }
        i = i + 1
    }
    return false
}

func tyArmsDiverge(_ env: inout TyEnv, _ arms: Vec[Nd]) using Alloc -> Bool {
    if arms.len() == 0 { return false }
    var i: Int = 0
    while i < arms.len() {
        if !tyArmDiverges(env, arms.get(i) ?? Nd.wildcard) { return false }
        i = i + 1
    }
    return true
}

func tyArmDiverges(_ env: inout TyEnv, _ a: Nd) using Alloc -> Bool {
    return match a {
        case .matchArm(let d, let pat, let g, let body): body.len() > 0 && tyDiverges(env, body)
        default: false
    }
}

func tyStmtDiverges(_ env: inout TyEnv, _ s: Nd) using Alloc -> Bool {
    return match s {
        case .retS(let v): true
        case .exprS(let e): tyDiverges(env, e)
        case .letS(let p, let t, let v): v.len() > 0 && tyDiverges(env, v)
        case .varS(let p, let t, let v): v.len() > 0 && tyDiverges(env, v)
        case .whileS(let c, let b): tyIsTrueLit(c) && !tyBreaksOut(b, false)
        case .withS(let caps, let vals, let b): tyDiverges(env, b)
        default: false
    }
}

func tyIsTrueLit(_ c: Vec[Nd]) -> Bool {
    if let n = c.get(0) {
        return match n {
            case .boolLit(let v): v
            default: false
        }
    }
    return false
}

// Does a `break` in `body` leave the loop it belongs to? A labeled break
// leaves it too (it targets this loop or one outside it).
func tyBreaksOut(_ body: Vec[Nd], _ inLoop: Bool) -> Bool {
    var i: Int = 0
    while i < body.len() {
        if tyNodeBreaksOut(body.get(i) ?? Nd.wildcard, inLoop) { return true }
        i = i + 1
    }
    return false
}

func tyNodeBreaksOut(_ n: Nd, _ inLoop: Bool) -> Bool {
    return match n {
        case .breakS(let label): !inLoop || !streq(label, "")
        case .block(let stmts): tyBreaksOut(stmts, inLoop)
        case .exprS(let e): tyBreaksOut(e, inLoop)
        case .ifE(let ln, let li, let c, let t, let el): tyBreaksOut(t, inLoop) || tyBreaksOut(el, inLoop)
        case .matchE(let scr, let arms): tyBreaksOut(arms, inLoop)
        case .matchArm(let d, let pat, let g, let body): tyBreaksOut(body, inLoop)
        case .whileS(let c, let b): tyBreaksOut(b, true)
        case .forS(let p, let it, let b): tyBreaksOut(b, true)
        case .withS(let caps, let vals, let b): tyBreaksOut(b, inLoop)
        default: false
    }
}

func tyCheckFuncAll(_ env: inout TyEnv, _ mods: String, _ name: String, _ params: Vec[Nd], _ result: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    tyCheckFunc(env, name, params, result, body)
    if !containsSub(mods, nakedMark()) { tyCheckDivergence(env, name, body) }
}

func tyRetSpelling(_ result: Vec[Nd]) using Alloc -> String {
    if result.len() == 0 { return own("Unit") }
    return typeSpelling(result.get(0) ?? Nd.wildcard)
}

// §10/§17 — when the body's trailing expression is present and its type is not
// assignable to the declared (non-Unit) result, the implicit return is wrong.
// A body ending in a non-expression statement (let / return / ...) produces Unit
// and is tolerated (an explicit return we don't flow-check).
func tyCheckBodyProduces(_ env: inout TyEnv, _ name: String, _ body: Vec[Nd]) using Alloc {
    if streq(env.curRet, "") || streq(env.curRet, "Unit") { return }
    let bt = tyBodyType(env, body)
    if streq(bt, "") || streq(bt, "Unit") { return }
    if !tyAssignable(bt, env.curRet) { env.bad.push(tyBodyMsg(name, env.curRet, bt)) }
}

func tyBodyType(_ env: inout TyEnv, _ body: Vec[Nd]) using Alloc -> String {
    if body.len() == 0 { return own("Unit") }
    return tyBlockLastType(env, body.get(0) ?? Nd.wildcard)
}

func tyBlockLastType(_ env: inout TyEnv, _ blk: Nd) using Alloc -> String {
    return match blk {
        case .block(let stmts): tyLastStmtType(env, stmts)
        default: own("Unit")
    }
}

func tyLastStmtType(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc -> String {
    if stmts.len() == 0 { return own("Unit") }
    return tyStmtType(env, stmts.get(stmts.len() - 1) ?? Nd.wildcard)
}

func tyStmtType(_ env: inout TyEnv, _ s: Nd) using Alloc -> String {
    return match s {
        case .exprS(let e): tyInferBoxed(env, e)
        default: own("Unit")
    }
}

func tyResetSyms(_ env: inout TyEnv) using Alloc {
    while env.symName.len() > 0 { let _ = env.symName.pop() }
    while env.symType.len() > 0 { let _ = env.symType.pop() }
}

func tyRegisterParams(_ env: inout TyEnv, _ params: Vec[Nd]) using Alloc {
    while env.muName.len() > 0 { let _ = env.muName.pop() }
    while env.muFlag.len() > 0 { let _ = env.muFlag.pop() }
    while env.muKind.len() > 0 { let _ = env.muKind.pop() }
    while env.muMarks.len() > 0 { let _ = env.muMarks.pop() }
    var i: Int = 0
    while i < params.len() {
        tyRegisterParam(env, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRegisterParam(_ env: inout TyEnv, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): tyAddParamMu(env, nm, md, ty)
        default: noop()
    }
}

// §7 a `read` parameter is immutable; `inout` and `sink` may be written.
func tyAddParamMu(_ env: inout TyEnv, _ nm: String, _ md: String, _ ty: Vec[Nd]) using Alloc {
    muPush(env, nm, streq(md, "inout ") || streq(md, "sink "), 1)
    tyAddSym(env, nm, ty)
}

// ----- §4 mutability (the bootstrap's Symbol::is_mutable + check_mutable_place)
func muPush(_ env: inout TyEnv, _ n: String, _ isMut: Bool, _ kind: Int) using Alloc {
    env.muName.push(own(n))
    env.muFlag.push(isMut)
    env.muKind.push(kind)
}

func muEnter(_ env: inout TyEnv) using Alloc { env.muMarks.push(env.muName.len()) }

func muLeave(_ env: inout TyEnv) using Alloc {
    if env.muMarks.len() == 0 { return }
    let m = env.muMarks.pop() ?? 0
    while env.muName.len() > m { let _ = env.muName.pop() }
    while env.muFlag.len() > m { let _ = env.muFlag.pop() }
    while env.muKind.len() > m { let _ = env.muKind.pop() }
}

// Every name a pattern binds, as immutable locals.
func muPat(_ env: inout TyEnv, _ pat: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < pat.len() {
        match pat.get(i) ?? Nd.wildcard {
            case .identP(let n): muPush(env, n, false, 0)
            case .bindP(let n): muPush(env, n, false, 0)
            case .enumP(let c, let xs): muPat(env, xs)
            case .tupleP(let xs): muPat(env, xs)
            default: noop()
        }
        i = i + 1
    }
}

func muBind(_ env: inout TyEnv, _ pat: Vec[Nd], _ isMut: Bool) using Alloc {
    if let p = pat.get(0) {
        match p {
            case .identP(let n): muPush(env, n, isMut, 0)
            case .bindP(let n): muPush(env, n, isMut, 0)
            case .tupleP(let xs): muBindAll(env, xs, isMut)
            default: noop()
        }
    }
}

func muBindAll(_ env: inout TyEnv, _ xs: Vec[Nd], _ isMut: Bool) using Alloc {
    var i: Int = 0
    while i < xs.len() {
        var one: Vec[Nd] = Vec.new()
        one.push(xs.get(i) ?? Nd.wildcard)
        muBind(env, one, isMut)
        i = i + 1
    }
}

// A write to `t` needs a isMut root; a write through a view (an element of a
// Span / MutSpan, a pointer's `.value`) changes the viewed memory instead.
func muCheck(_ env: inout TyEnv, _ t: Vec[Nd]) using Alloc {
    if let n = t.get(0) {
        match n {
            case .paren(let x): muCheck(env, x)
            case .member(let base, let m, let ch): muCheckMember(env, base, m)
            case .index(let base, let idxs): muCheckIndex(env, base)
            case .ident(let x): muCheckRoot(env, x)
            default: noop()
        }
    }
}

func muCheckMember(_ env: inout TyEnv, _ base: Vec[Nd], _ m: String) using Alloc {
    let bt = tyInferBoxed(env, base)
    if streq(m, "value") && (tyStartsWith(bt, "MutPtr[") || tyStartsWith(bt, "Ptr[")) { return }
    muCheck(env, base)
}

func muCheckIndex(_ env: inout TyEnv, _ base: Vec[Nd]) using Alloc {
    let bt = tyInferBoxed(env, base)
    // An unknown base (a span from chunks / split, say) may be a view: don't pile
    // on. A static is never a view, typed or not.
    if streq(bt, "") && !muIsStatic(env, base) { return }
    if tyStartsWith(bt, "MutSpan[") || tyStartsWith(bt, "Span[") { return }
    muCheck(env, base)
}

func muIsStatic(_ env: inout TyEnv, _ base: Vec[Nd]) using Alloc -> Bool {
    if let n = base.get(0) {
        return match n {
            case .ident(let x): muStaticIdx(env, x) >= 0
            default: false
        }
    }
    return false
}

func muStaticIdx(_ env: inout TyEnv, _ x: String) using Alloc -> Int {
    if muLocalIdx(env, x) >= 0 { return -1 }   // a local of the same name shadows it
    var k: Int = 0
    while k < env.stName.len() {
        if streq(env.stName.get(k) ?? own(""), x) { return k }
        k = k + 1
    }
    return -1
}

func muLocalIdx(_ env: inout TyEnv, _ x: String) using Alloc -> Int {
    var i: Int = env.muName.len() - 1
    while i >= 0 {
        if streq(env.muName.get(i) ?? own(""), x) { return i }
        i = i - 1
    }
    return -1
}

func muCheckRoot(_ env: inout TyEnv, _ x: String) using Alloc {
    var i: Int = env.muName.len() - 1
    while i >= 0 {
        if let n = env.muName.get(i) {
            if streq(n, x) {
                if env.muFlag.get(i) ?? true { return }
                if (env.muKind.get(i) ?? 0) == 1 { env.bad.push(muParamMsg(x)) } else { env.bad.push(muLetMsg(x)) }
                return
            }
        }
        i = i - 1
    }
    // §1 / §4 a static holds an immutable value or an Atomic.
    var k: Int = 0
    while k < env.stName.len() {
        if streq(env.stName.get(k) ?? own(""), x) {
            if !(env.stAtomic.get(k) ?? false) { env.bad.push(muStaticMsg(x)) }
            return
        }
        k = k + 1
    }
}

func muStaticMsg(_ x: String) using Alloc -> String {
    var s: String = "'"
    s.append(x)
    s.append("' is a static, which holds an immutable value; keep shared mutable state in an `Atomic`, or in `@noinit` storage reached through `&")
    s.append(x)
    s.append("` under `RawMemory`")
    return s
}

func muLetMsg(_ x: String) using Alloc -> String {
    var s: String = "'"
    s.append(x)
    s.append("' is bound with `let`, so it can't be changed; declare it `var` to change it")
    return s
}

func muParamMsg(_ x: String) using Alloc -> String {
    var s: String = "'"
    s.append(x)
    s.append("' is a `read` parameter, so it can't be changed here; take it `inout` to change the caller's value")
    return s
}

// A call's writes: `&` arguments, and a mutating method's receiver.
func muCall(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < args.len() {
        match args.get(i) ?? Nd.wildcard {
            case .arg(let l, let io, let v): muArg(env, io, v)
            default: noop()
        }
        i = i + 1
    }
    if let c = callee.get(0) {
        match c {
            case .member(let base, let m, let ch): muRecv(env, base, m)
            default: noop()
        }
    }
}

func muArg(_ env: inout TyEnv, _ io: Bool, _ v: Vec[Nd]) using Alloc {
    if io { muCheck(env, v) }
}

func muRecv(_ env: inout TyEnv, _ base: Vec[Nd], _ m: String) using Alloc {
    let bt = tyInferBoxed(env, base)
    if streq(bt, "") { return }
    var mut: Bool = false
    if tyStartsWith(bt, "Vec[") {
        mut = streq(m, "push") || streq(m, "pop") || streq(m, "set") || streq(m, "clear") || streq(m, "insert") || streq(m, "remove")
    } else if streq(bt, "String") {
        mut = streq(m, "append") || streq(m, "push")
    } else if tyStartsWith(bt, "HashMap[") {
        mut = streq(m, "set") || streq(m, "remove")
    } else if (bt.byteAt(bt.len() - 1) ?? 0) == 63 {
        mut = streq(m, "take") || streq(m, "put")
    } else {
        mut = muMethodInout(env, bt, m)
    }
    if mut { muCheck(env, base) }
}

func muMethodInout(_ env: inout TyEnv, _ owner: String, _ m: String) using Alloc -> Bool {
    var out: Bool = false
    var i: Int = 0
    while i < env.mStruct.len() {
        if streq(env.mStruct.get(i) ?? own(""), owner) && streq(env.mName.get(i) ?? own(""), m) { out = env.mInout.get(i) ?? false }
        i = i + 1
    }
    return out
}

// Register a binding's type from its annotation (empty annotation => untracked).
func tyAddSym(_ env: inout TyEnv, _ name: String, _ ty: Vec[Nd]) using Alloc {
    let sp = tyAnnSpelling(ty)
    if !streq(sp, "") {
        env.symName.push(name)
        env.symType.push(sp)
    }
}

func tySymType(_ env: inout TyEnv, _ name: String) using Alloc -> String {
    var i: Int = 0
    while i < env.symName.len() {
        if let n = env.symName.get(i) {
            if streq(n, name) { return env.symType.get(i) ?? own("") }
        }
        i = i + 1
    }
    return own("")
}

func tyCheckConst(_ env: inout TyEnv, _ ty: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    let ann = tyAnnSpelling(ty)
    if streq(ann, "") { return }
    let vt = tyInferBoxed(env, v)
    if !tyFits(vt, v, ann) { env.bad.push(tyConstMsg(vt, ann)) }
}

// ----- statement / expression walk (find every let/var, check initializers) -
func tyBoxed(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { tyExpr(env, v.get(0) ?? Nd.wildcard) }
}

func tyPair(_ env: inout TyEnv, _ a: Vec[Nd], _ b: Vec[Nd]) using Alloc {
    tyBoxed(env, a)
    tyBoxed(env, b)
}

func tyExpr(_ env: inout TyEnv, _ e: Nd) using Alloc {
    match e {
        case .call(let callee, let args): tyExprCall(env, callee, args)
        case .prefixE(let kw, let inner): tyBoxed(env, inner)
        case .paren(let x): tyBoxed(env, x)
        case .unary(let op, let x): tyUnary(env, op, x)
        case .binary(let op, let l, let r): tyBinary(env, op, l, r)
        case .member(let base, let n, let c): tyMember(env, base, n, c)
        case .index(let base, let idxs): tyIndex(env, base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): tyIfMu(env, ln, li, cond, thenB, els)
        case .block(let stmts): tyBlock(env, stmts)
        case .asE(let v, let t, let o): tyBoxed(env, v)
        case .addrOf(let x): tyBoxed(env, x)
        case .arg(let l, let io, let v): tyBoxed(env, v)
        case .throwE(let inner): tyBoxed(env, inner)
        case .matchE(let scrut, let arms): tyMatch(env, scrut, arms)
        case .doCatchE(let db, let en, let et, let cb): tyPair(env, db, cb)
        default: noop()
    }
}

// Walk a match: descend the scrutinee and every arm body, and require each arm's
// `where` guard to be Bool. (Pattern-bound variables type as unknown here and are
// tolerated; arm-result-type unification is a later slice.)
func tyMatch(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    tyBoxed(env, scrut)
    var i: Int = 0
    while i < arms.len() {
        tyArm(env, arms.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyCheckArmPatterns(env, scrut, arms)
    tyCheckExhaustive(env, scrut, arms)
    tyCheckArmTypes(env, arms)
}

// Validate each arm pattern against the scrutinee type: an enum-case pattern on a
// non-enum scrutinee; a payload-binding count that disagrees with the case; and a
// literal pattern whose type does not match the scrutinee. (An unknown scrutinee
// type is tolerated; default / catch-all arms carry no pattern.)
func tyCheckArmPatterns(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    let st = tyInferBoxed(env, scrut)
    if streq(st, "") { return }
    var i: Int = 0
    while i < arms.len() {
        tyCheckArmPattern(env, st, arms.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyCheckArmPattern(_ env: inout TyEnv, _ st: String, _ a: Nd) using Alloc {
    match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyCheckPatBoxed(env, st, pat)
        default: noop()
    }
}

func tyCheckPatBoxed(_ env: inout TyEnv, _ st: String, _ pat: Vec[Nd]) using Alloc {
    if pat.len() > 0 { tyCheckPatNode(env, st, pat.get(0) ?? Nd.wildcard) }
}

func tyCheckPatNode(_ env: inout TyEnv, _ st: String, _ p: Nd) using Alloc {
    match p {
        case .enumP(let cn, let children): tyCheckEnumPat(env, st, cn, children)
        case .litP(let inner): tyCheckLitPat(env, st, inner)
        case .orP(let alts): tyCheckAltPats(env, st, alts)
        default: noop()
    }
}

func tyCheckAltPats(_ env: inout TyEnv, _ st: String, _ alts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < alts.len() {
        tyCheckPatNode(env, st, alts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyCheckEnumPat(_ env: inout TyEnv, _ st: String, _ cn: String, _ children: Vec[Nd]) using Alloc {
    if !tyIsEnum(env, st) { env.bad.push(tyEnumPatNonEnumMsg(cn, st)); return }
    let arity = tyCaseArity(env, st, cn)
    // `case .x:` with no bindings ignores the payload (the bootstrap's rule).
    if arity >= 0 && children.len() > 0 && children.len() != arity { env.bad.push(tyPayloadArityMsg(cn, arity, children.len())) }
}

func tyCheckLitPat(_ env: inout TyEnv, _ st: String, _ inner: Vec[Nd]) using Alloc {
    let lt = tyInferBoxed(env, inner)
    if streq(lt, "") { return }
    if !tyAssignable(lt, st) && !tyAssignable(st, lt) && !tyLitFits(inner, st) { env.bad.push(tyLitScrutMsg(lt, st)) }
}

func tyEnumPatNonEnumMsg(_ cn: String, _ st: String) using Alloc -> String {
    var s: String = "enum pattern '."
    s.append(cn)
    s.append("' used against non-enum type ")
    s.append(st)
    return s
}

func tyPayloadArityMsg(_ cn: String, _ arity: Int, _ binds: Int) using Alloc -> String {
    var s: String = "case '"
    s.append(cn)
    s.append("' has ")
    s.append(intToStr(arity))
    s.append(" payload field(s), pattern binds ")
    s.append(intToStr(binds))
    return s
}

func tyLitScrutMsg(_ lt: String, _ st: String) using Alloc -> String {
    var s: String = "literal of type "
    s.append(lt)
    s.append(" does not match scrutinee of type ")
    s.append(st)
    return s
}

// The arm bodies must share one type. The first arm with a known type sets the
// baseline; a later arm whose known type is incompatible reports
// "match arms have different types: <baseline> vs <arm>", after which the
// baseline becomes the error type so every following known arm reports
// "<error> vs <arm>" (mirroring the resolver's cascade). Arms whose body type is
// unknown are skipped. NB this unifies the arms among themselves (no expected
// type is threaded in), so it matches the resolver only where the match has no
// expected type, e.g. an unannotated `let x = match …`.
func tyCheckArmTypes(_ env: inout TyEnv, _ arms: Vec[Nd]) using Alloc {
    var unified: String = ""
    var errored: Bool = false
    var i: Int = 0
    while i < arms.len() {
        let t = tyArmBodyType(env, arms.get(i) ?? Nd.wildcard)
        if !streq(t, "") {
            if errored {
                env.bad.push(tyArmDiffMsg("<error>", t))
            } else if streq(unified, "") {
                unified = own(t)
            } else if !tyArmCompatible(unified, t) {
                env.bad.push(tyArmDiffMsg(unified, t))
                errored = true
            }
        }
        i = i + 1
    }
}

func tyArmBodyType(_ env: inout TyEnv, _ a: Nd) using Alloc -> String {
    return match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyInferBoxed(env, body)
        default: own("")
    }
}

func tyArmCompatible(_ a: String, _ b: String) using Alloc -> Bool {
    return tyAssignable(a, b) || tyAssignable(b, a)
}

func tyArmDiffMsg(_ x: Str, _ y: Str) using Alloc -> String {
    var s: String = "match arms have different types: "
    s.append(x)
    s.append(" vs ")
    s.append(y)
    return s
}

// When the scrutinee is a known enum and no arm is a catch-all (a `default` or a
// `_` wildcard), every case must be covered by some arm's pattern, else
// "match is not exhaustive: case '<c>' is not covered" — one per uncovered case,
// in declaration order. Guards do not affect coverage (matching the resolver).
func tyCheckExhaustive(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    let st = tyInferBoxed(env, scrut)
    if !tyIsEnum(env, st) { return }
    if tyHasCatchAll(arms) { return }
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let e = env.ecEnum.get(i) {
            if streq(e, st) {
                if let cn = env.ecName.get(i) {
                    if !tyArmsCover(arms, cn) { env.bad.push(notExhaustiveMsg(cn)) }
                }
            }
        }
        i = i + 1
    }
}

func tyHasCatchAll(_ arms: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < arms.len() {
        if tyArmIsCatchAll(arms.get(i) ?? Nd.wildcard) { return true }
        i = i + 1
    }
    return false
}

func tyArmIsCatchAll(_ a: Nd) -> Bool {
    return match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyDefaultOrWild(isDef, pat)
        default: false
    }
}

func tyDefaultOrWild(_ isDef: Bool, _ pat: Vec[Nd]) -> Bool {
    if isDef { return true }
    if pat.len() == 0 { return false }
    return tyPatIsWild(pat.get(0) ?? Nd.wildcard)
}

func tyPatIsWild(_ p: Nd) -> Bool {
    return match p {
        case .wildcard: true
        default: false
    }
}

func tyArmsCover(_ arms: Vec[Nd], _ caseName: String) -> Bool {
    var i: Int = 0
    while i < arms.len() {
        if tyArmCovers(arms.get(i) ?? Nd.wildcard, caseName) { return true }
        i = i + 1
    }
    return false
}

func tyArmCovers(_ a: Nd, _ caseName: String) -> Bool {
    return match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyPatBoxedCovers(pat, caseName)
        default: false
    }
}

func tyPatBoxedCovers(_ pat: Vec[Nd], _ caseName: String) -> Bool {
    if pat.len() == 0 { return false }
    return tyPatCoversCase(pat.get(0) ?? Nd.wildcard, caseName)
}

func tyPatCoversCase(_ p: Nd, _ caseName: String) -> Bool {
    return match p {
        case .enumP(let cn, let ch): streq(cn, caseName)
        case .orP(let alts): tyAltsCover(alts, caseName)
        default: false
    }
}

func tyAltsCover(_ alts: Vec[Nd], _ caseName: String) -> Bool {
    var i: Int = 0
    while i < alts.len() {
        if tyPatCoversCase(alts.get(i) ?? Nd.wildcard, caseName) { return true }
        i = i + 1
    }
    return false
}

func notExhaustiveMsg(_ caseName: String) using Alloc -> String {
    var s: String = "match is not exhaustive: case '"
    s.append(caseName)
    s.append("' is not covered")
    return s
}

func tyArm(_ env: inout TyEnv, _ a: Nd) using Alloc {
    match a {
        case .matchArm(let isDefault, let pat, let guard, let body): tyArmMu(env, pat, guard, body)
        default: noop()
    }
}

// A match arm's pattern bindings are `let`s, scoped to the arm.
func tyArmMu(_ env: inout TyEnv, _ pat: Vec[Nd], _ guard: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    muEnter(env)
    muPat(env, pat)
    tyArmParts(env, guard, body)
    muLeave(env)
}

func tyArmParts(_ env: inout TyEnv, _ guard: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    tyBoxed(env, body)
    if guard.len() > 0 {
        let gt = tyInferBoxed(env, guard)
        if !streq(gt, "") && !streq(gt, "Bool") { env.bad.push(tyGuardMsg(gt)) }
    }
}

func tyGuardMsg(_ got: String) using Alloc -> String {
    var s: String = "match guard must be Bool, got "
    s.append(got)
    return s
}

func tyExprCall(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    tyBoxed(env, callee)
    var i: Int = 0
    while i < args.len() {
        tyExpr(env, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyCheckCallArgs(env, callee, args)
    muCall(env, callee, args)
}

// A call to a known user function must supply the right arity, and each argument
// must be assignable to its parameter. Calls to builtins / methods / struct
// constructors (no entry in funcName) are left to later slices.
func tyCheckCallArgs(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    let fname = exCalleeNameBoxed(callee)
    let arity = tyArity(env, fname)
    if arity >= 0 {
        if arity != args.len() {
            env.bad.push(tyArityMsg(arity, args.len()))
            return
        }
        var i: Int = 0
        while i < args.len() {
            tyCheckArg(env, fname, i, args.get(i) ?? Nd.wildcard)
            i = i + 1
        }
        return
    }
    if tyIsStruct(env, fname) { tyCheckCtor(env, fname, args) }
}

// §6 struct construction: each labeled argument must name a field whose type
// accepts the value, and every (non-embed) field must be supplied. (Non-generic,
// non-union structs only; generics are dropped from the AST and unions are rare.)
func tyCheckCtor(_ env: inout TyEnv, _ structName: String, _ args: Vec[Nd]) using Alloc {
    var seen: Vec[String] = Vec.new()
    var i: Int = 0
    while i < args.len() {
        tyCtorArg(env, structName, i, args.get(i) ?? Nd.wildcard, seen)
        i = i + 1
    }
    tyCtorMissing(env, structName, seen)
}

func tyCtorArg(_ env: inout TyEnv, _ structName: String, _ idx: Int, _ a: Nd, _ seen: inout Vec[String]) using Alloc {
    match a {
        case .arg(let label, let isInout, let val): tyCtorArgLabeled(env, structName, idx, label, val, seen)
        default: noop()
    }
}

func tyCtorArgLabeled(_ env: inout TyEnv, _ structName: String, _ idx: Int, _ label: String, _ val: Vec[Nd], _ seen: inout Vec[String]) using Alloc {
    if streq(label, "") { env.bad.push(tyCtorLabelMsg(idx + 1)); return }
    if !tyHasField(env, structName, label) { env.bad.push(tyNoFieldMsg(structName, label)); return }
    let ft = tyFieldType(env, structName, label)
    let at = tyInferBoxed(env, val)
    if !tyFits(at, val, ft) { env.bad.push(tyFieldMsg(label, ft, at)) }
    seen.push(label)
}

func tyCtorMissing(_ env: inout TyEnv, _ structName: String, _ seen: inout Vec[String]) using Alloc {
    var i: Int = 0
    while i < env.sFldStruct.len() {
        tyCtorMissingField(env, structName, i, seen)
        i = i + 1
    }
}

func tyCtorMissingField(_ env: inout TyEnv, _ structName: String, _ i: Int, _ seen: inout Vec[String]) using Alloc {
    if let s = env.sFldStruct.get(i) {
        if streq(s, structName) {
            if let fn = env.sFldName.get(i) {
                if !tyContains(seen, fn) { env.bad.push(tyMissingMsg(structName, fn)) }
            }
        }
    }
}

func tyContains(_ v: inout Vec[String], _ s: String) -> Bool {
    var i: Int = 0
    while i < v.len() {
        if let e = v.get(i) {
            if streq(e, s) { return true }
        }
        i = i + 1
    }
    return false
}

func tyCheckArg(_ env: inout TyEnv, _ fname: String, _ idx: Int, _ a: Nd) using Alloc {
    match a {
        case .arg(let label, let isInout, let val): tyCheckArgVal(env, fname, idx, val)
        default: noop()
    }
}

func tyCheckArgVal(_ env: inout TyEnv, _ fname: String, _ idx: Int, _ val: Vec[Nd]) using Alloc {
    let at = tyInferBoxed(env, val)
    let pt = tyParamType(env, fname, idx)
    if !tyFits(at, val, pt) { env.bad.push(tyArgMsg(idx + 1, at, pt)) }
}

func tyIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    tyBoxed(env, base)
    var i: Int = 0
    while i < idxs.len() {
        tyExpr(env, idxs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyCheckIndex(env, base, idxs)
}

// §18.5 — every index must be integer-typed, then a known base that is not a
// Vec/Span/MutSpan is not indexable. (Mirrors the resolver: indices first, then
// the base shape; an unknown base is tolerated.)
func tyCheckIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < idxs.len() {
        tyCheckIndexExpr(env, idxs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    let bt = tyInferBoxed(env, base)
    if !streq(bt, "") && !tyIsIndexable(bt) { env.bad.push(tyNotIndexableMsg(bt)) }
}

func tyCheckIndexExpr(_ env: inout TyEnv, _ idx: Nd) using Alloc {
    let it = tyInfer(env, idx)
    if !streq(it, "") && !tyIsInt(it) { env.bad.push(tyIndexIntMsg(it)) }
}

func tyIndexIntMsg(_ got: String) using Alloc -> String {
    var s: String = "index must be integer-typed, got "
    s.append(got)
    return s
}

func tyNotIndexableMsg(_ bt: String) using Alloc -> String {
    var s: String = "type "
    s.append(bt)
    s.append(" is not indexable")
    return s
}

// Member access: descend into the base, then check enum-case access. `E.case`
// where `E` names an enum (and is a type ref, not a value binding) must name a
// real case of `E`. Value member access (`x.field` / `x.method()`) is handled by
// inference; a `?.` chain is tolerated.
func tyMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String, _ chain: Bool) using Alloc {
    tyBoxed(env, base)
    if chain { return }
    tyCheckEnumCase(env, base, name)
}

func tyCheckEnumCase(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String) using Alloc {
    let bn = exCalleeNameBoxed(base)               // base ident name, or "" if not a bare ident
    if streq(bn, "") { return }
    if !streq(tySymType(env, bn), "") { return }   // a value binding shadows: not a type ref
    if !tyIsEnum(env, bn) { return }
    if !tyEnumHasCase(env, bn, name) { env.bad.push(tyNoCaseMsg(bn, name)) }
}

func tyNoCaseMsg(_ enumName: String, _ caseName: String) using Alloc -> String {
    var s: String = "enum '"
    s.append(enumName)
    s.append("' has no case '")
    s.append(caseName)
    s.append("'")
    return s
}

// An `if let` binding is a `let`, scoped to the then-branch.
func tyIfMu(_ env: inout TyEnv, _ ln: String, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc {
    if streq(ln, "") { tyIf(env, li, cond, thenB, els); return }
    tyCheckCond(env, cond, "if")
    tyBoxed(env, cond)
    tyBoxed(env, li)
    muEnter(env)
    muPush(env, ln, false, 0)
    tyBoxed(env, thenB)
    muLeave(env)
    tyBoxed(env, els)
}

func tyIf(_ env: inout TyEnv, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc {
    tyCheckCond(env, cond, "if")
    tyBoxed(env, cond)
    tyBoxed(env, li)
    tyBoxed(env, thenB)
    tyBoxed(env, els)
}

// §10 — an `if`/`while` condition must be Bool. (An `if let` has no `cond`, so
// the empty-condition case is skipped; an unknown-typed condition is tolerated.)
func tyCheckCond(_ env: inout TyEnv, _ cond: Vec[Nd], _ kind: Str) using Alloc {
    if cond.len() == 0 { return }
    let ct = tyInferBoxed(env, cond)
    if !streq(ct, "") && !streq(ct, "Bool") { env.bad.push(tyCondMsg(kind, ct)) }
}

func tyCondMsg(_ kind: Str, _ got: String) using Alloc -> String {
    var s: String = own(kind)
    s.append(" condition must be Bool, got ")
    s.append(got)
    return s
}

func tyWhile(_ env: inout TyEnv, _ cond: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    tyCheckCond(env, cond, "while")
    tyBoxed(env, cond)
    tyBoxed(env, body)
}

func tyBlock(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc {
    muEnter(env)
    var i: Int = 0
    while i < stmts.len() {
        tyStmt(env, stmts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    muLeave(env)
}

func tyStmt(_ env: inout TyEnv, _ s: Nd) using Alloc {
    match s {
        case .letS(let p, let ty, let v): tyLetMu(env, p, ty, v, false)
        case .varS(let p, let ty, let v): tyLetMu(env, p, ty, v, true)
        case .exprS(let e): tyBoxed(env, e)
        case .retS(let v): tyRet(env, v)
        case .assignS(let op, let t, let v): tyAssign(env, t, v)
        case .whileS(let c, let b): tyWhile(env, c, b)
        case .forS(let pp, let it, let b): tyForMu(env, pp, it, b)
        case .withS(let caps, let vals, let body): tyWith(env, vals, body)
        default: noop()
    }
}

func tyLetMu(_ env: inout TyEnv, _ p: Vec[Nd], _ ty: Vec[Nd], _ v: Vec[Nd], _ isVar: Bool) using Alloc {
    tyLet(env, p, ty, v)
    muBind(env, p, isVar)
}

// A `for` element is a `let`, scoped to the body.
func tyForMu(_ env: inout TyEnv, _ pp: Vec[Nd], _ it: Vec[Nd], _ b: Vec[Nd]) using Alloc {
    tyBoxed(env, it)
    muEnter(env)
    muBind(env, pp, false)
    tyBoxed(env, b)
    muLeave(env)
}

// `let`/`var`: if annotated, the initializer must be assignable to it; then walk
// the value for any nested bindings, and register this one for later idents.
func tyLet(_ env: inout TyEnv, _ pat: Vec[Nd], _ ty: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    let ann = tyAnnSpelling(ty)
    if !streq(ann, "") {
        let vt = tyInferBoxed(env, v)
        if !tyFits(vt, v, ann) { env.bad.push(tyInitMsg(vt, ann)) }
    }
    tyBoxed(env, v)
    if ty.len() > 0 { tyRegisterPat(env, pat, ty) } else { tyRegisterInferred(env, pat, tyInferBoxed(env, v)) }
}

// An unannotated binding types as its initializer, when that is known.
// Numbers stay untracked: a literal types as `Int` here, which would mistype
// the binding (sema types it against its later uses).
func tyRegisterInferred(_ env: inout TyEnv, _ pat: Vec[Nd], _ sp: String) using Alloc {
    if streq(sp, "") || tyIsNumeric(sp) { return }
    if let p = pat.get(0) {
        match p {
            case .identP(let n): tyAddSymSp(env, n, sp)
            case .bindP(let n): tyAddSymSp(env, n, sp)
            default: noop()
        }
    }
}

func tyAddSymSp(_ env: inout TyEnv, _ n: String, _ sp: String) using Alloc {
    env.symName.push(own(n))
    env.symType.push(own(sp))
}

// Assignment (incl. compound ops, which the resolver checks identically): the
// value must be assignable to the target. Only ident targets type to a known
// slot here; member/index targets are unknown and tolerated.
func tyAssign(_ env: inout TyEnv, _ t: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    tyBoxed(env, t)
    muCheck(env, t)
    tyBoxed(env, v)
    let lt = tyInferBoxed(env, t)
    let rt = tyInferBoxed(env, v)
    if streq(lt, "") || streq(rt, "") { return }
    if !tyFits(rt, v, lt) { env.bad.push(tyAssignMsg(rt, lt)) }
}

func tyAssignMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "cannot assign value of type "
    s.append(from)
    s.append(" to target of type ")
    s.append(to)
    return s
}

// `return EXPR`: walk the value (nested checks), then its type must be assignable
// to the enclosing function's declared result. A bare `return` produces Unit.
func tyRet(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc {
    tyBoxed(env, v)
    if streq(env.curRet, "") { return }
    var rt: String = own("Unit")
    if v.len() > 0 { rt = tyInferBoxed(env, v) }
    if !tyFits(rt, v, env.curRet) { env.bad.push(tyReturnMsg(rt, env.curRet)) }
}

func tyWith(_ env: inout TyEnv, _ vals: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < vals.len() {
        tyExpr(env, vals.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyBoxed(env, body)
}

func tyRegisterPat(_ env: inout TyEnv, _ pat: Vec[Nd], _ ty: Vec[Nd]) using Alloc {
    if pat.len() > 0 { tyRegisterPatE(env, pat.get(0) ?? Nd.wildcard, ty) }
}

func tyRegisterPatE(_ env: inout TyEnv, _ p: Nd, _ ty: Vec[Nd]) using Alloc {
    match p {
        case .identP(let n): tyAddSym(env, n, ty)
        case .bindP(let n): tyAddSym(env, n, ty)
        default: noop()
    }
}

// ----- inference ------------------------------------------------------------
func tyInferBoxed(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc -> String {
    if v.len() > 0 { return tyInfer(env, v.get(0) ?? Nd.wildcard) }
    return own("")
}

func tyInfer(_ env: inout TyEnv, _ e: Nd) using Alloc -> String {
    return match e {
        case .intLit(let s): own("Int")
        case .floatLit(let s): own("Float64")
        case .boolLit(let b): own("Bool")
        case .charLit(let s): own("Char")
        case .strLit(let s): own("StrConst")
        case .ident(let n): tySymType(env, n)
        case .paren(let inner): tyInferBoxed(env, inner)
        case .call(let callee, let args): tyInferCall(env, callee)
        case .binary(let op, let l, let r): tyInferBinary(env, op, l, r)
        case .unary(let op, let x): tyInferUnary(env, op, x)
        case .member(let base, let name, let chain): tyInferMember(env, base, name, chain)
        case .index(let base, let idxs): tyInferIndex(env, base, idxs)
        case .vecLit(let elems): tyInferVecLit(env, elems)
        default: own("")
    }
}

// An array literal `[e1, ...]` types as `[N]T`, where N is the element count and
// T is the FIRST element's type (vestra does not unify the rest); the spelling
// nests, so `[[1,2],[3,4]]` -> `[2][2]Int`. An empty literal or an unknown first
// element stays unknown so the value is tolerated rather than mis-flagged.
func tyInferVecLit(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc -> String {
    if elems.len() == 0 { return own("") }
    let et = tyInfer(env, elems.get(0) ?? Nd.wildcard)
    if streq(et, "") { return own("") }
    var s: String = "["
    s.append(intToStr(elems.len()))
    s.append("]")
    s.append(et)
    return s
}

// Indexing a Vec[T] / Span[T] / MutSpan[T] yields its element T; other bases stay
// unknown (arrays spell empty here, and non-indexables type as unknown anyway).
func tyInferIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc -> String {
    let bt = tyInferBoxed(env, base)
    if tyStartsWith(bt, "[") { return tyArrayElem(bt) }
    if tyIsIndexable(bt) { return tyBracketInner(bt) }
    return own("")
}

// A fixed array `[N]T` is indexable too (the bootstrap's resolver).
func tyIsIndexable(_ s: String) -> Bool {
    return tyStartsWith(s, "Vec[") || tyStartsWith(s, "Span[") || tyStartsWith(s, "MutSpan[")
        || tyStartsWith(s, "[")
}

func tyStartsWith(_ s: String, _ prefix: Str) -> Bool {
    let pn = prefix.len()
    if pn > s.len() { return false }
    var i: Int = 0
    while i < pn {
        if (s.byteAt(i) ?? 0) != (prefix.byteAt(i) ?? 1) { return false }
        i = i + 1
    }
    return true
}

// "Vec[Int32]" -> "Int32" (the text between the first '[' and the trailing ']',
// so a nested element like "HashMap[Int32, Str]" comes back whole).
func tyBracketInner(_ s: String) using Alloc -> String {
    let n = s.len()
    if n < 2 || (s.byteAt(n - 1) ?? 0) != 93 { return own("") }   // ']' == 93
    var open: Int = -1
    var i: Int = 0
    while i < n {
        if (s.byteAt(i) ?? 0) == 91 { open = i; i = n }           // first '[' == 91
        else { i = i + 1 }
    }
    if open < 0 { return own("") }
    return own(s.slice(open + 1, n - 1))
}

// `base.field` types as the field's declared type when `base` is a known struct
// and `field` is one of its fields; a `?.` chain (optional result) and anything
// else stay unknown. Nested access (`a.b.c`) falls out of the recursion.
func tyInferMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String, _ chain: Bool) using Alloc -> String {
    if chain { return own("") }
    let bt = tyInferBoxed(env, base)
    if tyHasField(env, bt, name) { return tyFieldType(env, bt, name) }
    return own("")
}

// A binary expression's type, mirroring the resolver's result types (and its
// "error type on failure" so a mis-typed operator suppresses downstream checks):
// comparisons -> Bool when the operands match (else unknown); logical -> Bool
// when both Bool; arithmetic/bitwise -> the operand type with the §17 sized
// operand winning (`Int32 + Int` -> Int32), or unknown when the operand rule is
// violated. Unknown operands stay permissive so a partly-inferred condition is
// tolerated. Other operators (??, ranges) are unknown.
// An expression of number literals alone (`48`, `-1`, `(2 * 3)`, `1 + 2`).
func tyIsNumLitTree(_ e: Vec[Nd]) -> Bool {
    if let n = e.get(0) {
        return match n {
            case .intLit(let t): true
            case .floatLit(let t): true
            case .paren(let x): tyIsNumLitTree(x)
            case .unary(let op, let x): streq(op, "-") && tyIsNumLitTree(x)
            case .binary(let op, let a, let b): isArithOp(op) && tyIsNumLitTree(a) && tyIsNumLitTree(b)
            default: false
        }
    }
    return false
}

// The bootstrap's rule: an operand of literals alone takes the other operand's
// numeric type, whichever side it is on. Returns `mine`'s type.
func tyLitAdapt(_ mine: String, _ other: String, _ m: Vec[Nd], _ o: Vec[Nd]) using Alloc -> String {
    if tyIsNumLitTree(m) && !tyIsNumLitTree(o) && tyIsNumeric(other) { return own(other) }
    return own(mine)
}

func tyInferBinary(_ env: inout TyEnv, _ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc -> String {
    let rt0 = tyInferBoxed(env, r)
    let lt = tyLitAdapt(tyInferBoxed(env, l), rt0, l, r)
    let rt = tyLitAdapt(rt0, lt, r, l)
    if isCmpOp(op) { return tyCmpResult(lt, rt) }
    if isLogOp(op) { return tyLogResult(lt, rt) }
    if isArithOp(op) { return tyNumResult(lt, rt, false) }
    if isBitOp(op) { return tyNumResult(lt, rt, true) }
    if streq(op, "??") { return tyUnwrapOpt(lt) }
    return own("")
}

// §9 `lhs ?? rhs` yields the wrapped element T when lhs is a known Optional
// `T?`; an lhs of any other (or unknown) type stays unknown, mirroring the
// resolver's error type when the left operand is not an Optional.
func tyUnwrapOpt(_ s: String) using Alloc -> String {
    let n = s.len()
    if n > 0 && (s.byteAt(n - 1) ?? 0) == 63 { return own(s.slice(0, n - 1)) }   // '?' == 63
    return own("")
}

func tyCmpResult(_ lt: String, _ rt: String) using Alloc -> String {
    if streq(lt, "") || streq(rt, "") { return own("Bool") }
    if tyReqMatch(lt, rt) { return own("Bool") }
    return own("")
}

func tyLogResult(_ lt: String, _ rt: String) using Alloc -> String {
    if streq(lt, "") || streq(rt, "") { return own("Bool") }
    if streq(lt, "Bool") && streq(rt, "Bool") { return own("Bool") }
    return own("")
}

func tyNumResult(_ lt: String, _ rt: String, _ needInt: Bool) using Alloc -> String {
    if streq(lt, "") || streq(rt, "") { return own("") }
    var lok: Bool = tyIsNumeric(lt)
    if needInt { lok = tyIsInt(lt) }
    if !lok { return own("") }
    if !tyReqMatch(lt, rt) { return own("") }
    if streq(lt, "Int") || streq(lt, "UInt") { return rt }
    return lt
}

// The self-host AST spells both prefix logical-not `!x` and postfix force-unwrap
// `x!` as `unary("!", _)`, so they are told apart by the operand: an Optional
// `T?` operand is a force-unwrap yielding T (§9), anything else is logical-not
// yielding Bool. `-x` carries a numeric operand through, `~x` an integer one;
// a constraint violation yields the error type ("") so it doesn't cascade.
func tyInferUnary(_ env: inout TyEnv, _ op: String, _ x: Vec[Nd]) using Alloc -> String {
    let xt = tyInferBoxed(env, x)
    if streq(op, "!") {
        if (xt.byteAt(xt.len() - 1) ?? 0) == 63 { return tyUnwrapOpt(xt) }   // T? -> T
        return own("Bool")
    }
    if streq(xt, "") { return own("") }                   // unknown operand: stay permissive
    if streq(op, "-") { if tyIsNumeric(xt) { return own(xt) }; return own("") }
    if streq(op, "~") { if tyIsInt(xt) { return own(xt) }; return own("") }
    return own(xt)
}

func isCmpOp(_ op: String) -> Bool {
    return streq(op, "==") || streq(op, "!=") || streq(op, "<") || streq(op, "<=")
        || streq(op, ">") || streq(op, ">=")
}

func isLogOp(_ op: String) -> Bool {
    return streq(op, "&&") || streq(op, "||")
}

func isArithOp(_ op: String) -> Bool {
    return streq(op, "+") || streq(op, "-") || streq(op, "*") || streq(op, "/")
        || streq(op, "%") || streq(op, "&*") || streq(op, "&+") || streq(op, "&-")
}

func isBitOp(_ op: String) -> Bool {
    return streq(op, "<<") || streq(op, ">>") || streq(op, "&") || streq(op, "^") || streq(op, "|")
}

func tyIsNumeric(_ s: String) -> Bool {
    return tyIsInt(s) || streq(s, "Float32") || streq(s, "Float64")
}

// The resolver's require_match: operands match when they are equal, or both
// integers where one assigns to the other (the §17 natural-width rule).
func tyReqMatch(_ lt: String, _ rt: String) using Alloc -> Bool {
    if streq(lt, rt) { return true }
    if tyIsInt(lt) && tyIsInt(rt) && (tyAssignable(lt, rt) || tyAssignable(rt, lt)) { return true }
    return false
}

// ----- binary operator constraints ------------------------------------------
func tyBinary(_ env: inout TyEnv, _ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc {
    tyBoxed(env, l)
    tyBoxed(env, r)
    tyCheckBinOp(env, op, l, r)
}

func tyCheckBinOp(_ env: inout TyEnv, _ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc {
    let rt0 = tyInferBoxed(env, r)
    let lt = tyLitAdapt(tyInferBoxed(env, l), rt0, l, r)
    let rt = tyLitAdapt(rt0, lt, r, l)
    if streq(lt, "") || streq(rt, "") { return }
    if isLogOp(op) {
        if !streq(lt, "Bool") || !streq(rt, "Bool") { env.bad.push(tyLogMsg()) }
    } else if isArithOp(op) {
        if !tyIsNumeric(lt) { env.bad.push(tyArithMsg(lt)) }
        else if !tyReqMatch(lt, rt) { env.bad.push(tyDiffMsg(lt, rt)) }
    } else if isBitOp(op) {
        if !tyIsInt(lt) { env.bad.push(tyBitMsg(lt)) }
        else if !tyReqMatch(lt, rt) { env.bad.push(tyDiffMsg(lt, rt)) }
    } else if isCmpOp(op) {
        if !tyReqMatch(lt, rt) { env.bad.push(tyDiffMsg(lt, rt)) }
    }
}

func tyArithMsg(_ got: String) using Alloc -> String {
    var s: String = "arithmetic operator requires numeric operands, got "
    s.append(got)
    return s
}

func tyBitMsg(_ got: String) using Alloc -> String {
    var s: String = "bitwise operator requires integer operands, got "
    s.append(got)
    return s
}

func tyDiffMsg(_ lt: String, _ rt: String) using Alloc -> String {
    var s: String = "binary operator operands of different types: "
    s.append(lt)
    s.append(" vs ")
    s.append(rt)
    return s
}

func tyLogMsg() using Alloc -> String {
    return own("logical && / || require Bool operands")
}

// ----- unary operator constraints -------------------------------------------
func tyUnary(_ env: inout TyEnv, _ op: String, _ x: Vec[Nd]) using Alloc {
    tyBoxed(env, x)
    tyCheckUnOp(env, op, x)
}

// `-x` needs a numeric operand, `~x` an integer one. `!` is skipped: the AST
// merges prefix logical-not and postfix force-unwrap into one node, so the right
// diagnostic ("requires Bool" vs "requires an Optional") can't be chosen.
func tyCheckUnOp(_ env: inout TyEnv, _ op: String, _ x: Vec[Nd]) using Alloc {
    let xt = tyInferBoxed(env, x)
    if streq(xt, "") { return }
    if streq(op, "-") {
        if !tyIsNumeric(xt) { env.bad.push(tyNegMsg(xt)) }
    } else if streq(op, "~") {
        if !tyIsInt(xt) { env.bad.push(tyBitNotMsg(xt)) }
    }
}

func tyNegMsg(_ got: String) using Alloc -> String {
    var s: String = "unary '-' requires a numeric type, got "
    s.append(got)
    return s
}

func tyBitNotMsg(_ got: String) using Alloc -> String {
    var s: String = "unary '~' requires an integer type, got "
    s.append(got)
    return s
}

func tyFieldMsg(_ label: String, _ fieldType: String, _ argType: String) using Alloc -> String {
    var s: String = "field '"
    s.append(label)
    s.append("' of type ")
    s.append(fieldType)
    s.append(" cannot accept value of type ")
    s.append(argType)
    return s
}

func tyNoFieldMsg(_ structName: String, _ label: String) using Alloc -> String {
    var s: String = "'"
    s.append(structName)
    s.append("' has no field '")
    s.append(label)
    s.append("'")
    return s
}

func tyMissingMsg(_ structName: String, _ fieldName: String) using Alloc -> String {
    var s: String = "struct '"
    s.append(structName)
    s.append("' constructor is missing field '")
    s.append(fieldName)
    s.append("'")
    return s
}

func tyCtorLabelMsg(_ n: Int) using Alloc -> String {
    var s: String = "struct constructor argument "
    s.append(intToStr(n))
    s.append(" requires a field label")
    return s
}

func tyInferCall(_ env: inout TyEnv, _ callee: Vec[Nd]) using Alloc -> String {
    return match (callee.get(0) ?? Nd.wildcard) {
        case .member(let base, let name, let chain): tyInferMethodCall(env, base, name, chain)
        default: tyInferPlainCall(env, callee)
    }
}

func tyInferPlainCall(_ env: inout TyEnv, _ callee: Vec[Nd]) using Alloc -> String {
    let nm = exCalleeNameBoxed(callee)
    let r = tyFuncRet(env, nm)
    if !streq(r, "") { return r }
    if tyIsStruct(env, nm) { return nm }
    return own("")
}

// `recv.method(...)` types as the method's declared result, found by the
// receiver's (struct/enum) type. A `?.` chain, an unknown receiver, or a builtin
// / generic method (none recorded) stays unknown and is tolerated. A `Self`
// result resolves to the receiver type so a chained / stored result types right.
func tyInferMethodCall(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String, _ chain: Bool) using Alloc -> String {
    if chain { return own("") }
    let bt = tyInferBoxed(env, base)
    if streq(bt, "") { return own("") }
    return tyMethodRet(env, bt, name)
}

func tyMethodRet(_ env: inout TyEnv, _ owner: String, _ name: String) using Alloc -> String {
    var i: Int = 0
    while i < env.mStruct.len() {
        if let s = env.mStruct.get(i) {
            if streq(s, owner) {
                if let mn = env.mName.get(i) {
                    if streq(mn, name) {
                        let r = env.mRet.get(i) ?? own("")
                        if streq(r, "Self") { return owner }
                        return r
                    }
                }
            }
        }
        i = i + 1
    }
    return own("")
}

// ----- type spelling (describe) of an annotation node -----------------------
func tyAnnSpelling(_ ty: Vec[Nd]) using Alloc -> String {
    if ty.len() == 0 { return own("") }
    return typeSpelling(ty.get(0) ?? Nd.wildcard)
}

func typeSpelling(_ t: Nd) using Alloc -> String {
    return match t {
        case .named(let path, let hasG, let args): tyNamedSpelling(path, hasG, args)
        case .opt(let inner): tyOptSpelling(inner)
        case .vecT(let len, let elem): tyVecTSpelling(len, elem)
        default: own("")
    }
}

// A fixed-size array type `[N]T` spells as "[N]" + the element spelling, no
// space — the same shape an array literal infers to (see tyInferVecLit).
func tyVecTSpelling(_ len: String, _ elem: Vec[Nd]) using Alloc -> String {
    var s: String = "["
    s.append(len)
    s.append("]")
    s.append(tyAnnSpelling(elem))
    return s
}

func tyNamedSpelling(_ path: String, _ hasG: Bool, _ args: Vec[Nd]) using Alloc -> String {
    var s: String = path
    if hasG && args.len() > 0 {
        s.append("[")
        var i: Int = 0
        while i < args.len() {
            if i > 0 { s.append(", ") }
            s.append(typeSpelling(args.get(i) ?? Nd.wildcard))
            i = i + 1
        }
        s.append("]")
    }
    return s
}

func tyOptSpelling(_ inner: Vec[Nd]) using Alloc -> String {
    var s: String = tyAnnSpelling(inner)
    s.append("?")
    return s
}

// ----- assignability --------------------------------------------------------
// Does expression `e`, of inferred type `t`, fit where `to` is expected? The
// bootstrap types a number literal against the expected type, so `1` fits a
// UInt8 and `[[1, 2], [3, 4]]` fits a `[2][2]UInt8`; here a literal infers as
// `Int`, so a literal (or an array literal of them) is let through by shape.
func tyFits(_ t: String, _ e: Vec[Nd], _ to: String) using Alloc -> Bool {
    if tyAssignable(t, to) { return true }
    return tyLitFits(e, to)
}

func tyLitFits(_ e: Vec[Nd], _ to: String) using Alloc -> Bool {
    if tyIsNumLitTree(e) {
        if tyHasFloatLit(e) { return streq(to, "Float32") || streq(to, "Float64") }
        return tyIsInt(to)   // an integer literal doesn't become a float
    }
    if let n = e.get(0) {
        return match n {
            case .vecLit(let xs): tyArrayLitFits(xs, to)
            case .paren(let x): tyLitFits(x, to)
            default: false
        }
    }
    return false
}

// `[a, b, ...]` against `[N]T`: the count matches and every element fits T.
func tyArrayLitFits(_ xs: Vec[Nd], _ to: String) using Alloc -> Bool {
    if !tyIsArray(to) { return false }
    if !streq(tyArrayCount(to), intToStr(xs.len())) { return false }
    let et = tyArrayElem(to)
    var i: Int = 0
    while i < xs.len() {
        var one: Vec[Nd] = Vec.new()
        one.push(xs.get(i) ?? Nd.wildcard)
        if !tyLitFits(one, et) { return false }
        i = i + 1
    }
    return true
}

func tyHasFloatLit(_ e: Vec[Nd]) -> Bool {
    if let n = e.get(0) {
        return match n {
            case .floatLit(let t): true
            case .paren(let x): tyHasFloatLit(x)
            case .unary(let op, let x): tyHasFloatLit(x)
            case .binary(let op, let a, let b): tyHasFloatLit(a) || tyHasFloatLit(b)
            default: false
        }
    }
    return false
}

func tyAssignable(_ from: String, _ to: String) using Alloc -> Bool {
    if streq(from, "") || streq(to, "") { return true }   // unknown: don't pile on
    if streq(from, to) { return true }
    if tyIsArray(from) && tyIsArray(to) { return tyArrayAssignable(from, to) }
    if tyIntNatural(from, to) { return true }
    if tyStrLattice(from, to) { return true }
    if tyOptionalWrap(from, to) { return true }
    return false
}

// Two array types `[N]T` / `[M]U` are assignable when their counts match and the
// element types are assignable (so `[3]Int` -> `[3]Int32` by natural width, but
// neither a count nor a Vec mismatch passes).
func tyIsArray(_ s: String) -> Bool {
    return s.len() > 0 && (s.byteAt(0) ?? 0) == 91   // '[' == 91
}

func tyArrayAssignable(_ from: String, _ to: String) using Alloc -> Bool {
    return streq(tyArrayCount(from), tyArrayCount(to))
        && tyAssignable(tyArrayElem(from), tyArrayElem(to))
}

// "[3]Int32" -> "3" (between '[' and the first ']').
func tyArrayCount(_ s: String) using Alloc -> String {
    var i: Int = 1
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 93 { return own(s.slice(1, i)) }   // ']' == 93
        i = i + 1
    }
    return own("")
}

// "[3]Int32" -> "Int32" (everything after the first ']').
func tyArrayElem(_ s: String) using Alloc -> String {
    var i: Int = 1
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 93 { return own(s.slice(i + 1, s.len())) }
        i = i + 1
    }
    return own("")
}

func tyIsInt(_ s: String) -> Bool {
    return streq(s, "Int") || streq(s, "Int8") || streq(s, "Int16") || streq(s, "Int32")
        || streq(s, "Int64") || streq(s, "Int128") || streq(s, "UInt") || streq(s, "UInt8")
        || streq(s, "UInt16") || streq(s, "UInt32") || streq(s, "UInt64") || streq(s, "UInt128")
}

func tyIsSignedInt(_ s: String) -> Bool {
    return streq(s, "Int") || streq(s, "Int8") || streq(s, "Int16") || streq(s, "Int32")
        || streq(s, "Int64") || streq(s, "Int128")
}

// §17 — a natural-width Int/UInt assigns to/from a specific width of the same
// signedness; specific widths remain mutually incompatible.
func tyIntNatural(_ from: String, _ to: String) -> Bool {
    if !(tyIsInt(from) && tyIsInt(to)) { return false }
    let fn = streq(from, "Int") || streq(from, "UInt")
    let tn = streq(to, "Int") || streq(to, "UInt")
    if !(fn || tn) { return false }
    return tyIsSignedInt(from) == tyIsSignedInt(to)
}

func tyStrRank(_ s: String) -> Int {
    if streq(s, "StrConst") { return 0 }
    if streq(s, "Str") { return 1 }
    if streq(s, "String") { return 2 }
    return -1
}

// §4 — StrConst <= Str <= String (narrowing literal to wider owner/view).
func tyStrLattice(_ from: String, _ to: String) -> Bool {
    let f = tyStrRank(from)
    let t = tyStrRank(to)
    return f >= 0 && t >= 0 && f <= t
}

// §9 — a value of T is assignable to an Optional T (`.some(...)` wrap).
func tyOptionalWrap(_ from: String, _ to: String) using Alloc -> Bool {
    let n = to.len()
    if n == 0 { return false }
    if (to.byteAt(n - 1) ?? 0) != 63 { return false }   // ends with '?'
    return tyAssignable(from, own(to.slice(0, n - 1)))
}

// ----- diagnostics ----------------------------------------------------------
func tyInitMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "initializer of type "
    s.append(from)
    s.append(" does not match annotation ")
    s.append(to)
    return s
}

func tyConstMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "const value of type "
    s.append(from)
    s.append(" does not match annotation ")
    s.append(to)
    return s
}

func digitChar(_ d: Int) -> Str {
    return "0123456789".slice(d, d + 1)
}

func intToStr(_ n: Int) using Alloc -> String {
    if n == 0 { return own("0") }
    var rev: Vec[Int] = Vec.new()
    var x: Int = n
    while x > 0 {
        rev.push(x % 10)
        x = x / 10
    }
    var s: String = ""
    var i: Int = rev.len() - 1
    while i >= 0 {
        s.append(digitChar(rev.get(i) ?? 0))
        i = i - 1
    }
    return s
}

func tyArityMsg(_ expected: Int, _ got: Int) using Alloc -> String {
    var s: String = "call expects "
    s.append(intToStr(expected))
    s.append(" argument(s), got ")
    s.append(intToStr(got))
    return s
}

func tyArgMsg(_ idx1: Int, _ from: String, _ to: String) using Alloc -> String {
    var s: String = "argument "
    s.append(intToStr(idx1))
    s.append(" of type ")
    s.append(from)
    s.append(" does not match parameter type ")
    s.append(to)
    return s
}

func tyReturnMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "return value of type "
    s.append(from)
    s.append(" does not match function result type ")
    s.append(to)
    return s
}

func tyBodyMsg(_ name: String, _ ret: String, _ body: String) using Alloc -> String {
    var s: String = "function '"
    s.append(name)
    s.append("' returns ")
    s.append(ret)
    s.append(" but body produces ")
    s.append(body)
    return s
}

// ===========================================================================
// §5 module loading (foundation for multi-file resolution). For each
// `import a.b.c`, the file <entry-dir>/a/b/c.vst must exist; the only search root
// here is the entry file's directory (the driver also honours `-I`, which vsema
// is not given). A missing import yields
// "cannot find imported module '<a.b.c>' (searched: <candidate>)".
// ===========================================================================
// <dir>/<dotted-with-slashes>.vst
func importCandidate(_ dir: Str, _ dotted: Str) using Alloc -> String {
    var rel: String = dotToSlash(dotted)
    rel.append(".vst")
    return joinPath(dir, rel)
}

func dirName(_ path: Str) using Alloc -> String {
    var last: Int = -1
    var i: Int = 0
    while i < path.len() {
        if (path.byteAt(i) ?? 0) == 47 { last = i }   // '/' == 47
        i = i + 1
    }
    if last < 0 { return own("") }
    return own(path.slice(0, last))
}

func dotToSlash(_ s: Str) using Alloc -> String {
    var r: String = ""
    var i: Int = 0
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 46 { r.append("/") }   // '.' == 46
        else { r.append(s.slice(i, i + 1)) }
        i = i + 1
    }
    return r
}

func joinPath(_ dir: Str, _ rel: Str) using Alloc -> String {
    if dir.len() == 0 { return own(rel) }
    var s: String = own(dir)
    s.append("/")
    s.append(rel)
    return s
}

func missingImportMsg(_ dotted: Str, _ searched: Str) using Alloc -> String {
    var s: String = "cannot find imported module '"
    s.append(dotted)
    s.append("' (searched: ")
    s.append(searched)
    s.append(")")
    return s
}

// §5 module loading: resolve each `import a.b.c` to <dir>/a/b/c.vst. A missing
// import is reported (and aborts before sema, as the driver does); a found one
// is parsed and its public declarations tabulated into env's export tables,
// keyed by the imported file's *declared* module path, so qualified references
// `mod.member` can be checked during resolution.
func loadModules(_ u: NUnit, _ path: Str, _ env: inout Env) using Alloc, Fs -> Vec[String] {
    let dir = dirName(path)
    var errs: Vec[String] = Vec.new()
    var i: Int = 0
    while i < u.imports.len() {
        loadOneImport(u.imports.get(i) ?? Nd.importD(false, ""), dir, &errs, &env)
        i = i + 1
    }
    return errs
}

func loadOneImport(_ imp: Nd, _ dir: Str, _ errs: inout Vec[String], _ env: inout Env) using Alloc, Fs {
    match imp {
        case .importD(let isC, let dotted): loadImportPath(isC, dotted, dir, &errs, &env)
        default: noop()
    }
}

func loadImportPath(_ isC: Bool, _ dotted: String, _ dir: Str, _ errs: inout Vec[String], _ env: inout Env) using Alloc, Fs {
    if isC { return }
    if streq(dotted, "") { return }
    let cand = importCandidate(dir, dotted)
    if let contents = readFile(cand) { harvestModule(&env, contents) }
    else { errs.push(missingImportMsg(dotted, cand)) }
}

// Parse a found import and record its public declarations under its declared
// module path. A file with no `module` line exports nothing addressable.
func harvestModule(_ env: inout Env, _ contents: Str) using Alloc {
    let toks = tokenize(contents)
    var p = Ps(toks: toks, pos: 0)
    let mu = parseUnit(&p)
    if !mu.hasMod { return }
    env.modPaths.push(own(mu.modPath))
    var i: Int = 0
    while i < mu.decls.len() {
        harvestDecl(&env, mu.modPath, mu.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

// A public func/const/static is a value MEMBER; a public struct/enum/opaque is
// both a type export (usable in type position) and a value member (its name
// doubles as a constructor in value position).
func harvestDecl(_ env: inout Env, _ modPath: Str, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let ps, let cap, let th, let r, let b):
            harvestMember(&env, modPath, vis, name)
        case .structD(let vis, let name, let f, let m, let dn, let lin, let g):
            harvestTypeMember(&env, modPath, vis, name)
        case .enumD(let vis, let name, let c, let m, let g):
            harvestTypeMember(&env, modPath, vis, name)
        case .constD(let vis, let name, let t, let v):
            harvestMember(&env, modPath, vis, name)
        case .staticD(let vis, let name, let t, let v):
            harvestMember(&env, modPath, vis, name)
        case .opaqueD(let vis, let name, let t):
            harvestTypeMember(&env, modPath, vis, name)
        default: noop()
    }
}

// A struct / enum / opaque exports both a value member (constructor) and a type.
func harvestTypeMember(_ env: inout Env, _ modPath: Str, _ vis: Str, _ name: Str) using Alloc {
    harvestMember(&env, modPath, vis, name)
    harvestType(&env, modPath, vis, name)
}

func harvestMember(_ env: inout Env, _ modPath: Str, _ vis: Str, _ name: Str) using Alloc {
    if !streq(vis, "public ") { return }
    env.modExpMod.push(own(modPath))
    env.modExpName.push(own(name))
}

func harvestType(_ env: inout Env, _ modPath: Str, _ vis: Str, _ name: Str) using Alloc {
    if !streq(vis, "public ") { return }
    env.modTypMod.push(own(modPath))
    env.modTypName.push(own(name))
}

// ----- §15.5 hosted-runtime features under --no-libc ------------------------
// The bootstrap's TargetContext::freestanding rule: a hosted capability in a
// `using` row or a `with`, an `async func`, or a heap type (String, Vec, Box,
// HashMap, Channel) is an error. Order as the bootstrap reports: signature
// types while declarations are collected (types first, then functions), then
// each function's using row, `async`, and body.
func hlCheck(_ u: NUnit, _ out: inout Vec[String]) using Alloc {
    var i: Int = 0
    while i < u.decls.len() {
        match u.decls.get(i) ?? Nd.wildcard {
            case .structD(let vis, let name, let fl, let m, let dn, let lin, let g): hlV(fl, out)
            case .enumD(let vis, let name, let cs, let m, let g): hlV(cs, out)
            default: noop()
        }
        i = i + 1
    }
    i = 0
    while i < u.decls.len() {
        match u.decls.get(i) ?? Nd.wildcard {
            case .funcD(let vis, let mods, let name, let g, let ps, let c, let t, let r, let b): hlSig(ps, r, out)
            case .constD(let vis, let name, let ty, let v): hlV(ty, out)
            case .staticD(let vis, let name, let ty, let v): hlV(ty, out)
            default: noop()
        }
        i = i + 1
    }
    i = 0
    while i < u.decls.len() {
        hlDecl(u.decls.get(i) ?? Nd.wildcard, out)
        i = i + 1
    }
}

func hlSig(_ ps: Vec[Nd], _ r: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    hlV(ps, out)
    hlV(r, out)
}

func hlDecl(_ d: Nd, _ out: inout Vec[String]) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let ps, let c, let t, let r, let b): hlFunc(mods, c, b, out)
        case .structD(let vis, let name, let fl, let m, let dn, let lin, let g): hlMethods(m, out)
        case .enumD(let vis, let name, let cs, let m, let g): hlMethods(m, out)
        default: noop()
    }
}

func hlMethods(_ ms: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    var i: Int = 0
    while i < ms.len() {
        match ms.get(i) ?? Nd.wildcard {
            case .funcD(let vis, let mods, let name, let g, let ps, let c, let t, let r, let b): hlMethod(mods, ps, r, c, b, out)
            default: noop()
        }
        i = i + 1
    }
}

func hlMethod(_ mods: String, _ ps: Vec[Nd], _ r: Vec[Nd], _ caps: Vec[Nd], _ body: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    hlSig(ps, r, out)
    hlFunc(mods, caps, body, out)
}

func hlFunc(_ mods: String, _ caps: Vec[Nd], _ body: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    hlCaps(caps, out)
    if containsSub(mods, "async") { out.push(hlCapMsg("Async")) }
    hlV(body, out)
}

func hlCaps(_ caps: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    var i: Int = 0
    while i < caps.len() {
        match caps.get(i) ?? Nd.wildcard {
            case .named(let path, let g, let a): hlCap(path, out)
            default: noop()
        }
        i = i + 1
    }
}

func hlCap(_ path: String, _ out: inout Vec[String]) using Alloc {
    let n = hlLastSeg(path)
    if streq(n, "Alloc") || streq(n, "Log") || streq(n, "Async") || streq(n, "Fs") || streq(n, "Net")
        || streq(n, "Clock") || streq(n, "Rand") { out.push(hlCapMsg(n)) }
}

func hlLastSeg(_ p: String) using Alloc -> String {
    var at: Int = 0
    var i: Int = 0
    while i < p.len() {
        if (p.byteAt(i) ?? 0) == 46 { at = i + 1 }
        i = i + 1
    }
    return own(p.slice(at, p.len()))
}

func hlCapMsg(_ n: Str) using Alloc -> String {
    var s: String = "`"
    s.append(n)
    s.append("` needs the hosted runtime, which a --no-libc build doesn't have (no heap, logging, files, async, clock, network or randomness)")
    return s
}

func hlTypeMsg(_ n: Str) using Alloc -> String {
    var s: String = "`"
    s.append(n)
    s.append("` needs the hosted runtime (a heap), which a --no-libc build doesn't have")
    return s
}

func hlV(_ xs: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    var i: Int = 0
    while i < xs.len() {
        hlN(xs.get(i) ?? Nd.wildcard, out)
        i = i + 1
    }
}

// Walk statements, expressions and types for heap types and `with` caps.
func hlN(_ n: Nd, _ out: inout Vec[String]) using Alloc {
    match n {
        case .named(let path, let g, let args): hlNamed(path, args, out)
        case .opt(let x): hlV(x, out)
        case .vecT(let len, let x): hlV(x, out)
        case .tupleT(let xs): hlV(xs, out)
        case .someT(let x): hlV(x, out)
        case .dynT(let x): hlV(x, out)
        case .fnT(let ps, let cs, let t, let r): hlFnT(ps, r, out)
        case .param(let lo, let l, let nm, let ne, let md, let t): hlV(t, out)
        case .field(let k, let nm, let t): hlV(t, out)
        case .enumCase(let nm, let ps): hlV(ps, out)
        case .payElem(let l, let t): hlV(t, out)
        case .block(let ss): hlV(ss, out)
        case .letS(let p, let t, let v): hlPair(t, v, out)
        case .varS(let p, let t, let v): hlPair(t, v, out)
        case .exprS(let x): hlV(x, out)
        case .retS(let x): hlV(x, out)
        case .assignS(let op, let t, let v): hlPair(t, v, out)
        case .whileS(let c, let b): hlPair(c, b, out)
        case .forS(let p, let it, let b): hlPair(it, b, out)
        case .withS(let caps, let vals, let b): hlWith(caps, vals, b, out)
        case .ifE(let ln, let li, let c, let t, let e): hlIf(li, c, t, e, out)
        case .matchE(let sc, let arms): hlPair(sc, arms, out)
        case .matchArm(let d, let pt, let g, let b): hlPair(g, b, out)
        case .closureE(let ps, let b): hlV(b, out)
        case .call(let c, let a): hlPair(c, a, out)
        case .arg(let l, let io, let v): hlV(v, out)
        case .paren(let x): hlV(x, out)
        case .unary(let op, let x): hlV(x, out)
        case .binary(let op, let a, let b): hlPair(a, b, out)
        case .asE(let v, let t, let o): hlPair(v, t, out)
        case .prefixE(let kw, let x): hlV(x, out)
        default: noop()
    }
}

func hlPair(_ a: Vec[Nd], _ b: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    hlV(a, out)
    hlV(b, out)
}

func hlFnT(_ ps: Vec[Nd], _ r: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    hlV(ps, out)
    hlV(r, out)
}

func hlIf(_ li: Vec[Nd], _ c: Vec[Nd], _ t: Vec[Nd], _ e: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    hlV(li, out)
    hlV(c, out)
    hlV(t, out)
    hlV(e, out)
}

func hlWith(_ caps: Vec[Nd], _ vals: Vec[Nd], _ body: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    hlCaps(caps, out)
    hlV(vals, out)
    hlV(body, out)
}

func hlNamed(_ path: String, _ args: Vec[Nd], _ out: inout Vec[String]) using Alloc {
    if streq(path, "String") || streq(path, "Vec") || streq(path, "Box") || streq(path, "HashMap")
        || streq(path, "Channel") {
        out.push(hlTypeMsg(path))
        return
    }
    hlV(args, out)
}

func main() -> Int32 {
    with Alloc {
        with Fs {
            with Log {
                let argv = args()
                if argv.len() < 2 {
                    eprintln("usage: vsema [--no-libc] <file.vst>")
                    return 1
                }
                // `--no-libc` (§15.5): reject what needs the hosted runtime.
                var noLibc: Bool = false
                var path: Str = ""
                var ai: Int = 1
                while ai < argv.len() {
                    let a = argv.get(ai) ?? ""
                    if streq(a, "--no-libc") { noLibc = true } else { path = a }
                    ai = ai + 1
                }
                if let src = readFile(path) {
                    let toks = tokenize(src)
                    var p = Ps(toks: toks, pos: 0)
                    let u = parseUnit(&p)
                    // §5 module loading: every `import a.b.c` must resolve to a
                    // file <dir>/a/b/c.vst; a missing one aborts before sema (as
                    // the driver does), reporting the searched path.
                    var env = Env(names: Vec.new(), bad: Vec.new(), marks: Vec.new(),
                                  dups: Vec.new(), curThrows: false, throwBad: Vec.new(),
                                  modPaths: Vec.new(), modExpMod: Vec.new(),
                                  modExpName: Vec.new(), modTypMod: Vec.new(),
                                  modTypName: Vec.new(), modBad: Vec.new())
                    let impErrs = loadModules(u, path, &env)
                    var ie: Int = 0
                    while ie < impErrs.len() {
                        if let m = impErrs.get(ie) { println(m) }
                        ie = ie + 1
                    }
                    if impErrs.len() > 0 { return 1 }
                    addBuiltins(&env)
                    resolve(&env, u)
                    var di: Int = 0
                    while di < env.dups.len() {
                        if let msg = env.dups.get(di) { println(msg) }
                        di = di + 1
                    }
                    var thi: Int = 0
                    while thi < env.throwBad.len() {
                        if let msg = env.throwBad.get(thi) { println(msg) }
                        thi = thi + 1
                    }
                    var mbi: Int = 0
                    while mbi < env.modBad.len() {
                        if let msg = env.modBad.get(mbi) { println(msg) }
                        mbi = mbi + 1
                    }
                    var tnenv = TnEnv(types: Vec.new(), userTypes: Vec.new(),
                                      genericUserTypes: Vec.new(), tparams: Vec.new(),
                                      tpMarks: Vec.new(), modPaths: Vec.new(),
                                      modTypMod: Vec.new(), modTypName: Vec.new(),
                                      bad: Vec.new())
                    tnCheck(&tnenv, u, env.modPaths, env.modTypMod, env.modTypName)
                    var tni: Int = 0
                    while tni < tnenv.bad.len() {
                        if let msg = tnenv.bad.get(tni) { println(msg) }
                        tni = tni + 1
                    }
                    var hosted: Vec[String] = Vec.new()
                    if noLibc { hlCheck(u, hosted) }
                    var hli: Int = 0
                    while hli < hosted.len() {
                        if let msg = hosted.get(hli) { println(msg) }
                        hli = hli + 1
                    }
                    var i: Int = 0
                    while i < env.bad.len() {
                        if let nm = env.bad.get(i) {
                            print("undefined name '")
                            print(nm)
                            println("'")
                        }
                        i = i + 1
                    }
                    // Match `vestra check`: stop at resolution errors before the
                    // later passes; otherwise run them all and accumulate. Order
                    // mirrors the driver: type checking is part of resolution (so
                    // its errors gate too), then ownership, exclusivity, capability.
                    if env.bad.len() > 0 || env.dups.len() > 0 || env.throwBad.len() > 0
                        || env.modBad.len() > 0 || tnenv.bad.len() > 0 || hosted.len() > 0 { return 1 }
                    var tenv = TyEnv(funcName: Vec.new(), funcRet: Vec.new(), funcArity: Vec.new(),
                                     pFn: Vec.new(), pIdx: Vec.new(), pType: Vec.new(),
                                     structs: Vec.new(), sFldStruct: Vec.new(), sFldName: Vec.new(),
                                     sFldType: Vec.new(), mStruct: Vec.new(), mName: Vec.new(),
                                     mRet: Vec.new(), eName: Vec.new(), ecEnum: Vec.new(),
                                     ecName: Vec.new(), ecArity: Vec.new(),
                                     symName: Vec.new(), symType: Vec.new(),
                                     curRet: own(""), bad: Vec.new(),
                                     mInout: Vec.new(), muName: Vec.new(), muFlag: Vec.new(),
                                     muKind: Vec.new(), muMarks: Vec.new(),
                                     stName: Vec.new(), stAtomic: Vec.new())
                    tyCheck(&tenv, u)
                    var ti: Int = 0
                    while ti < tenv.bad.len() {
                        if let msg = tenv.bad.get(ti) { println(msg) }
                        ti = ti + 1
                    }
                    if tenv.bad.len() > 0 { return 1 }
                    var oenv = OwnEnv(names: Vec.new(), consumed: Vec.new(),
                                      sigName: Vec.new(), sigIdx: Vec.new(), sigMode: Vec.new(),
                                      ctors: Vec.new(), bad: Vec.new(),
                                      linears: Vec.new(), isLin: Vec.new(), leakRep: Vec.new(),
                                      fieldOwner: Vec.new(), fieldTy: Vec.new(), neverFns: Vec.new(),
                                      fnName: Vec.new(), fnRet: Vec.new(),
                                      fieldName: Vec.new(), staticName: Vec.new(), staticTy: Vec.new(),
                                      pName: Vec.new(), pMode: Vec.new(), pTy: Vec.new(),
                                      locName: Vec.new(), locTy: Vec.new(), selfTy: "", borrows: Vec.new(),
                                      fKeys: Vec.new(), fIds: Vec.new(), fStatic: Vec.new())
                    ownCheck(&oenv, u)
                    var o: Int = 0
                    while o < oenv.bad.len() {
                        if let msg = oenv.bad.get(o) { println(msg) }
                        o = o + 1
                    }
                    var xenv = ExEnv(sigName: Vec.new(), sigIdx: Vec.new(),
                                     sigMode: Vec.new(), bad: Vec.new())
                    exCheck(&xenv, u)
                    var x: Int = 0
                    while x < xenv.bad.len() {
                        if let msg = xenv.bad.get(x) { println(msg) }
                        x = x + 1
                    }
                    var cenv = CapEnv(active: Vec.new(), fcNames: Vec.new(), fcCaps: Vec.new(),
                                      userFuncs: Vec.new(), bad: Vec.new())
                    checkCapabilities(&cenv, u)
                    var k: Int = 0
                    while k < cenv.bad.len() {
                        if let msg = cenv.bad.get(k) { println(msg) }
                        k = k + 1
                    }
                    if oenv.bad.len() > 0 || xenv.bad.len() > 0 || cenv.bad.len() > 0 { return 1 }
                    return 0
                }
                eprintln("read failed")
                return 1
            }
        }
    }
}
