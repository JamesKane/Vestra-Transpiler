// The dog-food compiler, phase 4: the Vestra C++ code generator, written in
// Vestra. It reuses the self-hosted lexer + parser (the front of this file is a
// copy of selfhost/parser.vst), then emits C++ from the AST, differentially
// tested against `vestra build`:
//
//   vgen <file.vst>    prints the generated C++ *definitions* (the `.cpp` body)
//                      to stdout.
//
// The contract is the emitted `.cpp` text: the e2e runs `vestra build` to produce
// <stem>.cpp and diffs it against vgen's stdout. The huge fixed runtime prelude
// and the per-program forward declarations live in the `.hpp`, which a later
// slice can mirror; this phase focuses on the definitions the codegen actually
// generates per construct.
//
// Slice 1 scope: free functions with explicitly-typed read-mode parameters and
// bodies of plain `return` statements over identifiers, integer literals, and
// binary / parenthesized expressions. Builtin scalar types map to their C++
// spellings (Int32 -> std::int32_t, Unit -> void, ...). Richer constructs are
// added slice by slice; the AST and parser below are unchanged from
// selfhost/parser.vst.

// ---------------------------------------------------------------------------
// The real token kinds (mirrors include/vestra/lex/token.hpp).
// ---------------------------------------------------------------------------
enum TokKind {
    // bookkeeping
    case eof
    case error
    case newline
    // literals
    case intLit
    case floatLit
    case stringLit
    case byteStringLit
    case charLit
    case identifier
    case interpBegin
    case interpPart
    case interpEnd
    // punctuation
    case lparen
    case rparen
    case lbrace
    case rbrace
    case lbracket
    case rbracket
    case comma
    case semicolon
    case colon
    case dot
    case dotDot
    case dotDotLt
    case arrow
    case fatArrow
    case at
    case dollar
    case question
    case underscore
    // operators
    case plus
    case minus
    case star
    case slash
    case percent
    case ampPlus
    case ampMinus
    case ampStar
    case amp
    case pipe
    case caret
    case tilde
    case bang
    case shiftL
    case shiftR
    case assign
    case plusEq
    case minusEq
    case starEq
    case slashEq
    case percentEq
    case ampEq
    case pipeEq
    case caretEq
    case shiftLEq
    case shiftREq
    case eqEq
    case bangEq
    case lt
    case gt
    case ltEq
    case gtEq
    case ampAmp
    case pipePipe
    case questionQuestion
    // keywords
    case kwModule
    case kwImport
    case kwFunc
    case kwStruct
    case kwEnum
    case kwProtocol
    case kwExtension
    case kwOpaque
    case kwType
    case kwEmbed
    case kwDeinit
    case kwLet
    case kwVar
    case kwConst
    case kwStatic
    case kwReturn
    case kwIf
    case kwElse
    case kwMatch
    case kwCase
    case kwDefault
    case kwFor
    case kwIn
    case kwWhile
    case kwBreak
    case kwContinue
    case kwWhere
    case kwDo
    case kwCatch
    case kwThrow
    case kwThrows
    case kwWith
    case kwUsing
    case kwAsync
    case kwAwait
    case kwSpawn
    case kwSelect
    case kwOn
    case kwComptime
    case kwQuote
    case kwCopy
    case kwRead
    case kwInout
    case kwSink
    case kwNonescaping
    case kwSome
    case kwDyn
    case kwLinear
    case kwTry
    case kwTryQuestion
    case kwTryBang
    case kwAs
    case kwAsQuestion
    case kwDerive
    case kwTrue
    case kwFalse
    case kwNil
    case kwSelfLower
    case kwSelfUpper
    case kwPrivate
    case kwInternal
    case kwPackage
    case kwPublic
}

struct Token {
    let kind: TokKind
    let text: Str
}

// The scanner state, threaded by inout through the scan functions.
struct Lex {
    var src: Str
    var pos: Int
    var depth: Int
    var prevOp: Bool
}

// ---------------------------------------------------------------------------
// Token spelling — the exact strings the C++ `spelling()` returns (token.cpp).
// ---------------------------------------------------------------------------
func spelling(_ k: TokKind) -> Str {
    return match k {
        case .eof: "<eof>"
        case .error: "<error>"
        case .newline: "<newline>"
        case .intLit: "integer literal"
        case .floatLit: "float literal"
        case .stringLit: "string literal"
        case .byteStringLit: "byte string literal"
        case .charLit: "character literal"
        case .identifier: "identifier"
        case .interpBegin: "<interp string begin>"
        case .interpPart: "interp string fragment"
        case .interpEnd: "<interp string end>"
        case .lparen: "("
        case .rparen: ")"
        case .lbrace: "{"
        case .rbrace: "}"
        case .lbracket: "["
        case .rbracket: "]"
        case .comma: ","
        case .semicolon: ";"
        case .colon: ":"
        case .dot: "."
        case .dotDot: ".."
        case .dotDotLt: "..<"
        case .arrow: "->"
        case .fatArrow: "=>"
        case .at: "@"
        case .dollar: "$"
        case .question: "?"
        case .underscore: "_"
        case .plus: "+"
        case .minus: "-"
        case .star: "*"
        case .slash: "/"
        case .percent: "%"
        case .ampPlus: "&+"
        case .ampMinus: "&-"
        case .ampStar: "&*"
        case .amp: "&"
        case .pipe: "|"
        case .caret: "^"
        case .tilde: "~"
        case .bang: "!"
        case .shiftL: "<<"
        case .shiftR: ">>"
        case .assign: "="
        case .plusEq: "+="
        case .minusEq: "-="
        case .starEq: "*="
        case .slashEq: "/="
        case .percentEq: "%="
        case .ampEq: "&="
        case .pipeEq: "|="
        case .caretEq: "^="
        case .shiftLEq: "<<="
        case .shiftREq: ">>="
        case .eqEq: "=="
        case .bangEq: "!="
        case .lt: "<"
        case .gt: ">"
        case .ltEq: "<="
        case .gtEq: ">="
        case .ampAmp: "&&"
        case .pipePipe: "||"
        case .questionQuestion: "??"
        case .kwModule: "module"
        case .kwImport: "import"
        case .kwFunc: "func"
        case .kwStruct: "struct"
        case .kwEnum: "enum"
        case .kwProtocol: "protocol"
        case .kwExtension: "extension"
        case .kwOpaque: "opaque"
        case .kwType: "type"
        case .kwEmbed: "embed"
        case .kwDeinit: "deinit"
        case .kwLet: "let"
        case .kwVar: "var"
        case .kwConst: "const"
        case .kwStatic: "static"
        case .kwReturn: "return"
        case .kwIf: "if"
        case .kwElse: "else"
        case .kwMatch: "match"
        case .kwCase: "case"
        case .kwDefault: "default"
        case .kwFor: "for"
        case .kwIn: "in"
        case .kwWhile: "while"
        case .kwBreak: "break"
        case .kwContinue: "continue"
        case .kwWhere: "where"
        case .kwDo: "do"
        case .kwCatch: "catch"
        case .kwThrow: "throw"
        case .kwThrows: "throws"
        case .kwWith: "with"
        case .kwUsing: "using"
        case .kwAsync: "async"
        case .kwAwait: "await"
        case .kwSpawn: "spawn"
        case .kwSelect: "select"
        case .kwOn: "on"
        case .kwComptime: "comptime"
        case .kwQuote: "quote"
        case .kwCopy: "copy"
        case .kwRead: "read"
        case .kwInout: "inout"
        case .kwSink: "sink"
        case .kwNonescaping: "nonescaping"
        case .kwSome: "some"
        case .kwDyn: "dyn"
        case .kwLinear: "linear"
        case .kwTry: "try"
        case .kwTryQuestion: "try?"
        case .kwTryBang: "try!"
        case .kwAs: "as"
        case .kwAsQuestion: "as?"
        case .kwDerive: "derive"
        case .kwTrue: "true"
        case .kwFalse: "false"
        case .kwNil: "nil"
        case .kwSelfLower: "self"
        case .kwSelfUpper: "Self"
        case .kwPrivate: "private"
        case .kwInternal: "internal"
        case .kwPackage: "package"
        case .kwPublic: "public"
    }
}

// The §3 binary-operator set: a newline right after one of these is suppressed
// (mirrors is_binary_operator in lexer.cpp). Unary !, ~, ? are NOT included.
func isBinOp(_ k: TokKind) -> Bool {
    return match k {
        case .plus: true
        case .minus: true
        case .star: true
        case .slash: true
        case .percent: true
        case .ampPlus: true
        case .ampMinus: true
        case .ampStar: true
        case .amp: true
        case .pipe: true
        case .caret: true
        case .shiftL: true
        case .shiftR: true
        case .eqEq: true
        case .bangEq: true
        case .lt: true
        case .gt: true
        case .ltEq: true
        case .gtEq: true
        case .ampAmp: true
        case .pipePipe: true
        case .questionQuestion: true
        case .assign: true
        case .plusEq: true
        case .minusEq: true
        case .starEq: true
        case .slashEq: true
        case .percentEq: true
        case .ampEq: true
        case .pipeEq: true
        case .caretEq: true
        case .shiftLEq: true
        case .shiftREq: true
        case .arrow: true
        case .fatArrow: true
        case .comma: true
        case .colon: true
        case .dotDot: true
        case .dotDotLt: true
        default: false
    }
}

// The §17.1 keyword table. `try` / `as` map to their base kind here; the `?` / `!`
// suffixes are folded in by the identifier scanner.
func keywordKind(_ s: Str) -> TokKind {
    return match s {
        case "module": TokKind.kwModule
        case "import": TokKind.kwImport
        case "func": TokKind.kwFunc
        case "struct": TokKind.kwStruct
        case "enum": TokKind.kwEnum
        case "protocol": TokKind.kwProtocol
        case "extension": TokKind.kwExtension
        case "opaque": TokKind.kwOpaque
        case "type": TokKind.kwType
        case "embed": TokKind.kwEmbed
        case "deinit": TokKind.kwDeinit
        case "let": TokKind.kwLet
        case "var": TokKind.kwVar
        case "const": TokKind.kwConst
        case "static": TokKind.kwStatic
        case "return": TokKind.kwReturn
        case "if": TokKind.kwIf
        case "else": TokKind.kwElse
        case "match": TokKind.kwMatch
        case "case": TokKind.kwCase
        case "default": TokKind.kwDefault
        case "for": TokKind.kwFor
        case "in": TokKind.kwIn
        case "while": TokKind.kwWhile
        case "break": TokKind.kwBreak
        case "continue": TokKind.kwContinue
        case "where": TokKind.kwWhere
        case "do": TokKind.kwDo
        case "catch": TokKind.kwCatch
        case "throw": TokKind.kwThrow
        case "throws": TokKind.kwThrows
        case "with": TokKind.kwWith
        case "using": TokKind.kwUsing
        case "async": TokKind.kwAsync
        case "await": TokKind.kwAwait
        case "spawn": TokKind.kwSpawn
        case "select": TokKind.kwSelect
        case "on": TokKind.kwOn
        case "comptime": TokKind.kwComptime
        case "quote": TokKind.kwQuote
        case "copy": TokKind.kwCopy
        case "read": TokKind.kwRead
        case "inout": TokKind.kwInout
        case "sink": TokKind.kwSink
        case "nonescaping": TokKind.kwNonescaping
        case "some": TokKind.kwSome
        case "dyn": TokKind.kwDyn
        case "linear": TokKind.kwLinear
        case "try": TokKind.kwTry
        case "as": TokKind.kwAs
        case "derive": TokKind.kwDerive
        case "true": TokKind.kwTrue
        case "false": TokKind.kwFalse
        case "nil": TokKind.kwNil
        case "self": TokKind.kwSelfLower
        case "Self": TokKind.kwSelfUpper
        case "private": TokKind.kwPrivate
        case "internal": TokKind.kwInternal
        case "package": TokKind.kwPackage
        case "public": TokKind.kwPublic
        default: TokKind.identifier
    }
}

// ---------------------------------------------------------------------------
// ASCII character classes — written out to match the C++ predicates exactly
// (rather than relying on Char.isAlpha, which could differ on non-ASCII).
// ---------------------------------------------------------------------------
func isDigitC(_ c: Char) -> Bool { return c >= '0' && c <= '9' }
func isHexC(_ c: Char) -> Bool {
    return isDigitC(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}
func isOctC(_ c: Char) -> Bool { return c >= '0' && c <= '7' }
func isBinC(_ c: Char) -> Bool { return c == '0' || c == '1' }
func isIdStartC(_ c: Char) -> Bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}
func isIdContC(_ c: Char) -> Bool { return isIdStartC(c) || isDigitC(c) }

// Byte-wise string equality (avoids the Str-vs-StrConst operator mismatch).
func streq(_ a: Str, _ b: Str) -> Bool {
    if a.len() != b.len() { return false }
    var i: Int = 0
    while i < a.len() {
        if (a.byteAt(i) ?? 0) != (b.byteAt(i) ?? 0) { return false }
        i = i + 1
    }
    return true
}

// ---------------------------------------------------------------------------
// Cursor primitives over the Lex state.
// ---------------------------------------------------------------------------
func atC(_ src: Str, _ i: Int) -> Char {
    if i >= src.len() { return '\0' }
    return src.charAt(i) ?? '\0'
}
func curC(_ l: Lex) -> Char { return atC(l.src, l.pos) }
func aheadC(_ l: Lex, _ n: Int) -> Char { return atC(l.src, l.pos + n) }
func atEndL(_ l: Lex) -> Bool { return l.pos >= l.src.len() }
func advC(_ l: inout Lex) { l.pos = l.pos + 1 }
func bumpC(_ l: inout Lex) -> Char {
    let c = curC(l)
    l.pos = l.pos + 1
    return c
}
func eatC(_ l: inout Lex, _ expected: Char) -> Bool {
    if curC(l) == expected {
        l.pos = l.pos + 1
        return true
    }
    return false
}

// Emit a token spanning [start, pos); records whether it was a binary operator
// so the next newline knows whether to continue the statement.
func emitTok(_ toks: inout Vec[Token], _ l: inout Lex, _ k: TokKind, _ start: Int) using Alloc {
    let bin = isBinOp(k)
    toks.push(Token(kind: k, text: l.src.slice(start, l.pos)))
    l.prevOp = bin
}

// Does the next significant char (past horizontal whitespace, blank lines, and
// line comments) begin a binary operator? Then the pending newline continues.
func nextStartsWithOperator(_ src: Str, _ scanStart: Int) -> Bool {
    var scan: Int = scanStart
    var go: Bool = true
    while go && scan < src.len() {
        let d = atC(src, scan)
        if d == ' ' || d == '\t' || d == '\r' || d == '\n' {
            scan = scan + 1
        } else if d == '/' && atC(src, scan + 1) == '/' {
            while scan < src.len() && atC(src, scan) != '\n' { scan = scan + 1 }
        } else {
            go = false
        }
    }
    if scan < src.len() {
        let d = atC(src, scan)
        return d == '+' || d == '-' || d == '*' || d == '/' || d == '%'
            || d == '|' || d == '^' || d == '?' || d == '.'
    }
    return false
}

// /* ... */ with §3 nesting.
func scanBlockComment(_ l: inout Lex) {
    var depth: Int = 1
    while depth > 0 && !atEndL(l) {
        if curC(l) == '/' && aheadC(l, 1) == '*' {
            advC(&l)
            advC(&l)
            depth = depth + 1
        } else if curC(l) == '*' && aheadC(l, 1) == '/' {
            advC(&l)
            advC(&l)
            depth = depth - 1
        } else {
            advC(&l)
        }
    }
}

// Skip whitespace and comments, emitting Newline tokens where they terminate a
// statement (§3 continuation rules).
func skipTrivia(_ toks: inout Vec[Token], _ l: inout Lex) using Alloc {
    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        if c == ' ' || c == '\t' || c == '\r' {
            advC(&l)
        } else if c == '\n' {
            let nlStart = l.pos
            advC(&l)
            if l.depth > 0 || l.prevOp {
                // continuation: newline suppressed
            } else if !nextStartsWithOperator(l.src, l.pos) {
                toks.push(Token(kind: TokKind.newline, text: l.src.slice(nlStart, nlStart + 1)))
            }
        } else if c == '/' && aheadC(l, 1) == '/' {
            while !atEndL(l) && curC(l) != '\n' { advC(&l) }
        } else if c == '/' && aheadC(l, 1) == '*' {
            advC(&l)
            advC(&l)
            scanBlockComment(&l)
        } else {
            go = false
        }
    }
}

// Consume a run of digits (and `_` separators) in the given base.
func eatDigits(_ l: inout Lex, _ base: Int) {
    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        var ok: Bool = false
        if base == 16 { ok = isHexC(c) }
        else if base == 8 { ok = isOctC(c) }
        else if base == 2 { ok = isBinC(c) }
        else { ok = isDigitC(c) }
        if ok || c == '_' { advC(&l) } else { go = false }
    }
}

func scanNumber(_ toks: inout Vec[Token], _ l: inout Lex, _ start: Int) using Alloc {
    var isFloat: Bool = false
    let first = atC(l.src, start)
    let c1 = curC(l)
    if first == '0' && (c1 == 'x' || c1 == 'o' || c1 == 'b') {
        let base = bumpC(&l)
        if base == 'x' { eatDigits(&l, 16) }
        else if base == 'o' { eatDigits(&l, 8) }
        else { eatDigits(&l, 2) }
    } else {
        eatDigits(&l, 10)
        if curC(l) == '.' && isDigitC(aheadC(l, 1)) {
            isFloat = true
            advC(&l)
            eatDigits(&l, 10)
        }
        if curC(l) == 'e' || curC(l) == 'E' {
            isFloat = true
            advC(&l)
            if curC(l) == '+' || curC(l) == '-' { advC(&l) }
            eatDigits(&l, 10)
        }
    }
    var k: TokKind = TokKind.intLit
    if isFloat { k = TokKind.floatLit }
    emitTok(&toks, &l, k, start)
}

func scanIdentifier(_ toks: inout Vec[Token], _ l: inout Lex, _ start: Int) using Alloc {
    while !atEndL(l) && isIdContC(curC(l)) { advC(&l) }
    let lex = l.src.slice(start, l.pos)
    var kind = keywordKind(lex)
    if streq(lex, "try") {
        if curC(l) == '?' { advC(&l); kind = TokKind.kwTryQuestion }
        else if curC(l) == '!' { advC(&l); kind = TokKind.kwTryBang }
    } else if streq(lex, "as") && curC(l) == '?' {
        advC(&l)
        kind = TokKind.kwAsQuestion
    }
    if streq(lex, "_") { kind = TokKind.underscore }
    emitTok(&toks, &l, kind, start)
}

// §4 interpolation: pick up the next literal fragment after the opening `"` of an
// interpolated string or the `)` that closed a splice. Emit the fragment as an
// InterpStringPart, then either close on `"` (part + InterpStringEnd) or split on
// `\(` (part + LParen, push the splice's bracket depth, and return so the main loop
// runs the splice body). The `)` that closes the splice resumes us via the main
// loop. The splice-opening LParen carries the two-char lexeme `\(`, matching the
// C++ lexer; InterpStringBegin / End each carry the `"`.
func scanInterpContinue(_ toks: inout Vec[Token], _ l: inout Lex, _ splices: inout Vec[Int]) using Alloc {
    let fragStart = l.pos
    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        if c == '"' {
            emitTok(&toks, &l, TokKind.interpPart, fragStart)
            let endStart = l.pos
            advC(&l)
            emitTok(&toks, &l, TokKind.interpEnd, endStart)
            return
        }
        if c == '\\' && aheadC(l, 1) == '(' {
            emitTok(&toks, &l, TokKind.interpPart, fragStart)
            let markerStart = l.pos
            advC(&l)
            advC(&l)
            l.depth = l.depth + 1
            splices.push(l.depth)
            emitTok(&toks, &l, TokKind.lparen, markerStart)
            return
        }
        if c == '\\' {
            advC(&l)
            if !atEndL(l) { advC(&l) }
        } else if c == '\n' {
            emitTok(&toks, &l, TokKind.error, fragStart)
            return
        } else {
            advC(&l)
        }
    }
    emitTok(&toks, &l, TokKind.error, fragStart)
}

// String / byte string. Regular strings are pre-scanned for a `\(` splice: if one
// is present the literal lexes as InterpStringBegin + (Part / splice tokens)* +
// InterpStringEnd; otherwise it is a single StringLit. Byte strings (§17.1) never
// interpolate.
func scanString(_ toks: inout Vec[Token], _ l: inout Lex, _ splices: inout Vec[Int], _ start: Int, _ isByte: Bool) using Alloc {
    if !isByte {
        let saved = l.pos
        var hasSplice: Bool = false
        var scan: Bool = true
        while scan && !atEndL(l) {
            let c = curC(l)
            if c == '"' || c == '\n' {
                scan = false
            } else if c == '\\' {
                if aheadC(l, 1) == '(' {
                    hasSplice = true
                    scan = false
                } else {
                    advC(&l)
                    if !atEndL(l) { advC(&l) }
                }
            } else {
                advC(&l)
            }
        }
        l.pos = saved
        if hasSplice {
            emitTok(&toks, &l, TokKind.interpBegin, start)
            scanInterpContinue(&toks, &l, &splices)
            return
        }
    }

    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        if c == '"' {
            advC(&l)
            var k: TokKind = TokKind.stringLit
            if isByte { k = TokKind.byteStringLit }
            emitTok(&toks, &l, k, start)
            return
        }
        if c == '\\' {
            advC(&l)
            if !atEndL(l) { advC(&l) }
        } else if c == '\n' {
            emitTok(&toks, &l, TokKind.error, start)
            return
        } else {
            advC(&l)
        }
    }
    emitTok(&toks, &l, TokKind.error, start)
}

func scanChar(_ toks: inout Vec[Token], _ l: inout Lex, _ start: Int) using Alloc {
    if curC(l) == '\\' {
        advC(&l)
        if !atEndL(l) { advC(&l) }
    } else if !atEndL(l) && curC(l) != '\'' {
        advC(&l)
    }
    if curC(l) != '\'' {
        emitTok(&toks, &l, TokKind.error, start)
        return
    }
    advC(&l)
    emitTok(&toks, &l, TokKind.charLit, start)
}

// The main scan loop: skip trivia, dispatch on the first char, append Eof.
func tokenize(_ src: Str) using Alloc -> Vec[Token] {
    var l = Lex(src: src, pos: 0, depth: 0, prevOp: false)
    var toks: Vec[Token] = Vec.new()
    var splices: Vec[Int] = Vec.new()
    while !atEndL(l) {
        skipTrivia(&toks, &l)
        if atEndL(l) { return finish(&toks, &l) }
        let start = l.pos
        let c = bumpC(&l)
        if c == '(' { l.depth = l.depth + 1; emitTok(&toks, &l, TokKind.lparen, start) }
        else if c == ')' {
            l.depth = l.depth - 1
            emitTok(&toks, &l, TokKind.rparen, start)
            // §4: a `)` that drops bracket depth below the current splice's level
            // closes the splice and resumes the surrounding string fragment.
            if splices.len() > 0 && l.depth < (splices.get(splices.len() - 1) ?? 0) {
                let _ = splices.pop()
                scanInterpContinue(&toks, &l, &splices)
            }
        }
        else if c == '[' { l.depth = l.depth + 1; emitTok(&toks, &l, TokKind.lbracket, start) }
        else if c == ']' { l.depth = l.depth - 1; emitTok(&toks, &l, TokKind.rbracket, start) }
        else if c == '{' { l.depth = l.depth + 1; emitTok(&toks, &l, TokKind.lbrace, start) }
        else if c == '}' { l.depth = l.depth - 1; emitTok(&toks, &l, TokKind.rbrace, start) }
        else if c == ',' { emitTok(&toks, &l, TokKind.comma, start) }
        else if c == ';' { emitTok(&toks, &l, TokKind.semicolon, start) }
        else if c == '@' { emitTok(&toks, &l, TokKind.at, start) }
        else if c == '$' { emitTok(&toks, &l, TokKind.dollar, start) }
        else if c == '~' { emitTok(&toks, &l, TokKind.tilde, start) }
        else if c == ':' { emitTok(&toks, &l, TokKind.colon, start) }
        else if c == '.' {
            if eatC(&l, '.') {
                if eatC(&l, '<') { emitTok(&toks, &l, TokKind.dotDotLt, start) }
                else { emitTok(&toks, &l, TokKind.dotDot, start) }
            } else { emitTok(&toks, &l, TokKind.dot, start) }
        }
        else if c == '?' {
            if eatC(&l, '?') { emitTok(&toks, &l, TokKind.questionQuestion, start) }
            else { emitTok(&toks, &l, TokKind.question, start) }
        }
        else if c == '+' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.plusEq, start) }
            else { emitTok(&toks, &l, TokKind.plus, start) }
        }
        else if c == '-' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.minusEq, start) }
            else if eatC(&l, '>') { emitTok(&toks, &l, TokKind.arrow, start) }
            else { emitTok(&toks, &l, TokKind.minus, start) }
        }
        else if c == '*' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.starEq, start) }
            else { emitTok(&toks, &l, TokKind.star, start) }
        }
        else if c == '/' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.slashEq, start) }
            else { emitTok(&toks, &l, TokKind.slash, start) }
        }
        else if c == '%' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.percentEq, start) }
            else { emitTok(&toks, &l, TokKind.percent, start) }
        }
        else if c == '^' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.caretEq, start) }
            else { emitTok(&toks, &l, TokKind.caret, start) }
        }
        else if c == '&' {
            if eatC(&l, '&') { emitTok(&toks, &l, TokKind.ampAmp, start) }
            else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.ampEq, start) }
            else if eatC(&l, '+') { emitTok(&toks, &l, TokKind.ampPlus, start) }
            else if eatC(&l, '-') { emitTok(&toks, &l, TokKind.ampMinus, start) }
            else if eatC(&l, '*') { emitTok(&toks, &l, TokKind.ampStar, start) }
            else { emitTok(&toks, &l, TokKind.amp, start) }
        }
        else if c == '|' {
            if eatC(&l, '|') { emitTok(&toks, &l, TokKind.pipePipe, start) }
            else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.pipeEq, start) }
            else { emitTok(&toks, &l, TokKind.pipe, start) }
        }
        else if c == '=' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.eqEq, start) }
            else if eatC(&l, '>') { emitTok(&toks, &l, TokKind.fatArrow, start) }
            else { emitTok(&toks, &l, TokKind.assign, start) }
        }
        else if c == '!' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.bangEq, start) }
            else { emitTok(&toks, &l, TokKind.bang, start) }
        }
        else if c == '<' {
            if eatC(&l, '<') {
                if eatC(&l, '=') { emitTok(&toks, &l, TokKind.shiftLEq, start) }
                else { emitTok(&toks, &l, TokKind.shiftL, start) }
            } else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.ltEq, start) }
            else { emitTok(&toks, &l, TokKind.lt, start) }
        }
        else if c == '>' {
            if eatC(&l, '>') {
                if eatC(&l, '=') { emitTok(&toks, &l, TokKind.shiftREq, start) }
                else { emitTok(&toks, &l, TokKind.shiftR, start) }
            } else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.gtEq, start) }
            else { emitTok(&toks, &l, TokKind.gt, start) }
        }
        else if c == '"' { scanString(&toks, &l, &splices, start, false) }
        else if c == '\'' { scanChar(&toks, &l, start) }
        else if c == 'b' && curC(l) == '"' { advC(&l); scanString(&toks, &l, &splices, start, true) }
        else if isDigitC(c) { scanNumber(&toks, &l, start) }
        else if isIdStartC(c) { scanIdentifier(&toks, &l, start) }
        else { emitTok(&toks, &l, TokKind.error, start) }
    }
    return finish(&toks, &l)
}

// Append the final Eof token (empty lexeme) and hand back the stream.
func finish(_ toks: inout Vec[Token], _ l: inout Lex) using Alloc -> Vec[Token] {
    let n = l.src.len()
    toks.push(Token(kind: TokKind.eof, text: l.src.slice(n, n)))
    return toks
}

// ===========================================================================
// One self-recursive node type. Folding expressions, statements, types, patterns,
// params, and decls into a single enum avoids mutual recursion between separate
// enums (which the transpiler can't forward-declare); self-recursion through
// Vec[Nd] lowers cleanly. Children are boxed as one-element Vec[Nd]; lists are
// many-element Vec[Nd]. Operator / visibility tags are stored as their already-
// printable strings, so the printer just emits them.
// ===========================================================================
enum Nd {
    // expressions
    case intLit(String)
    case floatLit(String)
    case strLit(String)                     // text without the surrounding quotes
    case byteStrLit(String)                 // text without b"…"
    case charLit(String)                    // text without the quotes
    case boolLit(Bool)
    case nilLit
    case ident(String)
    case selfE
    case leadingDot(String)
    case paren(Vec[Nd])                     // inner (boxed)
    case unary(String, Vec[Nd])             // op string, operand
    case binary(String, Vec[Nd], Vec[Nd])
    case call(Vec[Nd], Vec[Nd])             // callee (boxed), args (each an .arg)
    case arg(String, Bool, Vec[Nd])         // label, is_inout, value (only as a call arg)
    case member(Vec[Nd], String, Bool)      // base, name, is_optional_chain
    case index(Vec[Nd], Vec[Nd])            // base (boxed), indices
    case ifE(String, Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd]) // letName, letInit, cond, then, else
    case block(Vec[Nd])                     // statements
    case asE(Vec[Nd], Vec[Nd], Bool)        // value, target type, is_optional
    case addrOf(Vec[Nd])
    case matchE(Vec[Nd], Vec[Nd])           // scrutinee (boxed), arms — still prints /*?expr*/ (no C++ printer case), but carries the match for sema
    case matchArm(Bool, Vec[Nd], Vec[Nd], Vec[Nd]) // isDefault, pattern (empty if default), guard (empty if none), body — all boxed
    case exoticE                            // comptime, closure, select, etc — /*?expr*/
    case vecLit(Vec[Nd])                    // [e1, e2, ...] array/vector literal — prints /*?expr*/ (no C++ case), carries elements for sema
    case tupleLit(Vec[Nd])                  // (e1, e2, ...) tuple literal — prints /*?expr*/ (no C++ case), carries elements for sema
    case closureE(Vec[Nd], Vec[Nd])         // { params => body } — params (ident nodes) + body stmts; prints /*?expr*/ (no C++ case), carries both for sema
    case interpE(Vec[String], Vec[Nd])      // "...\(e)..." interpolated string — prints /*?expr*/ (no C++ case), carries the embedded exprs for sema
    case throwE(Vec[Nd])                    // throw OPERAND — also prints /*?expr*/ (no C++ printer case), but carries the operand for sema
    case prefixE(String, Vec[Nd])           // copy / await / spawn / try (kw string), operand — printed fully
    case doCatchE(Vec[Nd], String, Vec[Nd], Vec[Nd]) // doBody, errName, errType?, catchBody
    case quoteE(Vec[Nd])                     // quote { EXPR } — printed fully
    case spliceE(Bool, Vec[Nd])              // isBareIdent, inner — $ident or $(expr)
    // statements
    case letS(Vec[Nd], Vec[Nd], Vec[Nd])    // pattern, type?, value
    case varS(Vec[Nd], Vec[Nd], Vec[Nd])
    case exprS(Vec[Nd])
    case retS(Vec[Nd])                       // value?
    case assignS(String, Vec[Nd], Vec[Nd])   // op, target, value
    case whileS(Vec[Nd], Vec[Nd])            // cond, body (block)
    case forS(Vec[Nd], Vec[Nd], Vec[Nd])     // pattern, iter, body (block)
    case breakS(String)                      // label ("" if none)
    case continueS(String)
    case withS(Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd])  // grant-only cap types, binding names (parallel to values; "" = capability instance), binding values, body (printed /*?stmt*/)
    // patterns
    case wildcard
    case identP(String)
    case bindP(String)
    case litP(Vec[Nd])                       // literal pattern (boxed expr)
    case enumP(String, Vec[Nd])              // case name, children patterns
    case tupleP(Vec[Nd])                     // printed /*?pat*/
    case rangeP(Vec[Nd], Vec[Nd], Bool)      // printed /*?pat*/
    case orP(Vec[Nd])                        // printed /*?pat*/
    // types
    case named(String, Bool, Vec[Nd])        // path, hasGenerics, type args
    case opt(Vec[Nd])                        // inner type (boxed)
    case someT(Vec[Nd])                      // some T
    case dynT(Vec[Nd])                       // dyn T
    case vecT(String, Vec[Nd])               // length (int or ident string), element
    case tupleT(Vec[Nd])                     // (T, U, ...)
    case fnT(Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd]) // params, usingCaps, throws?, result?
    // generic parameters (printed on funcs; parsed-and-dropped on structs/enums)
    case genConst(String, Vec[Nd])           // name, const type
    case genType(String, Vec[Nd])            // name, bounds (types joined by " & ")
    // a function parameter
    case param(Bool, String, String, Bool, String, Vec[Nd]) // labelOmitted, label, name, nonesc, mode, type
    // struct / enum members
    case field(String, String, Vec[Nd])     // kind ("let "/"var "/"embed "), name, type
    case enumCase(String, Vec[Nd])           // name, payload (payElem list)
    case payElem(String, Vec[Nd])            // label ("" if positional), type
    // declarations
    case importD(Bool, String)               // is_c_header, payload (joined path or header)
    case funcD(String, String, String, Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd])
    // visibilityPrefix, modifiers (async/recv), name, generics, params, usingCaps, throwsType?, result?, body?
    case structD(String, String, Vec[Nd], Vec[Nd], Vec[Nd], Bool, Vec[Nd]) // vis, name, fields, methods, deinit?, isLinear, generics
    case enumD(String, String, Vec[Nd], Vec[Nd], Vec[Nd])   // vis, name, cases, methods, generics
    case constD(String, String, Vec[Nd], Vec[Nd])           // vis, name, type?, value
    case staticD(String, String, Vec[Nd], Vec[Nd])          // vis, name, type, value?
    case opaqueD(String, String, Vec[Nd])                   // vis, name, underlying type
    case deriveD(Vec[Nd], Vec[Nd])                          // protocols, target type
}

struct NUnit {
    var hasMod: Bool
    var modPath: String
    var imports: Vec[Nd]
    var decls: Vec[Nd]
}

struct Ps {
    var toks: Vec[Token]
    var pos: Int
}

struct BP {
    let left: Int
    let right: Int
}

// ----- small constructors / helpers ----------------------------------------
func own(_ s: Str) using Alloc -> String { var r: String = ""; r.append(s); return r }
func bE(_ e: Nd) using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); v.push(e); return v }
func bT(_ t: Nd) using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); v.push(t); return v }
func noE() using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); return v }
func noT() using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); return v }
func errE() using Alloc -> Nd { return Nd.ident("?") }
func errT() using Alloc -> Nd { return Nd.named("?", false, noT()) }
func errP() using Alloc -> Nd { return Nd.wildcard }

func eofTok() -> Token { return Token(kind: TokKind.eof, text: "") }
func curT(_ p: inout Ps) -> Token { return p.toks.get(p.pos) ?? eofTok() }
func curKind(_ p: inout Ps) -> TokKind { let t = curT(p); return t.kind }
func aheadKindP(_ p: inout Ps, _ n: Int) -> TokKind { let t = p.toks.get(p.pos + n) ?? eofTok(); return t.kind }
func curRaw(_ p: inout Ps) -> Str { let t = curT(p); return t.text }
func curText(_ p: inout Ps) using Alloc -> String { return own(curRaw(p)) }
func advP(_ p: inout Ps) { p.pos = p.pos + 1 }
func isKind(_ p: inout Ps, _ k: TokKind) -> Bool { return streq(spelling(curKind(p)), spelling(k)) }
func isKindAt(_ p: inout Ps, _ n: Int, _ k: TokKind) -> Bool { return streq(spelling(aheadKindP(p, n)), spelling(k)) }
func eat(_ p: inout Ps, _ k: TokKind) -> Bool { if isKind(p, k) { advP(&p); return true } return false }
func eatV(_ p: inout Ps, _ k: TokKind) { if isKind(p, k) { advP(&p) } }
func atEndP(_ p: inout Ps) -> Bool { return isKind(p, TokKind.eof) }
func skipNL(_ p: inout Ps) { while isKind(p, TokKind.newline) || isKind(p, TokKind.semicolon) { advP(&p) } }

// ----- operator tables (token kind -> printable string / binding power) -----
func binOpStr(_ k: TokKind) -> Str {
    return match k {
        case .star: "*"
        case .slash: "/"
        case .percent: "%"
        case .ampStar: "&*"
        case .plus: "+"
        case .minus: "-"
        case .ampPlus: "&+"
        case .ampMinus: "&-"
        case .shiftL: "<<"
        case .shiftR: ">>"
        case .amp: "&"
        case .caret: "^"
        case .pipe: "|"
        case .dotDot: ".."
        case .dotDotLt: "..<"
        case .eqEq: "=="
        case .bangEq: "!="
        case .lt: "<"
        case .ltEq: "<="
        case .gt: ">"
        case .gtEq: ">="
        case .ampAmp: "&&"
        case .pipePipe: "||"
        case .questionQuestion: "??"
        default: "?"
    }
}

func infixBp(_ k: TokKind) -> BP {
    return match k {
        case .star: BP(left: 130, right: 131)
        case .slash: BP(left: 130, right: 131)
        case .percent: BP(left: 130, right: 131)
        case .ampStar: BP(left: 130, right: 131)
        case .plus: BP(left: 120, right: 121)
        case .minus: BP(left: 120, right: 121)
        case .ampPlus: BP(left: 120, right: 121)
        case .ampMinus: BP(left: 120, right: 121)
        case .shiftL: BP(left: 110, right: 111)
        case .shiftR: BP(left: 110, right: 111)
        case .amp: BP(left: 100, right: 101)
        case .caret: BP(left: 90, right: 91)
        case .pipe: BP(left: 80, right: 81)
        case .dotDot: BP(left: 70, right: 71)
        case .dotDotLt: BP(left: 70, right: 71)
        case .eqEq: BP(left: 60, right: 61)
        case .bangEq: BP(left: 60, right: 61)
        case .lt: BP(left: 60, right: 61)
        case .ltEq: BP(left: 60, right: 61)
        case .gt: BP(left: 60, right: 61)
        case .gtEq: BP(left: 60, right: 61)
        case .ampAmp: BP(left: 50, right: 51)
        case .pipePipe: BP(left: 40, right: 41)
        case .questionQuestion: BP(left: 30, right: 31)
        default: BP(left: 0, right: 0)
    }
}

func isAssignOp(_ k: TokKind) -> Bool {
    return match k {
        case .assign: true
        case .plusEq: true
        case .minusEq: true
        case .starEq: true
        case .slashEq: true
        case .percentEq: true
        case .ampEq: true
        case .pipeEq: true
        case .caretEq: true
        case .shiftLEq: true
        case .shiftREq: true
        default: false
    }
}

func assignOpStr(_ k: TokKind) -> Str {
    return match k {
        case .assign: "="
        case .plusEq: "+="
        case .minusEq: "-="
        case .starEq: "*="
        case .slashEq: "/="
        case .percentEq: "%="
        case .ampEq: "&="
        case .pipeEq: "|="
        case .caretEq: "^="
        case .shiftLEq: "<<="
        case .shiftREq: ">>="
        default: "?="
    }
}

// ----- parser ---------------------------------------------------------------
func parseUnit(_ p: inout Ps) using Alloc -> NUnit {
    var u = NUnit(hasMod: false, modPath: "", imports: Vec.new(), decls: Vec.new())
    skipNL(&p)
    if isKind(p, TokKind.kwModule) {
        advP(&p)
        u.hasMod = true
        u.modPath = parseDottedPath(&p)
        skipNL(&p)
    }
    while isKind(p, TokKind.kwImport) {
        u.imports.push(parseImport(&p))
        skipNL(&p)
    }
    while !atEndP(p) {
        u.decls.push(parseDecl(&p))
        skipNL(&p)
    }
    return u
}

func parseDottedPath(_ p: inout Ps) using Alloc -> String {
    var s: String = curText(p)
    advP(&p)
    while isKind(p, TokKind.dot) {
        advP(&p)
        s.append(".")
        s.append(curText(p))
        advP(&p)
    }
    return s
}

func parseImport(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'import'
    if isKind(p, TokKind.identifier) && streq(curRaw(p), "c") && isKindAt(p, 1, TokKind.stringLit) {
        advP(&p)  // 'c'
        let raw = curRaw(p)
        advP(&p)
        var body: String = ""
        if raw.len() >= 2 { body = own(raw.slice(1, raw.len() - 1)) }
        return Nd.importD(true, body)
    }
    return Nd.importD(false, parseDottedPath(&p))
}

func parseVisibility(_ p: inout Ps) -> Str {
    if isKind(p, TokKind.kwPrivate) { advP(&p); return "private " }
    if isKind(p, TokKind.kwPublic) { advP(&p); return "public " }
    if isKind(p, TokKind.kwPackage) { advP(&p); return "package " }
    if isKind(p, TokKind.kwInternal) { advP(&p); return "" }
    return ""
}

// Skip declaration attributes `@name` / `@name(...)` (the C++ printer does not emit
// them). Consumes any run of attributes, balancing parens in their argument lists.
func skipAttributes(_ p: inout Ps) {
    while isKind(p, TokKind.at) {
        advP(&p)  // '@'
        advP(&p)  // name (identifier or reserved word)
        if isKind(p, TokKind.lparen) {
            var depth: Int = 0
            var go: Bool = true
            while go && !atEndP(p) {
                if isKind(p, TokKind.lparen) { depth = depth + 1 }
                else if isKind(p, TokKind.rparen) {
                    depth = depth - 1
                    if depth == 0 { advP(&p); go = false }
                }
                if go { advP(&p) }
            }
        }
        skipNL(&p)
    }
}

func parseDecl(_ p: inout Ps) using Alloc -> Nd {
    skipAttributes(&p)
    let vis = own(parseVisibility(&p))
    if isKind(p, TokKind.kwStruct) { return parseStruct(&p, vis, false) }
    // §5 `linear struct Foo { … }` — the modifier (admitted on structs in v0.5)
    // is captured on the node; the printer drops it, matching the C++ dump.
    if eat(p, TokKind.kwLinear) { return parseStruct(&p, vis, true) }
    if isKind(p, TokKind.kwEnum) { return parseEnum(&p, vis) }
    if isKind(p, TokKind.kwConst) { return parseConst(&p, vis) }
    if isKind(p, TokKind.kwStatic) { return parseStatic(&p, vis) }
    if isKind(p, TokKind.kwOpaque) { return parseOpaque(&p, vis) }
    if isKind(p, TokKind.kwDerive) { return parseDerive(&p) }
    var mods: String = ""
    if eat(p, TokKind.kwComptime) { mods = "comptime " }
    if eat(p, TokKind.kwAsync) { mods.append("async ") }
    if eat(p, TokKind.kwInout) { mods.append("inout ") }
    else if eat(p, TokKind.kwSink) { mods.append("sink ") }
    return parseFunc(&p, vis, mods)
}

func parseConst(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'const'
    let name = curText(p)
    advP(&p)
    var ty: Vec[Nd] = Vec.new()
    if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
    eat(p, TokKind.assign)
    return Nd.constD(vis, name, ty, bE(parseExpr(&p)))
}

func parseStatic(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'static'
    let name = curText(p)
    advP(&p)
    var ty: Vec[Nd] = Vec.new()
    if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
    var val: Vec[Nd] = Vec.new()
    if eat(p, TokKind.assign) { val.push(parseExpr(&p)) }
    return Nd.staticD(vis, name, ty, val)
}

func parseOpaque(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'opaque'
    eat(p, TokKind.kwType)
    let name = curText(p)
    advP(&p)
    eat(p, TokKind.assign)
    return Nd.opaqueD(vis, name, bT(parseType(&p)))
}

func parseDerive(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'derive'
    eat(p, TokKind.lparen)
    var protocols: Vec[Nd] = Vec.new()
    if !isKind(p, TokKind.rparen) {
        protocols.push(parseType(&p))
        while eat(p, TokKind.comma) { protocols.push(parseType(&p)) }
    }
    eat(p, TokKind.rparen)
    eat(p, TokKind.kwFor)
    return Nd.deriveD(protocols, bT(parseType(&p)))
}

func parseStruct(_ p: inout Ps, _ vis: String, _ isLinear: Bool) using Alloc -> Nd {
    advP(&p)  // 'struct'
    let name = curText(p)
    advP(&p)  // name
    let g = parseGenerics(&p)
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var fields: Vec[Nd] = Vec.new()
    var methods: Vec[Nd] = Vec.new()
    var deinitB: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        skipAttributes(&p)  // field / method attributes (e.g. @bits(4)) — printer drops them
        if isKind(p, TokKind.kwFunc) || isKind(p, TokKind.kwAsync)
            || isKind(p, TokKind.kwInout) || isKind(p, TokKind.kwSink) {
            var mods: String = ""
            if eat(p, TokKind.kwAsync) { mods = "async " }
            if eat(p, TokKind.kwInout) { mods.append("inout ") }
            else if eat(p, TokKind.kwSink) { mods.append("sink ") }
            methods.push(parseFunc(&p, "", mods))
        } else if isKind(p, TokKind.kwDeinit) {
            advP(&p)
            deinitB.push(parseBlock(&p))
        } else {
            var kind: String = ""
            if eat(p, TokKind.kwLet) { kind = "let " }
            else if eat(p, TokKind.kwVar) { kind = "var " }
            else if eat(p, TokKind.kwEmbed) { kind = "embed " }
            else { advP(&p) }
            let fname = curText(p)
            advP(&p)
            eat(p, TokKind.colon)
            fields.push(Nd.field(kind, fname, bT(parseType(&p))))
        }
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.structD(vis, name, fields, methods, deinitB, isLinear, g)
}

func parseEnum(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'enum'
    let name = curText(p)
    advP(&p)  // name
    let g = parseGenerics(&p)
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var cases: Vec[Nd] = Vec.new()
    var methods: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        if eat(p, TokKind.kwCase) {
            let cname = curText(p)
            advP(&p)
            var payload: Vec[Nd] = Vec.new()
            if eat(p, TokKind.lparen) {
                if !isKind(p, TokKind.rparen) {
                    payload.push(parsePayElem(&p))
                    while eat(p, TokKind.comma) { payload.push(parsePayElem(&p)) }
                }
                eat(p, TokKind.rparen)
            }
            cases.push(Nd.enumCase(cname, payload))
        } else if isKind(p, TokKind.at) {
            skipAttributes(&p)  // member attributes — printer drops them
        } else if isKind(p, TokKind.kwFunc) {
            methods.push(parseFunc(&p, "", ""))
        } else {
            advP(&p)
        }
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.enumD(vis, name, cases, methods, g)
}

func parsePayElem(_ p: inout Ps) using Alloc -> Nd {
    var label: String = ""
    if isKind(p, TokKind.identifier) && isKindAt(p, 1, TokKind.colon) {
        label = curText(p)
        advP(&p)
        advP(&p)  // ':'
    }
    return Nd.payElem(label, bT(parseType(&p)))
}

func parseFunc(_ p: inout Ps, _ vis: String, _ mods: String) using Alloc -> Nd {
    advP(&p)  // 'func'
    let name = curText(p)
    advP(&p)  // name
    var generics = parseGenerics(&p)
    let params = parseParams(&p)
    var usingCaps: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.kwUsing) {
        advP(&p)
        usingCaps.push(parseType(&p))
        while eat(p, TokKind.comma) { usingCaps.push(parseType(&p)) }
    }
    var throwsT: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.kwThrows) {
        advP(&p)
        eat(p, TokKind.lparen)
        throwsT.push(parseType(&p))
        eat(p, TokKind.rparen)
    }
    var result: Vec[Nd] = Vec.new()
    if eat(p, TokKind.arrow) { result.push(parseType(&p)) }
    // A trailing `where T: P & Q` clause folds its bounds back into the generic
    // params, exactly as the C++ parser does (so they print inline as `[T: P & Q]`).
    generics = mergeWhere(generics, parseWhereClause(&p))
    var body: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.lbrace) { body.push(parseBlock(&p)) }
    return Nd.funcD(vis, mods, name, generics, params, usingCaps, throwsT, result, body)
}

func parseWhereClause(_ p: inout Ps) using Alloc -> Vec[Nd] {
    if !isKind(p, TokKind.kwWhere) { var empty: Vec[Nd] = Vec.new(); return empty }
    advP(&p)  // 'where'
    var out: Vec[Nd] = Vec.new()
    var more: Bool = true
    while more {
        let nm = curText(p)
        advP(&p)
        eat(p, TokKind.colon)
        var bounds: Vec[Nd] = Vec.new()
        bounds.push(parseType(&p))
        while eat(p, TokKind.amp) { bounds.push(parseType(&p)) }
        out.push(Nd.genType(nm, bounds))
        if !eat(p, TokKind.comma) { more = false }
    }
    return out
}

// Merge where-clause bounds (a list of genType entries) into the matching generic
// params by name, returning a fresh generics list.
func mergeWhere(_ gens: Vec[Nd], _ wheres: Vec[Nd]) using Alloc -> Vec[Nd] {
    var out: Vec[Nd] = Vec.new()
    var i: Int = 0
    while i < gens.len() {
        out.push(mergeOne(gens.get(i) ?? errT(), wheres))
        i = i + 1
    }
    return out
}

func mergeOne(_ g: Nd, _ wheres: Vec[Nd]) using Alloc -> Nd {
    return match g {
        case .genType(let name, let bounds): Nd.genType(name, boundsFor(name, bounds, wheres))
        default: g
    }
}

func boundsFor(_ name: String, _ bounds: Vec[Nd], _ wheres: Vec[Nd]) using Alloc -> Vec[Nd] {
    var nb: Vec[Nd] = Vec.new()
    var i: Int = 0
    while i < bounds.len() {
        nb.push(bounds.get(i) ?? errT())
        i = i + 1
    }
    var w: Int = 0
    while w < wheres.len() {
        appendWhereBounds(name, wheres.get(w) ?? errT(), &nb)
        w = w + 1
    }
    return nb
}

func appendWhereBounds(_ name: String, _ entry: Nd, _ nb: inout Vec[Nd]) using Alloc {
    match entry {
        case .genType(let wname, let wbounds): appendIfMatch(name, wname, wbounds, &nb)
        default: nb.push(entry)
    }
}

func appendIfMatch(_ name: String, _ wname: String, _ wbounds: Vec[Nd], _ nb: inout Vec[Nd]) using Alloc {
    if streq(name, wname) {
        var i: Int = 0
        while i < wbounds.len() {
            nb.push(wbounds.get(i) ?? errT())
            i = i + 1
        }
    }
}

func parseParams(_ p: inout Ps) using Alloc -> Vec[Nd] {
    var params: Vec[Nd] = Vec.new()
    eat(p, TokKind.lparen)
    if !isKind(p, TokKind.rparen) {
        params.push(parseParam(&p))
        while eat(p, TokKind.comma) { params.push(parseParam(&p)) }
    }
    eat(p, TokKind.rparen)
    return params
}

func parseParam(_ p: inout Ps) using Alloc -> Nd {
    var labelOmitted: Bool = false
    var label: String = ""
    var name: String = ""
    if isKind(p, TokKind.lparen) {
        // §6 tuple-destructuring parameter `(a, b): T` — the C++ printer renders it
        // as `_ : T` (label omitted, no name, pattern dropped). Consume the pattern.
        skipBalancedParens(&p)
        labelOmitted = true
    } else if isKind(p, TokKind.underscore) {
        advP(&p)
        labelOmitted = true
        // `_ name:` binds a name; bare `_:` is an anonymous parameter (no name).
        if !isKind(p, TokKind.colon) { name = curText(p); advP(&p) }
    } else if isKind(p, TokKind.identifier) && isKindAt(p, 1, TokKind.identifier) {
        label = curText(p)
        advP(&p)
        name = curText(p)
        advP(&p)
    } else {
        name = curText(p)
        advP(&p)
    }
    eat(p, TokKind.colon)
    var nonesc: Bool = false
    if isKind(p, TokKind.kwNonescaping) { advP(&p); nonesc = true }
    var mode: String = ""
    if isKind(p, TokKind.kwInout) { advP(&p); mode = "inout " }
    else if isKind(p, TokKind.kwSink) { advP(&p); mode = "sink " }
    else if isKind(p, TokKind.kwRead) { advP(&p) }
    let ty = bT(parseType(&p))
    return Nd.param(labelOmitted, label, name, nonesc, mode, ty)
}

func parseType(_ p: inout Ps) using Alloc -> Nd {
    var base = parseTypeBase(&p)
    while isKind(p, TokKind.question) {
        advP(&p)
        base = Nd.opt(bT(base))
    }
    return base
}

func parseTypeBase(_ p: inout Ps) using Alloc -> Nd {
    if eat(p, TokKind.kwSome) { return Nd.someT(bT(parseType(&p))) }
    if eat(p, TokKind.kwDyn) { return Nd.dynT(bT(parseType(&p))) }
    if isKind(p, TokKind.at) {
        // §A8 @interrupt(T) in type position — InterruptType prints /*?type*/.
        advP(&p)  // '@'
        advP(&p)  // 'interrupt'
        eatV(p, TokKind.lparen)
        let t = parseType(&p)
        eatV(p, TokKind.rparen)
        return Nd.exoticE
    }
    if isKind(p, TokKind.lbracket) { return parseVectorType(&p) }
    if isKind(p, TokKind.lparen) { return parseParenType(&p) }
    // named type: path (identifier or `Self`) with optional generic args
    var path: String = curText(p)
    advP(&p)
    while isKind(p, TokKind.dot) {
        advP(&p)
        path.append(".")
        path.append(curText(p))
        advP(&p)
    }
    var hasGen: Bool = false
    var args: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.lbracket) {
        advP(&p)
        hasGen = true
        if !isKind(p, TokKind.rbracket) {
            args.push(parseType(&p))
            while eat(p, TokKind.comma) { args.push(parseType(&p)) }
        }
        eat(p, TokKind.rbracket)
    }
    return Nd.named(path, hasGen, args)
}

func parseVectorType(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '['
    var lenStr: String = ""
    if isKind(p, TokKind.intLit) { lenStr = curText(p); advP(&p) }
    else if isKind(p, TokKind.identifier) { lenStr = curText(p); advP(&p) }
    eat(p, TokKind.rbracket)
    return Nd.vecT(lenStr, bT(parseType(&p)))
}

func parseParenType(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '('
    var parts: Vec[Nd] = Vec.new()
    if !isKind(p, TokKind.rparen) {
        parts.push(parseType(&p))
        while eat(p, TokKind.comma) { parts.push(parseType(&p)) }
    }
    eat(p, TokKind.rparen)
    if isKind(p, TokKind.kwUsing) || isKind(p, TokKind.kwThrows) || isKind(p, TokKind.arrow) {
        var caps: Vec[Nd] = Vec.new()
        if eat(p, TokKind.kwUsing) {
            caps.push(parseType(&p))
            while eat(p, TokKind.comma) { caps.push(parseType(&p)) }
        }
        var thr: Vec[Nd] = Vec.new()
        if eat(p, TokKind.kwThrows) {
            eat(p, TokKind.lparen)
            thr.push(parseType(&p))
            eat(p, TokKind.rparen)
        }
        var res: Vec[Nd] = Vec.new()
        if eat(p, TokKind.arrow) { res.push(parseType(&p)) }
        return Nd.fnT(parts, caps, thr, res)
    }
    if parts.len() == 1 { return parts.get(0) ?? errT() }
    return Nd.tupleT(parts)
}

// Generic parameter list `[T, U: A & B, const N: Int]`. Returned for funcs (which
// print them) and consumed-and-dropped for structs / enums (whose printer omits them).
func parseGenerics(_ p: inout Ps) using Alloc -> Vec[Nd] {
    if !isKind(p, TokKind.lbracket) { var empty: Vec[Nd] = Vec.new(); return empty }
    advP(&p)  // '['
    var out: Vec[Nd] = Vec.new()
    var more: Bool = true
    while more {
        if eat(p, TokKind.kwConst) {
            let nm = curText(p)
            advP(&p)
            eat(p, TokKind.colon)
            out.push(Nd.genConst(nm, bT(parseType(&p))))
        } else {
            let nm = curText(p)
            advP(&p)
            var bounds: Vec[Nd] = Vec.new()
            if eat(p, TokKind.colon) {
                bounds.push(parseType(&p))
                while eat(p, TokKind.amp) { bounds.push(parseType(&p)) }
            }
            out.push(Nd.genType(nm, bounds))
        }
        if !eat(p, TokKind.comma) { more = false }
    }
    eat(p, TokKind.rbracket)
    return out
}

func parseBlock(_ p: inout Ps) using Alloc -> Nd {
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var stmts: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        stmts.push(parseStmt(&p))
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.block(stmts)
}

func parseStmt(_ p: inout Ps) using Alloc -> Nd {
    if isKind(p, TokKind.kwLet) {
        advP(&p)
        let pat = bP(parsePattern(&p))
        var ty: Vec[Nd] = Vec.new()
        if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
        eat(p, TokKind.assign)
        return Nd.letS(pat, ty, bE(parseExpr(&p)))
    }
    if isKind(p, TokKind.kwVar) {
        advP(&p)
        let pat = bP(parsePattern(&p))
        var ty: Vec[Nd] = Vec.new()
        if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
        eat(p, TokKind.assign)
        return Nd.varS(pat, ty, bE(parseExpr(&p)))
    }
    if isKind(p, TokKind.kwReturn) {
        advP(&p)
        var v: Vec[Nd] = Vec.new()
        if !isKind(p, TokKind.newline) && !isKind(p, TokKind.semicolon)
            && !isKind(p, TokKind.rbrace) && !atEndP(p) {
            v.push(parseExpr(&p))
        }
        return Nd.retS(v)
    }
    if isKind(p, TokKind.kwWhile) {
        advP(&p)
        let cond = bE(parseExpr(&p))
        let body = bE(parseBlock(&p))
        return Nd.whileS(cond, body)
    }
    if isKind(p, TokKind.kwFor) {
        advP(&p)
        let pat = bP(parsePattern(&p))
        eat(p, TokKind.kwIn)
        let iter = bE(parseExpr(&p))
        let body = bE(parseBlock(&p))
        return Nd.forS(pat, iter, body)
    }
    if isKind(p, TokKind.kwWith) { return parseWith(&p) }
    if isKind(p, TokKind.kwBreak) {
        advP(&p)
        var label: String = ""
        if isKind(p, TokKind.identifier) { label = curText(p); advP(&p) }
        return Nd.breakS(label)
    }
    if isKind(p, TokKind.kwContinue) {
        advP(&p)
        var label: String = ""
        if isKind(p, TokKind.identifier) { label = curText(p); advP(&p) }
        return Nd.continueS(label)
    }
    let e = parseExpr(&p)
    if isAssignOp(curKind(p)) {
        let op = own(assignOpStr(curKind(p)))
        advP(&p)
        return Nd.assignS(op, bE(e), bE(parseExpr(&p)))
    }
    return Nd.exprS(bE(e))
}

func bP(_ x: Nd) using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); v.push(x); return v }

func firstCharLower(_ s: Str) -> Bool {
    let c = s.charAt(0) ?? ' '
    return c >= 'a' && c <= 'z'
}

// §17.4 `with` capability block. The C++ printer has no WithStmt case, so it dumps
// as /*?stmt*/ (our default arm); we parse the bindings and body precisely to keep
// the token stream aligned. A binding is `name (: type)? = expr` when the leading
// identifier is lowercase and followed by `=` or `:`, otherwise `cap_type (= expr)?`.
func parseWith(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'with'
    var caps: Vec[Nd] = Vec.new()
    var names: Vec[Nd] = Vec.new()
    var vals: Vec[Nd] = Vec.new()
    var more: Bool = true
    while more {
        if isKind(p, TokKind.identifier)
            && (isKindAt(p, 1, TokKind.assign) || isKindAt(p, 1, TokKind.colon))
            && firstCharLower(curRaw(p)) {
            let nm = curText(p)
            advP(&p)  // name (value binding, grants no capability)
            if eat(p, TokKind.colon) { let t = parseType(&p) }
            eat(p, TokKind.assign)
            names.push(Nd.ident(nm))
            vals.push(parseExpr(&p))
        } else {
            let t = parseType(&p)  // capability-typed binding
            if eat(p, TokKind.assign) {
                names.push(Nd.ident(""))  // "" sentinel => capability instance, lowers to (void)(val)
                vals.push(parseExpr(&p))
            } else {
                caps.push(t)  // grant-only, lowers to nothing
            }
        }
        if !eat(p, TokKind.comma) { more = false }
    }
    let body = parseBlock(&p)
    return Nd.withS(caps, names, vals, bE(body))
}

func parsePattern(_ p: inout Ps) using Alloc -> Nd {
    var alts: Vec[Nd] = Vec.new()
    alts.push(parsePatAlt(&p))
    if !isKind(p, TokKind.pipe) { return alts.get(0) ?? errP() }
    while eat(p, TokKind.pipe) { alts.push(parsePatAlt(&p)) }
    return Nd.orP(alts)
}

func parsePatAlt(_ p: inout Ps) using Alloc -> Nd {
    if isKind(p, TokKind.underscore) { advP(&p); return Nd.wildcard }
    if isKind(p, TokKind.lparen) {
        advP(&p)
        var elems: Vec[Nd] = Vec.new()
        if !isKind(p, TokKind.rparen) {
            elems.push(parsePattern(&p))
            while eat(p, TokKind.comma) { elems.push(parsePattern(&p)) }
        }
        eat(p, TokKind.rparen)
        if elems.len() == 1 { return elems.get(0) ?? errP() }
        return Nd.tupleP(elems)
    }
    if isKind(p, TokKind.kwLet) {
        advP(&p)
        let n = curText(p)
        advP(&p)
        return Nd.bindP(n)
    }
    if isKind(p, TokKind.dot) {
        advP(&p)
        let cname = curText(p)
        advP(&p)
        var children: Vec[Nd] = Vec.new()
        if eat(p, TokKind.lparen) {
            if !isKind(p, TokKind.rparen) {
                children.push(parsePattern(&p))
                while eat(p, TokKind.comma) { children.push(parsePattern(&p)) }
            }
            eat(p, TokKind.rparen)
        }
        return Nd.enumP(cname, children)
    }
    if isKind(p, TokKind.identifier) {
        let n = curText(p)
        advP(&p)
        return Nd.identP(n)
    }
    if isKind(p, TokKind.intLit) || isKind(p, TokKind.floatLit) || isKind(p, TokKind.stringLit)
        || isKind(p, TokKind.charLit) || isKind(p, TokKind.kwTrue) || isKind(p, TokKind.kwFalse) {
        let lit = parsePrimary(&p)
        if isKind(p, TokKind.dotDot) || isKind(p, TokKind.dotDotLt) {
            let incl = isKind(p, TokKind.dotDot)
            advP(&p)
            let high = parsePrimary(&p)
            return Nd.rangeP(bE(lit), bE(high), incl)
        }
        return Nd.litP(bE(lit))
    }
    return Nd.wildcard
}

func parseExpr(_ p: inout Ps) using Alloc -> Nd { return parseExprBp(&p, 0) }

func parseExprBp(_ p: inout Ps, _ minBp: Int) using Alloc -> Nd {
    var lhs = parsePrefix(&p)
    var go: Bool = true
    while go {
        if isKind(p, TokKind.kwAs) || isKind(p, TokKind.kwAsQuestion) {
            let isOpt = isKind(p, TokKind.kwAsQuestion)
            advP(&p)
            lhs = Nd.asE(bE(lhs), bT(parseType(&p)), isOpt)
        } else {
            let bp = infixBp(curKind(p))
            if bp.left < minBp || bp.left == 0 {
                go = false
            } else {
                let op = own(binOpStr(curKind(p)))
                advP(&p)
                let rhs = parseExprBp(&p, bp.right)
                lhs = Nd.binary(op, bE(lhs), bE(rhs))
            }
        }
    }
    return lhs
}

func parsePrefix(_ p: inout Ps) using Alloc -> Nd {
    // §17.7 prefix expressions. copy / await / spawn / try print fully; throw wraps
    // its operand but the C++ printer has no ThrowExpr case, so it dumps /*?expr*/.
    if eat(p, TokKind.kwCopy) { return Nd.prefixE("copy ", bE(parsePrefix(&p))) }
    if eat(p, TokKind.kwAwait) { return Nd.prefixE("await ", bE(parsePrefix(&p))) }
    if eat(p, TokKind.kwSpawn) { return Nd.prefixE("spawn ", bE(parsePrefix(&p))) }
    if eat(p, TokKind.kwThrow) { return Nd.throwE(bE(parsePrefix(&p))) }
    if isKind(p, TokKind.kwTry) || isKind(p, TokKind.kwTryQuestion) || isKind(p, TokKind.kwTryBang) {
        var form: String = "try "
        if isKind(p, TokKind.kwTryQuestion) { form = "try? " }
        else if isKind(p, TokKind.kwTryBang) { form = "try! " }
        advP(&p)
        return Nd.prefixE(form, bE(parsePrefix(&p)))
    }
    if eat(p, TokKind.minus) { return Nd.unary("-", bE(parsePrefix(&p))) }
    if eat(p, TokKind.bang) { return Nd.unary("!", bE(parsePrefix(&p))) }
    if eat(p, TokKind.tilde) { return Nd.unary("~", bE(parsePrefix(&p))) }
    if eat(p, TokKind.amp) { return Nd.addrOf(bE(parsePrefix(&p))) }
    let prim = parsePrimary(&p)
    return parsePostfix(&p, prim)
}

func parsePrimary(_ p: inout Ps) using Alloc -> Nd {
    if isKind(p, TokKind.intLit) { let t = curText(p); advP(&p); return Nd.intLit(t) }
    if isKind(p, TokKind.floatLit) { let t = curText(p); advP(&p); return Nd.floatLit(t) }
    if isKind(p, TokKind.stringLit) {
        let raw = curRaw(p); advP(&p)
        var inner: String = ""
        if raw.len() >= 2 { inner = own(raw.slice(1, raw.len() - 1)) }
        return Nd.strLit(inner)
    }
    if isKind(p, TokKind.byteStringLit) {
        let raw = curRaw(p); advP(&p)
        var inner: String = ""
        if raw.len() >= 3 { inner = own(raw.slice(2, raw.len() - 1)) }
        return Nd.byteStrLit(inner)
    }
    if isKind(p, TokKind.charLit) {
        let raw = curRaw(p); advP(&p)
        var inner: String = ""
        if raw.len() >= 2 { inner = own(raw.slice(1, raw.len() - 1)) }
        return Nd.charLit(inner)
    }
    if isKind(p, TokKind.kwTrue) { advP(&p); return Nd.boolLit(true) }
    if isKind(p, TokKind.kwFalse) { advP(&p); return Nd.boolLit(false) }
    if isKind(p, TokKind.kwNil) { advP(&p); return Nd.nilLit }
    if isKind(p, TokKind.kwSelfLower) { advP(&p); return Nd.selfE }
    if isKind(p, TokKind.identifier) { let t = curText(p); advP(&p); return Nd.ident(t) }
    if isKind(p, TokKind.dot) {
        advP(&p)
        let n = curText(p)
        advP(&p)
        return Nd.leadingDot(n)
    }
    if isKind(p, TokKind.lparen) {
        advP(&p)
        let first = parseExpr(&p)
        if eat(p, TokKind.comma) {
            // tuple literal: keep the elements (still printed as /*?expr*/).
            var elems: Vec[Nd] = Vec.new()
            elems.push(first)
            elems.push(parseExpr(&p))
            while eat(p, TokKind.comma) { elems.push(parseExpr(&p)) }
            eat(p, TokKind.rparen)
            return Nd.tupleLit(elems)
        }
        eat(p, TokKind.rparen)
        return Nd.paren(bE(first))
    }
    if isKind(p, TokKind.lbracket) {
        // array / vector literal: keep the elements (still printed as /*?expr*/).
        advP(&p)
        var elems: Vec[Nd] = Vec.new()
        if !isKind(p, TokKind.rbracket) {
            elems.push(parseExpr(&p))
            while eat(p, TokKind.comma) { elems.push(parseExpr(&p)) }
        }
        eat(p, TokKind.rbracket)
        return Nd.vecLit(elems)
    }
    if isKind(p, TokKind.kwIf) { return parseIf(&p) }
    if isKind(p, TokKind.kwMatch) { return parseMatch(&p) }
    if isKind(p, TokKind.kwSelect) {
        // §11 select { ... } — SelectExpr has no printer case (/*?expr*/); consume
        // the balanced body to stay token-aligned.
        advP(&p)
        skipBalancedBraces(&p)
        return Nd.exoticE
    }
    if isKind(p, TokKind.kwQuote) { return parseQuote(&p) }
    if isKind(p, TokKind.dollar) { return parseSplice(&p) }
    if isKind(p, TokKind.kwDo) { return parseDoCatch(&p) }
    if isKind(p, TokKind.kwComptime) {
        advP(&p)
        if isKind(p, TokKind.lbrace) { let b = parseBlock(&p) } else { let e = parseExpr(&p) }
        return Nd.exoticE
    }
    if isKind(p, TokKind.at) {
        // @embed(...) / @macro(...) — both print /*?expr*/ in the C++ printer.
        advP(&p)  // '@'
        advP(&p)  // intrinsic / macro name
        if isKind(p, TokKind.lparen) { skipBalancedParens(&p) }
        return Nd.exoticE
    }
    if isKind(p, TokKind.interpBegin) { return parseInterpString(&p) }
    if isKind(p, TokKind.lbrace) {
        if isClosureAhead(p) { return parseClosure(&p) }
        return parseBlock(&p)
    }
    // unsupported construct in this slice; emit a stub and advance.
    advP(&p)
    return Nd.ident("<error>")
}

// `do { body } catch (NAME: E) { handler }` (or bare `catch NAME`). Prints fully.
func parseDoCatch(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'do'
    let doBody = bE(parseBlock(&p))
    eat(p, TokKind.kwCatch)
    var errName: String = ""
    var errType: Vec[Nd] = Vec.new()
    if eat(p, TokKind.lparen) {
        errName = curText(p)
        advP(&p)
        eat(p, TokKind.colon)
        errType.push(parseType(&p))
        eatV(p, TokKind.rparen)
    } else if isKind(p, TokKind.identifier) {
        errName = curText(p)
        advP(&p)
    }
    if eat(p, TokKind.kwWhere) { let guard = parseExpr(&p) }
    let catchBody = bE(parseBlock(&p))
    return Nd.doCatchE(doBody, errName, errType, catchBody)
}

// §12.4 `quote { EXPR }` (expression form, printed fully) vs `quote { <decls> }` (a
// declaration-macro template, printed /*?expr*/). Disambiguated by a declaration
// keyword at brace depth 1.
func parseQuote(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'quote'  (now at '{')
    if isDeclQuoteAhead(p) {
        skipBalancedBraces(&p)
        return Nd.exoticE
    }
    eatV(p, TokKind.lbrace)
    skipNL(&p)
    let inner = parseExpr(&p)
    skipNL(&p)
    eatV(p, TokKind.rbrace)
    return Nd.quoteE(bE(inner))
}

func isDeclQuoteAhead(_ p: inout Ps) -> Bool {
    var i: Int = p.pos + 1
    var depth: Int = 1
    var found: Bool = false
    var go: Bool = true
    while go {
        let k = kindAtAbs(p, i)
        if isKind2(k, TokKind.eof) { go = false }
        else if isKind2(k, TokKind.lbrace) || isKind2(k, TokKind.lparen) || isKind2(k, TokKind.lbracket) {
            depth = depth + 1
        } else if isKind2(k, TokKind.rbrace) || isKind2(k, TokKind.rparen) || isKind2(k, TokKind.rbracket) {
            depth = depth - 1
            if depth == 0 { go = false }
        } else if depth == 1 && isDeclKw(k) {
            found = true
            go = false
        }
        i = i + 1
    }
    return found
}

func isDeclKw(_ k: TokKind) -> Bool {
    return isKind2(k, TokKind.kwFunc) || isKind2(k, TokKind.kwStruct) || isKind2(k, TokKind.kwEnum)
        || isKind2(k, TokKind.kwProtocol) || isKind2(k, TokKind.kwExtension)
        || isKind2(k, TokKind.kwConst) || isKind2(k, TokKind.kwStatic)
}

// §12.4 splice `$ident` / `$(expr)`. The C++ printer renders it bare when the inner
// is an identifier (so `$(x)` also prints `$x`), otherwise with parens.
func parseSplice(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '$'
    if eat(p, TokKind.lparen) {
        let inner = parseExpr(&p)
        eatV(p, TokKind.rparen)
        let bare = isIdentNode(inner)
        return Nd.spliceE(bare, bE(inner))
    }
    if isKind(p, TokKind.identifier) {
        let n = curText(p)
        advP(&p)
        return Nd.spliceE(true, bE(Nd.ident(n)))
    }
    return Nd.exoticE
}

func isIdentNode(_ e: Nd) -> Bool {
    return match e {
        case .ident(let n): true
        default: false
    }
}

func skipBalancedParens(_ p: inout Ps) {
    var depth: Int = 0
    var go: Bool = true
    while go && !atEndP(p) {
        if isKind(p, TokKind.lparen) { depth = depth + 1 }
        else if isKind(p, TokKind.rparen) {
            depth = depth - 1
            if depth == 0 { advP(&p); go = false }
        }
        if go { advP(&p) }
    }
}

func skipBalancedBraces(_ p: inout Ps) {
    var depth: Int = 0
    var go: Bool = true
    while go && !atEndP(p) {
        if isKind(p, TokKind.lbrace) { depth = depth + 1 }
        else if isKind(p, TokKind.rbrace) {
            depth = depth - 1
            if depth == 0 { advP(&p); go = false }
        }
        if go { advP(&p) }
    }
}

// An interpolated string `"...\(e)..."` lexes as InterpStringBegin (Part | LParen
// expr RParen)* InterpStringEnd; the C++ printer has no InterpStringExpr case, so
// it dumps /*?expr*/. We consume the sequence to stay token-aligned.
func parseInterpString(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // InterpStringBegin
    var parts: Vec[String] = Vec.new()
    var exprs: Vec[Nd] = Vec.new()
    var go: Bool = true
    while go && !isKind(p, TokKind.interpEnd) && !atEndP(p) {
        if isKind(p, TokKind.interpPart) { parts.push(curText(p)); advP(&p) }
        else if isKind(p, TokKind.lparen) {
            advP(&p)
            exprs.push(parseExpr(&p))
            eatV(p, TokKind.rparen)
        } else { advP(&p) }
    }
    eatV(p, TokKind.interpEnd)
    return Nd.interpE(parts, exprs)
}

// A `{ params => body }` closure (vs a block). The C++ printer has no ClosureExpr
// case, so it dumps /*?expr*/. Detect by scanning for a `=>` at brace depth 1.
func isClosureAhead(_ p: inout Ps) -> Bool {
    var i: Int = p.pos + 1
    var depth: Int = 1
    var found: Bool = false
    var go: Bool = true
    while go {
        let k = kindAtAbs(p, i)
        if isKind2(k, TokKind.eof) { go = false }
        else if isKind2(k, TokKind.lbrace) || isKind2(k, TokKind.lparen) || isKind2(k, TokKind.lbracket) {
            depth = depth + 1
        } else if isKind2(k, TokKind.rbrace) || isKind2(k, TokKind.rparen) || isKind2(k, TokKind.rbracket) {
            depth = depth - 1
            if depth == 0 { go = false }
        } else if depth == 1 && isKind2(k, TokKind.fatArrow) {
            found = true
            go = false
        }
        i = i + 1
    }
    return found
}

func kindAtAbs(_ p: inout Ps, _ i: Int) -> TokKind { let t = p.toks.get(i) ?? eofTok(); return t.kind }
func isKind2(_ a: TokKind, _ b: TokKind) -> Bool { return streq(spelling(a), spelling(b)) }

func parseClosure(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '{'
    var params: Vec[Nd] = Vec.new()
    if !isKind(p, TokKind.fatArrow) {
        if isKind(p, TokKind.identifier) {
            params.push(Nd.ident(curText(p)))
            advP(&p)
            while eat(p, TokKind.comma) {
                if isKind(p, TokKind.identifier) { params.push(Nd.ident(curText(p))); advP(&p) }
            }
        }
    }
    eat(p, TokKind.fatArrow)
    skipNL(&p)
    var body: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        body.push(parseStmt(&p))
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.closureE(params, body)
}

// A match expression. The C++ printer has no MatchExpr case, so it dumps as
// /*?expr*/; we still parse the arms (pattern / guard / body) precisely so the
// surrounding token stream stays aligned, then discard them.
func parseMatch(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'match'
    let scrut = parseExpr(&p)
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var arms: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        if eat(p, TokKind.kwDefault) {
            eat(p, TokKind.colon)
            arms.push(Nd.matchArm(true, Vec.new(), Vec.new(), bE(parseExpr(&p))))
        } else {
            eat(p, TokKind.kwCase)
            let pat = parsePattern(&p)
            var guard: Vec[Nd] = Vec.new()
            if eat(p, TokKind.kwWhere) { guard.push(parseExpr(&p)) }
            eat(p, TokKind.colon)
            arms.push(Nd.matchArm(false, bP(pat), guard, bE(parseExpr(&p))))
        }
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.matchE(bE(scrut), arms)
}

func parseIf(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'if'
    var letName: String = ""
    var letInit: Vec[Nd] = Vec.new()
    var cond: Vec[Nd] = Vec.new()
    if eat(p, TokKind.kwLet) {
        letName = curText(p)
        advP(&p)
        eat(p, TokKind.assign)
        letInit.push(parseExpr(&p))
    } else {
        cond.push(parseExpr(&p))
    }
    let thenB = bE(parseBlock(&p))
    var els: Vec[Nd] = Vec.new()
    if eat(p, TokKind.kwElse) {
        if isKind(p, TokKind.kwIf) { els.push(parsePrimary(&p)) }
        else { els.push(parseBlock(&p)) }
    }
    return Nd.ifE(letName, letInit, cond, thenB, els)
}

func parsePostfix(_ p: inout Ps, _ start: Nd) using Alloc -> Nd {
    var lhs = start
    var go: Bool = true
    while go {
        if isKind(p, TokKind.lparen) {
            advP(&p)
            var args: Vec[Nd] = Vec.new()
            if !isKind(p, TokKind.rparen) {
                args.push(parseArg(&p))
                while eat(p, TokKind.comma) { args.push(parseArg(&p)) }
            }
            eat(p, TokKind.rparen)
            lhs = Nd.call(bE(lhs), args)
        } else if isKind(p, TokKind.dot)
                  || (isKind(p, TokKind.question) && isKindAt(p, 1, TokKind.dot)) {
            let isChain = isKind(p, TokKind.question)
            if isChain { advP(&p) }
            advP(&p)  // '.'
            let n = curText(p)
            advP(&p)
            lhs = Nd.member(bE(lhs), n, isChain)
        } else if isKind(p, TokKind.lbracket) {
            advP(&p)
            var idxs: Vec[Nd] = Vec.new()
            if !isKind(p, TokKind.rbracket) {
                idxs.push(parseExpr(&p))
                while eat(p, TokKind.comma) { idxs.push(parseExpr(&p)) }
            }
            eat(p, TokKind.rbracket)
            lhs = Nd.index(bE(lhs), idxs)
        } else if isKind(p, TokKind.bang) {
            advP(&p)
            lhs = Nd.unary("!", bE(lhs))
        } else {
            go = false
        }
    }
    return lhs
}

func parseArg(_ p: inout Ps) using Alloc -> Nd {
    var label: String = ""
    if isKind(p, TokKind.identifier) && isKindAt(p, 1, TokKind.colon) {
        label = curText(p)
        advP(&p)
        advP(&p)  // ':'
    }
    var isInout: Bool = false
    if eat(p, TokKind.amp) { isInout = true }
    return Nd.arg(label, isInout, bE(parseExpr(&p)))
}

// ----- printer (mirrors src/ast/printer.cpp exactly) ------------------------
func indentTo(_ n: Int) using Log {
    var i: Int = 0
    while i < n { print("    "); i = i + 1 }
}

func printUnit(_ u: NUnit) using Alloc, Log {
    if u.hasMod {
        print("module ")
        print(u.modPath)
        print("\n\n")
    }
    var i: Int = 0
    while i < u.imports.len() {
        printImport(u.imports.get(i) ?? Nd.importD(false, "?"))
        i = i + 1
    }
    if u.imports.len() > 0 { print("\n") }
    var j: Int = 0
    while j < u.decls.len() {
        printDecl(u.decls.get(j) ?? Nd.importD(false, "?"), 0)
        print("\n")
        j = j + 1
    }
}

func printImport(_ d: Nd) using Alloc, Log {
    match d {
        case .importD(let isC, let payload): printImportBody(isC, payload)
        default: print("")
    }
}

func printImportBody(_ isC: Bool, _ payload: String) using Log {
    if isC {
        print("import c \"")
        print(payload)
        print("\"\n")
    } else {
        print("import ")
        print(payload)
        print("\n")
    }
}

func printDecl(_ d: Nd, _ indent: Int) using Alloc, Log {
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body):
            printFunc(vis, mods, name, gens, params, caps, thr, res, body, indent)
        case .structD(let vis, let name, let fields, let methods, let deinitB, let isLinear, let generics):
            printStruct(vis, name, fields, methods, deinitB, indent)
        case .enumD(let vis, let name, let cases, let methods, let generics):
            printEnum(vis, name, cases, methods, indent)
        case .constD(let vis, let name, let ty, let val): printConst(vis, name, ty, val, indent)
        case .staticD(let vis, let name, let ty, let val): printStatic(vis, name, ty, val, indent)
        case .opaqueD(let vis, let name, let under): printOpaque(vis, name, under, indent)
        case .deriveD(let protocols, let target): printDerive(protocols, target, indent)
        default: print("")
    }
}

func printStruct(_ vis: String, _ name: String, _ fields: Vec[Nd], _ methods: Vec[Nd],
                 _ deinitB: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("struct ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < fields.len() {
        printField(fields.get(i) ?? errE(), indent + 1)
        i = i + 1
    }
    var m: Int = 0
    while m < methods.len() {
        printDecl(methods.get(m) ?? errE(), indent + 1)
        m = m + 1
    }
    if deinitB.len() > 0 {
        indentTo(indent + 1)
        print("deinit ")
        printExpr(deinitB.get(0) ?? errE())
        print("\n")
    }
    indentTo(indent)
    print("}\n")
}

func printField(_ f: Nd, _ indent: Int) using Alloc, Log {
    match f {
        case .field(let kind, let name, let ty): printFieldBody(kind, name, ty, indent)
        default: print("")
    }
}

func printFieldBody(_ kind: String, _ name: String, _ ty: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(kind)
    print(name)
    print(": ")
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
    print("\n")
}

func printEnum(_ vis: String, _ name: String, _ cases: Vec[Nd], _ methods: Vec[Nd],
               _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("enum ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < cases.len() {
        printEnumCase(cases.get(i) ?? errE(), indent + 1)
        i = i + 1
    }
    var m: Int = 0
    while m < methods.len() {
        printDecl(methods.get(m) ?? errE(), indent + 1)
        m = m + 1
    }
    indentTo(indent)
    print("}\n")
}

func printEnumCase(_ c: Nd, _ indent: Int) using Alloc, Log {
    match c {
        case .enumCase(let name, let payload): printEnumCaseBody(name, payload, indent)
        default: print("")
    }
}

func printEnumCaseBody(_ name: String, _ payload: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print("case ")
    print(name)
    if payload.len() > 0 {
        print("(")
        var i: Int = 0
        while i < payload.len() {
            if i > 0 { print(", ") }
            printPayElem(payload.get(i) ?? errE())
            i = i + 1
        }
        print(")")
    }
    print("\n")
}

func printPayElem(_ e: Nd) using Alloc, Log {
    match e {
        case .payElem(let label, let ty): printPayElemBody(label, ty)
        default: print("")
    }
}

func printPayElemBody(_ label: String, _ ty: Vec[Nd]) using Alloc, Log {
    if !streq(label, "") {
        print(label)
        print(": ")
    }
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
}

func printFunc(_ vis: String, _ mods: String, _ name: String, _ gens: Vec[Nd], _ params: Vec[Nd], _ caps: Vec[Nd],
               _ thr: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print(mods)
    print("func ")
    print(name)
    printGenerics(gens)
    print("(")
    var i: Int = 0
    while i < params.len() {
        if i > 0 { print(", ") }
        printParam(params.get(i) ?? errParam())
        i = i + 1
    }
    print(")")
    if caps.len() > 0 {
        print(" using ")
        var c: Int = 0
        while c < caps.len() {
            if c > 0 { print(", ") }
            printType(caps.get(c) ?? errT())
            c = c + 1
        }
    }
    if thr.len() > 0 {
        print(" throws(")
        printType(thr.get(0) ?? errT())
        print(")")
    }
    if res.len() > 0 {
        print(" -> ")
        printType(res.get(0) ?? errT())
    }
    if body.len() > 0 {
        print(" ")
        printExpr(body.get(0) ?? errE())
    }
    print("\n")
}

func printConst(_ vis: String, _ name: String, _ ty: Vec[Nd], _ val: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("const ")
    print(name)
    if ty.len() > 0 {
        print(": ")
        printType(ty.get(0) ?? errT())
    }
    print(" = ")
    if val.len() > 0 { printExpr(val.get(0) ?? errE()) }
    print("\n")
}

func printStatic(_ vis: String, _ name: String, _ ty: Vec[Nd], _ val: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("static ")
    print(name)
    print(": ")
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
    print(" = ")
    if val.len() > 0 { printExpr(val.get(0) ?? errE()) }
    print("\n")
}

func printOpaque(_ vis: String, _ name: String, _ under: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("opaque type ")
    print(name)
    print(" = ")
    printType(under.get(0) ?? errT())
    print("\n")
}

func printDerive(_ protocols: Vec[Nd], _ target: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print("derive(")
    var i: Int = 0
    while i < protocols.len() {
        if i > 0 { print(", ") }
        printType(protocols.get(i) ?? errT())
        i = i + 1
    }
    print(") for ")
    printType(target.get(0) ?? errT())
    print("\n")
}

func printGenerics(_ gens: Vec[Nd]) using Alloc, Log {
    if gens.len() == 0 { return }
    print("[")
    var i: Int = 0
    while i < gens.len() {
        if i > 0 { print(", ") }
        printGenericParam(gens.get(i) ?? errT())
        i = i + 1
    }
    print("]")
}

func printGenericParam(_ g: Nd) using Alloc, Log {
    match g {
        case .genConst(let name, let ct): printGenConst(name, ct)
        case .genType(let name, let bounds): printGenType(name, bounds)
        default: print("")
    }
}

func printGenConst(_ name: String, _ ct: Vec[Nd]) using Alloc, Log {
    print("const ")
    print(name)
    print(": ")
    if ct.len() > 0 { printType(ct.get(0) ?? errT()) }
}

func printGenType(_ name: String, _ bounds: Vec[Nd]) using Alloc, Log {
    print(name)
    if bounds.len() > 0 {
        print(": ")
        var i: Int = 0
        while i < bounds.len() {
            if i > 0 { print(" & ") }
            printType(bounds.get(i) ?? errT())
            i = i + 1
        }
    }
}

func errParam() using Alloc -> Nd {
    return Nd.param(false, "", "?", false, "", noT())
}

func printParam(_ pm: Nd) using Alloc, Log {
    match pm {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): printParamBody(lo, lbl, nm, ne, md, ty)
        default: print("")
    }
}

func printParamBody(_ lo: Bool, _ lbl: String, _ nm: String, _ ne: Bool, _ md: String, _ ty: Vec[Nd]) using Alloc, Log {
    if lo {
        print("_ ")
    } else if !streq(lbl, "") && !streq(lbl, nm) {
        print(lbl)
        print(" ")
    }
    print(nm)
    print(": ")
    if ne { print("nonescaping ") }
    print(md)
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
}

func printType(_ t: Nd) using Alloc, Log {
    match t {
        case .named(let path, let hasGen, let args): printNamed(path, hasGen, args)
        case .opt(let inner): printOpt(inner)
        case .someT(let inner): printPrefixType("some ", inner)
        case .dynT(let inner): printPrefixType("dyn ", inner)
        case .vecT(let len, let elem): printVecType(len, elem)
        case .tupleT(let elems): printTupleType(elems)
        case .fnT(let params, let caps, let thr, let res): printFnType(params, caps, thr, res)
        default: print("/*?type*/")
    }
}

func printPrefixType(_ kw: Str, _ inner: Vec[Nd]) using Alloc, Log {
    print(kw)
    printType(inner.get(0) ?? errT())
}

func printVecType(_ len: String, _ elem: Vec[Nd]) using Alloc, Log {
    print("[")
    print(len)
    print("]")
    printType(elem.get(0) ?? errT())
}

func printTypeList(_ ts: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < ts.len() {
        if i > 0 { print(", ") }
        printType(ts.get(i) ?? errT())
        i = i + 1
    }
}

func printTupleType(_ elems: Vec[Nd]) using Alloc, Log {
    print("(")
    printTypeList(elems)
    print(")")
}

func printFnType(_ params: Vec[Nd], _ caps: Vec[Nd], _ thr: Vec[Nd], _ res: Vec[Nd]) using Alloc, Log {
    print("(")
    printTypeList(params)
    print(")")
    if caps.len() > 0 {
        print(" using ")
        printTypeList(caps)
    }
    if thr.len() > 0 {
        print(" throws(")
        printType(thr.get(0) ?? errT())
        print(")")
    }
    if res.len() > 0 {
        print(" -> ")
        printType(res.get(0) ?? errT())
    }
}

func printNamed(_ path: String, _ hasGen: Bool, _ args: Vec[Nd]) using Alloc, Log {
    print(path)
    if hasGen {
        print("[")
        var i: Int = 0
        while i < args.len() {
            if i > 0 { print(", ") }
            printType(args.get(i) ?? errT())
            i = i + 1
        }
        print("]")
    }
}

func printOpt(_ inner: Vec[Nd]) using Alloc, Log {
    printType(inner.get(0) ?? errT())
    print("?")
}

func printBlock(_ stmts: Vec[Nd], _ indent: Int) using Alloc, Log {
    print("{\n")
    var i: Int = 0
    while i < stmts.len() {
        printStmt(stmts.get(i) ?? Nd.exprS(noE()), indent + 1)
        i = i + 1
    }
    indentTo(indent)
    print("}")
}

func printStmt(_ s: Nd, _ indent: Int) using Alloc, Log {
    indentTo(indent)
    match s {
        case .letS(let pat, let ty, let value): printBinding("let ", pat, ty, value)
        case .varS(let pat, let ty, let value): printBinding("var ", pat, ty, value)
        case .exprS(let e): printExprStmt(e)
        case .retS(let v): printReturn(v)
        case .assignS(let op, let t, let v): printAssign(op, t, v)
        case .whileS(let c, let b): printWhile(c, b)
        case .forS(let pat, let iter, let b): printFor(pat, iter, b)
        case .breakS(let label): printBreakContinue("break", label)
        case .continueS(let label): printBreakContinue("continue", label)
        default: print("/*?stmt*/\n")
    }
}

func printFor(_ pat: Vec[Nd], _ iter: Vec[Nd], _ b: Vec[Nd]) using Alloc, Log {
    print("for ")
    printPat(pat.get(0) ?? errP())
    print(" in ")
    printExpr(iter.get(0) ?? errE())
    print(" ")
    printExpr(b.get(0) ?? errE())
    print("\n")
}

func printBreakContinue(_ kw: Str, _ label: String) using Log {
    print(kw)
    if !streq(label, "") {
        print(" ")
        print(label)
    }
    print("\n")
}

func printBinding(_ kw: Str, _ pat: Vec[Nd], _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    print(kw)
    printPat(pat.get(0) ?? errP())
    if ty.len() > 0 {
        print(": ")
        printType(ty.get(0) ?? errT())
    }
    print(" = ")
    if value.len() > 0 { printExpr(value.get(0) ?? errE()) }
    print("\n")
}

func printExprStmt(_ e: Vec[Nd]) using Alloc, Log {
    printExpr(e.get(0) ?? errE())
    print("\n")
}

func printReturn(_ v: Vec[Nd]) using Alloc, Log {
    print("return")
    if v.len() > 0 {
        print(" ")
        printExpr(v.get(0) ?? errE())
    }
    print("\n")
}

func printAssign(_ op: String, _ t: Vec[Nd], _ v: Vec[Nd]) using Alloc, Log {
    printExpr(t.get(0) ?? errE())
    print(" ")
    print(op)
    print(" ")
    printExpr(v.get(0) ?? errE())
    print("\n")
}

func printWhile(_ c: Vec[Nd], _ b: Vec[Nd]) using Alloc, Log {
    print("while ")
    printExpr(c.get(0) ?? errE())
    print(" ")
    printExpr(b.get(0) ?? errE())
    print("\n")
}

func printPat(_ p: Nd) using Alloc, Log {
    match p {
        case .wildcard: print("_")
        case .identP(let n): print(n)
        case .bindP(let n): printBind(n)
        case .litP(let inner): printExpr(inner.get(0) ?? errE())
        case .enumP(let cname, let children): printEnumPat(cname, children)
        default: print("/*?pat*/")
    }
}

func printBind(_ n: String) using Log { print("let "); print(n) }

func printEnumPat(_ cname: String, _ children: Vec[Nd]) using Alloc, Log {
    print(".")
    print(cname)
    if children.len() > 0 {
        print("(")
        var i: Int = 0
        while i < children.len() {
            if i > 0 { print(", ") }
            printPat(children.get(i) ?? errP())
            i = i + 1
        }
        print(")")
    }
}

func printExpr(_ e: Nd) using Alloc, Log {
    match e {
        case .intLit(let t): print(t)
        case .floatLit(let t): print(t)
        case .strLit(let t): printQuoted("\"", t, "\"")
        case .byteStrLit(let t): printQuoted("b\"", t, "\"")
        case .charLit(let t): printQuoted("'", t, "'")
        case .boolLit(let b): printBool(b)
        case .nilLit: print("/*?expr*/")
        case .ident(let n): print(n)
        case .selfE: print("self")
        case .leadingDot(let n): printLeadingDot(n)
        case .paren(let inner): printParen(inner)
        case .unary(let op, let operand): printUnary(op, operand)
        case .binary(let op, let l, let r): printBinary(op, l, r)
        case .call(let callee, let args): printCall(callee, args)
        case .arg(let label, let isInout, let val): printArg(label, isInout, val)
        case .member(let base, let n, let chain): printMember(base, n)
        case .index(let base, let idxs): printIndex(base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): printIf(ln, li, cond, thenB, els)
        case .block(let stmts): printBlock(stmts, 0)
        case .asE(let v, let target, let isOpt): printAs(v, target, isOpt)
        case .addrOf(let inner): print("/*?expr*/")
        case .prefixE(let kw, let inner): printPrefixExpr(kw, inner)
        case .doCatchE(let db, let en, let et, let cb): printDoCatch(db, en, et, cb)
        case .quoteE(let inner): printQuote(inner)
        case .spliceE(let bare, let inner): printSplice(bare, inner)
        default: print("/*?expr*/")
    }
}

func printQuote(_ inner: Vec[Nd]) using Alloc, Log {
    print("quote { ")
    printExpr(inner.get(0) ?? errE())
    print(" }")
}

func printSplice(_ bare: Bool, _ inner: Vec[Nd]) using Alloc, Log {
    print("$")
    if bare {
        printExpr(inner.get(0) ?? errE())
    } else {
        print("(")
        printExpr(inner.get(0) ?? errE())
        print(")")
    }
}

func printPrefixExpr(_ kw: String, _ inner: Vec[Nd]) using Alloc, Log {
    print(kw)
    printExpr(inner.get(0) ?? errE())
}

func printDoCatch(_ db: Vec[Nd], _ en: String, _ et: Vec[Nd], _ cb: Vec[Nd]) using Alloc, Log {
    print("do ")
    printExpr(db.get(0) ?? errE())
    print(" catch (")
    print(en)
    print(": ")
    if et.len() > 0 { printType(et.get(0) ?? errT()) }
    print(") ")
    printExpr(cb.get(0) ?? errE())
}

func printQuoted(_ open: Str, _ t: String, _ close: Str) using Log {
    print(open)
    print(t)
    print(close)
}

func printBool(_ b: Bool) using Log { if b { print("true") } else { print("false") } }
func printLeadingDot(_ n: String) using Log { print("."); print(n) }

func printParen(_ inner: Vec[Nd]) using Alloc, Log {
    print("(")
    printExpr(inner.get(0) ?? errE())
    print(")")
}

func printUnary(_ op: String, _ operand: Vec[Nd]) using Alloc, Log {
    print(op)
    printExpr(operand.get(0) ?? errE())
}

func printBinary(_ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc, Log {
    printExpr(l.get(0) ?? errE())
    print(" ")
    print(op)
    print(" ")
    printExpr(r.get(0) ?? errE())
}

func printCall(_ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log {
    printExpr(callee.get(0) ?? errE())
    print("(")
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        printExpr(args.get(i) ?? errE())
        i = i + 1
    }
    print(")")
}

func printArg(_ label: String, _ isInout: Bool, _ val: Vec[Nd]) using Alloc, Log {
    if !streq(label, "") {
        print(label)
        print(": ")
    }
    if isInout { print("&") }
    printExpr(val.get(0) ?? errE())
}

func printMember(_ base: Vec[Nd], _ n: String) using Alloc, Log {
    printExpr(base.get(0) ?? errE())
    print(".")
    print(n)
}

func printIndex(_ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc, Log {
    printExpr(base.get(0) ?? errE())
    print("[")
    var i: Int = 0
    while i < idxs.len() {
        if i > 0 { print(", ") }
        printExpr(idxs.get(i) ?? errE())
        i = i + 1
    }
    print("]")
}

func printIf(_ ln: String, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print("if ")
    if !streq(ln, "") {
        print("let ")
        print(ln)
        print(" = ")
        if li.len() > 0 { printExpr(li.get(0) ?? errE()) }
    } else if cond.len() > 0 {
        printExpr(cond.get(0) ?? errE())
    }
    print(" ")
    printExpr(thenB.get(0) ?? errE())
    if els.len() > 0 {
        print(" else ")
        printExpr(els.get(0) ?? errE())
    }
}

func printAs(_ v: Vec[Nd], _ target: Vec[Nd], _ isOpt: Bool) using Alloc, Log {
    printExpr(v.get(0) ?? errE())
    if isOpt { print(" as? ") } else { print(" as ") }
    printType(target.get(0) ?? errT())
}


// ===========================================================================
// C++ code emission (phase 4). The generated `.cpp` is:
//
//   // Generated by vestra-transpiler. Do not edit.
//   #include "<stem>.hpp"
//   <blank>
//   <definition> <blank> <definition> <blank> ...
//
// Slice 1 emits free functions: `<retType> <name>(<params>) {` then 4-space
// indented body statements, then `}` and a trailing blank line. Read-mode params
// render as `const <type>& <name>`; the result type maps a builtin scalar to its
// C++ spelling (an absent result is `void`).
// ===========================================================================
func noop() {}

func digitChar(_ d: Int) -> Str {
    return "0123456789".slice(d, d + 1)
}

func intToStr(_ n: Int) using Alloc -> String {
    if n == 0 { return own("0") }
    var rev: Vec[Int] = Vec.new()
    var x: Int = n
    while x > 0 {
        rev.push(x % 10)
        x = x / 10
    }
    var s: String = ""
    var i: Int = rev.len() - 1
    while i >= 0 {
        s.append(digitChar(rev.get(i) ?? 0))
        i = i - 1
    }
    return s
}





func containsSub(_ s: String, _ sub: Str) -> Bool {
    let n = s.len()
    let m = sub.len()
    if m == 0 { return true }
    if m > n { return false }
    var i: Int = 0
    while i + m <= n {
        var j: Int = 0
        var ok: Bool = true
        while ok && j < m {
            if (s.byteAt(i + j) ?? 0) != (sub.byteAt(j) ?? 1) { ok = false }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

func exCalleeNameBoxed(_ callee: Vec[Nd]) using Alloc -> String {
    if callee.len() > 0 { return exCalleeName(callee.get(0) ?? Nd.wildcard) }
    return own("")
}

func exCalleeName(_ callee: Nd) using Alloc -> String {
    return match callee {
        case .ident(let nm): nm
        default: own("")
    }
}

// ===========================================================================
// Type inference (ported from selfhost/sema.vst's type checker). The checking
// functions are unused here; codegen drives the table collection + tyInfer to
// recover expression types for type-directed lowerings (force-unwrap, match,
// payload-enum construction).
// ===========================================================================
struct TyEnv {
    var funcName: Vec[String]   // global: function name ...
    var funcRet: Vec[String]    // ... -> return-type spelling ("Unit" if none) ...
    var funcArity: Vec[Int]     // ... -> declared parameter count
    var pFn: Vec[String]        // global: per-parameter rows — function name ...
    var pIdx: Vec[Int]          // ... parameter index ...
    var pType: Vec[String]      // ... -> parameter type spelling
    var pTyNode: Vec[Nd]        // ... -> parameter type NODE (wildcard if unannotated; for closure-arg lowering)
    var structs: Vec[String]    // global: struct names (construction yields that type)
    var sFldStruct: Vec[String] // global: per-field rows — owning struct ...
    var sFldName: Vec[String]   // ... field name ...
    var sFldType: Vec[String]   // ... -> field type spelling (embeds excluded)
    var mStruct: Vec[String]    // global: per-method rows — owning struct/enum ...
    var mName: Vec[String]      // ... method name ...
    var mRet: Vec[String]       // ... -> result-type spelling ("Unit" if none, "Self"->owner)
    var mpOwner: Vec[String]    // global: per-method-parameter rows — owning struct/enum ...
    var mpName: Vec[String]     // ... method name ...
    var mpIdx: Vec[Int]         // ... parameter index ...
    var mpTyNode: Vec[Nd]       // ... -> parameter type NODE (wildcard if unannotated; for closure-arg lowering)
    var eName: Vec[String]      // global: enum names (a bare `E.case` is a type ref)
    var ecEnum: Vec[String]     // global: per-case rows — owning enum ...
    var ecName: Vec[String]     // ... case name ...
    var ecArity: Vec[Int]       // ... -> payload field count
    var ecfEnum: Vec[String]    // global: per-payload-field rows — owning enum ...
    var ecfCase: Vec[String]    // ... case name ...
    var ecfIdx: Vec[Int]        // ... field index ...
    var ecfName: Vec[String]    // ... -> declared field label ("" if positional)
    var symName: Vec[String]    // per-function: binding name ...
    var symType: Vec[String]    // ... -> type spelling
    var curRet: String          // per-function: enclosing function's result spelling ("Unit" if none)
    var curRetNode: Vec[Nd]     // per-function: the result TYPE node (for emitting the C++ return type, e.g. a match lambda)
    var bad: Vec[String]
}

func tyCheck(_ env: inout TyEnv, _ u: NUnit) using Alloc {
    var i: Int = 0
    while i < u.decls.len() {
        tyCollectDecl(env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    var j: Int = 0
    while j < u.decls.len() {
        tyCheckDecl(env, u.decls.get(j) ?? Nd.wildcard)
        j = j + 1
    }
}

// ----- pass 1: function return types and struct names -----------------------
func tyCollectDecl(_ env: inout TyEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b):
            tyRecordFunc(env, name, params, r)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): tyRecordStructDecl(env, name, fl, m)
        case .enumD(let vis, let name, let cs, let m, let generics): tyRecordEnumDecl(env, name, cs, m)
        default: noop()
    }
}

func tyRecordEnumDecl(_ env: inout TyEnv, _ name: String, _ cases: Vec[Nd], _ methods: Vec[Nd]) using Alloc {
    env.eName.push(name)
    var i: Int = 0
    while i < cases.len() {
        tyRecordCase(env, name, cases.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyRecordMethods(env, name, methods)
}

func tyRecordCase(_ env: inout TyEnv, _ enumName: String, _ c: Nd) using Alloc {
    match c {
        case .enumCase(let cn, let pay): tyPushCaseFields(env, enumName, cn, pay)
        default: noop()
    }
}

func tyPushCaseFields(_ env: inout TyEnv, _ enumName: String, _ cn: String, _ pay: Vec[Nd]) using Alloc {
    tyPushCase(env, enumName, cn, pay.len())
    var i: Int = 0
    while i < pay.len() {
        tyPushCaseField(env, enumName, cn, i, pay.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyPushCaseField(_ env: inout TyEnv, _ enumName: String, _ cn: String, _ idx: Int, _ pe: Nd) using Alloc {
    match pe {
        case .payElem(let label, let ty): tyPushCaseFieldRow(env, enumName, cn, idx, label)
        default: noop()
    }
}

func tyPushCaseFieldRow(_ env: inout TyEnv, _ enumName: String, _ cn: String, _ idx: Int, _ label: String) using Alloc {
    env.ecfEnum.push(enumName)
    env.ecfCase.push(cn)
    env.ecfIdx.push(idx)
    env.ecfName.push(label)
}

func tyPushCase(_ env: inout TyEnv, _ enumName: String, _ cn: String, _ arity: Int) using Alloc {
    env.ecEnum.push(enumName)
    env.ecName.push(cn)
    env.ecArity.push(arity)
}

// The declared label of payload field <idx> of <enum>.<case> — "" when the field
// is positional (or the case is unknown), in which case it lowers to `._<idx>`.
func tyPayFieldName(_ env: inout TyEnv, _ enumName: Str, _ cn: Str, _ idx: Int) using Alloc -> String {
    var i: Int = 0
    while i < env.ecfEnum.len() {
        if let e = env.ecfEnum.get(i) {
            if streq(e, enumName) && (env.ecfIdx.get(i) ?? -1) == idx {
                if let c = env.ecfCase.get(i) {
                    if streq(c, cn) { return env.ecfName.get(i) ?? own("") }
                }
            }
        }
        i = i + 1
    }
    return own("")
}

func tyCaseArity(_ env: inout TyEnv, _ enumName: String, _ cn: String) -> Int {
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let e = env.ecEnum.get(i) {
            if streq(e, enumName) {
                if let c = env.ecName.get(i) {
                    if streq(c, cn) { return env.ecArity.get(i) ?? -1 }
                }
            }
        }
        i = i + 1
    }
    return -1
}

func tyIsEnum(_ env: inout TyEnv, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.eName.len() {
        if let n = env.eName.get(i) {
            if streq(n, name) { return true }
        }
        i = i + 1
    }
    return false
}

func tyEnumHasCase(_ env: inout TyEnv, _ enumName: String, _ caseName: String) -> Bool {
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let e = env.ecEnum.get(i) {
            if streq(e, enumName) {
                if let c = env.ecName.get(i) {
                    if streq(c, caseName) { return true }
                }
            }
        }
        i = i + 1
    }
    return false
}

func tyRecordStructDecl(_ env: inout TyEnv, _ name: String, _ fields: Vec[Nd], _ methods: Vec[Nd]) using Alloc {
    tyRecordStruct(env, name, fields)
    tyRecordMethods(env, name, methods)
}

// Record each user-declared method's result spelling under its owning type. A
// method with its OWN generic parameters is skipped (its result may name a type
// variable we can't resolve) so it stays unknown and tolerated, like a builtin.
func tyRecordMethods(_ env: inout TyEnv, _ owner: String, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        tyRecordMethod(env, owner, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRecordMethod(_ env: inout TyEnv, _ owner: String, _ m: Nd) using Alloc {
    match m {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b):
            tyPushMethod(env, owner, name, g, params, r)
        default: noop()
    }
}

func tyPushMethod(_ env: inout TyEnv, _ owner: String, _ name: String, _ gens: Vec[Nd], _ params: Vec[Nd], _ result: Vec[Nd]) using Alloc {
    if gens.len() > 0 { return }
    env.mStruct.push(owner)
    env.mName.push(name)
    env.mRet.push(tyRetSpelling(result))
    var i: Int = 0
    while i < params.len() {
        tyPushMethodParam(env, owner, name, i, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyPushMethodParam(_ env: inout TyEnv, _ owner: String, _ name: String, _ idx: Int, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): tyPushMethodParamRow(env, owner, name, idx, tyAnnNode(ty))
        default: noop()
    }
}

func tyPushMethodParamRow(_ env: inout TyEnv, _ owner: String, _ name: String, _ idx: Int, _ tn: Nd) using Alloc {
    env.mpOwner.push(owner)
    env.mpName.push(name)
    env.mpIdx.push(idx)
    env.mpTyNode.push(tn)
}

func tyMethodParamTypeNode(_ env: inout TyEnv, _ owner: Str, _ mname: Str, _ idx: Int) using Alloc -> Nd {
    var i: Int = 0
    while i < env.mpOwner.len() {
        if let o = env.mpOwner.get(i) {
            if streq(o, owner) && (env.mpIdx.get(i) ?? -1) == idx {
                if let n = env.mpName.get(i) {
                    if streq(n, mname) { return env.mpTyNode.get(i) ?? Nd.wildcard }
                }
            }
        }
        i = i + 1
    }
    return Nd.wildcard
}

func tyRecordStruct(_ env: inout TyEnv, _ name: String, _ fields: Vec[Nd]) using Alloc {
    env.structs.push(name)
    var i: Int = 0
    while i < fields.len() {
        tyRecordField(env, name, fields.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRecordField(_ env: inout TyEnv, _ structName: String, _ f: Nd) using Alloc {
    match f {
        case .field(let kind, let fname, let fty): tyPushField(env, structName, kind, fname, fty)
        default: noop()
    }
}

// Record a constructible field (`let`/`var`); embeds aren't set by label.
func tyPushField(_ env: inout TyEnv, _ structName: String, _ kind: String, _ fname: String, _ fty: Vec[Nd]) using Alloc {
    if containsSub(kind, "embed") { return }
    env.sFldStruct.push(structName)
    env.sFldName.push(fname)
    env.sFldType.push(tyAnnSpelling(fty))
}

func tyHasField(_ env: inout TyEnv, _ structName: String, _ label: String) -> Bool {
    var i: Int = 0
    while i < env.sFldStruct.len() {
        if let s = env.sFldStruct.get(i) {
            if streq(s, structName) {
                if let fn = env.sFldName.get(i) {
                    if streq(fn, label) { return true }
                }
            }
        }
        i = i + 1
    }
    return false
}

func tyFieldType(_ env: inout TyEnv, _ structName: String, _ label: String) using Alloc -> String {
    var i: Int = 0
    while i < env.sFldStruct.len() {
        if let s = env.sFldStruct.get(i) {
            if streq(s, structName) {
                if let fn = env.sFldName.get(i) {
                    if streq(fn, label) { return env.sFldType.get(i) ?? own("") }
                }
            }
        }
        i = i + 1
    }
    return own("")
}

func tyRecordFunc(_ env: inout TyEnv, _ name: String, _ params: Vec[Nd], _ result: Vec[Nd]) using Alloc {
    env.funcName.push(name)
    if result.len() == 0 { env.funcRet.push("Unit") }
    else { env.funcRet.push(typeSpelling(result.get(0) ?? Nd.wildcard)) }
    env.funcArity.push(params.len())
    var i: Int = 0
    while i < params.len() {
        tyRecordParam(env, name, i, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRecordParam(_ env: inout TyEnv, _ name: String, _ idx: Int, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): tyPushParam(env, name, idx, tyAnnSpelling(ty), tyAnnNode(ty))
        default: noop()
    }
}

func tyAnnNode(_ ty: Vec[Nd]) using Alloc -> Nd {
    return ty.get(0) ?? Nd.wildcard
}

func tyPushParam(_ env: inout TyEnv, _ name: String, _ idx: Int, _ sp: String, _ tn: Nd) using Alloc {
    env.pFn.push(name)
    env.pIdx.push(idx)
    env.pType.push(sp)
    env.pTyNode.push(tn)
}

func tyArity(_ env: inout TyEnv, _ name: String) -> Int {
    var i: Int = 0
    while i < env.funcName.len() {
        if let n = env.funcName.get(i) {
            if streq(n, name) { return env.funcArity.get(i) ?? -1 }
        }
        i = i + 1
    }
    return -1
}

func tyParamType(_ env: inout TyEnv, _ name: String, _ idx: Int) using Alloc -> String {
    var i: Int = 0
    while i < env.pFn.len() {
        if let n = env.pFn.get(i) {
            if streq(n, name) && (env.pIdx.get(i) ?? -1) == idx { return env.pType.get(i) ?? own("") }
        }
        i = i + 1
    }
    return own("")
}

func tyParamTypeNode(_ env: inout TyEnv, _ name: Str, _ idx: Int) using Alloc -> Nd {
    var i: Int = 0
    while i < env.pFn.len() {
        if let n = env.pFn.get(i) {
            if streq(n, name) && (env.pIdx.get(i) ?? -1) == idx { return env.pTyNode.get(i) ?? Nd.wildcard }
        }
        i = i + 1
    }
    return Nd.wildcard
}

func tyFuncRet(_ env: inout TyEnv, _ name: String) using Alloc -> String {
    var i: Int = 0
    while i < env.funcName.len() {
        if let n = env.funcName.get(i) {
            if streq(n, name) { return env.funcRet.get(i) ?? own("") }
        }
        i = i + 1
    }
    return own("")
}

func tyIsStruct(_ env: inout TyEnv, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.structs.len() {
        if let s = env.structs.get(i) {
            if streq(s, name) { return true }
        }
        i = i + 1
    }
    return false
}

// ----- pass 2: per-function walk --------------------------------------------
func tyCheckDecl(_ env: inout TyEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b):
            tyCheckFunc(env, name, params, r, b)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics): tyCheckMethods(env, m)
        case .enumD(let vis, let name, let cs, let m, let generics): tyCheckMethods(env, m)
        case .constD(let vis, let name, let ty, let v): tyCheckConst(env, ty, v)
        default: noop()
    }
}

func tyCheckMethods(_ env: inout TyEnv, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        tyCheckDecl(env, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyCheckFunc(_ env: inout TyEnv, _ name: String, _ params: Vec[Nd], _ result: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    env.curRet = tyRetSpelling(result)
    tyResetSyms(env)
    tyRegisterParams(env, params)
    tyBoxed(env, body)
    tyCheckBodyProduces(env, name, body)
}

func tyRetSpelling(_ result: Vec[Nd]) using Alloc -> String {
    if result.len() == 0 { return own("Unit") }
    return typeSpelling(result.get(0) ?? Nd.wildcard)
}

// §10/§17 — when the body's trailing expression is present and its type is not
// assignable to the declared (non-Unit) result, the implicit return is wrong.
// A body ending in a non-expression statement (let / return / ...) produces Unit
// and is tolerated (an explicit return we don't flow-check).
func tyCheckBodyProduces(_ env: inout TyEnv, _ name: String, _ body: Vec[Nd]) using Alloc {
    if streq(env.curRet, "") || streq(env.curRet, "Unit") { return }
    let bt = tyBodyType(env, body)
    if streq(bt, "") || streq(bt, "Unit") { return }
    if !tyAssignable(bt, env.curRet) { env.bad.push(tyBodyMsg(name, env.curRet, bt)) }
}

func tyBodyType(_ env: inout TyEnv, _ body: Vec[Nd]) using Alloc -> String {
    if body.len() == 0 { return own("Unit") }
    return tyBlockLastType(env, body.get(0) ?? Nd.wildcard)
}

func tyBlockLastType(_ env: inout TyEnv, _ blk: Nd) using Alloc -> String {
    return match blk {
        case .block(let stmts): tyLastStmtType(env, stmts)
        default: own("Unit")
    }
}

func tyLastStmtType(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc -> String {
    if stmts.len() == 0 { return own("Unit") }
    return tyStmtType(env, stmts.get(stmts.len() - 1) ?? Nd.wildcard)
}

func tyStmtType(_ env: inout TyEnv, _ s: Nd) using Alloc -> String {
    return match s {
        case .exprS(let e): tyInferBoxed(env, e)
        default: own("Unit")
    }
}

func tyResetSyms(_ env: inout TyEnv) using Alloc {
    while env.symName.len() > 0 { let _ = env.symName.pop() }
    while env.symType.len() > 0 { let _ = env.symType.pop() }
}

func tyRegisterParams(_ env: inout TyEnv, _ params: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < params.len() {
        tyRegisterParam(env, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRegisterParam(_ env: inout TyEnv, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): tyAddSym(env, nm, ty)
        default: noop()
    }
}

// Register a binding's type from its annotation (empty annotation => untracked).
func tyAddSym(_ env: inout TyEnv, _ name: String, _ ty: Vec[Nd]) using Alloc {
    let sp = tyAnnSpelling(ty)
    if !streq(sp, "") {
        env.symName.push(name)
        env.symType.push(sp)
    }
}

func tySymType(_ env: inout TyEnv, _ name: String) using Alloc -> String {
    var i: Int = 0
    while i < env.symName.len() {
        if let n = env.symName.get(i) {
            if streq(n, name) { return env.symType.get(i) ?? own("") }
        }
        i = i + 1
    }
    return own("")
}

func tyCheckConst(_ env: inout TyEnv, _ ty: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    let ann = tyAnnSpelling(ty)
    if streq(ann, "") { return }
    let vt = tyInferBoxed(env, v)
    if !tyAssignable(vt, ann) { env.bad.push(tyConstMsg(vt, ann)) }
}

// ----- statement / expression walk (find every let/var, check initializers) -
func tyBoxed(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { tyExpr(env, v.get(0) ?? Nd.wildcard) }
}

func tyPair(_ env: inout TyEnv, _ a: Vec[Nd], _ b: Vec[Nd]) using Alloc {
    tyBoxed(env, a)
    tyBoxed(env, b)
}

func tyExpr(_ env: inout TyEnv, _ e: Nd) using Alloc {
    match e {
        case .call(let callee, let args): tyExprCall(env, callee, args)
        case .prefixE(let kw, let inner): tyBoxed(env, inner)
        case .paren(let x): tyBoxed(env, x)
        case .unary(let op, let x): tyUnary(env, op, x)
        case .binary(let op, let l, let r): tyBinary(env, op, l, r)
        case .member(let base, let n, let c): tyMember(env, base, n, c)
        case .index(let base, let idxs): tyIndex(env, base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): tyIf(env, li, cond, thenB, els)
        case .block(let stmts): tyBlock(env, stmts)
        case .asE(let v, let t, let o): tyBoxed(env, v)
        case .addrOf(let x): tyBoxed(env, x)
        case .arg(let l, let io, let v): tyBoxed(env, v)
        case .throwE(let inner): tyBoxed(env, inner)
        case .matchE(let scrut, let arms): tyMatch(env, scrut, arms)
        case .doCatchE(let db, let en, let et, let cb): tyPair(env, db, cb)
        default: noop()
    }
}

// Walk a match: descend the scrutinee and every arm body, and require each arm's
// `where` guard to be Bool. (Pattern-bound variables type as unknown here and are
// tolerated; arm-result-type unification is a later slice.)
func tyMatch(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    tyBoxed(env, scrut)
    var i: Int = 0
    while i < arms.len() {
        tyArm(env, arms.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyCheckArmPatterns(env, scrut, arms)
    tyCheckExhaustive(env, scrut, arms)
    tyCheckArmTypes(env, arms)
}

// Validate each arm pattern against the scrutinee type: an enum-case pattern on a
// non-enum scrutinee; a payload-binding count that disagrees with the case; and a
// literal pattern whose type does not match the scrutinee. (An unknown scrutinee
// type is tolerated; default / catch-all arms carry no pattern.)
func tyCheckArmPatterns(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    let st = tyInferBoxed(env, scrut)
    if streq(st, "") { return }
    var i: Int = 0
    while i < arms.len() {
        tyCheckArmPattern(env, st, arms.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyCheckArmPattern(_ env: inout TyEnv, _ st: String, _ a: Nd) using Alloc {
    match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyCheckPatBoxed(env, st, pat)
        default: noop()
    }
}

func tyCheckPatBoxed(_ env: inout TyEnv, _ st: String, _ pat: Vec[Nd]) using Alloc {
    if pat.len() > 0 { tyCheckPatNode(env, st, pat.get(0) ?? Nd.wildcard) }
}

func tyCheckPatNode(_ env: inout TyEnv, _ st: String, _ p: Nd) using Alloc {
    match p {
        case .enumP(let cn, let children): tyCheckEnumPat(env, st, cn, children)
        case .litP(let inner): tyCheckLitPat(env, st, inner)
        case .orP(let alts): tyCheckAltPats(env, st, alts)
        default: noop()
    }
}

func tyCheckAltPats(_ env: inout TyEnv, _ st: String, _ alts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < alts.len() {
        tyCheckPatNode(env, st, alts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyCheckEnumPat(_ env: inout TyEnv, _ st: String, _ cn: String, _ children: Vec[Nd]) using Alloc {
    if !tyIsEnum(env, st) { env.bad.push(tyEnumPatNonEnumMsg(cn, st)); return }
    let arity = tyCaseArity(env, st, cn)
    if arity >= 0 && children.len() != arity { env.bad.push(tyPayloadArityMsg(cn, arity, children.len())) }
}

func tyCheckLitPat(_ env: inout TyEnv, _ st: String, _ inner: Vec[Nd]) using Alloc {
    let lt = tyInferBoxed(env, inner)
    if streq(lt, "") { return }
    if !tyAssignable(lt, st) && !tyAssignable(st, lt) { env.bad.push(tyLitScrutMsg(lt, st)) }
}

func tyEnumPatNonEnumMsg(_ cn: String, _ st: String) using Alloc -> String {
    var s: String = "enum pattern '."
    s.append(cn)
    s.append("' used against non-enum type ")
    s.append(st)
    return s
}

func tyPayloadArityMsg(_ cn: String, _ arity: Int, _ binds: Int) using Alloc -> String {
    var s: String = "case '"
    s.append(cn)
    s.append("' has ")
    s.append(intToStr(arity))
    s.append(" payload field(s), pattern binds ")
    s.append(intToStr(binds))
    return s
}

func tyLitScrutMsg(_ lt: String, _ st: String) using Alloc -> String {
    var s: String = "literal of type "
    s.append(lt)
    s.append(" does not match scrutinee of type ")
    s.append(st)
    return s
}

// The arm bodies must share one type. The first arm with a known type sets the
// baseline; a later arm whose known type is incompatible reports
// "match arms have different types: <baseline> vs <arm>", after which the
// baseline becomes the error type so every following known arm reports
// "<error> vs <arm>" (mirroring the resolver's cascade). Arms whose body type is
// unknown are skipped. NB this unifies the arms among themselves (no expected
// type is threaded in), so it matches the resolver only where the match has no
// expected type, e.g. an unannotated `let x = match …`.
func tyCheckArmTypes(_ env: inout TyEnv, _ arms: Vec[Nd]) using Alloc {
    var unified: String = ""
    var errored: Bool = false
    var i: Int = 0
    while i < arms.len() {
        let t = tyArmBodyType(env, arms.get(i) ?? Nd.wildcard)
        if !streq(t, "") {
            if errored {
                env.bad.push(tyArmDiffMsg("<error>", t))
            } else if streq(unified, "") {
                unified = own(t)
            } else if !tyArmCompatible(unified, t) {
                env.bad.push(tyArmDiffMsg(unified, t))
                errored = true
            }
        }
        i = i + 1
    }
}

func tyArmBodyType(_ env: inout TyEnv, _ a: Nd) using Alloc -> String {
    return match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyInferBoxed(env, body)
        default: own("")
    }
}

func tyArmCompatible(_ a: String, _ b: String) using Alloc -> Bool {
    return tyAssignable(a, b) || tyAssignable(b, a)
}

func tyArmDiffMsg(_ x: Str, _ y: Str) using Alloc -> String {
    var s: String = "match arms have different types: "
    s.append(x)
    s.append(" vs ")
    s.append(y)
    return s
}

// When the scrutinee is a known enum and no arm is a catch-all (a `default` or a
// `_` wildcard), every case must be covered by some arm's pattern, else
// "match is not exhaustive: case '<c>' is not covered" — one per uncovered case,
// in declaration order. Guards do not affect coverage (matching the resolver).
func tyCheckExhaustive(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    let st = tyInferBoxed(env, scrut)
    if !tyIsEnum(env, st) { return }
    if tyHasCatchAll(arms) { return }
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let e = env.ecEnum.get(i) {
            if streq(e, st) {
                if let cn = env.ecName.get(i) {
                    if !tyArmsCover(arms, cn) { env.bad.push(notExhaustiveMsg(cn)) }
                }
            }
        }
        i = i + 1
    }
}

func tyHasCatchAll(_ arms: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < arms.len() {
        if tyArmIsCatchAll(arms.get(i) ?? Nd.wildcard) { return true }
        i = i + 1
    }
    return false
}

func tyArmIsCatchAll(_ a: Nd) -> Bool {
    return match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyDefaultOrWild(isDef, pat)
        default: false
    }
}

func tyDefaultOrWild(_ isDef: Bool, _ pat: Vec[Nd]) -> Bool {
    if isDef { return true }
    if pat.len() == 0 { return false }
    return tyPatIsWild(pat.get(0) ?? Nd.wildcard)
}

func tyPatIsWild(_ p: Nd) -> Bool {
    return match p {
        case .wildcard: true
        default: false
    }
}

func tyArmsCover(_ arms: Vec[Nd], _ caseName: String) -> Bool {
    var i: Int = 0
    while i < arms.len() {
        if tyArmCovers(arms.get(i) ?? Nd.wildcard, caseName) { return true }
        i = i + 1
    }
    return false
}

func tyArmCovers(_ a: Nd, _ caseName: String) -> Bool {
    return match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyPatBoxedCovers(pat, caseName)
        default: false
    }
}

func tyPatBoxedCovers(_ pat: Vec[Nd], _ caseName: String) -> Bool {
    if pat.len() == 0 { return false }
    return tyPatCoversCase(pat.get(0) ?? Nd.wildcard, caseName)
}

func tyPatCoversCase(_ p: Nd, _ caseName: String) -> Bool {
    return match p {
        case .enumP(let cn, let ch): streq(cn, caseName)
        case .orP(let alts): tyAltsCover(alts, caseName)
        default: false
    }
}

func tyAltsCover(_ alts: Vec[Nd], _ caseName: String) -> Bool {
    var i: Int = 0
    while i < alts.len() {
        if tyPatCoversCase(alts.get(i) ?? Nd.wildcard, caseName) { return true }
        i = i + 1
    }
    return false
}

func notExhaustiveMsg(_ caseName: String) using Alloc -> String {
    var s: String = "match is not exhaustive: case '"
    s.append(caseName)
    s.append("' is not covered")
    return s
}

func tyArm(_ env: inout TyEnv, _ a: Nd) using Alloc {
    match a {
        case .matchArm(let isDefault, let pat, let guard, let body): tyArmParts(env, guard, body)
        default: noop()
    }
}

func tyArmParts(_ env: inout TyEnv, _ guard: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    tyBoxed(env, body)
    if guard.len() > 0 {
        let gt = tyInferBoxed(env, guard)
        if !streq(gt, "") && !streq(gt, "Bool") { env.bad.push(tyGuardMsg(gt)) }
    }
}

func tyGuardMsg(_ got: String) using Alloc -> String {
    var s: String = "match guard must be Bool, got "
    s.append(got)
    return s
}

func tyExprCall(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    tyBoxed(env, callee)
    var i: Int = 0
    while i < args.len() {
        tyExpr(env, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyCheckCallArgs(env, callee, args)
}

// A call to a known user function must supply the right arity, and each argument
// must be assignable to its parameter. Calls to builtins / methods / struct
// constructors (no entry in funcName) are left to later slices.
func tyCheckCallArgs(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    let fname = exCalleeNameBoxed(callee)
    let arity = tyArity(env, fname)
    if arity >= 0 {
        if arity != args.len() {
            env.bad.push(tyArityMsg(arity, args.len()))
            return
        }
        var i: Int = 0
        while i < args.len() {
            tyCheckArg(env, fname, i, args.get(i) ?? Nd.wildcard)
            i = i + 1
        }
        return
    }
    if tyIsStruct(env, fname) { tyCheckCtor(env, fname, args) }
}

// §6 struct construction: each labeled argument must name a field whose type
// accepts the value, and every (non-embed) field must be supplied. (Non-generic,
// non-union structs only; generics are dropped from the AST and unions are rare.)
func tyCheckCtor(_ env: inout TyEnv, _ structName: String, _ args: Vec[Nd]) using Alloc {
    var seen: Vec[String] = Vec.new()
    var i: Int = 0
    while i < args.len() {
        tyCtorArg(env, structName, i, args.get(i) ?? Nd.wildcard, seen)
        i = i + 1
    }
    tyCtorMissing(env, structName, seen)
}

func tyCtorArg(_ env: inout TyEnv, _ structName: String, _ idx: Int, _ a: Nd, _ seen: inout Vec[String]) using Alloc {
    match a {
        case .arg(let label, let isInout, let val): tyCtorArgLabeled(env, structName, idx, label, val, seen)
        default: noop()
    }
}

func tyCtorArgLabeled(_ env: inout TyEnv, _ structName: String, _ idx: Int, _ label: String, _ val: Vec[Nd], _ seen: inout Vec[String]) using Alloc {
    if streq(label, "") { env.bad.push(tyCtorLabelMsg(idx + 1)); return }
    if !tyHasField(env, structName, label) { env.bad.push(tyNoFieldMsg(structName, label)); return }
    let ft = tyFieldType(env, structName, label)
    let at = tyInferBoxed(env, val)
    if !tyAssignable(at, ft) { env.bad.push(tyFieldMsg(label, ft, at)) }
    seen.push(label)
}

func tyCtorMissing(_ env: inout TyEnv, _ structName: String, _ seen: inout Vec[String]) using Alloc {
    var i: Int = 0
    while i < env.sFldStruct.len() {
        tyCtorMissingField(env, structName, i, seen)
        i = i + 1
    }
}

func tyCtorMissingField(_ env: inout TyEnv, _ structName: String, _ i: Int, _ seen: inout Vec[String]) using Alloc {
    if let s = env.sFldStruct.get(i) {
        if streq(s, structName) {
            if let fn = env.sFldName.get(i) {
                if !tyContains(seen, fn) { env.bad.push(tyMissingMsg(structName, fn)) }
            }
        }
    }
}

func tyContains(_ v: inout Vec[String], _ s: String) -> Bool {
    var i: Int = 0
    while i < v.len() {
        if let e = v.get(i) {
            if streq(e, s) { return true }
        }
        i = i + 1
    }
    return false
}

func tyCheckArg(_ env: inout TyEnv, _ fname: String, _ idx: Int, _ a: Nd) using Alloc {
    match a {
        case .arg(let label, let isInout, let val): tyCheckArgVal(env, fname, idx, val)
        default: noop()
    }
}

func tyCheckArgVal(_ env: inout TyEnv, _ fname: String, _ idx: Int, _ val: Vec[Nd]) using Alloc {
    let at = tyInferBoxed(env, val)
    let pt = tyParamType(env, fname, idx)
    if !tyAssignable(at, pt) { env.bad.push(tyArgMsg(idx + 1, at, pt)) }
}

func tyIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    tyBoxed(env, base)
    var i: Int = 0
    while i < idxs.len() {
        tyExpr(env, idxs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyCheckIndex(env, base, idxs)
}

// §18.5 — every index must be integer-typed, then a known base that is not a
// Vec/Span/MutSpan is not indexable. (Mirrors the resolver: indices first, then
// the base shape; an unknown base is tolerated.)
func tyCheckIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < idxs.len() {
        tyCheckIndexExpr(env, idxs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    let bt = tyInferBoxed(env, base)
    if !streq(bt, "") && !tyIsIndexable(bt) { env.bad.push(tyNotIndexableMsg(bt)) }
}

func tyCheckIndexExpr(_ env: inout TyEnv, _ idx: Nd) using Alloc {
    let it = tyInfer(env, idx)
    if !streq(it, "") && !tyIsInt(it) { env.bad.push(tyIndexIntMsg(it)) }
}

func tyIndexIntMsg(_ got: String) using Alloc -> String {
    var s: String = "index must be integer-typed, got "
    s.append(got)
    return s
}

func tyNotIndexableMsg(_ bt: String) using Alloc -> String {
    var s: String = "type "
    s.append(bt)
    s.append(" is not indexable")
    return s
}

// Member access: descend into the base, then check enum-case access. `E.case`
// where `E` names an enum (and is a type ref, not a value binding) must name a
// real case of `E`. Value member access (`x.field` / `x.method()`) is handled by
// inference; a `?.` chain is tolerated.
func tyMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String, _ chain: Bool) using Alloc {
    tyBoxed(env, base)
    if chain { return }
    tyCheckEnumCase(env, base, name)
}

func tyCheckEnumCase(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String) using Alloc {
    let bn = exCalleeNameBoxed(base)               // base ident name, or "" if not a bare ident
    if streq(bn, "") { return }
    if !streq(tySymType(env, bn), "") { return }   // a value binding shadows: not a type ref
    if !tyIsEnum(env, bn) { return }
    if !tyEnumHasCase(env, bn, name) { env.bad.push(tyNoCaseMsg(bn, name)) }
}

func tyNoCaseMsg(_ enumName: String, _ caseName: String) using Alloc -> String {
    var s: String = "enum '"
    s.append(enumName)
    s.append("' has no case '")
    s.append(caseName)
    s.append("'")
    return s
}

func tyIf(_ env: inout TyEnv, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc {
    tyCheckCond(env, cond, "if")
    tyBoxed(env, cond)
    tyBoxed(env, li)
    tyBoxed(env, thenB)
    tyBoxed(env, els)
}

// §10 — an `if`/`while` condition must be Bool. (An `if let` has no `cond`, so
// the empty-condition case is skipped; an unknown-typed condition is tolerated.)
func tyCheckCond(_ env: inout TyEnv, _ cond: Vec[Nd], _ kind: Str) using Alloc {
    if cond.len() == 0 { return }
    let ct = tyInferBoxed(env, cond)
    if !streq(ct, "") && !streq(ct, "Bool") { env.bad.push(tyCondMsg(kind, ct)) }
}

func tyCondMsg(_ kind: Str, _ got: String) using Alloc -> String {
    var s: String = own(kind)
    s.append(" condition must be Bool, got ")
    s.append(got)
    return s
}

func tyWhile(_ env: inout TyEnv, _ cond: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    tyCheckCond(env, cond, "while")
    tyBoxed(env, cond)
    tyBoxed(env, body)
}

func tyBlock(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < stmts.len() {
        tyStmt(env, stmts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyStmt(_ env: inout TyEnv, _ s: Nd) using Alloc {
    match s {
        case .letS(let p, let ty, let v): tyLet(env, p, ty, v)
        case .varS(let p, let ty, let v): tyLet(env, p, ty, v)
        case .exprS(let e): tyBoxed(env, e)
        case .retS(let v): tyRet(env, v)
        case .assignS(let op, let t, let v): tyAssign(env, t, v)
        case .whileS(let c, let b): tyWhile(env, c, b)
        case .forS(let pp, let it, let b): tyPair(env, it, b)
        case .withS(let caps, let names, let vals, let body): tyWith(env, vals, body)
        default: noop()
    }
}

// `let`/`var`: if annotated, the initializer must be assignable to it; then walk
// the value for any nested bindings, and register this one for later idents.
func tyLet(_ env: inout TyEnv, _ pat: Vec[Nd], _ ty: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    let ann = tyAnnSpelling(ty)
    if !streq(ann, "") {
        let vt = tyInferBoxed(env, v)
        if !tyAssignable(vt, ann) { env.bad.push(tyInitMsg(vt, ann)) }
    }
    tyBoxed(env, v)
    tyRegisterPat(env, pat, ty)
}

// Assignment (incl. compound ops, which the resolver checks identically): the
// value must be assignable to the target. Only ident targets type to a known
// slot here; member/index targets are unknown and tolerated.
func tyAssign(_ env: inout TyEnv, _ t: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    tyBoxed(env, t)
    tyBoxed(env, v)
    let lt = tyInferBoxed(env, t)
    let rt = tyInferBoxed(env, v)
    if streq(lt, "") || streq(rt, "") { return }
    if !tyAssignable(rt, lt) { env.bad.push(tyAssignMsg(rt, lt)) }
}

func tyAssignMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "cannot assign value of type "
    s.append(from)
    s.append(" to target of type ")
    s.append(to)
    return s
}

// `return EXPR`: walk the value (nested checks), then its type must be assignable
// to the enclosing function's declared result. A bare `return` produces Unit.
func tyRet(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc {
    tyBoxed(env, v)
    if streq(env.curRet, "") { return }
    var rt: String = own("Unit")
    if v.len() > 0 { rt = tyInferBoxed(env, v) }
    if !tyAssignable(rt, env.curRet) { env.bad.push(tyReturnMsg(rt, env.curRet)) }
}

func tyWith(_ env: inout TyEnv, _ vals: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < vals.len() {
        tyExpr(env, vals.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyBoxed(env, body)
}

func tyRegisterPat(_ env: inout TyEnv, _ pat: Vec[Nd], _ ty: Vec[Nd]) using Alloc {
    if pat.len() > 0 { tyRegisterPatE(env, pat.get(0) ?? Nd.wildcard, ty) }
}

func tyRegisterPatE(_ env: inout TyEnv, _ p: Nd, _ ty: Vec[Nd]) using Alloc {
    match p {
        case .identP(let n): tyAddSym(env, n, ty)
        case .bindP(let n): tyAddSym(env, n, ty)
        default: noop()
    }
}

// ----- inference ------------------------------------------------------------
func tyInferBoxed(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc -> String {
    if v.len() > 0 { return tyInfer(env, v.get(0) ?? Nd.wildcard) }
    return own("")
}

func tyInfer(_ env: inout TyEnv, _ e: Nd) using Alloc -> String {
    return match e {
        case .intLit(let s): own("Int")
        case .floatLit(let s): own("Float64")
        case .boolLit(let b): own("Bool")
        case .charLit(let s): own("Char")
        case .strLit(let s): own("StrConst")
        case .ident(let n): tySymType(env, n)
        case .paren(let inner): tyInferBoxed(env, inner)
        case .call(let callee, let args): tyInferCall(env, callee)
        case .binary(let op, let l, let r): tyInferBinary(env, op, l, r)
        case .unary(let op, let x): tyInferUnary(env, op, x)
        case .member(let base, let name, let chain): tyInferMember(env, base, name, chain)
        case .index(let base, let idxs): tyInferIndex(env, base, idxs)
        case .vecLit(let elems): tyInferVecLit(env, elems)
        case .matchE(let scrut, let arms): tyInferMatch(env, scrut, arms)
        case .interpE(let parts, let exprs): own("String")
        default: own("")
    }
}

// A match expression types as its first known-typed arm body — the same baseline
// tyCheckArmTypes unifies the remaining arms against. Pattern-bound payload
// names are unknown to the symbol table, so a payload arm's body may stay
// unknown; an annotated binding supplies the type in that case.
func tyInferMatch(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc -> String {
    var i: Int = 0
    while i < arms.len() {
        let t = tyArmBodyType(env, arms.get(i) ?? Nd.wildcard)
        if !streq(t, "") { return t }
        i = i + 1
    }
    return own("")
}

// An array literal `[e1, ...]` types as `[N]T`, where N is the element count and
// T is the FIRST element's type (vestra does not unify the rest); the spelling
// nests, so `[[1,2],[3,4]]` -> `[2][2]Int`. An empty literal or an unknown first
// element stays unknown so the value is tolerated rather than mis-flagged.
func tyInferVecLit(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc -> String {
    if elems.len() == 0 { return own("") }
    let et = tyInfer(env, elems.get(0) ?? Nd.wildcard)
    if streq(et, "") { return own("") }
    var s: String = "["
    s.append(intToStr(elems.len()))
    s.append("]")
    s.append(et)
    return s
}

// Indexing a Vec[T] / Span[T] / MutSpan[T] yields its element T; other bases stay
// unknown (arrays spell empty here, and non-indexables type as unknown anyway).
func tyInferIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc -> String {
    let bt = tyInferBoxed(env, base)
    if tyIsIndexable(bt) { return tyBracketInner(bt) }
    if tyIsArray(bt) { return tyArrayElem(bt) }
    return own("")
}

func tyIsIndexable(_ s: String) -> Bool {
    return tyStartsWith(s, "Vec[") || tyStartsWith(s, "Span[") || tyStartsWith(s, "MutSpan[")
}

func tyStartsWith(_ s: String, _ prefix: Str) -> Bool {
    let pn = prefix.len()
    if pn > s.len() { return false }
    var i: Int = 0
    while i < pn {
        if (s.byteAt(i) ?? 0) != (prefix.byteAt(i) ?? 1) { return false }
        i = i + 1
    }
    return true
}

// "Vec[Int32]" -> "Int32" (the text between the first '[' and the trailing ']',
// so a nested element like "HashMap[Int32, Str]" comes back whole).
func tyBracketInner(_ s: String) using Alloc -> String {
    let n = s.len()
    if n < 2 || (s.byteAt(n - 1) ?? 0) != 93 { return own("") }   // ']' == 93
    var open: Int = -1
    var i: Int = 0
    while i < n {
        if (s.byteAt(i) ?? 0) == 91 { open = i; i = n }           // first '[' == 91
        else { i = i + 1 }
    }
    if open < 0 { return own("") }
    return own(s.slice(open + 1, n - 1))
}

// `base.field` types as the field's declared type when `base` is a known struct
// and `field` is one of its fields; a `?.` chain (optional result) and anything
// else stay unknown. Nested access (`a.b.c`) falls out of the recursion.
func tyInferMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String, _ chain: Bool) using Alloc -> String {
    if chain { return own("") }
    let bt = tyInferBoxed(env, base)
    if tyHasField(env, bt, name) { return tyFieldType(env, bt, name) }
    return own("")
}

// A binary expression's type, mirroring the resolver's result types (and its
// "error type on failure" so a mis-typed operator suppresses downstream checks):
// comparisons -> Bool when the operands match (else unknown); logical -> Bool
// when both Bool; arithmetic/bitwise -> the operand type with the §17 sized
// operand winning (`Int32 + Int` -> Int32), or unknown when the operand rule is
// violated. Unknown operands stay permissive so a partly-inferred condition is
// tolerated. Other operators (??, ranges) are unknown.
func tyInferBinary(_ env: inout TyEnv, _ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc -> String {
    let lt = tyInferBoxed(env, l)
    let rt = tyInferBoxed(env, r)
    if isCmpOp(op) { return tyCmpResult(lt, rt) }
    if isLogOp(op) { return tyLogResult(lt, rt) }
    if isArithOp(op) { return tyNumResult(lt, rt, false) }
    if isBitOp(op) { return tyNumResult(lt, rt, true) }
    if streq(op, "??") { return tyUnwrapOpt(lt) }
    return own("")
}

// §9 `lhs ?? rhs` yields the wrapped element T when lhs is a known Optional
// `T?`; an lhs of any other (or unknown) type stays unknown, mirroring the
// resolver's error type when the left operand is not an Optional.
func tyUnwrapOpt(_ s: String) using Alloc -> String {
    let n = s.len()
    if n > 0 && (s.byteAt(n - 1) ?? 0) == 63 { return own(s.slice(0, n - 1)) }   // '?' == 63
    return own("")
}

func tyCmpResult(_ lt: String, _ rt: String) using Alloc -> String {
    if streq(lt, "") || streq(rt, "") { return own("Bool") }
    if tyReqMatch(lt, rt) { return own("Bool") }
    return own("")
}

func tyLogResult(_ lt: String, _ rt: String) using Alloc -> String {
    if streq(lt, "") || streq(rt, "") { return own("Bool") }
    if streq(lt, "Bool") && streq(rt, "Bool") { return own("Bool") }
    return own("")
}

func tyNumResult(_ lt: String, _ rt: String, _ needInt: Bool) using Alloc -> String {
    if streq(lt, "") || streq(rt, "") { return own("") }
    var lok: Bool = tyIsNumeric(lt)
    if needInt { lok = tyIsInt(lt) }
    if !lok { return own("") }
    if !tyReqMatch(lt, rt) { return own("") }
    if streq(lt, "Int") || streq(lt, "UInt") { return rt }
    return lt
}

// The self-host AST spells both prefix logical-not `!x` and postfix force-unwrap
// `x!` as `unary("!", _)`, so they are told apart by the operand: an Optional
// `T?` operand is a force-unwrap yielding T (§9), anything else is logical-not
// yielding Bool. `-x` carries a numeric operand through, `~x` an integer one;
// a constraint violation yields the error type ("") so it doesn't cascade.
func tyInferUnary(_ env: inout TyEnv, _ op: String, _ x: Vec[Nd]) using Alloc -> String {
    let xt = tyInferBoxed(env, x)
    if streq(op, "!") {
        if (xt.byteAt(xt.len() - 1) ?? 0) == 63 { return tyUnwrapOpt(xt) }   // T? -> T
        return own("Bool")
    }
    if streq(xt, "") { return own("") }                   // unknown operand: stay permissive
    if streq(op, "-") { if tyIsNumeric(xt) { return own(xt) }; return own("") }
    if streq(op, "~") { if tyIsInt(xt) { return own(xt) }; return own("") }
    return own(xt)
}

func isCmpOp(_ op: String) -> Bool {
    return streq(op, "==") || streq(op, "!=") || streq(op, "<") || streq(op, "<=")
        || streq(op, ">") || streq(op, ">=")
}

func isLogOp(_ op: String) -> Bool {
    return streq(op, "&&") || streq(op, "||")
}

func isArithOp(_ op: String) -> Bool {
    return streq(op, "+") || streq(op, "-") || streq(op, "*") || streq(op, "/")
        || streq(op, "%") || streq(op, "&*") || streq(op, "&+") || streq(op, "&-")
}

func isBitOp(_ op: String) -> Bool {
    return streq(op, "<<") || streq(op, ">>") || streq(op, "&") || streq(op, "^") || streq(op, "|")
}

func tyIsNumeric(_ s: String) -> Bool {
    return tyIsInt(s) || streq(s, "Float32") || streq(s, "Float64")
}

// The resolver's require_match: operands match when they are equal, or both
// integers where one assigns to the other (the §17 natural-width rule).
func tyReqMatch(_ lt: String, _ rt: String) using Alloc -> Bool {
    if streq(lt, rt) { return true }
    if tyIsInt(lt) && tyIsInt(rt) && (tyAssignable(lt, rt) || tyAssignable(rt, lt)) { return true }
    return false
}

// ----- binary operator constraints ------------------------------------------
func tyBinary(_ env: inout TyEnv, _ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc {
    tyBoxed(env, l)
    tyBoxed(env, r)
    tyCheckBinOp(env, op, l, r)
}

func tyCheckBinOp(_ env: inout TyEnv, _ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc {
    let lt = tyInferBoxed(env, l)
    let rt = tyInferBoxed(env, r)
    if streq(lt, "") || streq(rt, "") { return }
    if isLogOp(op) {
        if !streq(lt, "Bool") || !streq(rt, "Bool") { env.bad.push(tyLogMsg()) }
    } else if isArithOp(op) {
        if !tyIsNumeric(lt) { env.bad.push(tyArithMsg(lt)) }
        else if !tyReqMatch(lt, rt) { env.bad.push(tyDiffMsg(lt, rt)) }
    } else if isBitOp(op) {
        if !tyIsInt(lt) { env.bad.push(tyBitMsg(lt)) }
        else if !tyReqMatch(lt, rt) { env.bad.push(tyDiffMsg(lt, rt)) }
    } else if isCmpOp(op) {
        if !tyReqMatch(lt, rt) { env.bad.push(tyDiffMsg(lt, rt)) }
    }
}

func tyArithMsg(_ got: String) using Alloc -> String {
    var s: String = "arithmetic operator requires numeric operands, got "
    s.append(got)
    return s
}

func tyBitMsg(_ got: String) using Alloc -> String {
    var s: String = "bitwise operator requires integer operands, got "
    s.append(got)
    return s
}

func tyDiffMsg(_ lt: String, _ rt: String) using Alloc -> String {
    var s: String = "binary operator operands of different types: "
    s.append(lt)
    s.append(" vs ")
    s.append(rt)
    return s
}

func tyLogMsg() using Alloc -> String {
    return own("logical && / || require Bool operands")
}

// ----- unary operator constraints -------------------------------------------
func tyUnary(_ env: inout TyEnv, _ op: String, _ x: Vec[Nd]) using Alloc {
    tyBoxed(env, x)
    tyCheckUnOp(env, op, x)
}

// `-x` needs a numeric operand, `~x` an integer one. `!` is skipped: the AST
// merges prefix logical-not and postfix force-unwrap into one node, so the right
// diagnostic ("requires Bool" vs "requires an Optional") can't be chosen.
func tyCheckUnOp(_ env: inout TyEnv, _ op: String, _ x: Vec[Nd]) using Alloc {
    let xt = tyInferBoxed(env, x)
    if streq(xt, "") { return }
    if streq(op, "-") {
        if !tyIsNumeric(xt) { env.bad.push(tyNegMsg(xt)) }
    } else if streq(op, "~") {
        if !tyIsInt(xt) { env.bad.push(tyBitNotMsg(xt)) }
    }
}

func tyNegMsg(_ got: String) using Alloc -> String {
    var s: String = "unary '-' requires a numeric type, got "
    s.append(got)
    return s
}

func tyBitNotMsg(_ got: String) using Alloc -> String {
    var s: String = "unary '~' requires an integer type, got "
    s.append(got)
    return s
}

func tyFieldMsg(_ label: String, _ fieldType: String, _ argType: String) using Alloc -> String {
    var s: String = "field '"
    s.append(label)
    s.append("' of type ")
    s.append(fieldType)
    s.append(" cannot accept value of type ")
    s.append(argType)
    return s
}

func tyNoFieldMsg(_ structName: String, _ label: String) using Alloc -> String {
    var s: String = "'"
    s.append(structName)
    s.append("' has no field '")
    s.append(label)
    s.append("'")
    return s
}

func tyMissingMsg(_ structName: String, _ fieldName: String) using Alloc -> String {
    var s: String = "struct '"
    s.append(structName)
    s.append("' constructor is missing field '")
    s.append(fieldName)
    s.append("'")
    return s
}

func tyCtorLabelMsg(_ n: Int) using Alloc -> String {
    var s: String = "struct constructor argument "
    s.append(intToStr(n))
    s.append(" requires a field label")
    return s
}

func tyInferCall(_ env: inout TyEnv, _ callee: Vec[Nd]) using Alloc -> String {
    return match (callee.get(0) ?? Nd.wildcard) {
        case .member(let base, let name, let chain): tyInferMethodCall(env, base, name, chain)
        default: tyInferPlainCall(env, callee)
    }
}

func tyInferPlainCall(_ env: inout TyEnv, _ callee: Vec[Nd]) using Alloc -> String {
    let nm = exCalleeNameBoxed(callee)
    let r = tyFuncRet(env, nm)
    if !streq(r, "") { return r }
    let b = tyBuiltinRet(nm)
    if !streq(b, "") { return b }
    if tyIsStruct(env, nm) { return nm }
    return own("")
}

// Return types of the §18 builtins vgen lowers (a unit-defined function wins in
// the lookup above). readFile's optional makes the `!` disambiguation fire so
// `readFile(p)!` lowers as a force-unwrap, not logical-not.
func tyBuiltinRet(_ nm: Str) using Alloc -> String {
    if streq(nm, "readFile") { return own("String?") }
    if streq(nm, "writeFile") { return own("Bool") }
    return own("")
}

// `recv.method(...)` types as the method's declared result, found by the
// receiver's (struct/enum) type. A `?.` chain, an unknown receiver, or a builtin
// / generic method (none recorded) stays unknown and is tolerated. A `Self`
// result resolves to the receiver type so a chained / stored result types right.
func tyInferMethodCall(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String, _ chain: Bool) using Alloc -> String {
    if chain { return own("") }
    let bt = tyInferBoxed(env, base)
    if streq(bt, "") { return own("") }
    return tyMethodRet(env, bt, name)
}

func tyMethodRet(_ env: inout TyEnv, _ owner: String, _ name: String) using Alloc -> String {
    var i: Int = 0
    while i < env.mStruct.len() {
        if let s = env.mStruct.get(i) {
            if streq(s, owner) {
                if let mn = env.mName.get(i) {
                    if streq(mn, name) {
                        let r = env.mRet.get(i) ?? own("")
                        if streq(r, "Self") { return owner }
                        return r
                    }
                }
            }
        }
        i = i + 1
    }
    return own("")
}

// ----- type spelling (describe) of an annotation node -----------------------
func tyAnnSpelling(_ ty: Vec[Nd]) using Alloc -> String {
    if ty.len() == 0 { return own("") }
    return typeSpelling(ty.get(0) ?? Nd.wildcard)
}

func typeSpelling(_ t: Nd) using Alloc -> String {
    return match t {
        case .named(let path, let hasG, let args): tyNamedSpelling(path, hasG, args)
        case .opt(let inner): tyOptSpelling(inner)
        case .vecT(let len, let elem): tyVecTSpelling(len, elem)
        default: own("")
    }
}

// A fixed-size array type `[N]T` spells as "[N]" + the element spelling, no
// space — the same shape an array literal infers to (see tyInferVecLit).
func tyVecTSpelling(_ len: String, _ elem: Vec[Nd]) using Alloc -> String {
    var s: String = "["
    s.append(len)
    s.append("]")
    s.append(tyAnnSpelling(elem))
    return s
}

func tyNamedSpelling(_ path: String, _ hasG: Bool, _ args: Vec[Nd]) using Alloc -> String {
    var s: String = path
    if hasG && args.len() > 0 {
        s.append("[")
        var i: Int = 0
        while i < args.len() {
            if i > 0 { s.append(", ") }
            s.append(typeSpelling(args.get(i) ?? Nd.wildcard))
            i = i + 1
        }
        s.append("]")
    }
    return s
}

func tyOptSpelling(_ inner: Vec[Nd]) using Alloc -> String {
    var s: String = tyAnnSpelling(inner)
    s.append("?")
    return s
}

// ----- assignability --------------------------------------------------------
func tyAssignable(_ from: String, _ to: String) using Alloc -> Bool {
    if streq(from, "") || streq(to, "") { return true }   // unknown: don't pile on
    if streq(from, to) { return true }
    if tyIsArray(from) && tyIsArray(to) { return tyArrayAssignable(from, to) }
    if tyIntNatural(from, to) { return true }
    if tyStrLattice(from, to) { return true }
    if tyOptionalWrap(from, to) { return true }
    return false
}

// Two array types `[N]T` / `[M]U` are assignable when their counts match and the
// element types are assignable (so `[3]Int` -> `[3]Int32` by natural width, but
// neither a count nor a Vec mismatch passes).
func tyIsArray(_ s: String) -> Bool {
    return s.len() > 0 && (s.byteAt(0) ?? 0) == 91   // '[' == 91
}

func tyArrayAssignable(_ from: String, _ to: String) using Alloc -> Bool {
    return streq(tyArrayCount(from), tyArrayCount(to))
        && tyAssignable(tyArrayElem(from), tyArrayElem(to))
}

// "[3]Int32" -> "3" (between '[' and the first ']').
func tyArrayCount(_ s: String) using Alloc -> String {
    var i: Int = 1
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 93 { return own(s.slice(1, i)) }   // ']' == 93
        i = i + 1
    }
    return own("")
}

// "[3]Int32" -> "Int32" (everything after the first ']').
func tyArrayElem(_ s: String) using Alloc -> String {
    var i: Int = 1
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 93 { return own(s.slice(i + 1, s.len())) }
        i = i + 1
    }
    return own("")
}

func tyIsInt(_ s: String) -> Bool {
    return streq(s, "Int") || streq(s, "Int8") || streq(s, "Int16") || streq(s, "Int32")
        || streq(s, "Int64") || streq(s, "Int128") || streq(s, "UInt") || streq(s, "UInt8")
        || streq(s, "UInt16") || streq(s, "UInt32") || streq(s, "UInt64") || streq(s, "UInt128")
}

func tyIsSignedInt(_ s: String) -> Bool {
    return streq(s, "Int") || streq(s, "Int8") || streq(s, "Int16") || streq(s, "Int32")
        || streq(s, "Int64") || streq(s, "Int128")
}

// §17 — a natural-width Int/UInt assigns to/from a specific width of the same
// signedness; specific widths remain mutually incompatible.
func tyIntNatural(_ from: String, _ to: String) -> Bool {
    if !(tyIsInt(from) && tyIsInt(to)) { return false }
    let fn = streq(from, "Int") || streq(from, "UInt")
    let tn = streq(to, "Int") || streq(to, "UInt")
    if !(fn || tn) { return false }
    return tyIsSignedInt(from) == tyIsSignedInt(to)
}

func tyStrRank(_ s: String) -> Int {
    if streq(s, "StrConst") { return 0 }
    if streq(s, "Str") { return 1 }
    if streq(s, "String") { return 2 }
    return -1
}

// §4 — StrConst <= Str <= String (narrowing literal to wider owner/view).
func tyStrLattice(_ from: String, _ to: String) -> Bool {
    let f = tyStrRank(from)
    let t = tyStrRank(to)
    return f >= 0 && t >= 0 && f <= t
}

// §9 — a value of T is assignable to an Optional T (`.some(...)` wrap).
func tyOptionalWrap(_ from: String, _ to: String) using Alloc -> Bool {
    let n = to.len()
    if n == 0 { return false }
    if (to.byteAt(n - 1) ?? 0) != 63 { return false }   // ends with '?'
    return tyAssignable(from, own(to.slice(0, n - 1)))
}

// ----- diagnostics ----------------------------------------------------------
func tyInitMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "initializer of type "
    s.append(from)
    s.append(" does not match annotation ")
    s.append(to)
    return s
}

func tyConstMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "const value of type "
    s.append(from)
    s.append(" does not match annotation ")
    s.append(to)
    return s
}

func tyArityMsg(_ expected: Int, _ got: Int) using Alloc -> String {
    var s: String = "call expects "
    s.append(intToStr(expected))
    s.append(" argument(s), got ")
    s.append(intToStr(got))
    return s
}

func tyArgMsg(_ idx1: Int, _ from: String, _ to: String) using Alloc -> String {
    var s: String = "argument "
    s.append(intToStr(idx1))
    s.append(" of type ")
    s.append(from)
    s.append(" does not match parameter type ")
    s.append(to)
    return s
}

func tyReturnMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "return value of type "
    s.append(from)
    s.append(" does not match function result type ")
    s.append(to)
    return s
}

func tyBodyMsg(_ name: String, _ ret: String, _ body: String) using Alloc -> String {
    var s: String = "function '"
    s.append(name)
    s.append("' returns ")
    s.append(ret)
    s.append(" but body produces ")
    s.append(body)
    return s
}

// A fresh type environment with the unit's global tables (function returns,
// struct fields, enum cases, methods) collected. The per-function symbol table is
// (re)built per function/method body.
func buildTyEnv(_ u: NUnit) using Alloc -> TyEnv {
    var env = TyEnv(funcName: Vec.new(), funcRet: Vec.new(), funcArity: Vec.new(),
                    pFn: Vec.new(), pIdx: Vec.new(), pType: Vec.new(), pTyNode: Vec.new(),
                    structs: Vec.new(), sFldStruct: Vec.new(), sFldName: Vec.new(),
                    sFldType: Vec.new(), mStruct: Vec.new(), mName: Vec.new(),
                    mRet: Vec.new(), mpOwner: Vec.new(), mpName: Vec.new(),
                    mpIdx: Vec.new(), mpTyNode: Vec.new(),
                    eName: Vec.new(), ecEnum: Vec.new(),
                    ecName: Vec.new(), ecArity: Vec.new(),
                    ecfEnum: Vec.new(), ecfCase: Vec.new(),
                    ecfIdx: Vec.new(), ecfName: Vec.new(),
                    symName: Vec.new(), symType: Vec.new(),
                    curRet: own(""), curRetNode: Vec.new(), bad: Vec.new())
    var i: Int = 0
    while i < u.decls.len() {
        tyCollectDecl(&env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    return env
}

func emitUnit(_ u: NUnit, _ stem: Str) using Alloc, Log {
    var env = buildTyEnv(u)
    print("// Generated by vestra-transpiler. Do not edit.\n")
    print("#include \"")
    print(stem)
    print(".hpp\"\n\n")
    var i: Int = 0
    while i < u.decls.len() {
        emitDecl(&env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func emitDecl(_ env: inout TyEnv, _ d: Nd) using Alloc, Log {
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body):
            emitFunc(env, name, params, res, body)
        default: noop()
    }
}

// ----- header (`.hpp`) emission --------------------------------------------
// The per-program tail of the generated header (everything after the fixed
// runtime prelude): a leading blank line, then each declaration in SOURCE order
// — a free function as a forward declaration, a struct/enum as its definition
// (definitions/methods are a later slice). The harness diffs this against the
// `.hpp` tail `vestra build` writes (after the `#endif // VESTRA_RUNTIME_PRELUDE`
// marker).
func emitHpp(_ u: NUnit) using Alloc, Log {
    var env = buildTyEnv(u)
    print("\n")
    var i: Int = 0
    while i < u.decls.len() {
        emitHppDecl(&env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func emitHppDecl(_ env: inout TyEnv, _ d: Nd) using Alloc, Log {
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body):
            emitFwdDecl(name, params, res)
        case .structD(let vis, let name, let fields, let methods, let deinitB, let isLinear, let generics):
            emitStructDef(env, name, fields, methods)
        case .enumD(let vis, let name, let cases, let methods, let generics):
            emitEnumDecl(name, cases, methods)
        case .constD(let vis, let name, let ty, let value):
            emitGlobalDef(env, "inline constexpr ", name, ty, value)
        case .staticD(let vis, let name, let ty, let value):
            emitGlobalDef(env, "inline ", name, ty, value)
        default: noop()
    }
}

// A top-level `const` / `static` lowers to an inline variable in the header:
// `inline constexpr <type> <name> = <value>;` / `inline <type> <name> = <value>;`
// (one line, no trailing blank — like a forward declaration). The `.cpp` emits
// nothing for them.
func emitGlobalDef(_ env: inout TyEnv, _ prefix: Str, _ name: Str, _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    print(prefix)
    emitTypeBoxed(ty)
    print(" ")
    print(name)
    print(" = ")
    emitBoxed(env, value)
    print(";\n")
}

// A payload-free enum lowers to a C++ `enum class` (each case a trailing-comma
// enumerator). An enum with any payload lowers to a tagged-union struct: a nested
// `<case>_t` payload struct per case and a `std::variant<...> value` member.
// Enum methods are deferred (the variant form gets methods in a later slice), so
// they are guarded out rather than mis-emitted.
// Enum methods are dropped by the C++ emitter (an `enum class` cannot carry them,
// and the variant form does not lower them either), so only the definition is
// emitted whether or not the enum declares methods.
func emitEnumDecl(_ name: Str, _ cases: Vec[Nd], _ methods: Vec[Nd]) using Alloc, Log {
    if allCasesBare(cases) { emitEnumClass(name, cases) }
    else { emitPayloadEnum(name, cases) }
}

// `struct <Name> { <case>_t structs...; std::variant<...> value{}; };`
func emitPayloadEnum(_ name: Str, _ cases: Vec[Nd]) using Alloc, Log {
    print("struct ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < cases.len() {
        emitCaseStruct(cases.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    emitVariantMember(cases)
    print("};\n\n")
}

func emitCaseStruct(_ c: Nd) using Alloc, Log {
    match c {
        case .enumCase(let cname, let payload): emitCaseStructBody(cname, payload)
        default: noop()
    }
}

// `    struct <case>_t {};` for a bare case, or `    struct <case>_t {<f0>  <f1> };`
// — payload fields `<type> <name>{};` joined by two spaces, with a trailing
// space before the closing brace. A named field keeps its declared label; a
// positional one is `_<i>`.
func emitCaseStructBody(_ cname: Str, _ payload: Vec[Nd]) using Alloc, Log {
    print("    struct ")
    print(cname)
    print("_t {")
    if payload.len() > 0 {
        var i: Int = 0
        while i < payload.len() {
            if i > 0 { print("  ") }
            emitPayloadField(payload.get(i) ?? Nd.wildcard, i)
            i = i + 1
        }
        print(" };\n")
    } else {
        print("};\n")
    }
}

func emitPayloadField(_ pe: Nd, _ idx: Int) using Alloc, Log {
    match pe {
        case .payElem(let label, let ty): emitPayloadFieldParts(label, ty, idx)
        default: noop()
    }
}

func emitPayloadFieldParts(_ label: Str, _ ty: Vec[Nd], _ idx: Int) using Alloc, Log {
    emitTypeBoxed(ty)
    print(" ")
    if streq(label, "") {
        print("_")
        print(intToStr(idx))
    } else {
        print(label)
    }
    print("{};")
}

func emitVariantMember(_ cases: Vec[Nd]) using Alloc, Log {
    print("    std::variant<")
    var i: Int = 0
    while i < cases.len() {
        if i > 0 { print(", ") }
        emitCaseTypeName(cases.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print("> value{};\n")
}

func emitCaseTypeName(_ c: Nd) using Alloc, Log {
    match c {
        case .enumCase(let cname, let payload): emitCaseTypeNameParts(cname)
        default: noop()
    }
}

func emitCaseTypeNameParts(_ cname: Str) using Alloc, Log {
    print(cname)
    print("_t")
}

func allCasesBare(_ cases: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < cases.len() {
        if !caseIsBare(cases.get(i) ?? Nd.wildcard) { return false }
        i = i + 1
    }
    return true
}

func caseIsBare(_ c: Nd) -> Bool {
    return match c {
        case .enumCase(let n, let payload): payload.len() == 0
        default: true
    }
}

func emitEnumClass(_ name: Str, _ cases: Vec[Nd]) using Alloc, Log {
    print("enum class ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < cases.len() {
        emitEnumCaseName(cases.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print("};\n\n")
}

func emitEnumCaseName(_ c: Nd) using Alloc, Log {
    match c {
        case .enumCase(let n, let payload): emitCaseEnumerator(n)
        default: noop()
    }
}

func emitCaseEnumerator(_ n: Str) using Alloc, Log {
    print("    ")
    print(n)
    print(",\n")
}

// A struct definition: `struct <Name> { <fields> <methods> };` then a trailing
// blank line. Each field (let / var alike) is `    <type> <name>{};` with a `{}`
// default initializer; methods follow as inline definitions.
func emitStructDef(_ env: inout TyEnv, _ name: Str, _ fields: Vec[Nd], _ methods: Vec[Nd]) using Alloc, Log {
    print("struct ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < fields.len() {
        emitField(fields.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    var m: Int = 0
    while m < methods.len() {
        emitMethod(env, methods.get(m) ?? Nd.wildcard)
        m = m + 1
    }
    print("};\n\n")
}

func emitMethod(_ env: inout TyEnv, _ d: Nd) using Alloc, Log {
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body):
            emitMethodDef(env, name, params, res, body)
        default: noop()
    }
}

// An inline struct method, indented one level: a method ALWAYS carries
// `[[nodiscard]]` (even an omitted / Unit return), unlike a free function. Its
// body sits two levels in; `self.x` lowers to `(*this).x`.
func emitMethodDef(_ env: inout TyEnv, _ name: Str, _ params: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print("    [[nodiscard]] ")
    emitRetType(res)
    print(" ")
    print(name)
    print("(")
    emitParams(params)
    print(") {\n")
    tyResetSyms(&env)
    tyRegisterParams(&env, params)
    tySetRetNode(&env, res)
    if body.len() > 0 { emitBlockStmts(env, body.get(0) ?? Nd.wildcard, "        ") }
    print("    }\n")
}

func emitField(_ f: Nd) using Alloc, Log {
    match f {
        case .field(let kind, let name, let ty): emitFieldDef(name, ty)
        default: noop()
    }
}

func emitFieldDef(_ name: Str, _ ty: Vec[Nd]) using Alloc, Log {
    print("    ")
    emitTypeBoxed(ty)
    print(" ")
    print(name)
    print("{};\n")
}

// A free-function forward declaration. `[[nodiscard]]` is emitted whenever the
// return type is written explicitly (even `-> Unit`); an omitted return type
// gets a bare `void`.
func emitFwdDecl(_ name: Str, _ params: Vec[Nd], _ res: Vec[Nd]) using Alloc, Log {
    if res.len() > 0 { print("[[nodiscard]] ") }
    emitRetType(res)
    print(" ")
    print(name)
    print("(")
    emitParams(params)
    print(");\n")
}

func emitFunc(_ env: inout TyEnv, _ name: Str, _ params: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    emitRetType(res)
    print(" ")
    print(name)
    print("(")
    emitParams(params)
    print(") {\n")
    tyResetSyms(&env)
    tyRegisterParams(&env, params)
    tySetRetNode(&env, res)
    emitBody(env, body)
    print("}\n\n")
}

// Record the enclosing function's result type node (used when an emitted match
// expression needs the C++ return type for its lambda). Copies the node out so
// the caller's `res` is not consumed.
func tySetRetNode(_ env: inout TyEnv, _ res: Vec[Nd]) using Alloc {
    while env.curRetNode.len() > 0 { let _ = env.curRetNode.pop() }
    if res.len() > 0 { env.curRetNode.push(res.get(0) ?? Nd.wildcard) }
    env.curRet = tyRetSpelling(res)
}

// §18.5 string-lattice coercion: a Str / StrConst-typed value flowing into a
// String slot (return, annotated initializer, assignment, call argument,
// struct-construction field) wraps in std::string(...) — the string_view ->
// string constructor is explicit.
func needsStrCoercion(_ from: Str, _ to: Str) -> Bool {
    if !streq(to, "String") { return false }
    return streq(from, "Str") || streq(from, "StrConst")
}

func emitMaybeCoerced(_ env: inout TyEnv, _ wrap: Bool, _ v: Vec[Nd]) using Alloc, Log {
    if wrap { print("std::string(") }
    emitBoxed(env, v)
    if wrap { print(")") }
}

func emitRetType(_ res: Vec[Nd]) using Alloc, Log {
    if res.len() == 0 { print("void"); return }
    emitTypeBoxed(res)
}

func emitParams(_ params: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < params.len() {
        if i > 0 { print(", ") }
        emitParam(params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func emitParam(_ p: Nd) using Alloc, Log {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty): emitReadParam(nm, ty)
        default: noop()
    }
}

// Slice 1: read-mode parameter -> `const <type>& <name>`. A function-typed
// parameter instead becomes a bare function pointer `<res>(*<name>)(...)`.
func emitReadParam(_ nm: Str, _ ty: Vec[Nd]) using Alloc, Log {
    if isFnTy(ty) { emitFnPtrDecl(ty, nm); return }
    print("const ")
    emitTypeBoxed(ty)
    print("& ")
    print(nm)
}

func emitTypeBoxed(_ ty: Vec[Nd]) using Alloc, Log {
    if ty.len() > 0 { emitType(ty.get(0) ?? Nd.wildcard) }
}

func emitType(_ t: Nd) using Alloc, Log {
    match t {
        case .named(let path, let hasG, let args): emitNamedType(path, hasG, args)
        case .opt(let inner): emitOptType(inner)
        case .fnT(let params, let caps, let thr, let res): emitFnPtr(res, "", params)
        case .vecT(let len, let elem): emitVecType(len, elem)
        case .tupleT(let elems): emitTupleType(elems)
        default: print("/*?type*/")
    }
}

// `[N]T` -> `std::array<T', N>`; `(T, U, ...)` -> `std::tuple<T', U', ...>`.
func emitVecType(_ len: Str, _ elem: Vec[Nd]) using Alloc, Log {
    print("std::array<")
    emitTypeBoxed(elem)
    print(", ")
    print(len)
    print(">")
}

func emitTupleType(_ elems: Vec[Nd]) using Alloc, Log {
    print("std::tuple<")
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(", ") }
        emitType(elems.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print(">")
}

// A function type lowers to a C++ function-pointer declarator: `<res>(*<name>)(
// const P0&, const P1&, ...)`. In type-argument / return-type position the name
// is empty, giving the abstract `<res>(*)(...)` form. Parameters are read-mode.
func emitFnPtr(_ res: Vec[Nd], _ name: Str, _ params: Vec[Nd]) using Alloc, Log {
    emitRetType(res)
    print("(*")
    print(name)
    print(")(")
    var i: Int = 0
    while i < params.len() {
        if i > 0 { print(", ") }
        print("const ")
        emitType(params.get(i) ?? Nd.wildcard)
        print("&")
        i = i + 1
    }
    print(")")
}

// True when a (boxed) type annotation is a function type, which needs the
// declarator form (name embedded mid-type) rather than `<type> <name>`.
func isFnTy(_ ty: Vec[Nd]) -> Bool {
    if ty.len() == 0 { return false }
    return match ty.get(0) ?? Nd.wildcard {
        case .fnT(let a, let b, let c, let d): true
        default: false
    }
}

// Emit a function-pointer declarator for an annotation known to be a function
// type, splicing `name` into the `(*name)` slot.
func emitFnPtrDecl(_ ty: Vec[Nd], _ name: Str) using Alloc, Log {
    match ty.get(0) ?? Nd.wildcard {
        case .fnT(let params, let caps, let thr, let res): emitFnPtr(res, name, params)
        default: noop()
    }
}

func emitNamedType(_ path: Str, _ hasG: Bool, _ args: Vec[Nd]) using Alloc, Log {
    if hasG && args.len() > 0 { emitGenericType(path, args); return }
    print(cppNamed(path))
}

// The builtin generic containers map onto their C++ standard-library spellings,
// with the element / key / value types emitted recursively.
func emitGenericType(_ path: Str, _ args: Vec[Nd]) using Alloc, Log {
    if streq(path, "Vec") { emitWrap1("std::vector<", args); return }
    if streq(path, "Box") { emitWrap1("std::unique_ptr<", args); return }
    if streq(path, "Span") { emitWrap1("std::span<const ", args); return }
    if streq(path, "MutSpan") { emitWrap1("std::span<", args); return }
    if streq(path, "HashMap") { emitWrap2("std::unordered_map<", args); return }
    print(cppNamed(path))
}

func emitWrap1(_ open: Str, _ args: Vec[Nd]) using Alloc, Log {
    print(open)
    emitTypeArg(args, 0)
    print(">")
}

func emitWrap2(_ open: Str, _ args: Vec[Nd]) using Alloc, Log {
    print(open)
    emitTypeArg(args, 0)
    print(", ")
    emitTypeArg(args, 1)
    print(">")
}

func emitTypeArg(_ args: Vec[Nd], _ i: Int) using Alloc, Log {
    if i < args.len() { emitType(args.get(i) ?? Nd.wildcard) }
}

// An optional `T?` lowers to std::optional<T>.
func emitOptType(_ inner: Vec[Nd]) using Alloc, Log {
    print("std::optional<")
    emitTypeBoxed(inner)
    print(">")
}

// Map a builtin scalar type name to its C++ spelling; an unknown name passes
// through unchanged (user types are added in a later slice).
func cppNamed(_ path: Str) using Alloc -> String {
    if streq(path, "Int8") { return own("std::int8_t") }
    if streq(path, "Int16") { return own("std::int16_t") }
    if streq(path, "Int32") { return own("std::int32_t") }
    if streq(path, "Int64") { return own("std::int64_t") }
    if streq(path, "Int") { return own("std::intptr_t") }
    if streq(path, "UInt8") { return own("std::uint8_t") }
    if streq(path, "UInt16") { return own("std::uint16_t") }
    if streq(path, "UInt32") { return own("std::uint32_t") }
    if streq(path, "UInt64") { return own("std::uint64_t") }
    if streq(path, "UInt") { return own("std::uintptr_t") }
    if streq(path, "Int128") { return own("__int128_t") }
    if streq(path, "UInt128") { return own("__uint128_t") }
    if streq(path, "Float32") { return own("float") }
    if streq(path, "Float64") { return own("double") }
    if streq(path, "Bool") { return own("bool") }
    if streq(path, "Char") { return own("char32_t") }
    if streq(path, "Unit") { return own("void") }
    if streq(path, "String") { return own("std::string") }
    if streq(path, "Str") { return own("std::string_view") }
    if streq(path, "StrConst") { return own("std::string_view") }
    return own(path)
}

// A function body is a single boxed block; emit its statements one level in.
func emitBody(_ env: inout TyEnv, _ body: Vec[Nd]) using Alloc, Log {
    if body.len() == 0 { return }
    emitBlockStmts(env, body.get(0) ?? Nd.wildcard, "    ")
}

func emitBlockStmts(_ env: inout TyEnv, _ b: Nd, _ indent: Str) using Alloc, Log {
    match b {
        case .block(let stmts): emitStmtList(env, stmts, indent)
        default: noop()
    }
}

func emitStmtList(_ env: inout TyEnv, _ stmts: Vec[Nd], _ indent: Str) using Alloc, Log {
    var i: Int = 0
    while i < stmts.len() {
        emitStmt(env, stmts.get(i) ?? Nd.wildcard, indent)
        i = i + 1
    }
}

func emitStmt(_ env: inout TyEnv, _ s: Nd, _ indent: Str) using Alloc, Log {
    match s {
        case .letS(let pat, let ty, let value): emitBinding(env, indent, pat, ty, value)
        case .varS(let pat, let ty, let value): emitBinding(env, indent, pat, ty, value)
        case .assignS(let op, let t, let v): emitAssign(env, indent, op, t, v)
        case .whileS(let cond, let body): emitWhile(env, indent, cond, body)
        case .forS(let pat, let iter, let body): emitFor(env, indent, pat, iter, body)
        case .exprS(let e): emitExprStmt(env, indent, e)
        case .retS(let v): emitReturn(env, indent, v)
        case .breakS(let label): emitJump(indent, "break")
        case .continueS(let label): emitJump(indent, "continue")
        case .withS(let caps, let names, let vals, let body): emitWith(env, indent, names, vals, body)
        default: noop()
    }
}

// `with ... { body }` lowers to a bare nested block `{ ... }` at the current
// statement indent. Grant-only capabilities (`with Cap`) are erased. A value
// binding (`with x = e`) emits `auto&& x = e;`; a capability instance
// (`with Cap = e`) emits `(void)(e);`. Bindings precede the body, in source order.
func emitWith(_ env: inout TyEnv, _ indent: Str, _ names: Vec[Nd], _ vals: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("{\n")
    let d = deeper(indent)
    var i: Int = 0
    while i < vals.len() {
        let nm = identName(names.get(i) ?? Nd.ident(""))
        print(d)
        if streq(nm, "") {
            print("(void)(")
            emitExpr(env, vals.get(i) ?? Nd.wildcard)
            print(");\n")
        } else {
            print("auto&& ")
            print(nm)
            print(" = ")
            emitExpr(env, vals.get(i) ?? Nd.wildcard)
            print(";\n")
            tyAddSymSpelling(&env, nm, tyInfer(&env, vals.get(i) ?? Nd.wildcard))
        }
        i = i + 1
    }
    if body.len() > 0 { emitBlockStmts(env, body.get(0) ?? Nd.wildcard, d) }
    print(indent)
    print("}\n")
}

func identName(_ n: Nd) using Alloc -> String {
    return match n {
        case .ident(let s): own(s)
        default: String.new()
    }
}

// `break;` / `continue;` (loop labels are not handled).
func emitJump(_ indent: Str, _ kw: Str) using Alloc, Log {
    print(indent)
    print(kw)
    print(";\n")
}

// `let`/`var` lower identically: an annotated binding keeps its C++ type, an
// inferred one uses `auto` (Vestra's immutability is not re-expressed in C++).
func emitBinding(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    if patIsTuple(pat) { emitTupleBinding(env, indent, pat, value); return }
    if valIsMatch(value) { emitMatchBinding(env, indent, pat, ty, value); return }
    if valIsVecLit(value) { emitVecLitBinding(env, indent, pat, ty, value); return }
    print(indent)
    if isFnTy(ty) {
        // A function-typed binding needs the declarator form `<res>(*<name>)(...)`.
        emitFnPtrDecl(ty, patName(pat))
    } else {
        if ty.len() > 0 { emitTypeBoxed(ty) } else { print("auto") }
        print(" ")
        print(patName(pat))
    }
    print(" = ")
    if isFnTy(ty) && valIsClosure(value) {
        // The annotation's function type supplies the lambda's parameter types.
        emitClosureWithFnTy(env, ty, value)
    } else {
        emitBindingValue(env, ty, value)
    }
    print(";\n")
    // Record the binding's type so later expressions can be inferred: an annotated
    // binding from its annotation, an inferred one from its initializer's type.
    if ty.len() > 0 {
        tyRegisterPat(&env, pat, ty)
    } else {
        tyAddSymSpelling(&env, patName(pat), tyInferBoxed(&env, value))
    }
}

func valIsMatch(_ v: Vec[Nd]) -> Bool {
    if v.len() == 0 { return false }
    return isMatchE(v.get(0) ?? Nd.wildcard)
}

func patIsTuple(_ pat: Vec[Nd]) -> Bool {
    if pat.len() == 0 { return false }
    return match pat.get(0) ?? Nd.wildcard {
        case .tupleP(let elems): true
        default: false
    }
}

// `let (a, b) = <expr>` lowers to a C++ structured binding: `auto [a, b] = <expr>;`.
func emitTupleBinding(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("auto [")
    emitTuplePatNames(pat.get(0) ?? Nd.wildcard)
    print("] = ")
    emitBoxed(env, value)
    print(";\n")
}

func emitTuplePatNames(_ p: Nd) using Alloc, Log {
    match p {
        case .tupleP(let elems): emitPatNameList(elems)
        default: noop()
    }
}

func emitPatNameList(_ elems: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(", ") }
        print(patNameOf(elems.get(i) ?? Nd.wildcard))
        i = i + 1
    }
}

func valIsVecLit(_ v: Vec[Nd]) -> Bool {
    if v.len() == 0 { return false }
    return match v.get(0) ?? Nd.wildcard {
        case .vecLit(let elems): true
        default: false
    }
}

// An array-literal binding threads the annotation's ELEMENT type into the
// literal (`[3]Int32` elements emit as std::int32_t, not the inferred default).
func emitVecLitBinding(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    print(indent)
    if ty.len() > 0 { emitTypeBoxed(ty) } else { print("auto") }
    print(" ")
    print(patName(pat))
    print(" = ")
    let et = annElemBox(ty)
    emitVecLitVal(env, et, value)
    print(";\n")
    if ty.len() > 0 {
        tyRegisterPat(&env, pat, ty)
    } else {
        tyAddSymSpelling(&env, patName(pat), tyInferBoxed(&env, value))
    }
}

func emitVecLitVal(_ env: inout TyEnv, _ et: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    match value.get(0) ?? Nd.wildcard {
        case .vecLit(let elems): emitVecLit(env, elems, et)
        default: noop()
    }
}

// A match-valued binding is `<type-or-auto> <name> = <match lambda>;` — the
// lambda's return type comes from the annotation when present, else from the
// match's inferred arm type (already a C++ spelling via cppNamed).
func emitMatchBinding(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    print(indent)
    if ty.len() > 0 { emitTypeBoxed(ty) } else { print("auto") }
    print(" ")
    print(patName(pat))
    print(" = ")
    let sp = cppNamed(tyInferBoxed(env, value))
    emitMatchBindingVal(env, indent, ty, sp, value)
    print(";\n")
    if ty.len() > 0 {
        tyRegisterPat(&env, pat, ty)
    } else {
        tyAddSymSpelling(&env, patName(pat), tyInferBoxed(&env, value))
    }
}

func emitMatchBindingVal(_ env: inout TyEnv, _ indent: Str, _ ty: Vec[Nd], _ tyStr: Str, _ value: Vec[Nd]) using Alloc, Log {
    match value.get(0) ?? Nd.wildcard {
        case .matchE(let scrut, let arms): emitMatchValue(env, indent, ty, tyStr, scrut, arms)
        default: noop()
    }
}

// An annotated binding's initializer coerces into a String annotation.
func emitBindingValue(_ env: inout TyEnv, _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    let from = tyInferBoxed(env, value)
    let wrap = needsStrCoercion(from, tyAnnSpelling(ty))
    emitMaybeCoerced(env, wrap, value)
}

func tyAddSymSpelling(_ env: inout TyEnv, _ name: String, _ sp: String) using Alloc {
    if !streq(sp, "") {
        env.symName.push(name)
        env.symType.push(sp)
    }
}

func emitAssign(_ env: inout TyEnv, _ indent: Str, _ op: Str, _ t: Vec[Nd], _ v: Vec[Nd]) using Alloc, Log {
    print(indent)
    emitBoxed(env, t)
    print(" ")
    print(op)
    print(" ")
    let to = tyInferBoxed(env, t)
    let from = tyInferBoxed(env, v)
    emitMaybeCoerced(env, needsStrCoercion(from, to), v)
    print(";\n")
}

func emitWhile(_ env: inout TyEnv, _ indent: Str, _ cond: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("while (")
    emitBoxed(env, cond)
    print(") {\n")
    if body.len() > 0 { emitBlockStmts(env, body.get(0) ?? Nd.wildcard, deeper(indent)) }
    print(indent)
    print("}\n")
}

// An expression statement is `<expr>;`, EXCEPT a statement-position `if` (an
// expression in Vestra) which lowers to the emitter's inline braced form with no
// trailing semicolon — see emitIfStmt.
// A `for v in <iter>` lowers two ways: a range `lo..<hi` / `lo..hi` becomes a
// C-style loop with a hoisted `__vstr_end` bound (`<` exclusive, `<=` inclusive),
// and any other iterable becomes a range-based `for (auto&& v : <iter>)`.
func emitFor(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ iter: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("for (")
    emitForHead(env, patName(pat), iter)
    print(") {\n")
    if body.len() > 0 { emitBlockStmts(env, body.get(0) ?? Nd.wildcard, deeper(indent)) }
    print(indent)
    print("}\n")
}

func emitForHead(_ env: inout TyEnv, _ v: Str, _ iter: Vec[Nd]) using Alloc, Log {
    if iter.len() == 0 { return }
    match iter.get(0) ?? Nd.wildcard {
        case .binary(let op, let lo, let hi): emitForMaybeRange(env, v, op, lo, hi, iter)
        default: emitForEach(env, v, iter)
    }
}

func emitForMaybeRange(_ env: inout TyEnv, _ v: Str, _ op: Str, _ lo: Vec[Nd], _ hi: Vec[Nd], _ iter: Vec[Nd]) using Alloc, Log {
    if streq(op, "..<") { emitForRange(env, v, lo, hi, true); return }
    if streq(op, "..") { emitForRange(env, v, lo, hi, false); return }
    emitForEach(env, v, iter)
}

func emitForRange(_ env: inout TyEnv, _ v: Str, _ lo: Vec[Nd], _ hi: Vec[Nd], _ excl: Bool) using Alloc, Log {
    print("auto ")
    print(v)
    print(" = ")
    emitBoxed(env, lo)
    print(", __vstr_end = ")
    emitBoxed(env, hi)
    print("; ")
    print(v)
    if excl { print(" < ") } else { print(" <= ") }
    print("__vstr_end; ++")
    print(v)
}

func emitForEach(_ env: inout TyEnv, _ v: Str, _ iter: Vec[Nd]) using Alloc, Log {
    print("auto&& ")
    print(v)
    print(" : ")
    emitBoxed(env, iter)
}

func emitExprStmt(_ env: inout TyEnv, _ indent: Str, _ e: Vec[Nd]) using Alloc, Log {
    if e.len() == 0 { return }
    match e.get(0) ?? Nd.wildcard {
        case .ifE(let ln, let li, let cond, let thenB, let els): emitIfStmt(env, indent, ln, li, cond, thenB, els)
        case .matchE(let scrut, let arms): emitMatchStmt(env, indent, scrut, arms)
        default: emitPlainExprStmt(env, indent, e)
    }
}

// A statement-position match is the same immediately-invoked lambda with an
// `auto` return type, its value discarded.
func emitMatchStmt(_ env: inout TyEnv, _ indent: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print(indent)
    let noTy: Vec[Nd] = Vec.new()
    emitMatchValue(env, indent, noTy, "auto", scrut, arms)
    print(";\n")
}

func emitPlainExprStmt(_ env: inout TyEnv, _ indent: Str, _ e: Vec[Nd]) using Alloc, Log {
    print(indent)
    emitBoxed(env, e)
    print(";\n")
}

// The inline statement-`if`: `<indent>if (<cond>) { <then-stmts>}` then an
// optional ` else { <else-stmts>}` and a trailing newline. The branch statements
// are emitted with EMPTY indentation (the emitter opens the block inline and the
// closing braces sit at column 0), and no `;` follows. Plain `if` only; if-let
// (a non-empty bind name) and else-if chains are deferred.
func emitIfStmt(_ env: inout TyEnv, _ indent: Str, _ ln: Str, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("if (")
    emitBoxed(env, cond)
    print(") { ")
    if thenB.len() > 0 { emitBlockStmts(env, thenB.get(0) ?? Nd.wildcard, "") }
    print("}")
    if els.len() > 0 {
        print(" else { ")
        emitElse(env, els.get(0) ?? Nd.wildcard)
        print("}")
    }
    print("\n")
}

func emitElse(_ env: inout TyEnv, _ e: Nd) using Alloc, Log {
    match e {
        case .block(let stmts): emitStmtList(env, stmts, "")
        default: noop()
    }
}

func emitReturn(_ env: inout TyEnv, _ indent: Str, _ v: Vec[Nd]) using Alloc, Log {
    if v.len() > 0 && isMatchE(v.get(0) ?? Nd.wildcard) {
        emitReturnMatch(env, indent, v.get(0) ?? Nd.wildcard)
        return
    }
    if v.len() > 0 && isValueIfE(v.get(0) ?? Nd.wildcard) {
        emitReturnIfNode(env, indent, v.get(0) ?? Nd.wildcard)
        return
    }
    if valIsVecLit(v) {
        emitReturnVecLit(env, indent, v.get(0) ?? Nd.wildcard)
        return
    }
    print(indent)
    print("return")
    if v.len() > 0 { print(" "); emitReturnValue(env, v) }
    print(";\n")
}

func emitReturnValue(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc, Log {
    let from = tyInferBoxed(env, v)
    let wrap = needsStrCoercion(from, env.curRet)
    emitMaybeCoerced(env, wrap, v)
}

// A returned array literal threads the function's `[N]T` result type into the
// literal's element type.
func emitReturnVecLit(_ env: inout TyEnv, _ indent: Str, _ m: Nd) using Alloc, Log {
    print(indent)
    print("return ")
    let et = retElemBox(env)
    emitReturnVecLitNode(env, et, m)
    print(";\n")
}

func retElemBox(_ env: inout TyEnv) using Alloc -> Vec[Nd] {
    if env.curRetNode.len() == 0 { return emptyNdBox() }
    return vecElemBox(env.curRetNode.get(0) ?? Nd.wildcard)
}

func emitReturnVecLitNode(_ env: inout TyEnv, _ et: Vec[Nd], _ m: Nd) using Alloc, Log {
    match m {
        case .vecLit(let elems): emitVecLit(env, elems, et)
        default: noop()
    }
}

func isMatchE(_ e: Nd) -> Bool {
    return match e {
        case .matchE(let scrut, let arms): true
        default: false
    }
}

// A value-position if (plain, with an else) — if-let stays on the general path.
func isValueIfE(_ e: Nd) -> Bool {
    return match e {
        case .ifE(let ln, let li, let cond, let thenB, let els): streq(ln, "") && els.len() > 0
        default: false
    }
}

// `return if <c> { <a> } else { <b> }` lowers NOT to the value lambda but to a
// statement `if` whose branch tails return — the same inline-braced,
// column-0-closing shape as emitIfStmt:
//
//   if (<c>) { return <a>;
//   } else { return <b>;
//   }
//
// An else-if chain nests the same form inside the else block.
func emitReturnIfNode(_ env: inout TyEnv, _ indent: Str, _ m: Nd) using Alloc, Log {
    match m {
        case .ifE(let ln, let li, let cond, let thenB, let els): emitReturnIf(env, indent, cond, thenB, els)
        default: noop()
    }
}

func emitReturnIf(_ env: inout TyEnv, _ indent: Str, _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("if (")
    emitBoxed(env, cond)
    print(") { ")
    emitRetBlock(env, thenB)
    print("}")
    emitRetElse(env, els)
    print("\n")
}

func emitRetBlock(_ env: inout TyEnv, _ b: Vec[Nd]) using Alloc, Log {
    match b.get(0) ?? Nd.wildcard {
        case .block(let stmts): emitRetStmts(env, stmts)
        default: noop()
    }
}

// Branch statements at "" indent; the value-yielding trailing expression
// becomes `return <expr>;` with its newline (unlike the inline-lambda shape,
// the closing brace follows on the next line).
func emitRetStmts(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc, Log {
    let n = stmts.len()
    var i: Int = 0
    while i < n {
        let s = stmts.get(i) ?? Nd.wildcard
        if i == n - 1 {
            emitRetTail(env, s)
        } else {
            emitStmt(env, s, "")
        }
        i = i + 1
    }
}

func emitRetTail(_ env: inout TyEnv, _ s: Nd) using Alloc, Log {
    match s {
        case .exprS(let e): emitRetTailExpr(env, e)
        default: emitStmt(env, s, "")
    }
}

func emitRetTailExpr(_ env: inout TyEnv, _ e: Vec[Nd]) using Alloc, Log {
    print("return ")
    emitBoxed(env, e)
    print(";\n")
}

func emitRetElse(_ env: inout TyEnv, _ els: Vec[Nd]) using Alloc, Log {
    if els.len() == 0 { return }
    match els.get(0) ?? Nd.wildcard {
        case .block(let stmts): emitRetElseBlock(env, stmts)
        case .ifE(let ln, let li, let cond, let thenB, let els2): emitRetElseIf(env, cond, thenB, els2)
        default: noop()
    }
}

func emitRetElseBlock(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc, Log {
    print(" else { ")
    emitRetStmts(env, stmts)
    print("}")
}

func emitRetElseIf(_ env: inout TyEnv, _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print(" else { ")
    emitReturnIf(env, "", cond, thenB, els)
    print("}")
}

// `return match <scrut> { case .X: <body> ... }` over a payload-free enum lowers
// to an immediately-invoked lambda wrapping a switch:
//
//   return [&]() -> <retType> { switch (<scrut>) {
//       case <Enum>::<case>:
//           return <body>;
//       ...
//   } }();
//
// The scrutinee type (inferred) supplies the enum name that qualifies each case
// label. In return position the lambda's return type is the enclosing function's
// result type.
func emitReturnMatch(_ env: inout TyEnv, _ indent: Str, _ m: Nd) using Alloc, Log {
    match m {
        case .matchE(let scrut, let arms): emitReturnMatchParts(env, indent, scrut, arms)
        default: noop()
    }
}

func emitReturnMatchParts(_ env: inout TyEnv, _ indent: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("return ")
    let noTy: Vec[Nd] = Vec.new()
    emitMatchValue(env, indent, noTy, "", scrut, arms)
    print(";\n")
}

// The lambda-expression core of a match lowering, shared by every position
// (return value, binding initializer, bare statement). Emits from `[&](` or
// `std::visit(` through the closing `()` — the caller prints whatever precedes
// (indent, `return `, `<type> <name> = `) and the trailing `;\n`. The `indent`
// still shapes the inner lines and closing brace, which sit at statement level
// in every position.
func emitMatchValue(_ env: inout TyEnv, _ indent: Str, _ ty: Vec[Nd], _ tyStr: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    let enumName = tyInferBoxed(env, scrut)
    // A guarded payload-free match cannot be a switch (a guard is a runtime
    // condition); it lowers to an if/else-if chain over the scrutinee.
    if !isPayloadEnum(env, enumName) && anyArmGuarded(arms) {
        emitGuardMatchValue(env, indent, ty, tyStr, enumName, scrut, arms)
        return
    }
    if isPayloadEnum(env, enumName) { emitVisitMatchValue(env, indent, ty, tyStr, enumName, scrut, arms); return }
    print("[&]() -> ")
    emitMatchRetTy(env, ty, tyStr)
    print(" { switch (")
    emitBoxed(env, scrut)
    print(") {\n")
    let armIndent = deeper(indent)
    var i: Int = 0
    while i < arms.len() {
        emitMatchArm(env, armIndent, enumName, arms.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print(indent)
    print("} }()")
}

// The lambda's C++ return type: a binding annotation (`ty`) when present, else
// an already-C++ spelling (`tyStr`, e.g. `auto` in statement position or an
// inferred scalar in an unannotated binding), else the enclosing function's
// result type (return position).
func emitMatchRetTy(_ env: inout TyEnv, _ ty: Vec[Nd], _ tyStr: Str) using Alloc, Log {
    if ty.len() > 0 { emitTypeBoxed(ty); return }
    if !streq(tyStr, "") { print(tyStr); return }
    emitTypeBoxed(env.curRetNode)
}

func anyArmGuarded(_ arms: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < arms.len() {
        if armGuarded(arms.get(i) ?? Nd.wildcard) { return true }
        i = i + 1
    }
    return false
}

func armGuarded(_ arm: Nd) -> Bool {
    return match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): guard.len() > 0
        default: false
    }
}

// A guarded payload-free match lowers to an if/else-if chain over a copy of the
// scrutinee:
//
//   [&]() -> <retType> {
//       auto&& __vstr_m = <scrut>;
//       if (__vstr_m == <Enum>::<case> && (<guard>)) {
//           return <body>;
//       }
//       else if (__vstr_m == <Enum>::<case>) { ... }
//       else { return <default>; }   // or `else { std::unreachable(); }`
//   }()
func emitGuardMatchValue(_ env: inout TyEnv, _ indent: Str, _ ty: Vec[Nd], _ tyStr: Str, _ enumName: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print("[&]() -> ")
    emitMatchRetTy(env, ty, tyStr)
    print(" {\n")
    let i8 = deeper(indent)
    print(i8)
    print("auto&& __vstr_m = ")
    emitBoxed(env, scrut)
    print(";\n")
    let i12 = deeper(i8)
    var k: Int = 0
    var di: Int = 0 - 1
    var j: Int = 0
    while j < arms.len() {
        if armIsDefault(arms.get(j) ?? Nd.wildcard) {
            di = j
        } else {
            emitGuardArm(env, i8, i12, enumName, arms.get(j) ?? Nd.wildcard, k)
            k = k + 1
        }
        j = j + 1
    }
    if di >= 0 {
        emitGuardDefault(env, i8, arms.get(di) ?? Nd.wildcard)
    } else {
        print(i8)
        print("else { std::unreachable(); }\n")
    }
    print(indent)
    print("}()")
}

func emitGuardArm(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ enumName: Str, _ arm: Nd, _ k: Int) using Alloc, Log {
    match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): emitGuardArmParts(env, i8, i12, enumName, pat, guard, body, k)
        default: noop()
    }
}

func emitGuardArmParts(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ enumName: Str, _ pat: Vec[Nd], _ guard: Vec[Nd], _ body: Vec[Nd], _ k: Int) using Alloc, Log {
    print(i8)
    if k == 0 { print("if (") } else { print("else if (") }
    print("__vstr_m == ")
    print(enumName)
    print("::")
    print(armCaseName(pat))
    if guard.len() > 0 {
        print(" && (")
        emitBoxed(env, guard)
        print(")")
    }
    print(") {\n")
    print(i12)
    print("return ")
    emitBoxed(env, body)
    print(";\n")
    print(i8)
    print("}\n")
}

func emitGuardDefault(_ env: inout TyEnv, _ i8: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): emitGuardDefaultParts(env, i8, body)
        default: noop()
    }
}

func emitGuardDefaultParts(_ env: inout TyEnv, _ i8: Str, _ body: Vec[Nd]) using Alloc, Log {
    print(i8)
    print("else { return ")
    emitBoxed(env, body)
    print("; }\n")
}

func emitMatchArm(_ env: inout TyEnv, _ armIndent: Str, _ enumName: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): emitMatchArmParts(env, armIndent, enumName, isDefault, pat, body)
        default: noop()
    }
}

// A `default:` / wildcard `case _:` arm lowers to a `default:` label; any other
// arm to its `case <Enum>::<case>:` label.
func emitMatchArmParts(_ env: inout TyEnv, _ armIndent: Str, _ enumName: Str, _ isDefault: Bool, _ pat: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(armIndent)
    if isDefault || isWildcardPat(pat) {
        print("default:\n")
    } else {
        print("case ")
        print(enumName)
        print("::")
        print(armCaseName(pat))
        print(":\n")
    }
    print(deeper(armIndent))
    print("return ")
    emitBoxed(env, body)
    print(";\n")
}

func isWildcardPat(_ pat: Vec[Nd]) -> Bool {
    if pat.len() == 0 { return false }
    return match pat.get(0) ?? Nd.wildcard {
        case .wildcard: true
        default: false
    }
}

// `match <scrut> { case .C(let a, ...): <body> ... }` over a PAYLOAD enum lowers
// to a std::visit over the variant, with an `if constexpr` chain selecting the
// active alternative and binding its payload fields:
//
//   std::visit([&](auto&& __vstr_alt) -> <retType> {
//       using __vstr_alt_t = std::decay_t<decltype(__vstr_alt)>;
//       if constexpr (std::is_same_v<__vstr_alt_t, <Enum>::<C>_t>) {
//           {
//               auto&& a = __vstr_alt._0;
//               return <body>;
//           }
//       } else if constexpr (...) { ... } else { std::unreachable(); }
//   }, <scrut>.value)
func emitVisitMatchValue(_ env: inout TyEnv, _ indent: Str, _ ty: Vec[Nd], _ tyStr: Str, _ enumName: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print("std::visit([&](auto&& __vstr_alt) -> ")
    emitMatchRetTy(env, ty, tyStr)
    print(" {\n")
    let i8 = deeper(indent)
    print(i8)
    print("using __vstr_alt_t = std::decay_t<decltype(__vstr_alt)>;\n")
    let i12 = deeper(i8)
    let i16 = deeper(i12)
    // Arms GROUP by case: each distinct case name (in arm order) forms one
    // if-constexpr branch holding every arm of that case as its own binding
    // scope. A guarded arm returns inside a runtime `if (<guard>)`, so control
    // can fall through to the case's next scope; a group whose LAST arm is
    // guarded falls back to the default arm's body after the scopes. A default
    // / wildcard arm becomes the trailing `else`, otherwise the chain ends in
    // `std::unreachable()`. (With no guards each case has one always-returning
    // scope, the degenerate chain this emitter always produced.)
    var di: Int = 0 - 1
    var j: Int = 0
    while j < arms.len() {
        if armIsDefault(arms.get(j) ?? Nd.wildcard) { di = j }
        j = j + 1
    }
    let caseNames = distinctCaseNames(arms)
    var k: Int = 0
    while k < caseNames.len() {
        if let cn = caseNames.get(k) {
            emitVisitGroup(env, i8, i12, i16, enumName, cn, arms, k, di)
        }
        k = k + 1
    }
    if di >= 0 {
        emitVisitDefault(env, i8, i12, arms.get(di) ?? Nd.wildcard)
    } else {
        print(i8)
        print("} else { std::unreachable(); }\n")
    }
    print(indent)
    print("}, ")
    emitBoxed(env, scrut)
    print(".value)")
}

// The distinct non-default case names, in order of first appearance.
func distinctCaseNames(_ arms: Vec[Nd]) using Alloc -> Vec[String] {
    var names: Vec[String] = Vec.new()
    var i: Int = 0
    while i < arms.len() {
        let a = arms.get(i) ?? Nd.wildcard
        if !armIsDefault(a) {
            let cn = armCase(a)
            if !nameListHas(names, cn) { names.push(cn) }
        }
        i = i + 1
    }
    return names
}

func nameListHas(_ xs: Vec[String], _ n: Str) -> Bool {
    var i: Int = 0
    while i < xs.len() {
        if let x = xs.get(i) { if streq(x, n) { return true } }
        i = i + 1
    }
    return false
}

func armCase(_ arm: Nd) using Alloc -> String {
    return match arm {
        case .matchArm(let isDef, let pat, let guard, let body): armCaseName(pat)
        default: own("")
    }
}

// One case group: the if-constexpr branch header, a scope per arm of the case,
// and — when the last arm's guard can fail — the default body as fallback.
func emitVisitGroup(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ i16: Str, _ enumName: Str, _ cn: Str, _ arms: Vec[Nd], _ idx: Int, _ di: Int) using Alloc, Log {
    print(i8)
    if idx == 0 { print("if constexpr (std::is_same_v<__vstr_alt_t, ") }
    else { print("} else if constexpr (std::is_same_v<__vstr_alt_t, ") }
    print(enumName)
    print("::")
    print(cn)
    print("_t>) {\n")
    var lastGuarded: Bool = false
    var j: Int = 0
    while j < arms.len() {
        let a = arms.get(j) ?? Nd.wildcard
        if !armIsDefault(a) && streq(armCase(a), cn) {
            emitVisitScope(env, i12, i16, enumName, a)
            lastGuarded = armGuarded(a)
        }
        j = j + 1
    }
    if lastGuarded && di >= 0 {
        emitVisitFallback(env, i12, arms.get(di) ?? Nd.wildcard)
    }
}

func emitVisitScope(_ env: inout TyEnv, _ i12: Str, _ i16: Str, _ enumName: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDef, let pat, let guard, let body): emitVisitScopeParts(env, i12, i16, enumName, pat, guard, body)
        default: noop()
    }
}

func emitVisitScopeParts(_ env: inout TyEnv, _ i12: Str, _ i16: Str, _ enumName: Str, _ pat: Vec[Nd], _ guard: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(i12)
    print("{\n")
    emitPayloadBindings(env, i16, enumName, pat)
    if guard.len() > 0 {
        print(i16)
        print("if (")
        emitBoxed(env, guard)
        print(") {\n")
        print(deeper(i16))
        print("return ")
        emitBoxed(env, body)
        print(";\n")
        print(i16)
        print("}\n")
    } else {
        print(i16)
        print("return ")
        emitBoxed(env, body)
        print(";\n")
    }
    print(i12)
    print("}\n")
}

func emitVisitFallback(_ env: inout TyEnv, _ i12: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDef, let pat, let guard, let body): emitVisitFallbackBody(env, i12, body)
        default: noop()
    }
}

func emitVisitFallbackBody(_ env: inout TyEnv, _ i12: Str, _ body: Vec[Nd]) using Alloc, Log {
    print(i12)
    print("return ")
    emitBoxed(env, body)
    print(";\n")
}

func armIsDefault(_ arm: Nd) -> Bool {
    return match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): isDefault || isWildcardPat(pat)
        default: false
    }
}

// The trailing `} else { return <body>; }` for a default / wildcard arm of a
// payload match (no inner scope block, unlike the if-constexpr arms).
func emitVisitDefault(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): emitVisitDefaultParts(env, i8, i12, body)
        default: noop()
    }
}

func emitVisitDefaultParts(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ body: Vec[Nd]) using Alloc, Log {
    print(i8)
    print("} else {\n")
    print(i12)
    print("return ")
    emitBoxed(env, body)
    print(";\n")
    print(i8)
    print("}\n")
}

// `auto&& <bind> = __vstr_alt.<field>;` for each payload binding in the pattern
// — <field> is the case's declared label when the payload field is named, else
// the positional `_<idx>`.
func emitPayloadBindings(_ env: inout TyEnv, _ i16: Str, _ enumName: Str, _ pat: Vec[Nd]) using Alloc, Log {
    match pat.get(0) ?? Nd.wildcard {
        case .enumP(let cname, let children): emitBindingList(env, i16, enumName, cname, children)
        default: noop()
    }
}

func emitBindingList(_ env: inout TyEnv, _ i16: Str, _ enumName: Str, _ cname: Str, _ children: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < children.len() {
        emitOneBinding(env, i16, enumName, cname, children.get(i) ?? Nd.wildcard, i)
        i = i + 1
    }
}

func emitOneBinding(_ env: inout TyEnv, _ i16: Str, _ enumName: Str, _ cname: Str, _ child: Nd, _ idx: Int) using Alloc, Log {
    let bn = patNameOf(child)
    if streq(bn, "") { return }
    print(i16)
    print("auto&& ")
    print(bn)
    print(" = __vstr_alt.")
    let fn = tyPayFieldName(env, enumName, cname, idx)
    if streq(fn, "") {
        print("_")
        print(intToStr(idx))
    } else {
        print(fn)
    }
    print(";\n")
}

func armCaseName(_ pat: Vec[Nd]) using Alloc -> String {
    if pat.len() == 0 { return own("") }
    return match pat.get(0) ?? Nd.wildcard {
        case .enumP(let cname, let children): own(cname)
        default: own("")
    }
}

// The binding name of a simple `let`/`var` pattern (identifier or `let`-binding).
func patName(_ pat: Vec[Nd]) using Alloc -> String {
    if pat.len() == 0 { return own("") }
    return patNameOf(pat.get(0) ?? Nd.wildcard)
}

func patNameOf(_ p: Nd) using Alloc -> String {
    return match p {
        case .identP(let n): own(n)
        case .bindP(let n): own(n)
        default: own("")
    }
}

// One nesting level deeper (4 more spaces of indentation).
func deeper(_ indent: Str) using Alloc -> String {
    var s: String = own(indent)
    s.append("    ")
    return s
}

func emitBoxed(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc, Log {
    if v.len() > 0 { emitExpr(env, v.get(0) ?? Nd.wildcard) }
}

func emitExpr(_ env: inout TyEnv, _ e: Nd) using Alloc, Log {
    match e {
        case .ident(let n): print(n)
        case .selfE: print("(*this)")
        case .intLit(let s): print(s)
        case .floatLit(let s): print(s)
        case .boolLit(let b): emitBool(b)
        case .charLit(let s): emitChar(s)
        case .strLit(let s): emitStr(s)
        case .paren(let inner): emitParen(env, inner)
        case .unary(let op, let x): emitUnary(env, op, x)
        case .binary(let op, let l, let r): emitBinary(env, op, l, r)
        case .call(let callee, let args): emitCall(env, callee, args)
        case .member(let base, let name, let chain): emitMember(env, base, name, chain)
        case .index(let base, let idxs): emitIndex(env, base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): emitIfE(env, ln, cond, thenB, els)
        case .vecLit(let elems): emitVecLitNoTy(env, elems)
        case .tupleLit(let elems): emitTupleLit(env, elems)
        case .interpE(let parts, let exprs): emitInterp(env, parts, exprs)
        default: print("/*?expr*/")
    }
}

// `"a \(x) b"` -> `std::format("a {} b", x)`: each literal fragment joins the
// format string (its `{` / `}` doubled — std::format escape), each splice
// contributes a `{}` and one trailing argument. The lexer guarantees a
// fragment before, between, and after splices (possibly empty), so a `{}`
// precedes every fragment but the first.
func emitInterp(_ env: inout TyEnv, _ parts: Vec[String], _ exprs: Vec[Nd]) using Alloc, Log {
    print("std::format(\"")
    var i: Int = 0
    while i < parts.len() {
        if i > 0 { print("{}") }
        if let frag = parts.get(i) { print(fmtFragment(frag)) }
        i = i + 1
    }
    print("\"")
    var j: Int = 0
    while j < exprs.len() {
        print(", ")
        emitExpr(env, exprs.get(j) ?? Nd.wildcard)
        j = j + 1
    }
    print(")")
}

// A literal fragment with std::format's brace escaping applied.
func fmtFragment(_ s: Str) using Alloc -> String {
    var out: String = ""
    var i: Int = 0
    while i < s.len() {
        let c = s.byteAt(i) ?? 0
        if c == 123 { out.append("{{") }
        else if c == 125 { out.append("}}") }
        else { out.append(s.slice(i, i + 1)) }
        i = i + 1
    }
    return out
}

// `(e0, e1, ...)` -> `std::tuple{<e0>, <e1>, ...}` — CTAD deduces the element
// types, so the lowering is context-free.
func emitTupleLit(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc, Log {
    print("std::tuple{")
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(", ") }
        emitExpr(env, elems.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print("}")
}

// `[e0, e1, ...]` -> `std::array<<elemT>, N>{<e0>, ...}`. The element type
// comes from the expected type when one is in hand (a binding annotation or
// the function's return type — the bootstrap threads it), else from the FIRST
// element's inferred type. A nested literal element threads the expected
// element type's own element.
func emitVecLit(_ env: inout TyEnv, _ elems: Vec[Nd], _ elemTy: Vec[Nd]) using Alloc, Log {
    print("std::array<")
    if elemTy.len() > 0 { emitTypeBoxed(elemTy) } else { emitInferredElemTy(env, elems) }
    print(", ")
    print(intToStr(elems.len()))
    print(">{")
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(", ") }
        emitVecElem(env, elems.get(i) ?? Nd.wildcard, elemTy)
        i = i + 1
    }
    print("}")
}

func emitVecLitNoTy(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc, Log {
    let noTy: Vec[Nd] = Vec.new()
    emitVecLit(env, elems, noTy)
}

func emitInferredElemTy(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc, Log {
    if elems.len() == 0 { return }
    print(cppOfSpelling(tyInfer(env, elems.get(0) ?? Nd.wildcard)))
}

// The C++ spelling of an inferred type spelling: `[N]T` recurses into
// std::array, anything else is the scalar mapping.
func cppOfSpelling(_ sp: String) using Alloc -> String {
    if !tyIsArray(sp) { return cppNamed(sp) }
    var s: String = "std::array<"
    s.append(cppOfSpelling(tyArrayElem(sp)))
    s.append(", ")
    s.append(tyArrayCount(sp))
    s.append(">")
    return s
}

func emitVecElem(_ env: inout TyEnv, _ e: Nd, _ elemTy: Vec[Nd]) using Alloc, Log {
    match e {
        case .vecLit(let inner): emitNestedVecLit(env, inner, elemTy)
        default: emitExpr(env, e)
    }
}

func emitNestedVecLit(_ env: inout TyEnv, _ inner: Vec[Nd], _ elemTy: Vec[Nd]) using Alloc, Log {
    let et = annElemBox(elemTy)
    emitVecLit(env, inner, et)
}

// The boxed element-type node of a boxed `[N]T` type (empty otherwise).
func annElemBox(_ ty: Vec[Nd]) using Alloc -> Vec[Nd] {
    if ty.len() == 0 { return emptyNdBox() }
    return vecElemBox(ty.get(0) ?? Nd.wildcard)
}

func vecElemBox(_ t: Nd) using Alloc -> Vec[Nd] {
    return match t {
        case .vecT(let len, let elem): elemBoxCopy(elem)
        default: emptyNdBox()
    }
}

func elemBoxCopy(_ elem: Vec[Nd]) using Alloc -> Vec[Nd] {
    var b: Vec[Nd] = Vec.new()
    if elem.len() > 0 { b.push(elem.get(0) ?? Nd.wildcard) }
    return b
}

func emptyNdBox() using Alloc -> Vec[Nd] {
    return Vec.new()
}

// An if-expression in VALUE position lowers to a parenthesized, immediately-
// invoked lambda whose branches each return their own branch lambda's value:
//
//   ([&]{ if (<cond>) { return [&]{ <then> }(); } else { return <else>; } }())
//
// where a block <else> is another branch lambda and an else-if recurses into
// the same form (parens and all). If-let (a non-empty bind name) and else-less
// ifs (never values; sema rejects them) keep the /*?expr*/ stub.
func emitIfE(_ env: inout TyEnv, _ ln: Str, _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    if !streq(ln, "") || els.len() == 0 {
        print("/*?expr*/")
        return
    }
    emitIfValue(env, cond, thenB, els)
}

func emitIfValue(_ env: inout TyEnv, _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print("([&]{ if (")
    emitBoxed(env, cond)
    print(") { return ")
    emitIfBranchLambda(env, thenB)
    print("; } else { return ")
    emitIfElseValue(env, els)
    print("; } }())")
}

// `[&]{ <branch stmts> }()` — the branch block as an invoked lambda, its
// trailing expression returned (the closure-body shape).
func emitIfBranchLambda(_ env: inout TyEnv, _ b: Vec[Nd]) using Alloc, Log {
    print("[&]{ ")
    match b.get(0) ?? Nd.wildcard {
        case .block(let stmts): emitClosureStmts(env, stmts, true)
        default: noop()
    }
    print(" }()")
}

func emitIfElseValue(_ env: inout TyEnv, _ els: Vec[Nd]) using Alloc, Log {
    match els.get(0) ?? Nd.wildcard {
        case .block(let stmts): emitIfBranchLambda(env, els)
        case .ifE(let ln, let li, let cond, let thenB, let els2): emitIfValue(env, cond, thenB, els2)
        default: noop()
    }
}

// Indexing lowers to a subscript. Container bases (Vec / Span / MutSpan) take
// std::size_t in operator[], so the (signed) index is cast: `xs[i]` ->
// `xs[static_cast<std::size_t>(i)]`; a fixed-size `[N]T` array (std::array)
// indexes plainly — the bootstrap casts only container bases. (Single-index
// only.)
func emitIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc, Log {
    let plainIdx = tyIsArray(tyInferBoxed(env, base))
    emitBoxed(env, base)
    print("[")
    if !plainIdx { print("static_cast<std::size_t>(") }
    emitBoxed(env, idxs)
    if !plainIdx { print(")") }
    print("]")
}

// Field / method access `base.name` lowers to `base.name`, EXCEPT a type-qualified
// access whose base is a capitalized identifier (an enum/type name) lowers to
// `Base::name` — this covers payload-free enum cases (`Color.red` -> `Color::red`).
// The capitalization heuristic stands in for the type info vgen lacks; values are
// lowercase by convention, so instance access is unaffected.
func emitMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str, _ chain: Bool) using Alloc, Log {
    if chain { emitChainMember(env, base, name); return }
    // A bare case of a payload-carrying enum constructs the variant:
    // `Shape.point` -> `Shape{Shape::point_t{}}`.
    let bn = identBaseName(base)
    if !streq(bn, "") && isPayloadEnum(env, bn) {
        emitPayloadCase(env, bn, name, Vec.new())
        return
    }
    // A payload-free enum case (or another capitalized type-qualified name) is
    // a scoped reference: `Color.red` -> `Color::red`.
    if baseIsCapIdent(base) {
        emitBoxed(env, base)
        print("::")
        print(name)
        return
    }
    emitBoxed(env, base)
    print(".")
    print(name)
}

// Optional-chain field access `base?.name` lowers to std::optional::transform:
// `base.transform([](auto&& __vstr_o) { return __vstr_o.<name>; })` — an
// engaged optional maps to the field, an empty one stays empty. The bootstrap's
// sema allows only a single field hop through `?.` (no method calls, no deeper
// member access), so this is the whole family.
func emitChainMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str) using Alloc, Log {
    emitBoxed(env, base)
    print(".transform([](auto&& __vstr_o) { return __vstr_o.")
    print(name)
    print("; })")
}

// An enum whose declaration has at least one payload-carrying case (so it lowers
// to the struct + std::variant form rather than an `enum class`).
func isPayloadEnum(_ env: inout TyEnv, _ name: Str) -> Bool {
    var k: Int = 0
    var isEnum: Bool = false
    while k < env.eName.len() {
        if let e = env.eName.get(k) { if streq(e, name) { isEnum = true } }
        k = k + 1
    }
    if !isEnum { return false }
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let en = env.ecEnum.get(i) {
            if streq(en, name) && (env.ecArity.get(i) ?? 0) > 0 { return true }
        }
        i = i + 1
    }
    return false
}

func identBaseName(_ base: Vec[Nd]) using Alloc -> String {
    if base.len() == 0 { return own("") }
    return match base.get(0) ?? Nd.wildcard {
        case .ident(let n): own(n)
        default: own("")
    }
}

// `Enum{Enum::case_t{<args>}}` — variant construction for a payload-enum case
// (a bare case passes an empty argument list, yielding `{}`).
func emitPayloadCase(_ env: inout TyEnv, _ enumName: Str, _ caseName: Str, _ args: Vec[Nd]) using Alloc, Log {
    print(enumName)
    print("{")
    print(enumName)
    print("::")
    print(caseName)
    print("_t{")
    emitArgList(env, args)
    print("}}")
}

func baseIsCapIdent(_ base: Vec[Nd]) -> Bool {
    if base.len() == 0 { return false }
    return match base.get(0) ?? Nd.wildcard {
        case .ident(let n): isCapitalized(n)
        default: false
    }
}

func isCapitalized(_ n: Str) -> Bool {
    if n.len() == 0 { return false }
    let c = n.byteAt(0) ?? 0
    return c >= 65 && c <= 90   // 'A'..'Z'
}

func emitBool(_ b: Bool) using Log { if b { print("true") } else { print("false") } }

// A Char literal lowers to a char32_t literal: `'x'` -> `U'x'`.
func emitChar(_ s: Str) using Alloc, Log {
    print("U'")
    print(s)
    print("'")
}

// A string literal lowers to a string_view over its (already source-escaped) text.
func emitStr(_ s: Str) using Alloc, Log {
    print("std::string_view(\"")
    print(s)
    print("\")")
}

// A call emits the callee then a parenthesized, comma-separated argument list —
// unless it is struct construction (an identifier callee with labeled arguments),
// which lowers to designated initializers `Name{.field = value, ...}`. Labeled
// calls in the curated corpus are struct constructions; method calls have a
// member callee (not an identifier) and so never match.
func emitCall(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log {
    if tryEmitPayloadCase(env, callee, args) { return }
    if isStructCtor(callee, args) { emitStructCtor(env, callee, args); return }
    let fname = identBaseName(callee)
    if tryEmitPrint(env, fname, args) { return }
    if tryEmitBuiltin(env, fname, args) { return }
    let owner = calleeMethodOwner(env, callee)
    if !streq(owner, "") {
        emitBoxed(env, callee)
        print("(")
        emitCallArgList(env, owner, calleeMemberName(callee), args)
        print(")")
        return
    }
    emitBoxed(env, callee)
    print("(")
    emitCallArgList(env, "", fname, args)
    print(")")
}

// The owner type of a method callee `base.name` — the base expression's inferred
// type spelling. "" when the callee isn't a member access or the base type is
// unknown (including a capitalized type-qualified base like `Vec.new`, whose
// ident carries no symbol type).
func calleeMethodOwner(_ env: inout TyEnv, _ callee: Vec[Nd]) using Alloc -> String {
    if callee.len() == 0 { return own("") }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): tyInferBoxed(env, base)
        default: own("")
    }
}

func calleeMemberName(_ callee: Vec[Nd]) using Alloc -> String {
    if callee.len() == 0 { return own("") }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): own(name)
        default: own("")
    }
}

// The remaining §18 builtins, each lowering to its __vstr runtime shim.
// `panic`/`abort`/`unreachable` intercept unconditionally on name + arity
// (mirroring the bootstrap emitter); `readFile`/`writeFile`/`args` only when no
// unit-defined function shadows the name.
func tryEmitBuiltin(_ env: inout TyEnv, _ fname: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if streq(fname, "panic") && args.len() == 1 {
        print("__vstr::panic(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(fname, "abort") && args.len() == 0 {
        print("__vstr::abort_fn()")
        return true
    }
    if streq(fname, "unreachable") && args.len() == 0 {
        print("__vstr::unreachable_fn()")
        return true
    }
    if tyArity(env, fname) >= 0 { return false }
    if streq(fname, "readFile") && args.len() == 1 {
        print("__vstr::read_file(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(fname, "writeFile") && args.len() == 2 {
        print("__vstr::write_file(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(", ")
        emitArg(env, args.get(1) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(fname, "args") && args.len() == 0 {
        print("__vstr::args()")
        return true
    }
    return false
}

// The print family — `print`/`println` (stdout) and `eprint`/`eprintln`
// (stderr, a leading `stderr` stream argument) — lowers to std::print /
// std::println with the text passed as a formatting ARGUMENT (`"{}"`), so a
// `{` in it is harmless. Only the builtin is intercepted: a unit-defined
// function of the same name (tyArity >= 0) emits as a plain call.
func tryEmitPrint(_ env: inout TyEnv, _ fname: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if args.len() != 1 { return false }
    let isOut = streq(fname, "print") || streq(fname, "println")
    let isErr = streq(fname, "eprint") || streq(fname, "eprintln")
    if !isOut && !isErr { return false }
    if tyArity(env, fname) >= 0 { return false }
    let ln = streq(fname, "println") || streq(fname, "eprintln")
    if ln { print("std::println(") } else { print("std::print(") }
    if isErr { print("stderr, ") }
    print("\"{}\", ")
    emitArg(env, args.get(0) ?? Nd.wildcard)
    print(")")
    return true
}

// Slices 27 + 31: a call's arguments have the callee's declared parameter types
// in hand — from the free function's signature (`owner` empty) or the method's
// signature on the base expression's inferred type — so a closure-literal
// argument can lower against the callee's function-typed parameter:
// `apply({ n => n + 1 }, 5)` / `c.apply({ n => n + 1 })` -> a `[&]` lambda.
// Any other argument (or an unnamed/unknown callee) emits as before.
func emitCallArgList(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ args: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitCallArg(env, owner, fname, i, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func emitCallArg(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ idx: Int, _ a: Nd) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitCallArgVal(env, owner, fname, idx, val)
        default: noop()
    }
}

func emitCallArgVal(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ idx: Int, _ val: Vec[Nd]) using Alloc, Log {
    if valIsClosure(val) && !streq(fname, "") {
        let tn = callArgTypeNode(env, owner, fname, idx)
        if nodeIsFnTy(tn) { emitClosureArgTy(env, tn, val); return }
    }
    let to = callArgTypeSpelling(env, owner, fname, idx)
    let from = tyInferBoxed(env, val)
    emitMaybeCoerced(env, needsStrCoercion(from, to), val)
}

func callArgTypeSpelling(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ idx: Int) using Alloc -> String {
    if !streq(owner, "") { return typeSpelling(tyMethodParamTypeNode(env, owner, fname, idx)) }
    return tyParamType(env, own(fname), idx)
}

func callArgTypeNode(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ idx: Int) using Alloc -> Nd {
    if !streq(owner, "") { return tyMethodParamTypeNode(env, owner, fname, idx) }
    return tyParamTypeNode(env, fname, idx)
}

func nodeIsFnTy(_ t: Nd) -> Bool {
    return match t {
        case .fnT(let a, let b, let c, let d): true
        default: false
    }
}

func emitClosureArgTy(_ env: inout TyEnv, _ tn: Nd, _ val: Vec[Nd]) using Alloc, Log {
    match tn {
        case .fnT(let params, let caps, let thr, let res): emitClosureVal(env, val, params, res)
        default: noop()
    }
}

// A call `Enum.case(args)` where Enum is a payload enum constructs the variant:
// `Shape.circle(r)` -> `Shape{Shape::circle_t{r}}`. Returns whether it matched
// (and emitted).
func tryEmitPayloadCase(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if callee.len() == 0 { return false }
    return tryEmitPayloadCaseNode(env, callee.get(0) ?? Nd.wildcard, args)
}

func tryEmitPayloadCaseNode(_ env: inout TyEnv, _ c: Nd, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    return match c {
        case .member(let base, let name, let chain): emitPayloadCaseIfEnum(env, base, name, args)
        default: false
    }
}

func emitPayloadCaseIfEnum(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    let bn = identBaseName(base)
    if streq(bn, "") { return false }
    if !isPayloadEnum(env, bn) { return false }
    emitPayloadCase(env, bn, name, args)
    return true
}

func isStructCtor(_ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc -> Bool {
    if !calleeIsIdent(callee) { return false }
    if args.len() == 0 { return false }
    return argHasLabel(args.get(0) ?? Nd.wildcard)
}

func calleeIsIdent(_ callee: Vec[Nd]) -> Bool {
    if callee.len() == 0 { return false }
    return match callee.get(0) ?? Nd.wildcard {
        case .ident(let n): true
        default: false
    }
}

func argHasLabel(_ a: Nd) using Alloc -> Bool {
    return match a {
        case .arg(let label, let isInout, let val): !streq(label, "")
        default: false
    }
}

func emitStructCtor(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log {
    let sn = identBaseName(callee)
    emitBoxed(env, callee)
    print("{")
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitCtorField(env, sn, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print("}")
}

func emitCtorField(_ env: inout TyEnv, _ sn: Str, _ a: Nd) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitCtorFieldParts(env, sn, label, val)
        default: noop()
    }
}

// A field initializer coerces into a String-typed field.
func emitCtorFieldParts(_ env: inout TyEnv, _ sn: Str, _ label: Str, _ val: Vec[Nd]) using Alloc, Log {
    print(".")
    print(label)
    print(" = ")
    let to = tyFieldType(env, own(sn), own(label))
    let from = tyInferBoxed(env, val)
    emitMaybeCoerced(env, needsStrCoercion(from, to), val)
}

func emitArgList(_ env: inout TyEnv, _ args: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitArg(env, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

// Slice 2: positional argument — emit its value (call labels are deferred).
func emitArg(_ env: inout TyEnv, _ a: Nd) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitBoxed(env, val)
        default: noop()
    }
}

// A closure literal `{ p => body }` lowers to a `[&]`-capturing C++ lambda:
// `[&](<ptype> p, ...) { <body> }`. Parameter types are NOT in the source — they
// come from the expected function type at the use site (here, ptypes). The body
// is a statement list whose final expression becomes the lambda's `return` (when
// the closure yields a value); earlier statements emit inline, separated by the
// `;\n` their normal emission already carries.
func emitClosure(_ env: inout TyEnv, _ cparams: Vec[Nd], _ body: Vec[Nd], _ ptypes: Vec[Nd], _ resTy: Vec[Nd]) using Alloc, Log {
    print("[&](")
    var i: Int = 0
    while i < cparams.len() {
        if i > 0 { print(", ") }
        if i < ptypes.len() { emitType(ptypes.get(i) ?? Nd.wildcard) } else { print("auto") }
        print(" ")
        print(identName(cparams.get(i) ?? Nd.ident("")))
        i = i + 1
    }
    print(") { ")
    emitClosureBody(env, body, resTy)
    print(" }")
}

func emitClosureBody(_ env: inout TyEnv, _ body: Vec[Nd], _ resTy: Vec[Nd]) using Alloc, Log {
    emitClosureStmts(env, body, closureReturnsValue(resTy))
}

// A statement list in inline-lambda position: earlier statements emit at ""
// indent (each carrying its own `;\n`); a value-yielding trailing expression
// becomes `return <expr>;` with no trailing newline. Shared by closure bodies
// and if-expression branch lambdas.
func emitClosureStmts(_ env: inout TyEnv, _ body: Vec[Nd], _ valueRet: Bool) using Alloc, Log {
    let n = body.len()
    var i: Int = 0
    while i < n {
        let s = body.get(i) ?? Nd.wildcard
        if i == n - 1 {
            emitClosureTail(env, s, valueRet)
        } else {
            emitStmt(env, s, "")
        }
        i = i + 1
    }
}

// The closure's final statement. A value-returning closure turns a trailing
// expression into `return <expr>;`; a Unit closure emits the bare statement.
func emitClosureTail(_ env: inout TyEnv, _ s: Nd, _ valueRet: Bool) using Alloc, Log {
    match s {
        case .exprS(let e): emitClosureRet(env, e, valueRet)
        default: emitStmt(env, s, "")
    }
}

func emitClosureRet(_ env: inout TyEnv, _ e: Vec[Nd], _ valueRet: Bool) using Alloc, Log {
    if valueRet { print("return ") }
    emitBoxed(env, e)
    print(";")
}

// A closure yields a value unless its expected result type is absent or Unit.
func closureReturnsValue(_ resTy: Vec[Nd]) using Alloc -> Bool {
    if resTy.len() == 0 { return false }
    return match resTy.get(0) ?? Nd.wildcard {
        case .named(let path, let hasG, let args): !streq(path, "Unit")
        default: true
    }
}

// Emit a closure binding's value when the annotation is a function type: pull the
// expected parameter/result types from the fnT and the params/body from the
// closure literal, then lower the lambda.
func emitClosureWithFnTy(_ env: inout TyEnv, _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    match ty.get(0) ?? Nd.wildcard {
        case .fnT(let params, let caps, let thr, let res): emitClosureVal(env, value, params, res)
        default: noop()
    }
}

func emitClosureVal(_ env: inout TyEnv, _ value: Vec[Nd], _ ptypes: Vec[Nd], _ resTy: Vec[Nd]) using Alloc, Log {
    match value.get(0) ?? Nd.wildcard {
        case .closureE(let cparams, let body): emitClosure(env, cparams, body, ptypes, resTy)
        default: noop()
    }
}

func valIsClosure(_ v: Vec[Nd]) using Alloc -> Bool {
    if v.len() == 0 { return false }
    return match v.get(0) ?? Nd.wildcard {
        case .closureE(let p, let b): true
        default: false
    }
}

func emitParen(_ env: inout TyEnv, _ inner: Vec[Nd]) using Alloc, Log {
    print("(")
    emitBoxed(env, inner)
    print(")")
}

// `!` is ambiguous in the AST: prefix logical-not and postfix force-unwrap both
// parse as unary("!", _). Type inference disambiguates — an Optional operand is a
// force-unwrap (`x!` -> __vstr::unwrap_opt(x)), anything else is logical-not.
func emitUnary(_ env: inout TyEnv, _ op: Str, _ x: Vec[Nd]) using Alloc, Log {
    if streq(op, "!") && tyIsOptional(tyInferBoxed(&env, x)) {
        print("__vstr::unwrap_opt(")
        emitBoxed(env, x)
        print(")")
        return
    }
    print(op)
    emitBoxed(env, x)
}

func tyIsOptional(_ sp: Str) -> Bool {
    if sp.len() == 0 { return false }
    return (sp.byteAt(sp.len() - 1) ?? 0) == 63   // ends with '?'
}

// Most binary operators pass through (`a + b`, `a == b`, `a && b`); nil-coalescing
// `l ?? r` lowers to `(l).value_or(r)`.
func emitBinary(_ env: inout TyEnv, _ op: Str, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc, Log {
    if streq(op, "??") { emitCoalesce(env, l, r); return }
    emitBoxed(env, l)
    print(" ")
    print(op)
    print(" ")
    emitBoxed(env, r)
}

func emitCoalesce(_ env: inout TyEnv, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc, Log {
    print("(")
    emitBoxed(env, l)
    print(").value_or(")
    emitBoxed(env, r)
    print(")")
}

// Basename of the input path without its `.vst` extension (the `.hpp`/`.cpp` stem).
func stemOf(_ path: Str) using Alloc -> String {
    var start: Int = 0
    var i: Int = 0
    while i < path.len() {
        if (path.byteAt(i) ?? 0) == 47 { start = i + 1 }   // '/' == 47
        i = i + 1
    }
    var base: String = own(path.slice(start, path.len()))
    let n = base.len()
    if n >= 4 {
        if streq(own(base.slice(n - 4, n)), ".vst") { return own(base.slice(0, n - 4)) }
    }
    return base
}

func main() -> Int32 {
    with Alloc {
        with Fs {
            with Log {
                let argv = args()
                if argv.len() < 2 {
                    eprintln("usage: vgen [--hpp] <file.vst>")
                    return 1
                }
                // `vgen --hpp FILE` emits the header tail (declarations);
                // `vgen FILE` emits the source definitions.
                var hppMode: Bool = false
                var path: String = own(argv.get(1) ?? "")
                if streq(path, "--hpp") {
                    if argv.len() < 3 { eprintln("usage: vgen [--hpp] <file.vst>"); return 1 }
                    hppMode = true
                    path = own(argv.get(2) ?? "")
                }
                if let src = readFile(path) {
                    let toks = tokenize(src)
                    var p = Ps(toks: toks, pos: 0)
                    let u = parseUnit(&p)
                    if hppMode { emitHpp(u) } else { emitUnit(u, stemOf(path)) }
                    return 0
                }
                eprintln("read failed")
                return 1
            }
        }
    }
}
