// The dog-food compiler, phase 4: the Vestra C++ code generator, written in
// Vestra. It reuses the self-hosted lexer + parser (the front of this file is a
// copy of selfhost/parser.vst), then emits C++ from the AST, differentially
// tested against `vestra build`:
//
//   vgen <file.vst>    prints the generated C++ *definitions* (the `.cpp` body)
//                      to stdout.
//
// The contract is the emitted `.cpp` text: the e2e runs `vestra build` to produce
// <stem>.cpp and diffs it against vgen's stdout. The huge fixed runtime prelude
// and the per-program forward declarations live in the `.hpp`, which a later
// slice can mirror; this phase focuses on the definitions the codegen actually
// generates per construct.
//
// Slice 1 scope: free functions with explicitly-typed read-mode parameters and
// bodies of plain `return` statements over identifiers, integer literals, and
// binary / parenthesized expressions. Builtin scalar types map to their C++
// spellings (Int32 -> std::int32_t, Unit -> void, ...). Richer constructs are
// added slice by slice; the AST and parser below are unchanged from
// selfhost/parser.vst.

// ---------------------------------------------------------------------------
// The real token kinds (mirrors include/vestra/lex/token.hpp).
// ---------------------------------------------------------------------------
enum TokKind {
    // bookkeeping
    case eof
    case error
    case newline
    // literals
    case intLit
    case floatLit
    case stringLit
    case byteStringLit
    case charLit
    case identifier
    case interpBegin
    case interpPart
    case interpEnd
    // punctuation
    case lparen
    case rparen
    case lbrace
    case rbrace
    case lbracket
    case rbracket
    case comma
    case semicolon
    case colon
    case dot
    case dotDot
    case dotDotLt
    case arrow
    case fatArrow
    case at
    case dollar
    case question
    case underscore
    // operators
    case plus
    case minus
    case star
    case slash
    case percent
    case ampPlus
    case ampMinus
    case ampStar
    case amp
    case pipe
    case caret
    case tilde
    case bang
    case shiftL
    case shiftR
    case assign
    case plusEq
    case minusEq
    case starEq
    case slashEq
    case percentEq
    case ampEq
    case pipeEq
    case caretEq
    case shiftLEq
    case shiftREq
    case eqEq
    case bangEq
    case lt
    case gt
    case ltEq
    case gtEq
    case ampAmp
    case pipePipe
    case questionQuestion
    // keywords
    case kwModule
    case kwImport
    case kwFunc
    case kwStruct
    case kwEnum
    case kwProtocol
    case kwExtension
    case kwOpaque
    case kwType
    case kwEmbed
    case kwDeinit
    case kwLet
    case kwVar
    case kwConst
    case kwStatic
    case kwReturn
    case kwIf
    case kwElse
    case kwMatch
    case kwCase
    case kwDefault
    case kwFor
    case kwIn
    case kwWhile
    case kwBreak
    case kwContinue
    case kwWhere
    case kwDo
    case kwCatch
    case kwThrow
    case kwThrows
    case kwWith
    case kwUsing
    case kwAsync
    case kwAwait
    case kwSpawn
    case kwSelect
    case kwOn
    case kwComptime
    case kwQuote
    case kwCopy
    case kwRead
    case kwInout
    case kwSink
    case kwNonescaping
    case kwSome
    case kwDyn
    case kwLinear
    case kwTry
    case kwTryQuestion
    case kwTryBang
    case kwAs
    case kwAsQuestion
    case kwDerive
    case kwTrue
    case kwFalse
    case kwNil
    case kwSelfLower
    case kwSelfUpper
    case kwPrivate
    case kwInternal
    case kwPackage
    case kwPublic
}

struct Token {
    let kind: TokKind
    let text: Str
}

// The scanner state, threaded by inout through the scan functions.
struct Lex {
    var src: Str
    var pos: Int
    var depth: Int
    var prevOp: Bool
}

// ---------------------------------------------------------------------------
// Token spelling — the exact strings the C++ `spelling()` returns (token.cpp).
// ---------------------------------------------------------------------------
func spelling(_ k: TokKind) -> Str {
    return match k {
        case .eof: "<eof>"
        case .error: "<error>"
        case .newline: "<newline>"
        case .intLit: "integer literal"
        case .floatLit: "float literal"
        case .stringLit: "string literal"
        case .byteStringLit: "byte string literal"
        case .charLit: "character literal"
        case .identifier: "identifier"
        case .interpBegin: "<interp string begin>"
        case .interpPart: "interp string fragment"
        case .interpEnd: "<interp string end>"
        case .lparen: "("
        case .rparen: ")"
        case .lbrace: "{"
        case .rbrace: "}"
        case .lbracket: "["
        case .rbracket: "]"
        case .comma: ","
        case .semicolon: ";"
        case .colon: ":"
        case .dot: "."
        case .dotDot: ".."
        case .dotDotLt: "..<"
        case .arrow: "->"
        case .fatArrow: "=>"
        case .at: "@"
        case .dollar: "$"
        case .question: "?"
        case .underscore: "_"
        case .plus: "+"
        case .minus: "-"
        case .star: "*"
        case .slash: "/"
        case .percent: "%"
        case .ampPlus: "&+"
        case .ampMinus: "&-"
        case .ampStar: "&*"
        case .amp: "&"
        case .pipe: "|"
        case .caret: "^"
        case .tilde: "~"
        case .bang: "!"
        case .shiftL: "<<"
        case .shiftR: ">>"
        case .assign: "="
        case .plusEq: "+="
        case .minusEq: "-="
        case .starEq: "*="
        case .slashEq: "/="
        case .percentEq: "%="
        case .ampEq: "&="
        case .pipeEq: "|="
        case .caretEq: "^="
        case .shiftLEq: "<<="
        case .shiftREq: ">>="
        case .eqEq: "=="
        case .bangEq: "!="
        case .lt: "<"
        case .gt: ">"
        case .ltEq: "<="
        case .gtEq: ">="
        case .ampAmp: "&&"
        case .pipePipe: "||"
        case .questionQuestion: "??"
        case .kwModule: "module"
        case .kwImport: "import"
        case .kwFunc: "func"
        case .kwStruct: "struct"
        case .kwEnum: "enum"
        case .kwProtocol: "protocol"
        case .kwExtension: "extension"
        case .kwOpaque: "opaque"
        case .kwType: "type"
        case .kwEmbed: "embed"
        case .kwDeinit: "deinit"
        case .kwLet: "let"
        case .kwVar: "var"
        case .kwConst: "const"
        case .kwStatic: "static"
        case .kwReturn: "return"
        case .kwIf: "if"
        case .kwElse: "else"
        case .kwMatch: "match"
        case .kwCase: "case"
        case .kwDefault: "default"
        case .kwFor: "for"
        case .kwIn: "in"
        case .kwWhile: "while"
        case .kwBreak: "break"
        case .kwContinue: "continue"
        case .kwWhere: "where"
        case .kwDo: "do"
        case .kwCatch: "catch"
        case .kwThrow: "throw"
        case .kwThrows: "throws"
        case .kwWith: "with"
        case .kwUsing: "using"
        case .kwAsync: "async"
        case .kwAwait: "await"
        case .kwSpawn: "spawn"
        case .kwSelect: "select"
        case .kwOn: "on"
        case .kwComptime: "comptime"
        case .kwQuote: "quote"
        case .kwCopy: "copy"
        case .kwRead: "read"
        case .kwInout: "inout"
        case .kwSink: "sink"
        case .kwNonescaping: "nonescaping"
        case .kwSome: "some"
        case .kwDyn: "dyn"
        case .kwLinear: "linear"
        case .kwTry: "try"
        case .kwTryQuestion: "try?"
        case .kwTryBang: "try!"
        case .kwAs: "as"
        case .kwAsQuestion: "as?"
        case .kwDerive: "derive"
        case .kwTrue: "true"
        case .kwFalse: "false"
        case .kwNil: "nil"
        case .kwSelfLower: "self"
        case .kwSelfUpper: "Self"
        case .kwPrivate: "private"
        case .kwInternal: "internal"
        case .kwPackage: "package"
        case .kwPublic: "public"
    }
}

// The §3 binary-operator set: a newline right after one of these is suppressed
// (mirrors is_binary_operator in lexer.cpp). Unary !, ~, ? are NOT included.
func isBinOp(_ k: TokKind) -> Bool {
    return match k {
        case .plus: true
        case .minus: true
        case .star: true
        case .slash: true
        case .percent: true
        case .ampPlus: true
        case .ampMinus: true
        case .ampStar: true
        case .amp: true
        case .pipe: true
        case .caret: true
        case .shiftL: true
        case .shiftR: true
        case .eqEq: true
        case .bangEq: true
        case .lt: true
        case .gt: true
        case .ltEq: true
        case .gtEq: true
        case .ampAmp: true
        case .pipePipe: true
        case .questionQuestion: true
        case .assign: true
        case .plusEq: true
        case .minusEq: true
        case .starEq: true
        case .slashEq: true
        case .percentEq: true
        case .ampEq: true
        case .pipeEq: true
        case .caretEq: true
        case .shiftLEq: true
        case .shiftREq: true
        case .arrow: true
        case .fatArrow: true
        case .comma: true
        case .colon: true
        case .dotDot: true
        case .dotDotLt: true
        default: false
    }
}

// The §17.1 keyword table. `try` / `as` map to their base kind here; the `?` / `!`
// suffixes are folded in by the identifier scanner.
func keywordKind(_ s: Str) -> TokKind {
    return match s {
        case "module": TokKind.kwModule
        case "import": TokKind.kwImport
        case "func": TokKind.kwFunc
        case "struct": TokKind.kwStruct
        case "enum": TokKind.kwEnum
        case "protocol": TokKind.kwProtocol
        case "extension": TokKind.kwExtension
        case "opaque": TokKind.kwOpaque
        case "type": TokKind.kwType
        case "embed": TokKind.kwEmbed
        case "deinit": TokKind.kwDeinit
        case "let": TokKind.kwLet
        case "var": TokKind.kwVar
        case "const": TokKind.kwConst
        case "static": TokKind.kwStatic
        case "return": TokKind.kwReturn
        case "if": TokKind.kwIf
        case "else": TokKind.kwElse
        case "match": TokKind.kwMatch
        case "case": TokKind.kwCase
        case "default": TokKind.kwDefault
        case "for": TokKind.kwFor
        case "in": TokKind.kwIn
        case "while": TokKind.kwWhile
        case "break": TokKind.kwBreak
        case "continue": TokKind.kwContinue
        case "where": TokKind.kwWhere
        case "do": TokKind.kwDo
        case "catch": TokKind.kwCatch
        case "throw": TokKind.kwThrow
        case "throws": TokKind.kwThrows
        case "with": TokKind.kwWith
        case "using": TokKind.kwUsing
        case "async": TokKind.kwAsync
        case "await": TokKind.kwAwait
        case "spawn": TokKind.kwSpawn
        case "select": TokKind.kwSelect
        case "on": TokKind.kwOn
        case "comptime": TokKind.kwComptime
        case "quote": TokKind.kwQuote
        case "copy": TokKind.kwCopy
        case "read": TokKind.kwRead
        case "inout": TokKind.kwInout
        case "sink": TokKind.kwSink
        case "nonescaping": TokKind.kwNonescaping
        case "some": TokKind.kwSome
        case "dyn": TokKind.kwDyn
        case "linear": TokKind.kwLinear
        case "try": TokKind.kwTry
        case "as": TokKind.kwAs
        case "derive": TokKind.kwDerive
        case "true": TokKind.kwTrue
        case "false": TokKind.kwFalse
        case "nil": TokKind.kwNil
        case "self": TokKind.kwSelfLower
        case "Self": TokKind.kwSelfUpper
        case "private": TokKind.kwPrivate
        case "internal": TokKind.kwInternal
        case "package": TokKind.kwPackage
        case "public": TokKind.kwPublic
        default: TokKind.identifier
    }
}

// ---------------------------------------------------------------------------
// ASCII character classes — written out to match the C++ predicates exactly
// (rather than relying on Char.isAlpha, which could differ on non-ASCII).
// ---------------------------------------------------------------------------
func isDigitC(_ c: Char) -> Bool { return c >= '0' && c <= '9' }
func isHexC(_ c: Char) -> Bool {
    return isDigitC(c) || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')
}
func isOctC(_ c: Char) -> Bool { return c >= '0' && c <= '7' }
func isBinC(_ c: Char) -> Bool { return c == '0' || c == '1' }
func isIdStartC(_ c: Char) -> Bool {
    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_'
}
func isIdContC(_ c: Char) -> Bool { return isIdStartC(c) || isDigitC(c) }

// Byte-wise string equality (avoids the Str-vs-StrConst operator mismatch).
func streq(_ a: Str, _ b: Str) -> Bool {
    if a.len() != b.len() { return false }
    var i: Int = 0
    while i < a.len() {
        if (a.byteAt(i) ?? 0) != (b.byteAt(i) ?? 0) { return false }
        i = i + 1
    }
    return true
}

// ---------------------------------------------------------------------------
// Cursor primitives over the Lex state.
// ---------------------------------------------------------------------------
func atC(_ src: Str, _ i: Int) -> Char {
    if i >= src.len() { return '\0' }
    return src.charAt(i) ?? '\0'
}
func curC(_ l: Lex) -> Char { return atC(l.src, l.pos) }
func aheadC(_ l: Lex, _ n: Int) -> Char { return atC(l.src, l.pos + n) }
func atEndL(_ l: Lex) -> Bool { return l.pos >= l.src.len() }
func advC(_ l: inout Lex) { l.pos = l.pos + 1 }
func bumpC(_ l: inout Lex) -> Char {
    let c = curC(l)
    l.pos = l.pos + 1
    return c
}
func eatC(_ l: inout Lex, _ expected: Char) -> Bool {
    if curC(l) == expected {
        l.pos = l.pos + 1
        return true
    }
    return false
}

// Emit a token spanning [start, pos); records whether it was a binary operator
// so the next newline knows whether to continue the statement.
func emitTok(_ toks: inout Vec[Token], _ l: inout Lex, _ k: TokKind, _ start: Int) using Alloc {
    let bin = isBinOp(k)
    toks.push(Token(kind: k, text: l.src.slice(start, l.pos)))
    l.prevOp = bin
}

// Does the next significant char (past horizontal whitespace, blank lines, and
// line comments) begin a binary operator? Then the pending newline continues.
func nextStartsWithOperator(_ src: Str, _ scanStart: Int) -> Bool {
    var scan: Int = scanStart
    var go: Bool = true
    while go && scan < src.len() {
        let d = atC(src, scan)
        if d == ' ' || d == '\t' || d == '\r' || d == '\n' {
            scan = scan + 1
        } else if d == '/' && atC(src, scan + 1) == '/' {
            while scan < src.len() && atC(src, scan) != '\n' { scan = scan + 1 }
        } else {
            go = false
        }
    }
    if scan < src.len() {
        let d = atC(src, scan)
        return d == '+' || d == '-' || d == '*' || d == '/' || d == '%'
            || d == '|' || d == '^' || d == '?' || d == '.'
    }
    return false
}

// /* ... */ with §3 nesting.
func scanBlockComment(_ l: inout Lex) {
    var depth: Int = 1
    while depth > 0 && !atEndL(l) {
        if curC(l) == '/' && aheadC(l, 1) == '*' {
            advC(&l)
            advC(&l)
            depth = depth + 1
        } else if curC(l) == '*' && aheadC(l, 1) == '/' {
            advC(&l)
            advC(&l)
            depth = depth - 1
        } else {
            advC(&l)
        }
    }
}

// Skip whitespace and comments, emitting Newline tokens where they terminate a
// statement (§3 continuation rules).
func skipTrivia(_ toks: inout Vec[Token], _ l: inout Lex) using Alloc {
    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        if c == ' ' || c == '\t' || c == '\r' {
            advC(&l)
        } else if c == '\n' {
            let nlStart = l.pos
            advC(&l)
            if l.depth > 0 || l.prevOp {
                // continuation: newline suppressed
            } else if !nextStartsWithOperator(l.src, l.pos) {
                toks.push(Token(kind: TokKind.newline, text: l.src.slice(nlStart, nlStart + 1)))
            }
        } else if c == '/' && aheadC(l, 1) == '/' {
            while !atEndL(l) && curC(l) != '\n' { advC(&l) }
        } else if c == '/' && aheadC(l, 1) == '*' {
            advC(&l)
            advC(&l)
            scanBlockComment(&l)
        } else {
            go = false
        }
    }
}

// Consume a run of digits (and `_` separators) in the given base.
func eatDigits(_ l: inout Lex, _ base: Int) {
    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        var ok: Bool = false
        if base == 16 { ok = isHexC(c) }
        else if base == 8 { ok = isOctC(c) }
        else if base == 2 { ok = isBinC(c) }
        else { ok = isDigitC(c) }
        if ok || c == '_' { advC(&l) } else { go = false }
    }
}

func scanNumber(_ toks: inout Vec[Token], _ l: inout Lex, _ start: Int) using Alloc {
    var isFloat: Bool = false
    let first = atC(l.src, start)
    let c1 = curC(l)
    if first == '0' && (c1 == 'x' || c1 == 'o' || c1 == 'b') {
        let base = bumpC(&l)
        if base == 'x' { eatDigits(&l, 16) }
        else if base == 'o' { eatDigits(&l, 8) }
        else { eatDigits(&l, 2) }
    } else {
        eatDigits(&l, 10)
        if curC(l) == '.' && isDigitC(aheadC(l, 1)) {
            isFloat = true
            advC(&l)
            eatDigits(&l, 10)
        }
        if curC(l) == 'e' || curC(l) == 'E' {
            isFloat = true
            advC(&l)
            if curC(l) == '+' || curC(l) == '-' { advC(&l) }
            eatDigits(&l, 10)
        }
    }
    var k: TokKind = TokKind.intLit
    if isFloat { k = TokKind.floatLit }
    emitTok(&toks, &l, k, start)
}

func scanIdentifier(_ toks: inout Vec[Token], _ l: inout Lex, _ start: Int) using Alloc {
    while !atEndL(l) && isIdContC(curC(l)) { advC(&l) }
    let lex = l.src.slice(start, l.pos)
    var kind = keywordKind(lex)
    if streq(lex, "try") {
        if curC(l) == '?' { advC(&l); kind = TokKind.kwTryQuestion }
        else if curC(l) == '!' { advC(&l); kind = TokKind.kwTryBang }
    } else if streq(lex, "as") && curC(l) == '?' {
        advC(&l)
        kind = TokKind.kwAsQuestion
    }
    if streq(lex, "_") { kind = TokKind.underscore }
    emitTok(&toks, &l, kind, start)
}

// §4 interpolation: pick up the next literal fragment after the opening `"` of an
// interpolated string or the `)` that closed a splice. Emit the fragment as an
// InterpStringPart, then either close on `"` (part + InterpStringEnd) or split on
// `\(` (part + LParen, push the splice's bracket depth, and return so the main loop
// runs the splice body). The `)` that closes the splice resumes us via the main
// loop. The splice-opening LParen carries the two-char lexeme `\(`, matching the
// C++ lexer; InterpStringBegin / End each carry the `"`.
func scanInterpContinue(_ toks: inout Vec[Token], _ l: inout Lex, _ splices: inout Vec[Int]) using Alloc {
    let fragStart = l.pos
    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        if c == '"' {
            emitTok(&toks, &l, TokKind.interpPart, fragStart)
            let endStart = l.pos
            advC(&l)
            emitTok(&toks, &l, TokKind.interpEnd, endStart)
            return
        }
        if c == '\\' && aheadC(l, 1) == '(' {
            emitTok(&toks, &l, TokKind.interpPart, fragStart)
            let markerStart = l.pos
            advC(&l)
            advC(&l)
            l.depth = l.depth + 1
            splices.push(l.depth)
            emitTok(&toks, &l, TokKind.lparen, markerStart)
            return
        }
        if c == '\\' {
            advC(&l)
            if !atEndL(l) { advC(&l) }
        } else if c == '\n' {
            emitTok(&toks, &l, TokKind.error, fragStart)
            return
        } else {
            advC(&l)
        }
    }
    emitTok(&toks, &l, TokKind.error, fragStart)
}

// String / byte string. Regular strings are pre-scanned for a `\(` splice: if one
// is present the literal lexes as InterpStringBegin + (Part / splice tokens)* +
// InterpStringEnd; otherwise it is a single StringLit. Byte strings (§17.1) never
// interpolate.
func scanString(_ toks: inout Vec[Token], _ l: inout Lex, _ splices: inout Vec[Int], _ start: Int, _ isByte: Bool) using Alloc {
    if !isByte {
        let saved = l.pos
        var hasSplice: Bool = false
        var scan: Bool = true
        while scan && !atEndL(l) {
            let c = curC(l)
            if c == '"' || c == '\n' {
                scan = false
            } else if c == '\\' {
                if aheadC(l, 1) == '(' {
                    hasSplice = true
                    scan = false
                } else {
                    advC(&l)
                    if !atEndL(l) { advC(&l) }
                }
            } else {
                advC(&l)
            }
        }
        l.pos = saved
        if hasSplice {
            emitTok(&toks, &l, TokKind.interpBegin, start)
            scanInterpContinue(&toks, &l, &splices)
            return
        }
    }

    var go: Bool = true
    while go && !atEndL(l) {
        let c = curC(l)
        if c == '"' {
            advC(&l)
            var k: TokKind = TokKind.stringLit
            if isByte { k = TokKind.byteStringLit }
            emitTok(&toks, &l, k, start)
            return
        }
        if c == '\\' {
            advC(&l)
            if !atEndL(l) { advC(&l) }
        } else if c == '\n' {
            emitTok(&toks, &l, TokKind.error, start)
            return
        } else {
            advC(&l)
        }
    }
    emitTok(&toks, &l, TokKind.error, start)
}

func scanChar(_ toks: inout Vec[Token], _ l: inout Lex, _ start: Int) using Alloc {
    if curC(l) == '\\' {
        advC(&l)
        if !atEndL(l) { advC(&l) }
    } else if !atEndL(l) && curC(l) != '\'' {
        advC(&l)
    }
    if curC(l) != '\'' {
        emitTok(&toks, &l, TokKind.error, start)
        return
    }
    advC(&l)
    emitTok(&toks, &l, TokKind.charLit, start)
}

// The main scan loop: skip trivia, dispatch on the first char, append Eof.
func tokenize(_ src: Str) using Alloc -> Vec[Token] {
    var l = Lex(src: src, pos: 0, depth: 0, prevOp: false)
    var toks: Vec[Token] = Vec.new()
    var splices: Vec[Int] = Vec.new()
    while !atEndL(l) {
        skipTrivia(&toks, &l)
        if atEndL(l) { return finish(&toks, &l) }
        let start = l.pos
        let c = bumpC(&l)
        if c == '(' { l.depth = l.depth + 1; emitTok(&toks, &l, TokKind.lparen, start) }
        else if c == ')' {
            l.depth = l.depth - 1
            emitTok(&toks, &l, TokKind.rparen, start)
            // §4: a `)` that drops bracket depth below the current splice's level
            // closes the splice and resumes the surrounding string fragment.
            if splices.len() > 0 && l.depth < (splices.get(splices.len() - 1) ?? 0) {
                let _ = splices.pop()
                scanInterpContinue(&toks, &l, &splices)
            }
        }
        else if c == '[' { l.depth = l.depth + 1; emitTok(&toks, &l, TokKind.lbracket, start) }
        else if c == ']' { l.depth = l.depth - 1; emitTok(&toks, &l, TokKind.rbracket, start) }
        else if c == '{' { l.depth = l.depth + 1; emitTok(&toks, &l, TokKind.lbrace, start) }
        else if c == '}' { l.depth = l.depth - 1; emitTok(&toks, &l, TokKind.rbrace, start) }
        else if c == ',' { emitTok(&toks, &l, TokKind.comma, start) }
        else if c == ';' { emitTok(&toks, &l, TokKind.semicolon, start) }
        else if c == '@' { emitTok(&toks, &l, TokKind.at, start) }
        else if c == '$' { emitTok(&toks, &l, TokKind.dollar, start) }
        else if c == '~' { emitTok(&toks, &l, TokKind.tilde, start) }
        else if c == ':' { emitTok(&toks, &l, TokKind.colon, start) }
        else if c == '.' {
            if eatC(&l, '.') {
                if eatC(&l, '<') { emitTok(&toks, &l, TokKind.dotDotLt, start) }
                else { emitTok(&toks, &l, TokKind.dotDot, start) }
            } else { emitTok(&toks, &l, TokKind.dot, start) }
        }
        else if c == '?' {
            if eatC(&l, '?') { emitTok(&toks, &l, TokKind.questionQuestion, start) }
            else { emitTok(&toks, &l, TokKind.question, start) }
        }
        else if c == '+' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.plusEq, start) }
            else { emitTok(&toks, &l, TokKind.plus, start) }
        }
        else if c == '-' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.minusEq, start) }
            else if eatC(&l, '>') { emitTok(&toks, &l, TokKind.arrow, start) }
            else { emitTok(&toks, &l, TokKind.minus, start) }
        }
        else if c == '*' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.starEq, start) }
            else { emitTok(&toks, &l, TokKind.star, start) }
        }
        else if c == '/' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.slashEq, start) }
            else { emitTok(&toks, &l, TokKind.slash, start) }
        }
        else if c == '%' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.percentEq, start) }
            else { emitTok(&toks, &l, TokKind.percent, start) }
        }
        else if c == '^' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.caretEq, start) }
            else { emitTok(&toks, &l, TokKind.caret, start) }
        }
        else if c == '&' {
            if eatC(&l, '&') { emitTok(&toks, &l, TokKind.ampAmp, start) }
            else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.ampEq, start) }
            else if eatC(&l, '+') { emitTok(&toks, &l, TokKind.ampPlus, start) }
            else if eatC(&l, '-') { emitTok(&toks, &l, TokKind.ampMinus, start) }
            else if eatC(&l, '*') { emitTok(&toks, &l, TokKind.ampStar, start) }
            else { emitTok(&toks, &l, TokKind.amp, start) }
        }
        else if c == '|' {
            if eatC(&l, '|') { emitTok(&toks, &l, TokKind.pipePipe, start) }
            else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.pipeEq, start) }
            else { emitTok(&toks, &l, TokKind.pipe, start) }
        }
        else if c == '=' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.eqEq, start) }
            else if eatC(&l, '>') { emitTok(&toks, &l, TokKind.fatArrow, start) }
            else { emitTok(&toks, &l, TokKind.assign, start) }
        }
        else if c == '!' {
            if eatC(&l, '=') { emitTok(&toks, &l, TokKind.bangEq, start) }
            else { emitTok(&toks, &l, TokKind.bang, start) }
        }
        else if c == '<' {
            if eatC(&l, '<') {
                if eatC(&l, '=') { emitTok(&toks, &l, TokKind.shiftLEq, start) }
                else { emitTok(&toks, &l, TokKind.shiftL, start) }
            } else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.ltEq, start) }
            else { emitTok(&toks, &l, TokKind.lt, start) }
        }
        else if c == '>' {
            if eatC(&l, '>') {
                if eatC(&l, '=') { emitTok(&toks, &l, TokKind.shiftREq, start) }
                else { emitTok(&toks, &l, TokKind.shiftR, start) }
            } else if eatC(&l, '=') { emitTok(&toks, &l, TokKind.gtEq, start) }
            else { emitTok(&toks, &l, TokKind.gt, start) }
        }
        else if c == '"' { scanString(&toks, &l, &splices, start, false) }
        else if c == '\'' { scanChar(&toks, &l, start) }
        else if c == 'b' && curC(l) == '"' { advC(&l); scanString(&toks, &l, &splices, start, true) }
        else if isDigitC(c) { scanNumber(&toks, &l, start) }
        else if isIdStartC(c) { scanIdentifier(&toks, &l, start) }
        else { emitTok(&toks, &l, TokKind.error, start) }
    }
    return finish(&toks, &l)
}

// Append the final Eof token (empty lexeme) and hand back the stream.
func finish(_ toks: inout Vec[Token], _ l: inout Lex) using Alloc -> Vec[Token] {
    let n = l.src.len()
    toks.push(Token(kind: TokKind.eof, text: l.src.slice(n, n)))
    return toks
}

// ===========================================================================
// One self-recursive node type. Folding expressions, statements, types, patterns,
// params, and decls into a single enum avoids mutual recursion between separate
// enums (which the transpiler can't forward-declare); self-recursion through
// Vec[Nd] lowers cleanly. Children are boxed as one-element Vec[Nd]; lists are
// many-element Vec[Nd]. Operator / visibility tags are stored as their already-
// printable strings, so the printer just emits them.
// ===========================================================================
enum Nd {
    // expressions
    case intLit(String)
    case floatLit(String)
    case strLit(String)                     // text without the surrounding quotes
    case byteStrLit(String)                 // text without b"…"
    case charLit(String)                    // text without the quotes
    case boolLit(Bool)
    case nilLit
    case ident(String)
    case selfE
    case leadingDot(String)
    case paren(Vec[Nd])                     // inner (boxed)
    case unary(String, Vec[Nd])             // op string, operand
    case binary(String, Vec[Nd], Vec[Nd])
    case call(Vec[Nd], Vec[Nd])             // callee (boxed), args (each an .arg)
    case arg(String, Bool, Vec[Nd])         // label, is_inout, value (only as a call arg)
    case member(Vec[Nd], String, Bool)      // base, name, is_optional_chain
    case index(Vec[Nd], Vec[Nd])            // base (boxed), indices
    case ifE(String, Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd]) // letName, letInit, cond, then, else
    case block(Vec[Nd])                     // statements
    case asE(Vec[Nd], Vec[Nd], Bool)        // value, target type, is_optional
    case addrOf(Vec[Nd])
    case matchE(Vec[Nd], Vec[Nd])           // scrutinee (boxed), arms — still prints /*?expr*/ (no C++ printer case), but carries the match for sema
    case matchArm(Bool, Vec[Nd], Vec[Nd], Vec[Nd]) // isDefault, pattern (empty if default), guard (empty if none), body — all boxed
    case exoticE                            // comptime, closure, select, etc — /*?expr*/
    case intrT(Vec[Nd])                     // §A8 `@interrupt(T)` vector-table slot type: the trap-frame type (printed /*?type*/)
    case vecLit(Vec[Nd])                    // [e1, e2, ...] array/vector literal — prints /*?expr*/ (no C++ case), carries elements for sema
    case tupleLit(Vec[Nd])                  // (e1, e2, ...) tuple literal — prints /*?expr*/ (no C++ case), carries elements for sema
    case closureE(Vec[Nd], Vec[Nd])         // { params => body } — params (ident nodes) + body stmts; prints /*?expr*/ (no C++ case), carries both for sema
    case interpE(Vec[String], Vec[Nd])      // "...\(e)..." interpolated string — prints /*?expr*/ (no C++ case), carries the embedded exprs for sema
    case throwE(Vec[Nd])                    // throw OPERAND — also prints /*?expr*/ (no C++ printer case), but carries the operand for sema
    case prefixE(String, Vec[Nd])           // copy / await / spawn / try (kw string), operand — printed fully
    case doCatchE(Vec[Nd], String, Vec[Nd], Vec[Nd]) // doBody, errName, errType?, catchBody
    case quoteE(Vec[Nd])                     // quote { EXPR } — printed fully
    case spliceE(Bool, Vec[Nd])              // isBareIdent, inner — $ident or $(expr)
    // statements
    case letS(Vec[Nd], Vec[Nd], Vec[Nd])    // pattern, type?, value
    case varS(Vec[Nd], Vec[Nd], Vec[Nd])
    case exprS(Vec[Nd])
    case retS(Vec[Nd])                       // value?
    case assignS(String, Vec[Nd], Vec[Nd])   // op, target, value
    case whileS(Vec[Nd], Vec[Nd])            // cond, body (block)
    case forS(Vec[Nd], Vec[Nd], Vec[Nd])     // pattern, iter, body (block)
    case breakS(String)                      // label ("" if none)
    case continueS(String)
    case withS(Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd])  // grant-only cap types, binding names (parallel to values; "" = capability instance), binding values, binding annotations (parallel; wildcard = none), body (printed /*?stmt*/)
    // patterns
    case wildcard
    case identP(String)
    case bindP(String)
    case litP(Vec[Nd])                       // literal pattern (boxed expr)
    case enumP(String, Vec[Nd])              // case name, children patterns
    case tupleP(Vec[Nd])                     // printed /*?pat*/
    case rangeP(Vec[Nd], Vec[Nd], Bool)      // printed /*?pat*/
    case orP(Vec[Nd])                        // printed /*?pat*/
    // types
    case named(String, Bool, Vec[Nd])        // path, hasGenerics, type args
    case opt(Vec[Nd])                        // inner type (boxed)
    case someT(Vec[Nd])                      // some T
    case dynT(Vec[Nd])                       // dyn T
    case vecT(String, Vec[Nd])               // length (int or ident string), element
    case tupleT(Vec[Nd])                     // (T, U, ...)
    case fnT(Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd]) // params, usingCaps, throws?, result?
    // generic parameters (printed on funcs; parsed-and-dropped on structs/enums)
    case genConst(String, Vec[Nd])           // name, const type
    case genType(String, Vec[Nd])            // name, bounds (types joined by " & ")
    // a function parameter
    case param(Bool, String, String, Bool, String, Vec[Nd], Vec[Nd]) // labelOmitted, label, name, nonesc, mode, type, tuple pattern (empty unless `(a, b): T`)
    // struct / enum members
    case field(String, String, Vec[Nd], Vec[Nd])  // kind ("let "/"var "/"embed "), name, type, attributes (attrN)
    case enumCase(String, Vec[Nd])           // name, payload (payElem list)
    case payElem(String, Vec[Nd])            // label ("" if positional), type
    // declarations
    case importD(Bool, String)               // is_c_header, payload (joined path or header)
    case funcD(String, String, String, Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd], Vec[Nd])  // ..., attributes (attrN; top-level only)
    // visibilityPrefix, modifiers (async/recv), name, generics, params, usingCaps, throwsType?, result?, body?
    case structD(String, String, Vec[Nd], Vec[Nd], Vec[Nd], Bool, Vec[Nd], Vec[Nd]) // vis, name, fields, methods, deinit?, isLinear, generics, attributes
    case enumD(String, String, Vec[Nd], Vec[Nd], Vec[Nd])   // vis, name, cases, methods, generics
    case constD(String, String, Vec[Nd], Vec[Nd])           // vis, name, type?, value
    case staticD(String, String, Vec[Nd], Vec[Nd], Vec[Nd])  // vis, name, type, value?, attributes
    case attrN(String, Vec[Nd])                 // `@name` / `@name(arg, ...)`: name, first argument (boxed; empty if none)
    case opaqueD(String, String, Vec[Nd])                   // vis, name, underlying type
    case deriveD(Vec[Nd], Vec[Nd])                          // protocols, target type
}

struct NUnit {
    var hasMod: Bool
    var modPath: String
    var imports: Vec[Nd]
    var decls: Vec[Nd]
}

struct Ps {
    var toks: Vec[Token]
    var pos: Int
}

struct BP {
    let left: Int
    let right: Int
}

// ----- small constructors / helpers ----------------------------------------
func own(_ s: Str) using Alloc -> String { var r: String = ""; r.append(s); return r }
func bE(_ e: Nd) using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); v.push(e); return v }
func bT(_ t: Nd) using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); v.push(t); return v }
func noE() using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); return v }
func noT() using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); return v }
func errE() using Alloc -> Nd { return Nd.ident("?") }
func errT() using Alloc -> Nd { return Nd.named("?", false, noT()) }
func errP() using Alloc -> Nd { return Nd.wildcard }

func eofTok() -> Token { return Token(kind: TokKind.eof, text: "") }
func curT(_ p: inout Ps) -> Token { return p.toks.get(p.pos) ?? eofTok() }
func curKind(_ p: inout Ps) -> TokKind { let t = curT(p); return t.kind }
func aheadKindP(_ p: inout Ps, _ n: Int) -> TokKind { let t = p.toks.get(p.pos + n) ?? eofTok(); return t.kind }
func curRaw(_ p: inout Ps) -> Str { let t = curT(p); return t.text }
func curText(_ p: inout Ps) using Alloc -> String { return own(curRaw(p)) }
func advP(_ p: inout Ps) { p.pos = p.pos + 1 }
func isKind(_ p: inout Ps, _ k: TokKind) -> Bool { return streq(spelling(curKind(p)), spelling(k)) }
func isKindAt(_ p: inout Ps, _ n: Int, _ k: TokKind) -> Bool { return streq(spelling(aheadKindP(p, n)), spelling(k)) }
func eat(_ p: inout Ps, _ k: TokKind) -> Bool { if isKind(p, k) { advP(&p); return true } return false }
func eatV(_ p: inout Ps, _ k: TokKind) { if isKind(p, k) { advP(&p) } }
func atEndP(_ p: inout Ps) -> Bool { return isKind(p, TokKind.eof) }
func skipNL(_ p: inout Ps) { while isKind(p, TokKind.newline) || isKind(p, TokKind.semicolon) { advP(&p) } }

// ----- operator tables (token kind -> printable string / binding power) -----
func binOpStr(_ k: TokKind) -> Str {
    return match k {
        case .star: "*"
        case .slash: "/"
        case .percent: "%"
        case .ampStar: "&*"
        case .plus: "+"
        case .minus: "-"
        case .ampPlus: "&+"
        case .ampMinus: "&-"
        case .shiftL: "<<"
        case .shiftR: ">>"
        case .amp: "&"
        case .caret: "^"
        case .pipe: "|"
        case .dotDot: ".."
        case .dotDotLt: "..<"
        case .eqEq: "=="
        case .bangEq: "!="
        case .lt: "<"
        case .ltEq: "<="
        case .gt: ">"
        case .gtEq: ">="
        case .ampAmp: "&&"
        case .pipePipe: "||"
        case .questionQuestion: "??"
        default: "?"
    }
}

func infixBp(_ k: TokKind) -> BP {
    return match k {
        case .star: BP(left: 130, right: 131)
        case .slash: BP(left: 130, right: 131)
        case .percent: BP(left: 130, right: 131)
        case .ampStar: BP(left: 130, right: 131)
        case .plus: BP(left: 120, right: 121)
        case .minus: BP(left: 120, right: 121)
        case .ampPlus: BP(left: 120, right: 121)
        case .ampMinus: BP(left: 120, right: 121)
        case .shiftL: BP(left: 110, right: 111)
        case .shiftR: BP(left: 110, right: 111)
        case .amp: BP(left: 100, right: 101)
        case .caret: BP(left: 90, right: 91)
        case .pipe: BP(left: 80, right: 81)
        case .dotDot: BP(left: 70, right: 71)
        case .dotDotLt: BP(left: 70, right: 71)
        case .eqEq: BP(left: 60, right: 61)
        case .bangEq: BP(left: 60, right: 61)
        case .lt: BP(left: 60, right: 61)
        case .ltEq: BP(left: 60, right: 61)
        case .gt: BP(left: 60, right: 61)
        case .gtEq: BP(left: 60, right: 61)
        case .ampAmp: BP(left: 50, right: 51)
        case .pipePipe: BP(left: 40, right: 41)
        case .questionQuestion: BP(left: 30, right: 31)
        default: BP(left: 0, right: 0)
    }
}

func isAssignOp(_ k: TokKind) -> Bool {
    return match k {
        case .assign: true
        case .plusEq: true
        case .minusEq: true
        case .starEq: true
        case .slashEq: true
        case .percentEq: true
        case .ampEq: true
        case .pipeEq: true
        case .caretEq: true
        case .shiftLEq: true
        case .shiftREq: true
        default: false
    }
}

func assignOpStr(_ k: TokKind) -> Str {
    return match k {
        case .assign: "="
        case .plusEq: "+="
        case .minusEq: "-="
        case .starEq: "*="
        case .slashEq: "/="
        case .percentEq: "%="
        case .ampEq: "&="
        case .pipeEq: "|="
        case .caretEq: "^="
        case .shiftLEq: "<<="
        case .shiftREq: ">>="
        default: "?="
    }
}

// ----- parser ---------------------------------------------------------------
func parseUnit(_ p: inout Ps) using Alloc -> NUnit {
    var u = NUnit(hasMod: false, modPath: "", imports: Vec.new(), decls: Vec.new())
    skipNL(&p)
    if isKind(p, TokKind.kwModule) {
        advP(&p)
        u.hasMod = true
        u.modPath = parseDottedPath(&p)
        skipNL(&p)
    }
    while isKind(p, TokKind.kwImport) {
        u.imports.push(parseImport(&p))
        skipNL(&p)
    }
    while !atEndP(p) {
        u.decls.push(parseDecl(&p))
        skipNL(&p)
    }
    return u
}

func parseDottedPath(_ p: inout Ps) using Alloc -> String {
    var s: String = curText(p)
    advP(&p)
    while isKind(p, TokKind.dot) {
        advP(&p)
        s.append(".")
        s.append(curText(p))
        advP(&p)
    }
    return s
}

func parseImport(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'import'
    if isKind(p, TokKind.identifier) && streq(curRaw(p), "c") && isKindAt(p, 1, TokKind.stringLit) {
        advP(&p)  // 'c'
        let raw = curRaw(p)
        advP(&p)
        var body: String = ""
        if raw.len() >= 2 { body = own(raw.slice(1, raw.len() - 1)) }
        return Nd.importD(true, body)
    }
    return Nd.importD(false, parseDottedPath(&p))
}

func parseVisibility(_ p: inout Ps) -> Str {
    if isKind(p, TokKind.kwPrivate) { advP(&p); return "private " }
    if isKind(p, TokKind.kwPublic) { advP(&p); return "public " }
    if isKind(p, TokKind.kwPackage) { advP(&p); return "package " }
    if isKind(p, TokKind.kwInternal) { advP(&p); return "" }
    return ""
}

// Skip declaration attributes `@name` / `@name(...)` (the C++ printer does not emit
// them). Consumes any run of attributes, balancing parens in their argument lists.
func skipAttributes(_ p: inout Ps) {
    while isKind(p, TokKind.at) {
        advP(&p)  // '@'
        advP(&p)  // name (identifier or reserved word)
        if isKind(p, TokKind.lparen) {
            var depth: Int = 0
            var go: Bool = true
            while go && !atEndP(p) {
                if isKind(p, TokKind.lparen) { depth = depth + 1 }
                else if isKind(p, TokKind.rparen) {
                    depth = depth - 1
                    if depth == 0 { advP(&p); go = false }
                }
                if go { advP(&p) }
            }
        }
        skipNL(&p)
    }
}

// A top-level declaration with its leading attributes, which attach to a
// func / static / struct (the decls whose lowering reads them); on any other
// decl they are dropped, as before.
func parseDecl(_ p: inout Ps) using Alloc -> Nd {
    let attrs = parseAttrs(&p)
    return attachAttrs(parseDeclBody(&p), attrs)
}

// `@name` or `@name(arg, ...)` repeated, newlines between. Attribute
// arguments are ordinary expressions (parser.cpp parse_attributes); only the
// first is kept, as only it is read by the lowerings vgen mirrors.
func parseAttrs(_ p: inout Ps) using Alloc -> Vec[Nd] {
    var out: Vec[Nd] = Vec.new()
    while isKind(p, TokKind.at) {
        advP(&p)  // '@'
        let name = curText(p)
        advP(&p)  // name (identifier or reserved word, e.g. `inline`)
        var arg: Vec[Nd] = Vec.new()
        if eat(p, TokKind.lparen) {
            if !isKind(p, TokKind.rparen) {
                arg.push(parseExpr(&p))
                while eat(p, TokKind.comma) { let extra = parseExpr(&p) }
            }
            eat(p, TokKind.rparen)
        }
        out.push(Nd.attrN(name, arg))
        skipNL(&p)
    }
    return out
}

func attachAttrs(_ d: Nd, _ attrs: Vec[Nd]) using Alloc -> Nd {
    return match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b, let old):
            Nd.funcD(vis, mods, name, g, params, caps, t, r, b, ndsCopy(attrs))
        case .staticD(let vis, let name, let ty, let v, let old): Nd.staticD(vis, name, ty, v, ndsCopy(attrs))
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics, let old):
            Nd.structD(vis, name, fl, m, dn, isLinear, generics, ndsCopy(attrs))
        default: d
    }
}

func parseDeclBody(_ p: inout Ps) using Alloc -> Nd {
    let vis = own(parseVisibility(&p))
    if isKind(p, TokKind.kwStruct) { return parseStruct(&p, vis, false) }
    // §5 `linear struct Foo { … }` — the modifier (admitted on structs in v0.5)
    // is captured on the node; the printer drops it, matching the C++ dump.
    if eat(p, TokKind.kwLinear) { return parseStruct(&p, vis, true) }
    if isKind(p, TokKind.kwEnum) { return parseEnum(&p, vis) }
    if isKind(p, TokKind.kwConst) { return parseConst(&p, vis) }
    if isKind(p, TokKind.kwStatic) { return parseStatic(&p, vis) }
    if isKind(p, TokKind.kwOpaque) { return parseOpaque(&p, vis) }
    if isKind(p, TokKind.kwDerive) { return parseDerive(&p) }
    var mods: String = ""
    if eat(p, TokKind.kwComptime) { mods = "comptime " }
    if eat(p, TokKind.kwAsync) { mods.append("async ") }
    if eat(p, TokKind.kwInout) { mods.append("inout ") }
    else if eat(p, TokKind.kwSink) { mods.append("sink ") }
    return parseFunc(&p, vis, mods)
}

func parseConst(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'const'
    let name = curText(p)
    advP(&p)
    var ty: Vec[Nd] = Vec.new()
    if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
    eat(p, TokKind.assign)
    return Nd.constD(vis, name, ty, bE(parseExpr(&p)))
}

func parseStatic(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'static'
    let name = curText(p)
    advP(&p)
    var ty: Vec[Nd] = Vec.new()
    if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
    var val: Vec[Nd] = Vec.new()
    if eat(p, TokKind.assign) { val.push(parseExpr(&p)) }
    return Nd.staticD(vis, name, ty, val, emptyNdBox())
}

func parseOpaque(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'opaque'
    eat(p, TokKind.kwType)
    let name = curText(p)
    advP(&p)
    eat(p, TokKind.assign)
    return Nd.opaqueD(vis, name, bT(parseType(&p)))
}

func parseDerive(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'derive'
    eat(p, TokKind.lparen)
    var protocols: Vec[Nd] = Vec.new()
    if !isKind(p, TokKind.rparen) {
        protocols.push(parseType(&p))
        while eat(p, TokKind.comma) { protocols.push(parseType(&p)) }
    }
    eat(p, TokKind.rparen)
    eat(p, TokKind.kwFor)
    return Nd.deriveD(protocols, bT(parseType(&p)))
}

func parseStruct(_ p: inout Ps, _ vis: String, _ isLinear: Bool) using Alloc -> Nd {
    advP(&p)  // 'struct'
    let name = curText(p)
    advP(&p)  // name
    let g = parseGenerics(&p)
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var fields: Vec[Nd] = Vec.new()
    var methods: Vec[Nd] = Vec.new()
    var deinitB: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        // Field attributes (`@bits(4)`, `@align(8)`) attach to the field; on a
        // method they are dropped. The printer drops both.
        let fattrs = parseAttrs(&p)
        if isKind(p, TokKind.kwFunc) || isKind(p, TokKind.kwAsync)
            || isKind(p, TokKind.kwInout) || isKind(p, TokKind.kwSink) {
            var mods: String = ""
            if eat(p, TokKind.kwAsync) { mods = "async " }
            if eat(p, TokKind.kwInout) { mods.append("inout ") }
            else if eat(p, TokKind.kwSink) { mods.append("sink ") }
            methods.push(parseFunc(&p, "", mods))
        } else if isKind(p, TokKind.kwDeinit) {
            advP(&p)
            deinitB.push(parseBlock(&p))
        } else {
            var kind: String = ""
            if eat(p, TokKind.kwLet) { kind = "let " }
            else if eat(p, TokKind.kwVar) { kind = "var " }
            else if eat(p, TokKind.kwEmbed) { kind = "embed " }
            else { advP(&p) }
            let fname = curText(p)
            advP(&p)
            eat(p, TokKind.colon)
            fields.push(Nd.field(kind, fname, bT(parseType(&p)), fattrs))
        }
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.structD(vis, name, fields, methods, deinitB, isLinear, g, emptyNdBox())
}

func parseEnum(_ p: inout Ps, _ vis: String) using Alloc -> Nd {
    advP(&p)  // 'enum'
    let name = curText(p)
    advP(&p)  // name
    let g = parseGenerics(&p)
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var cases: Vec[Nd] = Vec.new()
    var methods: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        if eat(p, TokKind.kwCase) {
            let cname = curText(p)
            advP(&p)
            var payload: Vec[Nd] = Vec.new()
            if eat(p, TokKind.lparen) {
                if !isKind(p, TokKind.rparen) {
                    payload.push(parsePayElem(&p))
                    while eat(p, TokKind.comma) { payload.push(parsePayElem(&p)) }
                }
                eat(p, TokKind.rparen)
            }
            cases.push(Nd.enumCase(cname, payload))
        } else if isKind(p, TokKind.at) {
            skipAttributes(&p)  // member attributes — printer drops them
        } else if isKind(p, TokKind.kwFunc) {
            methods.push(parseFunc(&p, "", ""))
        } else {
            advP(&p)
        }
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.enumD(vis, name, cases, methods, g)
}

func parsePayElem(_ p: inout Ps) using Alloc -> Nd {
    var label: String = ""
    if isKind(p, TokKind.identifier) && isKindAt(p, 1, TokKind.colon) {
        label = curText(p)
        advP(&p)
        advP(&p)  // ':'
    }
    return Nd.payElem(label, bT(parseType(&p)))
}

func parseFunc(_ p: inout Ps, _ vis: String, _ mods: String) using Alloc -> Nd {
    advP(&p)  // 'func'
    let name = curText(p)
    advP(&p)  // name
    var generics = parseGenerics(&p)
    let params = parseParams(&p)
    var usingCaps: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.kwUsing) {
        advP(&p)
        usingCaps.push(parseType(&p))
        while eat(p, TokKind.comma) { usingCaps.push(parseType(&p)) }
    }
    var throwsT: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.kwThrows) {
        advP(&p)
        eat(p, TokKind.lparen)
        throwsT.push(parseType(&p))
        eat(p, TokKind.rparen)
    }
    var result: Vec[Nd] = Vec.new()
    if eat(p, TokKind.arrow) { result.push(parseType(&p)) }
    // A trailing `where T: P & Q` clause folds its bounds back into the generic
    // params, exactly as the C++ parser does (so they print inline as `[T: P & Q]`).
    generics = mergeWhere(generics, parseWhereClause(&p))
    var body: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.lbrace) { body.push(parseBlock(&p)) }
    return Nd.funcD(vis, mods, name, generics, params, usingCaps, throwsT, result, body, emptyNdBox())
}

func parseWhereClause(_ p: inout Ps) using Alloc -> Vec[Nd] {
    if !isKind(p, TokKind.kwWhere) { var empty: Vec[Nd] = Vec.new(); return empty }
    advP(&p)  // 'where'
    var out: Vec[Nd] = Vec.new()
    var more: Bool = true
    while more {
        let nm = curText(p)
        advP(&p)
        eat(p, TokKind.colon)
        var bounds: Vec[Nd] = Vec.new()
        bounds.push(parseType(&p))
        while eat(p, TokKind.amp) { bounds.push(parseType(&p)) }
        out.push(Nd.genType(nm, bounds))
        if !eat(p, TokKind.comma) { more = false }
    }
    return out
}

// Merge where-clause bounds (a list of genType entries) into the matching generic
// params by name, returning a fresh generics list.
func mergeWhere(_ gens: Vec[Nd], _ wheres: Vec[Nd]) using Alloc -> Vec[Nd] {
    var out: Vec[Nd] = Vec.new()
    var i: Int = 0
    while i < gens.len() {
        out.push(mergeOne(gens.get(i) ?? errT(), wheres))
        i = i + 1
    }
    return out
}

func mergeOne(_ g: Nd, _ wheres: Vec[Nd]) using Alloc -> Nd {
    return match g {
        case .genType(let name, let bounds): Nd.genType(name, boundsFor(name, bounds, wheres))
        default: g
    }
}

func boundsFor(_ name: String, _ bounds: Vec[Nd], _ wheres: Vec[Nd]) using Alloc -> Vec[Nd] {
    var nb: Vec[Nd] = Vec.new()
    var i: Int = 0
    while i < bounds.len() {
        nb.push(bounds.get(i) ?? errT())
        i = i + 1
    }
    var w: Int = 0
    while w < wheres.len() {
        appendWhereBounds(name, wheres.get(w) ?? errT(), &nb)
        w = w + 1
    }
    return nb
}

func appendWhereBounds(_ name: String, _ entry: Nd, _ nb: inout Vec[Nd]) using Alloc {
    match entry {
        case .genType(let wname, let wbounds): appendIfMatch(name, wname, wbounds, &nb)
        default: nb.push(entry)
    }
}

func appendIfMatch(_ name: String, _ wname: String, _ wbounds: Vec[Nd], _ nb: inout Vec[Nd]) using Alloc {
    if streq(name, wname) {
        var i: Int = 0
        while i < wbounds.len() {
            nb.push(wbounds.get(i) ?? errT())
            i = i + 1
        }
    }
}

func parseParams(_ p: inout Ps) using Alloc -> Vec[Nd] {
    var params: Vec[Nd] = Vec.new()
    eat(p, TokKind.lparen)
    if !isKind(p, TokKind.rparen) {
        params.push(parseParam(&p, 0))
        while eat(p, TokKind.comma) { params.push(parseParam(&p, params.len())) }
    }
    eat(p, TokKind.rparen)
    return params
}

func parseParam(_ p: inout Ps, _ idx: Int) using Alloc -> Nd {
    var labelOmitted: Bool = false
    var label: String = ""
    var name: String = ""
    var pat: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.lparen) {
        // §6 tuple-destructuring parameter `(a, b): T` — the C++ printer renders it
        // as `_ : T` (label omitted, no name). The pattern is kept for codegen,
        // and the parameter takes the bootstrap's synthetic `__vstr_arg<i>`
        // name, which the body's destructuring prologue reads.
        pat.push(parsePattern(&p))
        name = own("__vstr_arg")
        name.append(intToStr(idx))
        labelOmitted = true
    } else if isKind(p, TokKind.underscore) {
        advP(&p)
        labelOmitted = true
        // `_ name:` binds a name; bare `_:` is an anonymous parameter (no name).
        if !isKind(p, TokKind.colon) { name = curText(p); advP(&p) }
    } else if isKind(p, TokKind.identifier) && isKindAt(p, 1, TokKind.identifier) {
        label = curText(p)
        advP(&p)
        name = curText(p)
        advP(&p)
    } else {
        name = curText(p)
        advP(&p)
    }
    eat(p, TokKind.colon)
    var nonesc: Bool = false
    if isKind(p, TokKind.kwNonescaping) { advP(&p); nonesc = true }
    var mode: String = ""
    if isKind(p, TokKind.kwInout) { advP(&p); mode = "inout " }
    else if isKind(p, TokKind.kwSink) { advP(&p); mode = "sink " }
    else if isKind(p, TokKind.kwRead) { advP(&p) }
    let ty = bT(parseType(&p))
    return Nd.param(labelOmitted, label, name, nonesc, mode, ty, pat)
}

func parseType(_ p: inout Ps) using Alloc -> Nd {
    var base = parseTypeBase(&p)
    while isKind(p, TokKind.question) {
        advP(&p)
        base = Nd.opt(bT(base))
    }
    return base
}

func parseTypeBase(_ p: inout Ps) using Alloc -> Nd {
    if eat(p, TokKind.kwSome) { return Nd.someT(bT(parseType(&p))) }
    if eat(p, TokKind.kwDyn) { return Nd.dynT(bT(parseType(&p))) }
    if isKind(p, TokKind.at) {
        // §A8 @interrupt(T) in type position — InterruptType prints /*?type*/.
        // Only `interrupt` is admitted there (the bootstrap errors on any
        // other name); anything else, such as a quote splice reaching type
        // position, stays the opaque placeholder.
        advP(&p)  // '@'
        let isIntr = streq(curText(p), "interrupt")
        advP(&p)  // 'interrupt'
        eatV(p, TokKind.lparen)
        let t = parseType(&p)
        eatV(p, TokKind.rparen)
        if !isIntr { return Nd.exoticE }
        return Nd.intrT(bT(t))
    }
    if isKind(p, TokKind.lbracket) { return parseVectorType(&p) }
    if isKind(p, TokKind.lparen) { return parseParenType(&p) }
    // named type: path (identifier or `Self`) with optional generic args
    var path: String = curText(p)
    advP(&p)
    while isKind(p, TokKind.dot) {
        advP(&p)
        path.append(".")
        path.append(curText(p))
        advP(&p)
    }
    var hasGen: Bool = false
    var args: Vec[Nd] = Vec.new()
    if isKind(p, TokKind.lbracket) {
        advP(&p)
        hasGen = true
        if !isKind(p, TokKind.rbracket) {
            args.push(parseType(&p))
            while eat(p, TokKind.comma) { args.push(parseType(&p)) }
        }
        eat(p, TokKind.rbracket)
    }
    return Nd.named(path, hasGen, args)
}

func parseVectorType(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '['
    var lenStr: String = ""
    if isKind(p, TokKind.intLit) { lenStr = curText(p); advP(&p) }
    else if isKind(p, TokKind.identifier) { lenStr = curText(p); advP(&p) }
    eat(p, TokKind.rbracket)
    return Nd.vecT(lenStr, bT(parseType(&p)))
}

func parseParenType(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '('
    var parts: Vec[Nd] = Vec.new()
    if !isKind(p, TokKind.rparen) {
        parts.push(parseType(&p))
        while eat(p, TokKind.comma) { parts.push(parseType(&p)) }
    }
    eat(p, TokKind.rparen)
    if isKind(p, TokKind.kwUsing) || isKind(p, TokKind.kwThrows) || isKind(p, TokKind.arrow) {
        var caps: Vec[Nd] = Vec.new()
        if eat(p, TokKind.kwUsing) {
            caps.push(parseType(&p))
            while eat(p, TokKind.comma) { caps.push(parseType(&p)) }
        }
        var thr: Vec[Nd] = Vec.new()
        if eat(p, TokKind.kwThrows) {
            eat(p, TokKind.lparen)
            thr.push(parseType(&p))
            eat(p, TokKind.rparen)
        }
        var res: Vec[Nd] = Vec.new()
        if eat(p, TokKind.arrow) { res.push(parseType(&p)) }
        return Nd.fnT(parts, caps, thr, res)
    }
    if parts.len() == 1 { return parts.get(0) ?? errT() }
    return Nd.tupleT(parts)
}

// Generic parameter list `[T, U: A & B, const N: Int]`. Returned for funcs (which
// print them) and consumed-and-dropped for structs / enums (whose printer omits them).
func parseGenerics(_ p: inout Ps) using Alloc -> Vec[Nd] {
    if !isKind(p, TokKind.lbracket) { var empty: Vec[Nd] = Vec.new(); return empty }
    advP(&p)  // '['
    var out: Vec[Nd] = Vec.new()
    var more: Bool = true
    while more {
        if eat(p, TokKind.kwConst) {
            let nm = curText(p)
            advP(&p)
            eat(p, TokKind.colon)
            out.push(Nd.genConst(nm, bT(parseType(&p))))
        } else {
            let nm = curText(p)
            advP(&p)
            var bounds: Vec[Nd] = Vec.new()
            if eat(p, TokKind.colon) {
                bounds.push(parseType(&p))
                while eat(p, TokKind.amp) { bounds.push(parseType(&p)) }
            }
            out.push(Nd.genType(nm, bounds))
        }
        if !eat(p, TokKind.comma) { more = false }
    }
    eat(p, TokKind.rbracket)
    return out
}

func parseBlock(_ p: inout Ps) using Alloc -> Nd {
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var stmts: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        stmts.push(parseStmt(&p))
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.block(stmts)
}

func parseStmt(_ p: inout Ps) using Alloc -> Nd {
    if isKind(p, TokKind.kwLet) {
        advP(&p)
        let pat = bP(parsePattern(&p))
        var ty: Vec[Nd] = Vec.new()
        if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
        eat(p, TokKind.assign)
        return Nd.letS(pat, ty, bE(parseExpr(&p)))
    }
    if isKind(p, TokKind.kwVar) {
        advP(&p)
        let pat = bP(parsePattern(&p))
        var ty: Vec[Nd] = Vec.new()
        if eat(p, TokKind.colon) { ty.push(parseType(&p)) }
        eat(p, TokKind.assign)
        return Nd.varS(pat, ty, bE(parseExpr(&p)))
    }
    if isKind(p, TokKind.kwReturn) {
        advP(&p)
        var v: Vec[Nd] = Vec.new()
        if !isKind(p, TokKind.newline) && !isKind(p, TokKind.semicolon)
            && !isKind(p, TokKind.rbrace) && !atEndP(p) {
            v.push(parseExpr(&p))
        }
        return Nd.retS(v)
    }
    if isKind(p, TokKind.kwWhile) {
        advP(&p)
        // §9 `while let x = e { B }` is `while true { if let x = e { B } else
        // { break } }`, as the bootstrap parser desugars it.
        if eat(p, TokKind.kwLet) { return parseWhileLet(&p) }
        let cond = bE(parseExpr(&p))
        let body = bE(parseBlock(&p))
        return Nd.whileS(cond, body)
    }
    if isKind(p, TokKind.kwFor) {
        advP(&p)
        let pat = bP(parsePattern(&p))
        eat(p, TokKind.kwIn)
        let iter = bE(parseExpr(&p))
        let body = bE(parseBlock(&p))
        return Nd.forS(pat, iter, body)
    }
    if isKind(p, TokKind.kwWith) { return parseWith(&p) }
    if isKind(p, TokKind.kwBreak) {
        advP(&p)
        var label: String = ""
        if isKind(p, TokKind.identifier) { label = curText(p); advP(&p) }
        return Nd.breakS(label)
    }
    if isKind(p, TokKind.kwContinue) {
        advP(&p)
        var label: String = ""
        if isKind(p, TokKind.identifier) { label = curText(p); advP(&p) }
        return Nd.continueS(label)
    }
    let e = parseExpr(&p)
    if isAssignOp(curKind(p)) {
        let op = own(assignOpStr(curKind(p)))
        advP(&p)
        return Nd.assignS(op, bE(e), bE(parseExpr(&p)))
    }
    return Nd.exprS(bE(e))
}

func bP(_ x: Nd) using Alloc -> Vec[Nd] { var v: Vec[Nd] = Vec.new(); v.push(x); return v }

func firstCharLower(_ s: Str) -> Bool {
    let c = s.charAt(0) ?? ' '
    return c >= 'a' && c <= 'z'
}

// §17.4 `with` capability block. The C++ printer has no WithStmt case, so it dumps
// as /*?stmt*/ (our default arm); we parse the bindings and body precisely to keep
// the token stream aligned. A binding is `name (: type)? = expr` when the leading
// identifier is lowercase and followed by `=` or `:`, otherwise `cap_type (= expr)?`.
func parseWith(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'with'
    var caps: Vec[Nd] = Vec.new()
    var names: Vec[Nd] = Vec.new()
    var vals: Vec[Nd] = Vec.new()
    var tys: Vec[Nd] = Vec.new()
    var more: Bool = true
    while more {
        if isKind(p, TokKind.identifier)
            && (isKindAt(p, 1, TokKind.assign) || isKindAt(p, 1, TokKind.colon))
            && firstCharLower(curRaw(p)) {
            let nm = curText(p)
            advP(&p)  // name (value binding, grants no capability)
            if eat(p, TokKind.colon) { tys.push(parseType(&p)) } else { tys.push(Nd.wildcard) }
            eat(p, TokKind.assign)
            names.push(Nd.ident(nm))
            vals.push(parseExpr(&p))
        } else {
            let t = parseType(&p)  // capability-typed binding
            if eat(p, TokKind.assign) {
                names.push(Nd.ident(""))  // "" sentinel => capability instance, lowers to (void)(val)
                tys.push(Nd.wildcard)
                vals.push(parseExpr(&p))
            } else {
                caps.push(t)  // grant-only, lowers to nothing
            }
        }
        if !eat(p, TokKind.comma) { more = false }
    }
    let body = parseBlock(&p)
    return Nd.withS(caps, names, vals, tys, bE(body))
}

func parsePattern(_ p: inout Ps) using Alloc -> Nd {
    var alts: Vec[Nd] = Vec.new()
    alts.push(parsePatAlt(&p))
    if !isKind(p, TokKind.pipe) { return alts.get(0) ?? errP() }
    while eat(p, TokKind.pipe) { alts.push(parsePatAlt(&p)) }
    return Nd.orP(alts)
}

func parsePatAlt(_ p: inout Ps) using Alloc -> Nd {
    if isKind(p, TokKind.underscore) { advP(&p); return Nd.wildcard }
    if isKind(p, TokKind.lparen) {
        advP(&p)
        var elems: Vec[Nd] = Vec.new()
        if !isKind(p, TokKind.rparen) {
            elems.push(parsePattern(&p))
            while eat(p, TokKind.comma) { elems.push(parsePattern(&p)) }
        }
        eat(p, TokKind.rparen)
        if elems.len() == 1 { return elems.get(0) ?? errP() }
        return Nd.tupleP(elems)
    }
    if isKind(p, TokKind.kwLet) {
        advP(&p)
        let n = curText(p)
        advP(&p)
        return Nd.bindP(n)
    }
    if isKind(p, TokKind.dot) {
        advP(&p)
        let cname = curText(p)
        advP(&p)
        var children: Vec[Nd] = Vec.new()
        if eat(p, TokKind.lparen) {
            if !isKind(p, TokKind.rparen) {
                children.push(parsePattern(&p))
                while eat(p, TokKind.comma) { children.push(parsePattern(&p)) }
            }
            eat(p, TokKind.rparen)
        }
        return Nd.enumP(cname, children)
    }
    if isKind(p, TokKind.identifier) {
        let n = curText(p)
        advP(&p)
        return Nd.identP(n)
    }
    if isKind(p, TokKind.intLit) || isKind(p, TokKind.floatLit) || isKind(p, TokKind.stringLit)
        || isKind(p, TokKind.charLit) || isKind(p, TokKind.kwTrue) || isKind(p, TokKind.kwFalse) {
        let lit = parsePrimary(&p)
        if isKind(p, TokKind.dotDot) || isKind(p, TokKind.dotDotLt) {
            let incl = isKind(p, TokKind.dotDot)
            advP(&p)
            let high = parsePrimary(&p)
            return Nd.rangeP(bE(lit), bE(high), incl)
        }
        return Nd.litP(bE(lit))
    }
    return Nd.wildcard
}

func parseExpr(_ p: inout Ps) using Alloc -> Nd { return parseExprBp(&p, 0) }

func parseExprBp(_ p: inout Ps, _ minBp: Int) using Alloc -> Nd {
    var lhs = parsePrefix(&p)
    var go: Bool = true
    while go {
        if isKind(p, TokKind.kwAs) || isKind(p, TokKind.kwAsQuestion) {
            let isOpt = isKind(p, TokKind.kwAsQuestion)
            advP(&p)
            lhs = Nd.asE(bE(lhs), bT(parseType(&p)), isOpt)
        } else {
            let bp = infixBp(curKind(p))
            if bp.left < minBp || bp.left == 0 {
                go = false
            } else {
                let op = own(binOpStr(curKind(p)))
                advP(&p)
                let rhs = parseExprBp(&p, bp.right)
                lhs = Nd.binary(op, bE(lhs), bE(rhs))
            }
        }
    }
    return lhs
}

func parsePrefix(_ p: inout Ps) using Alloc -> Nd {
    // §17.7 prefix expressions. copy / await / spawn / try print fully; throw wraps
    // its operand but the C++ printer has no ThrowExpr case, so it dumps /*?expr*/.
    if eat(p, TokKind.kwCopy) { return Nd.prefixE("copy ", bE(parsePrefix(&p))) }
    if eat(p, TokKind.kwAwait) { return Nd.prefixE("await ", bE(parsePrefix(&p))) }
    if eat(p, TokKind.kwSpawn) { return Nd.prefixE("spawn ", bE(parsePrefix(&p))) }
    if eat(p, TokKind.kwThrow) { return Nd.throwE(bE(parsePrefix(&p))) }
    if isKind(p, TokKind.kwTry) || isKind(p, TokKind.kwTryQuestion) || isKind(p, TokKind.kwTryBang) {
        var form: String = "try "
        if isKind(p, TokKind.kwTryQuestion) { form = "try? " }
        else if isKind(p, TokKind.kwTryBang) { form = "try! " }
        advP(&p)
        return Nd.prefixE(form, bE(parsePrefix(&p)))
    }
    if eat(p, TokKind.minus) { return Nd.unary("-", bE(parsePrefix(&p))) }
    if eat(p, TokKind.bang) { return Nd.unary("!", bE(parsePrefix(&p))) }
    if eat(p, TokKind.tilde) { return Nd.unary("~", bE(parsePrefix(&p))) }
    if eat(p, TokKind.amp) { return Nd.addrOf(bE(parsePrefix(&p))) }
    let prim = parsePrimary(&p)
    return parsePostfix(&p, prim)
}

func parsePrimary(_ p: inout Ps) using Alloc -> Nd {
    if isKind(p, TokKind.intLit) { let t = curText(p); advP(&p); return Nd.intLit(t) }
    if isKind(p, TokKind.floatLit) { let t = curText(p); advP(&p); return Nd.floatLit(t) }
    if isKind(p, TokKind.stringLit) {
        let raw = curRaw(p); advP(&p)
        var inner: String = ""
        if raw.len() >= 2 { inner = own(raw.slice(1, raw.len() - 1)) }
        return Nd.strLit(inner)
    }
    if isKind(p, TokKind.byteStringLit) {
        let raw = curRaw(p); advP(&p)
        var inner: String = ""
        if raw.len() >= 3 { inner = own(raw.slice(2, raw.len() - 1)) }
        return Nd.byteStrLit(inner)
    }
    if isKind(p, TokKind.charLit) {
        let raw = curRaw(p); advP(&p)
        var inner: String = ""
        if raw.len() >= 2 { inner = own(raw.slice(1, raw.len() - 1)) }
        return Nd.charLit(inner)
    }
    if isKind(p, TokKind.kwTrue) { advP(&p); return Nd.boolLit(true) }
    if isKind(p, TokKind.kwFalse) { advP(&p); return Nd.boolLit(false) }
    if isKind(p, TokKind.kwNil) { advP(&p); return Nd.nilLit }
    if isKind(p, TokKind.kwSelfLower) { advP(&p); return Nd.selfE }
    if isKind(p, TokKind.identifier) { let t = curText(p); advP(&p); return Nd.ident(t) }
    if isKind(p, TokKind.dot) {
        advP(&p)
        let n = curText(p)
        advP(&p)
        return Nd.leadingDot(n)
    }
    if isKind(p, TokKind.lparen) {
        advP(&p)
        let first = parseExpr(&p)
        if eat(p, TokKind.comma) {
            // tuple literal: keep the elements (still printed as /*?expr*/).
            var elems: Vec[Nd] = Vec.new()
            elems.push(first)
            elems.push(parseExpr(&p))
            while eat(p, TokKind.comma) { elems.push(parseExpr(&p)) }
            eat(p, TokKind.rparen)
            return Nd.tupleLit(elems)
        }
        eat(p, TokKind.rparen)
        return Nd.paren(bE(first))
    }
    if isKind(p, TokKind.lbracket) {
        // array / vector literal: keep the elements (still printed as /*?expr*/).
        advP(&p)
        var elems: Vec[Nd] = Vec.new()
        if !isKind(p, TokKind.rbracket) {
            elems.push(parseExpr(&p))
            // A trailing comma before `]` is allowed, as in the bootstrap.
            while eat(p, TokKind.comma) {
                if isKind(p, TokKind.rbracket) { break }
                elems.push(parseExpr(&p))
            }
        }
        eat(p, TokKind.rbracket)
        return Nd.vecLit(elems)
    }
    if isKind(p, TokKind.kwIf) { return parseIf(&p) }
    if isKind(p, TokKind.kwMatch) { return parseMatch(&p) }
    if isKind(p, TokKind.kwSelect) {
        // §11 select { ... } — SelectExpr has no printer case (/*?expr*/); consume
        // the balanced body to stay token-aligned.
        advP(&p)
        skipBalancedBraces(&p)
        return Nd.exoticE
    }
    if isKind(p, TokKind.kwQuote) { return parseQuote(&p) }
    if isKind(p, TokKind.dollar) { return parseSplice(&p) }
    if isKind(p, TokKind.kwDo) { return parseDoCatch(&p) }
    if isKind(p, TokKind.kwComptime) {
        advP(&p)
        if isKind(p, TokKind.lbrace) { let b = parseBlock(&p) } else { let e = parseExpr(&p) }
        return Nd.exoticE
    }
    if isKind(p, TokKind.at) {
        // @embed(...) / @macro(...) — both print /*?expr*/ in the C++ printer.
        advP(&p)  // '@'
        advP(&p)  // intrinsic / macro name
        if isKind(p, TokKind.lparen) { skipBalancedParens(&p) }
        return Nd.exoticE
    }
    if isKind(p, TokKind.interpBegin) { return parseInterpString(&p) }
    if isKind(p, TokKind.lbrace) {
        if isClosureAhead(p) { return parseClosure(&p) }
        return parseBlock(&p)
    }
    // unsupported construct in this slice; emit a stub and advance.
    advP(&p)
    return Nd.ident("<error>")
}

// `do { body } catch (NAME: E) { handler }` (or bare `catch NAME`). Prints fully.
func parseDoCatch(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'do'
    let doBody = bE(parseBlock(&p))
    eat(p, TokKind.kwCatch)
    var errName: String = ""
    var errType: Vec[Nd] = Vec.new()
    if eat(p, TokKind.lparen) {
        errName = curText(p)
        advP(&p)
        eat(p, TokKind.colon)
        errType.push(parseType(&p))
        eatV(p, TokKind.rparen)
    } else if isKind(p, TokKind.identifier) {
        errName = curText(p)
        advP(&p)
    }
    if eat(p, TokKind.kwWhere) { let guard = parseExpr(&p) }
    let catchBody = bE(parseBlock(&p))
    return Nd.doCatchE(doBody, errName, errType, catchBody)
}

// §12.4 `quote { EXPR }` (expression form, printed fully) vs `quote { <decls> }` (a
// declaration-macro template, printed /*?expr*/). Disambiguated by a declaration
// keyword at brace depth 1.
func parseQuote(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'quote'  (now at '{')
    if isDeclQuoteAhead(p) {
        skipBalancedBraces(&p)
        return Nd.exoticE
    }
    eatV(p, TokKind.lbrace)
    skipNL(&p)
    let inner = parseExpr(&p)
    skipNL(&p)
    eatV(p, TokKind.rbrace)
    return Nd.quoteE(bE(inner))
}

func isDeclQuoteAhead(_ p: inout Ps) -> Bool {
    var i: Int = p.pos + 1
    var depth: Int = 1
    var found: Bool = false
    var go: Bool = true
    while go {
        let k = kindAtAbs(p, i)
        if isKind2(k, TokKind.eof) { go = false }
        else if isKind2(k, TokKind.lbrace) || isKind2(k, TokKind.lparen) || isKind2(k, TokKind.lbracket) {
            depth = depth + 1
        } else if isKind2(k, TokKind.rbrace) || isKind2(k, TokKind.rparen) || isKind2(k, TokKind.rbracket) {
            depth = depth - 1
            if depth == 0 { go = false }
        } else if depth == 1 && isDeclKw(k) {
            found = true
            go = false
        }
        i = i + 1
    }
    return found
}

func isDeclKw(_ k: TokKind) -> Bool {
    return isKind2(k, TokKind.kwFunc) || isKind2(k, TokKind.kwStruct) || isKind2(k, TokKind.kwEnum)
        || isKind2(k, TokKind.kwProtocol) || isKind2(k, TokKind.kwExtension)
        || isKind2(k, TokKind.kwConst) || isKind2(k, TokKind.kwStatic)
}

// §12.4 splice `$ident` / `$(expr)`. The C++ printer renders it bare when the inner
// is an identifier (so `$(x)` also prints `$x`), otherwise with parens.
func parseSplice(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '$'
    if eat(p, TokKind.lparen) {
        let inner = parseExpr(&p)
        eatV(p, TokKind.rparen)
        let bare = isIdentNode(inner)
        return Nd.spliceE(bare, bE(inner))
    }
    if isKind(p, TokKind.identifier) {
        let n = curText(p)
        advP(&p)
        return Nd.spliceE(true, bE(Nd.ident(n)))
    }
    return Nd.exoticE
}

func isIdentNode(_ e: Nd) -> Bool {
    return match e {
        case .ident(let n): true
        default: false
    }
}

func skipBalancedParens(_ p: inout Ps) {
    var depth: Int = 0
    var go: Bool = true
    while go && !atEndP(p) {
        if isKind(p, TokKind.lparen) { depth = depth + 1 }
        else if isKind(p, TokKind.rparen) {
            depth = depth - 1
            if depth == 0 { advP(&p); go = false }
        }
        if go { advP(&p) }
    }
}

func skipBalancedBraces(_ p: inout Ps) {
    var depth: Int = 0
    var go: Bool = true
    while go && !atEndP(p) {
        if isKind(p, TokKind.lbrace) { depth = depth + 1 }
        else if isKind(p, TokKind.rbrace) {
            depth = depth - 1
            if depth == 0 { advP(&p); go = false }
        }
        if go { advP(&p) }
    }
}

// An interpolated string `"...\(e)..."` lexes as InterpStringBegin (Part | LParen
// expr RParen)* InterpStringEnd; the C++ printer has no InterpStringExpr case, so
// it dumps /*?expr*/. We consume the sequence to stay token-aligned.
func parseInterpString(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // InterpStringBegin
    var parts: Vec[String] = Vec.new()
    var exprs: Vec[Nd] = Vec.new()
    var go: Bool = true
    while go && !isKind(p, TokKind.interpEnd) && !atEndP(p) {
        if isKind(p, TokKind.interpPart) { parts.push(curText(p)); advP(&p) }
        else if isKind(p, TokKind.lparen) {
            advP(&p)
            exprs.push(parseExpr(&p))
            eatV(p, TokKind.rparen)
        } else { advP(&p) }
    }
    eatV(p, TokKind.interpEnd)
    return Nd.interpE(parts, exprs)
}

// A `{ params => body }` closure (vs a block). The C++ printer has no ClosureExpr
// case, so it dumps /*?expr*/. Detect by scanning for a `=>` at brace depth 1.
func isClosureAhead(_ p: inout Ps) -> Bool {
    var i: Int = p.pos + 1
    var depth: Int = 1
    var found: Bool = false
    var go: Bool = true
    while go {
        let k = kindAtAbs(p, i)
        if isKind2(k, TokKind.eof) { go = false }
        else if isKind2(k, TokKind.lbrace) || isKind2(k, TokKind.lparen) || isKind2(k, TokKind.lbracket) {
            depth = depth + 1
        } else if isKind2(k, TokKind.rbrace) || isKind2(k, TokKind.rparen) || isKind2(k, TokKind.rbracket) {
            depth = depth - 1
            if depth == 0 { go = false }
        } else if depth == 1 && isKind2(k, TokKind.fatArrow) {
            found = true
            go = false
        }
        i = i + 1
    }
    return found
}

func kindAtAbs(_ p: inout Ps, _ i: Int) -> TokKind { let t = p.toks.get(i) ?? eofTok(); return t.kind }
func isKind2(_ a: TokKind, _ b: TokKind) -> Bool { return streq(spelling(a), spelling(b)) }

func parseClosure(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // '{'
    var params: Vec[Nd] = Vec.new()
    if !isKind(p, TokKind.fatArrow) {
        if isKind(p, TokKind.identifier) {
            params.push(Nd.ident(curText(p)))
            advP(&p)
            while eat(p, TokKind.comma) {
                if isKind(p, TokKind.identifier) { params.push(Nd.ident(curText(p))); advP(&p) }
            }
        }
    }
    eat(p, TokKind.fatArrow)
    skipNL(&p)
    var body: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        body.push(parseStmt(&p))
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.closureE(params, body)
}

// A match expression. The C++ printer has no MatchExpr case, so it dumps as
// /*?expr*/; we still parse the arms (pattern / guard / body) precisely so the
// surrounding token stream stays aligned, then discard them.
func parseMatch(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'match'
    let scrut = parseExpr(&p)
    eat(p, TokKind.lbrace)
    skipNL(&p)
    var arms: Vec[Nd] = Vec.new()
    while !isKind(p, TokKind.rbrace) && !atEndP(p) {
        if eat(p, TokKind.kwDefault) {
            eat(p, TokKind.colon)
            arms.push(Nd.matchArm(true, Vec.new(), Vec.new(), bE(parseExpr(&p))))
        } else {
            eat(p, TokKind.kwCase)
            let pat = parsePattern(&p)
            var guard: Vec[Nd] = Vec.new()
            if eat(p, TokKind.kwWhere) { guard.push(parseExpr(&p)) }
            eat(p, TokKind.colon)
            arms.push(Nd.matchArm(false, bP(pat), guard, bE(parseExpr(&p))))
        }
        skipNL(&p)
    }
    eat(p, TokKind.rbrace)
    return Nd.matchE(bE(scrut), arms)
}

func parseWhileLet(_ p: inout Ps) using Alloc -> Nd {
    let letName = curText(p)
    advP(&p)
    eat(p, TokKind.assign)
    let letInit = bE(parseExpr(&p))
    let thenB = bE(parseBlock(&p))
    var brk: Vec[Nd] = Vec.new()
    brk.push(Nd.breakS(""))
    let els = bE(Nd.block(brk))
    let ifx = Nd.ifE(letName, letInit, Vec.new(), thenB, els)
    var body: Vec[Nd] = Vec.new()
    body.push(Nd.exprS(bE(ifx)))
    return Nd.whileS(bE(Nd.boolLit(true)), bE(Nd.block(body)))
}

func parseIf(_ p: inout Ps) using Alloc -> Nd {
    advP(&p)  // 'if'
    var letName: String = ""
    var letInit: Vec[Nd] = Vec.new()
    var cond: Vec[Nd] = Vec.new()
    if eat(p, TokKind.kwLet) {
        letName = curText(p)
        advP(&p)
        eat(p, TokKind.assign)
        letInit.push(parseExpr(&p))
    } else {
        cond.push(parseExpr(&p))
    }
    let thenB = bE(parseBlock(&p))
    var els: Vec[Nd] = Vec.new()
    if eat(p, TokKind.kwElse) {
        if isKind(p, TokKind.kwIf) { els.push(parsePrimary(&p)) }
        else { els.push(parseBlock(&p)) }
    }
    return Nd.ifE(letName, letInit, cond, thenB, els)
}

func parsePostfix(_ p: inout Ps, _ start: Nd) using Alloc -> Nd {
    var lhs = start
    var go: Bool = true
    while go {
        if isKind(p, TokKind.lparen) {
            advP(&p)
            var args: Vec[Nd] = Vec.new()
            if !isKind(p, TokKind.rparen) {
                args.push(parseArg(&p))
                while eat(p, TokKind.comma) { args.push(parseArg(&p)) }
            }
            eat(p, TokKind.rparen)
            lhs = Nd.call(bE(lhs), args)
        } else if isKind(p, TokKind.dot)
                  || (isKind(p, TokKind.question) && isKindAt(p, 1, TokKind.dot)) {
            let isChain = isKind(p, TokKind.question)
            if isChain { advP(&p) }
            advP(&p)  // '.'
            let n = curText(p)
            advP(&p)
            lhs = Nd.member(bE(lhs), n, isChain)
        } else if isKind(p, TokKind.lbracket) {
            advP(&p)
            var idxs: Vec[Nd] = Vec.new()
            if !isKind(p, TokKind.rbracket) {
                idxs.push(parseExpr(&p))
                while eat(p, TokKind.comma) { idxs.push(parseExpr(&p)) }
            }
            eat(p, TokKind.rbracket)
            lhs = Nd.index(bE(lhs), idxs)
        } else if isKind(p, TokKind.bang) {
            advP(&p)
            lhs = Nd.unary("!", bE(lhs))
        } else {
            go = false
        }
    }
    return lhs
}

func parseArg(_ p: inout Ps) using Alloc -> Nd {
    var label: String = ""
    if isKind(p, TokKind.identifier) && isKindAt(p, 1, TokKind.colon) {
        label = curText(p)
        advP(&p)
        advP(&p)  // ':'
    }
    var isInout: Bool = false
    if eat(p, TokKind.amp) { isInout = true }
    return Nd.arg(label, isInout, bE(parseExpr(&p)))
}

// ----- printer (mirrors src/ast/printer.cpp exactly) ------------------------
func indentTo(_ n: Int) using Log {
    var i: Int = 0
    while i < n { print("    "); i = i + 1 }
}

func printUnit(_ u: NUnit) using Alloc, Log {
    if u.hasMod {
        print("module ")
        print(u.modPath)
        print("\n\n")
    }
    var i: Int = 0
    while i < u.imports.len() {
        printImport(u.imports.get(i) ?? Nd.importD(false, "?"))
        i = i + 1
    }
    if u.imports.len() > 0 { print("\n") }
    var j: Int = 0
    while j < u.decls.len() {
        printDecl(u.decls.get(j) ?? Nd.importD(false, "?"), 0)
        print("\n")
        j = j + 1
    }
}

func printImport(_ d: Nd) using Alloc, Log {
    match d {
        case .importD(let isC, let payload): printImportBody(isC, payload)
        default: print("")
    }
}

func printImportBody(_ isC: Bool, _ payload: String) using Log {
    if isC {
        print("import c \"")
        print(payload)
        print("\"\n")
    } else {
        print("import ")
        print(payload)
        print("\n")
    }
}

func printDecl(_ d: Nd, _ indent: Int) using Alloc, Log {
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body, let attrs):
            printFunc(vis, mods, name, gens, params, caps, thr, res, body, indent)
        case .structD(let vis, let name, let fields, let methods, let deinitB, let isLinear, let generics, let attrs):
            printStruct(vis, name, fields, methods, deinitB, indent)
        case .enumD(let vis, let name, let cases, let methods, let generics):
            printEnum(vis, name, cases, methods, indent)
        case .constD(let vis, let name, let ty, let val): printConst(vis, name, ty, val, indent)
        case .staticD(let vis, let name, let ty, let val, let attrs): printStatic(vis, name, ty, val, indent)
        case .opaqueD(let vis, let name, let under): printOpaque(vis, name, under, indent)
        case .deriveD(let protocols, let target): printDerive(protocols, target, indent)
        default: print("")
    }
}

func printStruct(_ vis: String, _ name: String, _ fields: Vec[Nd], _ methods: Vec[Nd],
                 _ deinitB: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("struct ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < fields.len() {
        printField(fields.get(i) ?? errE(), indent + 1)
        i = i + 1
    }
    var m: Int = 0
    while m < methods.len() {
        printDecl(methods.get(m) ?? errE(), indent + 1)
        m = m + 1
    }
    if deinitB.len() > 0 {
        indentTo(indent + 1)
        print("deinit ")
        printExpr(deinitB.get(0) ?? errE())
        print("\n")
    }
    indentTo(indent)
    print("}\n")
}

func printField(_ f: Nd, _ indent: Int) using Alloc, Log {
    match f {
        case .field(let kind, let name, let ty, let fattrs): printFieldBody(kind, name, ty, indent)
        default: print("")
    }
}

func printFieldBody(_ kind: String, _ name: String, _ ty: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(kind)
    print(name)
    print(": ")
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
    print("\n")
}

func printEnum(_ vis: String, _ name: String, _ cases: Vec[Nd], _ methods: Vec[Nd],
               _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("enum ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < cases.len() {
        printEnumCase(cases.get(i) ?? errE(), indent + 1)
        i = i + 1
    }
    var m: Int = 0
    while m < methods.len() {
        printDecl(methods.get(m) ?? errE(), indent + 1)
        m = m + 1
    }
    indentTo(indent)
    print("}\n")
}

func printEnumCase(_ c: Nd, _ indent: Int) using Alloc, Log {
    match c {
        case .enumCase(let name, let payload): printEnumCaseBody(name, payload, indent)
        default: print("")
    }
}

func printEnumCaseBody(_ name: String, _ payload: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print("case ")
    print(name)
    if payload.len() > 0 {
        print("(")
        var i: Int = 0
        while i < payload.len() {
            if i > 0 { print(", ") }
            printPayElem(payload.get(i) ?? errE())
            i = i + 1
        }
        print(")")
    }
    print("\n")
}

func printPayElem(_ e: Nd) using Alloc, Log {
    match e {
        case .payElem(let label, let ty): printPayElemBody(label, ty)
        default: print("")
    }
}

func printPayElemBody(_ label: String, _ ty: Vec[Nd]) using Alloc, Log {
    if !streq(label, "") {
        print(label)
        print(": ")
    }
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
}

func printFunc(_ vis: String, _ mods: String, _ name: String, _ gens: Vec[Nd], _ params: Vec[Nd], _ caps: Vec[Nd],
               _ thr: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print(mods)
    print("func ")
    print(name)
    printGenerics(gens)
    print("(")
    var i: Int = 0
    while i < params.len() {
        if i > 0 { print(", ") }
        printParam(params.get(i) ?? errParam())
        i = i + 1
    }
    print(")")
    if caps.len() > 0 {
        print(" using ")
        var c: Int = 0
        while c < caps.len() {
            if c > 0 { print(", ") }
            printType(caps.get(c) ?? errT())
            c = c + 1
        }
    }
    if thr.len() > 0 {
        print(" throws(")
        printType(thr.get(0) ?? errT())
        print(")")
    }
    if res.len() > 0 {
        print(" -> ")
        printType(res.get(0) ?? errT())
    }
    if body.len() > 0 {
        print(" ")
        printExpr(body.get(0) ?? errE())
    }
    print("\n")
}

func printConst(_ vis: String, _ name: String, _ ty: Vec[Nd], _ val: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("const ")
    print(name)
    if ty.len() > 0 {
        print(": ")
        printType(ty.get(0) ?? errT())
    }
    print(" = ")
    if val.len() > 0 { printExpr(val.get(0) ?? errE()) }
    print("\n")
}

func printStatic(_ vis: String, _ name: String, _ ty: Vec[Nd], _ val: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("static ")
    print(name)
    print(": ")
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
    print(" = ")
    if val.len() > 0 { printExpr(val.get(0) ?? errE()) }
    print("\n")
}

func printOpaque(_ vis: String, _ name: String, _ under: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print(vis)
    print("opaque type ")
    print(name)
    print(" = ")
    printType(under.get(0) ?? errT())
    print("\n")
}

func printDerive(_ protocols: Vec[Nd], _ target: Vec[Nd], _ indent: Int) using Alloc, Log {
    indentTo(indent)
    print("derive(")
    var i: Int = 0
    while i < protocols.len() {
        if i > 0 { print(", ") }
        printType(protocols.get(i) ?? errT())
        i = i + 1
    }
    print(") for ")
    printType(target.get(0) ?? errT())
    print("\n")
}

func printGenerics(_ gens: Vec[Nd]) using Alloc, Log {
    if gens.len() == 0 { return }
    print("[")
    var i: Int = 0
    while i < gens.len() {
        if i > 0 { print(", ") }
        printGenericParam(gens.get(i) ?? errT())
        i = i + 1
    }
    print("]")
}

func printGenericParam(_ g: Nd) using Alloc, Log {
    match g {
        case .genConst(let name, let ct): printGenConst(name, ct)
        case .genType(let name, let bounds): printGenType(name, bounds)
        default: print("")
    }
}

func printGenConst(_ name: String, _ ct: Vec[Nd]) using Alloc, Log {
    print("const ")
    print(name)
    print(": ")
    if ct.len() > 0 { printType(ct.get(0) ?? errT()) }
}

func printGenType(_ name: String, _ bounds: Vec[Nd]) using Alloc, Log {
    print(name)
    if bounds.len() > 0 {
        print(": ")
        var i: Int = 0
        while i < bounds.len() {
            if i > 0 { print(" & ") }
            printType(bounds.get(i) ?? errT())
            i = i + 1
        }
    }
}

func errParam() using Alloc -> Nd {
    return Nd.param(false, "", "?", false, "", noT(), emptyNdBox())
}

func printParam(_ pm: Nd) using Alloc, Log {
    match pm {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty, let ppat): printParamBody(lo, lbl, nm, ne, md, ty)
        default: print("")
    }
}

func printParamBody(_ lo: Bool, _ lbl: String, _ nm: String, _ ne: Bool, _ md: String, _ ty: Vec[Nd]) using Alloc, Log {
    if lo {
        print("_ ")
    } else if !streq(lbl, "") && !streq(lbl, nm) {
        print(lbl)
        print(" ")
    }
    print(nm)
    print(": ")
    if ne { print("nonescaping ") }
    print(md)
    if ty.len() > 0 { printType(ty.get(0) ?? errT()) }
}

func printType(_ t: Nd) using Alloc, Log {
    match t {
        case .named(let path, let hasGen, let args): printNamed(path, hasGen, args)
        case .opt(let inner): printOpt(inner)
        case .someT(let inner): printPrefixType("some ", inner)
        case .dynT(let inner): printPrefixType("dyn ", inner)
        case .vecT(let len, let elem): printVecType(len, elem)
        case .tupleT(let elems): printTupleType(elems)
        case .fnT(let params, let caps, let thr, let res): printFnType(params, caps, thr, res)
        default: print("/*?type*/")
    }
}

func printPrefixType(_ kw: Str, _ inner: Vec[Nd]) using Alloc, Log {
    print(kw)
    printType(inner.get(0) ?? errT())
}

func printVecType(_ len: String, _ elem: Vec[Nd]) using Alloc, Log {
    print("[")
    print(len)
    print("]")
    printType(elem.get(0) ?? errT())
}

func printTypeList(_ ts: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < ts.len() {
        if i > 0 { print(", ") }
        printType(ts.get(i) ?? errT())
        i = i + 1
    }
}

func printTupleType(_ elems: Vec[Nd]) using Alloc, Log {
    print("(")
    printTypeList(elems)
    print(")")
}

func printFnType(_ params: Vec[Nd], _ caps: Vec[Nd], _ thr: Vec[Nd], _ res: Vec[Nd]) using Alloc, Log {
    print("(")
    printTypeList(params)
    print(")")
    if caps.len() > 0 {
        print(" using ")
        printTypeList(caps)
    }
    if thr.len() > 0 {
        print(" throws(")
        printType(thr.get(0) ?? errT())
        print(")")
    }
    if res.len() > 0 {
        print(" -> ")
        printType(res.get(0) ?? errT())
    }
}

func printNamed(_ path: String, _ hasGen: Bool, _ args: Vec[Nd]) using Alloc, Log {
    print(path)
    if hasGen {
        print("[")
        var i: Int = 0
        while i < args.len() {
            if i > 0 { print(", ") }
            printType(args.get(i) ?? errT())
            i = i + 1
        }
        print("]")
    }
}

func printOpt(_ inner: Vec[Nd]) using Alloc, Log {
    printType(inner.get(0) ?? errT())
    print("?")
}

func printBlock(_ stmts: Vec[Nd], _ indent: Int) using Alloc, Log {
    print("{\n")
    var i: Int = 0
    while i < stmts.len() {
        printStmt(stmts.get(i) ?? Nd.exprS(noE()), indent + 1)
        i = i + 1
    }
    indentTo(indent)
    print("}")
}

func printStmt(_ s: Nd, _ indent: Int) using Alloc, Log {
    indentTo(indent)
    match s {
        case .letS(let pat, let ty, let value): printBinding("let ", pat, ty, value)
        case .varS(let pat, let ty, let value): printBinding("var ", pat, ty, value)
        case .exprS(let e): printExprStmt(e)
        case .retS(let v): printReturn(v)
        case .assignS(let op, let t, let v): printAssign(op, t, v)
        case .whileS(let c, let b): printWhile(c, b)
        case .forS(let pat, let iter, let b): printFor(pat, iter, b)
        case .breakS(let label): printBreakContinue("break", label)
        case .continueS(let label): printBreakContinue("continue", label)
        default: print("/*?stmt*/\n")
    }
}

func printFor(_ pat: Vec[Nd], _ iter: Vec[Nd], _ b: Vec[Nd]) using Alloc, Log {
    print("for ")
    printPat(pat.get(0) ?? errP())
    print(" in ")
    printExpr(iter.get(0) ?? errE())
    print(" ")
    printExpr(b.get(0) ?? errE())
    print("\n")
}

func printBreakContinue(_ kw: Str, _ label: String) using Log {
    print(kw)
    if !streq(label, "") {
        print(" ")
        print(label)
    }
    print("\n")
}

func printBinding(_ kw: Str, _ pat: Vec[Nd], _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    print(kw)
    printPat(pat.get(0) ?? errP())
    if ty.len() > 0 {
        print(": ")
        printType(ty.get(0) ?? errT())
    }
    print(" = ")
    if value.len() > 0 { printExpr(value.get(0) ?? errE()) }
    print("\n")
}

func printExprStmt(_ e: Vec[Nd]) using Alloc, Log {
    printExpr(e.get(0) ?? errE())
    print("\n")
}

func printReturn(_ v: Vec[Nd]) using Alloc, Log {
    print("return")
    if v.len() > 0 {
        print(" ")
        printExpr(v.get(0) ?? errE())
    }
    print("\n")
}

func printAssign(_ op: String, _ t: Vec[Nd], _ v: Vec[Nd]) using Alloc, Log {
    printExpr(t.get(0) ?? errE())
    print(" ")
    print(op)
    print(" ")
    printExpr(v.get(0) ?? errE())
    print("\n")
}

func printWhile(_ c: Vec[Nd], _ b: Vec[Nd]) using Alloc, Log {
    print("while ")
    printExpr(c.get(0) ?? errE())
    print(" ")
    printExpr(b.get(0) ?? errE())
    print("\n")
}

func printPat(_ p: Nd) using Alloc, Log {
    match p {
        case .wildcard: print("_")
        case .identP(let n): print(n)
        case .bindP(let n): printBind(n)
        case .litP(let inner): printExpr(inner.get(0) ?? errE())
        case .enumP(let cname, let children): printEnumPat(cname, children)
        default: print("/*?pat*/")
    }
}

func printBind(_ n: String) using Log { print("let "); print(n) }

func printEnumPat(_ cname: String, _ children: Vec[Nd]) using Alloc, Log {
    print(".")
    print(cname)
    if children.len() > 0 {
        print("(")
        var i: Int = 0
        while i < children.len() {
            if i > 0 { print(", ") }
            printPat(children.get(i) ?? errP())
            i = i + 1
        }
        print(")")
    }
}

func printExpr(_ e: Nd) using Alloc, Log {
    match e {
        case .intLit(let t): print(t)
        case .floatLit(let t): print(t)
        case .strLit(let t): printQuoted("\"", t, "\"")
        case .byteStrLit(let t): printQuoted("b\"", t, "\"")
        case .charLit(let t): printQuoted("'", t, "'")
        case .boolLit(let b): printBool(b)
        case .nilLit: print("/*?expr*/")
        case .ident(let n): print(n)
        case .selfE: print("self")
        case .leadingDot(let n): printLeadingDot(n)
        case .paren(let inner): printParen(inner)
        case .unary(let op, let operand): printUnary(op, operand)
        case .binary(let op, let l, let r): printBinary(op, l, r)
        case .call(let callee, let args): printCall(callee, args)
        case .arg(let label, let isInout, let val): printArg(label, isInout, val)
        case .member(let base, let n, let chain): printMember(base, n)
        case .index(let base, let idxs): printIndex(base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): printIf(ln, li, cond, thenB, els)
        case .block(let stmts): printBlock(stmts, 0)
        case .asE(let v, let target, let isOpt): printAs(v, target, isOpt)
        case .addrOf(let inner): print("/*?expr*/")
        case .prefixE(let kw, let inner): printPrefixExpr(kw, inner)
        case .doCatchE(let db, let en, let et, let cb): printDoCatch(db, en, et, cb)
        case .quoteE(let inner): printQuote(inner)
        case .spliceE(let bare, let inner): printSplice(bare, inner)
        default: print("/*?expr*/")
    }
}

func printQuote(_ inner: Vec[Nd]) using Alloc, Log {
    print("quote { ")
    printExpr(inner.get(0) ?? errE())
    print(" }")
}

func printSplice(_ bare: Bool, _ inner: Vec[Nd]) using Alloc, Log {
    print("$")
    if bare {
        printExpr(inner.get(0) ?? errE())
    } else {
        print("(")
        printExpr(inner.get(0) ?? errE())
        print(")")
    }
}

func printPrefixExpr(_ kw: String, _ inner: Vec[Nd]) using Alloc, Log {
    print(kw)
    printExpr(inner.get(0) ?? errE())
}

func printDoCatch(_ db: Vec[Nd], _ en: String, _ et: Vec[Nd], _ cb: Vec[Nd]) using Alloc, Log {
    print("do ")
    printExpr(db.get(0) ?? errE())
    print(" catch (")
    print(en)
    print(": ")
    if et.len() > 0 { printType(et.get(0) ?? errT()) }
    print(") ")
    printExpr(cb.get(0) ?? errE())
}

func printQuoted(_ open: Str, _ t: String, _ close: Str) using Log {
    print(open)
    print(t)
    print(close)
}

func printBool(_ b: Bool) using Log { if b { print("true") } else { print("false") } }
func printLeadingDot(_ n: String) using Log { print("."); print(n) }

func printParen(_ inner: Vec[Nd]) using Alloc, Log {
    print("(")
    printExpr(inner.get(0) ?? errE())
    print(")")
}

func printUnary(_ op: String, _ operand: Vec[Nd]) using Alloc, Log {
    print(op)
    printExpr(operand.get(0) ?? errE())
}

func printBinary(_ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc, Log {
    printExpr(l.get(0) ?? errE())
    print(" ")
    print(op)
    print(" ")
    printExpr(r.get(0) ?? errE())
}

func printCall(_ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log {
    printExpr(callee.get(0) ?? errE())
    print("(")
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        printExpr(args.get(i) ?? errE())
        i = i + 1
    }
    print(")")
}

func printArg(_ label: String, _ isInout: Bool, _ val: Vec[Nd]) using Alloc, Log {
    if !streq(label, "") {
        print(label)
        print(": ")
    }
    if isInout { print("&") }
    printExpr(val.get(0) ?? errE())
}

func printMember(_ base: Vec[Nd], _ n: String) using Alloc, Log {
    printExpr(base.get(0) ?? errE())
    print(".")
    print(n)
}

func printIndex(_ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc, Log {
    printExpr(base.get(0) ?? errE())
    print("[")
    var i: Int = 0
    while i < idxs.len() {
        if i > 0 { print(", ") }
        printExpr(idxs.get(i) ?? errE())
        i = i + 1
    }
    print("]")
}

func printIf(_ ln: String, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print("if ")
    if !streq(ln, "") {
        print("let ")
        print(ln)
        print(" = ")
        if li.len() > 0 { printExpr(li.get(0) ?? errE()) }
    } else if cond.len() > 0 {
        printExpr(cond.get(0) ?? errE())
    }
    print(" ")
    printExpr(thenB.get(0) ?? errE())
    if els.len() > 0 {
        print(" else ")
        printExpr(els.get(0) ?? errE())
    }
}

func printAs(_ v: Vec[Nd], _ target: Vec[Nd], _ isOpt: Bool) using Alloc, Log {
    printExpr(v.get(0) ?? errE())
    if isOpt { print(" as? ") } else { print(" as ") }
    printType(target.get(0) ?? errT())
}


// ===========================================================================
// C++ code emission (phase 4). The generated `.cpp` is:
//
//   // Generated by vestra-transpiler. Do not edit.
//   #include "<stem>.hpp"
//   <blank>
//   <definition> <blank> <definition> <blank> ...
//
// Slice 1 emits free functions: `<retType> <name>(<params>) {` then 4-space
// indented body statements, then `}` and a trailing blank line. Read-mode params
// render as `const <type>& <name>`; the result type maps a builtin scalar to its
// C++ spelling (an absent result is `void`).
// ===========================================================================
func noop() {}

func digitChar(_ d: Int) -> Str {
    return "0123456789".slice(d, d + 1)
}

func intToStr(_ n: Int) using Alloc -> String {
    if n == 0 { return own("0") }
    var rev: Vec[Int] = Vec.new()
    var x: Int = n
    while x > 0 {
        rev.push(x % 10)
        x = x / 10
    }
    var s: String = ""
    var i: Int = rev.len() - 1
    while i >= 0 {
        s.append(digitChar(rev.get(i) ?? 0))
        i = i - 1
    }
    return s
}





func containsSub(_ s: String, _ sub: Str) -> Bool {
    let n = s.len()
    let m = sub.len()
    if m == 0 { return true }
    if m > n { return false }
    var i: Int = 0
    while i + m <= n {
        var j: Int = 0
        var ok: Bool = true
        while ok && j < m {
            if (s.byteAt(i + j) ?? 0) != (sub.byteAt(j) ?? 1) { ok = false }
            j = j + 1
        }
        if ok { return true }
        i = i + 1
    }
    return false
}

func exCalleeNameBoxed(_ callee: Vec[Nd]) using Alloc -> String {
    if callee.len() > 0 { return exCalleeName(callee.get(0) ?? Nd.wildcard) }
    return own("")
}

func exCalleeName(_ callee: Nd) using Alloc -> String {
    return match callee {
        case .ident(let nm): nm
        default: own("")
    }
}

// ===========================================================================
// Type inference (ported from selfhost/sema.vst's type checker). The checking
// functions are unused here; codegen drives the table collection + tyInfer to
// recover expression types for type-directed lowerings (force-unwrap, match,
// payload-enum construction).
// ===========================================================================
struct TyEnv {
    var funcName: Vec[String]   // global: function name ...
    var funcRet: Vec[String]    // ... -> return-type spelling ("Unit" if none) ...
    var funcArity: Vec[Int]     // ... -> declared parameter count
    var funcThr: Vec[Nd]        // ... -> `throws(E)` type NODE (wildcard if the function does not throw)
    var pFn: Vec[String]        // global: per-parameter rows — function name ...
    var pIdx: Vec[Int]          // ... parameter index ...
    var pType: Vec[String]      // ... -> parameter type spelling
    var pTyNode: Vec[Nd]        // ... -> parameter type NODE (wildcard if unannotated; for closure-arg lowering)
    var pMode: Vec[String]      // ... -> parameter mode ("", "inout ", "sink " — parser spelling)
    var structs: Vec[String]    // global: struct names (construction yields that type)
    var genTypes: Vec[String]   // global: GENERIC struct/enum names (construction needs the instantiated C++ name)
    var gpOwner: Vec[String]    // global: generic-parameter rows — owning struct / function name ...
    var gpName: Vec[String]     // ... -> parameter name, in declaration order
    var bindFn: String          // per-call: the generic callee whose result binding is pending ...
    var bindName: Vec[String]   // ... -> generic parameter names bound from the expected type ...
    var bindVal: Vec[String]    // ... -> their spellings
    var sFldStruct: Vec[String] // global: per-field rows — owning struct ...
    var sFldName: Vec[String]   // ... field name ...
    var sFldType: Vec[String]   // ... -> field type spelling (embeds excluded)
    var mStruct: Vec[String]    // global: per-method rows — owning struct/enum ...
    var mName: Vec[String]      // ... method name ...
    var mRet: Vec[String]       // ... -> result-type spelling ("Unit" if none, "Self"->owner)
    var mpOwner: Vec[String]    // global: per-method-parameter rows — owning struct/enum ...
    var mpName: Vec[String]     // ... method name ...
    var mpIdx: Vec[Int]         // ... parameter index ...
    var mpTyNode: Vec[Nd]       // ... -> parameter type NODE (wildcard if unannotated; for closure-arg lowering)
    var eName: Vec[String]      // global: enum names (a bare `E.case` is a type ref)
    var ecEnum: Vec[String]     // global: per-case rows — owning enum ...
    var ecName: Vec[String]     // ... case name ...
    var ecArity: Vec[Int]       // ... -> payload field count
    var ecfEnum: Vec[String]    // global: per-payload-field rows — owning enum ...
    var ecfCase: Vec[String]    // ... case name ...
    var ecfIdx: Vec[Int]        // ... field index ...
    var ecfName: Vec[String]    // ... -> declared field label ("" if positional)
    var ecfTy: Vec[String]      // ... -> declared field TYPE spelling (for typing a match arm's payload binding)
    var dvTarget: Vec[String]   // global: per-derive rows — target type name ...
    var dvProto: Vec[String]    // ... -> one derived protocol (a `derive(Eq, Hash) for T` pushes one row each)
    var opName: Vec[String]     // global: §3 opaque newtype names ...
    var opUnder: Vec[Nd]        // ... -> the underlying type NODE (for `.value` and the derive specs)
    var moveOnly: Vec[String]   // global: §10 struct/enum names that transitively own a Box (C++ non-copyable)
    var symName: Vec[String]    // per-function: binding name ...
    var symType: Vec[String]    // ... -> type spelling
    var gName: Vec[String]      // global: annotated top-level const / static name ...
    var gType: Vec[String]      // ... -> type spelling (a local of the same name shadows it)
    var curRet: String          // per-function: enclosing function's result spelling ("Unit" if none)
    var curRetNode: Vec[Nd]     // per-function: the result TYPE node (for emitting the C++ return type, e.g. a match lambda)
    var tryN: Int               // file-global `__vstr_t<N>` / `__vstr_c<N>` hoist counter (monotonic, never reset — matches the bootstrap)
    var hoistName: Vec[String]  // per-statement: pending propagating-`try` hoist names, in collection order ...
    var hoistExpr: Vec[Nd]      // ... -> the try's operand (the fallible call), or the whole if for a cond hoist
    var hoistKind: Vec[Bool]    // ... -> true for a conditional hoist (expected-returning lambda), false for the 3-line escape
    var hoistNext: Int          // per-statement: next hoist name a `try` use-site consumes
    var condUse: String         // per-statement: the cond-hoist name the statement's use-site reads via `(*name)` ("" if none)
    var condTy: Vec[Nd]         // per-statement: the cond-hoist lambda's success-type node (empty box = void)
    var condTyStr: String       // per-statement: C++ success-type SPELLING when no node exists (a statement-position match types as its arms)
    var armTo: String           // per-match: Vestra type SPELLING an arm body flows into ("" if none) — resolves a leading-dot case in an arm
    var curThrowsNode: Vec[Nd]  // per-function: the `throws(E)` type node (empty when the function does not throw)
    var curAsync: Bool          // per-function: enclosing function is `async` (returns lower to co_return)
    var curUnitThrows: Bool     // per-function: Unit-returning `throws(E)` (std::expected<void, E>): a bare return is `return {};` (F9b)
    var curAttrs: Vec[Nd]       // per-declaration: the top-level func / static being emitted's attributes
    var imports: Vec[String]    // global: imported module paths (a member base naming one qualifies with `::`)
    var hasModule: Bool         // global: unit declares `module ...` (an entry `main` only exists OUTSIDE a module)
    var tpN: Int                // file-global `__vstr_tp_unused_<N>` tuple-wildcard counter (monotonic, matches the bootstrap)
    var bad: Vec[String]
}

func tyCheck(_ env: inout TyEnv, _ u: NUnit) using Alloc {
    var i: Int = 0
    while i < u.decls.len() {
        tyCollectDecl(env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    var j: Int = 0
    while j < u.decls.len() {
        tyCheckDecl(env, u.decls.get(j) ?? Nd.wildcard)
        j = j + 1
    }
}

// ----- pass 1: function return types and struct names -----------------------
func tyCollectDecl(_ env: inout TyEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b, let attrs):
            tyRecordFuncG(env, name, g, params, t, r)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics, let attrs): tyRecordStructDecl(env, name, fl, m, generics)
        case .enumD(let vis, let name, let cs, let m, let generics): tyRecordEnumDecl(env, name, cs, m, generics)
        case .deriveD(let protocols, let target): tyRecordDerive(env, protocols, target)
        case .opaqueD(let vis, let name, let under): tyRecordOpaque(env, name, under)
        case .constD(let vis, let name, let ty, let v): tyRecordGlobal(env, name, ty)
        case .staticD(let vis, let name, let ty, let v, let attrs): tyRecordGlobal(env, name, ty)
        default: noop()
    }
}

// A top-level const / static types every function body's reference to it
// (`counter.load(.seqCst)` needs the receiver's Atomic type). Only an
// annotated one has a spelling to record.
func tyRecordGlobal(_ env: inout TyEnv, _ name: Str, _ ty: Vec[Nd]) using Alloc {
    let sp = tyAnnSpelling(ty)
    if streq(sp, "") { return }
    env.gName.push(own(name))
    env.gType.push(sp)
}

// §3 `opaque type Q = T` — one row per newtype, keeping T's node so `q.value`
// and the derived Hash/Debug specs can spell the underlying.
func tyRecordOpaque(_ env: inout TyEnv, _ name: Str, _ under: Vec[Nd]) using Alloc {
    env.opName.push(own(name))
    env.opUnder.push(under.get(0) ?? Nd.wildcard)
}

func tyOpaqueIdx(_ env: inout TyEnv, _ name: Str) -> Int {
    var i: Int = 0
    while i < env.opName.len() {
        if let n = env.opName.get(i) {
            if streq(n, name) { return i }
        }
        i = i + 1
    }
    return -1
}

func tyIsOpaque(_ env: inout TyEnv, _ name: Str) -> Bool {
    return tyOpaqueIdx(env, name) >= 0
}

// The underlying type node of opaque <name> (wildcard if <name> is not one).
func tyOpaqueUnder(_ env: inout TyEnv, _ name: Str) -> Nd {
    let i = tyOpaqueIdx(env, name)
    if i < 0 { return Nd.wildcard }
    return env.opUnder.get(i) ?? Nd.wildcard
}

// §12.3 `derive(Eq, Hash) for T` — one row per protocol, keyed by the target's
// LAST path segment (a qualified target derives on the named type itself).
func tyRecordDerive(_ env: inout TyEnv, _ protocols: Vec[Nd], _ target: Vec[Nd]) using Alloc {
    let tn = tyAnnSpelling(target)
    if streq(tn, "") { return }
    var i: Int = 0
    while i < protocols.len() {
        tyPushDerive(env, tn, protocols.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyPushDerive(_ env: inout TyEnv, _ target: Str, _ proto: Nd) using Alloc {
    let pn = typeSpelling(proto)
    if streq(pn, "") { return }
    env.dvTarget.push(own(target))
    env.dvProto.push(pn)
}

// Whether <target> derives <proto>. A generic target is recorded under its bare
// name, so the lookup compares base names.
func tyDerives(_ env: inout TyEnv, _ target: Str, _ proto: Str) using Alloc -> Bool {
    let bn = genBaseOf(target)
    var i: Int = 0
    while i < env.dvTarget.len() {
        if let t = env.dvTarget.get(i) {
            if streq(t, bn) {
                if let pr = env.dvProto.get(i) { if streq(pr, proto) { return true } }
            }
        }
        i = i + 1
    }
    return false
}

// §12.3 the derive-generated members that live INSIDE the type: a defaulted
// operator== for Eq (the C++ compiler recurses through nested derived-Eq
// members for free), and an explicit clone() for Clone that delegates to the
// implicit copy constructor. Shared by the struct and the sum-type enum
// wrapper, which emit the identical pair.
func emitDerivedMembers(_ env: inout TyEnv, _ name: Str) using Alloc, Log {
    if tyDerives(env, name, "Eq") {
        print("    [[nodiscard]] bool operator==(const ")
        print(name)
        print("&) const noexcept = default;\n")
    }
    if tyDerives(env, name, "Clone") {
        print("    [[nodiscard]] ")
        print(name)
        print(" clone() const { return *this; }\n")
    }
}

func tyRecordEnumDecl(_ env: inout TyEnv, _ name: String, _ cases: Vec[Nd], _ methods: Vec[Nd], _ generics: Vec[Nd]) using Alloc {
    if generics.len() > 0 { env.genTypes.push(name) }
    env.eName.push(name)
    var i: Int = 0
    while i < cases.len() {
        tyRecordCase(env, name, cases.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyRecordMethods(env, name, methods)
}

func tyRecordCase(_ env: inout TyEnv, _ enumName: String, _ c: Nd) using Alloc {
    match c {
        case .enumCase(let cn, let pay): tyPushCaseFields(env, enumName, cn, pay)
        default: noop()
    }
}

func tyPushCaseFields(_ env: inout TyEnv, _ enumName: String, _ cn: String, _ pay: Vec[Nd]) using Alloc {
    tyPushCase(env, enumName, cn, pay.len())
    var i: Int = 0
    while i < pay.len() {
        tyPushCaseField(env, enumName, cn, i, pay.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyPushCaseField(_ env: inout TyEnv, _ enumName: String, _ cn: String, _ idx: Int, _ pe: Nd) using Alloc {
    match pe {
        case .payElem(let label, let ty): tyPushCaseFieldTyped(env, enumName, cn, idx, label, ty)
        default: noop()
    }
}

func tyPushCaseFieldTyped(_ env: inout TyEnv, _ enumName: String, _ cn: String, _ idx: Int, _ label: String, _ ty: Vec[Nd]) using Alloc {
    let sp = tyAnnSpelling(ty)
    tyPushCaseFieldRow(env, enumName, cn, idx, label, sp)
}

func tyPushCaseFieldRow(_ env: inout TyEnv, _ enumName: String, _ cn: String, _ idx: Int, _ label: String, _ sp: String) using Alloc {
    env.ecfEnum.push(enumName)
    env.ecfCase.push(cn)
    env.ecfIdx.push(idx)
    env.ecfName.push(label)
    env.ecfTy.push(sp)
}

func tyPushCase(_ env: inout TyEnv, _ enumName: String, _ cn: String, _ arity: Int) using Alloc {
    env.ecEnum.push(enumName)
    env.ecName.push(cn)
    env.ecArity.push(arity)
}

// The declared label of payload field <idx> of <enum>.<case> — "" when the field
// is positional (or the case is unknown), in which case it lowers to `._<idx>`.
func tyPayFieldName(_ env: inout TyEnv, _ enumName: Str, _ cn: Str, _ idx: Int) using Alloc -> String {
    let bn = genBaseOf(enumName)
    var i: Int = 0
    while i < env.ecfEnum.len() {
        if let e = env.ecfEnum.get(i) {
            if streq(e, bn) && (env.ecfIdx.get(i) ?? -1) == idx {
                if let c = env.ecfCase.get(i) {
                    if streq(c, cn) { return env.ecfName.get(i) ?? own("") }
                }
            }
        }
        i = i + 1
    }
    return own("")
}

// The declared TYPE spelling of payload field <idx> of <enum>.<case> — "" when
// the case is unknown. Companion of `tyPayFieldName` over the same rows.
func tyPayFieldTy(_ env: inout TyEnv, _ enumName: Str, _ cn: Str, _ idx: Int) using Alloc -> String {
    let bn = genBaseOf(enumName)
    var i: Int = 0
    while i < env.ecfEnum.len() {
        if let e = env.ecfEnum.get(i) {
            if streq(e, bn) && (env.ecfIdx.get(i) ?? -1) == idx {
                if let c = env.ecfCase.get(i) {
                    if streq(c, cn) { return env.ecfTy.get(i) ?? own("") }
                }
            }
        }
        i = i + 1
    }
    return own("")
}

func tyCaseArity(_ env: inout TyEnv, _ enumName: String, _ cn: String) -> Int {
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let e = env.ecEnum.get(i) {
            if streq(e, enumName) {
                if let c = env.ecName.get(i) {
                    if streq(c, cn) { return env.ecArity.get(i) ?? -1 }
                }
            }
        }
        i = i + 1
    }
    return -1
}

func tyIsEnum(_ env: inout TyEnv, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.eName.len() {
        if let n = env.eName.get(i) {
            if streq(n, name) { return true }
        }
        i = i + 1
    }
    return false
}

func tyEnumHasCase(_ env: inout TyEnv, _ enumName: String, _ caseName: String) -> Bool {
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let e = env.ecEnum.get(i) {
            if streq(e, enumName) {
                if let c = env.ecName.get(i) {
                    if streq(c, caseName) { return true }
                }
            }
        }
        i = i + 1
    }
    return false
}

func tyRecordStructDecl(_ env: inout TyEnv, _ name: String, _ fields: Vec[Nd], _ methods: Vec[Nd], _ generics: Vec[Nd]) using Alloc {
    if generics.len() > 0 { env.genTypes.push(name) }
    tyRecordGenParams(env, name, generics)
    tyRecordStruct(env, name, fields)
    tyRecordMethods(env, name, methods)
}

func tyIsGenType(_ env: inout TyEnv, _ name: Str) -> Bool {
    var i: Int = 0
    while i < env.genTypes.len() {
        if let g = env.genTypes.get(i) { if streq(g, name) { return true } }
        i = i + 1
    }
    return false
}

// Record each user-declared method's result spelling under its owning type. A
// method with its OWN generic parameters is skipped (its result may name a type
// variable we can't resolve) so it stays unknown and tolerated, like a builtin.
func tyRecordMethods(_ env: inout TyEnv, _ owner: String, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        tyRecordMethod(env, owner, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRecordMethod(_ env: inout TyEnv, _ owner: String, _ m: Nd) using Alloc {
    match m {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b, let attrs):
            tyPushMethod(env, owner, name, g, params, r)
        default: noop()
    }
}

func tyPushMethod(_ env: inout TyEnv, _ owner: String, _ name: String, _ gens: Vec[Nd], _ params: Vec[Nd], _ result: Vec[Nd]) using Alloc {
    if gens.len() > 0 { return }
    env.mStruct.push(owner)
    env.mName.push(name)
    env.mRet.push(tyRetSpelling(result))
    var i: Int = 0
    while i < params.len() {
        tyPushMethodParam(env, owner, name, i, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyPushMethodParam(_ env: inout TyEnv, _ owner: String, _ name: String, _ idx: Int, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty, let ppat): tyPushMethodParamRow(env, owner, name, idx, tyAnnNode(ty))
        default: noop()
    }
}

func tyPushMethodParamRow(_ env: inout TyEnv, _ owner: String, _ name: String, _ idx: Int, _ tn: Nd) using Alloc {
    env.mpOwner.push(owner)
    env.mpName.push(name)
    env.mpIdx.push(idx)
    env.mpTyNode.push(tn)
}

func tyMethodParamTypeNode(_ env: inout TyEnv, _ owner: Str, _ mname: Str, _ idx: Int) using Alloc -> Nd {
    var i: Int = 0
    while i < env.mpOwner.len() {
        if let o = env.mpOwner.get(i) {
            if streq(o, owner) && (env.mpIdx.get(i) ?? -1) == idx {
                if let n = env.mpName.get(i) {
                    if streq(n, mname) { return env.mpTyNode.get(i) ?? Nd.wildcard }
                }
            }
        }
        i = i + 1
    }
    return Nd.wildcard
}

func tyRecordStruct(_ env: inout TyEnv, _ name: String, _ fields: Vec[Nd]) using Alloc {
    env.structs.push(name)
    var i: Int = 0
    while i < fields.len() {
        tyRecordField(env, name, fields.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRecordField(_ env: inout TyEnv, _ structName: String, _ f: Nd) using Alloc {
    match f {
        case .field(let kind, let fname, let fty, let fattrs): tyPushField(env, structName, kind, fname, fty)
        default: noop()
    }
}

// Record a constructible field (`let`/`var`); embeds aren't set by label.
func tyPushField(_ env: inout TyEnv, _ structName: String, _ kind: String, _ fname: String, _ fty: Vec[Nd]) using Alloc {
    if containsSub(kind, "embed") { return }
    env.sFldStruct.push(structName)
    env.sFldName.push(fname)
    env.sFldType.push(tyAnnSpelling(fty))
}

func tyHasField(_ env: inout TyEnv, _ structName: String, _ label: String) -> Bool {
    var i: Int = 0
    while i < env.sFldStruct.len() {
        if let s = env.sFldStruct.get(i) {
            if streq(s, structName) {
                if let fn = env.sFldName.get(i) {
                    if streq(fn, label) { return true }
                }
            }
        }
        i = i + 1
    }
    return false
}

func tyFieldType(_ env: inout TyEnv, _ structName: String, _ label: String) using Alloc -> String {
    var i: Int = 0
    while i < env.sFldStruct.len() {
        if let s = env.sFldStruct.get(i) {
            if streq(s, structName) {
                if let fn = env.sFldName.get(i) {
                    if streq(fn, label) { return env.sFldType.get(i) ?? own("") }
                }
            }
        }
        i = i + 1
    }
    return own("")
}

// §7 a generic struct's / function's parameter names, in order, so an
// instantiation spelling (`Buffer[Int32, 4]`) can substitute into a member's
// declared spelling (`[N]T` -> `[4]Int32`).
func tyRecordGenParams(_ env: inout TyEnv, _ owner: Str, _ generics: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < generics.len() {
        env.gpOwner.push(own(owner))
        env.gpName.push(genName(generics.get(i) ?? Nd.wildcard))
        i = i + 1
    }
}

func tyGenNames(_ env: inout TyEnv, _ owner: Str) using Alloc -> Vec[String] {
    var out: Vec[String] = Vec.new()
    var i: Int = 0
    while i < env.gpOwner.len() {
        if streq(env.gpOwner.get(i) ?? own(""), owner) { out.push(env.gpName.get(i) ?? own("")) }
        i = i + 1
    }
    return out
}

// The arguments of an instantiation spelling: `Buffer[Int32, 4]` ->
// [Int32, 4] (bracket-depth-aware, via the tuple splitter).
func tyInstArgs(_ sp: String) using Alloc -> Vec[String] {
    var t: String = "("
    t.append(tyBracketInner(sp))
    t.append(")")
    return tyTupleParts(t)
}

// Replace each identifier token of `sp` that names a parameter with its
// value: `[N]T` under N=4, T=Int32 -> `[4]Int32`.
func tySubstSp(_ sp: Str, _ names: Vec[String], _ vals: Vec[String]) using Alloc -> String {
    var out: String = ""
    var i: Int = 0
    while i < sp.len() {
        let c = sp.byteAt(i) ?? 0
        if isIdentStartByte(c) {
            var j: Int = i
            while j < sp.len() && isIdentByte(sp.byteAt(j) ?? 0) { j = j + 1 }
            let tok = sp.slice(i, j)
            out.append(substTok(tok, names, vals))
            i = j
        } else {
            out.append(sp.slice(i, i + 1))
            i = i + 1
        }
    }
    return out
}

func substTok(_ tok: Str, _ names: Vec[String], _ vals: Vec[String]) using Alloc -> String {
    var k: Int = 0
    while k < names.len() {
        if streq(names.get(k) ?? own(""), tok) { return own(vals.get(k) ?? own(tok)) }
        k = k + 1
    }
    return own(tok)
}

func isIdentStartByte(_ c: UInt8) -> Bool {
    return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

func isIdentByte(_ c: UInt8) -> Bool {
    return isIdentStartByte(c) || (c >= 48 && c <= 57)
}

// A field of an instantiated generic struct, its declared spelling with the
// instantiation substituted; "" when `bt` is not such an instantiation.
func tyInstFieldType(_ env: inout TyEnv, _ bt: String, _ name: String) using Alloc -> String {
    if !spHasBracket(bt) { return own("") }
    let base = genBaseOf(bt)
    if !tyIsGenType(env, base) || !tyHasField(env, base, name) { return own("") }
    let names = tyGenNames(env, base)
    let vals = tyInstArgs(bt)
    let ft = tyFieldType(env, base, name)
    if names.len() != vals.len() { return own(ft) }
    return tySubstSp(ft, names, vals)
}

func tyRecordFuncG(_ env: inout TyEnv, _ name: String, _ g: Vec[Nd], _ params: Vec[Nd], _ thr: Vec[Nd], _ result: Vec[Nd]) using Alloc {
    tyRecordGenParams(env, name, g)
    tyRecordFunc(env, name, params, thr, result)
}

func tyRecordFunc(_ env: inout TyEnv, _ name: String, _ params: Vec[Nd], _ thr: Vec[Nd], _ result: Vec[Nd]) using Alloc {
    env.funcName.push(name)
    env.funcThr.push(thr.get(0) ?? Nd.wildcard)
    if result.len() == 0 { env.funcRet.push("Unit") }
    else { env.funcRet.push(typeSpelling(result.get(0) ?? Nd.wildcard)) }
    env.funcArity.push(params.len())
    var i: Int = 0
    while i < params.len() {
        tyRecordParam(env, name, i, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRecordParam(_ env: inout TyEnv, _ name: String, _ idx: Int, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty, let ppat): tyPushParam(env, name, idx, tyAnnSpelling(ty), tyAnnNode(ty), md)
        default: noop()
    }
}

func tyAnnNode(_ ty: Vec[Nd]) using Alloc -> Nd {
    return ty.get(0) ?? Nd.wildcard
}

func tyPushParam(_ env: inout TyEnv, _ name: String, _ idx: Int, _ sp: String, _ tn: Nd, _ md: String) using Alloc {
    env.pFn.push(name)
    env.pIdx.push(idx)
    env.pType.push(sp)
    env.pTyNode.push(tn)
    env.pMode.push(md)
}

func tyParamMode(_ env: inout TyEnv, _ name: Str, _ idx: Int) using Alloc -> String {
    var i: Int = 0
    while i < env.pFn.len() {
        if let n = env.pFn.get(i) {
            if streq(n, name) && (env.pIdx.get(i) ?? -1) == idx { return env.pMode.get(i) ?? own("") }
        }
        i = i + 1
    }
    return own("")
}

func tyArity(_ env: inout TyEnv, _ name: String) -> Int {
    var i: Int = 0
    while i < env.funcName.len() {
        if let n = env.funcName.get(i) {
            if streq(n, name) { return env.funcArity.get(i) ?? -1 }
        }
        i = i + 1
    }
    return -1
}

func tyParamType(_ env: inout TyEnv, _ name: String, _ idx: Int) using Alloc -> String {
    var i: Int = 0
    while i < env.pFn.len() {
        if let n = env.pFn.get(i) {
            if streq(n, name) && (env.pIdx.get(i) ?? -1) == idx { return env.pType.get(i) ?? own("") }
        }
        i = i + 1
    }
    return own("")
}

func tyParamTypeNode(_ env: inout TyEnv, _ name: Str, _ idx: Int) using Alloc -> Nd {
    var i: Int = 0
    while i < env.pFn.len() {
        if let n = env.pFn.get(i) {
            if streq(n, name) && (env.pIdx.get(i) ?? -1) == idx { return env.pTyNode.get(i) ?? Nd.wildcard }
        }
        i = i + 1
    }
    return Nd.wildcard
}

func tyFuncRet(_ env: inout TyEnv, _ name: String) using Alloc -> String {
    var i: Int = 0
    while i < env.funcName.len() {
        if let n = env.funcName.get(i) {
            if streq(n, name) { return env.funcRet.get(i) ?? own("") }
        }
        i = i + 1
    }
    return own("")
}

func tyIsStruct(_ env: inout TyEnv, _ name: String) -> Bool {
    var i: Int = 0
    while i < env.structs.len() {
        if let s = env.structs.get(i) {
            if streq(s, name) { return true }
        }
        i = i + 1
    }
    return false
}

// ----- pass 2: per-function walk --------------------------------------------
func tyCheckDecl(_ env: inout TyEnv, _ d: Nd) using Alloc {
    match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b, let attrs):
            tyCheckFunc(env, name, params, r, b)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics, let attrs): tyCheckMethods(env, m)
        case .enumD(let vis, let name, let cs, let m, let generics): tyCheckMethods(env, m)
        case .constD(let vis, let name, let ty, let v): tyCheckConst(env, ty, v)
        default: noop()
    }
}

func tyCheckMethods(_ env: inout TyEnv, _ methods: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < methods.len() {
        tyCheckDecl(env, methods.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyCheckFunc(_ env: inout TyEnv, _ name: String, _ params: Vec[Nd], _ result: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    env.curRet = tyRetSpelling(result)
    tyResetSyms(env)
    tyRegisterParams(env, params)
    tyBoxed(env, body)
    tyCheckBodyProduces(env, name, body)
}

func tyRetSpelling(_ result: Vec[Nd]) using Alloc -> String {
    if result.len() == 0 { return own("Unit") }
    return typeSpelling(result.get(0) ?? Nd.wildcard)
}

// §10/§17 — when the body's trailing expression is present and its type is not
// assignable to the declared (non-Unit) result, the implicit return is wrong.
// A body ending in a non-expression statement (let / return / ...) produces Unit
// and is tolerated (an explicit return we don't flow-check).
func tyCheckBodyProduces(_ env: inout TyEnv, _ name: String, _ body: Vec[Nd]) using Alloc {
    if streq(env.curRet, "") || streq(env.curRet, "Unit") { return }
    let bt = tyBodyType(env, body)
    if streq(bt, "") || streq(bt, "Unit") { return }
    if !tyAssignable(bt, env.curRet) { env.bad.push(tyBodyMsg(name, env.curRet, bt)) }
}

func tyBodyType(_ env: inout TyEnv, _ body: Vec[Nd]) using Alloc -> String {
    if body.len() == 0 { return own("Unit") }
    return tyBlockLastType(env, body.get(0) ?? Nd.wildcard)
}

func tyBlockLastType(_ env: inout TyEnv, _ blk: Nd) using Alloc -> String {
    return match blk {
        case .block(let stmts): tyLastStmtType(env, stmts)
        default: own("Unit")
    }
}

func tyLastStmtType(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc -> String {
    if stmts.len() == 0 { return own("Unit") }
    return tyStmtType(env, stmts.get(stmts.len() - 1) ?? Nd.wildcard)
}

func tyStmtType(_ env: inout TyEnv, _ s: Nd) using Alloc -> String {
    return match s {
        case .exprS(let e): tyInferBoxed(env, e)
        default: own("Unit")
    }
}

func tyResetSyms(_ env: inout TyEnv) using Alloc {
    while env.symName.len() > 0 { let _ = env.symName.pop() }
    while env.symType.len() > 0 { let _ = env.symType.pop() }
}

func tyRegisterParams(_ env: inout TyEnv, _ params: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < params.len() {
        tyRegisterParam(env, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyRegisterParam(_ env: inout TyEnv, _ p: Nd) using Alloc {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty, let ppat): tyAddSym(env, nm, ty)
        default: noop()
    }
}

// Register a binding's type from its annotation (empty annotation => untracked).
func tyAddSym(_ env: inout TyEnv, _ name: String, _ ty: Vec[Nd]) using Alloc {
    let sp = tyAnnSpelling(ty)
    if !streq(sp, "") {
        env.symName.push(name)
        env.symType.push(sp)
    }
}

func tySymType(_ env: inout TyEnv, _ name: String) using Alloc -> String {
    var i: Int = 0
    while i < env.symName.len() {
        if let n = env.symName.get(i) {
            if streq(n, name) { return env.symType.get(i) ?? own("") }
        }
        i = i + 1
    }
    var g: Int = 0
    while g < env.gName.len() {
        if let n = env.gName.get(g) {
            if streq(n, name) { return env.gType.get(g) ?? own("") }
        }
        g = g + 1
    }
    return own("")
}

func tyCheckConst(_ env: inout TyEnv, _ ty: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    let ann = tyAnnSpelling(ty)
    if streq(ann, "") { return }
    let vt = tyInferBoxed(env, v)
    if !tyAssignable(vt, ann) { env.bad.push(tyConstMsg(vt, ann)) }
}

// ----- statement / expression walk (find every let/var, check initializers) -
func tyBoxed(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { tyExpr(env, v.get(0) ?? Nd.wildcard) }
}

func tyPair(_ env: inout TyEnv, _ a: Vec[Nd], _ b: Vec[Nd]) using Alloc {
    tyBoxed(env, a)
    tyBoxed(env, b)
}

func tyExpr(_ env: inout TyEnv, _ e: Nd) using Alloc {
    match e {
        case .call(let callee, let args): tyExprCall(env, callee, args)
        case .prefixE(let kw, let inner): tyBoxed(env, inner)
        case .paren(let x): tyBoxed(env, x)
        case .unary(let op, let x): tyUnary(env, op, x)
        case .binary(let op, let l, let r): tyBinary(env, op, l, r)
        case .member(let base, let n, let c): tyMember(env, base, n, c)
        case .index(let base, let idxs): tyIndex(env, base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): tyIf(env, li, cond, thenB, els)
        case .block(let stmts): tyBlock(env, stmts)
        case .asE(let v, let t, let o): tyBoxed(env, v)
        case .addrOf(let x): tyBoxed(env, x)
        case .arg(let l, let io, let v): tyBoxed(env, v)
        case .throwE(let inner): tyBoxed(env, inner)
        case .matchE(let scrut, let arms): tyMatch(env, scrut, arms)
        case .doCatchE(let db, let en, let et, let cb): tyPair(env, db, cb)
        default: noop()
    }
}

// Walk a match: descend the scrutinee and every arm body, and require each arm's
// `where` guard to be Bool. (Pattern-bound variables type as unknown here and are
// tolerated; arm-result-type unification is a later slice.)
func tyMatch(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    tyBoxed(env, scrut)
    var i: Int = 0
    while i < arms.len() {
        tyArm(env, arms.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyCheckArmPatterns(env, scrut, arms)
    tyCheckExhaustive(env, scrut, arms)
    tyCheckArmTypes(env, arms)
}

// Validate each arm pattern against the scrutinee type: an enum-case pattern on a
// non-enum scrutinee; a payload-binding count that disagrees with the case; and a
// literal pattern whose type does not match the scrutinee. (An unknown scrutinee
// type is tolerated; default / catch-all arms carry no pattern.)
func tyCheckArmPatterns(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    let st = tyInferBoxed(env, scrut)
    if streq(st, "") { return }
    var i: Int = 0
    while i < arms.len() {
        tyCheckArmPattern(env, st, arms.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyCheckArmPattern(_ env: inout TyEnv, _ st: String, _ a: Nd) using Alloc {
    match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyCheckPatBoxed(env, st, pat)
        default: noop()
    }
}

func tyCheckPatBoxed(_ env: inout TyEnv, _ st: String, _ pat: Vec[Nd]) using Alloc {
    if pat.len() > 0 { tyCheckPatNode(env, st, pat.get(0) ?? Nd.wildcard) }
}

func tyCheckPatNode(_ env: inout TyEnv, _ st: String, _ p: Nd) using Alloc {
    match p {
        case .enumP(let cn, let children): tyCheckEnumPat(env, st, cn, children)
        case .litP(let inner): tyCheckLitPat(env, st, inner)
        case .orP(let alts): tyCheckAltPats(env, st, alts)
        default: noop()
    }
}

func tyCheckAltPats(_ env: inout TyEnv, _ st: String, _ alts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < alts.len() {
        tyCheckPatNode(env, st, alts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyCheckEnumPat(_ env: inout TyEnv, _ st: String, _ cn: String, _ children: Vec[Nd]) using Alloc {
    if !tyIsEnum(env, st) { env.bad.push(tyEnumPatNonEnumMsg(cn, st)); return }
    let arity = tyCaseArity(env, st, cn)
    if arity >= 0 && children.len() != arity { env.bad.push(tyPayloadArityMsg(cn, arity, children.len())) }
}

func tyCheckLitPat(_ env: inout TyEnv, _ st: String, _ inner: Vec[Nd]) using Alloc {
    let lt = tyInferBoxed(env, inner)
    if streq(lt, "") { return }
    if !tyAssignable(lt, st) && !tyAssignable(st, lt) { env.bad.push(tyLitScrutMsg(lt, st)) }
}

func tyEnumPatNonEnumMsg(_ cn: String, _ st: String) using Alloc -> String {
    var s: String = "enum pattern '."
    s.append(cn)
    s.append("' used against non-enum type ")
    s.append(st)
    return s
}

func tyPayloadArityMsg(_ cn: String, _ arity: Int, _ binds: Int) using Alloc -> String {
    var s: String = "case '"
    s.append(cn)
    s.append("' has ")
    s.append(intToStr(arity))
    s.append(" payload field(s), pattern binds ")
    s.append(intToStr(binds))
    return s
}

func tyLitScrutMsg(_ lt: String, _ st: String) using Alloc -> String {
    var s: String = "literal of type "
    s.append(lt)
    s.append(" does not match scrutinee of type ")
    s.append(st)
    return s
}

// The arm bodies must share one type. The first arm with a known type sets the
// baseline; a later arm whose known type is incompatible reports
// "match arms have different types: <baseline> vs <arm>", after which the
// baseline becomes the error type so every following known arm reports
// "<error> vs <arm>" (mirroring the resolver's cascade). Arms whose body type is
// unknown are skipped. NB this unifies the arms among themselves (no expected
// type is threaded in), so it matches the resolver only where the match has no
// expected type, e.g. an unannotated `let x = match …`.
func tyCheckArmTypes(_ env: inout TyEnv, _ arms: Vec[Nd]) using Alloc {
    var unified: String = ""
    var errored: Bool = false
    var i: Int = 0
    while i < arms.len() {
        let t = tyArmBodyType(env, arms.get(i) ?? Nd.wildcard)
        if !streq(t, "") {
            if errored {
                env.bad.push(tyArmDiffMsg("<error>", t))
            } else if streq(unified, "") {
                unified = own(t)
            } else if !tyArmCompatible(unified, t) {
                env.bad.push(tyArmDiffMsg(unified, t))
                errored = true
            }
        }
        i = i + 1
    }
}

func tyArmBodyType(_ env: inout TyEnv, _ a: Nd) using Alloc -> String {
    return match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyInferBoxed(env, body)
        default: own("")
    }
}

func tyArmCompatible(_ a: String, _ b: String) using Alloc -> Bool {
    return tyAssignable(a, b) || tyAssignable(b, a)
}

func tyArmDiffMsg(_ x: Str, _ y: Str) using Alloc -> String {
    var s: String = "match arms have different types: "
    s.append(x)
    s.append(" vs ")
    s.append(y)
    return s
}

// When the scrutinee is a known enum and no arm is a catch-all (a `default` or a
// `_` wildcard), every case must be covered by some arm's pattern, else
// "match is not exhaustive: case '<c>' is not covered" — one per uncovered case,
// in declaration order. Guards do not affect coverage (matching the resolver).
func tyCheckExhaustive(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    let st = tyInferBoxed(env, scrut)
    if !tyIsEnum(env, st) { return }
    if tyHasCatchAll(arms) { return }
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let e = env.ecEnum.get(i) {
            if streq(e, st) {
                if let cn = env.ecName.get(i) {
                    if !tyArmsCover(arms, cn) { env.bad.push(notExhaustiveMsg(cn)) }
                }
            }
        }
        i = i + 1
    }
}

func tyHasCatchAll(_ arms: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < arms.len() {
        if tyArmIsCatchAll(arms.get(i) ?? Nd.wildcard) { return true }
        i = i + 1
    }
    return false
}

func tyArmIsCatchAll(_ a: Nd) -> Bool {
    return match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyDefaultOrWild(isDef, pat)
        default: false
    }
}

func tyDefaultOrWild(_ isDef: Bool, _ pat: Vec[Nd]) -> Bool {
    if isDef { return true }
    if pat.len() == 0 { return false }
    return tyPatIsWild(pat.get(0) ?? Nd.wildcard)
}

func tyPatIsWild(_ p: Nd) -> Bool {
    return match p {
        case .wildcard: true
        default: false
    }
}

func tyArmsCover(_ arms: Vec[Nd], _ caseName: String) -> Bool {
    var i: Int = 0
    while i < arms.len() {
        if tyArmCovers(arms.get(i) ?? Nd.wildcard, caseName) { return true }
        i = i + 1
    }
    return false
}

func tyArmCovers(_ a: Nd, _ caseName: String) -> Bool {
    return match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyPatBoxedCovers(pat, caseName)
        default: false
    }
}

func tyPatBoxedCovers(_ pat: Vec[Nd], _ caseName: String) -> Bool {
    if pat.len() == 0 { return false }
    return tyPatCoversCase(pat.get(0) ?? Nd.wildcard, caseName)
}

func tyPatCoversCase(_ p: Nd, _ caseName: String) -> Bool {
    return match p {
        case .enumP(let cn, let ch): streq(cn, caseName)
        case .orP(let alts): tyAltsCover(alts, caseName)
        default: false
    }
}

func tyAltsCover(_ alts: Vec[Nd], _ caseName: String) -> Bool {
    var i: Int = 0
    while i < alts.len() {
        if tyPatCoversCase(alts.get(i) ?? Nd.wildcard, caseName) { return true }
        i = i + 1
    }
    return false
}

func notExhaustiveMsg(_ caseName: String) using Alloc -> String {
    var s: String = "match is not exhaustive: case '"
    s.append(caseName)
    s.append("' is not covered")
    return s
}

func tyArm(_ env: inout TyEnv, _ a: Nd) using Alloc {
    match a {
        case .matchArm(let isDefault, let pat, let guard, let body): tyArmParts(env, guard, body)
        default: noop()
    }
}

func tyArmParts(_ env: inout TyEnv, _ guard: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    tyBoxed(env, body)
    if guard.len() > 0 {
        let gt = tyInferBoxed(env, guard)
        if !streq(gt, "") && !streq(gt, "Bool") { env.bad.push(tyGuardMsg(gt)) }
    }
}

func tyGuardMsg(_ got: String) using Alloc -> String {
    var s: String = "match guard must be Bool, got "
    s.append(got)
    return s
}

func tyExprCall(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    tyBoxed(env, callee)
    var i: Int = 0
    while i < args.len() {
        tyExpr(env, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyCheckCallArgs(env, callee, args)
}

// A call to a known user function must supply the right arity, and each argument
// must be assignable to its parameter. Calls to builtins / methods / struct
// constructors (no entry in funcName) are left to later slices.
func tyCheckCallArgs(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    let fname = exCalleeNameBoxed(callee)
    let arity = tyArity(env, fname)
    if arity >= 0 {
        if arity != args.len() {
            env.bad.push(tyArityMsg(arity, args.len()))
            return
        }
        var i: Int = 0
        while i < args.len() {
            tyCheckArg(env, fname, i, args.get(i) ?? Nd.wildcard)
            i = i + 1
        }
        return
    }
    if tyIsStruct(env, fname) { tyCheckCtor(env, fname, args) }
}

// §6 struct construction: each labeled argument must name a field whose type
// accepts the value, and every (non-embed) field must be supplied. (Non-generic,
// non-union structs only; generics are dropped from the AST and unions are rare.)
func tyCheckCtor(_ env: inout TyEnv, _ structName: String, _ args: Vec[Nd]) using Alloc {
    var seen: Vec[String] = Vec.new()
    var i: Int = 0
    while i < args.len() {
        tyCtorArg(env, structName, i, args.get(i) ?? Nd.wildcard, seen)
        i = i + 1
    }
    tyCtorMissing(env, structName, seen)
}

func tyCtorArg(_ env: inout TyEnv, _ structName: String, _ idx: Int, _ a: Nd, _ seen: inout Vec[String]) using Alloc {
    match a {
        case .arg(let label, let isInout, let val): tyCtorArgLabeled(env, structName, idx, label, val, seen)
        default: noop()
    }
}

func tyCtorArgLabeled(_ env: inout TyEnv, _ structName: String, _ idx: Int, _ label: String, _ val: Vec[Nd], _ seen: inout Vec[String]) using Alloc {
    if streq(label, "") { env.bad.push(tyCtorLabelMsg(idx + 1)); return }
    if !tyHasField(env, structName, label) { env.bad.push(tyNoFieldMsg(structName, label)); return }
    let ft = tyFieldType(env, structName, label)
    let at = tyInferBoxed(env, val)
    if !tyAssignable(at, ft) { env.bad.push(tyFieldMsg(label, ft, at)) }
    seen.push(label)
}

func tyCtorMissing(_ env: inout TyEnv, _ structName: String, _ seen: inout Vec[String]) using Alloc {
    var i: Int = 0
    while i < env.sFldStruct.len() {
        tyCtorMissingField(env, structName, i, seen)
        i = i + 1
    }
}

func tyCtorMissingField(_ env: inout TyEnv, _ structName: String, _ i: Int, _ seen: inout Vec[String]) using Alloc {
    if let s = env.sFldStruct.get(i) {
        if streq(s, structName) {
            if let fn = env.sFldName.get(i) {
                if !tyContains(seen, fn) { env.bad.push(tyMissingMsg(structName, fn)) }
            }
        }
    }
}

func tyContains(_ v: inout Vec[String], _ s: String) -> Bool {
    var i: Int = 0
    while i < v.len() {
        if let e = v.get(i) {
            if streq(e, s) { return true }
        }
        i = i + 1
    }
    return false
}

func tyCheckArg(_ env: inout TyEnv, _ fname: String, _ idx: Int, _ a: Nd) using Alloc {
    match a {
        case .arg(let label, let isInout, let val): tyCheckArgVal(env, fname, idx, val)
        default: noop()
    }
}

func tyCheckArgVal(_ env: inout TyEnv, _ fname: String, _ idx: Int, _ val: Vec[Nd]) using Alloc {
    let at = tyInferBoxed(env, val)
    let pt = tyParamType(env, fname, idx)
    if !tyAssignable(at, pt) { env.bad.push(tyArgMsg(idx + 1, at, pt)) }
}

func tyIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    tyBoxed(env, base)
    var i: Int = 0
    while i < idxs.len() {
        tyExpr(env, idxs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyCheckIndex(env, base, idxs)
}

// §18.5 — every index must be integer-typed, then a known base that is not a
// Vec/Span/MutSpan is not indexable. (Mirrors the resolver: indices first, then
// the base shape; an unknown base is tolerated.)
func tyCheckIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < idxs.len() {
        tyCheckIndexExpr(env, idxs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    let bt = tyInferBoxed(env, base)
    if !streq(bt, "") && !tyIsIndexable(bt) { env.bad.push(tyNotIndexableMsg(bt)) }
}

func tyCheckIndexExpr(_ env: inout TyEnv, _ idx: Nd) using Alloc {
    let it = tyInfer(env, idx)
    if !streq(it, "") && !tyIsInt(it) { env.bad.push(tyIndexIntMsg(it)) }
}

func tyIndexIntMsg(_ got: String) using Alloc -> String {
    var s: String = "index must be integer-typed, got "
    s.append(got)
    return s
}

func tyNotIndexableMsg(_ bt: String) using Alloc -> String {
    var s: String = "type "
    s.append(bt)
    s.append(" is not indexable")
    return s
}

// Member access: descend into the base, then check enum-case access. `E.case`
// where `E` names an enum (and is a type ref, not a value binding) must name a
// real case of `E`. Value member access (`x.field` / `x.method()`) is handled by
// inference; a `?.` chain is tolerated.
func tyMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String, _ chain: Bool) using Alloc {
    tyBoxed(env, base)
    if chain { return }
    tyCheckEnumCase(env, base, name)
}

func tyCheckEnumCase(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String) using Alloc {
    let bn = exCalleeNameBoxed(base)               // base ident name, or "" if not a bare ident
    if streq(bn, "") { return }
    if !streq(tySymType(env, bn), "") { return }   // a value binding shadows: not a type ref
    if !tyIsEnum(env, bn) { return }
    if !tyEnumHasCase(env, bn, name) { env.bad.push(tyNoCaseMsg(bn, name)) }
}

func tyNoCaseMsg(_ enumName: String, _ caseName: String) using Alloc -> String {
    var s: String = "enum '"
    s.append(enumName)
    s.append("' has no case '")
    s.append(caseName)
    s.append("'")
    return s
}

func tyIf(_ env: inout TyEnv, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc {
    tyCheckCond(env, cond, "if")
    tyBoxed(env, cond)
    tyBoxed(env, li)
    tyBoxed(env, thenB)
    tyBoxed(env, els)
}

// §10 — an `if`/`while` condition must be Bool. (An `if let` has no `cond`, so
// the empty-condition case is skipped; an unknown-typed condition is tolerated.)
func tyCheckCond(_ env: inout TyEnv, _ cond: Vec[Nd], _ kind: Str) using Alloc {
    if cond.len() == 0 { return }
    let ct = tyInferBoxed(env, cond)
    if !streq(ct, "") && !streq(ct, "Bool") { env.bad.push(tyCondMsg(kind, ct)) }
}

func tyCondMsg(_ kind: Str, _ got: String) using Alloc -> String {
    var s: String = own(kind)
    s.append(" condition must be Bool, got ")
    s.append(got)
    return s
}

func tyWhile(_ env: inout TyEnv, _ cond: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    tyCheckCond(env, cond, "while")
    tyBoxed(env, cond)
    tyBoxed(env, body)
}

func tyBlock(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < stmts.len() {
        tyStmt(env, stmts.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func tyStmt(_ env: inout TyEnv, _ s: Nd) using Alloc {
    match s {
        case .letS(let p, let ty, let v): tyLet(env, p, ty, v)
        case .varS(let p, let ty, let v): tyLet(env, p, ty, v)
        case .exprS(let e): tyBoxed(env, e)
        case .retS(let v): tyRet(env, v)
        case .assignS(let op, let t, let v): tyAssign(env, t, v)
        case .whileS(let c, let b): tyWhile(env, c, b)
        case .forS(let pp, let it, let b): tyPair(env, it, b)
        case .withS(let caps, let names, let vals, let tys, let body): tyWith(env, vals, body)
        default: noop()
    }
}

// `let`/`var`: if annotated, the initializer must be assignable to it; then walk
// the value for any nested bindings, and register this one for later idents.
func tyLet(_ env: inout TyEnv, _ pat: Vec[Nd], _ ty: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    let ann = tyAnnSpelling(ty)
    if !streq(ann, "") {
        let vt = tyInferBoxed(env, v)
        if !tyAssignable(vt, ann) { env.bad.push(tyInitMsg(vt, ann)) }
    }
    tyBoxed(env, v)
    tyRegisterPat(env, pat, ty)
}

// Assignment (incl. compound ops, which the resolver checks identically): the
// value must be assignable to the target. Only ident targets type to a known
// slot here; member/index targets are unknown and tolerated.
func tyAssign(_ env: inout TyEnv, _ t: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    tyBoxed(env, t)
    tyBoxed(env, v)
    let lt = tyInferBoxed(env, t)
    let rt = tyInferBoxed(env, v)
    if streq(lt, "") || streq(rt, "") { return }
    if !tyAssignable(rt, lt) { env.bad.push(tyAssignMsg(rt, lt)) }
}

func tyAssignMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "cannot assign value of type "
    s.append(from)
    s.append(" to target of type ")
    s.append(to)
    return s
}

// `return EXPR`: walk the value (nested checks), then its type must be assignable
// to the enclosing function's declared result. A bare `return` produces Unit.
func tyRet(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc {
    tyBoxed(env, v)
    if streq(env.curRet, "") { return }
    var rt: String = own("Unit")
    if v.len() > 0 { rt = tyInferBoxed(env, v) }
    if !tyAssignable(rt, env.curRet) { env.bad.push(tyReturnMsg(rt, env.curRet)) }
}

func tyWith(_ env: inout TyEnv, _ vals: Vec[Nd], _ body: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < vals.len() {
        tyExpr(env, vals.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    tyBoxed(env, body)
}

func tyRegisterPat(_ env: inout TyEnv, _ pat: Vec[Nd], _ ty: Vec[Nd]) using Alloc {
    if pat.len() > 0 { tyRegisterPatE(env, pat.get(0) ?? Nd.wildcard, ty) }
}

func tyRegisterPatE(_ env: inout TyEnv, _ p: Nd, _ ty: Vec[Nd]) using Alloc {
    match p {
        case .identP(let n): tyAddSym(env, n, ty)
        case .bindP(let n): tyAddSym(env, n, ty)
        default: noop()
    }
}

// ----- inference ------------------------------------------------------------
func tyInferBoxed(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc -> String {
    if v.len() > 0 { return tyInfer(env, v.get(0) ?? Nd.wildcard) }
    return own("")
}

func tyInfer(_ env: inout TyEnv, _ e: Nd) using Alloc -> String {
    return match e {
        case .intLit(let s): own("Int")
        case .floatLit(let s): own("Float64")
        case .boolLit(let b): own("Bool")
        case .charLit(let s): own("Char")
        case .strLit(let s): own("StrConst")
        case .ident(let n): tySymType(env, n)
        case .selfE: tySymType(env, own("self"))
        case .paren(let inner): tyInferBoxed(env, inner)
        case .call(let callee, let args): tyInferCallArgs(env, callee, args)
        case .binary(let op, let l, let r): tyInferBinary(env, op, l, r)
        case .unary(let op, let x): tyInferUnary(env, op, x)
        case .member(let base, let name, let chain): tyInferMember(env, base, name, chain)
        case .index(let base, let idxs): tyInferIndex(env, base, idxs)
        case .vecLit(let elems): tyInferVecLit(env, elems)
        case .tupleLit(let elems): tyInferTupleLit(env, elems)
        case .matchE(let scrut, let arms): tyInferMatch(env, scrut, arms)
        case .interpE(let parts, let exprs): own("String")
        case .prefixE(let kw, let inner): tyInferPrefix(env, kw, inner)
        default: own("")
    }
}

// `(a, b)` types as the tuple of its element types (unknown if any is).
func tyInferTupleLit(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc -> String {
    var parts: Vec[String] = Vec.new()
    var i: Int = 0
    while i < elems.len() {
        parts.push(tyInfer(env, elems.get(i) ?? Nd.wildcard))
        i = i + 1
    }
    return tyJoinTuple(parts)
}

// `try e` / `try! e` type as the operand's declared result — the hoist /
// unwrap yields the success value of the std::expected. `try? e` wraps that
// in an optional. `spawn e` yields a Future over the operand's result and
// `await e` strips it (awaiting an async call passes the declared result
// through — funcRet never carries the Task wrapper). Other prefixes stay
// unknown.
func tyInferPrefix(_ env: inout TyEnv, _ kw: Str, _ inner: Vec[Nd]) using Alloc -> String {
    if streq(kw, "try ") || streq(kw, "try! ") { return tyInferBoxed(env, inner) }
    if streq(kw, "try? ") {
        var t: String = tyInferBoxed(env, inner)
        if streq(t, "") { return own("") }
        t.append("?")
        return t
    }
    if streq(kw, "await ") { return tyAwaitOf(tyInferBoxed(env, inner)) }
    if streq(kw, "spawn ") { return tySpawnOf(tyInferBoxed(env, inner)) }
    return own("")
}

func tySpawnOf(_ t: String) using Alloc -> String {
    if streq(t, "") { return own("") }
    var s: String = "Future["
    s.append(t)
    s.append("]")
    return s
}

func tyAwaitOf(_ t: String) using Alloc -> String {
    if tyStartsWith(t, "Future[") { return tyBracketInner(t) }
    return t
}

// A match expression types as its first known-typed arm body — the same baseline
// tyCheckArmTypes unifies the remaining arms against. Each arm's payload
// bindings are registered before its body is typed: the emitter adds the same
// rows when it writes the `auto&& <bind> = __vstr_alt.<field>;` lines, but
// inference runs FIRST (a match is asked for its own result type before its
// scopes are emitted), so a body like `x + y` over two payload names would
// otherwise type against an empty symbol table.
func tyInferMatch(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc -> String {
    let enumName = tyInferBoxed(env, scrut)
    var i: Int = 0
    while i < arms.len() {
        let a = arms.get(i) ?? Nd.wildcard
        tyRegisterArmPayload(env, enumName, a)
        let t = tyArmBodyType(env, a)
        if !streq(t, "") { return t }
        i = i + 1
    }
    return own("")
}

// Give one arm's payload bindings their declared field types. Re-registering a
// name is harmless — `tySymType` returns the first row, and the emitter pushes
// the identical spelling.
func tyRegisterArmPayload(_ env: inout TyEnv, _ enumName: Str, _ a: Nd) using Alloc {
    match a {
        case .matchArm(let isDef, let pat, let guard, let body): tyRegisterPatPayload(env, enumName, pat)
        default: noop()
    }
}

func tyRegisterPatPayload(_ env: inout TyEnv, _ enumName: Str, _ pat: Vec[Nd]) using Alloc {
    match pat.get(0) ?? Nd.wildcard {
        case .enumP(let cname, let children): tyRegisterPayList(env, enumName, cname, children)
        default: noop()
    }
}

func tyRegisterPayList(_ env: inout TyEnv, _ enumName: Str, _ cname: Str, _ children: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < children.len() {
        tyRegisterPayOne(env, enumName, cname, children.get(i) ?? Nd.wildcard, i)
        i = i + 1
    }
}

func tyRegisterPayOne(_ env: inout TyEnv, _ enumName: Str, _ cname: Str, _ child: Nd, _ idx: Int) using Alloc {
    let bn = patNameOf(child)
    if streq(bn, "") { return }
    let fty = tyPayFieldTy(env, enumName, cname, idx)
    tyAddSymSpelling(&env, own(bn), fty)
}

// An array literal `[e1, ...]` types as `[N]T`, where N is the element count and
// T is the FIRST element's type (vestra does not unify the rest); the spelling
// nests, so `[[1,2],[3,4]]` -> `[2][2]Int`. An empty literal or an unknown first
// element stays unknown so the value is tolerated rather than mis-flagged.
func tyInferVecLit(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc -> String {
    if elems.len() == 0 { return own("") }
    let et = tyInfer(env, elems.get(0) ?? Nd.wildcard)
    if streq(et, "") { return own("") }
    var s: String = "["
    s.append(intToStr(elems.len()))
    s.append("]")
    s.append(et)
    return s
}

// Indexing a Vec[T] / Span[T] / MutSpan[T] yields its element T; other bases stay
// unknown (arrays spell empty here, and non-indexables type as unknown anyway).
func tyInferIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc -> String {
    let bt = tyInferBoxed(env, base)
    if tyIsIndexable(bt) { return tyBracketInner(bt) }
    if tyIsArray(bt) { return tyArrayElem(bt) }
    return own("")
}

func tyIsIndexable(_ s: String) -> Bool {
    return tyStartsWith(s, "Vec[") || tyStartsWith(s, "Span[") || tyStartsWith(s, "MutSpan[")
        || tyStartsWith(s, "Chunks[")
}

func tyIsSpanSp(_ s: String) -> Bool {
    return tyStartsWith(s, "Span[") || tyStartsWith(s, "MutSpan[")
}

// §9 / §18.4 the iterator values vgen models by spelling: the combinators
// `Zip[(A, B)]`, `Take[E]`, `Filter[E]`, `Map[E]` (E unknown for map, which
// would need the closure's result type) and a span's `Chunks[Span[T]]`. A
// `for` over one takes the iterator protocol.
func tyIsIterAdapter(_ s: String) -> Bool {
    return tyStartsWith(s, "Zip[") || tyStartsWith(s, "Take[") || tyStartsWith(s, "Filter[")
        || tyStartsWith(s, "Map[") || tyStartsWith(s, "Chunks[")
}

// The element a `for` over this iterable binds: a container's T, an
// adapter's element, or a user iterator struct's `next() -> T?` T.
func tyIterElem(_ env: inout TyEnv, _ s: String) using Alloc -> String {
    if tyStartsWith(s, "Vec[") || tyIsSpanSp(s) || tyIsIterAdapter(s) { return tyBracketInner(s) }
    if tyIsStruct(env, s) { return tyUnwrapOpt(tyMethodRet(env, s, own("next"))) }
    return own("")
}

func tyStartsWith(_ s: String, _ prefix: Str) -> Bool {
    let pn = prefix.len()
    if pn > s.len() { return false }
    var i: Int = 0
    while i < pn {
        if (s.byteAt(i) ?? 0) != (prefix.byteAt(i) ?? 1) { return false }
        i = i + 1
    }
    return true
}

// "Vec[Int32]" -> "Int32" (the text between the first '[' and the trailing ']',
// so a nested element like "HashMap[Int32, Str]" comes back whole).
func tyBracketInner(_ s: String) using Alloc -> String {
    let n = s.len()
    if n < 2 || (s.byteAt(n - 1) ?? 0) != 93 { return own("") }   // ']' == 93
    var open: Int = -1
    var i: Int = 0
    while i < n {
        if (s.byteAt(i) ?? 0) == 91 { open = i; i = n }           // first '[' == 91
        else { i = i + 1 }
    }
    if open < 0 { return own("") }
    return own(s.slice(open + 1, n - 1))
}

// `base.field` types as the field's declared type when `base` is a known struct
// and `field` is one of its fields; a `?.` chain (optional result) and anything
// else stay unknown. Nested access (`a.b.c`) falls out of the recursion.
func tyInferMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String, _ chain: Bool) using Alloc -> String {
    if chain { return tyInferChainMember(env, base, name) }
    let bt = tyInferBoxed(env, base)
    let inst = tyInstFieldType(env, bt, name)
    if !streq(inst, "") { return inst }
    if tyHasField(env, bt, name) { return tyFieldType(env, bt, name) }
    // §3 `q.value` on an opaque newtype types as its underlying.
    if streq(name, "value") && tyIsOpaque(env, bt) { return typeSpelling(tyOpaqueUnder(env, bt)) }
    if streq(name, "value") && tyStartsWith(bt, "Box[") { return own(bt.slice(4, bt.len() - 1)) }
    if streq(name, "value") && (tyStartsWith(bt, "Ptr[") || tyStartsWith(bt, "MutPtr[")) { return tyBracketInner(bt) }
    // §10 a span's `.count` / `.isEmpty`; §18.4 a chunk iterator's `.count`.
    if tyIsSpanSp(bt) && streq(name, "count") { return own("Int") }
    if tyIsSpanSp(bt) && streq(name, "isEmpty") { return own("Bool") }
    if tyStartsWith(bt, "Chunks[") && streq(name, "count") { return own("Int") }
    // §A11 (§14.8) `Padded[T].value` is the padded cell itself.
    if streq(name, "value") && tyStartsWith(bt, "Padded[") { return tyBracketInner(bt) }
    // A bare case of a user enum (`List.empty`) types as the enum.
    let en = identBaseName(base)
    if !streq(en, "") && tyIsEnum(env, en) && tyEnumHasCase(env, en, name) { return en }
    return own("")
}

// `base?.f` over a `S?` base types as the field made optional once: `F?`, or
// the field's own type when it is already optional (the `.and_then` flatten).
// Any other base stays unknown.
func tyInferChainMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String) using Alloc -> String {
    let inner = tyUnwrapOpt(tyInferBoxed(env, base))
    if streq(inner, "") || !tyHasField(env, inner, name) { return own("") }
    var ft = tyFieldType(env, inner, name)
    if streq(tyUnwrapOpt(ft), "") { ft.append("?") }
    return ft
}

// A binary expression's type, mirroring the resolver's result types (and its
// "error type on failure" so a mis-typed operator suppresses downstream checks):
// comparisons -> Bool when the operands match (else unknown); logical -> Bool
// when both Bool; arithmetic/bitwise -> the operand type with the §17 sized
// operand winning (`Int32 + Int` -> Int32), or unknown when the operand rule is
// violated. Unknown operands stay permissive so a partly-inferred condition is
// tolerated. Other operators (??, ranges) are unknown.
func tyInferBinary(_ env: inout TyEnv, _ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc -> String {
    let lt = tyInferBoxed(env, l)
    let rt = tyInferBoxed(env, r)
    // §13 element-wise arithmetic over two `[N]T` operands of one type yields
    // that vector type.
    if isVecArithOp(op) && tyIsArray(lt) && streq(lt, rt) { return own(lt) }
    if isCmpOp(op) { return tyCmpResult(lt, rt) }
    if isLogOp(op) { return tyLogResult(lt, rt) }
    if isArithOp(op) { return tyNumResult(lt, rt, false) }
    if isBitOp(op) { return tyNumResult(lt, rt, true) }
    if streq(op, "??") { return tyUnwrapOpt(lt) }
    return own("")
}

// §9 `lhs ?? rhs` yields the wrapped element T when lhs is a known Optional
// `T?`; an lhs of any other (or unknown) type stays unknown, mirroring the
// resolver's error type when the left operand is not an Optional.
func tyUnwrapOpt(_ s: String) using Alloc -> String {
    let n = s.len()
    if n > 0 && (s.byteAt(n - 1) ?? 0) == 63 { return own(s.slice(0, n - 1)) }   // '?' == 63
    return own("")
}

func tyCmpResult(_ lt: String, _ rt: String) using Alloc -> String {
    if streq(lt, "") || streq(rt, "") { return own("Bool") }
    if tyReqMatch(lt, rt) { return own("Bool") }
    return own("")
}

func tyLogResult(_ lt: String, _ rt: String) using Alloc -> String {
    if streq(lt, "") || streq(rt, "") { return own("Bool") }
    if streq(lt, "Bool") && streq(rt, "Bool") { return own("Bool") }
    return own("")
}

func tyNumResult(_ lt: String, _ rt: String, _ needInt: Bool) using Alloc -> String {
    if streq(lt, "") || streq(rt, "") { return own("") }
    var lok: Bool = tyIsNumeric(lt)
    if needInt { lok = tyIsInt(lt) }
    if !lok { return own("") }
    if !tyReqMatch(lt, rt) { return own("") }
    if streq(lt, "Int") || streq(lt, "UInt") { return rt }
    return lt
}

// The self-host AST spells both prefix logical-not `!x` and postfix force-unwrap
// `x!` as `unary("!", _)`, so they are told apart by the operand: an Optional
// `T?` operand is a force-unwrap yielding T (§9), anything else is logical-not
// yielding Bool. `-x` carries a numeric operand through, `~x` an integer one;
// a constraint violation yields the error type ("") so it doesn't cascade.
func tyInferUnary(_ env: inout TyEnv, _ op: String, _ x: Vec[Nd]) using Alloc -> String {
    let xt = tyInferBoxed(env, x)
    if streq(op, "!") {
        if (xt.byteAt(xt.len() - 1) ?? 0) == 63 { return tyUnwrapOpt(xt) }   // T? -> T
        return own("Bool")
    }
    if streq(xt, "") { return own("") }                   // unknown operand: stay permissive
    if streq(op, "-") { if tyIsNumeric(xt) { return own(xt) }; return own("") }
    if streq(op, "~") { if tyIsInt(xt) { return own(xt) }; return own("") }
    return own(xt)
}

func isCmpOp(_ op: String) -> Bool {
    return streq(op, "==") || streq(op, "!=") || streq(op, "<") || streq(op, "<=")
        || streq(op, ">") || streq(op, ">=")
}

func isLogOp(_ op: String) -> Bool {
    return streq(op, "&&") || streq(op, "||")
}

func isArithOp(_ op: String) -> Bool {
    return streq(op, "+") || streq(op, "-") || streq(op, "*") || streq(op, "/")
        || streq(op, "%") || streq(op, "&*") || streq(op, "&+") || streq(op, "&-")
}

func isBitOp(_ op: String) -> Bool {
    return streq(op, "<<") || streq(op, ">>") || streq(op, "&") || streq(op, "^") || streq(op, "|")
}

func tyIsNumeric(_ s: String) -> Bool {
    return tyIsInt(s) || streq(s, "Float32") || streq(s, "Float64")
}

// The resolver's require_match: operands match when they are equal, or both
// integers where one assigns to the other (the §17 natural-width rule).
func tyReqMatch(_ lt: String, _ rt: String) using Alloc -> Bool {
    if streq(lt, rt) { return true }
    if tyIsInt(lt) && tyIsInt(rt) && (tyAssignable(lt, rt) || tyAssignable(rt, lt)) { return true }
    return false
}

// ----- binary operator constraints ------------------------------------------
func tyBinary(_ env: inout TyEnv, _ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc {
    tyBoxed(env, l)
    tyBoxed(env, r)
    tyCheckBinOp(env, op, l, r)
}

func tyCheckBinOp(_ env: inout TyEnv, _ op: String, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc {
    let lt = tyInferBoxed(env, l)
    let rt = tyInferBoxed(env, r)
    if streq(lt, "") || streq(rt, "") { return }
    if isLogOp(op) {
        if !streq(lt, "Bool") || !streq(rt, "Bool") { env.bad.push(tyLogMsg()) }
    } else if isArithOp(op) {
        if !tyIsNumeric(lt) { env.bad.push(tyArithMsg(lt)) }
        else if !tyReqMatch(lt, rt) { env.bad.push(tyDiffMsg(lt, rt)) }
    } else if isBitOp(op) {
        if !tyIsInt(lt) { env.bad.push(tyBitMsg(lt)) }
        else if !tyReqMatch(lt, rt) { env.bad.push(tyDiffMsg(lt, rt)) }
    } else if isCmpOp(op) {
        if !tyReqMatch(lt, rt) { env.bad.push(tyDiffMsg(lt, rt)) }
    }
}

func tyArithMsg(_ got: String) using Alloc -> String {
    var s: String = "arithmetic operator requires numeric operands, got "
    s.append(got)
    return s
}

func tyBitMsg(_ got: String) using Alloc -> String {
    var s: String = "bitwise operator requires integer operands, got "
    s.append(got)
    return s
}

func tyDiffMsg(_ lt: String, _ rt: String) using Alloc -> String {
    var s: String = "binary operator operands of different types: "
    s.append(lt)
    s.append(" vs ")
    s.append(rt)
    return s
}

func tyLogMsg() using Alloc -> String {
    return own("logical && / || require Bool operands")
}

// ----- unary operator constraints -------------------------------------------
func tyUnary(_ env: inout TyEnv, _ op: String, _ x: Vec[Nd]) using Alloc {
    tyBoxed(env, x)
    tyCheckUnOp(env, op, x)
}

// `-x` needs a numeric operand, `~x` an integer one. `!` is skipped: the AST
// merges prefix logical-not and postfix force-unwrap into one node, so the right
// diagnostic ("requires Bool" vs "requires an Optional") can't be chosen.
func tyCheckUnOp(_ env: inout TyEnv, _ op: String, _ x: Vec[Nd]) using Alloc {
    let xt = tyInferBoxed(env, x)
    if streq(xt, "") { return }
    if streq(op, "-") {
        if !tyIsNumeric(xt) { env.bad.push(tyNegMsg(xt)) }
    } else if streq(op, "~") {
        if !tyIsInt(xt) { env.bad.push(tyBitNotMsg(xt)) }
    }
}

func tyNegMsg(_ got: String) using Alloc -> String {
    var s: String = "unary '-' requires a numeric type, got "
    s.append(got)
    return s
}

func tyBitNotMsg(_ got: String) using Alloc -> String {
    var s: String = "unary '~' requires an integer type, got "
    s.append(got)
    return s
}

func tyFieldMsg(_ label: String, _ fieldType: String, _ argType: String) using Alloc -> String {
    var s: String = "field '"
    s.append(label)
    s.append("' of type ")
    s.append(fieldType)
    s.append(" cannot accept value of type ")
    s.append(argType)
    return s
}

func tyNoFieldMsg(_ structName: String, _ label: String) using Alloc -> String {
    var s: String = "'"
    s.append(structName)
    s.append("' has no field '")
    s.append(label)
    s.append("'")
    return s
}

func tyMissingMsg(_ structName: String, _ fieldName: String) using Alloc -> String {
    var s: String = "struct '"
    s.append(structName)
    s.append("' constructor is missing field '")
    s.append(fieldName)
    s.append("'")
    return s
}

func tyCtorLabelMsg(_ n: Int) using Alloc -> String {
    var s: String = "struct constructor argument "
    s.append(intToStr(n))
    s.append(" requires a field label")
    return s
}

// `Box.new(v)` types as Box[<v's type>] (unknown if v's is); any other call
// types by its callee alone.
func tyInferCallArgs(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc -> String {
    let ad = tyInferAdapter(env, exCalleeNameBoxed(callee), args)
    if !streq(ad, "") { return ad }
    if !isBoxNewCallee(callee) || args.len() != 1 { return tyInferCall(env, callee) }
    let at = tyInferArg(env, args)
    if streq(at, "") { return own("") }
    var s: String = "Box["
    s.append(at)
    s.append("]")
    return s
}

func tyInferCall(_ env: inout TyEnv, _ callee: Vec[Nd]) using Alloc -> String {
    return match (callee.get(0) ?? Nd.wildcard) {
        case .member(let base, let name, let chain): tyInferMethodCall(env, base, name, chain)
        default: tyInferPlainCall(env, callee)
    }
}

func tyInferPlainCall(_ env: inout TyEnv, _ callee: Vec[Nd]) using Alloc -> String {
    let nm = exCalleeNameBoxed(callee)
    let r = tyFuncRet(env, nm)
    if !streq(r, "") { return r }
    let b = tyBuiltinRet(nm)
    if !streq(b, "") { return b }
    // §17.x a conversion call types as its primitive: `Int32(x)` -> Int32;
    // §3 `Q(t)` constructs the opaque newtype Q.
    if tyIsStruct(env, nm) || tyIsNumeric(nm) || tyIsOpaque(env, nm) { return nm }
    return own("")
}

// Return types of the §18 builtins vgen lowers (a unit-defined function wins in
// the lookup above). readFile's optional makes the `!` disambiguation fire so
// `readFile(p)!` lowers as a force-unwrap, not logical-not. args()'s Vec[Str]
// routes `argv.len()` / `argv.get(i)` through the §18.5 builtin-method path.
func tyBuiltinRet(_ nm: Str) using Alloc -> String {
    if streq(nm, "readFile") { return own("String?") }
    if streq(nm, "writeFile") { return own("Bool") }
    if streq(nm, "args") { return own("Vec[Str]") }
    return own("")
}

// §9 the builtin combinators (a unit function of the same name wins):
// `zip(a, b)` -> Zip[(EA, EB)], `take(xs, n)` -> Take[E], `filter(xs, f)` ->
// Filter[E], `map(xs, f)` -> Map[] (its element would need f's result).
func tyInferAdapter(_ env: inout TyEnv, _ nm: Str, _ args: Vec[Nd]) using Alloc -> String {
    if args.len() != 2 || tyArity(env, nm) >= 0 { return own("") }
    let isZip = streq(nm, "zip")
    let isTake = streq(nm, "take")
    let isFilter = streq(nm, "filter")
    let isMap = streq(nm, "map")
    if !(isZip || isTake || isFilter || isMap) { return own("") }
    let e0 = tyIterElem(env, tyInferArg(env, args))
    var inner: String = ""
    if isZip {
        var parts: Vec[String] = Vec.new()
        parts.push(e0)
        parts.push(tyIterElem(env, tyInferArgAt(env, args, 1)))
        inner = tyJoinTuple(parts)
    } else if !isMap {
        inner = own(e0)
    }
    var out: String = ""
    if isZip { out.append("Zip[") } else if isTake { out.append("Take[") }
    else if isFilter { out.append("Filter[") } else { out.append("Map[") }
    out.append(inner)
    out.append("]")
    return out
}

func tyInferArgAt(_ env: inout TyEnv, _ args: Vec[Nd], _ i: Int) using Alloc -> String {
    return match args.get(i) ?? Nd.wildcard {
        case .arg(let label, let isInout, let value): tyInferBoxed(env, value)
        default: own("")
    }
}

// `recv.method(...)` types as the method's declared result, found by the
// receiver's (struct/enum) type. A `?.` chain, an unknown receiver, or a builtin
// / generic method (none recorded) stays unknown and is tolerated. A `Self`
// result resolves to the receiver type so a chained / stored result types right.
func tyInferMethodCall(_ env: inout TyEnv, _ base: Vec[Nd], _ name: String, _ chain: Bool) using Alloc -> String {
    if chain { return own("") }
    let bt = tyInferBoxed(env, base)
    if streq(bt, "") { return own("") }
    let r = tyMethodRet(env, bt, name)
    if !streq(r, "") { return r }
    return tyBuiltinMethodRet(bt, name)
}

// Return types of the §18.5 builtin methods (a user method wins above), so a
// binding from one participates in downstream type-directed lowerings —
// chained builtin calls, force-unwrap, string coercion.
func tyBuiltinMethodRet(_ bt: String, _ name: String) using Alloc -> String {
    if tyStartsWith(bt, "Vec[") { return tyVecMethodRet(bt, name) }
    // §A11 `PerCpu[T].mine()` is this hart's T; §A4 the value-returning
    // atomic operations yield the atomic's T.
    if tyStartsWith(bt, "PerCpu[") && streq(name, "mine") { return tyBracketInner(bt) }
    if tyStartsWith(bt, "Atomic[") && atomicRetIsT(name) { return tyBracketInner(bt) }
    // §5 / §18.4 `s.split(at:)` is the (prefix, suffix) pair of sub-spans;
    // `s.chunks(of:)` iterates sub-spans of the same kind.
    if tyIsSpanSp(bt) && streq(name, "split") {
        var parts: Vec[String] = Vec.new()
        parts.push(own(bt))
        parts.push(own(bt))
        return tyJoinTuple(parts)
    }
    if tyIsSpanSp(bt) && streq(name, "chunks") {
        var c: String = "Chunks["
        c.append(bt)
        c.append("]")
        return c
    }
    if tyStartsWith(bt, "HashMap[") { return tyMapMethodRet(bt, name) }
    if streq(bt, "String") || streq(bt, "Str") || streq(bt, "StrConst") { return tyStrMethodRet(name) }
    if tyIsNumericScalar(bt) && streq(name, "toString") { return own("String") }
    return own("")
}

func tyVecMethodRet(_ bt: String, _ name: String) using Alloc -> String {
    if streq(name, "len") { return own("Int") }
    if streq(name, "get") || streq(name, "pop") { return tyOptOf(tyBracketInner(bt)) }
    return own("")
}

func tyMapMethodRet(_ bt: String, _ name: String) using Alloc -> String {
    if streq(name, "len") { return own("Int") }
    if streq(name, "contains") { return own("Bool") }
    if streq(name, "get") { return tyOptOf(mapValSpelling(bt)) }
    if streq(name, "keys") { return tyVecOf(mapKeySpelling(bt)) }
    if streq(name, "values") { return tyVecOf(mapValSpelling(bt)) }
    if streq(name, "entries") { return tyVecOf(tyMapEntrySpelling(bt)) }
    return own("")
}

// `m.entries()` yields `(K, V)` tuples; unknown if either half is.
func tyMapEntrySpelling(_ bt: String) using Alloc -> String {
    var parts: Vec[String] = Vec.new()
    parts.push(mapKeySpelling(bt))
    parts.push(mapValSpelling(bt))
    return tyJoinTuple(parts)
}

func tyStrMethodRet(_ name: String) using Alloc -> String {
    if streq(name, "len") { return own("Int") }
    if streq(name, "isEmpty") || streq(name, "contains") || streq(name, "startsWith")
        || streq(name, "endsWith") { return own("Bool") }
    if streq(name, "slice") { return own("Str") }
    if streq(name, "byteAt") { return own("UInt8?") }
    if streq(name, "find") || streq(name, "toInt") { return own("Int?") }
    if streq(name, "charAt") { return own("Char?") }
    if streq(name, "split") { return own("Vec[Str]") }
    if streq(name, "chars") { return own("Vec[Char]") }
    return own("")
}

func tyOptOf(_ t: Str) using Alloc -> String {
    var s: String = own(t)
    s.append("?")
    return s
}

func tyVecOf(_ t: Str) using Alloc -> String {
    var s: String = "Vec["
    s.append(t)
    s.append("]")
    return s
}

func tyMethodRet(_ env: inout TyEnv, _ owner: String, _ name: String) using Alloc -> String {
    var i: Int = 0
    while i < env.mStruct.len() {
        if let s = env.mStruct.get(i) {
            if streq(s, owner) {
                if let mn = env.mName.get(i) {
                    if streq(mn, name) {
                        let r = env.mRet.get(i) ?? own("")
                        if streq(r, "Self") { return owner }
                        return r
                    }
                }
            }
        }
        i = i + 1
    }
    return own("")
}

// ----- type spelling (describe) of an annotation node -----------------------
func tyAnnSpelling(_ ty: Vec[Nd]) using Alloc -> String {
    if ty.len() == 0 { return own("") }
    return typeSpelling(ty.get(0) ?? Nd.wildcard)
}

func typeSpelling(_ t: Nd) using Alloc -> String {
    return match t {
        case .named(let path, let hasG, let args): tyNamedSpelling(path, hasG, args)
        case .opt(let inner): tyOptSpelling(inner)
        case .vecT(let len, let elem): tyVecTSpelling(len, elem)
        case .tupleT(let elems): tyTupleTSpelling(elems)
        default: own("")
    }
}

// A tuple type `(A, B)` spells as the resolver describes it: the element
// spellings, ", "-joined, in parens. Unknown ("") if any element is.
func tyTupleTSpelling(_ elems: Vec[Nd]) using Alloc -> String {
    var parts: Vec[String] = Vec.new()
    var i: Int = 0
    while i < elems.len() {
        parts.push(typeSpelling(elems.get(i) ?? Nd.wildcard))
        i = i + 1
    }
    return tyJoinTuple(parts)
}

func tyJoinTuple(_ parts: Vec[String]) using Alloc -> String {
    if parts.len() == 0 { return own("") }
    var s: String = "("
    var i: Int = 0
    while i < parts.len() {
        let p = own(parts.get(i) ?? own(""))
        if streq(p, "") { return own("") }
        if i > 0 { s.append(", ") }
        s.append(p)
        i = i + 1
    }
    s.append(")")
    return s
}

func tyIsTuple(_ sp: Str) -> Bool {
    return sp.len() > 1 && (sp.byteAt(0) ?? 0) == 40   // '('
}

// The element spellings of `(A, B[C, D], (E, F))`, split at depth-0 commas.
func tyTupleParts(_ sp: Str) using Alloc -> Vec[String] {
    if !tyIsTuple(sp) { return Vec.new() }
    var out: Vec[String] = Vec.new()
    let inner = sp.slice(1, sp.len() - 1)
    var start: Int = 0
    var depth: Int = 0
    var i: Int = 0
    while i < inner.len() {
        let c = inner.byteAt(i) ?? 0
        if c == 91 || c == 40 { depth = depth + 1 }
        if c == 93 || c == 41 { depth = depth - 1 }
        if c == 44 && depth == 0 {
            out.push(tyTrimSp(inner.slice(start, i)))
            start = i + 1
        }
        i = i + 1
    }
    out.push(tyTrimSp(inner.slice(start, inner.len())))
    return out
}

// A fixed-size array type `[N]T` spells as "[N]" + the element spelling, no
// space — the same shape an array literal infers to (see tyInferVecLit).
func tyVecTSpelling(_ len: String, _ elem: Vec[Nd]) using Alloc -> String {
    var s: String = "["
    s.append(len)
    s.append("]")
    s.append(tyAnnSpelling(elem))
    return s
}

func tyNamedSpelling(_ path: String, _ hasG: Bool, _ args: Vec[Nd]) using Alloc -> String {
    var s: String = path
    if hasG && args.len() > 0 {
        s.append("[")
        var i: Int = 0
        while i < args.len() {
            if i > 0 { s.append(", ") }
            s.append(typeSpelling(args.get(i) ?? Nd.wildcard))
            i = i + 1
        }
        s.append("]")
    }
    return s
}

func tyOptSpelling(_ inner: Vec[Nd]) using Alloc -> String {
    var s: String = tyAnnSpelling(inner)
    s.append("?")
    return s
}

// ----- assignability --------------------------------------------------------
func tyAssignable(_ from: String, _ to: String) using Alloc -> Bool {
    if streq(from, "") || streq(to, "") { return true }   // unknown: don't pile on
    if streq(from, to) { return true }
    if tyIsArray(from) && tyIsArray(to) { return tyArrayAssignable(from, to) }
    if tyIntNatural(from, to) { return true }
    if tyStrLattice(from, to) { return true }
    if tyOptionalWrap(from, to) { return true }
    return false
}

// Two array types `[N]T` / `[M]U` are assignable when their counts match and the
// element types are assignable (so `[3]Int` -> `[3]Int32` by natural width, but
// neither a count nor a Vec mismatch passes).
func tyIsArray(_ s: String) -> Bool {
    return s.len() > 0 && (s.byteAt(0) ?? 0) == 91   // '[' == 91
}

func tyArrayAssignable(_ from: String, _ to: String) using Alloc -> Bool {
    return streq(tyArrayCount(from), tyArrayCount(to))
        && tyAssignable(tyArrayElem(from), tyArrayElem(to))
}

// "[3]Int32" -> "3" (between '[' and the first ']').
func tyArrayCount(_ s: String) using Alloc -> String {
    var i: Int = 1
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 93 { return own(s.slice(1, i)) }   // ']' == 93
        i = i + 1
    }
    return own("")
}

// "[3]Int32" -> "Int32" (everything after the first ']').
func tyArrayElem(_ s: String) using Alloc -> String {
    var i: Int = 1
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 93 { return own(s.slice(i + 1, s.len())) }
        i = i + 1
    }
    return own("")
}

func tyIsInt(_ s: String) -> Bool {
    return streq(s, "Int") || streq(s, "Int8") || streq(s, "Int16") || streq(s, "Int32")
        || streq(s, "Int64") || streq(s, "Int128") || streq(s, "UInt") || streq(s, "UInt8")
        || streq(s, "UInt16") || streq(s, "UInt32") || streq(s, "UInt64") || streq(s, "UInt128")
}

func tyIsSignedInt(_ s: String) -> Bool {
    return streq(s, "Int") || streq(s, "Int8") || streq(s, "Int16") || streq(s, "Int32")
        || streq(s, "Int64") || streq(s, "Int128")
}

// §17 — a natural-width Int/UInt assigns to/from a specific width of the same
// signedness; specific widths remain mutually incompatible.
func tyIntNatural(_ from: String, _ to: String) -> Bool {
    if !(tyIsInt(from) && tyIsInt(to)) { return false }
    let fn = streq(from, "Int") || streq(from, "UInt")
    let tn = streq(to, "Int") || streq(to, "UInt")
    if !(fn || tn) { return false }
    return tyIsSignedInt(from) == tyIsSignedInt(to)
}

func tyStrRank(_ s: String) -> Int {
    if streq(s, "StrConst") { return 0 }
    if streq(s, "Str") { return 1 }
    if streq(s, "String") { return 2 }
    return -1
}

// §4 — StrConst <= Str <= String (narrowing literal to wider owner/view).
func tyStrLattice(_ from: String, _ to: String) -> Bool {
    let f = tyStrRank(from)
    let t = tyStrRank(to)
    return f >= 0 && t >= 0 && f <= t
}

// §9 — a value of T is assignable to an Optional T (`.some(...)` wrap).
func tyOptionalWrap(_ from: String, _ to: String) using Alloc -> Bool {
    let n = to.len()
    if n == 0 { return false }
    if (to.byteAt(n - 1) ?? 0) != 63 { return false }   // ends with '?'
    return tyAssignable(from, own(to.slice(0, n - 1)))
}

// ----- diagnostics ----------------------------------------------------------
func tyInitMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "initializer of type "
    s.append(from)
    s.append(" does not match annotation ")
    s.append(to)
    return s
}

func tyConstMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "const value of type "
    s.append(from)
    s.append(" does not match annotation ")
    s.append(to)
    return s
}

func tyArityMsg(_ expected: Int, _ got: Int) using Alloc -> String {
    var s: String = "call expects "
    s.append(intToStr(expected))
    s.append(" argument(s), got ")
    s.append(intToStr(got))
    return s
}

func tyArgMsg(_ idx1: Int, _ from: String, _ to: String) using Alloc -> String {
    var s: String = "argument "
    s.append(intToStr(idx1))
    s.append(" of type ")
    s.append(from)
    s.append(" does not match parameter type ")
    s.append(to)
    return s
}

func tyReturnMsg(_ from: String, _ to: String) using Alloc -> String {
    var s: String = "return value of type "
    s.append(from)
    s.append(" does not match function result type ")
    s.append(to)
    return s
}

func tyBodyMsg(_ name: String, _ ret: String, _ body: String) using Alloc -> String {
    var s: String = "function '"
    s.append(name)
    s.append("' returns ")
    s.append(ret)
    s.append(" but body produces ")
    s.append(body)
    return s
}

// A fresh type environment with the unit's global tables (function returns,
// struct fields, enum cases, methods) collected. The per-function symbol table is
// (re)built per function/method body.
func buildTyEnv(_ u: NUnit, _ ext: Vec[Nd]) using Alloc -> TyEnv {
    var env = TyEnv(funcName: Vec.new(), funcRet: Vec.new(), funcArity: Vec.new(), funcThr: Vec.new(),
                    pFn: Vec.new(), pIdx: Vec.new(), pType: Vec.new(), pTyNode: Vec.new(),
                    pMode: Vec.new(),
                    structs: Vec.new(), genTypes: Vec.new(), gpOwner: Vec.new(), gpName: Vec.new(), bindFn: own(""), bindName: Vec.new(), bindVal: Vec.new(),
                    sFldStruct: Vec.new(), sFldName: Vec.new(),
                    sFldType: Vec.new(), mStruct: Vec.new(), mName: Vec.new(),
                    mRet: Vec.new(), mpOwner: Vec.new(), mpName: Vec.new(),
                    mpIdx: Vec.new(), mpTyNode: Vec.new(),
                    eName: Vec.new(), ecEnum: Vec.new(),
                    ecName: Vec.new(), ecArity: Vec.new(),
                    ecfEnum: Vec.new(), ecfCase: Vec.new(),
                    ecfIdx: Vec.new(), ecfName: Vec.new(), ecfTy: Vec.new(),
                    dvTarget: Vec.new(), dvProto: Vec.new(),
                    opName: Vec.new(), opUnder: Vec.new(), moveOnly: Vec.new(),
                    symName: Vec.new(), symType: Vec.new(), gName: Vec.new(), gType: Vec.new(),
                    curRet: own(""), curRetNode: Vec.new(), curAttrs: Vec.new(),
                    tryN: 0, hoistName: Vec.new(), hoistExpr: Vec.new(),
                    hoistKind: Vec.new(), hoistNext: 0,
                    condUse: own(""), condTy: Vec.new(), condTyStr: own(""), armTo: own(""),
                    curThrowsNode: Vec.new(),
                    curAsync: false,
                    curUnitThrows: false,
                    imports: Vec.new(),
                    hasModule: u.hasMod,
                    tpN: 0,
                    bad: Vec.new())
    // §5 imported modules' declarations first, under their qualified C++ names
    // (see loadImports), so a reference to one types and lowers like a local.
    var x: Int = 0
    while x < ext.len() {
        tyCollectDecl(&env, ext.get(x) ?? Nd.wildcard)
        x = x + 1
    }
    var i: Int = 0
    while i < u.decls.len() {
        tyCollectDecl(&env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    var m: Int = 0
    while m < u.imports.len() {
        tyRecordImport(&env, u.imports.get(m) ?? Nd.wildcard)
        m = m + 1
    }
    tyComputeMoveOnly(&env)
    return env
}

// §10 move-only nominals: a struct/enum becomes move-only once any field or
// case payload is, given what is already known — iterated to a fixpoint (the
// bootstrap's compute_move_only_types). Monotonic, bounded by the decl count.
func tyComputeMoveOnly(_ env: inout TyEnv) using Alloc {
    var changed: Bool = true
    while changed {
        changed = false
        var i: Int = 0
        while i < env.sFldStruct.len() {
            let owner = own(env.sFldStruct.get(i) ?? own(""))
            let ft = own(env.sFldType.get(i) ?? own(""))
            if tyMarkMoveOnly(env, owner, ft) { changed = true }
            i = i + 1
        }
        var j: Int = 0
        while j < env.ecfEnum.len() {
            let owner = own(env.ecfEnum.get(j) ?? own(""))
            let pt = own(env.ecfTy.get(j) ?? own(""))
            if tyMarkMoveOnly(env, owner, pt) { changed = true }
            j = j + 1
        }
    }
}

// Marks <owner> move-only when member type <t> is and it is not yet marked;
// true when it newly marked.
func tyMarkMoveOnly(_ env: inout TyEnv, _ owner: String, _ t: String) using Alloc -> Bool {
    if tyInMoveOnly(env, owner) { return false }
    if !tyIsMoveOnly(env, t) { return false }
    env.moveOnly.push(owner)
    return true
}

func tyInMoveOnly(_ env: inout TyEnv, _ name: Str) -> Bool {
    var i: Int = 0
    while i < env.moveOnly.len() {
        if let n = env.moveOnly.get(i) {
            if streq(n, name) { return true }
        }
        i = i + 1
    }
    return false
}

// Whether a type spelling lowers to a non-copyable C++ type: it reaches a Box
// (std::unique_ptr). Only Box and its containers count — Vec / String /
// HashMap own storage but are COPYABLE in C++ — so a container is move-only
// exactly when an element is; a nominal is move-only when the fixpoint marked
// it. A tuple is move-only when any element is.
func tyIsMoveOnly(_ env: inout TyEnv, _ t: Str) using Alloc -> Bool {
    if t.len() == 0 { return false }
    if (t.byteAt(t.len() - 1) ?? 0) == 63 { return tyIsMoveOnly(env, t.slice(0, t.len() - 1)) }  // 'T?'
    if tyIsArray(own(t)) { return tyIsMoveOnly(env, tyArrayElem(own(t))) }
    if tyIsTuple(t) { return tyAnyArgMoveOnly(env, t.slice(1, t.len() - 1)) }
    let base = genBaseOf(t)
    if streq(base, "Box") { return true }
    if streq(base, "Vec") || streq(base, "Optional") || streq(base, "HashMap") || streq(base, "Soa") {
        return tyAnyArgMoveOnly(env, t.slice(base.len() + 1, t.len() - 1))
    }
    return tyInMoveOnly(env, base)
}

// Whether any top-level comma-separated argument of `A, B[C, D]` is move-only.
func tyAnyArgMoveOnly(_ env: inout TyEnv, _ inner: Str) using Alloc -> Bool {
    var start: Int = 0
    var depth: Int = 0
    var i: Int = 0
    while i < inner.len() {
        let c = inner.byteAt(i) ?? 0
        if c == 91 || c == 40 { depth = depth + 1 }   // '[' '('
        if c == 93 || c == 41 { depth = depth - 1 }   // ']' ')'

        if c == 44 && depth == 0 {
            if tyIsMoveOnly(env, tyTrimSp(inner.slice(start, i))) { return true }
            start = i + 1
        }
        i = i + 1
    }
    return tyIsMoveOnly(env, tyTrimSp(inner.slice(start, inner.len())))
}

func tyTrimSp(_ s: Str) using Alloc -> String {
    var a: Int = 0
    while a < s.len() && (s.byteAt(a) ?? 0) == 32 { a = a + 1 }
    return own(s.slice(a, s.len()))
}

func tyRecordImport(_ env: inout TyEnv, _ d: Nd) using Alloc {
    match d {
        case .importD(let isC, let payload): tyRecordImportParts(env, isC, payload)
        default: noop()
    }
}

func tyRecordImportParts(_ env: inout TyEnv, _ isC: Bool, _ payload: Str) using Alloc {
    if isC { return }
    if streq(payload, "") { return }
    env.imports.push(own(payload))
}

func emitUnit(_ u: NUnit, _ stem: Str, _ ext: Vec[Nd]) using Alloc, Log {
    var env = buildTyEnv(u, ext)
    print("// Generated by vestra-transpiler. Do not edit.\n")
    print("#include \"")
    print(stem)
    print(".hpp\"\n\n")
    emitNsOpen(u.hasMod, u.modPath)
    var i: Int = 0
    while i < u.decls.len() {
        emitDecl(&env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    emitPanicRegistration(u.decls)
    emitNsClose(u.hasMod, u.modPath)
}

// §A10 (§15.5) the FIRST function carrying `@panic_handler` is registered with
// the runtime's delegation slot by a static-init block, inside the namespace
// so the name resolves unqualified (cpp_emitter.cpp, after the decl loop).
func emitPanicRegistration(_ decls: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < decls.len() {
        let d = decls.get(i) ?? Nd.wildcard
        if isFuncD(d) && attrHas(declAttrs(d), "panic_handler") {
            print("\n[[maybe_unused]] static const bool __vstr_register_panic_handler = []{\n")
            print("    __vstr::panic_handler = &")
            print(declName(d))
            print(";\n    return true;\n}();\n")
            return
        }
        i = i + 1
    }
}

func isFuncD(_ d: Nd) -> Bool {
    return match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b, let attrs): true
        default: false
    }
}

func declName(_ d: Nd) using Alloc -> String {
    return match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b, let attrs): own(name)
        default: own("")
    }
}

func declAttrs(_ d: Nd) using Alloc -> Vec[Nd] {
    return match d {
        case .funcD(let vis, let mods, let name, let g, let params, let caps, let t, let r, let b, let attrs): ndsCopy(attrs)
        case .staticD(let vis, let name, let ty, let v, let attrs): ndsCopy(attrs)
        case .structD(let vis, let name, let fl, let m, let dn, let isLinear, let generics, let attrs): ndsCopy(attrs)
        default: emptyNdBox()
    }
}

// ----- §A1 link attributes (cpp_emitter.cpp read_link_attrs) ---------------
// The GNU prefix shared by funcs and statics, in the bootstrap's fixed order:
// section, weak, alias, visibility, then @interrupt -> used, @boot -> naked,
// @stack_protector(.none) -> no_stack_protector, @inline(.always / .never).
// For a repeated attribute the LAST occurrence wins, as in read_link_attrs.
func emitLinkPrefix(_ attrs: Vec[Nd]) using Alloc, Log {
    let sec = attrStr(attrs, "section")
    if !streq(sec, "") {
        print("[[gnu::section(\"")
        print(sec)
        print("\")]] ")
    }
    if attrHas(attrs, "weak") { print("[[gnu::weak]] ") }
    let al = attrStr(attrs, "alias")
    if !streq(al, "") {
        print("[[gnu::alias(\"")
        print(al)
        print("\")]] ")
    }
    let vis = attrDot(attrs, "visibility")
    if streq(vis, "default") || streq(vis, "hidden") || streq(vis, "protected") {
        print("[[gnu::visibility(\"")
        print(vis)
        print("\")]] ")
    }
    if attrHas(attrs, "interrupt") { print("[[gnu::used]] ") }
    if attrHas(attrs, "boot") { print("[[gnu::naked]] ") }
    if streq(attrDot(attrs, "stack_protector"), "none") { print("[[gnu::no_stack_protector]] ") }
    let im = attrDot(attrs, "inline")
    if streq(im, "always") { print("[[gnu::always_inline]] ") }
    else if streq(im, "never") { print("[[gnu::noinline]] ") }
}

// The `inline` decl-specifier for @inline(.always) / @inline(.hint), printed
// after [[nodiscard]] so the attribute binds to the declaration.
func emitInlineSpec(_ attrs: Vec[Nd]) using Alloc, Log {
    let im = attrDot(attrs, "inline")
    if streq(im, "always") || streq(im, "hint") { print("inline ") }
}

func emitAsmLabel(_ sym: Str) using Alloc, Log {
    if streq(sym, "") { return }
    print(" asm(\"")
    print(sym)
    print("\")")
}

func attrHas(_ attrs: Vec[Nd], _ name: Str) using Alloc -> Bool {
    var i: Int = 0
    while i < attrs.len() {
        if streq(attrNameOf(attrs.get(i) ?? Nd.wildcard), name) { return true }
        i = i + 1
    }
    return false
}

// The string-literal argument of the last `@name(...)`, or "".
func attrStr(_ attrs: Vec[Nd], _ name: Str) using Alloc -> String {
    var out: String = ""
    var i: Int = 0
    while i < attrs.len() {
        let a = attrs.get(i) ?? Nd.wildcard
        if streq(attrNameOf(a), name) { out = attrArgStr(a) }
        i = i + 1
    }
    return out
}

// The leading-dot argument (`.hidden`) of the last `@name(...)`, or "".
func attrDot(_ attrs: Vec[Nd], _ name: Str) using Alloc -> String {
    var out: String = ""
    var i: Int = 0
    while i < attrs.len() {
        let a = attrs.get(i) ?? Nd.wildcard
        if streq(attrNameOf(a), name) { out = attrArgDot(a) }
        i = i + 1
    }
    return out
}

func attrNameOf(_ a: Nd) using Alloc -> String {
    return match a {
        case .attrN(let n, let arg): own(n)
        default: own("")
    }
}

func attrArgStr(_ a: Nd) using Alloc -> String {
    return match a {
        case .attrN(let n, let arg): boxStrLit(arg)
        default: own("")
    }
}

func attrArgDot(_ a: Nd) using Alloc -> String {
    return match a {
        case .attrN(let n, let arg): boxLeadingDot(arg)
        default: own("")
    }
}

func boxStrLit(_ b: Vec[Nd]) using Alloc -> String {
    if b.len() == 0 { return own("") }
    return match b.get(0) ?? Nd.wildcard {
        case .strLit(let t): own(t)
        default: own("")
    }
}

func boxLeadingDot(_ b: Vec[Nd]) using Alloc -> String {
    if b.len() == 0 { return own("") }
    return match b.get(0) ?? Nd.wildcard {
        case .leadingDot(let n): own(n)
        default: own("")
    }
}

// §5: a `module a.b` declaration wraps the unit's declarations in a C++
// nested namespace — `namespace a::b {` + blank line, and a
// `\n}  // namespace a::b` trailer — in both the .cpp and the .hpp tail
// (the header's wrap sits after the import includes).
func emitNsOpen(_ hasMod: Bool, _ path: Str) using Alloc, Log {
    if !hasMod { return }
    print("namespace ")
    print(dotsToColons(path))
    print(" {\n\n")
}

func emitNsClose(_ hasMod: Bool, _ path: Str) using Alloc, Log {
    if !hasMod { return }
    print("\n}  // namespace ")
    print(dotsToColons(path))
    print("\n")
}

func dotsToColons(_ s: Str) using Alloc -> String {
    var out: String = ""
    var i: Int = 0
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 46 { out.append("::") }
        else { out.append(s.slice(i, i + 1)) }
        i = i + 1
    }
    return out
}

func emitDecl(_ env: inout TyEnv, _ d: Nd) using Alloc, Log {
    env.curAttrs = declAttrs(d)
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body, let attrs):
            emitFuncOrSkip(env, mods, gens, name, params, thr, res, body)
        default: noop()
    }
}

// A generic function emits nothing in the .cpp — its template definition
// lives entirely in the header.
func emitFuncOrSkip(_ env: inout TyEnv, _ mods: Str, _ gens: Vec[Nd], _ name: Str, _ params: Vec[Nd], _ thr: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    if gens.len() > 0 { return }
    if body.len() == 0 { return }   // a body-less (`@extern`) declaration lives only in the header
    let attrs = ndsCopy(env.curAttrs)
    emitLinkPrefix(attrs)
    emitInlineSpec(attrs)
    emitFunc(env, mods, name, params, thr, res, body)
}

// ----- header (`.hpp`) emission --------------------------------------------
// The per-program tail of the generated header (everything after the fixed
// runtime prelude): a leading blank line, then each declaration in SOURCE order
// — a free function as a forward declaration, a struct/enum as its definition
// (definitions/methods are a later slice). The harness diffs this against the
// `.hpp` tail `vestra build` writes (after the `#endif // VESTRA_RUNTIME_PRELUDE`
// marker).
func emitHpp(_ u: NUnit, _ ext: Vec[Nd]) using Alloc, Log {
    var env = buildTyEnv(u, ext)
    print("\n")
    emitHppImports(u.imports)
    emitNsOpen(u.hasMod, u.modPath)
    var i: Int = 0
    while i < u.decls.len() {
        emitHppDecl(&env, u.decls.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    emitNsClose(u.hasMod, u.modPath)
    let qp = nsQualPrefix(u.hasMod, u.modPath)
    emitHashSpecs(&env, u, qp)
    emitDebugSpecs(&env, u, qp)
}

// The `a::b::` prefix the library specializations qualify their target with —
// they live at GLOBAL scope after the namespace closes, so an unqualified name
// would not resolve. Empty for a module-less unit.
func nsQualPrefix(_ hasMod: Bool, _ modPath: Str) using Alloc -> String {
    if !hasMod || streq(modPath, "") { return own("") }
    var s: String = dotsToColons(modPath)
    s.append("::")
    return s
}

// §12.3 derive(Hash) -> a std::hash specialization, emitted after the module
// namespace closes and separated by a blank line. Bare `enum class` cases fall
// back to the standard library's enum hash, so only structs and the
// struct-of-variant enum form need one, plus opaque newtypes (an `enum class`
// over T, which delegates to std::hash<T>).
func emitHashSpecs(_ env: inout TyEnv, _ u: NUnit, _ qp: Str) using Alloc, Log {
    var i: Int = 0
    while i < u.decls.len() {
        emitHashSpecDecl(env, u.decls.get(i) ?? Nd.wildcard, qp)
        i = i + 1
    }
}

func emitHashSpecDecl(_ env: inout TyEnv, _ d: Nd, _ qp: Str) using Alloc, Log {
    match d {
        case .structD(let vis, let name, let fields, let m, let dn, let isLinear, let generics, let attrs):
            emitHashSpecStruct(env, name, fields, generics, qp)
        case .enumD(let vis, let name, let cases, let m, let generics):
            emitHashSpecEnum(env, name, cases, generics, qp)
        case .opaqueD(let vis, let name, let under): emitHashSpecOpaque(env, name, under, qp)
        default: noop()
    }
}

func emitHashSpecStruct(_ env: inout TyEnv, _ name: Str, _ fields: Vec[Nd], _ generics: Vec[Nd], _ qp: Str) using Alloc, Log {
    if !tyDerives(env, name, "Hash") { return }
    print("\n")
    emitSpecHead(generics)
    print("struct std::hash<")
    print(qp)
    print(name)
    emitSpecArgs(generics)
    print("> {\n    [[nodiscard]] std::size_t operator()(const ")
    print(qp)
    print(name)
    emitSpecArgs(generics)
    print("& v) const noexcept {\n        std::size_t __h = 0;\n")
    var i: Int = 0
    while i < fields.len() {
        emitHashField(fields.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print("        return __h;\n    }\n};\n")
}

// The Boost-style combine the bootstrap uses — cheap, no <bit> dependency, and
// only ever feeds unordered_map bucket dispatch.
// An `embed` field is skipped: the bootstrap defers embed flattening for both
// specializations, so neither side hashes or renders it.
func emitHashField(_ f: Nd) using Alloc, Log {
    match f {
        case .field(let kind, let name, let ty, let fattrs): emitHashFieldParts(kind, name, ty)
        default: noop()
    }
}

func emitHashFieldParts(_ kind: Str, _ name: Str, _ ty: Vec[Nd]) using Alloc, Log {
    if isEmbedField(kind) { return }
    print("        __h ^= std::hash<")
    emitTypeBoxed(ty)
    print(">{}(v.")
    print(name)
    print(") + 0x9e3779b9 + (__h << 6) + (__h >> 2);\n")
}

func emitHashSpecEnum(_ env: inout TyEnv, _ name: Str, _ cases: Vec[Nd], _ generics: Vec[Nd], _ qp: Str) using Alloc, Log {
    if !tyDerives(env, name, "Hash") { return }
    if allCasesBare(cases) && generics.len() == 0 { return }
    print("\n")
    emitSpecHead(generics)
    print("struct std::hash<")
    print(qp)
    print(name)
    emitSpecArgs(generics)
    print("> {\n    [[nodiscard]] std::size_t operator()(const ")
    print(qp)
    print(name)
    emitSpecArgs(generics)
    print("& v) const noexcept {\n        return std::visit([&](auto&& __alt) {\n")
    print("            using __T = std::decay_t<decltype(__alt)>;\n")
    print("            std::size_t __h = v.value.index();\n")
    var i: Int = 0
    while i < cases.len() {
        emitHashCase(cases.get(i) ?? Nd.wildcard, name, generics, qp, i)
        i = i + 1
    }
    // The hash chain needs NO unreachable fallback — unlike the formatter, it
    // has a value to return either way, so an alternative that hashes nothing
    // (a payload-free case) just leaves __h at the variant index.
    if cases.len() > 0 { print("\n") }
    print("            return __h;\n        }, v.value);\n    }\n};\n")
}

func emitHashCase(_ c: Nd, _ owner: Str, _ generics: Vec[Nd], _ qp: Str, _ k: Int) using Alloc, Log {
    match c {
        case .enumCase(let cname, let payload): emitHashCaseParts(cname, payload, owner, generics, qp, k)
        default: noop()
    }
}

func emitHashCaseParts(_ cname: Str, _ payload: Vec[Nd], _ owner: Str, _ generics: Vec[Nd], _ qp: Str, _ k: Int) using Alloc, Log {
    emitSpecAltHead(cname, owner, generics, qp, k)
    var i: Int = 0
    while i < payload.len() {
        emitHashPayField(payload.get(i) ?? Nd.wildcard, i)
        i = i + 1
    }
    print("            }")
}

// `if constexpr (std::is_same_v<__T, <Q><Enum><args>::<case>_t>) {`, chained
// with ` else if` after the first. Inside a PARTIAL specialization the nested
// `X<T>::case_t` is a dependent name and needs `typename`.
func emitSpecAltHead(_ cname: Str, _ owner: Str, _ generics: Vec[Nd], _ qp: Str, _ k: Int) using Alloc, Log {
    if k == 0 { print("            if") } else { print(" else if") }
    print(" constexpr (std::is_same_v<__T, ")
    if specIsGeneric(generics) { print("typename ") }
    print(qp)
    print(owner)
    emitSpecArgs(generics)
    print("::")
    print(cname)
    print("_t>) {\n")
}

func emitHashPayField(_ pe: Nd, _ idx: Int) using Alloc, Log {
    match pe {
        case .payElem(let label, let ty): emitHashPayFieldParts(label, ty, idx)
        default: noop()
    }
}

func emitHashPayFieldParts(_ label: Str, _ ty: Vec[Nd], _ idx: Int) using Alloc, Log {
    print("                __h ^= std::hash<")
    emitTypeBoxed(ty)
    print(">{}(__alt.")
    printPayFieldName(label, idx)
    print(") + 0x9e3779b9 + (__h << 6) + (__h >> 2);\n")
}

// The C++ name of payload field <idx>: its declared label, or positional `_<i>`.
func printPayFieldName(_ label: Str, _ idx: Int) using Alloc, Log {
    if streq(label, "") {
        print("_")
        print(intToStr(idx))
        return
    }
    print(label)
}

// A specialization over a GENERIC type is partial, so it carries the decl's own
// template head and repeats the parameters as arguments on the target name;
// a concrete type degrades to `template <>` with no suffix.
func specIsGeneric(_ gens: Vec[Nd]) -> Bool {
    return gens.len() > 0
}

func emitSpecHead(_ gens: Vec[Nd]) using Alloc, Log {
    if !specIsGeneric(gens) { print("template <>\n"); return }
    emitTemplateHead(gens)
}

func emitSpecArgs(_ gens: Vec[Nd]) using Alloc, Log {
    if !specIsGeneric(gens) { return }
    print("<")
    var i: Int = 0
    while i < gens.len() {
        if i > 0 { print(", ") }
        printGenParamName(gens.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print(">")
}

func printGenParamName(_ g: Nd) using Alloc, Log {
    match g {
        case .genType(let n, let bounds): print(n)
        case .genConst(let n, let t): print(n)
        default: noop()
    }
}

// §12.3 derive(Debug) + §4 derive(Display): both lower to a std::formatter
// specialization so std::format and string interpolation work. For v0.5 the
// two render identically, and deriving BOTH emits a single spec — two
// specializations of the same template would be an ODR violation.
func emitDebugSpecs(_ env: inout TyEnv, _ u: NUnit, _ qp: Str) using Alloc, Log {
    var i: Int = 0
    while i < u.decls.len() {
        emitDebugSpecDecl(env, u.decls.get(i) ?? Nd.wildcard, qp)
        i = i + 1
    }
}

func emitDebugSpecDecl(_ env: inout TyEnv, _ d: Nd, _ qp: Str) using Alloc, Log {
    match d {
        case .structD(let vis, let name, let fields, let m, let dn, let isLinear, let generics, let attrs):
            emitDebugSpecStruct(env, name, fields, generics, qp)
        case .enumD(let vis, let name, let cases, let m, let generics):
            emitDebugSpecEnum(env, name, cases, generics, qp)
        case .opaqueD(let vis, let name, let under): emitDebugSpecOpaque(env, name, under, qp)
        default: noop()
    }
}

// §3 opaque newtype Hash: delegate to the underlying T's std::hash over
// `static_cast<T>(v)` (the enum class has no std::hash of its own). Passed
// by value — it is a scalar.
func emitHashSpecOpaque(_ env: inout TyEnv, _ name: Str, _ under: Vec[Nd], _ qp: Str) using Alloc, Log {
    if !tyDerives(env, name, "Hash") { return }
    if under.len() == 0 { return }
    print("\ntemplate <>\nstruct std::hash<")
    print(qp)
    print(name)
    print("> {\n    [[nodiscard]] std::size_t operator()(")
    print(qp)
    print(name)
    print(" v) const noexcept {\n        return std::hash<")
    emitTypeBoxed(under)
    print(">{}(static_cast<")
    emitTypeBoxed(under)
    print(">(v));\n    }\n};\n")
}

// §3 opaque newtype Debug/Display: render `Q(value)`, the underlying through
// its own formatter via `{}`. One spec covers both derives.
func emitDebugSpecOpaque(_ env: inout TyEnv, _ name: Str, _ under: Vec[Nd], _ qp: Str) using Alloc, Log {
    if !wantsFormatter(env, name) { return }
    if under.len() == 0 { return }
    print("\ntemplate <>\nstruct std::formatter<")
    print(qp)
    print(name)
    print("> {\n    constexpr auto parse(auto& __ctx) { return __ctx.begin(); }\n    auto format(")
    print(qp)
    print(name)
    print(" v, auto& __ctx) const {\n        return std::format_to(__ctx.out(), \"")
    print(name)
    print("({})\", static_cast<")
    emitTypeBoxed(under)
    print(">(v));\n    }\n};\n")
}

func wantsFormatter(_ env: inout TyEnv, _ name: Str) using Alloc -> Bool {
    if tyDerives(env, name, "Debug") { return true }
    return tyDerives(env, name, "Display")
}

// Renders as `Name{field: <v.field>, …}`. Literal braces are DOUBLED so they
// survive std::format's placeholder syntax.
func emitDebugSpecStruct(_ env: inout TyEnv, _ name: Str, _ fields: Vec[Nd], _ generics: Vec[Nd], _ qp: Str) using Alloc, Log {
    if !wantsFormatter(env, name) { return }
    print("\n")
    emitSpecHead(generics)
    print("struct std::formatter<")
    print(qp)
    print(name)
    emitSpecArgs(generics)
    print("> {\n    constexpr auto parse(auto& __ctx) { return __ctx.begin(); }\n")
    print("    auto format(const ")
    print(qp)
    print(name)
    emitSpecArgs(generics)
    print("& v, auto& __ctx) const {\n        return std::format_to(__ctx.out(), \"")
    print(name)
    print("{{")
    var i: Int = 0
    while i < fields.len() {
        if i > 0 { print(", ") }
        printFieldPlaceholder(fields.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print("}}\"")
    var j: Int = 0
    while j < fields.len() {
        printFieldArg(fields.get(j) ?? Nd.wildcard)
        j = j + 1
    }
    print(");\n    }\n};\n")
}

func printFieldPlaceholder(_ f: Nd) using Alloc, Log {
    match f {
        case .field(let kind, let name, let ty, let fattrs): printFieldPlaceholderParts(kind, name)
        default: noop()
    }
}

func printFieldPlaceholderParts(_ kind: Str, _ name: Str) using Alloc, Log {
    if isEmbedField(kind) { return }
    print(name)
    print(": {}")
}

func printFieldArg(_ f: Nd) using Alloc, Log {
    match f {
        case .field(let kind, let name, let ty, let fattrs): printFieldArgParts(kind, name)
        default: noop()
    }
}

func printFieldArgParts(_ kind: Str, _ name: Str) using Alloc, Log {
    if isEmbedField(kind) { return }
    print(", v.")
    print(name)
}

func isEmbedField(_ kind: Str) -> Bool { return streq(kind, "embed ") }

func emitDebugSpecEnum(_ env: inout TyEnv, _ name: Str, _ cases: Vec[Nd], _ generics: Vec[Nd], _ qp: Str) using Alloc, Log {
    if !wantsFormatter(env, name) { return }
    print("\n")
    emitSpecHead(generics)
    print("struct std::formatter<")
    print(qp)
    print(name)
    emitSpecArgs(generics)
    print("> {\n    constexpr auto parse(auto& __ctx) { return __ctx.begin(); }\n")
    if allCasesBare(cases) && generics.len() == 0 {
        emitDebugSpecBareEnum(name, cases, qp)
        return
    }
    emitDebugSpecSumEnum(name, cases, generics, qp)
}

// A bare `enum class` renders `EnumName.caseName` through a switch.
func emitDebugSpecBareEnum(_ name: Str, _ cases: Vec[Nd], _ qp: Str) using Alloc, Log {
    print("    auto format(")
    print(qp)
    print(name)
    print(" v, auto& __ctx) const {\n        switch (v) {\n")
    var i: Int = 0
    while i < cases.len() {
        emitDebugBareCase(cases.get(i) ?? Nd.wildcard, name, qp)
        i = i + 1
    }
    print("        }\n        return std::format_to(__ctx.out(), \"?\");\n    }\n};\n")
}

func emitDebugBareCase(_ c: Nd, _ owner: Str, _ qp: Str) using Alloc, Log {
    match c {
        case .enumCase(let cname, let payload): emitDebugBareCaseParts(cname, owner, qp)
        default: noop()
    }
}

func emitDebugBareCaseParts(_ cname: Str, _ owner: Str, _ qp: Str) using Alloc, Log {
    print("            case ")
    print(qp)
    print(owner)
    print("::")
    print(cname)
    print(": return std::format_to(__ctx.out(), \"")
    print(owner)
    print(".")
    print(cname)
    print("\");\n")
}

// A sum-type enum visits, rendering `EnumName::caseName{field: …}` per
// alternative (bare alternatives drop the brace group).
func emitDebugSpecSumEnum(_ name: Str, _ cases: Vec[Nd], _ generics: Vec[Nd], _ qp: Str) using Alloc, Log {
    print("    auto format(const ")
    print(qp)
    print(name)
    emitSpecArgs(generics)
    print("& v, auto& __ctx) const {\n        return std::visit([&](auto&& __alt) {\n")
    print("            using __T = std::decay_t<decltype(__alt)>;\n")
    var i: Int = 0
    while i < cases.len() {
        emitDebugSumCase(cases.get(i) ?? Nd.wildcard, name, generics, qp, i)
        i = i + 1
    }
    print(" else { std::unreachable(); }\n")
    print("        }, v.value);\n    }\n};\n")
}

func emitDebugSumCase(_ c: Nd, _ owner: Str, _ generics: Vec[Nd], _ qp: Str, _ k: Int) using Alloc, Log {
    match c {
        case .enumCase(let cname, let payload): emitDebugSumCaseParts(cname, payload, owner, generics, qp, k)
        default: noop()
    }
}

func emitDebugSumCaseParts(_ cname: Str, _ payload: Vec[Nd], _ owner: Str, _ generics: Vec[Nd], _ qp: Str, _ k: Int) using Alloc, Log {
    emitSpecAltHead(cname, owner, generics, qp, k)
    print("                return std::format_to(__ctx.out(), \"")
    print(owner)
    print("::")
    print(cname)
    if payload.len() > 0 {
        print("{{")
        var i: Int = 0
        while i < payload.len() {
            if i > 0 { print(", ") }
            printPayPlaceholder(payload.get(i) ?? Nd.wildcard, i)
            i = i + 1
        }
        print("}}\"")
        var j: Int = 0
        while j < payload.len() {
            printPayArg(payload.get(j) ?? Nd.wildcard, j)
            j = j + 1
        }
    } else {
        print("\"")
    }
    print(");\n            }")
}

func printPayPlaceholder(_ pe: Nd, _ idx: Int) using Alloc, Log {
    match pe {
        case .payElem(let label, let ty): printPayPlaceholderParts(label, idx)
        default: noop()
    }
}

func printPayPlaceholderParts(_ label: Str, _ idx: Int) using Alloc, Log {
    printPayFieldName(label, idx)
    print(": {}")
}

func printPayArg(_ pe: Nd, _ idx: Int) using Alloc, Log {
    match pe {
        case .payElem(let label, let ty): printPayArgParts(label, idx)
        default: noop()
    }
}

func printPayArgParts(_ label: Str, _ idx: Int) using Alloc, Log {
    print(", __alt.")
    printPayFieldName(label, idx)
}

// §5 imports in the header: `import c "h"` lowers to `#include "h"` at global
// scope ahead of the module includes; `import util.math` pulls in the imported
// module's header by its path as a directory path (`util/math.hpp`). Each
// group is followed by one blank line when non-empty; the `#include` alone
// suffices (cross-module references emit fully qualified).
func emitHppImports(_ imports: Vec[Nd]) using Alloc, Log {
    var anyC: Bool = false
    var i: Int = 0
    while i < imports.len() {
        if emitCImport(imports.get(i) ?? Nd.wildcard) { anyC = true }
        i = i + 1
    }
    if anyC { print("\n") }
    var anyM: Bool = false
    var j: Int = 0
    while j < imports.len() {
        if emitModImport(imports.get(j) ?? Nd.wildcard) { anyM = true }
        j = j + 1
    }
    if anyM { print("\n") }
}

func emitCImport(_ d: Nd) using Alloc, Log -> Bool {
    return match d {
        case .importD(let isC, let payload): emitCImportParts(isC, payload)
        default: false
    }
}

func emitCImportParts(_ isC: Bool, _ payload: Str) using Alloc, Log -> Bool {
    if !isC || streq(payload, "") { return false }
    print("#include \"")
    print(payload)
    print("\"\n")
    return true
}

func emitModImport(_ d: Nd) using Alloc, Log -> Bool {
    return match d {
        case .importD(let isC, let payload): emitModImportParts(isC, payload)
        default: false
    }
}

func emitModImportParts(_ isC: Bool, _ payload: Str) using Alloc, Log -> Bool {
    if isC || streq(payload, "") { return false }
    print("#include \"")
    print(dotsToSlashes(payload))
    print(".hpp\"\n")
    return true
}

func dotsToSlashes(_ s: Str) using Alloc -> String {
    var out: String = ""
    var i: Int = 0
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 46 { out.append("/") }
        else { out.append(s.slice(i, i + 1)) }
        i = i + 1
    }
    return out
}

func emitHppDecl(_ env: inout TyEnv, _ d: Nd) using Alloc, Log {
    env.curAttrs = declAttrs(d)
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body, let attrs):
            emitHppFunc(env, mods, gens, name, params, thr, res, body)
        case .structD(let vis, let name, let fields, let methods, let deinitB, let isLinear, let generics, let attrs):
            emitGenStructDef(env, generics, name, fields, methods)
        case .enumD(let vis, let name, let cases, let methods, let generics):
            emitGenEnumDecl(env, generics, name, cases, methods)
        case .constD(let vis, let name, let ty, let value):
            emitGlobalDef(env, "inline constexpr ", name, ty, value)
        case .staticD(let vis, let name, let ty, let value, let attrs):
            emitStaticDef(env, name, ty, value)
        case .opaqueD(let vis, let name, let under): emitOpaqueDecl(name, under)
        default: noop()
    }
}

// §3 `opaque type Q = T` -> `enum class Q : T {};` — a distinct type with
// T's representation and no implicit conversions, under a comment naming it.
func emitOpaqueDecl(_ name: Str, _ under: Vec[Nd]) using Alloc, Log {
    print("// opaque type ")
    print(name)
    print("\nenum class ")
    print(name)
    print(" : ")
    emitTypeBoxed(under)
    print(" {};\n")
}

// A top-level `const` / `static` lowers to an inline variable in the header:
// `inline constexpr <type> <name> = <value>;` / `inline <type> <name> = <value>;`
// (one line, no trailing blank — like a forward declaration). The `.cpp` emits
// nothing for them. An unannotated global spells its type `auto`. A static
// with no value is the §A1 `@noinit` form (the only way the bootstrap parser
// skips `= value`), so it drops the initializer: `inline <type> <name>;`.
// §A1 a static carries the link-attribute prefix and, for `@symbol`, the
// `asm("<name>")` label after its name.
func emitStaticDef(_ env: inout TyEnv, _ name: Str, _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    let attrs = ndsCopy(env.curAttrs)
    emitLinkPrefix(attrs)
    // §4 `@align(N)` on a static -> `alignas(N)`, as the bootstrap emits.
    let al = attrIntOf(attrs, "align")
    if !streq(al, "") {
        print("alignas(")
        print(al)
        print(") ")
    }
    emitGlobalDefSym(env, "inline ", name, ty, value, attrStr(attrs, "symbol"))
}

// The integer argument of the last `@name(N)` among `attrs`, or "".
func attrIntOf(_ attrs: Vec[Nd], _ name: Str) using Alloc -> String {
    var out: String = ""
    var i: Int = 0
    while i < attrs.len() {
        let a = attrs.get(i) ?? Nd.wildcard
        if streq(attrNameOf(a), name) { out = attrArgInt(a) }
        i = i + 1
    }
    return out
}

func emitGlobalDef(_ env: inout TyEnv, _ prefix: Str, _ name: Str, _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    emitGlobalDefSym(env, prefix, name, ty, value, "")
}

func emitGlobalDefSym(_ env: inout TyEnv, _ prefix: Str, _ name: Str, _ ty: Vec[Nd], _ value: Vec[Nd], _ sym: Str) using Alloc, Log {
    print(prefix)
    if ty.len() > 0 { emitTypeBoxed(ty) } else { print("auto") }
    print(" ")
    print(name)
    emitAsmLabel(sym)
    if value.len() > 0 {
        print(" = ")
        // An array-literal initializer takes its element type from the
        // annotation, as a `let` does (the bootstrap types the literal from
        // its declaration).
        if valIsVecLit(value) { emitVecLitVal(env, annElemBox(ty), value) }
        else { emitBoxed(env, value) }
    }
    print(";\n")
}

// A payload-free enum lowers to a C++ `enum class` (each case a trailing-comma
// enumerator). An enum with any payload lowers to a tagged-union struct: a nested
// `<case>_t` payload struct per case and a `std::variant<...> value` member.
// Enum methods are deferred (the variant form gets methods in a later slice), so
// they are guarded out rather than mis-emitted.
// Enum methods are dropped by the C++ emitter (an `enum class` cannot carry them,
// and the variant form does not lower them either), so only the definition is
// emitted whether or not the enum declares methods.
func emitEnumDecl(_ env: inout TyEnv, _ name: Str, _ cases: Vec[Nd], _ methods: Vec[Nd]) using Alloc, Log {
    // A payload-free `enum class` needs no derived members: C++ enumerators
    // already compare and copy natively, so only the variant form carries them.
    if allCasesBare(cases) { emitEnumClass(name, cases) }
    else { emitPayloadEnum(env, name, cases) }
}

// `struct <Name> { <case>_t structs...; std::variant<...> value{}; };`
func emitPayloadEnum(_ env: inout TyEnv, _ name: Str, _ cases: Vec[Nd]) using Alloc, Log {
    print("struct ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < cases.len() {
        emitCaseStruct(env, name, cases.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    emitVariantMember(cases)
    emitDerivedMembers(env, name)
    print("};\n\n")
}

func emitCaseStruct(_ env: inout TyEnv, _ owner: Str, _ c: Nd) using Alloc, Log {
    match c {
        case .enumCase(let cname, let payload): emitCaseStructBody(env, owner, cname, payload)
        default: noop()
    }
}

// `    struct <case>_t {};` for a bare case, or `    struct <case>_t {<f0>  <f1> };`
// — payload fields `<type> <name>{};` joined by two spaces, with a trailing
// space before the closing brace. A named field keeps its declared label; a
// positional one is `_<i>`.
// When the OWNING enum derives Eq, every case_t needs its own defaulted
// operator== as well: std::variant compares structurally only if each
// alternative is itself equality-comparable.
func emitCaseStructBody(_ env: inout TyEnv, _ owner: Str, _ cname: Str, _ payload: Vec[Nd]) using Alloc, Log {
    print("    struct ")
    print(cname)
    print("_t {")
    var any: Bool = false
    var i: Int = 0
    while i < payload.len() {
        if i > 0 { print("  ") }
        emitPayloadField(payload.get(i) ?? Nd.wildcard, i)
        any = true
        i = i + 1
    }
    if tyDerives(env, owner, "Eq") {
        if any { print(" ") }
        print("[[nodiscard]] bool operator==(const ")
        print(cname)
        print("_t&) const noexcept = default;")
        any = true
    }
    if any { print(" };\n") } else { print("};\n") }
}

func emitPayloadField(_ pe: Nd, _ idx: Int) using Alloc, Log {
    match pe {
        case .payElem(let label, let ty): emitPayloadFieldParts(label, ty, idx)
        default: noop()
    }
}

func emitPayloadFieldParts(_ label: Str, _ ty: Vec[Nd], _ idx: Int) using Alloc, Log {
    emitTypeBoxed(ty)
    print(" ")
    if streq(label, "") {
        print("_")
        print(intToStr(idx))
    } else {
        print(label)
    }
    print("{};")
}

func emitVariantMember(_ cases: Vec[Nd]) using Alloc, Log {
    print("    std::variant<")
    var i: Int = 0
    while i < cases.len() {
        if i > 0 { print(", ") }
        emitCaseTypeName(cases.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print("> value{};\n")
}

func emitCaseTypeName(_ c: Nd) using Alloc, Log {
    match c {
        case .enumCase(let cname, let payload): emitCaseTypeNameParts(cname)
        default: noop()
    }
}

func emitCaseTypeNameParts(_ cname: Str) using Alloc, Log {
    print(cname)
    print("_t")
}

func allCasesBare(_ cases: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < cases.len() {
        if !caseIsBare(cases.get(i) ?? Nd.wildcard) { return false }
        i = i + 1
    }
    return true
}

func caseIsBare(_ c: Nd) -> Bool {
    return match c {
        case .enumCase(let n, let payload): payload.len() == 0
        default: true
    }
}

func emitEnumClass(_ name: Str, _ cases: Vec[Nd]) using Alloc, Log {
    print("enum class ")
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < cases.len() {
        emitEnumCaseName(cases.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print("};\n\n")
}

func emitEnumCaseName(_ c: Nd) using Alloc, Log {
    match c {
        case .enumCase(let n, let payload): emitCaseEnumerator(n)
        default: noop()
    }
}

func emitCaseEnumerator(_ n: Str) using Alloc, Log {
    print("    ")
    print(n)
    print(",\n")
}

// A struct definition: `struct <Name> { <fields> <methods> };` then a trailing
// blank line. Each field (let / var alike) is `    <type> <name>{};` with a `{}`
// default initializer; methods follow as inline definitions.
// A generic struct / enum definition gets a `template <class T, ...>` head;
// the body emission is unchanged (the type parameters are ordinary named
// types inside).
func emitGenStructDef(_ env: inout TyEnv, _ gens: Vec[Nd], _ name: Str, _ fields: Vec[Nd], _ methods: Vec[Nd]) using Alloc, Log {
    if gens.len() > 0 { emitTemplateHead(gens) }
    emitStructDef(env, name, fields, methods)
}

func emitGenEnumDecl(_ env: inout TyEnv, _ gens: Vec[Nd], _ name: Str, _ cases: Vec[Nd], _ methods: Vec[Nd]) using Alloc, Log {
    if gens.len() > 0 { emitTemplateHead(gens) }
    emitEnumDecl(env, name, cases, methods)
}

func emitTemplateHead(_ gens: Vec[Nd]) using Alloc, Log {
    print("template <")
    var i: Int = 0
    while i < gens.len() {
        if i > 0 { print(", ") }
        emitGenParam(gens.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print(">\n")
}

// A type param is `class T` (bounds erase — the bootstrap drops them too);
// a CONST param (`const N: Int32`) lowers to `std::size_t N` regardless of
// its declared integer type — array extents are size_t in C++.
func emitGenParam(_ g: Nd) using Alloc, Log {
    match g {
        case .genConst(let nm, let ty): emitGenConstParam(nm)
        default: emitGenTypeParam(g)
    }
}

func emitGenConstParam(_ nm: Str) using Alloc, Log {
    print("std::size_t ")
    print(nm)
}

func emitGenTypeParam(_ g: Nd) using Alloc, Log {
    print("class ")
    print(genName(g))
}

// §4 the struct's own layout attributes (env.curAttrs, set per top-level
// declaration): `@repr(union)` swaps the keyword for `union`, an alignment
// sits between keyword and name, `@repr(packed)` follows the closing brace.
func emitStructDef(_ env: inout TyEnv, _ name: Str, _ fields: Vec[Nd], _ methods: Vec[Nd]) using Alloc, Log {
    let attrs = ndsCopy(env.curAttrs)
    let isUnion = layoutRepr(attrs, "union")
    if isUnion { print("union ") } else { print("struct ") }
    let al = layoutAlign(attrs)
    if !streq(al, "") {
        print("alignas(")
        print(al)
        print(") ")
    }
    print(name)
    print(" {\n")
    var i: Int = 0
    while i < fields.len() {
        emitField(fields.get(i) ?? Nd.wildcard, isUnion)
        i = i + 1
    }
    emitDerivedMembers(env, name)
    var m: Int = 0
    while m < methods.len() {
        emitMethod(env, name, methods.get(m) ?? Nd.wildcard)
        m = m + 1
    }
    print("}")
    if layoutRepr(attrs, "packed") { print(" __attribute__((packed))") }
    print(";\n\n")
}

func emitMethod(_ env: inout TyEnv, _ owner: Str, _ d: Nd) using Alloc, Log {
    match d {
        case .funcD(let vis, let mods, let name, let gens, let params, let caps, let thr, let res, let body, let attrs):
            emitMethodWithGens(env, owner, mods, gens, name, params, res, body)
        default: noop()
    }
}

// §7 a generic method is a member template.
func emitMethodWithGens(_ env: inout TyEnv, _ owner: Str, _ mods: Str, _ gens: Vec[Nd], _ name: Str, _ params: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    if gens.len() > 0 {
        print("    ")
        emitTemplateHead(gens)
    }
    emitMethodDef(env, owner, mods, name, params, res, body)
}

// An inline struct method, indented one level: a method ALWAYS carries
// `[[nodiscard]]` (even an omitted / Unit return), unlike a free function. Its
// body sits two levels in; `self.x` lowers to `(*this).x`, and `self` types
// as the owning struct so field accesses infer (array fields index plainly,
// string fields coerce). A plain method (no `inout` / `sink` receiver) is
// `const`. An ASYNC method is a coroutine returning Task<R>: its returns are
// co_returns and its read params pass BY VALUE, mirroring the bootstrap's
// method emitter.
func emitMethodDef(_ env: inout TyEnv, _ owner: Str, _ mods: Str, _ name: Str, _ params: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    let isA = isAsyncMods(mods)
    print("    [[nodiscard]] ")
    if isA { print("__vstr::Task<") }
    emitRetType(res)
    if isA { print(">") }
    print(" ")
    print(name)
    print("(")
    emitParamsMode(params, isA, false)
    let mo = own(mods)
    if containsSub(mo, "inout") || containsSub(mo, "sink") { print(") {\n") } else { print(") const {\n") }
    tyResetSyms(&env)
    tyRegisterParams(&env, params)
    tyAddSymSpelling(&env, own("self"), own(owner))
    tySetRetNode(&env, res)
    let noThrows: Vec[Nd] = Vec.new()
    tySetThrowsNode(&env, noThrows)
    env.curAsync = isA
    env.curUnitThrows = false
    if body.len() > 0 { emitBlockStmts(env, body.get(0) ?? Nd.wildcard, "        ") }
    if isA && res.len() == 0 && !blockEndsInReturn(body) { print("        co_return;\n") }
    env.curAsync = false
    print("    }\n")
}

func emitField(_ f: Nd, _ isUnion: Bool) using Alloc, Log {
    match f {
        case .field(let kind, let name, let ty, let fattrs): emitFieldDef(name, ty, fattrs, isUnion)
        default: noop()
    }
}

// `    [alignas(N) ]<type> <name>` then ` : <bits>` for a §4 `@bits(N)`
// bit-field (no default brace-init is legal there), nothing inside a
// `@repr(union)` (a C++ union takes at most one default member
// initializer, so construction picks the member), else `{}`.
func emitFieldDef(_ name: Str, _ ty: Vec[Nd], _ fattrs: Vec[Nd], _ isUnion: Bool) using Alloc, Log {
    print("    ")
    let al = layoutAlign(fattrs)
    if !streq(al, "") {
        print("alignas(")
        print(al)
        print(") ")
    }
    emitTypeBoxed(ty)
    print(" ")
    print(name)
    let bits = layoutBits(fattrs)
    if !streq(bits, "") {
        print(" : ")
        print(bits)
    } else if !isUnion {
        print("{}")
    }
    print(";\n")
}

// ----- §4 layout attributes (cpp_emitter.cpp read_layout_attrs) ------------
// `@repr(packed)`, `@repr(union)`, `@repr(align(N))` / `@align(N)` (the last
// alignment wins); `@repr(C)` and unknown modes emit nothing.
func layoutRepr(_ attrs: Vec[Nd], _ mode: Str) using Alloc -> Bool {
    var i: Int = 0
    while i < attrs.len() {
        let a = attrs.get(i) ?? Nd.wildcard
        if streq(attrNameOf(a), "repr") && streq(attrArgIdent(a), mode) { return true }
        i = i + 1
    }
    return false
}

func layoutAlign(_ attrs: Vec[Nd]) using Alloc -> String {
    var out: String = ""
    var i: Int = 0
    while i < attrs.len() {
        let a = attrs.get(i) ?? Nd.wildcard
        let an = attrNameOf(a)
        if streq(an, "align") { out = attrArgInt(a) }
        else if streq(an, "repr") {
            let ra = attrArgAlignCall(a)
            if !streq(ra, "") { out = ra }
        }
        i = i + 1
    }
    return out
}

// The FIRST `@bits(N)` on a field, as read_bits_attr returns.
func layoutBits(_ attrs: Vec[Nd]) using Alloc -> String {
    var i: Int = 0
    while i < attrs.len() {
        let a = attrs.get(i) ?? Nd.wildcard
        if streq(attrNameOf(a), "bits") { return attrArgInt(a) }
        i = i + 1
    }
    return own("")
}

func attrArgIdent(_ a: Nd) using Alloc -> String {
    return match a {
        case .attrN(let n, let arg): boxIdentName(arg)
        default: own("")
    }
}

func boxIdentName(_ b: Vec[Nd]) using Alloc -> String {
    if b.len() == 0 { return own("") }
    return match b.get(0) ?? Nd.wildcard {
        case .ident(let n): own(n)
        default: own("")
    }
}

// The integer of an attribute argument, as int_from_attr_arg + std::stoll
// read it: the literal's leading decimal digits, leading zeros dropped; ""
// for zero, a non-integer, or none (no attribute is emitted then).
func attrArgInt(_ a: Nd) using Alloc -> String {
    return match a {
        case .attrN(let n, let arg): boxIntLit(arg)
        default: own("")
    }
}

func boxIntLit(_ b: Vec[Nd]) using Alloc -> String {
    if b.len() == 0 { return own("") }
    return match b.get(0) ?? Nd.wildcard {
        case .intLit(let t): stollText(t)
        default: own("")
    }
}

func stollText(_ t: Str) using Alloc -> String {
    var out: String = ""
    var i: Int = 0
    var go: Bool = true
    while go && i < t.len() {
        let c = t.byteAt(i) ?? 0
        if c >= 48 && c <= 57 {
            if !(c == 48 && out.len() == 0) { out.append(t.slice(i, i + 1)) }
            i = i + 1
        } else {
            go = false
        }
    }
    return out
}

// `@repr(align(N))`: the argument is a call whose callee is `align`.
func attrArgAlignCall(_ a: Nd) using Alloc -> String {
    return match a {
        case .attrN(let n, let arg): boxAlignCall(arg)
        default: own("")
    }
}

func boxAlignCall(_ b: Vec[Nd]) using Alloc -> String {
    if b.len() == 0 { return own("") }
    return match b.get(0) ?? Nd.wildcard {
        case .call(let callee, let args): alignCallArg(callee, args)
        default: own("")
    }
}

func alignCallArg(_ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc -> String {
    if !streq(identBaseName(callee), "align") || args.len() != 1 { return own("") }
    return match args.get(0) ?? Nd.wildcard {
        case .arg(let label, let isInout, let val): boxIntLit(val)
        default: own("")
    }
}

// A non-generic function gets a forward declaration; a generic one is a full
// template definition (C++ templates must be visible at the instantiation
// site), in source position.
func emitHppFunc(_ env: inout TyEnv, _ mods: Str, _ gens: Vec[Nd], _ name: Str, _ params: Vec[Nd], _ thr: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    if gens.len() == 0 { emitFwdDecl(env, mods, name, params, thr, res); return }
    emitTemplateFunc(env, mods, gens, name, params, thr, res, body)
}

// `template <class T, class U>` then the same inline definition shape as a
// .cpp function, with [[nodiscard]] under the forward-declaration rule (an
// explicitly written result type or a throws clause).
func emitTemplateFunc(_ env: inout TyEnv, _ mods: Str, _ gens: Vec[Nd], _ name: Str, _ params: Vec[Nd], _ thr: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    emitTemplateHead(gens)
    emitRequiresClause(gens)
    let attrs = ndsCopy(env.curAttrs)
    emitLinkPrefix(attrs)
    emitResultAttr(thr, res)
    emitInlineSpec(attrs)
    emitFunc(env, mods, name, params, thr, res, body)
}

// §7 a generic FUNCTION's protocol bounds (inline or `where`, already merged
// into each genType) that have a standard C++20 concept become one
// `requires (<c1> && <c2>)` line under the template head: Eq ->
// equality_comparable, Comparable / Ordered -> totally_ordered, Default ->
// default_initializable. Other protocols are omitted; with none, no line.
// Struct and enum heads carry no clause, as in the bootstrap.
func emitRequiresClause(_ gens: Vec[Nd]) using Alloc, Log {
    var cs: Vec[String] = Vec.new()
    var i: Int = 0
    while i < gens.len() {
        pushGenConstraints(&cs, gens.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    if cs.len() == 0 { return }
    print("requires (")
    var k: Int = 0
    while k < cs.len() {
        if k > 0 { print(" && ") }
        print(cs.get(k) ?? own(""))
        k = k + 1
    }
    print(")\n")
}

func pushGenConstraints(_ cs: inout Vec[String], _ g: Nd) using Alloc {
    match g {
        case .genType(let nm, let bounds): pushBoundConstraints(&cs, nm, bounds)
        default: noop()
    }
}

func pushBoundConstraints(_ cs: inout Vec[String], _ nm: Str, _ bounds: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < bounds.len() {
        let c = boundConcept(bounds.get(i) ?? Nd.wildcard)
        if !streq(c, "") {
            var s: String = own(c)
            s.append("<")
            s.append(nm)
            s.append(">")
            cs.push(s)
        }
        i = i + 1
    }
}

func boundConcept(_ b: Nd) using Alloc -> String {
    return match b {
        case .named(let path, let hasG, let args): conceptFor(lastPathSeg(path))
        default: own("")
    }
}

func conceptFor(_ p: Str) using Alloc -> String {
    if streq(p, "Eq") { return own("std::equality_comparable") }
    if streq(p, "Comparable") || streq(p, "Ordered") { return own("std::totally_ordered") }
    if streq(p, "Default") { return own("std::default_initializable") }
    return own("")
}

// The last `.`-separated segment of a type path (`a.b.Eq` -> `Eq`).
func lastPathSeg(_ path: Str) using Alloc -> String {
    var start: Int = 0
    var i: Int = 0
    while i < path.len() {
        if (path.byteAt(i) ?? 0) == 46 { start = i + 1 }   // '.' == 46
        i = i + 1
    }
    return own(path.slice(start, path.len()))
}

func genName(_ g: Nd) using Alloc -> String {
    return match g {
        case .genType(let nm, let bounds): own(nm)
        case .genConst(let nm, let ty): own(nm)
        default: own("")
    }
}

// A free-function forward declaration. `[[nodiscard]]` is emitted whenever the
// return type is written explicitly (even `-> Unit`) or the function carries a
// throws clause (the fallible result must not be dropped); an omitted return
// type gets a bare `void`.
func emitFwdDecl(_ env: inout TyEnv, _ mods: Str, _ name: Str, _ params: Vec[Nd], _ thr: Vec[Nd], _ res: Vec[Nd]) using Alloc, Log {
    let attrs = ndsCopy(env.curAttrs)
    // §14.6 an `@extern` function has C linkage, as the bootstrap emits.
    if isForeignAbi(attrs) { print("extern \"C\" ") }
    emitLinkPrefix(attrs)
    emitResultAttr(thr, res)
    emitInlineSpec(attrs)
    emitTaskRet(isAsyncMods(mods), thr, res)
    print(" ")
    print(name)
    print("(")
    if isEntryMain(env, name) { print("int argc, char** argv") }
    else { emitParamsMode(params, isAsyncMods(mods) || isForeignAbi(attrs), true) }
    print(")")
    emitTrailingRet(isAsyncMods(mods), thr, res)
    // The asm label rides only on the declaration (a definition cannot take it).
    emitAsmLabel(attrStr(attrs, "symbol"))
    print(";\n")
}

// The entry `main` (a `func main` OUTSIDE any module declaration) captures the
// process arguments: `(int argc, char** argv)` plus a leading
// `__vstr::args_init(argc, argv);` so `args()` can read them. A `main` inside
// a module is an ordinary function.
func isEntryMain(_ env: inout TyEnv, _ name: Str) -> Bool {
    if env.hasModule { return false }
    return streq(name, "main")
}

func emitFunc(_ env: inout TyEnv, _ mods: Str, _ name: Str, _ params: Vec[Nd], _ thr: Vec[Nd], _ res: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    let isA = isAsyncMods(mods)
    emitTaskRet(isA, thr, res)
    print(" ")
    print(name)
    print("(")
    if isEntryMain(env, name) { print("int argc, char** argv") }
    else { emitParamsMode(params, isA || isForeignAbi(env.curAttrs), true) }
    print(")")
    emitTrailingRet(isA, thr, res)
    print(" {\n")
    tyResetSyms(&env)
    tyRegisterParams(&env, params)
    tySetRetNode(&env, res)
    tySetThrowsNode(&env, thr)
    env.curAsync = isA
    env.curUnitThrows = thr.len() > 0 && isUnitRes(res)
    if isEntryMain(env, name) { print("    __vstr::args_init(argc, argv);\n") }
    emitTupleParamPrologue(env, params)
    emitBody(env, body)
    if isA && res.len() == 0 && thr.len() == 0 && !blockEndsInReturn(body) { print("    co_return;\n") }
    // §9 a Unit throws fn returns std::expected<void, E>: falling off the end
    // must still produce the success value (F9b).
    if env.curUnitThrows && !blockEndsInReturn(body) {
        if isA { print("    co_return {};\n") } else { print("    return {};\n") }
    }
    env.curUnitThrows = false
    print("}\n\n")
}

// An omitted result, or a written `-> Unit`.
func isUnitRes(_ res: Vec[Nd]) using Alloc -> Bool {
    if res.len() == 0 { return true }
    return isNamedTy(res, "Unit")
}

// A written `-> Never` (the function lowers `[[noreturn]]`, F9).
func isNeverRes(_ res: Vec[Nd]) using Alloc -> Bool {
    return isNamedTy(res, "Never")
}

func isNamedTy(_ ty: Vec[Nd], _ want: Str) using Alloc -> Bool {
    if ty.len() == 0 { return false }
    return match ty.get(0) ?? Nd.wildcard {
        case .named(let path, let hasG, let args): streq(path, want) && !hasG
        default: false
    }
}

// `[[noreturn]]` for a non-throwing `-> Never`, else `[[nodiscard]]` when the
// result is written or the function throws (the bootstrap's result_attr).
func emitResultAttr(_ thr: Vec[Nd], _ res: Vec[Nd]) using Alloc, Log {
    if thr.len() == 0 && isNeverRes(res) { print("[[noreturn]] "); return }
    if res.len() > 0 || thr.len() > 0 { print("[[nodiscard]] ") }
}

// §6 a tuple-pattern parameter (`(a, b): (A, B)`) arrives as `__vstr_arg<i>`
// and is destructured first thing in the body, nested sub-tuples unpacking
// through the shared follow-on placeholders (emit_tuple_param_prologue).
func emitTupleParamPrologue(_ env: inout TyEnv, _ params: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < params.len() {
        emitParamPrologue(env, params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func emitParamPrologue(_ env: inout TyEnv, _ p: Nd) using Alloc, Log {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty, let ppat): emitParamPrologueParts(env, nm, ppat)
        default: noop()
    }
}

func emitParamPrologueParts(_ env: inout TyEnv, _ nm: Str, _ ppat: Vec[Nd]) using Alloc, Log {
    if ppat.len() == 0 { return }
    var v: Vec[Nd] = Vec.new()
    v.push(Nd.ident(own(nm)))
    emitTupleBinding(env, "    ", ppat, v)
}

// The modifier string is the parser's spelling ("async " / "comptime async "
// etc.), so detect `async` by substring.
func isAsyncMods(_ mods: Str) using Alloc -> Bool {
    return containsSub(own(mods), "async")
}

// §11: a coroutine must still contain a coroutine keyword; a void async body
// that doesn't already end in a `return` (lowered to co_return) gets a
// trailing `co_return;` appended.
func blockEndsInReturn(_ body: Vec[Nd]) -> Bool {
    if body.len() == 0 { return false }
    return match body.get(0) ?? Nd.wildcard {
        case .block(let stmts): stmtsEndInReturn(stmts)
        default: false
    }
}

func stmtsEndInReturn(_ stmts: Vec[Nd]) -> Bool {
    if stmts.len() == 0 { return false }
    return match stmts.get(stmts.len() - 1) ?? Nd.wildcard {
        case .retS(let v): true
        default: false
    }
}

// Record the enclosing function's throws-type node (the E of a cond-hoist
// lambda's std::expected<T, E>). Empty when the function does not throw.
func tySetThrowsNode(_ env: inout TyEnv, _ thr: Vec[Nd]) using Alloc {
    while env.curThrowsNode.len() > 0 { let _ = env.curThrowsNode.pop() }
    if thr.len() > 0 { env.curThrowsNode.push(thr.get(0) ?? Nd.wildcard) }
}

// Record the enclosing function's result type node (used when an emitted match
// expression needs the C++ return type for its lambda). Copies the node out so
// the caller's `res` is not consumed.
func tySetRetNode(_ env: inout TyEnv, _ res: Vec[Nd]) using Alloc {
    while env.curRetNode.len() > 0 { let _ = env.curRetNode.pop() }
    if res.len() > 0 { env.curRetNode.push(res.get(0) ?? Nd.wildcard) }
    env.curRet = tyRetSpelling(res)
}

// §18.5 string-lattice coercion: a Str / StrConst-typed value flowing into a
// String slot (return, annotated initializer, assignment, call argument,
// struct-construction field) wraps in std::string(...) — the string_view ->
// string constructor is explicit.
func needsStrCoercion(_ from: Str, _ to: Str) -> Bool {
    if !streq(to, "String") { return false }
    return streq(from, "Str") || streq(from, "StrConst")
}

func emitMaybeCoerced(_ env: inout TyEnv, _ wrap: Bool, _ v: Vec[Nd]) using Alloc, Log {
    if wrap { print("std::string(") }
    emitBoxed(env, v)
    if wrap { print(")") }
}

func emitRetType(_ res: Vec[Nd]) using Alloc, Log {
    if res.len() == 0 { print("void"); return }
    emitTypeBoxed(res)
}

// §11: an `async func` lowers to a C++20 coroutine returning `__vstr::Task<R>`,
// where R is the (possibly expected-wrapped) declared result — an async
// `throws(E)` nests as `Task<std::expected<T, E>>`.
func emitTaskRet(_ isAsync: Bool, _ thr: Vec[Nd], _ res: Vec[Nd]) using Alloc, Log {
    if hasTrailingRet(isAsync, thr, res) { print("auto"); return }
    if !isAsync { emitExpectedRet(thr, res); return }
    print("__vstr::Task<")
    emitExpectedRet(thr, res)
    print(">")
}

// §A12 a function returning a function pointer: C++ spells it only as a
// trailing return type (`auto f() -> R(*)(A)`), as the bootstrap emits.
func hasTrailingRet(_ isAsync: Bool, _ thr: Vec[Nd], _ res: Vec[Nd]) -> Bool {
    return !isAsync && thr.len() == 0 && isFnTy(res)
}

func emitTrailingRet(_ isAsync: Bool, _ thr: Vec[Nd], _ res: Vec[Nd]) using Alloc, Log {
    if !hasTrailingRet(isAsync, thr, res) { return }
    print(" -> ")
    emitTypeBoxed(res)
}

// §9: a `throws(E)` clause wraps the declared result in `std::expected<T, E>`
// so callers see the fallible type (`void` for T when the result is omitted);
// without a clause the plain return type is emitted.
func emitExpectedRet(_ thr: Vec[Nd], _ res: Vec[Nd]) using Alloc, Log {
    if thr.len() == 0 { emitRetType(res); return }
    print("std::expected<")
    if res.len() > 0 { emitTypeBoxed(res) } else { print("void") }
    print(", ")
    emitTypeBoxed(thr)
    print(">")
}

func emitParams(_ params: Vec[Nd], _ ptrByVal: Bool) using Alloc, Log {
    var i: Int = 0
    while i < params.len() {
        if i > 0 { print(", ") }
        emitParam(params.get(i) ?? Nd.wildcard, ptrByVal)
        i = i + 1
    }
}

// §11: an async function's read params pass BY VALUE (`T n`) — the coroutine
// frame does not copy by-reference params, so a `const T&` bound to a caller
// temporary would dangle across a suspension point.
func emitParamsMode(_ params: Vec[Nd], _ isAsync: Bool, _ ptrByVal: Bool) using Alloc, Log {
    if !isAsync { emitParams(params, ptrByVal); return }
    var i: Int = 0
    while i < params.len() {
        if i > 0 { print(", ") }
        emitValueParam(params.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func emitValueParam(_ p: Nd) using Alloc, Log {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty, let ppat): emitValueModeParam(md, nm, ty)
        default: noop()
    }
}

// Only READ params go by value; `inout` / `sink` keep their reference forms
// (an inout param is a pointer in the foreign ABI too).
func emitValueModeParam(_ md: Str, _ nm: Str, _ ty: Vec[Nd]) using Alloc, Log {
    if streq(md, "inout ") || streq(md, "sink ") { emitModeParam(md, nm, ty, true); return }
    emitValueParamParts(nm, ty)
}

// §15 Tier C: an `@extern(conv)` function, declared or defined, follows the
// foreign ABI, so its read params pass by value like an async function's (F8).
func isForeignAbi(_ attrs: Vec[Nd]) using Alloc -> Bool {
    var i: Int = 0
    while i < attrs.len() {
        if streq(attrNameOf(attrs.get(i) ?? Nd.wildcard), "extern") { return true }
        i = i + 1
    }
    return false
}

func emitValueParamParts(_ nm: Str, _ ty: Vec[Nd]) using Alloc, Log {
    if isFnTy(ty) { emitFnPtrDecl(ty, nm); return }
    emitTypeBoxed(ty)
    print(" ")
    print(nm)
}

func emitParam(_ p: Nd, _ ptrByVal: Bool) using Alloc, Log {
    match p {
        case .param(let lo, let lbl, let nm, let ne, let md, let ty, let ppat): emitModeParam(md, nm, ty, ptrByVal)
        default: noop()
    }
}

// Mode mapping: read -> `const T& n` (function-pointer declarator aside),
// inout -> `T& n`, sink -> `T&& n`. (The parser stores the mode with its
// trailing space, matching the AST print.)
func emitModeParam(_ md: Str, _ nm: Str, _ ty: Vec[Nd], _ ptrByVal: Bool) using Alloc, Log {
    if streq(md, "inout ") {
        emitTypeBoxed(ty)
        print("& ")
        print(nm)
        return
    }
    if streq(md, "sink ") {
        emitTypeBoxed(ty)
        print("&& ")
        print(nm)
        return
    }
    // §A3 (§10.5) a raw pointer is a word-sized Trivial value, and
    // `const T*& p` would put the const on the pointee, so a FREE function's
    // read-mode `Ptr` / `MutPtr` parameter passes by value. The bootstrap's
    // method-parameter path has no such case, so methods keep `const T&`.
    if ptrByVal && isRawPtrTy(ty) { emitValueParamParts(nm, ty); return }
    emitReadParam(nm, ty)
}

func isRawPtrTy(_ ty: Vec[Nd]) -> Bool {
    if ty.len() == 0 { return false }
    return match ty.get(0) ?? Nd.wildcard {
        case .named(let path, let hasG, let args): streq(path, "Ptr") || streq(path, "MutPtr")
        default: false
    }
}

// Slice 1: read-mode parameter -> `const <type>& <name>`. A function-typed
// parameter instead becomes a bare function pointer `<res>(*<name>)(...)`.
func emitReadParam(_ nm: Str, _ ty: Vec[Nd]) using Alloc, Log {
    if isFnTy(ty) { emitFnPtrDecl(ty, nm); return }
    print("const ")
    emitTypeBoxed(ty)
    print("& ")
    print(nm)
}

func emitTypeBoxed(_ ty: Vec[Nd]) using Alloc, Log {
    if ty.len() > 0 { emitType(ty.get(0) ?? Nd.wildcard) }
}

func emitType(_ t: Nd) using Alloc, Log {
    match t {
        case .named(let path, let hasG, let args): emitNamedType(path, hasG, args)
        case .opt(let inner): emitOptType(inner)
        case .fnT(let params, let caps, let thr, let res): emitFnPtr(res, "", params)
        case .vecT(let len, let elem): emitVecType(len, elem)
        case .tupleT(let elems): emitTupleType(elems)
        case .intrT(let tf): emitIntrType("", tf)
        default: print("/*?type*/")
    }
}

// §A8 (§14.5.3) an `@interrupt(T)` slot is `void(*)(T&)` (the handler
// mutates the trap frame in place); with a declarator name, `void(*n)(T&)`.
func emitIntrType(_ name: Str, _ tf: Vec[Nd]) using Alloc, Log {
    print("void(*")
    print(name)
    print(")(")
    if tf.len() > 0 {
        emitTypeBoxed(tf)
        print("&")
    }
    print(")")
}

func isIntrTy(_ ty: Vec[Nd]) -> Bool {
    if ty.len() == 0 { return false }
    return match ty.get(0) ?? Nd.wildcard {
        case .intrT(let tf): true
        default: false
    }
}

func emitIntrDecl(_ ty: Vec[Nd], _ name: Str) using Alloc, Log {
    match ty.get(0) ?? Nd.wildcard {
        case .intrT(let tf): emitIntrType(name, tf)
        default: noop()
    }
}

// `[N]T` -> `std::array<T', N>`; `(T, U, ...)` -> `std::tuple<T', U', ...>`.
func emitVecType(_ len: Str, _ elem: Vec[Nd]) using Alloc, Log {
    print("std::array<")
    emitTypeBoxed(elem)
    print(", ")
    print(len)
    print(">")
}

func emitTupleType(_ elems: Vec[Nd]) using Alloc, Log {
    print("std::tuple<")
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(", ") }
        emitType(elems.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print(">")
}

// A function type lowers to a C++ function-pointer declarator: `<res>(*<name>)(
// const P0&, const P1&, ...)`. In type-argument / return-type position the name
// is empty, giving the abstract `<res>(*)(...)` form. Parameters are read-mode.
func emitFnPtr(_ res: Vec[Nd], _ name: Str, _ params: Vec[Nd]) using Alloc, Log {
    emitRetType(res)
    print("(*")
    print(name)
    print(")(")
    var i: Int = 0
    while i < params.len() {
        if i > 0 { print(", ") }
        print("const ")
        emitType(params.get(i) ?? Nd.wildcard)
        print("&")
        i = i + 1
    }
    print(")")
}

// True when a (boxed) type annotation is a function type, which needs the
// declarator form (name embedded mid-type) rather than `<type> <name>`.
func isFnTy(_ ty: Vec[Nd]) -> Bool {
    if ty.len() == 0 { return false }
    return match ty.get(0) ?? Nd.wildcard {
        case .fnT(let a, let b, let c, let d): true
        default: false
    }
}

// Emit a function-pointer declarator for an annotation known to be a function
// type, splicing `name` into the `(*name)` slot.
func emitFnPtrDecl(_ ty: Vec[Nd], _ name: Str) using Alloc, Log {
    match ty.get(0) ?? Nd.wildcard {
        case .fnT(let params, let caps, let thr, let res): emitFnPtr(res, name, params)
        default: noop()
    }
}

func emitNamedType(_ path: Str, _ hasG: Bool, _ args: Vec[Nd]) using Alloc, Log {
    if hasG && args.len() > 0 { emitGenericType(path, args); return }
    print(cppNamed(path))
}

// The builtin generic containers map onto their C++ standard-library spellings,
// with the element / key / value types emitted recursively.
func emitGenericType(_ path: Str, _ args: Vec[Nd]) using Alloc, Log {
    if streq(path, "Vec") { emitWrap1("std::vector<", args); return }
    if streq(path, "Box") { emitWrap1("std::unique_ptr<", args); return }
    if streq(path, "Span") { emitWrap1("std::span<const ", args); return }
    if streq(path, "MutSpan") { emitWrap1("std::span<", args); return }
    if streq(path, "HashMap") { emitWrap2("std::unordered_map<", args); return }
    if streq(path, "Channel") { emitWrap1("__vstr::Channel<", args); return }
    if streq(path, "Future") { emitWrap1("__vstr::Future<", args); return }
    // §A3 (§10.5) raw pointers, §A6 MMIO views, §A11 (§14.8) per-CPU storage
    // and cache-line padding, §A4 (§14.9) atomics — each a one-argument
    // runtime or standard template, as in the bootstrap's emit_type.
    if args.len() == 1 && emitSysGeneric(path, args) { return }
    // A user generic instantiation: `Pair[Int32]` -> `Pair<std::int32_t>`.
    print(path)
    print("<")
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitType(args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print(">")
}

func emitSysGeneric(_ path: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if streq(path, "Ptr") { print("const "); emitTypeArg(args, 0); print("*"); return true }
    if streq(path, "MutPtr") { emitTypeArg(args, 0); print("*"); return true }
    if streq(path, "MmioView") { emitWrap1("__vstr::MmioView<", args); return true }
    if streq(path, "MmioRegion") { emitWrap1("__vstr::MmioRegion<", args); return true }
    if streq(path, "MmioWireView") { emitWrap1("__vstr::MmioWireView<", args); return true }
    if streq(path, "PerCpu") { emitWrap1("__vstr::PerCpu<", args); return true }
    if streq(path, "Padded") { emitWrap1("__vstr::Padded<", args); return true }
    if streq(path, "Atomic") { emitWrap1("std::atomic<", args); return true }
    if streq(path, "AtomicTaggedPointer") { emitWrap1("__vstr::AtomicTaggedPointer<", args); return true }
    return false
}

func emitWrap1(_ open: Str, _ args: Vec[Nd]) using Alloc, Log {
    print(open)
    emitTypeArg(args, 0)
    print(">")
}

func emitWrap2(_ open: Str, _ args: Vec[Nd]) using Alloc, Log {
    print(open)
    emitTypeArg(args, 0)
    print(", ")
    emitTypeArg(args, 1)
    print(">")
}

func emitTypeArg(_ args: Vec[Nd], _ i: Int) using Alloc, Log {
    if i < args.len() { emitType(args.get(i) ?? Nd.wildcard) }
}

// An optional `T?` lowers to std::optional<T>.
func emitOptType(_ inner: Vec[Nd]) using Alloc, Log {
    print("std::optional<")
    emitTypeBoxed(inner)
    print(">")
}

// Map a builtin scalar type name to its C++ spelling; an unknown name passes
// through unchanged (user types are added in a later slice).
func cppNamed(_ path: Str) using Alloc -> String {
    if streq(path, "Int8") { return own("std::int8_t") }
    if streq(path, "Int16") { return own("std::int16_t") }
    if streq(path, "Int32") { return own("std::int32_t") }
    if streq(path, "Int64") { return own("std::int64_t") }
    if streq(path, "Int") { return own("std::intptr_t") }
    if streq(path, "UInt8") { return own("std::uint8_t") }
    if streq(path, "UInt16") { return own("std::uint16_t") }
    if streq(path, "UInt32") { return own("std::uint32_t") }
    if streq(path, "UInt64") { return own("std::uint64_t") }
    if streq(path, "UInt") { return own("std::uintptr_t") }
    if streq(path, "Int128") { return own("__int128_t") }
    if streq(path, "UInt128") { return own("__uint128_t") }
    if streq(path, "Float32") { return own("float") }
    if streq(path, "Float64") { return own("double") }
    if streq(path, "Bool") { return own("bool") }
    if streq(path, "Char") { return own("char32_t") }
    if streq(path, "Unit") { return own("void") }
    if streq(path, "String") { return own("std::string") }
    if streq(path, "Str") { return own("std::string_view") }
    if streq(path, "StrConst") { return own("std::string_view") }
    // §A4 (§14.9.1) the atomics memory order — a builtin enum whose cases are
    // the `std::memory_order_*` literals (see emitMemoryOrder), so the type
    // itself is `std::memory_order`.
    if streq(path, "Ordering") { return own("std::memory_order") }
    // §A10 `Never`, §A7 (§14.14) the builtin `Context`, §11 `Duration`: bare
    // runtime types.
    if streq(path, "Never") { return own("__vstr::Never") }
    if streq(path, "Context") { return own("__vstr::Context") }
    if streq(path, "Duration") { return own("__vstr::Duration") }
    // §5 a module-qualified type (`helper.Point`) spells with `::` — dots
    // only appear in type paths as module qualifiers.
    if pathHasDot(path) { return dotsToColons(path) }
    return own(path)
}

func pathHasDot(_ s: Str) -> Bool {
    var i: Int = 0
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 46 { return true }
        i = i + 1
    }
    return false
}

// A function body is a single boxed block; emit its statements one level in.
func emitBody(_ env: inout TyEnv, _ body: Vec[Nd]) using Alloc, Log {
    if body.len() == 0 { return }
    emitBlockStmts(env, body.get(0) ?? Nd.wildcard, "    ")
}

func emitBlockStmts(_ env: inout TyEnv, _ b: Nd, _ indent: Str) using Alloc, Log {
    match b {
        case .block(let stmts): emitStmtList(env, stmts, indent)
        default: noop()
    }
}

func emitStmtList(_ env: inout TyEnv, _ stmts: Vec[Nd], _ indent: Str) using Alloc, Log {
    var i: Int = 0
    while i < stmts.len() {
        emitStmt(env, stmts.get(i) ?? Nd.wildcard, indent)
        i = i + 1
    }
}

// ----- §9 propagating-`try` hoists ------------------------------------------
// A `try f()` cannot stay mid-expression (its error path must exit the whole
// function), so each statement first hoists every propagating try it evaluates
// unconditionally into the canonical 3-line escape; the use-site then reads the
// hoisted name. The collection walk mirrors the bootstrap's evaluation-order
// traversal — post-order at a try, so an inner try's hoist precedes the outer
// one that consumes it, and consumption order equals collection order. Tries
// inside if/match branches (the bootstrap's conditional-hoist lambdas) and
// do/catch are out of scope.
func collectStmtHoists(_ env: inout TyEnv, _ s: Nd) using Alloc {
    clearHoists(&env)
    while env.condTy.len() > 0 { let _ = env.condTy.pop() }
    env.condUse = own("")
    env.condTyStr = own("")
    match s {
        case .letS(let pat, let ty, let value): collectBindHoists(env, ty, value)
        case .varS(let pat, let ty, let value): collectBindHoists(env, ty, value)
        case .exprS(let e): collectExprHoists(env, e)
        case .retS(let v): collectRetHoists(env, v)
        case .assignS(let op, let t, let v): collectAssignTries(env, t, v)
        case .whileS(let cond, let body): collectTryList(env, cond)
        case .forS(let pat, let iter, let body): collectTryList(env, iter)
        default: noop()
    }
}

// §9 conditional hoists: a TOP-LEVEL if whose branches carry a propagating
// `try` lifts to an expected-returning lambda (the branch tries cannot escape
// the enclosing function from inside a branch that may not run). The lambda's
// success type T comes from the statement context — void at statement
// position, the function result at return position, the annotation at a
// binding. An UNANNOTATED binding stays unregistered (vgen does not infer
// if-expressions), as does an if nested deeper in an expression — those
// branch tries fall back to the unwrap_exp safety net.
func collectExprHoists(_ env: inout TyEnv, _ e: Vec[Nd]) using Alloc {
    // An `if` used as a statement emits its branches as ordinary statements,
    // each hoisting its own tries, so a `return` there leaves the function;
    // a lambda hoist would make it leave only the lambda (the bootstrap's
    // collect_stmt_hoists). Only its cond / let-init tries hoist here.
    if boxIsIf(e) {
        collectTryList(env, e)
        return
    }
    let noTy: Vec[Nd] = Vec.new()
    if collectStmtCond(env, e, noTy) {
        setCondStmtTyStr(env, e)
        return
    }
    collectTryList(env, e)
}

func boxIsIf(_ e: Vec[Nd]) -> Bool {
    if e.len() == 0 { return false }
    return match e.get(0) ?? Nd.wildcard {
        case .ifE(let ln, let li, let c, let t, let el): true
        default: false
    }
}

func clearHoists(_ env: inout TyEnv) using Alloc {
    while env.hoistName.len() > 0 { let _ = env.hoistName.pop() }
    while env.hoistExpr.len() > 0 { let _ = env.hoistExpr.pop() }
    while env.hoistKind.len() > 0 { let _ = env.hoistKind.pop() }
    env.hoistNext = 0
}

// A statement-position MATCH still types its cond-hoist lambda by the match's
// own value (the bootstrap reads the resolver's type_of on the node): infer
// it from the arms. A statement-position IF stays void (+ `return {};`).
func setCondStmtTyStr(_ env: inout TyEnv, _ e: Vec[Nd]) using Alloc {
    match e.get(0) ?? Nd.wildcard {
        case .matchE(let scrut, let arms): setCondMatchTyStr(env, scrut, arms)
        default: noop()
    }
}

func setCondMatchTyStr(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc {
    let sp = tyInferMatch(env, scrut, arms)
    if streq(sp, "") || streq(sp, "Unit") { return }
    env.condTyStr = cppOfSpelling(sp)
}

func collectRetHoists(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc {
    let tyB = elemBoxCopy(env.curRetNode)
    if collectStmtCond(env, v, tyB) { return }
    collectTryList(env, v)
}

// An UNANNOTATED binding hoists only a match: its lambda types by the match's
// inferred value, as at statement position (vgen does not infer if-exprs).
func collectBindHoists(_ env: inout TyEnv, _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc {
    if ty.len() > 0 {
        let tyB = elemBoxCopy(ty)
        if collectStmtCond(env, value, tyB) { return }
    } else if valIsMatch(value) {
        let noTy: Vec[Nd] = Vec.new()
        if collectStmtCond(env, value, noTy) {
            setCondStmtTyStr(env, value)
            return
        }
    }
    collectTryList(env, value)
}

// Register the cond hoist when the boxed value is an if with branch tries and
// the enclosing function throws; walks the unconditionally-evaluated cond /
// let-init for plain hoists first (they precede the lambda), then pushes the
// `__vstr_c<N>` entry. tyB is the boxed success type (empty = void).
func collectStmtCond(_ env: inout TyEnv, _ v: Vec[Nd], _ tyB: Vec[Nd]) using Alloc -> Bool {
    if env.curThrowsNode.len() == 0 { return false }
    if v.len() == 0 { return false }
    if ifWithBranchTry(v.get(0) ?? Nd.wildcard) {
        collectCondPieces(env, v.get(0) ?? Nd.wildcard)
        pushCondHoist(env, v.get(0) ?? Nd.wildcard, tyB)
        return true
    }
    if matchWithArmTry(v.get(0) ?? Nd.wildcard) {
        collectCondPieces(env, v.get(0) ?? Nd.wildcard)
        pushCondHoist(env, v.get(0) ?? Nd.wildcard, tyB)
        return true
    }
    return false
}

func matchWithArmTry(_ e: Nd) -> Bool {
    return match e {
        case .matchE(let scrut, let arms): armsHaveTry(arms)
        default: false
    }
}

func armsHaveTry(_ arms: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < arms.len() {
        if armHasTry(arms.get(i) ?? Nd.wildcard) { return true }
        i = i + 1
    }
    return false
}

func armHasTry(_ a: Nd) -> Bool {
    return match a {
        case .matchArm(let isDef, let pat, let guard, let body): boxHasTry(guard) || boxHasTry(body)
        default: false
    }
}

func ifWithBranchTry(_ e: Nd) -> Bool {
    return match e {
        case .ifE(let ln, let li, let cond, let thenB, let els): boxHasTry(thenB) || boxHasTry(els)
        default: false
    }
}

func collectCondPieces(_ env: inout TyEnv, _ e: Nd) using Alloc {
    match e {
        case .ifE(let ln, let li, let cond, let thenB, let els): collectTryIf(env, li, cond)
        case .matchE(let scrut, let arms): collectTryList(env, scrut)
        default: noop()
    }
}

func pushCondHoist(_ env: inout TyEnv, _ node: Nd, _ tyB: Vec[Nd]) using Alloc {
    var nm: String = "__vstr_c"
    nm.append(intToStr(env.tryN))
    env.tryN = env.tryN + 1
    env.condUse = own(nm)
    env.hoistName.push(nm)
    env.hoistExpr.push(node)
    env.hoistKind.push(true)
    while env.condTy.len() > 0 { let _ = env.condTy.pop() }
    if tyB.len() > 0 { env.condTy.push(tyB.get(0) ?? Nd.wildcard) }
}

// ----- does-it-contain-a-propagating-try walkers (bootstrap's
// expr_contains_propagating_try / stmt_contains_propagating_try) ------------
func boxHasTry(_ v: Vec[Nd]) -> Bool {
    if v.len() == 0 { return false }
    return exprHasTry(v.get(0) ?? Nd.wildcard)
}

func exprHasTry(_ e: Nd) -> Bool {
    return match e {
        case .prefixE(let kw, let inner): prefixHasTry(kw, inner)
        case .paren(let inner): boxHasTry(inner)
        case .unary(let op, let x): boxHasTry(x)
        case .binary(let op, let l, let r): boxHasTry(l) || boxHasTry(r)
        case .call(let callee, let args): boxHasTry(callee) || listHasTry(args)
        case .arg(let label, let isInout, let val): boxHasTry(val)
        case .member(let base, let name, let chain): boxHasTry(base)
        case .index(let base, let idxs): boxHasTry(base) || listHasTry(idxs)
        case .vecLit(let elems): listHasTry(elems)
        case .tupleLit(let elems): listHasTry(elems)
        case .interpE(let parts, let exprs): listHasTry(exprs)
        case .ifE(let ln, let li, let cond, let thenB, let els): boxHasTry(cond) || boxHasTry(li) || boxHasTry(thenB) || boxHasTry(els)
        case .matchE(let scrut, let arms): boxHasTry(scrut) || listHasTry(arms)
        case .matchArm(let isDef, let pat, let guard, let body): boxHasTry(guard) || boxHasTry(body)
        case .block(let stmts): stmtsHaveTry(stmts)
        default: false
    }
}

func prefixHasTry(_ kw: Str, _ inner: Vec[Nd]) -> Bool {
    if streq(kw, "try ") { return true }
    if streq(kw, "copy ") { return boxHasTry(inner) }
    return false
}

func listHasTry(_ list: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < list.len() {
        if exprHasTry(list.get(i) ?? Nd.wildcard) { return true }
        i = i + 1
    }
    return false
}

func stmtsHaveTry(_ stmts: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < stmts.len() {
        if stmtHasTry(stmts.get(i) ?? Nd.wildcard) { return true }
        i = i + 1
    }
    return false
}

func stmtHasTry(_ s: Nd) -> Bool {
    return match s {
        case .letS(let pat, let ty, let value): boxHasTry(value)
        case .varS(let pat, let ty, let value): boxHasTry(value)
        case .exprS(let e): boxHasTry(e)
        case .retS(let v): boxHasTry(v)
        case .assignS(let op, let t, let v): boxHasTry(t) || boxHasTry(v)
        default: false
    }
}

func collectAssignTries(_ env: inout TyEnv, _ t: Vec[Nd], _ v: Vec[Nd]) using Alloc {
    collectTryList(env, t)
    collectTryList(env, v)
}

func collectTryList(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc {
    if v.len() > 0 { collectTry(env, v.get(0) ?? Nd.wildcard) }
}

// Descends only into subexpressions the statement evaluates unconditionally:
// if/match visit their condition/scrutinee but not their branches, `&&`/`||`
// skip the right operand, and `try?` / `try!` operands are not walked (they
// consume the error locally, no hoist needed).
func collectTry(_ env: inout TyEnv, _ e: Nd) using Alloc {
    match e {
        case .prefixE(let kw, let inner): collectTryPrefix(env, kw, inner)
        case .call(let callee, let args): collectTryCall(env, callee, args)
        case .binary(let op, let l, let r): collectTryBinary(env, op, l, r)
        case .unary(let op, let x): collectTryList(env, x)
        case .member(let base, let name, let chain): collectTryList(env, base)
        case .index(let base, let idxs): collectTryIndex(env, base, idxs)
        case .paren(let inner): collectTryList(env, inner)
        case .vecLit(let elems): collectTryEach(env, elems)
        case .tupleLit(let elems): collectTryEach(env, elems)
        case .interpE(let parts, let exprs): collectTryEach(env, exprs)
        case .ifE(let ln, let li, let cond, let thenB, let els): collectTryIf(env, li, cond)
        case .matchE(let scrut, let arms): collectTryList(env, scrut)
        default: noop()
    }
}

func collectTryPrefix(_ env: inout TyEnv, _ kw: Str, _ inner: Vec[Nd]) using Alloc {
    if streq(kw, "try ") {
        collectTryList(env, inner)
        pushTryHoist(env, inner)
        return
    }
    if streq(kw, "copy ") { collectTryList(env, inner) }
}

func pushTryHoist(_ env: inout TyEnv, _ inner: Vec[Nd]) using Alloc {
    var nm: String = "__vstr_t"
    nm.append(intToStr(env.tryN))
    env.tryN = env.tryN + 1
    env.hoistName.push(nm)
    env.hoistExpr.push(inner.get(0) ?? Nd.wildcard)
    env.hoistKind.push(false)
}

func collectTryCall(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc {
    collectTryList(env, callee)
    var i: Int = 0
    while i < args.len() {
        collectTryArg(env, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func collectTryArg(_ env: inout TyEnv, _ a: Nd) using Alloc {
    match a {
        case .arg(let label, let isInout, let val): collectTryList(env, val)
        default: noop()
    }
}

func collectTryBinary(_ env: inout TyEnv, _ op: Str, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc {
    collectTryList(env, l)
    if streq(op, "&&") || streq(op, "||") { return }
    collectTryList(env, r)
}

func collectTryIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc {
    collectTryList(env, base)
    collectTryEach(env, idxs)
}

func collectTryEach(_ env: inout TyEnv, _ list: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < list.len() {
        collectTry(env, list.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func collectTryIf(_ env: inout TyEnv, _ li: Vec[Nd], _ cond: Vec[Nd]) using Alloc {
    collectTryList(env, cond)
    collectTryList(env, li)
}

// One emission per collected hoist, at statement indent. A plain try entry
// prints the canonical 3-line escape; a cond entry prints the
// expected-returning lambda. The queue and the cond state are SNAPSHOTTED
// first — a cond entry's lambda body re-enters emitStmt for the branch
// statements, which resets the per-statement collector state mid-iteration.
func emitStmtHoists(_ env: inout TyEnv, _ indent: Str) using Alloc, Log {
    var names: Vec[String] = Vec.new()
    var exprs: Vec[Nd] = Vec.new()
    var kinds: Vec[Bool] = Vec.new()
    var i: Int = 0
    while i < env.hoistName.len() {
        names.push(env.hoistName.get(i) ?? own(""))
        exprs.push(env.hoistExpr.get(i) ?? Nd.wildcard)
        kinds.push(env.hoistKind.get(i) ?? false)
        i = i + 1
    }
    let condT = elemBoxCopy(env.condTy)
    let condTS = own(env.condTyStr)
    var j: Int = 0
    while j < names.len() {
        let nm = names.get(j) ?? own("")
        let ex = exprs.get(j) ?? Nd.wildcard
        if kinds.get(j) ?? false {
            emitCondHoistEntry(env, indent, nm, ex, condT, condTS)
        } else {
            emitTryHoistEntry(env, indent, nm, ex)
        }
        j = j + 1
    }
}

// The canonical 3-line escape: evaluate the fallible call into `<n>_r`,
// re-propagate its error, unwrap the success value into `<n>`.
// A `try` operand whose callee returns Unit (a void std::expected).
func isUnitTry(_ env: inout TyEnv, _ ex: Nd) using Alloc -> Bool {
    return streq(tyInfer(env, ex), "Unit")
}

func isUnitTryBoxed(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc -> Bool {
    if v.len() == 0 { return false }
    return isUnitTry(env, v.get(0) ?? Nd.wildcard)
}

func emitTryHoistEntry(_ env: inout TyEnv, _ indent: Str, _ nm: Str, _ ex: Nd) using Alloc, Log {
    print(indent)
    print("auto ")
    print(nm)
    print("_r = ")
    emitExpr(env, ex)
    print(";\n")
    print(indent)
    print("if (!")
    print(nm)
    print("_r.has_value()) { ")
    emitRetKw(env)
    print(" std::unexpected{")
    print(nm)
    print("_r.error()}; }\n")
    // §9 `*r` of a std::expected<void, E> is void: no value to bind (F9b);
    // the use site reads `*<n>_r` directly.
    if isUnitTry(env, ex) { return }
    // §10 move the unwrapped value out of the std::expected when it is
    // move-only — `*r` is an lvalue, so a plain copy is a hard error.
    print(indent)
    print("auto ")
    print(nm)
    if tyIsMoveOnly(env, tyInfer(env, ex)) {
        print(" = std::move(*")
        print(nm)
        print("_r);\n")
    } else {
        print(" = *")
        print(nm)
        print("_r;\n")
    }
}

// §9 the conditional hoist: the if lifts to an immediately-invoked lambda
// returning std::expected<T, E> (T = the statement-context success type,
// void at statement position — which also owes a `return {};` fallthrough;
// E = the enclosing throws type). The body is the statement-form if with
// returning tails; branch statements re-enter the normal per-statement hoist
// machinery (sharing the global counter), and a `try` TAIL emits the braced
// inline escape with the fixed name __vstr_r. The outer scope re-propagates
// with the same 1-line escape shape as a plain hoist (no `_r` suffix — the
// lambda's result IS the expected).
func emitCondHoistEntry(_ env: inout TyEnv, _ indent: Str, _ nm: Str, _ node: Nd, _ condT: Vec[Nd], _ condTS: Str) using Alloc, Log {
    print(indent)
    print("auto ")
    print(nm)
    print(" = [&]() -> std::expected<")
    if condT.len() > 0 { emitTypeBoxed(condT) }
    else if !streq(condTS, "") { print(condTS) }
    else { print("void") }
    print(", ")
    emitTypeBoxed(env.curThrowsNode)
    print("> {\n")
    emitCondHoistBody(env, deeper(indent), node)
    if condT.len() == 0 && streq(condTS, "") {
        print(deeper(indent))
        print("return {};\n")
    }
    print(indent)
    print("}();\n")
    print(indent)
    print("if (!")
    print(nm)
    print(".has_value()) { ")
    emitRetKw(env)
    print(" std::unexpected{")
    print(nm)
    print(".error()}; }\n")
}

func emitCondHoistBody(_ env: inout TyEnv, _ ind: Str, _ node: Nd) using Alloc, Log {
    match node {
        case .ifE(let ln, let li, let cond, let thenB, let els): emitReturnIf(env, ind, ln, li, cond, thenB, els)
        case .matchE(let scrut, let arms): emitMatchInLambda(env, ind, scrut, arms)
        default: noop()
    }
}

// §9 statement-form match for the cond-hoist lambda body (the bootstrap's
// emit_match_in_lambda). The std::visit shape cannot be reused — a
// `return std::unexpected{...}` inside visit's callable would return from
// the WRONG scope — so: a payloaded enum lowers to a
// std::holds_alternative / std::get if-chain, a bare enum to a switch with
// braced cases, and a value scrutinee to an if/else-if chain over a
// `__vstr_mh` handle. Every arm body emits in return form (a `try` tail
// takes the braced inline escape).
func emitMatchInLambda(_ env: inout TyEnv, _ ind: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    let sp = tyInferBoxed(env, scrut)
    let bn = genBaseOf(sp)
    if isPayloadEnum(env, sp) { emitPayMatchLambda(env, ind, sp, scrut, arms); return }
    if tyIsEnum(env, bn) { emitBareMatchLambda(env, ind, sp, scrut, arms); return }
    emitValMatchLambda(env, ind, scrut, arms)
}

func emitBareMatchLambda(_ env: inout TyEnv, _ ind: Str, _ en: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print(ind)
    print("switch (")
    emitBoxed(env, scrut)
    print(") {\n")
    let i12 = deeper(ind)
    var di: Int = 0 - 1
    var i: Int = 0
    while i < arms.len() {
        if armIsDefault(arms.get(i) ?? Nd.wildcard) { di = i }
        else { emitBareLambdaArm(env, ind, i12, en, arms.get(i) ?? Nd.wildcard) }
        i = i + 1
    }
    print(ind)
    if di >= 0 {
        print("default: {\n")
        emitLambdaArmBody(env, i12, arms.get(di) ?? Nd.wildcard)
        print(ind)
        print("}\n")
    } else {
        print("default: std::unreachable();\n")
    }
    print(ind)
    print("}\n")
}

func emitBareLambdaArm(_ env: inout TyEnv, _ ind: Str, _ i12: Str, _ en: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDef, let pat, let guard, let body): emitBareLambdaArmParts(env, ind, i12, en, pat, body)
        default: noop()
    }
}

func emitBareLambdaArmParts(_ env: inout TyEnv, _ ind: Str, _ i12: Str, _ en: Str, _ pat: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(ind)
    print("case ")
    print(en)
    print("::")
    print(armCaseName(pat))
    print(": {\n")
    print(i12)
    emitRetTailExpr(env, body)
    print(ind)
    print("}\n")
}

func emitPayMatchLambda(_ env: inout TyEnv, _ ind: Str, _ en: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print(ind)
    print("auto&& __vstr_alt_ref = (")
    emitBoxed(env, scrut)
    print(").value;\n")
    let i12 = deeper(ind)
    var di: Int = 0 - 1
    var k: Int = 0
    var i: Int = 0
    while i < arms.len() {
        if armIsDefault(arms.get(i) ?? Nd.wildcard) { di = i }
        else {
            emitPayLambdaArm(env, ind, i12, en, arms.get(i) ?? Nd.wildcard, k)
            k = k + 1
        }
        i = i + 1
    }
    print(ind)
    if di >= 0 {
        print("else {\n")
        emitLambdaArmBody(env, i12, arms.get(di) ?? Nd.wildcard)
        print(ind)
        print("}\n")
    } else {
        print("else { std::unreachable(); }\n")
    }
}

func emitPayLambdaArm(_ env: inout TyEnv, _ ind: Str, _ i12: Str, _ en: Str, _ arm: Nd, _ k: Int) using Alloc, Log {
    match arm {
        case .matchArm(let isDef, let pat, let guard, let body): emitPayLambdaArmParts(env, ind, i12, en, pat, body, k)
        default: noop()
    }
}

func emitPayLambdaArmParts(_ env: inout TyEnv, _ ind: Str, _ i12: Str, _ en: Str, _ pat: Vec[Nd], _ body: Vec[Nd], _ k: Int) using Alloc, Log {
    print(ind)
    if k == 0 { print("if") } else { print("else if") }
    print(" (std::holds_alternative<")
    print(en)
    print("::")
    let cn = armCaseName(pat)
    print(cn)
    print("_t>(__vstr_alt_ref)) {\n")
    if patHasBinding(pat) {
        print(i12)
        print("auto&& __vstr_alt = std::get<")
        print(en)
        print("::")
        print(cn)
        print("_t>(__vstr_alt_ref);\n")
        emitPayloadBindings(env, i12, en, pat)
    }
    print(i12)
    emitRetTailExpr(env, body)
    print(ind)
    print("}\n")
}

func patHasBinding(_ pat: Vec[Nd]) using Alloc -> Bool {
    if pat.len() == 0 { return false }
    return match pat.get(0) ?? Nd.wildcard {
        case .enumP(let cname, let children): childrenHaveBinding(children)
        default: false
    }
}

func childrenHaveBinding(_ children: Vec[Nd]) using Alloc -> Bool {
    var i: Int = 0
    while i < children.len() {
        if !streq(patNameOf(children.get(i) ?? Nd.wildcard), "") { return true }
        i = i + 1
    }
    return false
}

func emitValMatchLambda(_ env: inout TyEnv, _ ind: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print(ind)
    print("auto&& __vstr_mh = ")
    emitBoxed(env, scrut)
    print(";\n")
    let i12 = deeper(ind)
    var di: Int = 0 - 1
    var k: Int = 0
    var i: Int = 0
    while i < arms.len() {
        if armIsDefault(arms.get(i) ?? Nd.wildcard) { di = i }
        else {
            emitValLambdaArm(env, ind, i12, arms.get(i) ?? Nd.wildcard, k)
            k = k + 1
        }
        i = i + 1
    }
    print(ind)
    if di >= 0 {
        print("else {\n")
        emitLambdaArmBody(env, i12, arms.get(di) ?? Nd.wildcard)
        print(ind)
        print("}\n")
    } else {
        print("else { std::unreachable(); }\n")
    }
}

func emitValLambdaArm(_ env: inout TyEnv, _ ind: Str, _ i12: Str, _ arm: Nd, _ k: Int) using Alloc, Log {
    match arm {
        case .matchArm(let isDef, let pat, let guard, let body): emitValLambdaArmParts(env, ind, i12, pat, guard, body, k)
        default: noop()
    }
}

func emitValLambdaArmParts(_ env: inout TyEnv, _ ind: Str, _ i12: Str, _ pat: Vec[Nd], _ guard: Vec[Nd], _ body: Vec[Nd], _ k: Int) using Alloc, Log {
    print(ind)
    if k == 0 { print("if (") } else { print("else if (") }
    emitPatPredicate(env, pat, "__vstr_mh")
    if guard.len() > 0 {
        print(" && (")
        emitBoxed(env, guard)
        print(")")
    }
    print(") {\n")
    print(i12)
    emitRetTailExpr(env, body)
    print(ind)
    print("}\n")
}

func emitLambdaArmBody(_ env: inout TyEnv, _ i12: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDef, let pat, let guard, let body): emitLambdaArmBodyParts(env, i12, body)
        default: noop()
    }
}

func emitLambdaArmBodyParts(_ env: inout TyEnv, _ i12: Str, _ body: Vec[Nd]) using Alloc, Log {
    print(i12)
    emitRetTailExpr(env, body)
}

func emitStmt(_ env: inout TyEnv, _ s: Nd, _ indent: Str) using Alloc, Log {
    collectStmtHoists(&env, s)
    let cn = own(env.condUse)
    emitStmtHoists(&env, indent)
    if !streq(cn, "") { emitCondUse(&env, s, indent, cn); return }
    match s {
        case .letS(let pat, let ty, let value): emitBinding(env, indent, pat, ty, value)
        case .varS(let pat, let ty, let value): emitBinding(env, indent, pat, ty, value)
        case .assignS(let op, let t, let v): emitAssign(env, indent, op, t, v)
        case .whileS(let cond, let body): emitWhile(env, indent, cond, body)
        case .forS(let pat, let iter, let body): emitFor(env, indent, pat, iter, body)
        case .exprS(let e): emitExprStmt(env, indent, e)
        case .retS(let v): emitReturn(env, indent, v)
        case .breakS(let label): emitJump(indent, "break")
        case .continueS(let label): emitJump(indent, "continue")
        case .withS(let caps, let names, let vals, let tys, let body): emitWith(env, indent, names, vals, tys, body)
        default: noop()
    }
}

// §9 the statement whose value was lifted into a cond hoist reads the
// unwrapped lambda result: `(*__vstr_cN);` at statement position,
// `return (*__vstr_cN);` at return position, `<type> <name> = (*__vstr_cN);`
// at an (annotated) binding.
func emitCondUse(_ env: inout TyEnv, _ s: Nd, _ indent: Str, _ cn: Str) using Alloc, Log {
    match s {
        case .exprS(let e): emitCondUseStmt(indent, cn)
        case .retS(let v): emitCondUseRet(env, indent, cn)
        case .letS(let pat, let ty, let value): emitCondUseBind(env, indent, pat, ty, value, cn)
        case .varS(let pat, let ty, let value): emitCondUseBind(env, indent, pat, ty, value, cn)
        default: noop()
    }
}

func emitCondUseStmt(_ indent: Str, _ cn: Str) using Alloc, Log {
    print(indent)
    print("(*")
    print(cn)
    print(");\n")
}

func emitCondUseRet(_ env: inout TyEnv, _ indent: Str, _ cn: Str) using Alloc, Log {
    print(indent)
    emitRetKw(env)
    print(" (*")
    print(cn)
    print(");\n")
}

func emitCondUseBind(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ ty: Vec[Nd], _ value: Vec[Nd], _ cn: Str) using Alloc, Log {
    print(indent)
    if ty.len() > 0 { emitTypeBoxed(ty) } else { print("auto") }
    print(" ")
    print(patName(pat))
    print(" = (*")
    print(cn)
    print(");\n")
    if ty.len() > 0 { tyRegisterPat(&env, pat, ty) }
    else { tyAddSymSpelling(&env, patName(pat), tyInferBoxed(&env, value)) }
}

// §9 `do { body } catch (NAME: E) { handler }` in value position: a pair of
// nested IIFEs, mirroring the bootstrap's DoCatchExpr lowering. The inner
// lambda returns std::expected<T, E>, so the body's tries propagate via
// std::unexpected — its hoists print at column 0, inline in the statement.
// The outer lambda dispatches has_value to the unwrapped body value or to
// the handler with NAME bound to the error (the handler block lowers to its
// own `[&]{ return ...; }()` IIFE). T comes from the use-site context (the
// function result at return position, the annotation at a binding), E from
// the catch ANNOTATION — the bare `catch e` form needs sema's inferred
// error type: the resolver infers it from the do-body's FIRST try, so vgen
// takes the throws(E) of that try's callee (a unit function). Multi-statement
// do/handler bodies and the where-guard form stay out of the mirrored subset.
func valIsDoCatch(_ v: Vec[Nd]) using Alloc -> Bool {
    if v.len() == 0 { return false }
    return match v.get(0) ?? Nd.wildcard {
        case .doCatchE(let db, let en, let et, let cb): et.len() > 0 || boxHasTry(blockTrailing(db))
        default: false
    }
}

func emitDoCatchValue(_ env: inout TyEnv, _ tyB: Vec[Nd], _ v: Vec[Nd]) using Alloc, Log {
    match v.get(0) ?? Nd.wildcard {
        case .doCatchE(let db, let en, let et, let cb): emitDoCatchParts(env, tyB, db, en, et, cb)
        default: noop()
    }
}

func emitDoCatchParts(_ env: inout TyEnv, _ tyB: Vec[Nd], _ db: Vec[Nd], _ en: Str, _ et: Vec[Nd], _ cb: Vec[Nd]) using Alloc, Log {
    print("([&]() -> ")
    emitTypeBoxed(tyB)
    print(" { auto __vstr_do = [&]() -> std::expected<")
    emitTypeBoxed(tyB)
    print(", ")
    let tr = blockTrailing(db)
    // The error type comes from the first `try` in the body, statements first.
    let errB = doCatchErrTypeOf(env, et, db)
    emitTypeBoxed(errB)
    print("> { ")
    // Statements before the trailing value, each at column 0 (the bootstrap's
    // layout inside the lambda), then the value's own hoists.
    emitDoLeading(env, db)
    clearHoists(&env)
    collectTryList(env, tr)
    emitStmtHoists(&env, "")
    print("return ")
    emitBoxed(env, tr)
    print(";\n }(); if (__vstr_do.has_value()) { return *__vstr_do; } [[maybe_unused]] auto ")
    print(en)
    print(" = __vstr_do.error(); return ")
    // The catch binding carries the declared error type. Registering it lets
    // the catch body type-dispatch on `e` — most visibly, a `match e` over an
    // error ENUM has to reach the switch lowering rather than being taken for
    // a value scrutinee.
    let esp = tyAnnSpelling(errB)
    tyAddSymSpelling(&env, own(en), esp)
    emitCatchTail(env, tyB, cb)
    print("; }())")
}

func emitDoLeading(_ env: inout TyEnv, _ db: Vec[Nd]) using Alloc, Log {
    if let b = db.get(0) {
        match b {
            case .block(let stmts): emitDoLeadingStmts(env, stmts)
            default: noop()
        }
    }
}

func emitDoLeadingStmts(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc, Log {
    var n: Int = stmts.len()
    if stmtsTrailing(stmts).len() > 0 { n = n - 1 }
    var i: Int = 0
    while i < n {
        emitStmt(env, stmts.get(i) ?? Nd.wildcard, "")
        i = i + 1
    }
}

// The error type, judged on the first `try` anywhere in the body: the leading
// statements' hoists, else the trailing value's.
func doCatchErrTypeOf(_ env: inout TyEnv, _ et: Vec[Nd], _ db: Vec[Nd]) using Alloc -> Vec[Nd] {
    if et.len() > 0 { return elemBoxCopy(et) }
    clearHoists(&env)
    let savedN = env.tryN   // a look-ahead: the real collection numbers them
    if let b = db.get(0) {
        match b {
            case .block(let stmts): collectTryStmts(env, stmts)
            default: noop()
        }
    }
    let t = doCatchErrType(env, et)
    clearHoists(&env)
    env.tryN = savedN
    return t
}

func collectTryStmts(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc {
    var i: Int = 0
    while i < stmts.len() {
        match stmts.get(i) ?? Nd.wildcard {
            case .letS(let p, let t, let v): collectTryList(env, v)
            case .varS(let p, let t, let v): collectTryList(env, v)
            case .exprS(let e): collectTryList(env, e)
            default: noop()
        }
        i = i + 1
    }
}

// The do/catch error type: the catch annotation when present; for a bare
// `catch e`, the throws(E) of the do-body's first try's callee — read off the
// hoists collectTryList just gathered (in evaluation order, operand = the call).
func doCatchErrType(_ env: inout TyEnv, _ et: Vec[Nd]) using Alloc -> Vec[Nd] {
    if et.len() > 0 { return elemBoxCopy(et) }
    if env.hoistExpr.len() == 0 { return Vec.new() }
    var out: Vec[Nd] = Vec.new()
    let callee = callNameOf(env.hoistExpr.get(0) ?? Nd.wildcard)
    let t = tyFuncThrows(env, callee)
    if !ndIsWildcard(t) { out.push(t) }
    return out
}

// The plain-identifier callee name of a call node ("" for anything else).
func callNameOf(_ c: Nd) using Alloc -> String {
    return match c {
        case .call(let callee, let args): exCalleeNameBoxed(callee)
        default: own("")
    }
}

func ndIsWildcard(_ n: Nd) -> Bool {
    return match n {
        case .wildcard: true
        default: false
    }
}

func tyFuncThrows(_ env: inout TyEnv, _ name: Str) -> Nd {
    var i: Int = 0
    while i < env.funcName.len() {
        if let n = env.funcName.get(i) {
            if streq(n, name) { return env.funcThr.get(i) ?? Nd.wildcard }
        }
        i = i + 1
    }
    return Nd.wildcard
}

// The handler is checked against the do/catch's own type T, so a `match`
// handler types its lambda as T rather than as its arms' inferred type
// (`-100` arms under an Int32 result are Int32, not Int).
func emitCatchTail(_ env: inout TyEnv, _ tyB: Vec[Nd], _ cb: Vec[Nd]) using Alloc, Log {
    print("[&]{ return ")
    let tr = blockTrailing(cb)
    match tr.get(0) ?? Nd.wildcard {
        case .matchE(let scrut, let arms): emitMatchValue(env, "    ", tyB, "", scrut, arms)
        default: emitBoxed(env, tr)
    }
    print("; }()")
}

// The (boxed) trailing expression of a block — empty when the block does not
// end in an expression statement.
func blockTrailing(_ b: Vec[Nd]) using Alloc -> Vec[Nd] {
    if b.len() == 0 { return Vec.new() }
    return match b.get(0) ?? Nd.wildcard {
        case .block(let stmts): stmtsTrailing(stmts)
        default: Vec.new()
    }
}

func stmtsTrailing(_ stmts: Vec[Nd]) using Alloc -> Vec[Nd] {
    if stmts.len() == 0 { return Vec.new() }
    return match stmts.get(stmts.len() - 1) ?? Nd.wildcard {
        case .exprS(let e): elemBoxCopy(e)
        default: Vec.new()
    }
}

// `with ... { body }` lowers to a bare nested block `{ ... }` at the current
// statement indent. Grant-only capabilities (`with Cap`) are erased. A value
// binding (`with x = e`) emits `auto&& x = e;`; a capability instance
// (`with Cap = e`) emits `(void)(e);`. Bindings precede the body, in source order.
func emitWith(_ env: inout TyEnv, _ indent: Str, _ names: Vec[Nd], _ vals: Vec[Nd], _ tys: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("{\n")
    let d = deeper(indent)
    var i: Int = 0
    while i < vals.len() {
        let nm = identName(names.get(i) ?? Nd.ident(""))
        print(d)
        if streq(nm, "") {
            print("(void)(")
            emitExpr(env, vals.get(i) ?? Nd.wildcard)
            print(");\n")
        } else {
            // §17.4 an annotated binding declares its type (`T name = v;`, or
            // the function-pointer declarator); otherwise `auto&& name = v;`.
            let ann = withAnnBox(tys, i)
            if ann.len() > 0 {
                emitTypeWithName(ann, nm)
                print(" = ")
            } else {
                print("auto&& ")
                print(nm)
                print(" = ")
            }
            emitExpr(env, vals.get(i) ?? Nd.wildcard)
            print(";\n")
            if ann.len() > 0 { tyAddSymSpelling(&env, nm, tyAnnSpelling(ann)) }
            else { tyAddSymSpelling(&env, nm, tyInfer(&env, vals.get(i) ?? Nd.wildcard)) }
        }
        i = i + 1
    }
    if body.len() > 0 { emitBlockStmts(env, body.get(0) ?? Nd.wildcard, d) }
    print(indent)
    print("}\n")
}

// The i-th with-binding annotation as a one-element box, or empty for none.
func withAnnBox(_ tys: Vec[Nd], _ i: Int) using Alloc -> Vec[Nd] {
    var b: Vec[Nd] = Vec.new()
    let t = tys.get(i) ?? Nd.wildcard
    if !isWildcardNode(t) { b.push(t) }
    return b
}

func isWildcardNode(_ n: Nd) -> Bool {
    return match n {
        case .wildcard: true
        default: false
    }
}

// `<type> <name>`, or the `R(*name)(A)` declarator for a function type.
func emitTypeWithName(_ ty: Vec[Nd], _ nm: Str) using Alloc, Log {
    if isFnTy(ty) { emitFnPtrDecl(ty, nm); return }
    if isIntrTy(ty) { emitIntrDecl(ty, nm); return }
    emitTypeBoxed(ty)
    print(" ")
    print(nm)
}

func identName(_ n: Nd) using Alloc -> String {
    return match n {
        case .ident(let s): own(s)
        default: String.new()
    }
}

// `break;` / `continue;` (loop labels are not handled).
func emitJump(_ indent: Str, _ kw: Str) using Alloc, Log {
    print(indent)
    print(kw)
    print(";\n")
}

// `let`/`var` lower identically: an annotated binding keeps its C++ type, an
// inferred one uses `auto` (Vestra's immutability is not re-expressed in C++).
func emitBinding(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    if patIsTuple(pat) { emitTupleBinding(env, indent, pat, value); return }
    if valIsMatch(value) { emitMatchBinding(env, indent, pat, ty, value); return }
    if valIsVecLit(value) { emitVecLitBinding(env, indent, pat, ty, value); return }
    print(indent)
    if isFnTy(ty) || isIntrTy(ty) {
        // A function-typed (or §A8 @interrupt slot) binding needs the
        // declarator form `<res>(*<name>)(...)`.
        emitTypeWithName(ty, patName(pat))
    } else {
        if ty.len() > 0 { emitTypeBoxed(ty) } else { print("auto") }
        print(" ")
        print(patName(pat))
    }
    print(" = ")
    if isFnTy(ty) && valIsClosure(value) {
        // The annotation's function type supplies the lambda's parameter types.
        emitClosureWithFnTy(env, ty, value)
    } else {
        emitBindingValue(env, ty, value)
    }
    print(";\n")
    // Record the binding's type so later expressions can be inferred: an annotated
    // binding from its annotation, an inferred one from its initializer's type.
    if ty.len() > 0 {
        tyRegisterPat(&env, pat, ty)
    } else {
        tyAddSymSpelling(&env, patName(pat), tyInferBoxed(&env, value))
    }
}

func valIsMatch(_ v: Vec[Nd]) -> Bool {
    if v.len() == 0 { return false }
    return isMatchE(v.get(0) ?? Nd.wildcard)
}

func patIsTuple(_ pat: Vec[Nd]) -> Bool {
    if pat.len() == 0 { return false }
    return match pat.get(0) ?? Nd.wildcard {
        case .tupleP(let elems): true
        default: false
    }
}

// `let (a, b) = <expr>` lowers to a C++ structured binding: `auto [a, b] = <expr>;`.
// A wildcard element still owes a C++ binding name and mints
// `__vstr_tp_unused_<N>` on the file-global counter. C++ structured bindings
// are single-level, so a NESTED tuple element binds a `__vstr_tp<N>`
// placeholder (same counter) that a follow-on `auto [...] = __vstr_tp<N>;`
// unpacks right after, depth-first — the bootstrap's
// collect_tuple_pat_names / emit_tuple_pat_followons.
func emitTupleBinding(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    var fNames: Vec[String] = Vec.new()
    var fPats: Vec[Nd] = Vec.new()
    print(indent)
    print("auto [")
    emitNestedPatNames(env, pat.get(0) ?? Nd.wildcard, &fNames, &fPats)
    print("] = ")
    emitBoxed(env, value)
    print(";\n")
    emitTupleFollowons(env, indent, fNames, fPats)
    tyRegisterTuplePat(&env, pat.get(0) ?? Nd.wildcard, tyInferBoxed(&env, value))
}

func emitNestedPatNames(_ env: inout TyEnv, _ p: Nd, _ fNames: inout Vec[String], _ fPats: inout Vec[Nd]) using Alloc, Log {
    match p {
        case .tupleP(let elems): emitNestedPatNameList(env, elems, fNames, fPats)
        default: noop()
    }
}

func emitNestedPatNameList(_ env: inout TyEnv, _ elems: Vec[Nd], _ fNames: inout Vec[String], _ fPats: inout Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(", ") }
        let el = elems.get(i) ?? Nd.wildcard
        let nm = patNameOf(el)
        if !streq(nm, "") {
            print(nm)
        } else if patNodeIsTuple(el) {
            var ph: String = "__vstr_tp"
            ph.append(intToStr(env.tpN))
            env.tpN = env.tpN + 1
            print(ph)
            fNames.push(ph)
            fPats.push(el)
        } else {
            print("__vstr_tp_unused_")
            print(intToStr(env.tpN))
            env.tpN = env.tpN + 1
        }
        i = i + 1
    }
}

func patNodeIsTuple(_ p: Nd) -> Bool {
    return match p {
        case .tupleP(let elems): true
        default: false
    }
}

func emitTupleFollowons(_ env: inout TyEnv, _ indent: Str, _ fNames: Vec[String], _ fPats: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < fNames.len() {
        var subNames: Vec[String] = Vec.new()
        var subPats: Vec[Nd] = Vec.new()
        print(indent)
        print("auto [")
        emitNestedPatNames(env, fPats.get(i) ?? Nd.wildcard, &subNames, &subPats)
        print("] = ")
        print(fNames.get(i) ?? own(""))
        print(";\n")
        emitTupleFollowons(env, indent, subNames, subPats)
        i = i + 1
    }
}

// Each name of a destructuring pattern types as its element of the value's
// tuple spelling (nested tuple patterns recurse; wildcards bind nothing).
func tyRegisterTuplePat(_ env: inout TyEnv, _ p: Nd, _ sp: String) using Alloc {
    match p {
        case .tupleP(let elems): tyRegisterTupleElems(env, elems, sp)
        default: noop()
    }
}

func tyRegisterTupleElems(_ env: inout TyEnv, _ elems: Vec[Nd], _ sp: String) using Alloc {
    let parts = tyTupleParts(sp)
    if parts.len() != elems.len() { return }
    var i: Int = 0
    while i < elems.len() {
        let el = elems.get(i) ?? Nd.wildcard
        let et = own(parts.get(i) ?? own(""))
        let nm = patNameOf(el)
        if !streq(nm, "") { tyAddSymSpelling(env, nm, et) }
        else { tyRegisterTuplePat(env, el, et) }
        i = i + 1
    }
}

func emitTuplePatNames(_ env: inout TyEnv, _ p: Nd) using Alloc, Log {
    match p {
        case .tupleP(let elems): emitPatNameList(env, elems)
        default: noop()
    }
}

func emitPatNameList(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(", ") }
        let nm = patNameOf(elems.get(i) ?? Nd.wildcard)
        if streq(nm, "") {
            print("__vstr_tp_unused_")
            print(intToStr(env.tpN))
            env.tpN = env.tpN + 1
        } else {
            print(nm)
        }
        i = i + 1
    }
}

func valIsVecLit(_ v: Vec[Nd]) -> Bool {
    if v.len() == 0 { return false }
    return match v.get(0) ?? Nd.wildcard {
        case .vecLit(let elems): true
        default: false
    }
}

// An array-literal binding threads the annotation's ELEMENT type into the
// literal (`[3]Int32` elements emit as std::int32_t, not the inferred default).
func emitVecLitBinding(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    print(indent)
    if ty.len() > 0 { emitTypeBoxed(ty) } else { print("auto") }
    print(" ")
    print(patName(pat))
    print(" = ")
    let et = annElemBox(ty)
    emitVecLitVal(env, et, value)
    print(";\n")
    if ty.len() > 0 {
        tyRegisterPat(&env, pat, ty)
    } else {
        tyAddSymSpelling(&env, patName(pat), tyInferBoxed(&env, value))
    }
}

func emitVecLitVal(_ env: inout TyEnv, _ et: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    match value.get(0) ?? Nd.wildcard {
        case .vecLit(let elems): emitVecLit(env, elems, et)
        default: noop()
    }
}

// A match-valued binding is `<type-or-auto> <name> = <match lambda>;` — the
// lambda's return type comes from the annotation when present, else from the
// match's inferred arm type (already a C++ spelling via cppNamed).
func emitMatchBinding(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    print(indent)
    if ty.len() > 0 { emitTypeBoxed(ty) } else { print("auto") }
    print(" ")
    print(patName(pat))
    print(" = ")
    let sp = cppNamed(tyInferBoxed(env, value))
    emitMatchBindingVal(env, indent, ty, sp, value)
    print(";\n")
    if ty.len() > 0 {
        tyRegisterPat(&env, pat, ty)
    } else {
        tyAddSymSpelling(&env, patName(pat), tyInferBoxed(&env, value))
    }
}

func emitMatchBindingVal(_ env: inout TyEnv, _ indent: Str, _ ty: Vec[Nd], _ tyStr: Str, _ value: Vec[Nd]) using Alloc, Log {
    match value.get(0) ?? Nd.wildcard {
        case .matchE(let scrut, let arms): emitMatchValue(env, indent, ty, tyStr, scrut, arms)
        default: noop()
    }
}

// An annotated binding's initializer coerces into a String annotation. A
// `<Type>.new()` initializer constructs the ANNOTATION's C++ type directly:
// `var xs: Vec[Int32] = Vec.new()` -> `std::vector<std::int32_t> xs =
// std::vector<std::int32_t>{};` (the bare `Vec` carries no element type).
func emitBindingValue(_ env: inout TyEnv, _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    if ty.len() > 0 && tryEmitRawMint(env, tyAnnSpelling(ty), value) { return }
    if ty.len() > 0 && valIsDoCatch(value) {
        let tb = elemBoxCopy(ty)
        emitDoCatchValue(env, tb, value)
        return
    }
    if ty.len() > 0 && valIsNewCall(value) {
        emitTypeBoxed(ty)
        print("{}")
        return
    }
    if ty.len() > 0 && isGenericCtor(env, value) {
        emitGenericCtor(env, ty, value)
        return
    }
    let to = tyAnnSpelling(ty)
    if tryEmitLeadingDot(env, to, value) { return }
    // An annotated initializer binds a generic callee's result parameter, as
    // a return does (see emitReturnValue); scoped to this value.
    tyBindFromExpected(env, value, to)
    let from = tyInferBoxed(env, value)
    if needsStrCoercion(from, to) { emitMaybeCoerced(env, true, value) }
    else { emitMovedValue(env, value) }
    tyClearBinding(env)
}

func valIsNewCall(_ v: Vec[Nd]) using Alloc -> Bool {
    if v.len() == 0 { return false }
    return match v.get(0) ?? Nd.wildcard {
        case .call(let callee, let args): args.len() == 0 && calleeIsNew(callee)
        default: false
    }
}

func calleeIsNew(_ callee: Vec[Nd]) using Alloc -> Bool {
    if callee.len() == 0 { return false }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): !chain && streq(name, "new") && baseIsCapIdent(base)
        default: false
    }
}

func tyAddSymSpelling(_ env: inout TyEnv, _ name: String, _ sp: String) using Alloc {
    if !streq(sp, "") {
        env.symName.push(name)
        env.symType.push(sp)
    }
}

func emitAssign(_ env: inout TyEnv, _ indent: Str, _ op: Str, _ t: Vec[Nd], _ v: Vec[Nd]) using Alloc, Log {
    print(indent)
    emitBoxed(env, t)
    print(" ")
    print(op)
    print(" ")
    let to = tyInferBoxed(env, t)
    if !tryEmitLeadingDot(env, to, v) {
        let from = tyInferBoxed(env, v)
        emitMaybeCoerced(env, needsStrCoercion(from, to), v)
    }
    print(";\n")
}

func emitWhile(_ env: inout TyEnv, _ indent: Str, _ cond: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("while (")
    emitBoxed(env, cond)
    print(") {\n")
    if body.len() > 0 { emitBlockStmts(env, body.get(0) ?? Nd.wildcard, deeper(indent)) }
    print(indent)
    print("}\n")
}

// An expression statement is `<expr>;`, EXCEPT a statement-position `if` (an
// expression in Vestra) which lowers to the emitter's inline braced form with no
// trailing semicolon — see emitIfStmt.
// A `for v in <iter>` lowers two ways: a range `lo..<hi` / `lo..hi` becomes a
// C-style loop with a hoisted `__vstr_end` bound (`<` exclusive, `<=` inclusive),
// and any other iterable becomes a range-based `for (auto&& v : <iter>)`.
func emitFor(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ iter: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    tyRegisterForBinder(env, pat, iter)
    if forIsIterProto(env, iter) {
        emitIterProtoFor(env, indent, pat, iter, body)
        return
    }
    print(indent)
    print("for (")
    emitForHead(env, pat, iter)
    print(") {\n")
    if body.len() > 0 { emitBlockStmts(env, body.get(0) ?? Nd.wildcard, deeper(indent)) }
    print(indent)
    print("}\n")
}

// The loop variable types as the iterable's element, so a builtin method on
// it (`c.isDigit()`, `k.len()`, `field.toInt()`) takes the §18.5 lowering the
// bootstrap's resolver picks. Only a `Vec[T]` iterable is known here; a tuple
// element destructures through the same path `let (a, b) = …` uses.
func tyRegisterForBinder(_ env: inout TyEnv, _ pat: Vec[Nd], _ iter: Vec[Nd]) using Alloc {
    let el = tyIterElem(env, tyInferBoxed(env, iter))
    if streq(el, "") { return }
    if patIsTuple(pat) { tyRegisterTuplePat(env, pat.get(0) ?? Nd.wildcard, el) }
    else { tyAddSymSpelling(env, patName(pat), el) }
}

// §18.5 the iterator protocol: `for v in it` over a USER type (not a range,
// not a Vec/Span container) captures the iterable as a mutable local and
// drives while-true / .next() / break-on-nullopt. Only a KNOWN struct type
// takes this form on the vgen side — an unknown-typed iterable keeps the
// range-based lowering (the bootstrap resolves every type; vgen's spelling
// inference does not).
func forIsIterProto(_ env: inout TyEnv, _ iter: Vec[Nd]) using Alloc -> Bool {
    if iter.len() == 0 { return false }
    let isRange = match iter.get(0) ?? Nd.wildcard {
        case .binary(let op, let lo, let hi): streq(op, "..") || streq(op, "..<")
        default: false
    }
    if isRange { return false }
    let t = tyInferBoxed(env, iter)
    return tyIsStruct(env, t) || tyIsIterAdapter(t)
}

// A tuple loop variable (`for (i, j) in zip(a, b)`) binds by structured
// binding over the yielded value, as the bootstrap's iterator-protocol
// lowering does: `auto [i, j] = std::move(*__vstr_o);`.
func emitIterProtoFor(_ env: inout TyEnv, _ indent: Str, _ pat: Vec[Nd], _ iter: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("{ auto __vstr_iter = ")
    emitBoxed(env, iter)
    print("; while (true) { auto __vstr_o = __vstr_iter.next(); if (!__vstr_o.has_value()) { break; } auto ")
    emitForBinder(env, pat)
    print(" = std::move(*__vstr_o); {\n")
    if body.len() > 0 { emitBlockStmts(env, body.get(0) ?? Nd.wildcard, deeper(indent)) }
    print(indent)
    print("} } }\n")
}

func emitForHead(_ env: inout TyEnv, _ pat: Vec[Nd], _ iter: Vec[Nd]) using Alloc, Log {
    if iter.len() == 0 { return }
    match iter.get(0) ?? Nd.wildcard {
        case .binary(let op, let lo, let hi): emitForMaybeRange(env, pat, op, lo, hi, iter)
        default: emitForEach(env, pat, iter)
    }
}

// A range only ever binds a single counter, so it keeps the plain name; the
// tuple form cannot reach here (a range is not a tuple sequence).
func emitForMaybeRange(_ env: inout TyEnv, _ pat: Vec[Nd], _ op: Str, _ lo: Vec[Nd], _ hi: Vec[Nd], _ iter: Vec[Nd]) using Alloc, Log {
    let v = patName(pat)
    if streq(op, "..<") { emitForRange(env, v, lo, hi, true); return }
    if streq(op, "..") { emitForRange(env, v, lo, hi, false); return }
    emitForEach(env, pat, iter)
}

func emitForRange(_ env: inout TyEnv, _ v: Str, _ lo: Vec[Nd], _ hi: Vec[Nd], _ excl: Bool) using Alloc, Log {
    print("auto ")
    print(v)
    print(" = ")
    emitBoxed(env, lo)
    print(", __vstr_end = ")
    emitBoxed(env, hi)
    print("; ")
    print(v)
    if excl { print(" < ") } else { print(" <= ") }
    print("__vstr_end; ++")
    print(v)
}

// `for (k, v) in m.entries()` destructures each element, so the loop variable
// is a C++ STRUCTURED BINDING — `for (auto&& [k, v] : __vstr::map_entries(m))`.
// The name list is the same one `let (a, b) = …` builds, wildcards and all
// (a `_` element still owes a name and mints `__vstr_tp_unused_<N>`).
func emitForEach(_ env: inout TyEnv, _ pat: Vec[Nd], _ iter: Vec[Nd]) using Alloc, Log {
    print("auto&& ")
    emitForBinder(env, pat)
    print(" : ")
    emitBoxed(env, iter)
}

func emitForBinder(_ env: inout TyEnv, _ pat: Vec[Nd]) using Alloc, Log {
    if patIsTuple(pat) {
        print("[")
        emitTuplePatNames(env, pat.get(0) ?? Nd.wildcard)
        print("]")
        return
    }
    print(patName(pat))
}

func emitExprStmt(_ env: inout TyEnv, _ indent: Str, _ e: Vec[Nd]) using Alloc, Log {
    if e.len() == 0 { return }
    match e.get(0) ?? Nd.wildcard {
        case .ifE(let ln, let li, let cond, let thenB, let els): emitIfStmt(env, indent, ln, li, cond, thenB, els)
        case .matchE(let scrut, let arms): emitMatchStmt(env, indent, scrut, arms)
        case .throwE(let inner): emitThrowStmt(env, indent, inner)
        default: emitPlainExprStmt(env, indent, e)
    }
}

// §9 `throw e` at statement position ends the enclosing `throws(E)` function
// with the error value — the std::expected converting constructor does the
// wrapping: `return std::unexpected{<e>};`.
func emitThrowStmt(_ env: inout TyEnv, _ indent: Str, _ inner: Vec[Nd]) using Alloc, Log {
    print(indent)
    emitRetKw(env)
    print(" std::unexpected{")
    emitBoxed(env, inner)
    print("};\n")
}

// A statement-position match is the same immediately-invoked lambda with an
// `auto` return type, its value discarded.
func emitMatchStmt(_ env: inout TyEnv, _ indent: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print(indent)
    let noTy: Vec[Nd] = Vec.new()
    emitMatchValue(env, indent, noTy, "auto", scrut, arms)
    print(";\n")
}

func emitPlainExprStmt(_ env: inout TyEnv, _ indent: Str, _ e: Vec[Nd]) using Alloc, Log {
    print(indent)
    emitBoxed(env, e)
    print(";\n")
}

// The inline statement-`if`: `<indent>if (<cond>) { <then-stmts>}` then an
// optional ` else { <else-stmts>}` and a trailing newline. The branch statements
// are emitted with EMPTY indentation (the emitter opens the block inline and the
// closing braces sit at column 0), and no `;` follows. An if-LET (a non-empty
// bind name) tests-and-binds through the C++ init-statement form:
// `if (auto __vstr_opt = <init>; __vstr_opt.has_value()) { auto&& <n> =
// *__vstr_opt; <then-stmts>}` — the bound name registers as the init's
// optional-stripped type so the branch body infers.
func emitIfStmt(_ env: inout TyEnv, _ indent: Str, _ ln: Str, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print(indent)
    emitIfHead(env, ln, li, cond)
    if thenB.len() > 0 { emitBlockStmts(env, thenB.get(0) ?? Nd.wildcard, "") }
    print("}")
    if els.len() > 0 {
        print(" else { ")
        emitElse(env, els.get(0) ?? Nd.wildcard)
        print("}")
    }
    print("\n")
}

// The `if (...) { ` head every if lowering shares (statement, return and value
// position alike): `if (<cond>) { `, or for an if-let (a non-empty bind name)
// the init-statement test-and-bind
// `if (auto __vstr_opt = <init>; __vstr_opt.has_value()) { auto&& <n> = *__vstr_opt; `.
// The bound name registers as the init's optional-stripped type so the
// branch body infers.
func emitIfHead(_ env: inout TyEnv, _ ln: Str, _ li: Vec[Nd], _ cond: Vec[Nd]) using Alloc, Log {
    if streq(ln, "") {
        print("if (")
        emitBoxed(env, cond)
        print(") { ")
        return
    }
    print("if (auto __vstr_opt = ")
    emitBoxed(env, li)
    print("; __vstr_opt.has_value()) { auto&& ")
    print(ln)
    print(" = *__vstr_opt; ")
    let it = tyInferBoxed(env, li)
    tyAddSymSpelling(&env, own(ln), tyUnwrapOpt(it))
}

// The else branch is either a block or — for `else if` — another if, which the
// parser stores as a bare `ifE` rather than a block wrapping one. The bootstrap
// does NOT flatten the chain into `else if`; it nests, emitting
// `} else { if (c) { … } }` per level, so each level closes with its own brace.
// Emitting the nested if at indent "" puts it on the `} else { ` line, exactly
// where the reference has it.
func emitElse(_ env: inout TyEnv, _ e: Nd) using Alloc, Log {
    match e {
        case .block(let stmts): emitStmtList(env, stmts, "")
        case .ifE(let ln, let li, let cond, let thenB, let els): emitIfStmt(env, "", ln, li, cond, thenB, els)
        default: noop()
    }
}

func emitReturn(_ env: inout TyEnv, _ indent: Str, _ v: Vec[Nd]) using Alloc, Log {
    if v.len() > 0 && isMatchE(v.get(0) ?? Nd.wildcard) {
        emitReturnMatch(env, indent, v.get(0) ?? Nd.wildcard)
        return
    }
    if v.len() > 0 && isValueIfE(v.get(0) ?? Nd.wildcard) {
        emitReturnIfNode(env, indent, v.get(0) ?? Nd.wildcard)
        return
    }
    if valIsVecLit(v) {
        emitReturnVecLit(env, indent, v.get(0) ?? Nd.wildcard)
        return
    }
    print(indent)
    emitRetKw(env)
    if v.len() > 0 { print(" "); emitReturnValue(env, v) }
    else if env.curUnitThrows { print(" {}") }   // std::expected<void, E> success (F9b)
    print(";\n")
}

// §11 the function-level return keyword: `co_return` inside an async
// coroutine body, `return` otherwise. Lambda-internal returns (match / if
// value lambdas) print literally and are unaffected.
func emitRetKw(_ env: inout TyEnv) using Alloc, Log {
    if env.curAsync { print("co_return"); return }
    print("return")
}

func emitReturnValue(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc, Log {
    if valIsDoCatch(v) {
        let tb = elemBoxCopy(env.curRetNode)
        emitDoCatchValue(env, tb, v)
        return
    }
    if isGenericCtor(env, v) {
        let tb = elemBoxCopy(env.curRetNode)
        emitGenericCtor(env, tb, v)
        return
    }
    let to = own(env.curRet)
    if tryEmitRawMint(env, to, v) { return }
    if tryEmitLeadingDot(env, to, v) { return }
    // The binding lives only for this value's own call (cleared after, so a
    // later call to the same function elsewhere does not inherit it).
    tyBindFromExpected(env, v, to)
    let from = tyInferBoxed(env, v)
    let wrap = needsStrCoercion(from, to)
    emitMaybeCoerced(env, wrap, v)
    tyClearBinding(env)
}

// A construction of a GENERIC struct or enum needs the INSTANTIATED C++ type
// name, which the bare callee doesn't carry — it comes from the expected type
// (the binding annotation or the function's result type):
//   Pair(first: a, second: b)  ->  Pair<std::int32_t>{.first = a, .second = b}
//   Maybe.just(n)              ->  Maybe<std::int32_t>{Maybe<std::int32_t>::just_t{n}}
func isGenericCtor(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc -> Bool {
    if v.len() == 0 { return false }
    return match v.get(0) ?? Nd.wildcard {
        case .call(let callee, let args): isGenericCtorCall(env, callee, args)
        case .member(let base, let name, let chain): !chain && isGenTypeBase(env, base)
        default: false
    }
}

func isGenericCtorCall(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc -> Bool {
    if isStructCtor(callee, args) {
        let sn = identBaseName(callee)
        return tyIsGenType(env, sn)
    }
    if callee.len() == 0 { return false }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): !chain && isGenTypeBase(env, base)
        default: false
    }
}

func isGenTypeBase(_ env: inout TyEnv, _ base: Vec[Nd]) using Alloc -> Bool {
    let bn = identBaseName(base)
    if streq(bn, "") { return false }
    return tyIsGenType(env, bn)
}

func emitGenericCtor(_ env: inout TyEnv, _ tb: Vec[Nd], _ v: Vec[Nd]) using Alloc, Log {
    match v.get(0) ?? Nd.wildcard {
        case .call(let callee, let args): emitGenericCtorCall(env, tb, callee, args)
        case .member(let base, let name, let chain): emitGenericBareCase(env, tb, name)
        default: noop()
    }
}

func emitGenericCtorCall(_ env: inout TyEnv, _ tb: Vec[Nd], _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log {
    if isStructCtor(callee, args) {
        let sn = identBaseName(callee)
        let instSp = tyAnnSpelling(tb)
        emitTypeBoxed(tb)
        print("{")
        var i: Int = 0
        while i < args.len() {
            if i > 0 { print(", ") }
            emitGenCtorField(env, sn, instSp, args.get(i) ?? Nd.wildcard)
            i = i + 1
        }
        print("}")
        return
    }
    match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): emitGenericPayloadCase(env, tb, name, args)
        default: noop()
    }
}

func emitGenericPayloadCase(_ env: inout TyEnv, _ tb: Vec[Nd], _ caseName: Str, _ args: Vec[Nd]) using Alloc, Log {
    emitTypeBoxed(tb)
    print("{")
    emitTypeBoxed(tb)
    print("::")
    print(caseName)
    print("_t{")
    emitMovedArgList(env, args)
    print("}}")
}

func emitGenericBareCase(_ env: inout TyEnv, _ tb: Vec[Nd], _ caseName: Str) using Alloc, Log {
    let noArgs: Vec[Nd] = Vec.new()
    emitGenericPayloadCase(env, tb, caseName, noArgs)
}

// A returned array literal threads the function's `[N]T` result type into the
// literal's element type.
func emitReturnVecLit(_ env: inout TyEnv, _ indent: Str, _ m: Nd) using Alloc, Log {
    print(indent)
    print("return ")
    let et = retElemBox(env)
    emitReturnVecLitNode(env, et, m)
    print(";\n")
}

func retElemBox(_ env: inout TyEnv) using Alloc -> Vec[Nd] {
    if env.curRetNode.len() == 0 { return emptyNdBox() }
    return vecElemBox(env.curRetNode.get(0) ?? Nd.wildcard)
}

func emitReturnVecLitNode(_ env: inout TyEnv, _ et: Vec[Nd], _ m: Nd) using Alloc, Log {
    match m {
        case .vecLit(let elems): emitVecLit(env, elems, et)
        default: noop()
    }
}

func isMatchE(_ e: Nd) -> Bool {
    return match e {
        case .matchE(let scrut, let arms): true
        default: false
    }
}

// A value-position if (plain, with an else) — if-let stays on the general path.
func isValueIfE(_ e: Nd) -> Bool {
    return match e {
        case .ifE(let ln, let li, let cond, let thenB, let els): els.len() > 0
        default: false
    }
}

// `return if <c> { <a> } else { <b> }` lowers NOT to the value lambda but to a
// statement `if` whose branch tails return — the same inline-braced,
// column-0-closing shape as emitIfStmt:
//
//   if (<c>) { return <a>;
//   } else { return <b>;
//   }
//
// An else-if chain nests the same form inside the else block.
func emitReturnIfNode(_ env: inout TyEnv, _ indent: Str, _ m: Nd) using Alloc, Log {
    match m {
        case .ifE(let ln, let li, let cond, let thenB, let els): emitReturnIf(env, indent, ln, li, cond, thenB, els)
        default: noop()
    }
}

func emitReturnIf(_ env: inout TyEnv, _ indent: Str, _ ln: Str, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print(indent)
    emitIfHead(env, ln, li, cond)
    emitRetBlock(env, thenB)
    print("}")
    emitRetElse(env, els)
    print("\n")
}

func emitRetBlock(_ env: inout TyEnv, _ b: Vec[Nd]) using Alloc, Log {
    match b.get(0) ?? Nd.wildcard {
        case .block(let stmts): emitRetStmts(env, stmts)
        default: noop()
    }
}

// Branch statements at "" indent; the value-yielding trailing expression
// becomes `return <expr>;` with its newline (unlike the inline-lambda shape,
// the closing brace follows on the next line).
func emitRetStmts(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc, Log {
    let n = stmts.len()
    var i: Int = 0
    while i < n {
        let s = stmts.get(i) ?? Nd.wildcard
        if i == n - 1 {
            emitRetTail(env, s)
        } else {
            emitStmt(env, s, "")
        }
        i = i + 1
    }
}

func emitRetTail(_ env: inout TyEnv, _ s: Nd) using Alloc, Log {
    match s {
        case .exprS(let e): emitRetTailExpr(env, e)
        default: emitStmt(env, s, "")
    }
}

func emitRetTailExpr(_ env: inout TyEnv, _ e: Vec[Nd]) using Alloc, Log {
    if emitTryTail(env, e) { return }
    if emitThrowTail(env, e) { return }
    print("return ")
    emitBoxed(env, e)
    print(";\n")
}

// §9 a `try` in a returning-tail position (inside a cond-hoist lambda) emits
// the braced inline escape with the FIXED name __vstr_r — the whole escape is
// its own scope, so the name cannot collide across branches.
func emitTryTail(_ env: inout TyEnv, _ e: Vec[Nd]) using Alloc, Log -> Bool {
    if e.len() == 0 { return false }
    return match e.get(0) ?? Nd.wildcard {
        case .prefixE(let kw, let inner): emitTryTailParts(env, kw, inner)
        default: false
    }
}

// §9 a `throw E` arm body inside a cond-hoist lambda returns the error from
// the lambda (which returns std::expected<T, E>) — a lambda-internal
// `return`, never co_return.
func emitThrowTail(_ env: inout TyEnv, _ e: Vec[Nd]) using Alloc, Log -> Bool {
    if e.len() == 0 { return false }
    return match e.get(0) ?? Nd.wildcard {
        case .throwE(let inner): emitThrowTailParts(env, inner)
        default: false
    }
}

func emitThrowTailParts(_ env: inout TyEnv, _ inner: Vec[Nd]) using Alloc, Log -> Bool {
    print("return std::unexpected{")
    emitBoxed(env, inner)
    print("};\n")
    return true
}

func emitTryTailParts(_ env: inout TyEnv, _ kw: Str, _ inner: Vec[Nd]) using Alloc, Log -> Bool {
    if !streq(kw, "try ") { return false }
    print("{ auto __vstr_r = ")
    emitBoxed(env, inner)
    print("; if (!__vstr_r.has_value()) { return std::unexpected{__vstr_r.error()}; } return *__vstr_r; }\n")
    return true
}

func emitRetElse(_ env: inout TyEnv, _ els: Vec[Nd]) using Alloc, Log {
    if els.len() == 0 { return }
    match els.get(0) ?? Nd.wildcard {
        case .block(let stmts): emitRetElseBlock(env, stmts)
        case .ifE(let ln, let li, let cond, let thenB, let els2): emitRetElseIf(env, ln, li, cond, thenB, els2)
        default: noop()
    }
}

func emitRetElseBlock(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc, Log {
    print(" else { ")
    emitRetStmts(env, stmts)
    print("}")
}

func emitRetElseIf(_ env: inout TyEnv, _ ln: Str, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print(" else { ")
    emitReturnIf(env, "", ln, li, cond, thenB, els)
    print("}")
}

// `return match <scrut> { case .X: <body> ... }` over a payload-free enum lowers
// to an immediately-invoked lambda wrapping a switch:
//
//   return [&]() -> <retType> { switch (<scrut>) {
//       case <Enum>::<case>:
//           return <body>;
//       ...
//   } }();
//
// The scrutinee type (inferred) supplies the enum name that qualifies each case
// label. In return position the lambda's return type is the enclosing function's
// result type.
func emitReturnMatch(_ env: inout TyEnv, _ indent: Str, _ m: Nd) using Alloc, Log {
    match m {
        case .matchE(let scrut, let arms): emitReturnMatchParts(env, indent, scrut, arms)
        default: noop()
    }
}

func emitReturnMatchParts(_ env: inout TyEnv, _ indent: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print(indent)
    print("return ")
    let noTy: Vec[Nd] = Vec.new()
    emitMatchValue(env, indent, noTy, "", scrut, arms)
    print(";\n")
}

// A match in a nested EXPRESSION position — most often the body of an
// enclosing match arm (`case .str(let h): match needle { ... }`), since an arm
// body is a single expression. Two things differ from the statement-level
// positions above:
//
//   * The indent is the FIXED statement level, not the arm's column. The
//     bootstrap shapes the lowering with absolute `write_indent` calls, so a
//     match nested three scopes deep still lays its `using` / `if constexpr` /
//     closing `}, <scrut>.value)` lines out at the same columns a top-level one
//     would. Passing the enclosing indent down would drift from the reference.
//   * The lambda's result type is the nested match's OWN type (the bootstrap
//     reads `type_of(&m)`), not the enclosing function's result — so infer it
//     here rather than letting `emitMatchRetTy` fall back to `curRetNode`.
func emitNestedMatch(_ env: inout TyEnv, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    let sp = tyInferMatch(env, scrut, arms)
    let tyStr = nestedMatchTyStr(sp)
    let noTy: Vec[Nd] = Vec.new()
    emitMatchValue(env, "    ", noTy, tyStr, scrut, arms)
}

// A match with no inferable type (or a Unit one) types its lambda `auto`, the
// same fallback the bootstrap's `emit_match_result_type` takes.
func nestedMatchTyStr(_ sp: Str) using Alloc -> String {
    if streq(sp, "") || streq(sp, "Unit") { return own("auto") }
    return cppOfSpelling(own(sp))
}

// The lambda-expression core of a match lowering, shared by every position
// (return value, binding initializer, bare statement). Emits from `[&](` or
// `std::visit(` through the closing `()` — the caller prints whatever precedes
// (indent, `return `, `<type> <name> = `) and the trailing `;\n`. The `indent`
// still shapes the inner lines and closing brace, which sit at statement level
// in every position.
func emitMatchValue(_ env: inout TyEnv, _ indent: Str, _ ty: Vec[Nd], _ tyStr: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    // Publish the slot every ARM BODY flows into for the duration of this
    // lowering, so a leading-dot case in an arm can resolve against it. Saved
    // and restored around the emit: a nested match re-enters here and must not
    // leak its own arm slot back to the enclosing one.
    let prev = own(env.armTo)
    let slot = matchArmSlot(env, ty, tyStr)
    env.armTo = slot
    emitMatchValueParts(env, indent, ty, tyStr, scrut, arms)
    env.armTo = prev
}

// The Vestra type spelling an arm body flows into. A binding annotation gives
// it directly; in RETURN position (no annotation and no pre-computed C++
// spelling) it is the enclosing function's result. A statement-position match
// (`auto`) or one already typed from a C++ spelling — a nested match, which
// infers its own — has no Vestra spelling to offer, so arms there keep the
// untyped fallback.
func matchArmSlot(_ env: inout TyEnv, _ ty: Vec[Nd], _ tyStr: Str) using Alloc -> String {
    if ty.len() > 0 { return tyAnnSpelling(ty) }
    if streq(tyStr, "") { return own(env.curRet) }
    return own("")
}

// An arm body resolves a leading-dot case against the match's slot, then falls
// back to the ordinary expression emit.
func emitArmBody(_ env: inout TyEnv, _ body: Vec[Nd]) using Alloc, Log {
    let to = own(env.armTo)
    if tryEmitLeadingDot(env, to, body) { return }
    emitBoxed(env, body)
}

// A match on a NON-ENUM scrutinee — a Str, a number, a Bool, a tuple — cannot
// dispatch on cases, so the bootstrap lowers it to an IIFE that binds the
// scrutinee ONCE and walks an if/else-if chain of per-arm PREDICATES
// (cpp_emitter_match.cpp emit_match_value_scrutinee). vgen used to assume an
// enum unconditionally and emit `case <spelling>::<case>`, which for a Str
// scrutinee came out as the nonsense `case Str:::`.
//
// The dispatch mirrors the bootstrap's: anything whose scrutinee does not name
// a declared enum takes this path. That includes a scrutinee vgen FAILED to
// infer — the same fallback the bootstrap takes for an unresolved type, and
// better than the broken switch it produced before.
func emitValueMatch(_ env: inout TyEnv, _ indent: Str, _ ty: Vec[Nd], _ tyStr: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print("[&]() -> ")
    emitMatchRetTy(env, ty, tyStr)
    print(" {\n")
    let i8 = deeper(indent)
    print(i8)
    print("auto&& __vstr_m = ")
    emitBoxed(env, scrut)
    print(";\n")
    let i12 = deeper(i8)
    // A default / wildcard arm is pulled out to the tail wherever it sits; the
    // arms after it still join the chain, matching the bootstrap's walk.
    var di: Int = 0 - 1
    var k: Int = 0
    var j: Int = 0
    while j < arms.len() {
        if armIsDefault(arms.get(j) ?? Nd.wildcard) {
            di = j
        } else {
            emitValueArm(env, i8, i12, arms.get(j) ?? Nd.wildcard, k)
            k = k + 1
        }
        j = j + 1
    }
    if di >= 0 {
        emitValueDefault(env, i8, arms.get(di) ?? Nd.wildcard, k)
    } else {
        print(i8)
        if k == 0 { print("std::unreachable();\n") } else { print("else { std::unreachable(); }\n") }
    }
    print(indent)
    print("}()")
}

func emitValueArm(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ arm: Nd, _ k: Int) using Alloc, Log {
    match arm {
        case .matchArm(let isDef, let pat, let guard, let body): emitValueArmParts(env, i8, i12, pat, guard, body, k)
        default: noop()
    }
}

func emitValueArmParts(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ pat: Vec[Nd], _ guard: Vec[Nd], _ body: Vec[Nd], _ k: Int) using Alloc, Log {
    print(i8)
    if k == 0 { print("if (") } else { print("else if (") }
    emitPatPredicate(env, pat, "__vstr_m")
    if guard.len() > 0 {
        print(" && (")
        emitBoxed(env, guard)
        print(")")
    }
    print(") {\n")
    emitPatBindings(env, pat, "__vstr_m", i12)
    print(i12)
    print("return ")
    emitArmBody(env, body)
    print(";\n")
    print(i8)
    print("}\n")
}

// The trailing default. With no predicate arm ahead of it the chain never
// opened, so it emits a bare brace rather than `else`.
func emitValueDefault(_ env: inout TyEnv, _ i8: Str, _ arm: Nd, _ k: Int) using Alloc, Log {
    match arm {
        case .matchArm(let isDef, let pat, let guard, let body): emitValueDefaultParts(env, i8, body, k)
        default: noop()
    }
}

func emitValueDefaultParts(_ env: inout TyEnv, _ i8: Str, _ body: Vec[Nd], _ k: Int) using Alloc, Log {
    print(i8)
    if k == 0 { print("{ ") } else { print("else { ") }
    print("return ")
    emitArmBody(env, body)
    print("; }\n")
}

// The boolean test an arm's pattern makes against <base>. Always-match patterns
// (wildcard, plain binding) are `true`; the binding itself is emitted separately
// by emitPatBindings.
func emitPatPredicate(_ env: inout TyEnv, _ pat: Vec[Nd], _ base: Str) using Alloc, Log {
    if pat.len() == 0 { print("true"); return }
    emitPatPredicateNode(env, pat.get(0) ?? Nd.wildcard, base)
}

func emitPatPredicateNode(_ env: inout TyEnv, _ p: Nd, _ base: Str) using Alloc, Log {
    match p {
        case .litP(let lit): emitLitPred(env, base, lit)
        case .rangeP(let lo, let hi, let incl): emitRangePred(env, base, lo, hi, incl)
        case .orP(let alts): emitOrPred(env, base, alts)
        case .tupleP(let elems): emitTuplePred(env, base, elems)
        default: print("true")
    }
}

func emitLitPred(_ env: inout TyEnv, _ base: Str, _ lit: Vec[Nd]) using Alloc, Log {
    print("(")
    print(base)
    print(" == ")
    emitBoxed(env, lit)
    print(")")
}

func emitRangePred(_ env: inout TyEnv, _ base: Str, _ lo: Vec[Nd], _ hi: Vec[Nd], _ incl: Bool) using Alloc, Log {
    print("(")
    emitBoxed(env, lo)
    print(" <= ")
    print(base)
    print(" && ")
    print(base)
    if incl { print(" <= ") } else { print(" < ") }
    emitBoxed(env, hi)
    print(")")
}

func emitOrPred(_ env: inout TyEnv, _ base: Str, _ alts: Vec[Nd]) using Alloc, Log {
    print("(")
    var i: Int = 0
    while i < alts.len() {
        if i > 0 { print(" || ") }
        emitPatPredicateNode(env, alts.get(i) ?? Nd.wildcard, base)
        i = i + 1
    }
    print(")")
}

// Each element tests against `std::get<i>(<base>)`; an element-less tuple
// pattern degenerates to `(true)`.
func emitTuplePred(_ env: inout TyEnv, _ base: Str, _ elems: Vec[Nd]) using Alloc, Log {
    print("(")
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(" && ") }
        let sub = tupleSubBase(base, i)
        emitPatPredicateNode(env, elems.get(i) ?? Nd.wildcard, sub)
        i = i + 1
    }
    if elems.len() == 0 { print("true") }
    print(")")
}

func tupleSubBase(_ base: Str, _ i: Int) using Alloc -> String {
    var s: String = "std::get<"
    s.append(intToStr(i))
    s.append(">(")
    s.append(base)
    s.append(")")
    return s
}

// `auto&& <name> = <base>;` for every name the pattern introduces. Literal,
// range, or, and wildcard patterns introduce none; a tuple recurses into its
// elements at the SAME indent.
func emitPatBindings(_ env: inout TyEnv, _ pat: Vec[Nd], _ base: Str, _ ind: Str) using Alloc, Log {
    if pat.len() == 0 { return }
    emitPatBindingsNode(env, pat.get(0) ?? Nd.wildcard, base, ind)
}

func emitPatBindingsNode(_ env: inout TyEnv, _ p: Nd, _ base: Str, _ ind: Str) using Alloc, Log {
    match p {
        case .identP(let n): emitOnePatBinding(ind, n, base)
        case .bindP(let n): emitOnePatBinding(ind, n, base)
        case .tupleP(let elems): emitTupleBindings(env, elems, base, ind)
        default: noop()
    }
}

func emitTupleBindings(_ env: inout TyEnv, _ elems: Vec[Nd], _ base: Str, _ ind: Str) using Alloc, Log {
    var i: Int = 0
    while i < elems.len() {
        let sub = tupleSubBase(base, i)
        emitPatBindingsNode(env, elems.get(i) ?? Nd.wildcard, sub, ind)
        i = i + 1
    }
}

func emitOnePatBinding(_ ind: Str, _ n: Str, _ base: Str) using Alloc, Log {
    print(ind)
    print("auto&& ")
    print(n)
    print(" = ")
    print(base)
    print(";\n")
}

func emitMatchValueParts(_ env: inout TyEnv, _ indent: Str, _ ty: Vec[Nd], _ tyStr: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    let enumName = tyInferBoxed(env, scrut)
    if !tyIsEnumName(env, enumName) {
        emitValueMatch(env, indent, ty, tyStr, scrut, arms)
        return
    }
    // A guarded payload-free match cannot be a switch (a guard is a runtime
    // condition); it lowers to an if/else-if chain over the scrutinee.
    if !isPayloadEnum(env, enumName) && anyArmGuarded(arms) {
        emitGuardMatchValue(env, indent, ty, tyStr, enumName, scrut, arms)
        return
    }
    if isPayloadEnum(env, enumName) { emitVisitMatchValue(env, indent, ty, tyStr, enumName, scrut, arms); return }
    print("[&]() -> ")
    emitMatchRetTy(env, ty, tyStr)
    print(" { switch (")
    emitBoxed(env, scrut)
    print(") {\n")
    let armIndent = deeper(indent)
    var i: Int = 0
    while i < arms.len() {
        emitMatchArm(env, armIndent, enumName, arms.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print(indent)
    print("} }()")
}

// The lambda's C++ return type: a binding annotation (`ty`) when present, else
// an already-C++ spelling (`tyStr`, e.g. `auto` in statement position or an
// inferred scalar in an unannotated binding), else the enclosing function's
// result type (return position).
func emitMatchRetTy(_ env: inout TyEnv, _ ty: Vec[Nd], _ tyStr: Str) using Alloc, Log {
    if ty.len() > 0 { emitTypeBoxed(ty); return }
    if !streq(tyStr, "") { print(tyStr); return }
    emitTypeBoxed(env.curRetNode)
}

func anyArmGuarded(_ arms: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < arms.len() {
        if armGuarded(arms.get(i) ?? Nd.wildcard) { return true }
        i = i + 1
    }
    return false
}

func armGuarded(_ arm: Nd) -> Bool {
    return match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): guard.len() > 0
        default: false
    }
}

// A guarded payload-free match lowers to an if/else-if chain over a copy of the
// scrutinee:
//
//   [&]() -> <retType> {
//       auto&& __vstr_m = <scrut>;
//       if (__vstr_m == <Enum>::<case> && (<guard>)) {
//           return <body>;
//       }
//       else if (__vstr_m == <Enum>::<case>) { ... }
//       else { return <default>; }   // or `else { std::unreachable(); }`
//   }()
func emitGuardMatchValue(_ env: inout TyEnv, _ indent: Str, _ ty: Vec[Nd], _ tyStr: Str, _ enumName: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print("[&]() -> ")
    emitMatchRetTy(env, ty, tyStr)
    print(" {\n")
    let i8 = deeper(indent)
    print(i8)
    print("auto&& __vstr_m = ")
    emitBoxed(env, scrut)
    print(";\n")
    let i12 = deeper(i8)
    var k: Int = 0
    var di: Int = 0 - 1
    var j: Int = 0
    while j < arms.len() {
        if armIsDefault(arms.get(j) ?? Nd.wildcard) {
            di = j
        } else {
            emitGuardArm(env, i8, i12, enumName, arms.get(j) ?? Nd.wildcard, k)
            k = k + 1
        }
        j = j + 1
    }
    if di >= 0 {
        emitGuardDefault(env, i8, arms.get(di) ?? Nd.wildcard)
    } else {
        print(i8)
        print("else { std::unreachable(); }\n")
    }
    print(indent)
    print("}()")
}

func emitGuardArm(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ enumName: Str, _ arm: Nd, _ k: Int) using Alloc, Log {
    match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): emitGuardArmParts(env, i8, i12, enumName, pat, guard, body, k)
        default: noop()
    }
}

func emitGuardArmParts(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ enumName: Str, _ pat: Vec[Nd], _ guard: Vec[Nd], _ body: Vec[Nd], _ k: Int) using Alloc, Log {
    print(i8)
    if k == 0 { print("if (") } else { print("else if (") }
    if isOrPat(pat) { emitGuardOrPred(enumName, pat) }
    else {
        print("__vstr_m == ")
        print(enumName)
        print("::")
        print(armCaseName(pat))
    }
    if guard.len() > 0 {
        print(" && (")
        emitBoxed(env, guard)
        print(")")
    }
    print(") {\n")
    print(i12)
    print("return ")
    emitArmBody(env, body)
    print(";\n")
    print(i8)
    print("}\n")
}

// An or-pattern arm of the guard chain folds its alternatives into one `||`
// predicate; a non-enum alternative contributes `false`, as in the bootstrap.
func emitGuardOrPred(_ enumName: Str, _ pat: Vec[Nd]) using Alloc, Log {
    let alts = patAltList(pat)
    print("(")
    var i: Int = 0
    while i < alts.len() {
        if i > 0 { print(" || ") }
        let a = alts.get(i) ?? Nd.wildcard
        if isEnumPNode(a) {
            print("__vstr_m == ")
            print(enumName)
            print("::")
            print(altCaseName(a))
        } else {
            print("false")
        }
        i = i + 1
    }
    print(")")
}

func emitGuardDefault(_ env: inout TyEnv, _ i8: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): emitGuardDefaultParts(env, i8, body)
        default: noop()
    }
}

func emitGuardDefaultParts(_ env: inout TyEnv, _ i8: Str, _ body: Vec[Nd]) using Alloc, Log {
    print(i8)
    print("else { return ")
    emitArmBody(env, body)
    print("; }\n")
}

func emitMatchArm(_ env: inout TyEnv, _ armIndent: Str, _ enumName: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): emitMatchArmParts(env, armIndent, enumName, isDefault, pat, body)
        default: noop()
    }
}

// A `default:` / wildcard `case _:` arm lowers to a `default:` label; any other
// arm to its `case <Enum>::<case>:` label.
func emitMatchArmParts(_ env: inout TyEnv, _ armIndent: Str, _ enumName: Str, _ isDefault: Bool, _ pat: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(armIndent)
    if isDefault || isWildcardPat(pat) {
        print("default:\n")
    } else {
        // `case .a | .b:` stacks one label per alternative above the return.
        let alts = armEnumAlts(pat)
        var i: Int = 0
        while i < alts.len() {
            if i > 0 { print(armIndent) }
            print("case ")
            print(enumName)
            print("::")
            print(altCaseName(alts.get(i) ?? Nd.wildcard))
            print(":\n")
            i = i + 1
        }
    }
    print(deeper(armIndent))
    print("return ")
    emitArmBody(env, body)
    print(";\n")
}

func isWildcardPat(_ pat: Vec[Nd]) -> Bool {
    if pat.len() == 0 { return false }
    return match pat.get(0) ?? Nd.wildcard {
        case .wildcard: true
        default: false
    }
}

// `match <scrut> { case .C(let a, ...): <body> ... }` over a PAYLOAD enum lowers
// to a std::visit over the variant, with an `if constexpr` chain selecting the
// active alternative and binding its payload fields:
//
//   std::visit([&](auto&& __vstr_alt) -> <retType> {
//       using __vstr_alt_t = std::decay_t<decltype(__vstr_alt)>;
//       if constexpr (std::is_same_v<__vstr_alt_t, <Enum>::<C>_t>) {
//           {
//               auto&& a = __vstr_alt._0;
//               return <body>;
//           }
//       } else if constexpr (...) { ... } else { std::unreachable(); }
//   }, <scrut>.value)
func emitVisitMatchValue(_ env: inout TyEnv, _ indent: Str, _ ty: Vec[Nd], _ tyStr: Str, _ enumName: Str, _ scrut: Vec[Nd], _ arms: Vec[Nd]) using Alloc, Log {
    print("std::visit([&](auto&& __vstr_alt) -> ")
    emitMatchRetTy(env, ty, tyStr)
    print(" {\n")
    let i8 = deeper(indent)
    print(i8)
    print("using __vstr_alt_t = std::decay_t<decltype(__vstr_alt)>;\n")
    let i12 = deeper(i8)
    let i16 = deeper(i12)
    // Arms GROUP by case: each distinct case name (in arm order) forms one
    // if-constexpr branch holding every arm of that case as its own binding
    // scope. A guarded arm returns inside a runtime `if (<guard>)`, so control
    // can fall through to the case's next scope; a group whose LAST arm is
    // guarded falls back to the default arm's body after the scopes. A default
    // / wildcard arm becomes the trailing `else`, otherwise the chain ends in
    // `std::unreachable()`. (With no guards each case has one always-returning
    // scope, the degenerate chain this emitter always produced.)
    var di: Int = 0 - 1
    var j: Int = 0
    while j < arms.len() {
        if armIsDefault(arms.get(j) ?? Nd.wildcard) { di = j }
        j = j + 1
    }
    let caseNames = distinctCaseNames(arms)
    var k: Int = 0
    while k < caseNames.len() {
        if let cn = caseNames.get(k) {
            emitVisitGroup(env, i8, i12, i16, enumName, cn, arms, k, di)
        }
        k = k + 1
    }
    if di >= 0 {
        emitVisitDefault(env, i8, i12, arms.get(di) ?? Nd.wildcard)
    } else {
        print(i8)
        print("} else { std::unreachable(); }\n")
    }
    print(indent)
    print("}, ")
    emitBoxed(env, scrut)
    print(".value)")
}

// The distinct non-default case names, in order of first appearance.
func distinctCaseNames(_ arms: Vec[Nd]) using Alloc -> Vec[String] {
    var names: Vec[String] = Vec.new()
    var i: Int = 0
    while i < arms.len() {
        let a = arms.get(i) ?? Nd.wildcard
        if !armIsDefault(a) { pushArmCaseNames(&names, a) }
        i = i + 1
    }
    return names
}

// An or-pattern arm contributes each alternative's case, in order.
func pushArmCaseNames(_ names: inout Vec[String], _ arm: Nd) using Alloc {
    let alts = armAlts(arm)
    var i: Int = 0
    while i < alts.len() {
        let cn = altCaseName(alts.get(i) ?? Nd.wildcard)
        if !nameListHas(names, cn) { names.push(cn) }
        i = i + 1
    }
}

func armAlts(_ arm: Nd) using Alloc -> Vec[Nd] {
    return match arm {
        case .matchArm(let isDef, let pat, let guard, let body): armEnumAlts(pat)
        default: emptyNdBox()
    }
}

func nameListHas(_ xs: Vec[String], _ n: Str) -> Bool {
    var i: Int = 0
    while i < xs.len() {
        if let x = xs.get(i) { if streq(x, n) { return true } }
        i = i + 1
    }
    return false
}

// One case group: the if-constexpr branch header, a scope per arm of the case,
// and — when the last arm's guard can fail — the default body as fallback.
func emitVisitGroup(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ i16: Str, _ enumName: Str, _ cn: Str, _ arms: Vec[Nd], _ idx: Int, _ di: Int) using Alloc, Log {
    print(i8)
    if idx == 0 { print("if constexpr (std::is_same_v<__vstr_alt_t, ") }
    else { print("} else if constexpr (std::is_same_v<__vstr_alt_t, ") }
    print(cppOfSpelling(own(enumName)))
    print("::")
    print(cn)
    print("_t>) {\n")
    var lastGuarded: Bool = false
    var j: Int = 0
    while j < arms.len() {
        let a = arms.get(j) ?? Nd.wildcard
        if !armIsDefault(a) {
            if emitVisitScopes(env, i12, i16, enumName, cn, a) { lastGuarded = armGuarded(a) }
        }
        j = j + 1
    }
    if lastGuarded && di >= 0 {
        emitVisitFallback(env, i12, arms.get(di) ?? Nd.wildcard)
    }
}

// One scope per alternative of the arm that names case `cn` (an or-pattern
// arm shares its body across the cases it covers, each scope binding through
// its own alternative). True when any scope was emitted.
func emitVisitScopes(_ env: inout TyEnv, _ i12: Str, _ i16: Str, _ enumName: Str, _ cn: Str, _ arm: Nd) using Alloc, Log -> Bool {
    return match arm {
        case .matchArm(let isDef, let pat, let guard, let body): emitVisitAltScopes(env, i12, i16, enumName, cn, pat, guard, body)
        default: false
    }
}

func emitVisitAltScopes(_ env: inout TyEnv, _ i12: Str, _ i16: Str, _ enumName: Str, _ cn: Str, _ pat: Vec[Nd], _ guard: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log -> Bool {
    let alts = armEnumAlts(pat)
    var any: Bool = false
    var i: Int = 0
    while i < alts.len() {
        let alt = alts.get(i) ?? Nd.wildcard
        if streq(altCaseName(alt), cn) {
            var one: Vec[Nd] = Vec.new()
            one.push(alt)
            emitVisitScopeParts(env, i12, i16, enumName, one, guard, body)
            any = true
        }
        i = i + 1
    }
    return any
}

func emitVisitScopeParts(_ env: inout TyEnv, _ i12: Str, _ i16: Str, _ enumName: Str, _ pat: Vec[Nd], _ guard: Vec[Nd], _ body: Vec[Nd]) using Alloc, Log {
    print(i12)
    print("{\n")
    emitPayloadBindings(env, i16, enumName, pat)
    if guard.len() > 0 {
        print(i16)
        print("if (")
        emitBoxed(env, guard)
        print(") {\n")
        print(deeper(i16))
        print("return ")
        emitArmBody(env, body)
        print(";\n")
        print(i16)
        print("}\n")
    } else {
        print(i16)
        print("return ")
        emitArmBody(env, body)
        print(";\n")
    }
    print(i12)
    print("}\n")
}

func emitVisitFallback(_ env: inout TyEnv, _ i12: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDef, let pat, let guard, let body): emitVisitFallbackBody(env, i12, body)
        default: noop()
    }
}

func emitVisitFallbackBody(_ env: inout TyEnv, _ i12: Str, _ body: Vec[Nd]) using Alloc, Log {
    print(i12)
    print("return ")
    emitArmBody(env, body)
    print(";\n")
}

func armIsDefault(_ arm: Nd) -> Bool {
    return match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): isDefault || isWildcardPat(pat)
        default: false
    }
}

// The trailing `} else { return <body>; }` for a default / wildcard arm of a
// payload match (no inner scope block, unlike the if-constexpr arms).
func emitVisitDefault(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ arm: Nd) using Alloc, Log {
    match arm {
        case .matchArm(let isDefault, let pat, let guard, let body): emitVisitDefaultParts(env, i8, i12, body)
        default: noop()
    }
}

func emitVisitDefaultParts(_ env: inout TyEnv, _ i8: Str, _ i12: Str, _ body: Vec[Nd]) using Alloc, Log {
    print(i8)
    print("} else {\n")
    print(i12)
    print("return ")
    emitArmBody(env, body)
    print(";\n")
    print(i8)
    print("}\n")
}

// `auto&& <bind> = __vstr_alt.<field>;` for each payload binding in the pattern
// — <field> is the case's declared label when the payload field is named, else
// the positional `_<idx>`.
func emitPayloadBindings(_ env: inout TyEnv, _ i16: Str, _ enumName: Str, _ pat: Vec[Nd]) using Alloc, Log {
    match pat.get(0) ?? Nd.wildcard {
        case .enumP(let cname, let children): emitBindingList(env, i16, enumName, cname, children)
        default: noop()
    }
}

func emitBindingList(_ env: inout TyEnv, _ i16: Str, _ enumName: Str, _ cname: Str, _ children: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < children.len() {
        emitOneBinding(env, i16, enumName, cname, children.get(i) ?? Nd.wildcard, i)
        i = i + 1
    }
}

func emitOneBinding(_ env: inout TyEnv, _ i16: Str, _ enumName: Str, _ cname: Str, _ child: Nd, _ idx: Int) using Alloc, Log {
    if isTuplePNode(child) { emitTuplePayloadBinding(env, i16, enumName, cname, child, idx); return }
    let bn = patNameOf(child)
    if streq(bn, "") { return }
    // The binding takes the case's DECLARED field type, so everything typed on
    // a symbol's spelling — builtin-method dispatch (`s.len()` only lowers to
    // `.size()` once `s` is known to be a Str), String coercion, chained-call
    // inference — works on payload bindings the same as on a `let`. Registered
    // per function like every other symbol row; arm scopes are not modelled, so
    // a name reused across arms with different payload types would collide.
    let fty = tyPayFieldTy(env, enumName, cname, idx)
    tyAddSymSpelling(&env, own(bn), fty)
    print(i16)
    print("auto&& ")
    print(bn)
    print(" = __vstr_alt.")
    let fn = tyPayFieldName(env, enumName, cname, idx)
    if streq(fn, "") {
        print("_")
        print(intToStr(idx))
    } else {
        print(fn)
    }
    print(";\n")
}

// §6 a tuple-pattern payload child (`case .point((let x, let y))`) binds by
// structured binding off the payload field, `auto&& [x, y] = __vstr_alt.p;`,
// nested sub-tuples unpacking in follow-ons; the names type as the field's
// tuple elements.
func emitTuplePayloadBinding(_ env: inout TyEnv, _ i16: Str, _ enumName: Str, _ cname: Str, _ child: Nd, _ idx: Int) using Alloc, Log {
    var fNames: Vec[String] = Vec.new()
    var fPats: Vec[Nd] = Vec.new()
    print(i16)
    print("auto&& [")
    emitNestedPatNames(env, child, &fNames, &fPats)
    print("] = __vstr_alt.")
    let fn = tyPayFieldName(env, enumName, cname, idx)
    if streq(fn, "") {
        print("_")
        print(intToStr(idx))
    } else {
        print(fn)
    }
    print(";\n")
    emitTupleFollowons(env, i16, fNames, fPats)
    tyRegisterTuplePat(&env, child, tyPayFieldTy(env, enumName, cname, idx))
}

func isTuplePNode(_ p: Nd) -> Bool {
    return match p {
        case .tupleP(let elems): true
        default: false
    }
}

func armCaseName(_ pat: Vec[Nd]) using Alloc -> String {
    if pat.len() == 0 { return own("") }
    return match pat.get(0) ?? Nd.wildcard {
        case .enumP(let cname, let children): own(cname)
        default: own("")
    }
}

// §17.7 an arm's enum alternatives: `.a(x)` is the one-element list [.a(x)],
// `.a(x) | .b(x)` is [.a(x), .b(x)]. An or-pattern with any non-enum
// alternative (and any other pattern) has none, as in the bootstrap's
// all_enum test.
func armEnumAlts(_ pat: Vec[Nd]) using Alloc -> Vec[Nd] {
    let alts = patAltList(pat)
    if allEnumP(alts) { return alts }
    return Vec.new()
}

// The alternatives of an or-pattern, or the pattern itself as a one-element
// list.
func patAltList(_ pat: Vec[Nd]) using Alloc -> Vec[Nd] {
    if pat.len() == 0 { return Vec.new() }
    return match pat.get(0) ?? Nd.wildcard {
        case .orP(let alts): ndsCopy(alts)
        default: elemBoxCopy(pat)
    }
}

func ndsCopy(_ xs: Vec[Nd]) using Alloc -> Vec[Nd] {
    var out: Vec[Nd] = Vec.new()
    var i: Int = 0
    while i < xs.len() {
        out.push(xs.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    return out
}

func allEnumP(_ xs: Vec[Nd]) -> Bool {
    var i: Int = 0
    while i < xs.len() {
        if !isEnumPNode(xs.get(i) ?? Nd.wildcard) { return false }
        i = i + 1
    }
    return true
}

func isEnumPNode(_ p: Nd) -> Bool {
    return match p {
        case .enumP(let cname, let children): true
        default: false
    }
}

func isOrPat(_ pat: Vec[Nd]) -> Bool {
    if pat.len() == 0 { return false }
    return match pat.get(0) ?? Nd.wildcard {
        case .orP(let alts): true
        default: false
    }
}

func altCaseName(_ p: Nd) using Alloc -> String {
    return match p {
        case .enumP(let cname, let children): own(cname)
        default: own("")
    }
}

// The binding name of a simple `let`/`var` pattern (identifier or `let`-binding).
func patName(_ pat: Vec[Nd]) using Alloc -> String {
    if pat.len() == 0 { return own("") }
    return patNameOf(pat.get(0) ?? Nd.wildcard)
}

func patNameOf(_ p: Nd) using Alloc -> String {
    return match p {
        case .identP(let n): own(n)
        case .bindP(let n): own(n)
        default: own("")
    }
}

// One nesting level deeper (4 more spaces of indentation).
func deeper(_ indent: Str) using Alloc -> String {
    var s: String = own(indent)
    s.append("    ")
    return s
}

// §A12 (§14.6.3) prefix `&decl` is a plain C++ `&` over the operand (a
// function name taken as a value, or a global / static).
func emitAddrOf(_ env: inout TyEnv, _ x: Vec[Nd]) using Alloc, Log {
    print("&")
    emitBoxed(env, x)
}

// §17.1 `_` digit separators (`1_000`, `0xCAFE_BABE`) are stripped: C++
// would read `_BABE` as a user-defined literal suffix.
func emitIntText(_ t: Str) using Alloc, Log {
    var out: String = ""
    var i: Int = 0
    while i < t.len() {
        if (t.byteAt(i) ?? 0) != 95 { out.append(t.slice(i, i + 1)) }   // '_' == 95
        i = i + 1
    }
    print(out)
}

func emitBoxed(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc, Log {
    if v.len() > 0 { emitExpr(env, v.get(0) ?? Nd.wildcard) }
}

func emitExpr(_ env: inout TyEnv, _ e: Nd) using Alloc, Log {
    match e {
        case .ident(let n): print(n)
        case .nilLit: print("std::nullopt")
        case .selfE: print("(*this)")
        case .intLit(let s): emitIntText(s)
        case .floatLit(let s): print(s)
        case .boolLit(let b): emitBool(b)
        case .charLit(let s): emitChar(s)
        case .strLit(let s): emitStr(s)
        case .paren(let inner): emitParen(env, inner)
        case .unary(let op, let x): emitUnary(env, op, x)
        case .addrOf(let x): emitAddrOf(env, x)
        case .binary(let op, let l, let r): emitBinary(env, op, l, r)
        case .call(let callee, let args): emitCall(env, callee, args)
        case .member(let base, let name, let chain): emitMember(env, base, name, chain)
        case .index(let base, let idxs): emitIndex(env, base, idxs)
        case .ifE(let ln, let li, let cond, let thenB, let els): emitIfE(env, ln, li, cond, thenB, els)
        case .block(let stmts): emitBlockExpr(env, stmts)
        case .vecLit(let elems): emitVecLitNoTy(env, elems)
        case .tupleLit(let elems): emitTupleLit(env, elems)
        case .interpE(let parts, let exprs): emitInterp(env, parts, exprs)
        case .prefixE(let kw, let inner): emitPrefixE(env, kw, inner)
        case .matchE(let scrut, let arms): emitNestedMatch(env, scrut, arms)
        default: print("/*?expr*/")
    }
}

// §9 try forms in expression position. A propagating `try` consumes the next
// hoisted name (the statement's hoist pass already emitted the 3-line escape);
// with no hoist available it falls back to the `__vstr::unwrap_exp` panic —
// the bootstrap's safety net for contexts its hoist walk doesn't reach.
// `try!` always routes through the panic primitive; `try?` converts the
// std::expected to a std::optional via an IIFE. Other prefixes (copy / await /
// spawn) stay unlowered.
func emitPrefixE(_ env: inout TyEnv, _ kw: Str, _ inner: Vec[Nd]) using Alloc, Log {
    if streq(kw, "try ") {
        let nm = takeHoistName(&env)
        if !streq(nm, "") && isUnitTryBoxed(env, inner) { print("*"); print(nm); print("_r"); return }
        if !streq(nm, "") { print(nm); return }
        emitUnwrapExp(env, inner)
        return
    }
    if streq(kw, "try! ") { emitUnwrapExp(env, inner); return }
    if streq(kw, "try? ") {
        print("([&]{ auto __vstr_r = ")
        emitBoxed(env, inner)
        if isUnitTryBoxed(env, inner) {
            // A Unit callee has no value to wrap (F9b).
            print("; return __vstr_r.has_value() ? std::optional<std::monostate>{std::in_place} : std::nullopt; }())")
        } else {
            print("; return __vstr_r.has_value() ? std::optional{*__vstr_r} : std::nullopt; }())")
        }
        return
    }
    // `copy x` is a fresh value: C++23's decay-copy, as the bootstrap emits (F20).
    if streq(kw, "copy ") {
        print("auto(")
        emitBoxed(env, inner)
        print(")")
        return
    }
    if streq(kw, "await ") {
        print("co_await (")
        emitBoxed(env, inner)
        print(")")
        return
    }
    if streq(kw, "spawn ") {
        print("__vstr::spawn_future(")
        emitBoxed(env, inner)
        print(")")
        return
    }
    print("/*?expr*/")
}

func emitUnwrapExp(_ env: inout TyEnv, _ inner: Vec[Nd]) using Alloc, Log {
    print("__vstr::unwrap_exp(")
    emitBoxed(env, inner)
    print(")")
}

func takeHoistName(_ env: inout TyEnv) using Alloc -> String {
    if env.hoistNext >= env.hoistName.len() { return String.new() }
    let nm = env.hoistName.get(env.hoistNext) ?? own("")
    env.hoistNext = env.hoistNext + 1
    return nm
}

// `"a \(x) b"` -> `std::format("a {} b", x)`: each literal fragment joins the
// format string (its `{` / `}` doubled — std::format escape), each splice
// contributes a `{}` and one trailing argument. The lexer guarantees a
// fragment before, between, and after splices (possibly empty), so a `{}`
// precedes every fragment but the first.
func emitInterp(_ env: inout TyEnv, _ parts: Vec[String], _ exprs: Vec[Nd]) using Alloc, Log {
    print("std::format(\"")
    var i: Int = 0
    while i < parts.len() {
        if i > 0 { print("{}") }
        if let frag = parts.get(i) { print(fmtFragment(frag)) }
        i = i + 1
    }
    print("\"")
    var j: Int = 0
    while j < exprs.len() {
        print(", ")
        emitExpr(env, exprs.get(j) ?? Nd.wildcard)
        j = j + 1
    }
    print(")")
}

// A literal fragment with std::format's brace escaping applied.
func fmtFragment(_ s: Str) using Alloc -> String {
    var out: String = ""
    var i: Int = 0
    while i < s.len() {
        let c = s.byteAt(i) ?? 0
        if c == 123 { out.append("{{") }
        else if c == 125 { out.append("}}") }
        else { out.append(s.slice(i, i + 1)) }
        i = i + 1
    }
    return out
}

// `(e0, e1, ...)` -> `std::tuple{<e0>, <e1>, ...}` — CTAD deduces the element
// types, so the lowering is context-free.
func emitTupleLit(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc, Log {
    print("std::tuple{")
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(", ") }
        var eb: Vec[Nd] = Vec.new()
        eb.push(elems.get(i) ?? Nd.wildcard)
        emitMovedValue(env, eb)
        i = i + 1
    }
    print("}")
}

// `[e0, e1, ...]` -> `std::array<<elemT>, N>{<e0>, ...}`. The element type
// comes from the expected type when one is in hand (a binding annotation or
// the function's return type — the bootstrap threads it), else from the FIRST
// element's inferred type. A nested literal element threads the expected
// element type's own element.
func emitVecLit(_ env: inout TyEnv, _ elems: Vec[Nd], _ elemTy: Vec[Nd]) using Alloc, Log {
    // A function-pointer or §A8 @interrupt element keeps the bare brace list:
    // the declared target type supplies the shape, and each element (a bare
    // function name) decays to a pointer through it.
    if isFnTy(elemTy) || isIntrTy(elemTy) {
        print("{")
    } else {
        print("std::array<")
        if elemTy.len() > 0 { emitTypeBoxed(elemTy) } else { emitInferredElemTy(env, elems) }
        print(", ")
        print(intToStr(elems.len()))
        print(">{")
    }
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(", ") }
        emitVecElem(env, elems.get(i) ?? Nd.wildcard, elemTy)
        i = i + 1
    }
    print("}")
}

func emitVecLitNoTy(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc, Log {
    let noTy: Vec[Nd] = Vec.new()
    emitVecLit(env, elems, noTy)
}

func emitInferredElemTy(_ env: inout TyEnv, _ elems: Vec[Nd]) using Alloc, Log {
    if elems.len() == 0 { return }
    print(cppOfSpelling(tyInfer(env, elems.get(0) ?? Nd.wildcard)))
}

// The C++ spelling of an inferred type spelling: `[N]T` recurses into
// std::array, a generic instantiation `Name[A, B]` into `Name<A', B'>` (the
// builtin containers keeping their std:: mappings), anything else is the
// scalar mapping.
func cppOfSpelling(_ sp: String) using Alloc -> String {
    if tyIsTuple(sp) {
        let parts = tyTupleParts(sp)
        var t: String = "std::tuple<"
        var k: Int = 0
        while k < parts.len() {
            if k > 0 { t.append(", ") }
            t.append(cppOfSpelling(own(parts.get(k) ?? own(""))))
            k = k + 1
        }
        t.append(">")
        return t
    }
    if tyIsArray(sp) {
        var s: String = "std::array<"
        s.append(cppOfSpelling(tyArrayElem(sp)))
        s.append(", ")
        s.append(tyArrayCount(sp))
        s.append(">")
        return s
    }
    if spHasBracket(sp) { return cppGenericSpelling(sp) }
    return cppNamed(sp)
}

func spHasBracket(_ s: String) -> Bool {
    var i: Int = 0
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 91 { return true }   // '['
        i = i + 1
    }
    return false
}

// "Maybe[Int32]" -> "Maybe"; an array or plain spelling stays itself.
func genBaseOf(_ s: Str) using Alloc -> String {
    if s.len() == 0 { return own("") }
    if (s.byteAt(0) ?? 0) == 91 { return own(s) }
    var i: Int = 0
    while i < s.len() {
        if (s.byteAt(i) ?? 0) == 91 { return own(s.slice(0, i)) }
        i = i + 1
    }
    return own(s)
}

func cppGenericSpelling(_ sp: String) using Alloc -> String {
    let base = genBaseOf(sp)
    var s: String = ""
    if streq(base, "Vec") { s.append("std::vector<") }
    else if streq(base, "HashMap") { s.append("std::unordered_map<") }
    else if streq(base, "Box") { s.append("std::unique_ptr<") }
    else if streq(base, "Channel") { s.append("__vstr::Channel<") }
    else if streq(base, "Future") { s.append("__vstr::Future<") }
    else if streq(base, "Atomic") { s.append("std::atomic<") }
    else if streq(base, "Span") { s.append("std::span<const ") }
    else if streq(base, "MutSpan") { s.append("std::span<") }
    else if streq(base, "Padded") || streq(base, "PerCpu") || streq(base, "AtomicTaggedPointer")
        || streq(base, "MmioView") || streq(base, "MmioRegion") || streq(base, "MmioWireView") {
        s.append("__vstr::")
        s.append(base)
        s.append("<")
    }
    else {
        s.append(base)
        s.append("<")
    }
    s.append(cppArgsOfSpelling(tyBracketInner(sp)))
    s.append(">")
    return s
}

// "A, B" (bracket-depth-aware top-level split) with each argument mapped
// through cppOfSpelling.
func cppArgsOfSpelling(_ inner: Str) using Alloc -> String {
    var out: String = ""
    var start: Int = 0
    var depth: Int = 0
    var first: Bool = true
    var i: Int = 0
    while i < inner.len() {
        let c = inner.byteAt(i) ?? 0
        if c == 91 || c == 40 { depth = depth + 1 }   // '[' '('
        if c == 93 || c == 41 { depth = depth - 1 }   // ']' ')'

        if c == 44 && depth == 0 && (inner.byteAt(i + 1) ?? 0) == 32 {
            if !first { out.append(", ") }
            out.append(cppOfSpelling(own(inner.slice(start, i))))
            first = false
            start = i + 2
            i = i + 1
        }
        i = i + 1
    }
    if start < inner.len() {
        if !first { out.append(", ") }
        out.append(cppOfSpelling(own(inner.slice(start, inner.len()))))
    }
    return out
}

func emitVecElem(_ env: inout TyEnv, _ e: Nd, _ elemTy: Vec[Nd]) using Alloc, Log {
    match e {
        case .vecLit(let inner): emitNestedVecLit(env, inner, elemTy)
        default: emitExpr(env, e)
    }
}

func emitNestedVecLit(_ env: inout TyEnv, _ inner: Vec[Nd], _ elemTy: Vec[Nd]) using Alloc, Log {
    let et = annElemBox(elemTy)
    emitVecLit(env, inner, et)
}

// The boxed element-type node of a boxed `[N]T` type (empty otherwise).
func annElemBox(_ ty: Vec[Nd]) using Alloc -> Vec[Nd] {
    if ty.len() == 0 { return emptyNdBox() }
    return vecElemBox(ty.get(0) ?? Nd.wildcard)
}

func vecElemBox(_ t: Nd) using Alloc -> Vec[Nd] {
    return match t {
        case .vecT(let len, let elem): elemBoxCopy(elem)
        default: emptyNdBox()
    }
}

func elemBoxCopy(_ elem: Vec[Nd]) using Alloc -> Vec[Nd] {
    var b: Vec[Nd] = Vec.new()
    if elem.len() > 0 { b.push(elem.get(0) ?? Nd.wildcard) }
    return b
}

func emptyNdBox() using Alloc -> Vec[Nd] {
    return Vec.new()
}

// An if-expression in VALUE position lowers to a parenthesized, immediately-
// invoked lambda whose branches each return their own branch lambda's value:
//
//   ([&]{ if (<cond>) { return [&]{ <then> }(); } else { return <else>; } }())
//
// where a block <else> is another branch lambda and an else-if recurses into
// the same form (parens and all). An if-let takes the shared test-and-bind
// head. Else-less ifs (never values; sema rejects them) keep the /*?expr*/
// stub.
func emitIfE(_ env: inout TyEnv, _ ln: Str, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    if els.len() == 0 {
        print("/*?expr*/")
        return
    }
    emitIfValue(env, ln, li, cond, thenB, els)
}

func emitIfValue(_ env: inout TyEnv, _ ln: Str, _ li: Vec[Nd], _ cond: Vec[Nd], _ thenB: Vec[Nd], _ els: Vec[Nd]) using Alloc, Log {
    print("([&]{ ")
    emitIfHead(env, ln, li, cond)
    print("return ")
    emitIfBranchLambda(env, thenB)
    print("; } else { return ")
    emitIfElseValue(env, els)
    print("; } }())")
}

// A block in expression position (a `{ let x = ...; x + 1 }` match-arm body)
// lowers like the bootstrap's BlockExpr: an immediately-invoked lambda whose
// statements emit at column 0 and whose trailing expression is returned.
func emitBlockExpr(_ env: inout TyEnv, _ stmts: Vec[Nd]) using Alloc, Log {
    print("[&]{ ")
    emitClosureStmts(env, stmts, true)
    print(" }()")
}

// `[&]{ <branch stmts> }()` — the branch block as an invoked lambda, its
// trailing expression returned (the closure-body shape).
func emitIfBranchLambda(_ env: inout TyEnv, _ b: Vec[Nd]) using Alloc, Log {
    print("[&]{ ")
    match b.get(0) ?? Nd.wildcard {
        case .block(let stmts): emitClosureStmts(env, stmts, true)
        default: noop()
    }
    print(" }()")
}

func emitIfElseValue(_ env: inout TyEnv, _ els: Vec[Nd]) using Alloc, Log {
    match els.get(0) ?? Nd.wildcard {
        case .block(let stmts): emitIfBranchLambda(env, els)
        case .ifE(let ln, let li, let cond, let thenB, let els2): emitIfValue(env, ln, li, cond, thenB, els2)
        default: noop()
    }
}

// Indexing lowers to a subscript. Container bases (Vec / Span / MutSpan) take
// std::size_t in operator[], so the (signed) index is cast: `xs[i]` ->
// `xs[static_cast<std::size_t>(i)]`; a fixed-size `[N]T` array (std::array)
// indexes plainly — the bootstrap casts only container bases. (Single-index
// only.)
func emitIndex(_ env: inout TyEnv, _ base: Vec[Nd], _ idxs: Vec[Nd]) using Alloc, Log {
    let plainIdx = tyIsArray(tyInferBoxed(env, base))
    emitBoxed(env, base)
    print("[")
    if !plainIdx { print("static_cast<std::size_t>(") }
    emitBoxed(env, idxs)
    if !plainIdx { print(")") }
    print("]")
}

// Field / method access `base.name` lowers to `base.name`, EXCEPT a type-qualified
// access whose base is a capitalized identifier (an enum/type name) lowers to
// `Base::name` — this covers payload-free enum cases (`Color.red` -> `Color::red`).
// The capitalization heuristic stands in for the type info vgen lacks; values are
// lowercase by convention, so instance access is unaffected.
func emitMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str, _ chain: Bool) using Alloc, Log {
    if chain { emitChainMember(env, base, name); return }
    // §14.6.3 `p.address`: a pointer (or `&f`, a function pointer) as an
    // integer, as the bootstrap lowers it (F6).
    if streq(name, "address") && memberBaseIsPointer(env, base) {
        print("static_cast<std::uint64_t>(reinterpret_cast<std::uintptr_t>(")
        emitBoxed(env, base)
        print("))")
        return
    }
    // §10 a span's `.count` -> `static_cast<std::intptr_t>(s.size())` (signed,
    // comparable with Int indices) and `.isEmpty` -> `s.empty()`; §18.4 a chunk
    // iterator's `.count` -> `(cs).count()`.
    if streq(name, "count") || streq(name, "isEmpty") {
        let mbt = tyInferBoxed(env, base)
        if tyIsSpanSp(mbt) && streq(name, "count") {
            print("static_cast<std::intptr_t>(")
            emitBoxed(env, base)
            print(".size())")
            return
        }
        if tyIsSpanSp(mbt) {
            emitBoxed(env, base)
            print(".empty()")
            return
        }
        if tyStartsWith(mbt, "Chunks[") && streq(name, "count") {
            print("(")
            emitBoxed(env, base)
            print(").count()")
            return
        }
    }
    // §14.12 a typed system-register handle `Sysreg.<name>` is the runtime
    // singleton `__vstr::sysreg::<name>` (the bootstrap's resolver admits only
    // canonical names; a unit type named Sysreg would shadow it).
    if streq(identBaseName(base), "Sysreg") && !tyIsStruct(env, own("Sysreg")) && !tyIsEnumName(env, "Sysreg") {
        print("__vstr::sysreg::")
        print(name)
        return
    }
    // §3 `q.value` extracts an opaque newtype's underlying T via one static_cast.
    if streq(name, "value") {
        let bt = tyInferBoxed(env, base)
        // §10 Box[T]: `box.value` reads the heap pointee via `*box`; §A3 a
        // Ptr[T] / MutPtr[T] `p.value` dereferences the raw pointer the same
        // way (also as an assignment target).
        if tyStartsWith(bt, "Box[") || tyStartsWith(bt, "Ptr[") || tyStartsWith(bt, "MutPtr[") {
            print("(*")
            emitBoxed(env, base)
            print(")")
            return
        }
        if tyIsOpaque(env, bt) {
            print("static_cast<")
            emitType(tyOpaqueUnder(env, bt))
            print(">(")
            emitBoxed(env, base)
            print(")")
            return
        }
    }
    // §5 cross-module reference: a base naming an imported module qualifies
    // with `::` (`helper.LIMIT` -> `helper::LIMIT`).
    let mq = memberBaseImport(env, base)
    if !streq(mq, "") {
        print(mq)
        print("::")
        print(name)
        return
    }
    // A bare case of a payload-carrying enum constructs the variant:
    // `Shape.point` -> `Shape{Shape::point_t{}}`.
    let bn = identBaseName(base)
    if !streq(bn, "") && isPayloadEnum(env, bn) {
        emitPayloadCase(env, bn, name, Vec.new())
        return
    }
    // A payload-free enum case (or another capitalized type-qualified name) is
    // a scoped reference: `Color.red` -> `Color::red`.
    if baseIsCapIdent(base) {
        emitBoxed(env, base)
        print("::")
        print(name)
        return
    }
    emitBoxed(env, base)
    print(".")
    print(name)
}

// Optional-chain field access `base?.name` lowers to std::optional::transform:
// `base.transform([](auto&& __vstr_o) { return __vstr_o.<name>; })` — an
// engaged optional maps to the field, an empty one stays empty. When the base is
// an optional STRUCT whose field is itself declared optional, the hop flattens
// through `.and_then` instead (transform would nest `T??`), as the bootstrap's
// declared-field-type test does. The bootstrap's sema allows only a single
// field hop through `?.` (no method calls, no deeper member access), so this is
// the whole family.
func emitChainMember(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str) using Alloc, Log {
    let flatten = chainFieldIsOpt(env, tyInferBoxed(env, base), name)
    emitBoxed(env, base)
    if flatten { print(".and_then") } else { print(".transform") }
    print("([](auto&& __vstr_o) { return __vstr_o.")
    print(name)
    print("; })")
}

func chainFieldIsOpt(_ env: inout TyEnv, _ bt: String, _ name: Str) using Alloc -> Bool {
    let inner = tyUnwrapOpt(bt)
    if streq(inner, "") || !tyIsStruct(env, inner) { return false }
    let ft = tyFieldType(env, inner, own(name))
    return !streq(tyUnwrapOpt(ft), "")
}

// An enum whose declaration has at least one payload-carrying case (so it lowers
// to the struct + std::variant form rather than an `enum class`). A generic
// instantiation spelling (`Maybe[Int32]`) matches its declaration by base name.
func isPayloadEnum(_ env: inout TyEnv, _ name: Str) using Alloc -> Bool {
    let bn = genBaseOf(name)
    var k: Int = 0
    var isEnum: Bool = false
    while k < env.eName.len() {
        if let e = env.eName.get(k) { if streq(e, bn) { isEnum = true } }
        k = k + 1
    }
    if !isEnum { return false }
    var i: Int = 0
    while i < env.ecEnum.len() {
        if let en = env.ecEnum.get(i) {
            if streq(en, bn) && (env.ecArity.get(i) ?? 0) > 0 { return true }
        }
        i = i + 1
    }
    return false
}

func identBaseName(_ base: Vec[Nd]) using Alloc -> String {
    if base.len() == 0 { return own("") }
    return match base.get(0) ?? Nd.wildcard {
        case .ident(let n): own(n)
        default: own("")
    }
}

// §7 a LEADING-DOT case reference — `.plus`, or `.just(v)` in the call form —
// names no enum of its own. The bootstrap recovers one from the expression's
// RESOLVED type; vgen recovers it from the SLOT the value flows into, so `to`
// is that slot's Vestra type spelling. Returns false when there is nothing to
// key off (an unknown slot leaves the existing fallback in place) — every
// caller is a `tryEmit…` guard, never a commitment.
func tryEmitLeadingDot(_ env: inout TyEnv, _ to: Str, _ v: Vec[Nd]) using Alloc, Log -> Bool {
    if v.len() == 0 { return false }
    if streq(to, "") { return false }
    return match v.get(0) ?? Nd.wildcard {
        case .leadingDot(let n): tryEmitLeadingDotBare(env, to, n)
        case .call(let callee, let args): tryEmitLeadingDotCall(env, to, callee, args)
        default: false
    }
}

func tryEmitLeadingDotBare(_ env: inout TyEnv, _ to: Str, _ n: Str) using Alloc, Log -> Bool {
    let noArgs: Vec[Nd] = Vec.new()
    return tryEmitLeadingDotCase(env, to, n, noArgs)
}

func tryEmitLeadingDotCall(_ env: inout TyEnv, _ to: Str, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if callee.len() == 0 { return false }
    return match callee.get(0) ?? Nd.wildcard {
        case .leadingDot(let n): tryEmitLeadingDotCase(env, to, n, args)
        default: false
    }
}

// The three shapes, in the bootstrap's order (cpp_emitter.cpp ~5058):
//   * §A4 (§14.9.1) `Ordering` is not a user enum at all — its cases ARE the
//     `std::memory_order_*` literals, two of them snake_cased. Checked first,
//     since no declaration exists to look up.
//   * a payload-carrying (sum-type) enum takes the variant wrap, spelled with
//     the INSTANTIATED name when the slot carries generic arguments.
//   * a payload-free enum is a plain scoped reference off the DECLARED name.
func tryEmitLeadingDotCase(_ env: inout TyEnv, _ to: Str, _ n: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    let base = genBaseOf(to)
    if streq(base, "Ordering") { emitMemoryOrder(n); return true }
    // §A5 the prelude's payload-free builtin enums (`enum class BarrierScope`
    // and friends): a plain scoped reference, with no unit declaration to find.
    if streq(base, "BarrierScope") || streq(base, "BarrierKind") || streq(base, "TlbScope")
        || streq(base, "Endianness") {
        print(base)
        print("::")
        print(n)
        return true
    }
    if !tyIsEnumName(env, base) { return false }
    if isPayloadEnum(env, base) {
        let nm = cppOfSpelling(own(to))
        emitPayloadCase(env, nm, n, args)
        return true
    }
    print(base)
    print("::")
    print(n)
    return true
}

func emitMemoryOrder(_ n: Str) using Alloc, Log {
    print("std::memory_order_")
    if streq(n, "acqRel") { print("acq_rel"); return }
    if streq(n, "seqCst") { print("seq_cst"); return }
    print(n)   // relaxed / acquire / release spell identically
}

// Whether <name> names an enum declared in this unit (generic instantiations
// match by base name).
func tyIsEnumName(_ env: inout TyEnv, _ name: Str) using Alloc -> Bool {
    let bn = genBaseOf(name)
    var k: Int = 0
    while k < env.eName.len() {
        if let e = env.eName.get(k) { if streq(e, bn) { return true } }
        k = k + 1
    }
    return false
}

// `Enum{Enum::case_t{<args>}}` — variant construction for a payload-enum case
// (a bare case passes an empty argument list, yielding `{}`).
func emitPayloadCase(_ env: inout TyEnv, _ enumName: Str, _ caseName: Str, _ args: Vec[Nd]) using Alloc, Log {
    print(enumName)
    print("{")
    print(enumName)
    print("::")
    print(caseName)
    print("_t{")
    emitMovedArgList(env, args)
    print("}}")
}

func memberBaseIsPointer(_ env: inout TyEnv, _ base: Vec[Nd]) using Alloc -> Bool {
    if ndIsAddrOf(base) { return true }
    let bt = tyInferBoxed(env, base)
    return tyStartsWithStr(bt, "Ptr[") || tyStartsWithStr(bt, "MutPtr[")
}

func ndIsAddrOf(_ v: Vec[Nd]) -> Bool {
    if let n = v.get(0) {
        return match n {
            case .addrOf(let x): true
            case .paren(let x): ndIsAddrOf(x)
            default: false
        }
    }
    return false
}

func tyStartsWithStr(_ s: Str, _ prefix: Str) -> Bool {
    if prefix.len() > s.len() { return false }
    var i: Int = 0
    while i < prefix.len() {
        if (s.byteAt(i) ?? 0) != (prefix.byteAt(i) ?? 1) { return false }
        i = i + 1
    }
    return true
}

func baseIsCapIdent(_ base: Vec[Nd]) -> Bool {
    if base.len() == 0 { return false }
    return match base.get(0) ?? Nd.wildcard {
        case .ident(let n): isCapitalized(n)
        default: false
    }
}

// Capitalized, judged on the last `::` segment, so an imported module's type
// (`::kern::ipc::No`, see loadImports) counts like a local one.
func isCapitalized(_ n: Str) -> Bool {
    if n.len() == 0 { return false }
    var at: Int = 0
    var i: Int = 0
    while i + 1 < n.len() {
        if (n.byteAt(i) ?? 0) == 58 && (n.byteAt(i + 1) ?? 0) == 58 { at = i + 2 }   // "::"
        i = i + 1
    }
    let c = n.byteAt(at) ?? 0
    return c >= 65 && c <= 90   // 'A'..'Z'
}

func emitBool(_ b: Bool) using Log { if b { print("true") } else { print("false") } }

// A Char literal lowers to a char32_t literal: `'x'` -> `U'x'`.
func emitChar(_ s: Str) using Alloc, Log {
    print("U'")
    print(s)
    print("'")
}

// A string literal lowers to a string_view over its (already source-escaped) text.
func emitStr(_ s: Str) using Alloc, Log {
    print("std::string_view(\"")
    print(s)
    print("\")")
}

// A call emits the callee then a parenthesized, comma-separated argument list —
// unless it is struct construction (an identifier callee with labeled arguments),
// which lowers to designated initializers `Name{.field = value, ...}`. Labeled
// calls in the curated corpus are struct constructions; method calls have a
// member callee (not an identifier) and so never match.
func emitCall(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log {
    if tryEmitSysregWrite(env, callee, args) { return }
    if tryEmitRawCall(env, callee, args) { return }
    if tryEmitSysStatic(env, callee, args) { return }
    if tryEmitBoxNew(env, callee, args) { return }
    if tryEmitDeriveDefault(env, callee, args) { return }
    if tryEmitPayloadCase(env, callee, args) { return }
    if tryEmitImportCall(env, callee, args) { return }
    if tryEmitMapError(env, callee, args) { return }
    if tryEmitScalarCast(env, callee, args) { return }
    if tryEmitOpaqueCtor(env, callee, args) { return }
    if isStructCtor(callee, args) { emitStructCtor(env, callee, args); return }
    let fname = identBaseName(callee)
    if tryEmitPrint(env, fname, args) { return }
    if tryEmitBuiltin(env, fname, args) { return }
    if tryEmitBuiltinMethod(env, callee, args) { return }
    let owner = calleeMethodOwner(env, callee)
    if !streq(owner, "") {
        emitBoxed(env, callee)
        print("(")
        emitCallArgList(env, owner, calleeMemberName(callee), args)
        print(")")
        return
    }
    emitBoxed(env, callee)
    print("(")
    emitCallArgList(env, "", fname, args)
    print(")")
}

// ----- §A3 / §A6 raw memory (cpp_emitter.cpp, the CallExpr raw-mint block) --
// `Ptr.unchecked(fromAddress: a)` / `MutPtr.unchecked(...)` ->
// `reinterpret_cast<[const ]T*>(a)`. The bootstrap reads T off the call's
// resolved type; vgen knows it where the call is the whole initializer of an
// annotated binding or a returned value (`expected` is that slot's spelling),
// and otherwise spells the bootstrap's defensive `void`.
func tryEmitRawMint(_ env: inout TyEnv, _ expected: Str, _ value: Vec[Nd]) using Alloc, Log -> Bool {
    if value.len() == 0 { return false }
    return match value.get(0) ?? Nd.wildcard {
        case .call(let callee, let args): emitRawMintCall(env, expected, callee, args)
        default: false
    }
}

func emitRawMintCall(_ env: inout TyEnv, _ expected: Str, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    let ns = staticCalleeNs(callee, "unchecked")
    let isPtr = streq(ns, "Ptr")
    if !(isPtr || streq(ns, "MutPtr")) || args.len() != 1 { return false }
    var t: String = ""
    if tyStartsWith(own(expected), "Ptr[") || tyStartsWith(own(expected), "MutPtr[") {
        t = cppOfSpelling(tyBracketInner(own(expected)))
    }
    if streq(t, "") { t = own("void") }
    print("reinterpret_cast<")
    if isPtr { print("const ") }
    print(t)
    print("*>(")
    emitArg(env, args.get(0) ?? Nd.wildcard)
    print(")")
    return true
}

// `<Ns>.<member>` with a bare identifier namespace -> Ns, else "".
func staticCalleeNs(_ callee: Vec[Nd], _ member: Str) using Alloc -> String {
    if callee.len() == 0 { return own("") }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): nsIfMember(base, name, member)
        default: own("")
    }
}

func nsIfMember(_ base: Vec[Nd], _ name: Str, _ member: Str) using Alloc -> String {
    if !streq(name, member) { return own("") }
    return identBaseName(base)
}

// The rest of the raw-memory statics, each taking T from its pointer
// argument (the type the bootstrap's resolver derives the result from):
//   * `Span.raw(at: p, count: n)` / `MutSpan.raw(...)` ->
//     `std::span<[const ]T>(p, static_cast<std::size_t>(n))`
//   * `MmioView.at(p)` -> `__vstr::MmioView<T>{reinterpret_cast<T volatile*>(p)}`
//   * `MmioRegion.at(p, n)` -> `... , static_cast<std::intptr_t>(n)}`
//   * `MmioWireView.at(p, e)` -> `__vstr::MmioWireView<T>{..., <Endianness>}`
// plus `Ptr.unchecked` outside a typed slot (T unknown: `void`).
func tryEmitRawCall(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    let noTy: String = ""
    var box: Vec[Nd] = Vec.new()
    let rawNs = staticCalleeNs(callee, "raw")
    if (streq(rawNs, "Span") || streq(rawNs, "MutSpan")) && args.len() == 2 {
        print("std::span<")
        if streq(rawNs, "Span") { print("const ") }
        print(rawElemCpp(env, args))
        print(">(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(", static_cast<std::size_t>(")
        emitArg(env, args.get(1) ?? Nd.wildcard)
        print("))")
        return true
    }
    let atNs = staticCalleeNs(callee, "at")
    let isView = streq(atNs, "MmioView") && args.len() == 1
    let isRegion = streq(atNs, "MmioRegion") && args.len() == 2
    let isWire = streq(atNs, "MmioWireView") && args.len() == 2
    if isView || isRegion || isWire {
        let t = rawElemCpp(env, args)
        print("__vstr::")
        print(atNs)
        print("<")
        print(t)
        print(">{reinterpret_cast<")
        print(t)
        print(" volatile*>(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(")")
        if isRegion {
            print(", static_cast<std::intptr_t>(")
            emitArg(env, args.get(1) ?? Nd.wildcard)
            print(")")
        }
        if isWire {
            print(", ")
            emitSlotArg(env, "Endianness", args.get(1) ?? Nd.wildcard)
        }
        print("}")
        return true
    }
    let mintNs = staticCalleeNs(callee, "unchecked")
    if (streq(mintNs, "Ptr") || streq(mintNs, "MutPtr")) && args.len() == 1 {
        box.push(Nd.call(ndsCopy(callee), ndsCopy(args)))
        return tryEmitRawMint(env, noTy, box)
    }
    return false
}

// The C++ element type behind a raw-memory call's pointer argument
// (`p: MutPtr[UInt32]` -> `std::uint32_t`), `void` when unknown.
func rawElemCpp(_ env: inout TyEnv, _ args: Vec[Nd]) using Alloc -> String {
    let pt = tyInferArg(env, args)
    if tyStartsWith(pt, "Ptr[") || tyStartsWith(pt, "MutPtr[") { return cppOfSpelling(tyBracketInner(pt)) }
    return own("void")
}

// §14.12.3 a write to one of the six barrier-gated EL1 registers
// (`Sysreg.<reg>.write(v)`) routes through `__vstr::sysreg::write_<reg>(v)`,
// which issues the post-write barrier, unless the enclosing function carries
// `@no_auto_barrier` (read off the declaration's attributes).
func tryEmitSysregWrite(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if callee.len() == 0 || args.len() != 1 { return false }
    let reg = sysregWriteTarget(callee.get(0) ?? Nd.wildcard)
    if !isGatedSysreg(reg) { return false }
    if attrHas(env.curAttrs, "no_auto_barrier") { return false }
    print("__vstr::sysreg::write_")
    print(reg)
    print("(")
    emitArg(env, args.get(0) ?? Nd.wildcard)
    print(")")
    return true
}

// `Sysreg.<reg>.write` -> <reg>, else "".
func sysregWriteTarget(_ c: Nd) using Alloc -> String {
    return match c {
        case .member(let base, let name, let chain): sysregWriteOn(base, name, chain)
        default: own("")
    }
}

func sysregWriteOn(_ base: Vec[Nd], _ name: Str, _ chain: Bool) using Alloc -> String {
    if chain || !streq(name, "write") || base.len() == 0 { return own("") }
    return match base.get(0) ?? Nd.wildcard {
        case .member(let root, let reg, let c2): sysregRegOf(root, reg)
        default: own("")
    }
}

func sysregRegOf(_ root: Vec[Nd], _ reg: Str) using Alloc -> String {
    if !streq(identBaseName(root), "Sysreg") { return own("") }
    return own(reg)
}

// §14.12.3 the writes that get the post-write barrier: the sync_after_write
// rows of the bootstrap's target table (include/vestra/sema/sysregs.hpp).
func isGatedSysreg(_ r: Str) -> Bool {
    return streq(r, "sctlr_el1") || streq(r, "actlr_el1") || streq(r, "cpacr_el1")
        || streq(r, "vbar_el1") || streq(r, "ttbr0_el1") || streq(r, "ttbr1_el1")
        || streq(r, "tcr_el1") || streq(r, "mair_el1") || streq(r, "amair_el1")
        || streq(r, "contextidr_el1") || streq(r, "mdscr_el1") || streq(r, "icc_sre_el1")
        || streq(r, "icc_ctlr_el1") || streq(r, "icc_igrpen0_el1") || streq(r, "icc_igrpen1_el1")
}

// Static calls on two runtime namespaces, mirroring cpp_emitter.cpp:
//   * §A7 (§14.14) `Scheduler.swapContext(saving, loading)` ->
//     `__vstr::scheduler_swap_context(&saving, &loading)` (sema takes the
//     Context values; the shim wants pointers).
//   * §A11 (§14.8) `PerCpu.new(v)` -> `std::make_unique<__vstr::PerCpu<T>>(
//     __vstr::PerCpu<T>{v})`. The bootstrap reads T off the call's
//     Box[PerCpu[T]] type and falls back to the argument's; vgen has no
//     expected type at a call, so T is the argument's (as for Box.new).
func tryEmitSysStatic(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if callee.len() == 0 { return false }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): emitSysStaticOn(env, identBaseName(base), name, args)
        default: false
    }
}

func emitSysStaticOn(_ env: inout TyEnv, _ ns: Str, _ name: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if streq(ns, "Scheduler") && streq(name, "swapContext") && args.len() == 2 {
        print("__vstr::scheduler_swap_context(&")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(", &")
        emitArg(env, args.get(1) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(ns, "PerCpu") && streq(name, "new") && args.len() == 1 {
        let a = args.get(0) ?? Nd.wildcard
        var t: String = "__vstr::PerCpu<"
        t.append(cppOfSpelling(tyInferArg(env, args)))
        t.append(">")
        print("std::make_unique<")
        print(t)
        print(">(")
        print(t)
        print("{")
        emitArg(env, a)
        print("})")
        return true
    }
    return false
}

// §10 `Box.new(v)` -> `std::make_unique<T>(std::move(v))`, T the argument's
// type (the bootstrap peels the call's Box[T], which is the same type). The
// argument is always moved in: the box takes sole ownership, and a move of a
// temporary or a scalar is harmless.
func tryEmitBoxNew(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if args.len() != 1 { return false }
    if !isBoxNewCallee(callee) { return false }
    let at = tyInferArg(env, args)
    print("std::make_unique<")
    print(cppOfSpelling(at))
    print(">(std::move(")
    emitArgList(env, args)
    print("))")
    return true
}

func isBoxNewCallee(_ callee: Vec[Nd]) using Alloc -> Bool {
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): !chain && streq(name, "new") && streq(identBaseName(base), "Box")
        default: false
    }
}

// The inferred type of a call's sole argument ("" if unknown).
func tyInferArg(_ env: inout TyEnv, _ args: Vec[Nd]) using Alloc -> String {
    return match args.get(0) ?? Nd.wildcard {
        case .arg(let label, let isInout, let value): tyInferBoxed(env, value)
        default: own("")
    }
}

// §12.3 derive(Default) construction: `T.default()` lowers to `T{}`, C++
// value-init, which zero-initialises every field through the brace-init each
// field already carries. Gated on the base naming a STRUCT — sema has already
// checked that it derives Default and that every field conforms, so the
// codegen only has to spell the value.
func tryEmitDeriveDefault(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if args.len() > 0 { return false }
    if callee.len() == 0 { return false }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): tryEmitDefaultOf(env, base, name, chain)
        default: false
    }
}

func tryEmitDefaultOf(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str, _ chain: Bool) using Alloc, Log -> Bool {
    if chain { return false }
    if !streq(name, "default") { return false }
    let bn = identBaseName(base)
    if streq(bn, "") { return false }
    if !tyIsStruct(env, bn) { return false }
    print(bn)
    print("{}")
    return true
}

// §17.x conversion call: `Float64(i)` -> `static_cast<double>(i)` — a bare
// NUMERIC primitive name in callee position with exactly one argument
// (Bool/Char/Unit and the string kinds are excluded, matching the
// bootstrap's primitive_map filter; the primitive names are reserved, so no
// user function can shadow them).
func tryEmitScalarCast(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if args.len() != 1 { return false }
    let nm = identBaseName(callee)
    if !tyIsNumeric(nm) { return false }
    print("static_cast<")
    print(cppNamed(nm))
    print(">(")
    emitArgList(env, args)
    print(")")
    return true
}

// §3 opaque-type construction: `Q(t)` -> `static_cast<Q>(t)` over the
// `enum class Q : T {}` emission. Single positional argument (sema enforces).
func tryEmitOpaqueCtor(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if args.len() != 1 { return false }
    let nm = identBaseName(callee)
    if streq(nm, "") || !tyIsOpaque(env, nm) { return false }
    print("static_cast<")
    print(nm)
    print(">(")
    emitArgList(env, args)
    print(")")
    return true
}

// §9 `.mapError(f)` on a fallible call lifts the error type between throws
// functions: `(e).transform_error(f)` — one indirect call on the error path,
// zero on success. Dispatched by member NAME (a Result carries no type
// spelling on the vgen side); a user method named `mapError` is out of the
// mirrored subset. Closure-literal arguments are out of scope (their param
// types would need the error type, which vgen does not track).
func tryEmitMapError(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if args.len() != 1 { return false }
    if callee.len() == 0 { return false }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): emitMapErrorOn(env, base, name, chain, args)
        default: false
    }
}

// A closure argument takes the receiver's error type as its parameter and
// the enclosing function's error type as its result (a `try x.mapError(f)`
// propagates into that `throws(E)`), the types the bootstrap's resolver
// gives it; a function name or other value passes through.
func emitMapErrorOn(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str, _ chain: Bool, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if chain || !streq(name, "mapError") { return false }
    print("(")
    emitBoxed(env, base)
    print(").transform_error(")
    let a = args.get(0) ?? Nd.wildcard
    let errBox = vecElemOrEmpty(baseCallThrows(env, base))
    if argIsClosure(a) && errBox.len() > 0 && env.curThrowsNode.len() > 0 {
        let res = elemBoxCopy(env.curThrowsNode)
        emitClosureVal(env, argValue(a), errBox, res)
    } else {
        emitArgList(env, args)
    }
    print(")")
    return true
}

// The `throws(E)` node of the function a call receiver names, or wildcard.
func baseCallThrows(_ env: inout TyEnv, _ base: Vec[Nd]) using Alloc -> Nd {
    if base.len() == 0 { return Nd.wildcard }
    return match base.get(0) ?? Nd.wildcard {
        case .call(let callee, let cargs): tyFuncThrows(env, exCalleeNameBoxed(callee))
        default: Nd.wildcard
    }
}

func vecElemOrEmpty(_ n: Nd) using Alloc -> Vec[Nd] {
    var b: Vec[Nd] = Vec.new()
    if !isWildcardNode(n) { b.push(n) }
    return b
}

func argIsClosure(_ a: Nd) using Alloc -> Bool {
    return match a {
        case .arg(let label, let isInout, let val): valIsClosure(val)
        default: false
    }
}

func argValue(_ a: Nd) using Alloc -> Vec[Nd] {
    return match a {
        case .arg(let label, let isInout, let val): ndsCopy(val)
        default: emptyNdBox()
    }
}

// §5 a call through an imported-module qualifier. A Capitalized member is a
// cross-module STRUCT CONSTRUCTION (`helper.Point(x: a)` ->
// `helper::Point{.x = a}` — the import carries no field-type table, so no
// string coercion); anything else is a plain qualified call.
func tryEmitImportCall(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if callee.len() == 0 { return false }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): emitImportCallOn(env, base, name, chain, args)
        default: false
    }
}

func emitImportCallOn(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str, _ chain: Bool, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if chain { return false }
    let mq = memberBaseImport(env, base)
    if streq(mq, "") { return false }
    print(mq)
    print("::")
    print(name)
    if nameIsCapital(name) {
        emitImportCtorArgs(env, args)
        return true
    }
    print("(")
    emitArgList(env, args)
    print(")")
    return true
}

func emitImportCtorArgs(_ env: inout TyEnv, _ args: Vec[Nd]) using Alloc, Log {
    print("{")
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitImportCtorField(env, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print("}")
}

func emitImportCtorField(_ env: inout TyEnv, _ a: Nd) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitImportCtorFieldParts(env, label, val)
        default: noop()
    }
}

func emitImportCtorFieldParts(_ env: inout TyEnv, _ label: Str, _ val: Vec[Nd]) using Alloc, Log {
    print(".")
    print(label)
    print(" = ")
    emitBoxed(env, val)
}

func nameIsCapital(_ name: Str) -> Bool {
    let c = name.byteAt(0) ?? 0
    return c >= 65 && c <= 90
}

// The imported-module path a member BASE names — "" when the base is not a
// plain identifier, carries a local symbol type (a binding shadows the module
// qualifier), or matches no import.
func memberBaseImport(_ env: inout TyEnv, _ base: Vec[Nd]) using Alloc -> String {
    if base.len() == 0 { return own("") }
    let bn = identName(base.get(0) ?? Nd.ident(""))
    if streq(bn, "") { return own("") }
    if !streq(tySymType(env, bn), "") { return own("") }
    var i: Int = 0
    while i < env.imports.len() {
        if let m = env.imports.get(i) { if streq(m, bn) { return own(bn) } }
        i = i + 1
    }
    return own("")
}

// The owner type of a method callee `base.name` — the base expression's inferred
// type spelling. "" when the callee isn't a member access or the base type is
// unknown (including a capitalized type-qualified base like `Vec.new`, whose
// ident carries no symbol type).
func calleeMethodOwner(_ env: inout TyEnv, _ callee: Vec[Nd]) using Alloc -> String {
    if callee.len() == 0 { return own("") }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): tyInferBoxed(env, base)
        default: own("")
    }
}

func calleeMemberName(_ callee: Vec[Nd]) using Alloc -> String {
    if callee.len() == 0 { return own("") }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): own(name)
        default: own("")
    }
}

// §18.5 builtin container / string / numeric methods, dispatched on the BASE
// expression's inferred type spelling — Vec[...], HashMap[...], the string
// kinds, Char, and the numeric scalars. A user struct can never carry these
// spellings, so user methods are unaffected. Returns whether it emitted.
func tryEmitBuiltinMethod(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if callee.len() == 0 { return false }
    return match callee.get(0) ?? Nd.wildcard {
        case .member(let base, let name, let chain): emitBuiltinMethodOn(env, base, name, chain, args)
        default: false
    }
}

func emitBuiltinMethodOn(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str, _ chain: Bool, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if chain { return false }
    let bt = tyInferBoxed(env, base)
    if tyStartsWith(bt, "Vec[") { return emitVecMethod(env, base, bt, name, args) }
    if tyStartsWith(bt, "HashMap[") { return emitMapMethod(env, base, bt, name, args) }
    if streq(bt, "String") || streq(bt, "Str") || streq(bt, "StrConst") {
        return emitStrMethod(env, base, name, args, streq(bt, "String"))
    }
    if streq(bt, "Char") { return emitCharMethod(env, base, name, args) }
    if tyStartsWith(bt, "Atomic[") || tyStartsWith(bt, "AtomicTaggedPointer[") {
        return emitAtomicMethod(env, base, bt, name, args)
    }
    // §5 / §18.4 `s.split(at: i)` -> `__vstr::split_at(s, static_cast<std::intptr_t>(i))`;
    // `s.chunks(of: n)` -> `__vstr::Chunks{s, static_cast<std::size_t>(n)}`.
    if tyIsSpanSp(bt) && args.len() == 1 && (streq(name, "split") || streq(name, "chunks")) {
        let isSplit = streq(name, "split")
        if isSplit { print("__vstr::split_at(") } else { print("__vstr::Chunks{") }
        emitBoxed(env, base)
        if isSplit { print(", static_cast<std::intptr_t>(") } else { print(", static_cast<std::size_t>(") }
        emitArg(env, args.get(0) ?? Nd.wildcard)
        if isSplit { print("))") } else { print(")}") }
        return true
    }
    if tyIsNumericScalar(bt) && streq(name, "toString") && args.len() == 0 {
        print("__vstr::to_string(")
        emitBoxed(env, base)
        print(")")
        return true
    }
    return false
}

func atomicRetIsT(_ name: Str) -> Bool {
    return streq(name, "load") || streq(name, "exchange") || streq(name, "fetchAdd")
        || streq(name, "fetchSub") || streq(name, "fetchAnd") || streq(name, "fetchOr")
        || streq(name, "fetchXor")
}

// §A4 (§14.9) methods on an `Atomic[T]` / `AtomicTaggedPointer[T]` receiver,
// mirroring cpp_emitter.cpp. Every argument goes through an `Ordering` slot:
// the only enum-typed parameters here are memory orders (T is an integer,
// Bool or pointer), so a leading-dot argument (`.seqCst`) lowers to its
// `std::memory_order_*` literal and any other argument emits unchanged.
//   * Atomic `compareExchange` / `compareExchangeWeak(e, d, s, f)` -> an IIFE
//     over a local copy of `e`, returning `__vstr::CASResult<T>`.
//   * Atomic `fetchAdd` / `fetchSub` / `fetchAnd` / `fetchOr` / `fetchXor`
//     -> std::atomic's snake_case names.
//   * AtomicTaggedPointer `compareExchange` (5 args) -> a direct
//     `.compare_exchange_strong(...)` (the template returns the CASResult).
//   * anything else keeps its name.
func emitAtomicMethod(_ env: inout TyEnv, _ base: Vec[Nd], _ bt: Str, _ name: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    let isAtomic = tyStartsWith(own(bt), "Atomic[")
    let strong = streq(name, "compareExchange")
    let weak = streq(name, "compareExchangeWeak")
    if isAtomic && (strong || weak) && args.len() == 4 {
        let ct = cppOfSpelling(tyBracketInner(own(bt)))
        print("([&]{ ")
        print(ct)
        print(" __vstr_e = ")
        emitOrderingArg(env, args, 0)
        print("; bool __vstr_ok = ")
        emitBoxed(env, base)
        if strong { print(".compare_exchange_strong(__vstr_e, ") } else { print(".compare_exchange_weak(__vstr_e, ") }
        emitOrderingArg(env, args, 1)
        print(", ")
        emitOrderingArg(env, args, 2)
        print(", ")
        emitOrderingArg(env, args, 3)
        print("); return __vstr::CASResult<")
        print(ct)
        print(">{__vstr_ok, __vstr_e}; }())")
        return true
    }
    emitBoxed(env, base)
    print(".")
    if !isAtomic && strong && args.len() == 5 { print("compare_exchange_strong") }
    else if isAtomic { print(atomicCppName(name)) }
    else { print(name) }
    print("(")
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitOrderingArg(env, args, i)
        i = i + 1
    }
    print(")")
    return true
}

func atomicCppName(_ name: Str) using Alloc -> String {
    if streq(name, "fetchAdd") { return own("fetch_add") }
    if streq(name, "fetchSub") { return own("fetch_sub") }
    if streq(name, "fetchAnd") { return own("fetch_and") }
    if streq(name, "fetchOr") { return own("fetch_or") }
    if streq(name, "fetchXor") { return own("fetch_xor") }
    return own(name)
}

func emitOrderingArg(_ env: inout TyEnv, _ args: Vec[Nd], _ i: Int) using Alloc, Log {
    emitSlotArg(env, "Ordering", args.get(i) ?? Nd.wildcard)
}

func tyIsNumericScalar(_ s: String) -> Bool {
    return tyIsInt(s) || streq(s, "Float32") || streq(s, "Float64")
}

// One argument, coerced against a String-typed slot when needed (HashMap keys
// and values, Vec elements — the bootstrap's resolver marks these).
func emitSlotArg(_ env: inout TyEnv, _ to: Str, _ a: Nd) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitSlotArgVal(env, to, val)
        default: noop()
    }
}

func emitSlotArgVal(_ env: inout TyEnv, _ to: Str, _ val: Vec[Nd]) using Alloc, Log {
    if tryEmitLeadingDot(env, to, val) { return }
    let from = tyInferBoxed(env, val)
    emitMaybeCoerced(env, needsStrCoercion(from, to), val)
}

// `push(x)` -> .push_back; `len()` -> .size() as Int; `get(i)` / `pop()` ->
// the __vstr optional-returning helpers; `set(i, v)` -> a size_t-cast
// subscript assignment; `clear()` -> .clear().
func emitVecMethod(_ env: inout TyEnv, _ base: Vec[Nd], _ bt: Str, _ name: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if streq(name, "push") && args.len() == 1 {
        let elem = tyBracketInner(own(bt))
        emitBoxed(env, base)
        print(".push_back(")
        emitSlotArg(env, elem, args.get(0) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(name, "len") && args.len() == 0 {
        print("static_cast<std::intptr_t>(")
        emitBoxed(env, base)
        print(".size())")
        return true
    }
    if streq(name, "get") && args.len() == 1 {
        print("__vstr::vec_get(")
        emitBoxed(env, base)
        print(", ")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(name, "pop") && args.len() == 0 {
        print("__vstr::vec_pop(")
        emitBoxed(env, base)
        print(")")
        return true
    }
    if streq(name, "set") && args.len() == 2 {
        let elem = tyBracketInner(own(bt))
        emitBoxed(env, base)
        print("[static_cast<std::size_t>(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(")] = ")
        emitSlotArg(env, elem, args.get(1) ?? Nd.wildcard)
        return true
    }
    if streq(name, "clear") && args.len() == 0 {
        emitBoxed(env, base)
        print(".clear()")
        return true
    }
    return false
}

// `set(k, v)` -> .insert_or_assign; `get(k)` -> __vstr::map_get (optional V);
// `contains(k)` -> .contains; `len()` -> .size() as Int; keys/values/entries
// -> the owned-Vec __vstr helpers. Key / value arguments coerce against the
// map's declared K / V.
func emitMapMethod(_ env: inout TyEnv, _ base: Vec[Nd], _ bt: Str, _ name: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if streq(name, "set") && args.len() == 2 {
        let k = mapKeySpelling(own(bt))
        let v = mapValSpelling(own(bt))
        emitBoxed(env, base)
        print(".insert_or_assign(")
        emitSlotArg(env, k, args.get(0) ?? Nd.wildcard)
        print(", ")
        emitSlotArg(env, v, args.get(1) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(name, "get") && args.len() == 1 {
        let k = mapKeySpelling(own(bt))
        print("__vstr::map_get(")
        emitBoxed(env, base)
        print(", ")
        emitSlotArg(env, k, args.get(0) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(name, "contains") && args.len() == 1 {
        let k = mapKeySpelling(own(bt))
        emitBoxed(env, base)
        print(".contains(")
        emitSlotArg(env, k, args.get(0) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(name, "len") && args.len() == 0 {
        print("static_cast<std::intptr_t>(")
        emitBoxed(env, base)
        print(".size())")
        return true
    }
    if streq(name, "keys") && args.len() == 0 { return emitMapIter(env, base, "__vstr::map_keys(") }
    if streq(name, "values") && args.len() == 0 { return emitMapIter(env, base, "__vstr::map_values(") }
    if streq(name, "entries") && args.len() == 0 { return emitMapIter(env, base, "__vstr::map_entries(") }
    return false
}

func emitMapIter(_ env: inout TyEnv, _ base: Vec[Nd], _ fn: Str) using Alloc, Log -> Bool {
    print(fn)
    emitBoxed(env, base)
    print(")")
    return true
}

// "HashMap[K, V]" -> "K" / "V" (split at the first top-level ", "; nested
// generic keys are out of scope for the coercion check).
func mapKeySpelling(_ bt: String) using Alloc -> String {
    let inner = tyBracketInner(bt)
    var i: Int = 0
    while i + 1 < inner.len() {
        if (inner.byteAt(i) ?? 0) == 44 && (inner.byteAt(i + 1) ?? 0) == 32 { return own(inner.slice(0, i)) }
        i = i + 1
    }
    return own("")
}

func mapValSpelling(_ bt: String) using Alloc -> String {
    let inner = tyBracketInner(bt)
    var i: Int = 0
    while i + 1 < inner.len() {
        if (inner.byteAt(i) ?? 0) == 44 && (inner.byteAt(i + 1) ?? 0) == 32 { return own(inner.slice(i + 2, inner.len())) }
        i = i + 1
    }
    return own("")
}

// The String / Str / StrConst read queries share one lowering (the __vstr
// helpers take a string_view; std::string converts implicitly); `append` is
// the owned-String mutator.
func emitStrMethod(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str, _ args: Vec[Nd], _ owned: Bool) using Alloc, Log -> Bool {
    if owned && streq(name, "append") && args.len() == 1 {
        emitBoxed(env, base)
        print(".append(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(name, "len") && args.len() == 0 {
        print("static_cast<std::intptr_t>(")
        emitBoxed(env, base)
        print(".size())")
        return true
    }
    if streq(name, "isEmpty") && args.len() == 0 {
        emitBoxed(env, base)
        print(".empty()")
        return true
    }
    if streq(name, "slice") && args.len() == 2 {
        print("__vstr::str_slice(")
        emitBoxed(env, base)
        print(", static_cast<std::intptr_t>(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print("), static_cast<std::intptr_t>(")
        emitArg(env, args.get(1) ?? Nd.wildcard)
        print("))")
        return true
    }
    if streq(name, "byteAt") && args.len() == 1 { return emitStrIdxHelper(env, base, "__vstr::str_byte_at(", args) }
    if streq(name, "charAt") && args.len() == 1 { return emitStrIdxHelper(env, base, "__vstr::char_at(", args) }
    if streq(name, "find") && args.len() == 1 { return emitStrArgHelper(env, base, "__vstr::str_find(", args) }
    if streq(name, "split") && args.len() == 1 { return emitStrArgHelper(env, base, "__vstr::split(", args) }
    if streq(name, "toInt") && args.len() == 0 {
        print("__vstr::parse_int(")
        emitBoxed(env, base)
        print(")")
        return true
    }
    if streq(name, "chars") && args.len() == 0 {
        print("__vstr::chars(")
        emitBoxed(env, base)
        print(")")
        return true
    }
    if streq(name, "contains") && args.len() == 1 { return emitStrMember(env, base, ".contains(", args) }
    if streq(name, "startsWith") && args.len() == 1 { return emitStrMember(env, base, ".starts_with(", args) }
    if streq(name, "endsWith") && args.len() == 1 { return emitStrMember(env, base, ".ends_with(", args) }
    return false
}

// `<helper>(<base>, static_cast<std::intptr_t>(<arg>))` — the index-taking
// string helpers.
func emitStrIdxHelper(_ env: inout TyEnv, _ base: Vec[Nd], _ fn: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    print(fn)
    emitBoxed(env, base)
    print(", static_cast<std::intptr_t>(")
    emitArg(env, args.get(0) ?? Nd.wildcard)
    print("))")
    return true
}

func emitStrArgHelper(_ env: inout TyEnv, _ base: Vec[Nd], _ fn: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    print(fn)
    emitBoxed(env, base)
    print(", ")
    emitArg(env, args.get(0) ?? Nd.wildcard)
    print(")")
    return true
}

func emitStrMember(_ env: inout TyEnv, _ base: Vec[Nd], _ m: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    emitBoxed(env, base)
    print(m)
    emitArg(env, args.get(0) ?? Nd.wildcard)
    print(")")
    return true
}

// The four ASCII Char predicates -> the matching __vstr::is_* helper.
func emitCharMethod(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if args.len() != 0 { return false }
    if streq(name, "isDigit") { return emitCharPred(env, base, "__vstr::is_digit(") }
    if streq(name, "isAlpha") { return emitCharPred(env, base, "__vstr::is_alpha(") }
    if streq(name, "isAlnum") { return emitCharPred(env, base, "__vstr::is_alnum(") }
    if streq(name, "isSpace") { return emitCharPred(env, base, "__vstr::is_space(") }
    return false
}

func emitCharPred(_ env: inout TyEnv, _ base: Vec[Nd], _ fn: Str) using Alloc, Log -> Bool {
    print(fn)
    emitBoxed(env, base)
    print(")")
    return true
}

// The remaining §18 builtins, each lowering to its __vstr runtime shim.
// `panic`/`abort`/`unreachable` intercept unconditionally on name + arity
// (mirroring the bootstrap emitter); `readFile`/`writeFile`/`args` only when no
// unit-defined function shadows the name.
func tryEmitBuiltin(_ env: inout TyEnv, _ fname: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if streq(fname, "panic") && args.len() == 1 {
        print("__vstr::panic(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(fname, "abort") && args.len() == 0 {
        print("__vstr::abort_fn()")
        return true
    }
    if streq(fname, "unreachable") && args.len() == 0 {
        print("__vstr::unreachable_fn()")
        return true
    }
    if emitSyncIntrinsic(env, fname, args) { return true }
    if emitMemIntrinsic(env, fname, args) { return true }
    if tyArity(env, fname) >= 0 { return false }
    if emitAdapter(env, fname, args) { return true }
    if emitParallel(env, fname, args) { return true }
    if streq(fname, "readFile") && args.len() == 1 {
        print("__vstr::read_file(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(fname, "writeFile") && args.len() == 2 {
        print("__vstr::write_file(")
        emitArg(env, args.get(0) ?? Nd.wildcard)
        print(", ")
        emitArg(env, args.get(1) ?? Nd.wildcard)
        print(")")
        return true
    }
    if streq(fname, "args") && args.len() == 0 {
        print("__vstr::args()")
        return true
    }
    return false
}

// §A5 (§14.10) the sync, cache and TLB intrinsics: `__vstr::<name>(args)`,
// with `nop` -> `cpu_nop` (the bare name collides on the C++ side). Matched on
// the callee NAME alone, as the bootstrap's table is. Each argument takes its
// builtin parameter type (resolver_builtins.cpp), so a leading-dot Ordering /
// BarrierScope / BarrierKind / TlbScope case lowers to its C++ spelling.
func emitSyncIntrinsic(_ env: inout TyEnv, _ fname: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    let cn = syncIntrinsicCpp(fname)
    if streq(cn, "") { return false }
    print("__vstr::")
    print(cn)
    print("(")
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitSlotArg(env, syncParamType(fname, i), args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print(")")
    return true
}

// §9 the combinators construct the runtime adapter by CTAD:
// `__vstr::Zip{a, b}`, `__vstr::Take{xs, static_cast<std::int64_t>(n)}`,
// `__vstr::Map{xs, f}`, `__vstr::Filter{xs, f}`. A closure argument of map /
// filter takes its parameter type from the iterable's element type.
func emitAdapter(_ env: inout TyEnv, _ fname: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if args.len() != 2 { return false }
    let isTake = streq(fname, "take")
    let isFn = streq(fname, "map") || streq(fname, "filter")
    if !(isTake || isFn || streq(fname, "zip")) { return false }
    print("__vstr::")
    if streq(fname, "zip") { print("Zip") } else if isTake { print("Take") }
    else if streq(fname, "map") { print("Map") } else { print("Filter") }
    print("{")
    emitArg(env, args.get(0) ?? Nd.wildcard)
    print(", ")
    if isTake {
        print("static_cast<std::int64_t>(")
        emitArg(env, args.get(1) ?? Nd.wildcard)
        print(")")
    } else if isFn {
        let elem = tyIterElem(env, tyInferArg(env, args))
        emitElemClosureArg(env, elem, args.get(1) ?? Nd.wildcard, true)
    } else {
        emitArg(env, args.get(1) ?? Nd.wildcard)
    }
    print("}")
    return true
}

// §11.2 `parallel(data, chunks, body)` -> `__vstr::parallel(data,
// static_cast<std::intptr_t>(chunks), body)`, the runtime splitting `data`
// into disjoint sub-spans. A closure body takes the data span's own type for
// its parameter and yields nothing.
func emitParallel(_ env: inout TyEnv, _ fname: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if !streq(fname, "parallel") || args.len() != 3 { return false }
    print("__vstr::parallel(")
    emitArg(env, args.get(0) ?? Nd.wildcard)
    print(", static_cast<std::intptr_t>(")
    emitArg(env, args.get(1) ?? Nd.wildcard)
    print("), ")
    emitElemClosureArg(env, tyInferArg(env, args), args.get(2) ?? Nd.wildcard, false)
    print(")")
    return true
}

func emitElemClosureArg(_ env: inout TyEnv, _ elem: Str, _ a: Nd, _ valueRet: Bool) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitElemClosureVal(env, elem, val, valueRet)
        default: noop()
    }
}

func emitElemClosureVal(_ env: inout TyEnv, _ elem: Str, _ val: Vec[Nd], _ valueRet: Bool) using Alloc, Log {
    if val.len() == 0 { return }
    match val.get(0) ?? Nd.wildcard {
        case .closureE(let cparams, let body): emitSpClosure(env, cparams, body, elem, valueRet)
        default: emitBoxed(env, val)
    }
}

// `[&](<T> p) { return <body>; }` with every parameter typed by the C++
// spelling of `elem` (`auto` when unknown); the parameters register at that
// type so the body infers, and the closure always yields its value.
func emitSpClosure(_ env: inout TyEnv, _ cparams: Vec[Nd], _ body: Vec[Nd], _ elem: Str, _ valueRet: Bool) using Alloc, Log {
    print("[&](")
    var i: Int = 0
    while i < cparams.len() {
        if i > 0 { print(", ") }
        let pn = identName(cparams.get(i) ?? Nd.ident(""))
        if streq(elem, "") { print("auto") } else { print(cppOfSpelling(own(elem))) }
        print(" ")
        print(pn)
        tyAddSymSpelling(&env, pn, own(elem))
        i = i + 1
    }
    print(") { ")
    emitClosureStmts(env, body, valueRet)
    print(" }")
}

// §A10 (§15.4) `memcpy` / `memset` / `memmove` -> the `__builtin_*` forms,
// matched by name as the bootstrap's table is; the trailing length widens to
// std::size_t.
func emitMemIntrinsic(_ env: inout TyEnv, _ fname: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if !(streq(fname, "memcpy") || streq(fname, "memset") || streq(fname, "memmove")) { return false }
    print("__builtin_")
    print(fname)
    print("(")
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        if i + 1 == args.len() {
            print("static_cast<std::size_t>(")
            emitArg(env, args.get(i) ?? Nd.wildcard)
            print(")")
        } else {
            emitArg(env, args.get(i) ?? Nd.wildcard)
        }
        i = i + 1
    }
    print(")")
    return true
}

func syncIntrinsicCpp(_ n: Str) using Alloc -> String {
    if streq(n, "nop") { return own("cpu_nop") }
    if streq(n, "compilerFence") || streq(n, "memoryBarrier") || streq(n, "syncBarrier")
        || streq(n, "instructionBarrier") || streq(n, "waitForInterrupt")
        || streq(n, "waitForEvent") || streq(n, "signalEvent") || streq(n, "relax")
        || streq(n, "cleanData") || streq(n, "invalidateData")
        || streq(n, "cleanInvalidateData") || streq(n, "zeroData")
        || streq(n, "publishInstructions") || streq(n, "invalidateAllInstructions")
        || streq(n, "tlbInvalidateAll") || streq(n, "tlbInvalidatePage")
        || streq(n, "tlbInvalidateAsid") {
        return own(n)
    }
    return own("")
}

// The enum-typed parameters of the intrinsics; every other parameter (spans,
// addresses, flags) emits its argument unchanged.
func syncParamType(_ n: Str, _ i: Int) using Alloc -> String {
    if streq(n, "compilerFence") && i == 0 { return own("Ordering") }
    if streq(n, "memoryBarrier") && i == 0 { return own("BarrierScope") }
    if streq(n, "memoryBarrier") && i == 1 { return own("BarrierKind") }
    if streq(n, "syncBarrier") && i == 0 { return own("BarrierScope") }
    if streq(n, "tlbInvalidateAll") && i == 0 { return own("TlbScope") }
    if streq(n, "tlbInvalidatePage") && i == 2 { return own("TlbScope") }
    if streq(n, "tlbInvalidateAsid") && i == 1 { return own("TlbScope") }
    return own("")
}

// The print family — `print`/`println` (stdout) and `eprint`/`eprintln`
// (stderr, a leading `stderr` stream argument) — lowers to std::print /
// std::println with the text passed as a formatting ARGUMENT (`"{}"`), so a
// `{` in it is harmless. Only the builtin is intercepted: a unit-defined
// function of the same name (tyArity >= 0) emits as a plain call.
func tryEmitPrint(_ env: inout TyEnv, _ fname: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if args.len() != 1 { return false }
    let isOut = streq(fname, "print") || streq(fname, "println")
    let isErr = streq(fname, "eprint") || streq(fname, "eprintln")
    if !isOut && !isErr { return false }
    if tyArity(env, fname) >= 0 { return false }
    let ln = streq(fname, "println") || streq(fname, "eprintln")
    if ln { print("std::println(") } else { print("std::print(") }
    if isErr { print("stderr, ") }
    print("\"{}\", ")
    emitArg(env, args.get(0) ?? Nd.wildcard)
    print(")")
    return true
}

// Slices 27 + 31: a call's arguments have the callee's declared parameter types
// in hand — from the free function's signature (`owner` empty) or the method's
// signature on the base expression's inferred type — so a closure-literal
// argument can lower against the callee's function-typed parameter:
// `apply({ n => n + 1 }, 5)` / `c.apply({ n => n + 1 })` -> a `[&]` lambda.
// Any other argument (or an unnamed/unknown callee) emits as before.
func emitCallArgList(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ args: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitCallArg(env, owner, fname, i, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func emitCallArg(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ idx: Int, _ a: Nd) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitCallArgVal(env, owner, fname, idx, val)
        default: noop()
    }
}

// A free-function argument bound to a SINK parameter always arrives as an
// rvalue: the bootstrap wraps every one in `std::move(...)`, prvalues and
// copyable lvalues included (`std::move` of a temporary is harmless). A
// method's sink parameter is not wrapped (the bootstrap resolves only a plain
// callee to its FuncDecl).
func emitCallArgVal(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ idx: Int, _ val: Vec[Nd]) using Alloc, Log {
    var sinkArg: Bool = false
    if streq(owner, "") && !streq(fname, "") {
        sinkArg = streq(tyParamMode(env, fname, idx), "sink ") && !isCopyArg(val)
    }
    if sinkArg { print("std::move(") }
    emitCallArgInner(env, owner, fname, idx, val)
    if sinkArg { print(")") }
}

// A `copy x` argument is already a fresh prvalue (the bootstrap doesn't wrap it).
func isCopyArg(_ val: Vec[Nd]) -> Bool {
    if let v = val.get(0) {
        return match v {
            case .prefixE(let kw, let inner): streq(kw, "copy ")
            default: false
        }
    }
    return false
}

func emitCallArgInner(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ idx: Int, _ val: Vec[Nd]) using Alloc, Log {
    if valIsVecLit(val) && streq(owner, "") && !streq(fname, "") {
        let el = argVecElem(env, fname, idx)
        if !streq(el, "") {
            emitVecLitSpelled(env, val, el)
            return
        }
    }
    if valIsClosure(val) && !streq(fname, "") {
        let tn = callArgTypeNode(env, owner, fname, idx)
        if nodeIsFnTy(tn) { emitClosureArgTy(env, tn, val); return }
    }
    // A generic construction in ARGUMENT position recovers its instantiated
    // C++ name from the callee's parameter type (`consume(Pair(first: x))`
    // -> `consume(Pair<std::int32_t>{...})`).
    if isGenericCtor(env, val) && !streq(fname, "") {
        let gn = callArgTypeNode(env, owner, fname, idx)
        if nodeIsNamedGen(gn) {
            var tb: Vec[Nd] = Vec.new()
            tb.push(gn)
            emitGenericCtor(env, tb, val)
            return
        }
    }
    let to = callArgTypeSpelling(env, owner, fname, idx)
    if tryEmitLeadingDot(env, to, val) { return }
    let from = tyInferBoxed(env, val)
    emitMaybeCoerced(env, needsStrCoercion(from, to), val)
}

// An array-literal argument's element type: the parameter's `[N]E` element,
// with the callee's generic parameters substituted from any binding the
// expected result type supplied (`return firstElem([5, 6, 7])` in an Int32
// function binds T = Int32); "" while it still names a generic parameter.
func argVecElem(_ env: inout TyEnv, _ fname: Str, _ idx: Int) using Alloc -> String {
    var ps = tyParamType(env, own(fname), idx)
    if streq(env.bindFn, fname) { ps = tySubstSp(ps, env.bindName, env.bindVal) }
    if !tyIsArray(ps) { return own("") }
    let el = tyArrayElem(ps)
    if nameListHas(tyGenNames(env, fname), el) { return own("") }
    return el
}

// §7 expected-type propagation into a generic call's own result: when the
// callee's result is one of its generic parameters, the slot's type binds it.
func tyBindFromExpected(_ env: inout TyEnv, _ v: Vec[Nd], _ expected: Str) using Alloc {
    tyClearBinding(env)
    if streq(expected, "") || v.len() == 0 { return }
    let fname = exCalleeOfCall(v.get(0) ?? Nd.wildcard)
    if streq(fname, "") { return }
    let r = tyFuncRet(env, fname)
    if !nameListHas(tyGenNames(env, fname), r) { return }
    env.bindFn = own(fname)
    env.bindName.push(own(r))
    env.bindVal.push(own(expected))
}

func tyClearBinding(_ env: inout TyEnv) using Alloc {
    env.bindFn = own("")
    while env.bindName.len() > 0 { let _ = env.bindName.pop() }
    while env.bindVal.len() > 0 { let _ = env.bindVal.pop() }
}

func exCalleeOfCall(_ e: Nd) using Alloc -> String {
    return match e {
        case .call(let callee, let args): exCalleeNameBoxed(callee)
        default: own("")
    }
}

func nodeIsNamedGen(_ tn: Nd) -> Bool {
    return match tn {
        case .named(let p, let hasG, let args): hasG
        default: false
    }
}

func callArgTypeSpelling(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ idx: Int) using Alloc -> String {
    if !streq(owner, "") { return typeSpelling(tyMethodParamTypeNode(env, owner, fname, idx)) }
    return tyParamType(env, own(fname), idx)
}

func callArgTypeNode(_ env: inout TyEnv, _ owner: Str, _ fname: Str, _ idx: Int) using Alloc -> Nd {
    if !streq(owner, "") { return tyMethodParamTypeNode(env, owner, fname, idx) }
    return tyParamTypeNode(env, fname, idx)
}

func nodeIsFnTy(_ t: Nd) -> Bool {
    return match t {
        case .fnT(let a, let b, let c, let d): true
        default: false
    }
}

func emitClosureArgTy(_ env: inout TyEnv, _ tn: Nd, _ val: Vec[Nd]) using Alloc, Log {
    match tn {
        case .fnT(let params, let caps, let thr, let res): emitFnPtrClosureVal(env, val, params, res)
        default: noop()
    }
}

// A call `Enum.case(args)` where Enum is a payload enum constructs the variant:
// `Shape.circle(r)` -> `Shape{Shape::circle_t{r}}`. Returns whether it matched
// (and emitted).
func tryEmitPayloadCase(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log -> Bool {
    if callee.len() == 0 { return false }
    return tryEmitPayloadCaseNode(env, callee.get(0) ?? Nd.wildcard, args)
}

func tryEmitPayloadCaseNode(_ env: inout TyEnv, _ c: Nd, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    return match c {
        case .member(let base, let name, let chain): emitPayloadCaseIfEnum(env, base, name, args)
        default: false
    }
}

func emitPayloadCaseIfEnum(_ env: inout TyEnv, _ base: Vec[Nd], _ name: Str, _ args: Vec[Nd]) using Alloc, Log -> Bool {
    let bn = identBaseName(base)
    if streq(bn, "") { return false }
    if !isPayloadEnum(env, bn) { return false }
    emitPayloadCase(env, bn, name, args)
    return true
}

func isStructCtor(_ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc -> Bool {
    if !calleeIsIdent(callee) { return false }
    if args.len() == 0 { return false }
    return argHasLabel(args.get(0) ?? Nd.wildcard)
}

func calleeIsIdent(_ callee: Vec[Nd]) -> Bool {
    if callee.len() == 0 { return false }
    return match callee.get(0) ?? Nd.wildcard {
        case .ident(let n): true
        default: false
    }
}

func argHasLabel(_ a: Nd) using Alloc -> Bool {
    return match a {
        case .arg(let label, let isInout, let val): !streq(label, "")
        default: false
    }
}

func emitStructCtor(_ env: inout TyEnv, _ callee: Vec[Nd], _ args: Vec[Nd]) using Alloc, Log {
    let sn = identBaseName(callee)
    emitBoxed(env, callee)
    print("{")
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitCtorField(env, sn, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
    print("}")
}

func emitCtorField(_ env: inout TyEnv, _ sn: Str, _ a: Nd) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitCtorFieldParts(env, sn, label, val)
        default: noop()
    }
}

// A generic construction's array-literal field initializer takes the
// INSTANTIATED field's element type (`Buffer[Int32, 4]`'s `data: [N]T` ->
// `std::array<std::int32_t, 4>`); anything else is an ordinary field.
func emitGenCtorField(_ env: inout TyEnv, _ sn: Str, _ instSp: Str, _ a: Nd) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitGenCtorFieldParts(env, sn, instSp, label, val)
        default: noop()
    }
}

func emitGenCtorFieldParts(_ env: inout TyEnv, _ sn: Str, _ instSp: Str, _ label: Str, _ val: Vec[Nd]) using Alloc, Log {
    let fi = tyInstFieldType(env, own(instSp), own(label))
    if valIsVecLit(val) && tyIsArray(fi) {
        print(".")
        print(label)
        print(" = ")
        emitVecLitSpelled(env, val, tyArrayElem(fi))
        return
    }
    emitCtorFieldParts(env, sn, label, val)
}

// An array literal whose element type is known only as a spelling.
func emitVecLitSpelled(_ env: inout TyEnv, _ val: Vec[Nd], _ elemSp: Str) using Alloc, Log {
    match val.get(0) ?? Nd.wildcard {
        case .vecLit(let elems): emitVecLitSpelledParts(env, elems, elemSp)
        default: noop()
    }
}

func emitVecLitSpelledParts(_ env: inout TyEnv, _ elems: Vec[Nd], _ elemSp: Str) using Alloc, Log {
    print("std::array<")
    print(cppOfSpelling(own(elemSp)))
    print(", ")
    print(intToStr(elems.len()))
    print(">{")
    let noTy: Vec[Nd] = Vec.new()
    var i: Int = 0
    while i < elems.len() {
        if i > 0 { print(", ") }
        emitVecElem(env, elems.get(i) ?? Nd.wildcard, noTy)
        i = i + 1
    }
    print("}")
}

// A field initializer coerces into a String-typed field.
func emitCtorFieldParts(_ env: inout TyEnv, _ sn: Str, _ label: Str, _ val: Vec[Nd]) using Alloc, Log {
    print(".")
    print(label)
    print(" = ")
    let to = tyFieldType(env, own(sn), own(label))
    if tryEmitLeadingDot(env, to, val) { return }
    let from = tyInferBoxed(env, val)
    if needsStrCoercion(from, to) { emitMaybeCoerced(env, true, val) }
    else { emitMovedValue(env, val) }
}

// §10 by-value position (a binding initializer, a tuple element, a payload or
// field initializer): an lvalue of move-only type moves rather than copies —
// the bootstrap's emit_value. A prvalue already binds without a copy. A
// propagating `try` reads its hoisted temp, an lvalue, so it counts too; so
// does any member expression, including a bare enum case (`List.empty`).
func emitMovedValue(_ env: inout TyEnv, _ v: Vec[Nd]) using Alloc, Log {
    let mv = valIsLvalueOrTry(v) && tyIsMoveOnly(env, tyInferBoxed(env, v))
    if mv { print("std::move(") }
    emitBoxed(env, v)
    if mv { print(")") }
}

func valIsLvalueOrTry(_ v: Vec[Nd]) -> Bool {
    if v.len() == 0 { return false }
    return match v.get(0) ?? Nd.wildcard {
        case .ident(let n): true
        case .member(let b, let n, let c): true
        case .index(let b, let i): true
        case .prefixE(let kw, let inner): streq(kw, "try ")
        default: false
    }
}

func emitMovedArgList(_ env: inout TyEnv, _ args: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitMovedArg(env, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

func emitMovedArg(_ env: inout TyEnv, _ a: Nd) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitMovedValue(env, val)
        default: noop()
    }
}

func emitArgList(_ env: inout TyEnv, _ args: Vec[Nd]) using Alloc, Log {
    var i: Int = 0
    while i < args.len() {
        if i > 0 { print(", ") }
        emitArg(env, args.get(i) ?? Nd.wildcard)
        i = i + 1
    }
}

// Slice 2: positional argument — emit its value (call labels are deferred).
func emitArg(_ env: inout TyEnv, _ a: Nd) using Alloc, Log {
    match a {
        case .arg(let label, let isInout, let val): emitBoxed(env, val)
        default: noop()
    }
}

// A closure literal `{ p => body }` lowers to a `[&]`-capturing C++ lambda:
// `[&](<ptype> p, ...) { <body> }`. Parameter types are NOT in the source — they
// come from the expected function type at the use site (here, ptypes). The body
// is a statement list whose final expression becomes the lambda's `return` (when
// the closure yields a value); earlier statements emit inline, separated by the
// `;\n` their normal emission already carries.
// Each typed parameter registers at its type, and for the body the closure's
// own result type stands in for the enclosing function's, so a value-position
// match (or a leading dot) inside it types against the closure; the outer
// result type is restored after.
func emitClosure(_ env: inout TyEnv, _ cparams: Vec[Nd], _ body: Vec[Nd], _ ptypes: Vec[Nd], _ resTy: Vec[Nd]) using Alloc, Log {
    emitClosureMode(env, cparams, body, ptypes, resTy, false)
}

func emitClosureMode(_ env: inout TyEnv, _ cparams: Vec[Nd], _ body: Vec[Nd], _ ptypes: Vec[Nd], _ resTy: Vec[Nd], _ fnPtr: Bool) using Alloc, Log {
    if fnPtr { print("[](") } else { print("[&](") }
    var i: Int = 0
    while i < cparams.len() {
        if i > 0 { print(", ") }
        let pn = identName(cparams.get(i) ?? Nd.ident(""))
        if i < ptypes.len() {
            let pt = ptypes.get(i) ?? Nd.wildcard
            tyAddSymSpelling(&env, pn, typeSpelling(pt))
            if fnPtr { print("const ") }
            emitType(pt)
            if fnPtr { print("&") }
        } else {
            print("auto")
        }
        print(" ")
        print(pn)
        i = i + 1
    }
    print(") { ")
    let outer = elemBoxCopy(env.curRetNode)
    if resTy.len() > 0 { tySetRetNode(&env, resTy) }
    // A closure's `return` is its own, not the enclosing Unit throws fn's.
    let outerUnitThrows = env.curUnitThrows
    env.curUnitThrows = false
    emitClosureBody(env, body, resTy)
    env.curUnitThrows = outerUnitThrows
    tySetRetNode(&env, outer)
    print(" }")
}

func emitClosureBody(_ env: inout TyEnv, _ body: Vec[Nd], _ resTy: Vec[Nd]) using Alloc, Log {
    emitClosureStmts(env, body, closureReturnsValue(resTy))
}

// A statement list in inline-lambda position: earlier statements emit at ""
// indent (each carrying its own `;\n`); a value-yielding trailing expression
// becomes `return <expr>;` with no trailing newline. Shared by closure bodies
// and if-expression branch lambdas.
func emitClosureStmts(_ env: inout TyEnv, _ body: Vec[Nd], _ valueRet: Bool) using Alloc, Log {
    let n = body.len()
    var i: Int = 0
    while i < n {
        let s = body.get(i) ?? Nd.wildcard
        if i == n - 1 {
            emitClosureTail(env, s, valueRet)
        } else {
            emitStmt(env, s, "")
        }
        i = i + 1
    }
}

// The closure's final statement. A value-returning closure turns a trailing
// expression into `return <expr>;`; a Unit closure emits the bare statement.
func emitClosureTail(_ env: inout TyEnv, _ s: Nd, _ valueRet: Bool) using Alloc, Log {
    match s {
        case .exprS(let e): emitClosureRet(env, e, valueRet)
        default: emitStmt(env, s, "")
    }
}

func emitClosureRet(_ env: inout TyEnv, _ e: Vec[Nd], _ valueRet: Bool) using Alloc, Log {
    if valueRet { print("return ") }
    emitBoxed(env, e)
    print(";")
}

// A closure yields a value unless its expected result type is absent or Unit.
func closureReturnsValue(_ resTy: Vec[Nd]) using Alloc -> Bool {
    if resTy.len() == 0 { return false }
    return match resTy.get(0) ?? Nd.wildcard {
        case .named(let path, let hasG, let args): !streq(path, "Unit")
        default: true
    }
}

// Emit a closure binding's value when the annotation is a function type: pull the
// expected parameter/result types from the fnT and the params/body from the
// closure literal, then lower the lambda.
func emitClosureWithFnTy(_ env: inout TyEnv, _ ty: Vec[Nd], _ value: Vec[Nd]) using Alloc, Log {
    match ty.get(0) ?? Nd.wildcard {
        case .fnT(let params, let caps, let thr, let res): emitFnPtrClosureVal(env, value, params, res)
        default: noop()
    }
}

// §A12 a closure where a function type is expected (a `let` annotated with
// one, or an argument to a function-typed parameter) becomes the C function
// pointer itself: a capture-free `[]` lambda taking the pointer's `const T&`
// parameters (the bootstrap rejects a capturing one).
func emitFnPtrClosureVal(_ env: inout TyEnv, _ value: Vec[Nd], _ ptypes: Vec[Nd], _ resTy: Vec[Nd]) using Alloc, Log {
    match value.get(0) ?? Nd.wildcard {
        case .closureE(let cparams, let body): emitClosureMode(env, cparams, body, ptypes, resTy, true)
        default: noop()
    }
}

func emitClosureVal(_ env: inout TyEnv, _ value: Vec[Nd], _ ptypes: Vec[Nd], _ resTy: Vec[Nd]) using Alloc, Log {
    match value.get(0) ?? Nd.wildcard {
        case .closureE(let cparams, let body): emitClosure(env, cparams, body, ptypes, resTy)
        default: noop()
    }
}

func valIsClosure(_ v: Vec[Nd]) using Alloc -> Bool {
    if v.len() == 0 { return false }
    return match v.get(0) ?? Nd.wildcard {
        case .closureE(let p, let b): true
        default: false
    }
}

func emitParen(_ env: inout TyEnv, _ inner: Vec[Nd]) using Alloc, Log {
    print("(")
    emitBoxed(env, inner)
    print(")")
}

// `!` is ambiguous in the AST: prefix logical-not and postfix force-unwrap both
// parse as unary("!", _). Type inference disambiguates — an Optional operand is a
// force-unwrap (`x!` -> __vstr::unwrap_opt(x)), anything else is logical-not.
func emitUnary(_ env: inout TyEnv, _ op: Str, _ x: Vec[Nd]) using Alloc, Log {
    if streq(op, "!") && tyIsOptional(tyInferBoxed(&env, x)) {
        print("__vstr::unwrap_opt(")
        emitBoxed(env, x)
        print(")")
        return
    }
    print(op)
    emitBoxed(env, x)
}

func tyIsOptional(_ sp: Str) -> Bool {
    if sp.len() == 0 { return false }
    return (sp.byteAt(sp.len() - 1) ?? 0) == 63   // ends with '?'
}

// Most binary operators pass through (`a + b`, `a == b`, `a && b`); nil-coalescing
// `l ?? r` lowers to `(l).value_or(r)`.
func emitBinary(_ env: inout TyEnv, _ op: Str, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc, Log {
    if streq(op, "??") { emitCoalesce(env, l, r); return }
    // §13 vector arithmetic: `a * x + y` over `[N]T` operands lowers each
    // operator to the runtime's element-wise helper (cpp_emitter.cpp keys on
    // the expression's Vector result type).
    if isVecArithOp(op) && tyIsArray(tyInferBinary(env, op, l, r)) {
        print("__vstr::")
        print(vecOpName(op))
        print("(")
        emitBoxed(env, l)
        print(", ")
        emitBoxed(env, r)
        print(")")
        return
    }
    // F7: the tree encodes §17.7 precedence but C++ re-parses with its own
    // table (`&`/`^`/`|` looser than the comparisons). Parenthesize an operand
    // only where the two disagree (mirrors binop_operand_needs_parens).
    let lp = operandNeedsParens(l, op, false)
    let rp = operandNeedsParens(r, op, true)
    if lp { print("(") }
    emitBoxed(env, l)
    if lp { print(")") }
    print(" ")
    print(op)
    print(" ")
    if rp { print("(") }
    emitBoxed(env, r)
    if rp { print(")") }
}

// C++ binding strength of an emitted infix operator (higher binds tighter);
// 0 = never infix in the output (`??`, ranges), so never parenthesized.
func cppBinopPrec(_ op: Str) -> Int {
    if streq(op, "*") || streq(op, "/") || streq(op, "%") || streq(op, "&*") { return 13 }
    if streq(op, "+") || streq(op, "-") || streq(op, "&+") || streq(op, "&-") { return 12 }
    if streq(op, "<<") || streq(op, ">>") { return 11 }
    if streq(op, "<") || streq(op, "<=") || streq(op, ">") || streq(op, ">=") { return 9 }
    if streq(op, "==") || streq(op, "!=") { return 8 }
    if streq(op, "&") { return 7 }
    if streq(op, "^") { return 6 }
    if streq(op, "|") { return 5 }
    if streq(op, "&&") { return 4 }
    if streq(op, "||") { return 3 }
    return 0
}

func operandNeedsParens(_ v: Vec[Nd], _ parentOp: Str, _ isRhs: Bool) -> Bool {
    if v.len() == 0 { return false }
    return match v.get(0) ?? Nd.wildcard {
        case .binary(let cop, let cl, let cr): precRegroups(cppBinopPrec(cop), cppBinopPrec(parentOp), isRhs)
        case _: false
    }
}

func precRegroups(_ c: Int, _ p: Int, _ isRhs: Bool) -> Bool {
    if c == 0 || p == 0 { return false }
    if isRhs { return c <= p }
    return c < p
}

func isVecArithOp(_ op: Str) -> Bool {
    return streq(op, "+") || streq(op, "-") || streq(op, "*") || streq(op, "/")
}

func vecOpName(_ op: Str) using Alloc -> String {
    if streq(op, "+") { return own("vec_add") }
    if streq(op, "-") { return own("vec_sub") }
    if streq(op, "*") { return own("vec_mul") }
    return own("vec_div")
}

func emitCoalesce(_ env: inout TyEnv, _ l: Vec[Nd], _ r: Vec[Nd]) using Alloc, Log {
    print("(")
    emitBoxed(env, l)
    print(").value_or(")
    emitBoxed(env, r)
    print(")")
}

// Basename of the input path without its `.vst` extension (the `.hpp`/`.cpp` stem).
func stemOf(_ path: Str) using Alloc -> String {
    var start: Int = 0
    var i: Int = 0
    while i < path.len() {
        if (path.byteAt(i) ?? 0) == 47 { start = i + 1 }   // '/' == 47
        i = i + 1
    }
    var base: String = own(path.slice(start, path.len()))
    let n = base.len()
    if n >= 4 {
        if streq(own(base.slice(n - 4, n)), ".vst") { return own(base.slice(0, n - 4)) }
    }
    return base
}

// ----- §5 imported modules ----------------------------------------------------
// vgen reads one file; an imported module's declarations are loaded from
// `<entry dir>/a/b.vst` for `import a.b`, renamed to the C++ spelling the
// importer uses (`::a::b::Name` inside a module, `a::b::Name` outside one), and
// registered ahead of the unit's own. The importer's `a.b.Name` member chains
// and type names are rewritten to that same spelling, so the local-declaration
// lowering paths serve them unchanged.
struct QMap {
    var keys: Vec[String]
    var vals: Vec[String]
}

func qmGet(_ m: QMap, _ k: Str) using Alloc -> String {
    var i: Int = 0
    while i < m.keys.len() {
        if let x = m.keys.get(i) {
            if streq(x, k) { return own(m.vals.get(i) ?? own("")) }
        }
        i = i + 1
    }
    return own("")
}

func dirOf(_ path: Str) using Alloc -> String {
    var i: Int = path.len() - 1
    while i >= 0 {
        if (path.byteAt(i) ?? 0) == 47 { return own(path.slice(0, i + 1)) }   // '/'
        i = i - 1
    }
    return own("")
}

// Load each (non-C) import of `u` that exists under `dir`, returning its
// renamed top-level declarations, and fill `qm` with `a.b.Name` -> C++ name.
func loadImports(_ dir: Str, _ u: NUnit, _ qm: inout QMap) using Alloc, Fs -> Vec[Nd] {
    var out: Vec[Nd] = Vec.new()
    var i: Int = 0
    while i < u.imports.len() {
        match u.imports.get(i) ?? Nd.wildcard {
            case .importD(let isC, let payload): loadOneImport(dir, u.hasMod, isC, payload, qm, out)
            default: noop()
        }
        i = i + 1
    }
    return out
}

func loadOneImport(_ dir: Str, _ hasMod: Bool, _ isC: Bool, _ mod: Str, _ qm: inout QMap, _ out: inout Vec[Nd]) using Alloc, Fs {
    if isC || streq(mod, "") { return }
    var path: String = own(dir)
    path.append(dotsToSlashes(mod))
    path.append(".vst")
    if let src = readFile(path) {
        let toks = tokenize(src)
        var p = Ps(toks: toks, pos: 0)
        let iu = parseUnit(&p)
        // Its own names, local spelling -> qualified C++ spelling.
        var local = QMap(keys: Vec.new(), vals: Vec.new())
        var k: Int = 0
        while k < iu.decls.len() {
            let nm = declNameOf(iu.decls.get(k) ?? Nd.wildcard)
            if !streq(nm, "") {
                var cpp: String = ""
                if hasMod { cpp.append("::") }
                cpp.append(dotsToColons(mod))
                cpp.append("::")
                cpp.append(nm)
                var dotted: String = own(mod)
                dotted.append(".")
                dotted.append(nm)
                local.keys.push(own(nm))
                local.vals.push(own(cpp))
                qm.keys.push(dotted)
                qm.vals.push(cpp)
            }
            k = k + 1
        }
        var j: Int = 0
        while j < iu.decls.len() {
            let d = iu.decls.get(j) ?? Nd.wildcard
            if !streq(declNameOf(d), "") { out.push(rwDeclName(local, rwNd(local, 0, d))) }
            j = j + 1
        }
    }
}

func declNameOf(_ d: Nd) using Alloc -> String {
    return match d {
        case .funcD(let vis, let mods, let name, let g, let ps, let c, let t, let r, let b, let at): own(name)
        case .structD(let vis, let name, let fl, let m, let dn, let lin, let g, let at): own(name)
        case .enumD(let vis, let name, let cs, let m, let g): own(name)
        case .constD(let vis, let name, let ty, let v): own(name)
        case .staticD(let vis, let name, let ty, let v, let at): own(name)
        case .opaqueD(let vis, let name, let u): own(name)
        default: own("")
    }
}

// Rename a top-level declaration (not its members).
func rwDeclName(_ m: QMap, _ d: Nd) using Alloc -> Nd {
    return match d {
        case .funcD(let vis, let mods, let name, let g, let ps, let c, let t, let r, let b, let at):
            Nd.funcD(vis, mods, qmGet(m, name), g, ps, c, t, r, b, at)
        case .structD(let vis, let name, let fl, let mm, let dn, let lin, let g, let at):
            Nd.structD(vis, qmGet(m, name), fl, mm, dn, lin, g, at)
        case .enumD(let vis, let name, let cs, let mm, let g): Nd.enumD(vis, qmGet(m, name), cs, mm, g)
        case .constD(let vis, let name, let ty, let v): Nd.constD(vis, qmGet(m, name), ty, v)
        case .staticD(let vis, let name, let ty, let v, let at): Nd.staticD(vis, qmGet(m, name), ty, v, at)
        case .opaqueD(let vis, let name, let u): Nd.opaqueD(vis, qmGet(m, name), u)
        default: d
    }
}

func rwUnit(_ m: QMap, _ u: NUnit) using Alloc -> NUnit {
    if m.keys.len() == 0 { return u }
    return NUnit(hasMod: u.hasMod, modPath: own(u.modPath), imports: ndsCopy(u.imports), decls: rwV(m, 1, u.decls))
}

func rwV(_ m: QMap, _ mode: Int, _ xs: Vec[Nd]) using Alloc -> Vec[Nd] {
    var out: Vec[Nd] = Vec.new()
    var i: Int = 0
    while i < xs.len() {
        out.push(rwNd(m, mode, xs.get(i) ?? Nd.wildcard))
        i = i + 1
    }
    return out
}

// The dotted path a member chain of plain identifiers spells (`a.b.C`), or "".
func dottedOf(_ n: Nd) using Alloc -> String {
    return match n {
        case .ident(let x): own(x)
        case .member(let base, let name, let chain): dottedMember(base, name, chain)
        default: own("")
    }
}

func dottedMember(_ base: Vec[Nd], _ name: Str, _ chain: Bool) using Alloc -> String {
    if chain { return own("") }
    let b = dottedOf(base.get(0) ?? Nd.wildcard)
    if streq(b, "") { return own("") }
    var s = b
    s.append(".")
    s.append(name)
    return s
}

// Rewrite names through `m`. Mode 0 (inside an imported module): a bare
// identifier or type name of one of its top-level declarations. Mode 1 (the
// importer): an `a.b.Name` member chain or type name.
func rwNd(_ m: QMap, _ mode: Int, _ n: Nd) using Alloc -> Nd {
    return match n {
        case .ident(let x): rwIdent(m, mode, x)
        case .member(let base, let name, let chain): rwMember(m, mode, base, name, chain)
        case .named(let path, let g, let args): rwNamed(m, path, g, rwV(m, mode, args))
        case .paren(let x): Nd.paren(rwV(m, mode, x))
        case .unary(let op, let x): Nd.unary(own(op), rwV(m, mode, x))
        case .binary(let op, let a, let b): Nd.binary(own(op), rwV(m, mode, a), rwV(m, mode, b))
        case .call(let c, let a): Nd.call(rwV(m, mode, c), rwV(m, mode, a))
        case .arg(let l, let io, let v): Nd.arg(own(l), io, rwV(m, mode, v))
        case .index(let b, let i): Nd.index(rwV(m, mode, b), rwV(m, mode, i))
        case .ifE(let ln, let li, let c, let t, let e): Nd.ifE(own(ln), rwV(m, mode, li), rwV(m, mode, c), rwV(m, mode, t), rwV(m, mode, e))
        case .block(let ss): Nd.block(rwV(m, mode, ss))
        case .asE(let v, let t, let o): Nd.asE(rwV(m, mode, v), rwV(m, mode, t), o)
        case .addrOf(let x): Nd.addrOf(rwV(m, mode, x))
        case .matchE(let sc, let arms): Nd.matchE(rwV(m, mode, sc), rwV(m, mode, arms))
        case .matchArm(let d, let pt, let g, let b): Nd.matchArm(d, rwV(m, mode, pt), rwV(m, mode, g), rwV(m, mode, b))
        case .intrT(let x): Nd.intrT(rwV(m, mode, x))
        case .vecLit(let xs): Nd.vecLit(rwV(m, mode, xs))
        case .tupleLit(let xs): Nd.tupleLit(rwV(m, mode, xs))
        case .closureE(let ps, let b): Nd.closureE(rwV(m, mode, ps), rwV(m, mode, b))
        case .interpE(let parts, let xs): Nd.interpE(parts, rwV(m, mode, xs))
        case .throwE(let x): Nd.throwE(rwV(m, mode, x))
        case .prefixE(let kw, let x): Nd.prefixE(own(kw), rwV(m, mode, x))
        case .doCatchE(let db, let en, let et, let cb): Nd.doCatchE(rwV(m, mode, db), own(en), rwV(m, mode, et), rwV(m, mode, cb))
        case .quoteE(let x): Nd.quoteE(rwV(m, mode, x))
        case .spliceE(let bare, let x): Nd.spliceE(bare, rwV(m, mode, x))
        case .letS(let pt, let t, let v): Nd.letS(rwV(m, mode, pt), rwV(m, mode, t), rwV(m, mode, v))
        case .varS(let pt, let t, let v): Nd.varS(rwV(m, mode, pt), rwV(m, mode, t), rwV(m, mode, v))
        case .exprS(let x): Nd.exprS(rwV(m, mode, x))
        case .retS(let x): Nd.retS(rwV(m, mode, x))
        case .assignS(let op, let t, let v): Nd.assignS(own(op), rwV(m, mode, t), rwV(m, mode, v))
        case .whileS(let c, let b): Nd.whileS(rwV(m, mode, c), rwV(m, mode, b))
        case .forS(let pt, let it, let b): Nd.forS(rwV(m, mode, pt), rwV(m, mode, it), rwV(m, mode, b))
        case .withS(let cs, let ns, let vs, let ans, let b): Nd.withS(rwV(m, mode, cs), ndsCopy(ns), rwV(m, mode, vs), rwV(m, mode, ans), rwV(m, mode, b))
        case .litP(let x): Nd.litP(rwV(m, mode, x))
        case .enumP(let c, let xs): Nd.enumP(own(c), rwV(m, mode, xs))
        case .tupleP(let xs): Nd.tupleP(rwV(m, mode, xs))
        case .rangeP(let a, let b, let inc): Nd.rangeP(rwV(m, mode, a), rwV(m, mode, b), inc)
        case .orP(let xs): Nd.orP(rwV(m, mode, xs))
        case .opt(let x): Nd.opt(rwV(m, mode, x))
        case .someT(let x): Nd.someT(rwV(m, mode, x))
        case .dynT(let x): Nd.dynT(rwV(m, mode, x))
        case .vecT(let len, let x): Nd.vecT(own(len), rwV(m, mode, x))
        case .tupleT(let xs): Nd.tupleT(rwV(m, mode, xs))
        case .fnT(let ps, let cs, let t, let r): Nd.fnT(rwV(m, mode, ps), rwV(m, mode, cs), rwV(m, mode, t), rwV(m, mode, r))
        case .genConst(let nm, let t): Nd.genConst(own(nm), rwV(m, mode, t))
        case .genType(let nm, let bs): Nd.genType(own(nm), rwV(m, mode, bs))
        case .param(let lo, let l, let nm, let ne, let md, let t, let tp): Nd.param(lo, own(l), own(nm), ne, own(md), rwV(m, mode, t), rwV(m, mode, tp))
        case .field(let k, let nm, let t, let at): Nd.field(own(k), own(nm), rwV(m, mode, t), ndsCopy(at))
        case .enumCase(let nm, let ps): Nd.enumCase(own(nm), rwV(m, mode, ps))
        case .payElem(let l, let t): Nd.payElem(own(l), rwV(m, mode, t))
        case .funcD(let vis, let mods, let name, let g, let ps, let c, let t, let r, let b, let at):
            Nd.funcD(own(vis), own(mods), own(name), rwV(m, mode, g), rwV(m, mode, ps), rwV(m, mode, c), rwV(m, mode, t), rwV(m, mode, r), rwV(m, mode, b), ndsCopy(at))
        case .structD(let vis, let name, let fl, let mm, let dn, let lin, let g, let at):
            Nd.structD(own(vis), own(name), rwV(m, mode, fl), rwV(m, mode, mm), rwV(m, mode, dn), lin, rwV(m, mode, g), ndsCopy(at))
        case .enumD(let vis, let name, let cs, let mm, let g): Nd.enumD(own(vis), own(name), rwV(m, mode, cs), rwV(m, mode, mm), rwV(m, mode, g))
        case .constD(let vis, let name, let t, let v): Nd.constD(own(vis), own(name), rwV(m, mode, t), rwV(m, mode, v))
        case .staticD(let vis, let name, let t, let v, let at): Nd.staticD(own(vis), own(name), rwV(m, mode, t), rwV(m, mode, v), ndsCopy(at))
        case .opaqueD(let vis, let name, let u): Nd.opaqueD(own(vis), own(name), rwV(m, mode, u))
        case .deriveD(let ps, let t): Nd.deriveD(rwV(m, mode, ps), rwV(m, mode, t))
        default: n
    }
}

func rwIdent(_ m: QMap, _ mode: Int, _ x: Str) using Alloc -> Nd {
    if mode == 0 {
        let q = qmGet(m, x)
        if !streq(q, "") { return Nd.ident(q) }
    }
    return Nd.ident(own(x))
}

func rwMember(_ m: QMap, _ mode: Int, _ base: Vec[Nd], _ name: Str, _ chain: Bool) using Alloc -> Nd {
    if mode == 1 {
        let q = qmGet(m, dottedMember(base, name, chain))
        if !streq(q, "") { return Nd.ident(q) }
    }
    return Nd.member(rwV(m, mode, base), own(name), chain)
}

func rwNamed(_ m: QMap, _ path: Str, _ g: Bool, _ args: Vec[Nd]) using Alloc -> Nd {
    let q = qmGet(m, path)
    if !streq(q, "") { return Nd.named(q, g, args) }
    return Nd.named(own(path), g, args)
}

func main() -> Int32 {
    with Alloc {
        with Fs {
            with Log {
                let argv = args()
                if argv.len() < 2 {
                    eprintln("usage: vgen [--hpp] <file.vst>")
                    return 1
                }
                // `vgen --hpp FILE` emits the header tail (declarations);
                // `vgen FILE` emits the source definitions.
                var hppMode: Bool = false
                var path: String = own(argv.get(1) ?? "")
                if streq(path, "--hpp") {
                    if argv.len() < 3 { eprintln("usage: vgen [--hpp] <file.vst>"); return 1 }
                    hppMode = true
                    path = own(argv.get(2) ?? "")
                }
                if let src = readFile(path) {
                    let toks = tokenize(src)
                    var p = Ps(toks: toks, pos: 0)
                    let u0 = parseUnit(&p)
                    // §5 read the imported modules (from the entry's directory)
                    // and rewrite references to them as qualified C++ names.
                    var qm = QMap(keys: Vec.new(), vals: Vec.new())
                    let ext = loadImports(dirOf(path), u0, qm)
                    let u = rwUnit(qm, u0)
                    if hppMode { emitHpp(u, ext) } else { emitUnit(u, stemOf(path), ext) }
                    return 0
                }
                eprintln("read failed")
                return 1
            }
        }
    }
}
