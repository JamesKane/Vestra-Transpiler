// §9 `do { … } catch (e: E) where guard { … }` — guarded catch arm.
// The guard runs with the bound error in scope; if true, the handler
// applies; if false, the bound error propagates to the enclosing
// `throws(E)` context. Sugar for the common "retry on a subset of
// failure modes" pattern, without forcing an inner match.
//
// Sema requires an enclosing throws context that matches E; this is
// what makes the fall-through propagation typesafe.

module examples.docatch_where

enum NetErr {
    case timeout
    case refused
    case fatal
}

func makeReq(_ kind: Int32) throws(NetErr) -> Int32 {
    if kind == 1 { throw NetErr.timeout }
    if kind == 2 { throw NetErr.refused }
    if kind == 3 { throw NetErr.fatal }
    return 42
}

// The discriminator: only `timeout` and `refused` are worth retrying;
// `fatal` errors should be left alone.
func isRetryable(_ e: NetErr) -> Bool {
    return match e {
        case .timeout: true
        case .refused: true
        case .fatal:   false
    }
}

// The where-guarded catch dispatches the retryable family to the
// handler arm (returning the sentinel -1). A `fatal` error falls
// through the guard and propagates the NetErr up to attempt's own
// throws(NetErr) clause — the driver verifies this by unwrapping
// the std::expected at the call site.
func attempt(_ kind: Int32) throws(NetErr) -> Int32 {
    return do { try makeReq(kind) } catch (e: NetErr) where isRetryable(e) { -1 }
}
