// §18.5 String — an owned, growable string (lowers to std::string). The
// builder shape a real program needs: start empty with `String.new()` (gated by
// `Alloc`, like Vec.new), grow it with `append` (a literal or a borrowed Str),
// and read its byte length with `len()`. The finished String is an ordinary
// value: returnable, and usable where a `Str` view is expected. A String can be
// seeded directly from a string literal (`var s: String = "..."`) — the
// StrConst→String coercion wraps it in std::string at codegen.

module examples.string_demo

// Seed from a literal, then grow it.
func greeting(_ who: Str) using Alloc -> String {
    var s: String = "Hello, "
    s.append(who)
    s.append("!")
    return s
}

// Length of the built-up string.
func greetingLen(_ who: Str) using Alloc -> Int {
    return greeting(who).len()
}
