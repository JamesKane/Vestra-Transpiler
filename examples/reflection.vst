// §12.2 reflection demo: a struct's fields are first-class at comptime.
//
// `StructName.fields` returns a fixed-length `[N]Field`. A `Field`
// today carries one member — `name: Str` — which is enough to
// reproduce the §12.3 reflective-defaults shape from the spec:
//
//   for f in Self.fields { ... use f.name ... }
//
// The folder builds the Field values directly from the StructDecl in
// scope; the resolver pins the vector type from the field count. We
// also surface `.length` on vectors (a small ergonomic add that lets
// the loop bound itself reflect the struct shape) and `.name` on
// Field values.
//
// Field stays comptime-only for now — there's no runtime Field type
// in the emitted C++. The pattern shown below extracts just the
// names into a runtime `[N]Str` table that codegen handles via the
// existing folded-vector lowering.
//
// Later phases extend Field with `type`, `offset`, and attributes,
// unlocking `derive(Eq, Hash, Clone, …)` reflective defaults.

module examples.reflection

struct Point {
    var x: Int32
    var y: Int32
    var label: Str
}

// Reflective build: walk Point's fields at compile time and copy each
// `.name` into a fixed-size `[3]Str`. The loop bound `Point.fields.length`
// itself reflects the struct's shape, so adding/removing fields would
// cause a compile-time arity mismatch instead of a silent drift.
comptime func collectNames() -> [3]Str {
    var out: [3]Str = .zero
    for i in 0 ..< Point.fields.length {
        out[i] = Point.fields[i].name
    }
    return out
}

const PointFields: [3]Str = comptime { collectNames() }

func name_at(_ i: Int32) -> Str {
    return PointFields[i]
}
