// §12.2 reflection demo: a struct's fields are first-class at comptime.
//
// `StructName.fields` returns a fixed-length `[N]Field`. A `Field`
// today carries two members:
//   name: Str   — the field's identifier
//   type: Type  — a Type value with `.name: Str`
//
// That's enough to reproduce the §12.3 reflective-defaults shape from
// the spec one indirection layer down (we don't have for-each over
// vectors yet, so the loop iterates 0 ..< T.fields.length explicitly):
//
//   for i in 0 ..< Self.fields.length { ... Self.fields[i].name ... }
//
// The folder builds Field + Type values directly from the StructDecl
// in scope; the resolver pins the vector type from the field count.
// We also surface `.length` on vectors so the loop bound reflects the
// struct's shape (add or remove a field and the loop arity must
// match, or the compile fails).
//
// Field + Type stay comptime-only for now — there's no runtime
// Field/Type C++ shape yet. The pattern below extracts what the
// runtime needs (here: names + type spellings) into runtime `[N]Str`
// tables that codegen lowers via the existing folded-vector path.
//
// Later phases extend Field with `offset` + attributes, and unlock
// `derive(Eq, Hash, Clone, …)` reflective defaults riding on .type.

module examples.reflection

struct Point {
    var x: Int32
    var y: Int32
    var label: Str
}

// Two reflective walks: one collecting field names, one collecting
// each field's type-display-name. The loop bound itself reflects
// Point's arity via `.length`.

comptime func collectNames() -> [3]Str {
    var out: [3]Str = .zero
    for i in 0 ..< Point.fields.length {
        out[i] = Point.fields[i].name
    }
    return out
}

comptime func collectTypeNames() -> [3]Str {
    var out: [3]Str = .zero
    for i in 0 ..< Point.fields.length {
        out[i] = Point.fields[i].type.name
    }
    return out
}

const PointFields: [3]Str = comptime { collectNames() }
const PointTypes:  [3]Str = comptime { collectTypeNames() }

func name_at(_ i: Int32) -> Str {
    return PointFields[i]
}

func type_at(_ i: Int32) -> Str {
    return PointTypes[i]
}
