// A mini-language with variables: the front-end grows a symbol table. A program
// is a sequence of statements separated by ';'; a statement is either an
// assignment `name = expr` (which binds the name in the environment) or a bare
// expression. Identifiers in an expression are looked up in the environment, so
// later statements can use values bound by earlier ones. The program's result
// is the value of its last statement.
//
//   prog   = stmt (';' stmt)*
//   stmt   = ident '=' expr  |  expr
//   expr   = term (('+'|'-') term)*
//   term   = factor (('*'|'/') factor)*
//   factor = num | ident | '(' expr ')'
//
// The environment is a `HashMap[Str, Int]` over the existing collection surface:
// assignment is `env.set(name, v)`, a variable reference is `env.get(name)`. The
// token stream carries identifier names as `Str` slices of the source, so the
// map keys borrow the source (alive for the whole run). Evaluation happens as
// the parser descends (no separate AST), so the focus is the symbol table.

module examples.calc_vars_demo

enum Tok {
    case num
    case ident
    case plus
    case minus
    case star
    case slash
    case lparen
    case rparen
    case assign
    case semicolon
    case end
    case bad
}

// A token carries its kind plus, for a `num`, its value and, for an `ident`, its
// name (a borrowed slice of the source).
struct Token {
    let kind: Tok
    let value: Int
    let name: Str
}

// ---- lexer -----------------------------------------------------------------

func punct(_ c: Char) -> Tok {
    if c == '+' { return .plus }
    if c == '-' { return .minus }
    if c == '*' { return .star }
    if c == '/' { return .slash }
    if c == '(' { return .lparen }
    if c == ')' { return .rparen }
    if c == '=' { return .assign }
    if c == ';' { return .semicolon }
    return .bad
}

func lex(_ s: Str) using Alloc -> Vec[Token] {
    var toks: Vec[Token] = Vec.new()
    var i: Int = 0
    while i < s.len() {
        let c = s.charAt(i) ?? ' '
        if c.isSpace() {
            i = i + 1
        } else if c.isDigit() {
            let start = i
            while i < s.len() && (s.charAt(i) ?? ' ').isDigit() {
                i = i + 1
            }
            let v = s.slice(start, i).toInt() ?? 0
            toks.push(Token(kind: .num, value: v, name: ""))
        } else if c.isAlpha() {
            let start = i
            while i < s.len() && (s.charAt(i) ?? ' ').isAlnum() {
                i = i + 1
            }
            toks.push(Token(kind: .ident, value: 0, name: s.slice(start, i)))
        } else {
            toks.push(Token(kind: punct(c), value: 0, name: ""))
            i = i + 1
        }
    }
    toks.push(Token(kind: .end, value: 0, name: ""))
    return toks
}

func peekKind(_ ts: Vec[Token], _ i: Int) -> Tok {
    if let t = ts.get(i) {
        return t.kind
    }
    return Tok.end
}

func peekVal(_ ts: Vec[Token], _ i: Int) -> Int {
    if let t = ts.get(i) {
        return t.value
    }
    return 0
}

func peekName(_ ts: Vec[Token], _ i: Int) -> Str {
    if let t = ts.get(i) {
        return t.name
    }
    return ""
}

// ---- parser + evaluator (env is read for lookups) --------------------------

// factor = num | ident | '(' expr ')'. An identifier resolves through the
// environment (an undefined name reads as 0).
func pFactor(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int]) -> Int {
    let k = peekKind(ts, i)
    if k == Tok.num {
        let v = peekVal(ts, i)
        i = i + 1
        return v
    }
    if k == Tok.ident {
        let name = peekName(ts, i)
        i = i + 1
        return env.get(name) ?? 0
    }
    if k == Tok.lparen {
        i = i + 1
        let v = pExpr(ts, &i, env)
        i = i + 1  // consume ')'
        return v
    }
    i = i + 1
    return 0
}

func pTerm(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int]) -> Int {
    var acc: Int = pFactor(ts, &i, env)
    var more: Bool = true
    while more {
        let k = peekKind(ts, i)
        if k == Tok.star {
            i = i + 1
            acc = acc * pFactor(ts, &i, env)
        } else if k == Tok.slash {
            i = i + 1
            acc = acc / pFactor(ts, &i, env)
        } else {
            more = false
        }
    }
    return acc
}

func pExpr(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int]) -> Int {
    var acc: Int = pTerm(ts, &i, env)
    var more: Bool = true
    while more {
        let k = peekKind(ts, i)
        if k == Tok.plus {
            i = i + 1
            acc = acc + pTerm(ts, &i, env)
        } else if k == Tok.minus {
            i = i + 1
            acc = acc - pTerm(ts, &i, env)
        } else {
            more = false
        }
    }
    return acc
}

// ---- the program driver ----------------------------------------------------

// Run a whole program, threading a symbol table through its statements; returns
// the value of the last statement (0 for an empty program).
func runProgram(_ s: Str) using Alloc -> Int {
    let toks = lex(s)
    var env: HashMap[Str, Int] = HashMap.new()
    var i: Int = 0
    var last: Int = 0
    var more: Bool = true
    while more {
        if peekKind(toks, i) == Tok.end {
            more = false
        } else {
            // An assignment is an identifier immediately followed by '='.
            if peekKind(toks, i) == Tok.ident && peekKind(toks, i + 1) == Tok.assign {
                let name = peekName(toks, i)
                i = i + 2  // skip the name and the '='
                let v = pExpr(toks, &i, env)
                env.set(name, v)
                last = v
            } else {
                last = pExpr(toks, &i, env)
            }
            // Consume an optional statement separator.
            if peekKind(toks, i) == Tok.semicolon {
                i = i + 1
            }
        }
    }
    return last
}
