// §11 async, first slice: `async func` + `await`.
//
// `async` is a capability, not a function colour: `async func` adds
// `using Async` to the clause and `await e` is permitted exactly where
// Async is in scope (the capability checker already enforces this). This
// slice adds the codegen: an `async func` lowers to a C++20 coroutine
// returning `__vstr::Task<T>`, each `return` becomes `co_return`, and each
// `await e` becomes `co_await (e)`. v0.5 has no scheduler — a Task runs
// eagerly to completion, so without a real suspension point the awaits
// resolve synchronously with correct sequential semantics. `spawn`,
// `select`, `parallel`, and async + throws wait on later slices.

module examples.async_demo

// A leaf async computation.
async func increment(_ x: Int32) -> Int32 {
    return x + 1
}

// Sequential awaits, each binding its result.
async func sumTwo(_ a: Int32, _ b: Int32) -> Int32 {
    let x = await increment(a)
    let y = await increment(b)
    return x + y
}

// Nested await: the inner result feeds the outer call.
async func twice(_ x: Int32) -> Int32 {
    return await increment(await increment(x))
}

// A void async function (lowers to Task<void> with a trailing co_return).
async func touch(_ x: Int32) {
    await increment(x)
}

// `spawn f(args)` runs the call and yields a `Future[T]`; `await` consumes
// the future for its result. v0.5 has no scheduler, so a spawn runs
// eagerly, but the surface is the §11 one: spawn both, then await both.
async func sumSpawned(_ a: Int32, _ b: Int32) -> Int32 {
    let fa = spawn increment(a)
    let fb = spawn increment(b)
    return await fa + await fb
}
