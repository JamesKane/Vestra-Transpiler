// §11 async, first slice: `async func` + `await`.
//
// `async` is a capability, not a function colour: `async func` adds
// `using Async` to the clause and `await e` is permitted exactly where
// Async is in scope (the capability checker already enforces this). This
// slice adds the codegen: an `async func` lowers to a C++20 coroutine
// returning `__vstr::Task<T>`, each `return` becomes `co_return`, and each
// `await e` becomes `co_await (e)`. An `async func` that also `throws(E)`
// lowers to `__vstr::Task<std::expected<T, E>>`: `throw` and a propagating
// `try` `co_return std::unexpected{…}` (a plain return is ill-formed in a
// coroutine), and a `return v` co_returns through the expected converting
// ctor. The cooperative scheduler, channels, select, and timeouts live in
// examples/channel_select_demo.vst.

module examples.async_demo

// A leaf async computation.
async func increment(_ x: Int32) -> Int32 {
    return x + 1
}

// Sequential awaits, each binding its result.
async func sumTwo(_ a: Int32, _ b: Int32) -> Int32 {
    let x = await increment(a)
    let y = await increment(b)
    return x + y
}

// Nested await: the inner result feeds the outer call.
async func twice(_ x: Int32) -> Int32 {
    return await increment(await increment(x))
}

// A void async function (lowers to Task<void> with a trailing co_return).
async func touch(_ x: Int32) {
    await increment(x)
}

// `spawn f(args)` runs the call and yields a `Future[T]`; `await` consumes
// the future for its result. v0.5 has no scheduler, so a spawn runs
// eagerly, but the surface is the §11 one: spawn both, then await both.
async func sumSpawned(_ a: Int32, _ b: Int32) -> Int32 {
    let fa = spawn increment(a)
    let fb = spawn increment(b)
    return await fa + await fb
}

// `select` waits on several futures; the first ready arm wins, binding its
// value. v0.5 futures are always ready, so the first arm is taken; the
// optional `default` covers "nothing ready".
async func firstReady(_ a: Int32, _ b: Int32) -> Int32 {
    let fa = spawn increment(a)
    let fb = spawn increment(b)
    return select {
        on let x = fa: x
        on let y = fb: y
        default:       0
    }
}

// async + throws(E): lowers to `Task[expected[T, E]]`. `throw` co_returns the
// error; `return` co_returns the value through the expected converting ctor.
enum MathError { case negative }

async func checkedInc(_ x: Int32) throws(MathError) -> Int32 {
    if x < 0 {
        throw MathError.negative
    }
    return await increment(x)
}

// A propagating `try await` co_returns the error if the awaited call fails,
// otherwise binds the unwrapped value. checkedInc(5) -> 6 -> 7; a negative
// input propagates MathError.negative out of incTwice.
async func incTwice(_ x: Int32) throws(MathError) -> Int32 {
    let a = try await checkedInc(x)
    let b = try await checkedInc(a)
    return b
}
