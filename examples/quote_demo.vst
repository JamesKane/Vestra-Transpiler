// §12.4 quote / splice — first slice (expression context).
//
// `quote { EXPR }` is a code template; `$x` splices an identifier and
// `$(expr)` splices a parenthesized expression into the template. In this
// v0.5 slice a quote is used directly in expression position, so its body
// is materialized in place with the splices substituted. Expression macros
// (below) build on this: a `comptime func(Expr, …) -> Expr` whose body is a
// `quote` template, invoked as `@name(args)`. The declaration-macro layer (a
// `comptime func` taking a declaration and returning `[Decl]`) and hygiene are
// follow-on slices.

module examples.quote_demo

// `$(x)` splices the parenthesized argument expression twice.
func square(_ x: Int32) -> Int32 {
    return quote { $(x) * $(x) }
}

// `$a` / `$x` / `$y` splice bare identifiers.
func axpy(_ a: Int32, _ x: Int32, _ y: Int32) -> Int32 {
    return quote { $a * $x + $y }
}

// A quoted body can be any expression — here an `if` expression, with the
// operands spliced in.
func clampLow(_ v: Int32, _ lo: Int32) -> Int32 {
    return quote { if $(v) < $(lo) { $(lo) } else { $(v) } }
}

// §12.4 expression macros. A `comptime func(Expr, …) -> Expr` whose body is a
// `quote` template; invoked as `@name(args)`, the call expands to the template
// with each argument substituted for the matching `$param` splice, then the
// expansion is type-checked and lowered in place. The macro func is comptime-
// only (never emitted to C++).
comptime func twice(_ x: Expr) -> Expr {
    return quote { $x + $x }
}

// Spliced arguments are parenthesized, so a compound argument keeps its
// grouping: `@scaleBias(p + 1, k)` expands to `(p + 1) * (p + 1) + (k)`.
comptime func scaleBias(_ x: Expr, _ b: Expr) -> Expr {
    return quote { $x * $x + $b }
}

func useTwice(_ n: Int32) -> Int32 {
    return @twice(n)
}

func useScaleBias(_ p: Int32, _ k: Int32) -> Int32 {
    return @scaleBias(p + 1, k)
}

// §12.4 declaration macro with reflection: a `comptime func(Decl) -> [Decl]`
// whose body is a declaration-context `quote { … }`. Applied as `@name` on a
// declaration, it replaces that declaration with the template's declarations;
// the `$d` item splices the annotated declaration back in, and `$(d.name)`
// reflects the annotated declaration's name as a String. Here `@withOrigin`
// keeps the struct, adds a companion `origin()`, and a `markerName()` that
// returns the struct's own name.
comptime func withOrigin(_ d: Decl) -> [Decl] {
    return quote {
        $d
        func origin() -> Int32 { return 0 }
        func markerName() -> StrConst { return $(d.name) }
    }
}

@withOrigin
struct Marker {
    var tag: Int32
}

// §12.4 declaration macros run through the comptime folder, so a macro body can
// compute values before quoting them. Here `k` is folded to 42 during expansion
// and the computed `$(k)` splice materializes that constant into `answer()` —
// the emitted function returns the literal 42, evaluated at comptime, not at run
// time.
comptime func bump(_ d: Decl) -> [Decl] {
    let k: Int32 = 40 + 2
    return quote {
        $d
        func answer() -> Int32 { return $(k) }
    }
}

@bump
struct Counter {
    var n: Int32
}

// §12.4 reflection over `d.fields`: the folder iterates the annotated struct's
// fields in a comptime `for` loop, so a macro can derive a value from the shape
// of the type. Here `@described` counts the fields (and, separately, the Int64
// ones via `f.type.name`) at expansion time and splices the totals into the
// generated accessors — no field metadata survives to run time.
comptime func described(_ d: Decl) -> [Decl] {
    var total: Int32 = 0
    var wide: Int32 = 0
    for f in d.fields {
        total += 1
        if f.type.name == "Int64" { wide += 1 }
    }
    return quote {
        $d
        func fieldCount() -> Int32 { return $(total) }
        func wideFieldCount() -> Int32 { return $(wide) }
    }
}

@described
struct Vec3 {
    var x: Int32
    var y: Int64
    var z: Int64
}

// §12.4 per-field declaration generation with full type reflection: the macro
// builds its `[Decl]` result by iterating `d.fields` and appending one accessor
// per field with `+=`. Each generated function composes a distinct name from a
// comptime string splice (`$(f.name + "_of")`), takes the annotated struct by
// type (`$(d.name)`), returns the field's own type (`$(f.type)`), and reads the
// field through a member-name splice (`v.$(f.name)`). `quote { $d }` seeds the
// accumulator with the annotated struct itself. So `@getters` on a struct emits
// a typed `field_of(s)` reader per field, all resolved at comptime.
comptime func getters(_ d: Decl) -> [Decl] {
    var out: [Decl] = quote { $d }
    for f in d.fields {
        out += quote {
            func $(f.name + "_of")(_ v: $(d.name)) -> $(f.type) { return v.$(f.name) }
        }
    }
    return out
}

@getters
struct Pair {
    var first: Int32
    var second: Int64
}

// §12.4 hygiene + identifier-position splices: `gensym("hint")` yields a fresh,
// collision-free identifier on every call. Here `@seeded` binds one to `h`,
// names a private helper with it (`func $(h)()`), and then *calls* that helper
// from a public wrapper — `$(h)()`, where `$(h)` sits in call-callee position,
// splices as an identifier reference (not a string literal). Applied to the two
// structs below, each gets its own uniquely named helper (`__vstr_helper_h0`,
// `__vstr_helper_h1`) so the two never collide, and both `SeedN_seed()` call
// their own.
comptime func seeded(_ d: Decl) -> [Decl] {
    let h = gensym("helper")
    return quote {
        $d
        func $(h)() -> Int32 { return 7 }
        func $(d.name + "_seed")() -> Int32 { return $(h)() }
    }
}

@seeded
struct Seed1 {
    var a: Int32
}

@seeded
struct Seed2 {
    var b: Int32
}
