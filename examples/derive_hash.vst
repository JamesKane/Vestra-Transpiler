// §12.3 derive(Hash) demo: structural hashing without writing it.
//
// `derive(Hash) for T` emits a `std::hash<T>` specialization that
// boost-combines each field's std::hash. Combined with `derive(Eq)`
// for the same type, T immediately becomes usable as a key in
// std::unordered_map / std::unordered_set.
//
// The specialization is emitted at global scope (after the module's
// namespace closes) because `std::hash` is in the `std` namespace and
// the spec requires user specializations to be at namespace ::std.
//
// Hash and Eq compose: a derived-Eq nested member with derived-Hash
// participates in both equality AND hashing without extra work.

module examples.derive_hash

struct Point {
    var x: Int32
    var y: Int32
}

derive(Eq, Hash) for Point

func make_point(_ x: Int32, _ y: Int32) -> Point {
    return Point(x: x, y: y)
}

// Payloaded enum — the std::variant wrapper isn't hashable by default,
// so derive(Hash) emits a std::visit-based spec that combines each
// active case's payload AND seeds with the alt index so different
// cases with equal payload bytes still hash distinctly.
enum Shape {
    case circle(radius: Float64)
    case rect(width: Float64, height: Float64)
    case point
}

derive(Eq, Hash) for Shape

func make_circle(_ r: Float64) -> Shape { return Shape.circle(radius: r) }
func make_rect(_ w: Float64, _ h: Float64) -> Shape { return Shape.rect(width: w, height: h) }
