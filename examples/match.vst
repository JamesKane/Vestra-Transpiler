// Match-expression lowering demo.
//
// `match` on a payloaded enum lowers to `std::visit(...)` over the
// underlying `std::variant`, with a constexpr-if chain dispatching on
// each alternative's type. Bindings inside an arm pattern (`let r`,
// `let w`, `let h`) become `auto&&` aliases over the corresponding
// payload field — labeled fields use the field's name, positional
// fields use `_0`, `_1`, … in source order. The whole match is one
// expression that returns the arm's value.
//
// Sema verifies arm-by-arm exhaustiveness for enum scrutinees so the
// trailing `else { std::unreachable(); }` branch the emitter inserts
// to satisfy C++'s "all paths must return" rule never actually fires
// at runtime — it exists only to keep the compiler quiet when the
// user hasn't written a `default` arm.

module examples.matchdemo

enum Shape {
    case circle(radius: Float64)
    case rect(width: Float64, height: Float64)
    case point
}

func area(_ s: Shape) -> Float64 {
    return match s {
        case .circle(let r):       3.141592653589793 * r * r
        case .rect(let w, let h):  w * h
        case .point:               0.0
    }
}

// Sum of areas of the three sample shapes: a unit circle (π),
// a 3x4 rectangle (12), and a point (0). Total = 12 + π.
func sample_total() -> Float64 {
    let c: Shape = Shape.circle(radius: 1.0)
    let r: Shape = Shape.rect(width: 3.0, height: 4.0)
    let p: Shape = Shape.point
    return area(c) + area(r) + area(p)
}

// §17.7 or-pattern over payloaded-enum cases: two alternatives that bind the
// same payload name share one arm body. Each alternative becomes its own
// constexpr-if branch over the variant, binding its own field to `n`.
enum Event {
    case keyDown(Int32)
    case keyUp(Int32)
    case quit
}

// A key event (down or up) yields its keycode; quit yields -1.
func keycode(_ e: Event) -> Int32 {
    return match e {
        case .keyDown(n) | .keyUp(n): n
        case .quit: -1
    }
}
