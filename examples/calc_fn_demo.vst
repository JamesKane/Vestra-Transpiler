// User-defined functions — the mini-language becomes (recursively) programmable.
// A `fn name(p) = expr` definition records the function; a call `name(arg)` binds
// the argument and evaluates the body. Functions are single-argument and may
// recurse, so the language can express factorial and Fibonacci:
//
//   fn fact(n) = if n < 2 then 1 else n * fact(n - 1);  fact(5)     -> 120
//   fn fib(n)  = if n < 2 then n else fib(n-1) + fib(n-2);  fib(7)  -> 13
//
// Two pieces make recursion work. (1) A function is stored as the *start index*
// of its body in the token stream (the body is one expression, so re-running the
// parser from there consumes exactly it); a call re-runs the parser over that
// body with a fresh single-binding environment. (2) The conditional is now
// *lazy*: a `live` flag threads through the parser, and the untaken `if` branch
// is parsed-but-not-evaluated (no recursive call fires) — without that, the
// recursive branch of the base case would evaluate forever.

module examples.calc_fn_demo

enum Tok {
    case num
    case ident
    case kwFn
    case kwIf
    case kwThen
    case kwElse
    case plus
    case minus
    case star
    case slash
    case lt
    case gt
    case lparen
    case rparen
    case assign
    case semicolon
    case end
    case bad
}

struct Token {
    let kind: Tok
    let value: Int
    let name: Str
}

// ---- lexer -----------------------------------------------------------------

func punct(_ c: Char) -> Tok {
    if c == '+' { return .plus }
    if c == '-' { return .minus }
    if c == '*' { return .star }
    if c == '/' { return .slash }
    if c == '<' { return .lt }
    if c == '>' { return .gt }
    if c == '(' { return .lparen }
    if c == ')' { return .rparen }
    if c == '=' { return .assign }
    if c == ';' { return .semicolon }
    return .bad
}

func wordKind(_ nm: Str) -> Tok {
    return match nm {
        case "fn": .kwFn
        case "if": .kwIf
        case "then": .kwThen
        case "else": .kwElse
        default: .ident
    }
}

func lex(_ s: Str) using Alloc -> Vec[Token] {
    var toks: Vec[Token] = Vec.new()
    var i: Int = 0
    while i < s.len() {
        let c = s.charAt(i) ?? ' '
        if c.isSpace() {
            i = i + 1
        } else if c.isDigit() {
            let start = i
            while i < s.len() && (s.charAt(i) ?? ' ').isDigit() {
                i = i + 1
            }
            let v = s.slice(start, i).toInt() ?? 0
            toks.push(Token(kind: .num, value: v, name: ""))
        } else if c.isAlpha() {
            let start = i
            while i < s.len() && (s.charAt(i) ?? ' ').isAlnum() {
                i = i + 1
            }
            let nm = s.slice(start, i)
            toks.push(Token(kind: wordKind(nm), value: 0, name: nm))
        } else {
            toks.push(Token(kind: punct(c), value: 0, name: ""))
            i = i + 1
        }
    }
    toks.push(Token(kind: .end, value: 0, name: ""))
    return toks
}

func peekKind(_ ts: Vec[Token], _ i: Int) -> Tok {
    if let t = ts.get(i) {
        return t.kind
    }
    return Tok.end
}

func peekVal(_ ts: Vec[Token], _ i: Int) -> Int {
    if let t = ts.get(i) {
        return t.value
    }
    return 0
}

func peekName(_ ts: Vec[Token], _ i: Int) -> Str {
    if let t = ts.get(i) {
        return t.name
    }
    return ""
}

// ---- parser + evaluator ----------------------------------------------------
//
// The evaluation context threads through every rule: `env` is the current
// (single-binding) variable scope, `fparam` / `fbody` are the global function
// table (name -> parameter name, name -> body start index), and `live` is false
// while skipping an untaken branch (parse to advance the cursor, but evaluate
// nothing — in particular, fire no function call).

func callFunc(_ ts: Vec[Token], _ name: Str, _ arg: Int, _ fparam: HashMap[Str, Str],
              _ fbody: HashMap[Str, Int]) using Alloc -> Int {
    if let start = fbody.get(name) {
        let pname = fparam.get(name) ?? ""
        var callEnv: HashMap[Str, Int] = HashMap.new()
        callEnv.set(pname, arg)
        var bi: Int = start
        return pExpr(ts, &bi, callEnv, fparam, fbody, true)
    }
    return 0
}

func pFactor(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int],
             _ fparam: HashMap[Str, Str], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Int {
    let k = peekKind(ts, i)
    if k == Tok.num {
        let v = peekVal(ts, i)
        i = i + 1
        return v
    }
    if k == Tok.ident {
        let name = peekName(ts, i)
        if peekKind(ts, i + 1) == Tok.lparen {
            // a call: name '(' expr ')'
            i = i + 2  // skip the name and '('
            let arg = pExpr(ts, &i, env, fparam, fbody, live)
            i = i + 1  // consume ')'
            if live {
                return callFunc(ts, name, arg, fparam, fbody)
            }
            return 0
        }
        i = i + 1  // a variable reference
        if live {
            return env.get(name) ?? 0
        }
        return 0
    }
    if k == Tok.lparen {
        i = i + 1
        let v = pExpr(ts, &i, env, fparam, fbody, live)
        i = i + 1  // consume ')'
        return v
    }
    i = i + 1
    return 0
}

func pTerm(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int],
           _ fparam: HashMap[Str, Str], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Int {
    var acc: Int = pFactor(ts, &i, env, fparam, fbody, live)
    var more: Bool = true
    while more {
        let k = peekKind(ts, i)
        if k == Tok.star {
            i = i + 1
            acc = acc * pFactor(ts, &i, env, fparam, fbody, live)
        } else if k == Tok.slash {
            i = i + 1
            let d = pFactor(ts, &i, env, fparam, fbody, live)
            if d != 0 {
                acc = acc / d
            } else {
                acc = 0
            }
        } else {
            more = false
        }
    }
    return acc
}

func pSum(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int],
          _ fparam: HashMap[Str, Str], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Int {
    var acc: Int = pTerm(ts, &i, env, fparam, fbody, live)
    var more: Bool = true
    while more {
        let k = peekKind(ts, i)
        if k == Tok.plus {
            i = i + 1
            acc = acc + pTerm(ts, &i, env, fparam, fbody, live)
        } else if k == Tok.minus {
            i = i + 1
            acc = acc - pTerm(ts, &i, env, fparam, fbody, live)
        } else {
            more = false
        }
    }
    return acc
}

func pCmp(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int],
          _ fparam: HashMap[Str, Str], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Int {
    let a = pSum(ts, &i, env, fparam, fbody, live)
    let k = peekKind(ts, i)
    if k == Tok.lt {
        i = i + 1
        let b = pSum(ts, &i, env, fparam, fbody, live)
        if a < b {
            return 1
        }
        return 0
    }
    if k == Tok.gt {
        i = i + 1
        let b = pSum(ts, &i, env, fparam, fbody, live)
        if a > b {
            return 1
        }
        return 0
    }
    return a
}

// expr = 'if' cmp 'then' expr 'else' expr | cmp. Lazy: only the taken branch is
// evaluated, so a recursive call in the untaken branch does not fire.
func pExpr(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int],
          _ fparam: HashMap[Str, Str], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Int {
    if peekKind(ts, i) == Tok.kwIf {
        i = i + 1  // consume 'if'
        let c = pCmp(ts, &i, env, fparam, fbody, live)
        if peekKind(ts, i) == Tok.kwThen {
            i = i + 1
        }
        let t = pExpr(ts, &i, env, fparam, fbody, live && c != 0)
        if peekKind(ts, i) == Tok.kwElse {
            i = i + 1
        }
        let e = pExpr(ts, &i, env, fparam, fbody, live && c == 0)
        if c != 0 {
            return t
        }
        return e
    }
    return pCmp(ts, &i, env, fparam, fbody, live)
}

// ---- the program driver ----------------------------------------------------

func runProgram(_ s: Str) using Alloc -> Int {
    let toks = lex(s)
    var env: HashMap[Str, Int] = HashMap.new()
    var fparam: HashMap[Str, Str] = HashMap.new()
    var fbody: HashMap[Str, Int] = HashMap.new()
    var i: Int = 0
    var last: Int = 0
    var more: Bool = true
    while more {
        let k = peekKind(toks, i)
        if k == Tok.end {
            more = false
        } else if k == Tok.kwFn {
            i = i + 1  // 'fn'
            let name = peekName(toks, i)
            i = i + 2  // skip the name and '('
            let pname = peekName(toks, i)
            i = i + 2  // skip the parameter and ')'
            i = i + 1  // skip '='
            let bodyStart = i
            // Skip past the body to find where it ends (parse, don't evaluate).
            // The function is registered *after* this, so a self-call here fires
            // nothing and merely advances the cursor.
            let skip = pExpr(toks, &i, env, fparam, fbody, false)
            fparam.set(name, pname)
            fbody.set(name, bodyStart)
        } else if k == Tok.ident && peekKind(toks, i + 1) == Tok.assign {
            let name = peekName(toks, i)
            i = i + 2  // skip the name and '='
            let v = pExpr(toks, &i, env, fparam, fbody, true)
            env.set(name, v)
            last = v
        } else {
            last = pExpr(toks, &i, env, fparam, fbody, true)
        }
        if peekKind(toks, i) == Tok.semicolon {
            i = i + 1
        }
    }
    return last
}
