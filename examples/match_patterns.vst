// §17.7 pattern matching enhancements — the four shapes that complete
// the basic match story:
//
//   * Literal patterns: `case 1:` / `case "hello":`
//   * Or-patterns:     `case .red | .green:` / `case 1 | 2 | 3:`
//   * Range patterns:  `case 0..<10:` (exclusive) / `case 90..100:` (inclusive)
//   * Tuple-scrutinee: `match tup { case (1, _): … }`
//
// Bare-enum matches keep the switch lowering — `case .red | .green:`
// stacks both labels above one return. Non-enum scrutinees go through
// an if-else-if chain over per-pattern predicates; tuple patterns
// compose via `std::get<i>` element accessors.

module examples.match_patterns

// --- bare-enum or-pattern -------------------------------------------------

enum Color {
    case red
    case green
    case blue
    case yellow
}

func isWarm(_ c: Color) -> Int32 {
    return match c {
        case .red | .green | .yellow: 1
        case .blue: 0
    }
}

// --- integer scrutinee: literal + or + range arms --------------------------

func bucket(_ n: Int32) -> Int32 {
    return match n {
        case 0: 0
        case 1 | 2 | 3: 1
        case 4..<10: 2     // exclusive: matches 4..9
        case 10..20: 3     // inclusive: matches 10..20
        default: -1
    }
}

// Inclusive vs exclusive range — the upper bound's relation to the
// scrutinee differs by one. Letter-grade style: F < 60, then 60..70,
// 70..80, 80..90, 90..100 (where the last is inclusive of 100).
func grade(_ score: Int32) -> Int32 {
    return match score {
        case 0..<60:  0
        case 60..<70: 1
        case 70..<80: 2
        case 80..<90: 3
        case 90..100: 4
        default: -1
    }
}

// --- tuple-scrutinee match -----------------------------------------------

// Classify a point on the coordinate plane.
func quadrant(_ p: (Int32, Int32)) -> Int32 {
    return match p {
        case (0, 0): 0
        case (0, _): 1
        case (_, 0): 2
        default: 3
    }
}
