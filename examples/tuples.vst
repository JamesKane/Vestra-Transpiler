// §6 tuple types, literals, and destructuring patterns.
//
//   * Type:        `(T1, T2, ...)` — at least two elements.
//   * Literal:     `(e1, e2, ...)` — same shape, expression position.
//   * Destructure: `let (a, b) = pair` and the same in `var` / `for`.
//
// Tuples lower to C++ `std::tuple<…>`; literals to `std::tuple{…}`
// (CTAD picks element types); destructuring to a structured binding
// `auto [a, b] = expr;`.

module examples.tuples

// Returns multiple values without a struct.
func div_mod(_ a: Int32, _ b: Int32) -> (Int32, Int32) {
    return (a / b, a % b)
}

// Destructure into both bindings.
func combine(_ a: Int32, _ b: Int32) -> Int32 {
    let (q, r) = div_mod(a, b)
    return q * 10 + r
}

// Wildcards inside a tuple pattern — discard the second element.
func quotient(_ a: Int32, _ b: Int32) -> Int32 {
    let (q, _) = div_mod(a, b)
    return q
}

// Nested tuple patterns (`let ((a, b), c) = ...`) round-trip too via
// a sibling-statement hoist — see examples/nested_tuples.vst.
