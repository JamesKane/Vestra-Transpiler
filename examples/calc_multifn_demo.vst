// Multi-argument functions. The single-parameter functions of calc_fn_demo grow
// a comma-separated parameter list, so the language can express binary (and
// n-ary) operations — max, gcd, power:
//
//   fn max(a, b) = if a < b then b else a;            max(3, 7)   -> 7
//   fn pow(b, e) = if e < 1 then 1 else b * pow(b, e - 1);  pow(2, 10) -> 1024
//   fn gcd(a, b) = if b < 1 then a else gcd(b, a - (a / b) * b);  gcd(48, 36) -> 12
//
// The function table now stores each function's parameter list as a `Vec[Str]`
// (a value in a `HashMap[Str, Vec[Str]]`); a call collects its argument values
// into a `Vec[Int]` and binds them positionally into a fresh environment. The
// lazy conditional (the `live` flag) still gates recursion, so a recursive call
// in an untaken branch does not fire.

module examples.calc_multifn_demo

enum Tok {
    case num
    case ident
    case kwFn
    case kwIf
    case kwThen
    case kwElse
    case plus
    case minus
    case star
    case slash
    case lt
    case gt
    case lparen
    case rparen
    case comma
    case assign
    case semicolon
    case end
    case bad
}

struct Token {
    let kind: Tok
    let value: Int
    let name: Str
}

// ---- lexer -----------------------------------------------------------------

func punct(_ c: Char) -> Tok {
    if c == '+' { return .plus }
    if c == '-' { return .minus }
    if c == '*' { return .star }
    if c == '/' { return .slash }
    if c == '<' { return .lt }
    if c == '>' { return .gt }
    if c == '(' { return .lparen }
    if c == ')' { return .rparen }
    if c == ',' { return .comma }
    if c == '=' { return .assign }
    if c == ';' { return .semicolon }
    return .bad
}

func wordKind(_ nm: Str) -> Tok {
    return match nm {
        case "fn": .kwFn
        case "if": .kwIf
        case "then": .kwThen
        case "else": .kwElse
        default: .ident
    }
}

func lex(_ s: Str) using Alloc -> Vec[Token] {
    var toks: Vec[Token] = Vec.new()
    var i: Int = 0
    while i < s.len() {
        let c = s.charAt(i) ?? ' '
        if c.isSpace() {
            i = i + 1
        } else if c.isDigit() {
            let start = i
            while i < s.len() && (s.charAt(i) ?? ' ').isDigit() {
                i = i + 1
            }
            let v = s.slice(start, i).toInt() ?? 0
            toks.push(Token(kind: .num, value: v, name: ""))
        } else if c.isAlpha() {
            let start = i
            while i < s.len() && (s.charAt(i) ?? ' ').isAlnum() {
                i = i + 1
            }
            let nm = s.slice(start, i)
            toks.push(Token(kind: wordKind(nm), value: 0, name: nm))
        } else {
            toks.push(Token(kind: punct(c), value: 0, name: ""))
            i = i + 1
        }
    }
    toks.push(Token(kind: .end, value: 0, name: ""))
    return toks
}

func peekKind(_ ts: Vec[Token], _ i: Int) -> Tok {
    if let t = ts.get(i) {
        return t.kind
    }
    return Tok.end
}

func peekVal(_ ts: Vec[Token], _ i: Int) -> Int {
    if let t = ts.get(i) {
        return t.value
    }
    return 0
}

func peekName(_ ts: Vec[Token], _ i: Int) -> Str {
    if let t = ts.get(i) {
        return t.name
    }
    return ""
}

// ---- parser + evaluator ----------------------------------------------------
//
// Context: `env` is the current scope, `fparams` / `fbody` are the function
// table (name -> parameter names, name -> body start index), and `live` is false
// while skipping an untaken branch.

func callFunc(_ ts: Vec[Token], _ name: Str, _ args: Vec[Int],
              _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int]) using Alloc -> Int {
    if let start = fbody.get(name) {
        if let params = fparams.get(name) {
            var callEnv: HashMap[Str, Int] = HashMap.new()
            var j: Int = 0
            while j < params.len() && j < args.len() {
                callEnv.set(params.get(j) ?? "", args.get(j) ?? 0)
                j = j + 1
            }
            var bi: Int = start
            return pExpr(ts, &bi, callEnv, fparams, fbody, true)
        }
    }
    return 0
}

func pFactor(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int],
             _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Int {
    let k = peekKind(ts, i)
    if k == Tok.num {
        let v = peekVal(ts, i)
        i = i + 1
        return v
    }
    if k == Tok.ident {
        let name = peekName(ts, i)
        if peekKind(ts, i + 1) == Tok.lparen {
            // a call: name '(' (expr (',' expr)*)? ')'
            i = i + 2  // skip the name and '('
            var args: Vec[Int] = Vec.new()
            if peekKind(ts, i) != Tok.rparen {
                args.push(pExpr(ts, &i, env, fparams, fbody, live))
                while peekKind(ts, i) == Tok.comma {
                    i = i + 1
                    args.push(pExpr(ts, &i, env, fparams, fbody, live))
                }
            }
            i = i + 1  // consume ')'
            if live {
                return callFunc(ts, name, args, fparams, fbody)
            }
            return 0
        }
        i = i + 1  // a variable reference
        if live {
            return env.get(name) ?? 0
        }
        return 0
    }
    if k == Tok.lparen {
        i = i + 1
        let v = pExpr(ts, &i, env, fparams, fbody, live)
        i = i + 1  // consume ')'
        return v
    }
    i = i + 1
    return 0
}

func pTerm(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int],
           _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Int {
    var acc: Int = pFactor(ts, &i, env, fparams, fbody, live)
    var more: Bool = true
    while more {
        let k = peekKind(ts, i)
        if k == Tok.star {
            i = i + 1
            acc = acc * pFactor(ts, &i, env, fparams, fbody, live)
        } else if k == Tok.slash {
            i = i + 1
            let d = pFactor(ts, &i, env, fparams, fbody, live)
            if d != 0 {
                acc = acc / d
            } else {
                acc = 0
            }
        } else {
            more = false
        }
    }
    return acc
}

func pSum(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Int {
    var acc: Int = pTerm(ts, &i, env, fparams, fbody, live)
    var more: Bool = true
    while more {
        let k = peekKind(ts, i)
        if k == Tok.plus {
            i = i + 1
            acc = acc + pTerm(ts, &i, env, fparams, fbody, live)
        } else if k == Tok.minus {
            i = i + 1
            acc = acc - pTerm(ts, &i, env, fparams, fbody, live)
        } else {
            more = false
        }
    }
    return acc
}

func pCmp(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Int {
    let a = pSum(ts, &i, env, fparams, fbody, live)
    let k = peekKind(ts, i)
    if k == Tok.lt {
        i = i + 1
        let b = pSum(ts, &i, env, fparams, fbody, live)
        if a < b {
            return 1
        }
        return 0
    }
    if k == Tok.gt {
        i = i + 1
        let b = pSum(ts, &i, env, fparams, fbody, live)
        if a > b {
            return 1
        }
        return 0
    }
    return a
}

func pExpr(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Int],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Int {
    if peekKind(ts, i) == Tok.kwIf {
        i = i + 1  // consume 'if'
        let c = pCmp(ts, &i, env, fparams, fbody, live)
        if peekKind(ts, i) == Tok.kwThen {
            i = i + 1
        }
        let t = pExpr(ts, &i, env, fparams, fbody, live && c != 0)
        if peekKind(ts, i) == Tok.kwElse {
            i = i + 1
        }
        let e = pExpr(ts, &i, env, fparams, fbody, live && c == 0)
        if c != 0 {
            return t
        }
        return e
    }
    return pCmp(ts, &i, env, fparams, fbody, live)
}

// ---- the program driver ----------------------------------------------------

func runProgram(_ s: Str) using Alloc -> Int {
    let toks = lex(s)
    var env: HashMap[Str, Int] = HashMap.new()
    var fparams: HashMap[Str, Vec[Str]] = HashMap.new()
    var fbody: HashMap[Str, Int] = HashMap.new()
    var i: Int = 0
    var last: Int = 0
    var more: Bool = true
    while more {
        let k = peekKind(toks, i)
        if k == Tok.end {
            more = false
        } else if k == Tok.kwFn {
            i = i + 1  // 'fn'
            let name = peekName(toks, i)
            i = i + 2  // skip the name and '('
            // Parse the comma-separated parameter list.
            var params: Vec[Str] = Vec.new()
            if peekKind(toks, i) != Tok.rparen {
                params.push(peekName(toks, i))
                i = i + 1
                while peekKind(toks, i) == Tok.comma {
                    i = i + 1
                    params.push(peekName(toks, i))
                    i = i + 1
                }
            }
            i = i + 1  // ')'
            i = i + 1  // '='
            let bodyStart = i
            // Skip the body to advance the cursor (registered afterwards, so a
            // self-call here fires nothing).
            let skip = pExpr(toks, &i, env, fparams, fbody, false)
            fparams.set(name, params)
            fbody.set(name, bodyStart)
        } else if k == Tok.ident && peekKind(toks, i + 1) == Tok.assign {
            let name = peekName(toks, i)
            i = i + 2  // skip the name and '='
            let v = pExpr(toks, &i, env, fparams, fbody, true)
            env.set(name, v)
            last = v
        } else {
            last = pExpr(toks, &i, env, fparams, fbody, true)
        }
        if peekKind(toks, i) == Tok.semicolon {
            i = i + 1
        }
    }
    return last
}
