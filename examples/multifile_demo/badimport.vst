// §5 negative test (see tests/CMakeLists.txt e2e_multifile_visibility): `helper`
// is an `internal` (non-public) decl of util.math, so it is NOT exported and
// referencing it here must fail to resolve. `vestra check` on this file is
// expected to error.

module demo.bad

import util.math

func nope() -> Int32 {
    return util.math.helper(1)
}
