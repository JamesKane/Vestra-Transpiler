// §5 multi-file: a library module imported by examples/multifile_demo/main.vst.
// Its `module util.math` path mirrors its location under the entry file's
// directory (util/math.vst), which is how `import util.math` finds it.

module util.math

// Only `public` decls are exported to importers; `helper` below stays
// module-private and is not visible from main.vst.
public func add(_ a: Int32, _ b: Int32) -> Int32 {
    return helper(a) + b
}

public const answer: Int32 = 42

func helper(_ x: Int32) -> Int32 {
    return x
}
