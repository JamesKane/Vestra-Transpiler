// §5 multi-file: a library module imported by examples/multifile_demo/main.vst.
// Its `module util.math` path mirrors its location under the entry file's
// directory (util/math.vst), which is how `import util.math` finds it.

module util.math

// Only `public` decls are exported to importers; `helper` below stays
// module-private and is not visible from main.vst.
public func add(_ a: Int32, _ b: Int32) -> Int32 {
    return helper(a) + b
}

public const answer: Int32 = 42

func helper(_ x: Int32) -> Int32 {
    return x
}

// §5 a public struct export, reached from main as the qualified type
// `util.math.Pair` — used in a type annotation, constructed, and field-read.
public struct Pair {
    var lo: Int32
    var hi: Int32
}

// §5 a public function whose signature mentions the module's own type. The
// importer can call `util.math.combine(p)` even though `Pair` isn't in its
// scope: the signature is resolved here (in util.math) and the importer reuses
// the resolved symbol rather than re-deriving it.
public func combine(_ p: Pair) -> Int32 {
    return p.lo + p.hi
}

// §7/§5 a public *generic* struct export, reached from main as the qualified
// generic type `util.math.Boxed[Int32]` — the type arguments bind onto the
// imported nominal so field access substitutes them.
public struct Boxed[T] {
    var item: T
}
