// §5 multi-file demo. `import util.math` loads util/math.vst relative to this
// (the entry) file's directory; its public members are reached through a
// qualified reference (`util.math.add`), which lowers to `util::math::add`.
// Imports do not enter the unqualified scope, so a local can freely reuse an
// imported name — `add` below is the local one, distinct from util.math.add.

module demo.app

import util.math

func add(_ a: Int32, _ b: Int32) -> Int32 {
    return a - b  // a deliberately-different local `add` (subtracts)
}

func compute() -> Int32 {
    return util.math.add(40, 2)  // the imported add: 42
}

func localAdd() -> Int32 {
    return add(40, 2)  // the local add: 38
}

func viaConst() -> Int32 {
    return util.math.answer
}

// §5 cross-module struct type: name `util.math.Pair` as a type, construct it,
// and read its fields — all qualified, lowering to `util::math::Pair`.
func pairSum() -> Int32 {
    let p: util.math.Pair = util.math.Pair(lo: 40, hi: 2)
    return p.lo + p.hi
}

// §5 pass an imported struct to an imported function whose signature mentions
// it — works because util.math's resolved `combine` signature is reused here.
func combined() -> Int32 {
    return util.math.combine(util.math.Pair(lo: 40, hi: 2))
}

// §5 computed/inferred imported type: `Vec.new()` for a `Vec[util.math.Pair]`
// lowers its element type through emit_sema_type (the std::vector<...>{} the
// construction emits is not spelled from an annotation), so the imported
// nominal is fully qualified to `util::math::Pair` without any
// `using namespace`. Builds the vector, then folds the one pushed pair.
func pairVecSum() using Alloc -> Int32 {
    var v: Vec[util.math.Pair] = Vec.new()
    v.push(util.math.Pair(lo: 40, hi: 2))
    return v[0].lo + v[0].hi
}

// §7/§5 generic imported type: `util.math.Boxed[Int32]` binds the type argument
// onto the imported nominal, so the annotation resolves to the instance,
// construction infers it, and the field read yields Int32 (not the unbound T).
func boxedValue() -> Int32 {
    let b: util.math.Boxed[Int32] = util.math.Boxed(item: 42)
    return b.item
}
