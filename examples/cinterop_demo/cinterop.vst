// §5 C interop. `import c "clib.h"` lowers to a global-scope `#include "clib.h"`
// in the generated header — Vestra does not parse the C header, it just pulls
// the canonical declarations into the translation unit. The foreign symbol
// itself is declared in-tree via `@extern` (§14.6), mirroring the C prototype;
// the include lets the C++ compiler cross-check that declaration against the
// header and makes any types/macros it defines visible. Here `cdemo_value` is
// defined inline in clib.h, so the call links against that definition.
//
// No `module` declaration: the unit's decls stay at global scope so the
// `@extern` name matches the header's global `cdemo_value`.

import c "clib.h"

@extern("C") func cdemo_value() -> Int32

// Call the C function pulled in by the include.
func answer() -> Int32 {
    return cdemo_value()
}
