// A string-keyed value map: the interpreter's first *compound* data type. The
// tagged `Value` gains a fourth case, `case map(HashMap[String, Value])`, which
// makes `Value` *recursive* (a map holds values, a value may be a map) and gives
// it its first move-only heap container payload. Four builtins operate on it:
//
//   mapNew()          -> Map    a fresh empty map
//   put(m, k, v)      -> Map    a new map = m with key k bound to v (functional)
//   get(m, k)         -> Value  the value at k, or 0 when absent
//   has(m, k)         -> Bool   whether k is bound
//
// Maps are *value-semantic and functional*: `put` copies the map, inserts, and
// returns the new map (so `m = put(m, k, v)` is the update idiom), exactly like a
// map-containing `Value` already copies when read back out of the environment.
// Keys are owned `String`s (not `Str` views), so a *computed* key (`"k" + "ey"`)
// is safe — the map owns its key bytes rather than borrowing a temporary. Maps
// nest (`get(get(m, "inner"), "x")`) and support a frequency-count idiom
// (`put(c, k, get(c, k) + 1)`). The probe behind this slice confirmed a recursive
// `enum` through `HashMap`, the env round-trip of a map value, and a deep-copying
// functional `put`, all with no compiler change.
//
//   m = put(mapNew(), "name", "Vestra");  print get(m, "name")   -> Vestra
//   print has(m, "name"), has(m, "nope")                         -> true false

enum Tok {
    case num
    case strlit
    case ident
    case kwFn
    case kwIf
    case kwThen
    case kwElse
    case kwWhile
    case kwDo
    case kwPrint
    case kwTrue
    case kwFalse
    case plus
    case minus
    case star
    case slash
    case lt
    case gt
    case eq
    case lparen
    case rparen
    case lbrace
    case rbrace
    case comma
    case assign
    case semicolon
    case end
    case bad
}

struct Token {
    let kind: Tok
    let value: Int
    let name: Str
}

enum Value {
    case int(Int)
    case boolean(Bool)
    case str(String)
    case map(HashMap[String, Value])
}

// ---- value helpers ---------------------------------------------------------

func strOf(_ s: Str) using Alloc -> String {
    var out: String = ""
    out.append(s)
    return out
}

func boolStr(_ b: Bool) using Alloc -> String {
    if b {
        var t: String = "true"
        return t
    }
    var f: String = "false"
    return f
}

// Render a value by its tag (also the rendering used when concatenating). A map
// renders as a fixed placeholder: its entry order is unspecified, so printing the
// contents would not be deterministic — programs read individual keys instead.
func format(_ v: Value) using Alloc -> String {
    return match v {
        case .int(let n): n.toString()
        case .boolean(let b): boolStr(b)
        case .str(let s): strOf(s)
        case .map(let m): strOf("<map>")
    }
}

// Coerce to an integer for arithmetic (a bool is 1/0, a string / map is 0).
func asInt(_ v: Value) -> Int {
    return match v {
        case .int(let n): n
        case .boolean(let b): if b { 1 } else { 0 }
        case .str(let s): 0
        case .map(let m): 0
    }
}

// Truthiness for `if` / `while`: a nonzero int, a true bool, any string, any map.
func truthy(_ v: Value) -> Bool {
    return match v {
        case .int(let n): n != 0
        case .boolean(let b): b
        case .str(let s): true
        case .map(let m): true
    }
}

// Does this value carry a string payload? (selects `+` concatenation vs add).
func isStr(_ v: Value) -> Bool {
    return match v {
        case .int(let n): false
        case .boolean(let b): false
        case .str(let s): true
        case .map(let m): false
    }
}

// Byte length of a string value (0 for non-strings) — the `len` builtin.
func strLen(_ v: Value) -> Int {
    return match v {
        case .str(let s): s.len()
        default: 0
    }
}

// The [from, to) sub-string of a string value as a fresh owned String (clamped
// into range by `slice`; an empty string for non-strings) — the `substr` builtin.
func substrVal(_ v: Value, _ from: Int, _ to: Int) using Alloc -> Value {
    return match v {
        case .str(let s): Value.str(strOf(s.slice(from, to)))
        default: Value.str(strOf(""))
    }
}

// Index of the first occurrence of `needle` in `hay`, or -1 (when absent, or
// when either operand is not a string) — the `find` builtin.
func findVal(_ hay: Value, _ needle: Value) -> Int {
    return match hay {
        case .str(let h): match needle {
            case .str(let n): h.find(n) ?? -1
            default: -1
        }
        default: -1
    }
}

// Whether `needle` occurs anywhere in `hay` (false unless both are strings) —
// the `contains` builtin.
func containsVal(_ hay: Value, _ needle: Value) -> Bool {
    return match hay {
        case .str(let h): match needle {
            case .str(let n): h.contains(n)
            default: false
        }
        default: false
    }
}

// Structural equality: same tag and equal payload; cross-type is never equal. A
// map compares unequal to everything (deep map equality is out of scope here).
func valEq(_ a: Value, _ b: Value) -> Bool {
    return match a {
        case .int(let x): match b {
            case .int(let y): x == y
            default: false
        }
        case .boolean(let x): match b {
            case .boolean(let y): x == y
            default: false
        }
        case .str(let x): match b {
            case .str(let y): x == y
            default: false
        }
        case .map(let x): false
    }
}

// ---- map value: the first compound data type -------------------------------

// A fresh empty map value.
func mapNew() using Alloc -> Value {
    var m: HashMap[String, Value] = HashMap.new()
    return Value.map(m)
}

// Functional insert: copy the backing map, bind an owned-String key to `val`, and
// return the new map value. The key is copied (`strOf`) so the map owns its bytes.
func putInto(_ m: HashMap[String, Value], _ k: Str, _ val: Value) using Alloc -> Value {
    var dup: HashMap[String, Value] = m
    dup.set(strOf(k), val)
    return Value.map(dup)
}

// put(m, k, v): a new map = m with key k (a string value) bound to v.
func putVal(_ mv: Value, _ kv: Value, _ val: Value) using Alloc -> Value {
    return match mv {
        case .map(let m): match kv {
            case .str(let k): putInto(m, k, val)
            default: mv
        }
        default: mv
    }
}

// get(m, k): the value bound to k, or `int(0)` when the map / key is absent.
func getVal(_ mv: Value, _ kv: Value) using Alloc -> Value {
    return match mv {
        case .map(let m): match kv {
            case .str(let k): m.get(k) ?? Value.int(0)
            default: Value.int(0)
        }
        default: Value.int(0)
    }
}

// has(m, k): whether k is bound in the map.
func hasVal(_ mv: Value, _ kv: Value) -> Bool {
    return match mv {
        case .map(let m): match kv {
            case .str(let k): hasKey(m, k)
            default: false
        }
        default: false
    }
}

func hasKey(_ m: HashMap[String, Value], _ k: Str) -> Bool {
    if let found = m.get(k) {
        return true
    }
    return false
}

// ---- lexer -----------------------------------------------------------------

func punct(_ c: Char) -> Tok {
    if c == '+' { return .plus }
    if c == '-' { return .minus }
    if c == '*' { return .star }
    if c == '/' { return .slash }
    if c == '<' { return .lt }
    if c == '>' { return .gt }
    if c == '(' { return .lparen }
    if c == ')' { return .rparen }
    if c == '{' { return .lbrace }
    if c == '}' { return .rbrace }
    if c == ',' { return .comma }
    if c == '=' { return .assign }
    if c == ';' { return .semicolon }
    return .bad
}

func wordKind(_ nm: Str) -> Tok {
    return match nm {
        case "fn": .kwFn
        case "if": .kwIf
        case "then": .kwThen
        case "else": .kwElse
        case "while": .kwWhile
        case "do": .kwDo
        case "print": .kwPrint
        case "true": .kwTrue
        case "false": .kwFalse
        default: .ident
    }
}

func lex(_ s: Str) using Alloc -> Vec[Token] {
    var toks: Vec[Token] = Vec.new()
    var i: Int = 0
    while i < s.len() {
        let c = s.charAt(i) ?? ' '
        if c.isSpace() {
            i = i + 1
        } else if c.isDigit() {
            let start = i
            while i < s.len() && (s.charAt(i) ?? ' ').isDigit() {
                i = i + 1
            }
            let v = s.slice(start, i).toInt() ?? 0
            toks.push(Token(kind: .num, value: v, name: ""))
        } else if c == '"' {
            i = i + 1  // skip opening quote
            let start = i
            while i < s.len() && (s.charAt(i) ?? '"') != '"' {
                i = i + 1
            }
            let lit = s.slice(start, i)
            i = i + 1  // skip closing quote
            toks.push(Token(kind: .strlit, value: 0, name: lit))
        } else if c.isAlpha() {
            let start = i
            while i < s.len() && (s.charAt(i) ?? ' ').isAlnum() {
                i = i + 1
            }
            let nm = s.slice(start, i)
            toks.push(Token(kind: wordKind(nm), value: 0, name: nm))
        } else if c == '=' && (s.charAt(i + 1) ?? ' ') == '=' {
            toks.push(Token(kind: .eq, value: 0, name: ""))
            i = i + 2
        } else {
            toks.push(Token(kind: punct(c), value: 0, name: ""))
            i = i + 1
        }
    }
    toks.push(Token(kind: .end, value: 0, name: ""))
    return toks
}

func peekKind(_ ts: Vec[Token], _ i: Int) -> Tok {
    if let t = ts.get(i) {
        return t.kind
    }
    return Tok.end
}

func peekVal(_ ts: Vec[Token], _ i: Int) -> Int {
    if let t = ts.get(i) {
        return t.value
    }
    return 0
}

func peekName(_ ts: Vec[Token], _ i: Int) -> Str {
    if let t = ts.get(i) {
        return t.name
    }
    return ""
}

// ---- expression layer (reads the environment, produces a Value) ------------

func callFunc(_ ts: Vec[Token], _ name: Str, _ args: Vec[Value],
              _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int]) using Alloc -> Value {
    if let start = fbody.get(name) {
        if let params = fparams.get(name) {
            var callEnv: HashMap[Str, Value] = HashMap.new()
            var j: Int = 0
            while j < params.len() && j < args.len() {
                callEnv.set(params.get(j) ?? "", args.get(j) ?? Value.int(0))
                j = j + 1
            }
            var bi: Int = start
            return pExpr(ts, &bi, callEnv, fparams, fbody, true)
        }
    }
    // String builtins, a fallback for names a program did not define as `fn`s.
    return match name {
        case "len": Value.int(strLen(args.get(0) ?? Value.int(0)))
        case "substr": substrVal(args.get(0) ?? Value.int(0),
                                 asInt(args.get(1) ?? Value.int(0)),
                                 asInt(args.get(2) ?? Value.int(0)))
        case "find": Value.int(findVal(args.get(0) ?? Value.int(0),
                                       args.get(1) ?? Value.int(0)))
        case "contains": Value.boolean(containsVal(args.get(0) ?? Value.int(0),
                                                   args.get(1) ?? Value.int(0)))
        case "mapNew": mapNew()
        case "put": putVal(args.get(0) ?? Value.int(0),
                           args.get(1) ?? Value.int(0),
                           args.get(2) ?? Value.int(0))
        case "get": getVal(args.get(0) ?? Value.int(0),
                           args.get(1) ?? Value.int(0))
        case "has": Value.boolean(hasVal(args.get(0) ?? Value.int(0),
                                         args.get(1) ?? Value.int(0)))
        default: Value.int(0)
    }
}

func pFactor(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
             _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    let k = peekKind(ts, i)
    if k == Tok.num {
        let v = peekVal(ts, i)
        i = i + 1
        return Value.int(v)
    }
    if k == Tok.strlit {
        let s = peekName(ts, i)
        i = i + 1
        return Value.str(strOf(s))
    }
    if k == Tok.kwTrue {
        i = i + 1
        return Value.boolean(true)
    }
    if k == Tok.kwFalse {
        i = i + 1
        return Value.boolean(false)
    }
    if k == Tok.ident {
        let name = peekName(ts, i)
        if peekKind(ts, i + 1) == Tok.lparen {
            i = i + 2
            var args: Vec[Value] = Vec.new()
            if peekKind(ts, i) != Tok.rparen {
                args.push(pExpr(ts, &i, env, fparams, fbody, live))
                while peekKind(ts, i) == Tok.comma {
                    i = i + 1
                    args.push(pExpr(ts, &i, env, fparams, fbody, live))
                }
            }
            i = i + 1
            if live {
                return callFunc(ts, name, args, fparams, fbody)
            }
            return Value.int(0)
        }
        i = i + 1
        if live {
            return env.get(name) ?? Value.int(0)
        }
        return Value.int(0)
    }
    if k == Tok.lparen {
        i = i + 1
        let v = pExpr(ts, &i, env, fparams, fbody, live)
        i = i + 1
        return v
    }
    i = i + 1
    return Value.int(0)
}

func pTerm(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
           _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    let first = pFactor(ts, &i, env, fparams, fbody, live)
    let k0 = peekKind(ts, i)
    // Only when a `*` / `/` follows does this collapse to an integer; otherwise
    // the factor's value (and its type) is preserved.
    if k0 == Tok.star || k0 == Tok.slash {
        var acc: Int = asInt(first)
        var more: Bool = true
        while more {
            let k = peekKind(ts, i)
            if k == Tok.star {
                i = i + 1
                acc = acc * asInt(pFactor(ts, &i, env, fparams, fbody, live))
            } else if k == Tok.slash {
                i = i + 1
                let d = asInt(pFactor(ts, &i, env, fparams, fbody, live))
                if d != 0 {
                    acc = acc / d
                } else {
                    acc = 0
                }
            } else {
                more = false
            }
        }
        return Value.int(acc)
    }
    return first
}

func pSum(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    let first = pTerm(ts, &i, env, fparams, fbody, live)
    let k0 = peekKind(ts, i)
    // String-led `+`: if the left operand is a string, the whole run of `+`s
    // concatenates, each operand rendered by its tag. This builds a fresh,
    // *owned* String — the first heap-owned value the interpreter produces.
    if k0 == Tok.plus && isStr(first) {
        var acc: String = format(first)
        var more: Bool = true
        while more {
            let k = peekKind(ts, i)
            if k == Tok.plus {
                i = i + 1
                let r = pTerm(ts, &i, env, fparams, fbody, live)
                acc.append(format(r))
            } else {
                more = false
            }
        }
        return Value.str(acc)
    }
    if k0 == Tok.plus || k0 == Tok.minus {
        var acc: Int = asInt(first)
        var more: Bool = true
        while more {
            let k = peekKind(ts, i)
            if k == Tok.plus {
                i = i + 1
                acc = acc + asInt(pTerm(ts, &i, env, fparams, fbody, live))
            } else if k == Tok.minus {
                i = i + 1
                acc = acc - asInt(pTerm(ts, &i, env, fparams, fbody, live))
            } else {
                more = false
            }
        }
        return Value.int(acc)
    }
    return first
}

// cmp = sum (('<' | '>') sum)?  -> a boolean Value
func pCmp(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    let a = pSum(ts, &i, env, fparams, fbody, live)
    let k = peekKind(ts, i)
    if k == Tok.lt {
        i = i + 1
        let b = pSum(ts, &i, env, fparams, fbody, live)
        return Value.boolean(asInt(a) < asInt(b))
    }
    if k == Tok.gt {
        i = i + 1
        let b = pSum(ts, &i, env, fparams, fbody, live)
        return Value.boolean(asInt(a) > asInt(b))
    }
    return a
}

// eq = cmp ('==' cmp)?  -> a boolean Value (structural, across types)
func pEq(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
         _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    let a = pCmp(ts, &i, env, fparams, fbody, live)
    if peekKind(ts, i) == Tok.eq {
        i = i + 1
        let b = pCmp(ts, &i, env, fparams, fbody, live)
        return Value.boolean(valEq(a, b))
    }
    return a
}

// expr = 'if' expr 'then' expr 'else' expr | eq. The branches may have different
// value types; the taken one is returned.
func pExpr(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    if peekKind(ts, i) == Tok.kwIf {
        i = i + 1
        let c = pEq(ts, &i, env, fparams, fbody, live)
        let taken = truthy(c)
        if peekKind(ts, i) == Tok.kwThen {
            i = i + 1
        }
        let t = pExpr(ts, &i, env, fparams, fbody, live && taken)
        if peekKind(ts, i) == Tok.kwElse {
            i = i + 1
        }
        let e = pExpr(ts, &i, env, fparams, fbody, live && !taken)
        if taken {
            return t
        }
        return e
    }
    return pEq(ts, &i, env, fparams, fbody, live)
}

// ---- statement layer (mutates the environment, may print) ------------------

func pBlock(_ ts: Vec[Token], _ i: inout Int, _ env: inout HashMap[Str, Value],
            _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc, Log -> Value {
    i = i + 1  // consume '{'
    var last: Value = Value.int(0)
    var more: Bool = true
    while more {
        let k = peekKind(ts, i)
        if k == Tok.rbrace || k == Tok.end {
            more = false
        } else {
            last = pStmt(ts, &i, &env, fparams, fbody, live)
            if peekKind(ts, i) == Tok.semicolon {
                i = i + 1
            }
        }
    }
    if peekKind(ts, i) == Tok.rbrace {
        i = i + 1  // consume '}'
    }
    return last
}

// stmt = 'while' expr 'do' stmt | 'print' expr | block | ident '=' expr | expr
func pStmt(_ ts: Vec[Token], _ i: inout Int, _ env: inout HashMap[Str, Value],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc, Log -> Value {
    let k = peekKind(ts, i)
    if k == Tok.kwWhile {
        i = i + 1
        let condStart = i
        let cskip = pExpr(ts, &i, env, fparams, fbody, false)
        if peekKind(ts, i) == Tok.kwDo {
            i = i + 1
        }
        let bodyStart = i
        let bskip = pStmt(ts, &i, &env, fparams, fbody, false)
        let afterBody = i
        if live {
            var ci: Int = condStart
            var c: Value = pExpr(ts, &ci, env, fparams, fbody, true)
            var guard: Int = 0
            while truthy(c) && guard < 1000000 {
                var bi: Int = bodyStart
                let rb = pStmt(ts, &bi, &env, fparams, fbody, true)
                ci = condStart
                c = pExpr(ts, &ci, env, fparams, fbody, true)
                guard = guard + 1
            }
        }
        i = afterBody
        return Value.int(0)
    }
    if k == Tok.kwPrint {
        i = i + 1  // consume 'print'
        var last: Value = pExpr(ts, &i, env, fparams, fbody, live)
        // Render the comma-separated list into one space-separated line; print it
        // once. Building the line is harmless when skipping (live == false); only
        // the `println` is gated, so re-parsing a body advances `i` identically.
        var line: String = format(last)
        while peekKind(ts, i) == Tok.comma {
            i = i + 1
            let v = pExpr(ts, &i, env, fparams, fbody, live)
            line.append(" ")
            line.append(format(v))
            last = v
        }
        if live {
            println(line)
        }
        return last
    }
    if k == Tok.lbrace {
        return pBlock(ts, &i, &env, fparams, fbody, live)
    }
    if k == Tok.ident && peekKind(ts, i + 1) == Tok.assign {
        let name = peekName(ts, i)
        i = i + 2
        let v = pExpr(ts, &i, env, fparams, fbody, live)
        if live {
            env.set(name, v)
        }
        return Value.int(0)
    }
    return pExpr(ts, &i, env, fparams, fbody, live)
}

// ---- the program driver ----------------------------------------------------

func runProgram(_ s: Str) using Alloc, Log -> Value {
    let toks = lex(s)
    var env: HashMap[Str, Value] = HashMap.new()
    var fparams: HashMap[Str, Vec[Str]] = HashMap.new()
    var fbody: HashMap[Str, Int] = HashMap.new()
    var i: Int = 0
    var last: Value = Value.int(0)
    var more: Bool = true
    while more {
        let k = peekKind(toks, i)
        if k == Tok.end {
            more = false
        } else if k == Tok.kwFn {
            i = i + 1
            let name = peekName(toks, i)
            i = i + 2
            var params: Vec[Str] = Vec.new()
            if peekKind(toks, i) != Tok.rparen {
                params.push(peekName(toks, i))
                i = i + 1
                while peekKind(toks, i) == Tok.comma {
                    i = i + 1
                    params.push(peekName(toks, i))
                    i = i + 1
                }
            }
            i = i + 1
            i = i + 1
            let bodyStart = i
            let skip = pExpr(toks, &i, env, fparams, fbody, false)
            fparams.set(name, params)
            fbody.set(name, bodyStart)
        } else {
            last = pStmt(toks, &i, &env, fparams, fbody, true)
        }
        if peekKind(toks, i) == Tok.semicolon {
            i = i + 1
        }
    }
    return last
}

// ---- the executable: read a program file and run it ------------------------

func main() -> Int32 {
    with Alloc {
        with Fs {
            with Log {
                let argv = args()
                if argv.len() < 2 {
                    eprintln("usage: interp_map <program-file>")
                    return 1
                }
                let path = argv.get(1) ?? ""
                if let src = readFile(path) {
                    let result = runProgram(src)
                    print("result: ")
                    println(format(result))
                    return 0
                }
                eprintln("cannot read program file")
                return 1
            }
        }
    }
}
