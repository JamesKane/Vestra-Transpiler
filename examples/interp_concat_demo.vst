// String concatenation — the interpreter's first *heap-owned* value payload.
// interp_value_demo.vst gave the full interpreter a tagged `Value` whose `str`
// case held a `Str` *view* borrowing the program source. A concatenation result
// (`"a" + "b"`) is a fresh string that is not a slice of the source, so it has
// to be *owned*: this slice changes the payload to `case str(String)` and adds
// `+` over strings.
//
//   greeting = "Hello, " + "world";  print greeting   -> Hello, world
//   fn rep(s, n) = if n < 1 then "" else s + rep(s, n - 1);  rep("ab", 3) -> ababab
//   acc = ""; while i < 3 do { acc = acc + "x"; ... }        -> xxx
//
// `+` is string-led: if the left operand is a string the whole sum concatenates
// (each operand rendered by its tag, so `"n=" + 42` is `n=42`); otherwise `+`
// stays integer arithmetic. An owned-`String` `Value` rides through the variable
// environment (`HashMap[Str, Value]`) and the `Vec[Value]` argument lists: a read
// back out of the map / vec copies the owned value (Vestra enums are
// copy-constructible), so the heap payload survives being stored and re-read.

enum Tok {
    case num
    case strlit
    case ident
    case kwFn
    case kwIf
    case kwThen
    case kwElse
    case kwWhile
    case kwDo
    case kwPrint
    case kwTrue
    case kwFalse
    case plus
    case minus
    case star
    case slash
    case lt
    case gt
    case eq
    case lparen
    case rparen
    case lbrace
    case rbrace
    case comma
    case assign
    case semicolon
    case end
    case bad
}

struct Token {
    let kind: Tok
    let value: Int
    let name: Str
}

enum Value {
    case int(Int)
    case boolean(Bool)
    case str(String)
}

// ---- value helpers ---------------------------------------------------------

func strOf(_ s: Str) using Alloc -> String {
    var out: String = ""
    out.append(s)
    return out
}

func boolStr(_ b: Bool) using Alloc -> String {
    if b {
        var t: String = "true"
        return t
    }
    var f: String = "false"
    return f
}

// Render a value by its tag (also the rendering used when concatenating).
func format(_ v: Value) using Alloc -> String {
    return match v {
        case .int(let n): n.toString()
        case .boolean(let b): boolStr(b)
        case .str(let s): strOf(s)
    }
}

// Coerce to an integer for arithmetic (a bool is 1/0, a string is 0).
func asInt(_ v: Value) -> Int {
    return match v {
        case .int(let n): n
        case .boolean(let b): if b { 1 } else { 0 }
        case .str(let s): 0
    }
}

// Truthiness for `if` / `while`: a nonzero int, a true bool, or any string.
func truthy(_ v: Value) -> Bool {
    return match v {
        case .int(let n): n != 0
        case .boolean(let b): b
        case .str(let s): true
    }
}

// Does this value carry a string payload? (selects `+` concatenation vs add).
func isStr(_ v: Value) -> Bool {
    return match v {
        case .int(let n): false
        case .boolean(let b): false
        case .str(let s): true
    }
}

// Structural equality: same tag and equal payload; cross-type is never equal.
func valEq(_ a: Value, _ b: Value) -> Bool {
    return match a {
        case .int(let x): match b {
            case .int(let y): x == y
            default: false
        }
        case .boolean(let x): match b {
            case .boolean(let y): x == y
            default: false
        }
        case .str(let x): match b {
            case .str(let y): x == y
            default: false
        }
    }
}

// ---- lexer -----------------------------------------------------------------

func punct(_ c: Char) -> Tok {
    if c == '+' { return .plus }
    if c == '-' { return .minus }
    if c == '*' { return .star }
    if c == '/' { return .slash }
    if c == '<' { return .lt }
    if c == '>' { return .gt }
    if c == '(' { return .lparen }
    if c == ')' { return .rparen }
    if c == '{' { return .lbrace }
    if c == '}' { return .rbrace }
    if c == ',' { return .comma }
    if c == '=' { return .assign }
    if c == ';' { return .semicolon }
    return .bad
}

func wordKind(_ nm: Str) -> Tok {
    return match nm {
        case "fn": .kwFn
        case "if": .kwIf
        case "then": .kwThen
        case "else": .kwElse
        case "while": .kwWhile
        case "do": .kwDo
        case "print": .kwPrint
        case "true": .kwTrue
        case "false": .kwFalse
        default: .ident
    }
}

func lex(_ s: Str) using Alloc -> Vec[Token] {
    var toks: Vec[Token] = Vec.new()
    var i: Int = 0
    while i < s.len() {
        let c = s.charAt(i) ?? ' '
        if c.isSpace() {
            i = i + 1
        } else if c.isDigit() {
            let start = i
            while i < s.len() && (s.charAt(i) ?? ' ').isDigit() {
                i = i + 1
            }
            let v = s.slice(start, i).toInt() ?? 0
            toks.push(Token(kind: .num, value: v, name: ""))
        } else if c == '"' {
            i = i + 1  // skip opening quote
            let start = i
            while i < s.len() && (s.charAt(i) ?? '"') != '"' {
                i = i + 1
            }
            let lit = s.slice(start, i)
            i = i + 1  // skip closing quote
            toks.push(Token(kind: .strlit, value: 0, name: lit))
        } else if c.isAlpha() {
            let start = i
            while i < s.len() && (s.charAt(i) ?? ' ').isAlnum() {
                i = i + 1
            }
            let nm = s.slice(start, i)
            toks.push(Token(kind: wordKind(nm), value: 0, name: nm))
        } else if c == '=' && (s.charAt(i + 1) ?? ' ') == '=' {
            toks.push(Token(kind: .eq, value: 0, name: ""))
            i = i + 2
        } else {
            toks.push(Token(kind: punct(c), value: 0, name: ""))
            i = i + 1
        }
    }
    toks.push(Token(kind: .end, value: 0, name: ""))
    return toks
}

func peekKind(_ ts: Vec[Token], _ i: Int) -> Tok {
    if let t = ts.get(i) {
        return t.kind
    }
    return Tok.end
}

func peekVal(_ ts: Vec[Token], _ i: Int) -> Int {
    if let t = ts.get(i) {
        return t.value
    }
    return 0
}

func peekName(_ ts: Vec[Token], _ i: Int) -> Str {
    if let t = ts.get(i) {
        return t.name
    }
    return ""
}

// ---- expression layer (reads the environment, produces a Value) ------------

func callFunc(_ ts: Vec[Token], _ name: Str, _ args: Vec[Value],
              _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int]) using Alloc -> Value {
    if let start = fbody.get(name) {
        if let params = fparams.get(name) {
            var callEnv: HashMap[Str, Value] = HashMap.new()
            var j: Int = 0
            while j < params.len() && j < args.len() {
                callEnv.set(params.get(j) ?? "", args.get(j) ?? Value.int(0))
                j = j + 1
            }
            var bi: Int = start
            return pExpr(ts, &bi, callEnv, fparams, fbody, true)
        }
    }
    return Value.int(0)
}

func pFactor(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
             _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    let k = peekKind(ts, i)
    if k == Tok.num {
        let v = peekVal(ts, i)
        i = i + 1
        return Value.int(v)
    }
    if k == Tok.strlit {
        let s = peekName(ts, i)
        i = i + 1
        return Value.str(strOf(s))
    }
    if k == Tok.kwTrue {
        i = i + 1
        return Value.boolean(true)
    }
    if k == Tok.kwFalse {
        i = i + 1
        return Value.boolean(false)
    }
    if k == Tok.ident {
        let name = peekName(ts, i)
        if peekKind(ts, i + 1) == Tok.lparen {
            i = i + 2
            var args: Vec[Value] = Vec.new()
            if peekKind(ts, i) != Tok.rparen {
                args.push(pExpr(ts, &i, env, fparams, fbody, live))
                while peekKind(ts, i) == Tok.comma {
                    i = i + 1
                    args.push(pExpr(ts, &i, env, fparams, fbody, live))
                }
            }
            i = i + 1
            if live {
                return callFunc(ts, name, args, fparams, fbody)
            }
            return Value.int(0)
        }
        i = i + 1
        if live {
            return env.get(name) ?? Value.int(0)
        }
        return Value.int(0)
    }
    if k == Tok.lparen {
        i = i + 1
        let v = pExpr(ts, &i, env, fparams, fbody, live)
        i = i + 1
        return v
    }
    i = i + 1
    return Value.int(0)
}

func pTerm(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
           _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    let first = pFactor(ts, &i, env, fparams, fbody, live)
    let k0 = peekKind(ts, i)
    // Only when a `*` / `/` follows does this collapse to an integer; otherwise
    // the factor's value (and its type) is preserved.
    if k0 == Tok.star || k0 == Tok.slash {
        var acc: Int = asInt(first)
        var more: Bool = true
        while more {
            let k = peekKind(ts, i)
            if k == Tok.star {
                i = i + 1
                acc = acc * asInt(pFactor(ts, &i, env, fparams, fbody, live))
            } else if k == Tok.slash {
                i = i + 1
                let d = asInt(pFactor(ts, &i, env, fparams, fbody, live))
                if d != 0 {
                    acc = acc / d
                } else {
                    acc = 0
                }
            } else {
                more = false
            }
        }
        return Value.int(acc)
    }
    return first
}

func pSum(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    let first = pTerm(ts, &i, env, fparams, fbody, live)
    let k0 = peekKind(ts, i)
    // String-led `+`: if the left operand is a string, the whole run of `+`s
    // concatenates, each operand rendered by its tag. This builds a fresh,
    // *owned* String — the first heap-owned value the interpreter produces.
    if k0 == Tok.plus && isStr(first) {
        var acc: String = format(first)
        var more: Bool = true
        while more {
            let k = peekKind(ts, i)
            if k == Tok.plus {
                i = i + 1
                let r = pTerm(ts, &i, env, fparams, fbody, live)
                acc.append(format(r))
            } else {
                more = false
            }
        }
        return Value.str(acc)
    }
    if k0 == Tok.plus || k0 == Tok.minus {
        var acc: Int = asInt(first)
        var more: Bool = true
        while more {
            let k = peekKind(ts, i)
            if k == Tok.plus {
                i = i + 1
                acc = acc + asInt(pTerm(ts, &i, env, fparams, fbody, live))
            } else if k == Tok.minus {
                i = i + 1
                acc = acc - asInt(pTerm(ts, &i, env, fparams, fbody, live))
            } else {
                more = false
            }
        }
        return Value.int(acc)
    }
    return first
}

// cmp = sum (('<' | '>') sum)?  -> a boolean Value
func pCmp(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    let a = pSum(ts, &i, env, fparams, fbody, live)
    let k = peekKind(ts, i)
    if k == Tok.lt {
        i = i + 1
        let b = pSum(ts, &i, env, fparams, fbody, live)
        return Value.boolean(asInt(a) < asInt(b))
    }
    if k == Tok.gt {
        i = i + 1
        let b = pSum(ts, &i, env, fparams, fbody, live)
        return Value.boolean(asInt(a) > asInt(b))
    }
    return a
}

// eq = cmp ('==' cmp)?  -> a boolean Value (structural, across types)
func pEq(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
         _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    let a = pCmp(ts, &i, env, fparams, fbody, live)
    if peekKind(ts, i) == Tok.eq {
        i = i + 1
        let b = pCmp(ts, &i, env, fparams, fbody, live)
        return Value.boolean(valEq(a, b))
    }
    return a
}

// expr = 'if' expr 'then' expr 'else' expr | eq. The branches may have different
// value types; the taken one is returned.
func pExpr(_ ts: Vec[Token], _ i: inout Int, _ env: HashMap[Str, Value],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc -> Value {
    if peekKind(ts, i) == Tok.kwIf {
        i = i + 1
        let c = pEq(ts, &i, env, fparams, fbody, live)
        let taken = truthy(c)
        if peekKind(ts, i) == Tok.kwThen {
            i = i + 1
        }
        let t = pExpr(ts, &i, env, fparams, fbody, live && taken)
        if peekKind(ts, i) == Tok.kwElse {
            i = i + 1
        }
        let e = pExpr(ts, &i, env, fparams, fbody, live && !taken)
        if taken {
            return t
        }
        return e
    }
    return pEq(ts, &i, env, fparams, fbody, live)
}

// ---- statement layer (mutates the environment, may print) ------------------

func pBlock(_ ts: Vec[Token], _ i: inout Int, _ env: inout HashMap[Str, Value],
            _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc, Log -> Value {
    i = i + 1  // consume '{'
    var last: Value = Value.int(0)
    var more: Bool = true
    while more {
        let k = peekKind(ts, i)
        if k == Tok.rbrace || k == Tok.end {
            more = false
        } else {
            last = pStmt(ts, &i, &env, fparams, fbody, live)
            if peekKind(ts, i) == Tok.semicolon {
                i = i + 1
            }
        }
    }
    if peekKind(ts, i) == Tok.rbrace {
        i = i + 1  // consume '}'
    }
    return last
}

// stmt = 'while' expr 'do' stmt | 'print' expr | block | ident '=' expr | expr
func pStmt(_ ts: Vec[Token], _ i: inout Int, _ env: inout HashMap[Str, Value],
          _ fparams: HashMap[Str, Vec[Str]], _ fbody: HashMap[Str, Int], _ live: Bool) using Alloc, Log -> Value {
    let k = peekKind(ts, i)
    if k == Tok.kwWhile {
        i = i + 1
        let condStart = i
        let cskip = pExpr(ts, &i, env, fparams, fbody, false)
        if peekKind(ts, i) == Tok.kwDo {
            i = i + 1
        }
        let bodyStart = i
        let bskip = pStmt(ts, &i, &env, fparams, fbody, false)
        let afterBody = i
        if live {
            var ci: Int = condStart
            var c: Value = pExpr(ts, &ci, env, fparams, fbody, true)
            var guard: Int = 0
            while truthy(c) && guard < 1000000 {
                var bi: Int = bodyStart
                let rb = pStmt(ts, &bi, &env, fparams, fbody, true)
                ci = condStart
                c = pExpr(ts, &ci, env, fparams, fbody, true)
                guard = guard + 1
            }
        }
        i = afterBody
        return Value.int(0)
    }
    if k == Tok.kwPrint {
        i = i + 1  // consume 'print'
        let v = pExpr(ts, &i, env, fparams, fbody, live)
        if live {
            println(format(v))
        }
        return v
    }
    if k == Tok.lbrace {
        return pBlock(ts, &i, &env, fparams, fbody, live)
    }
    if k == Tok.ident && peekKind(ts, i + 1) == Tok.assign {
        let name = peekName(ts, i)
        i = i + 2
        let v = pExpr(ts, &i, env, fparams, fbody, live)
        if live {
            env.set(name, v)
        }
        return Value.int(0)
    }
    return pExpr(ts, &i, env, fparams, fbody, live)
}

// ---- the program driver ----------------------------------------------------

func runProgram(_ s: Str) using Alloc, Log -> Value {
    let toks = lex(s)
    var env: HashMap[Str, Value] = HashMap.new()
    var fparams: HashMap[Str, Vec[Str]] = HashMap.new()
    var fbody: HashMap[Str, Int] = HashMap.new()
    var i: Int = 0
    var last: Value = Value.int(0)
    var more: Bool = true
    while more {
        let k = peekKind(toks, i)
        if k == Tok.end {
            more = false
        } else if k == Tok.kwFn {
            i = i + 1
            let name = peekName(toks, i)
            i = i + 2
            var params: Vec[Str] = Vec.new()
            if peekKind(toks, i) != Tok.rparen {
                params.push(peekName(toks, i))
                i = i + 1
                while peekKind(toks, i) == Tok.comma {
                    i = i + 1
                    params.push(peekName(toks, i))
                    i = i + 1
                }
            }
            i = i + 1
            i = i + 1
            let bodyStart = i
            let skip = pExpr(toks, &i, env, fparams, fbody, false)
            fparams.set(name, params)
            fbody.set(name, bodyStart)
        } else {
            last = pStmt(toks, &i, &env, fparams, fbody, true)
        }
        if peekKind(toks, i) == Tok.semicolon {
            i = i + 1
        }
    }
    return last
}

// ---- the executable: read a program file and run it ------------------------

func main() -> Int32 {
    with Alloc {
        with Fs {
            with Log {
                let argv = args()
                if argv.len() < 2 {
                    eprintln("usage: interp_concat <program-file>")
                    return 1
                }
                let path = argv.get(1) ?? ""
                if let src = readFile(path) {
                    let result = runProgram(src)
                    print("result: ")
                    println(format(result))
                    return 0
                }
                eprintln("cannot read program file")
                return 1
            }
        }
    }
}
