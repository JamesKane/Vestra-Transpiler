// §17.4 `with NAME = EXPR { ... }` value binding. The block scopes
// the binding to its body — the name is in scope inside the braces
// and goes out of scope when the block ends. C++ lowering is a
// straightforward `{ auto&& NAME = EXPR; ... }` sub-scope.
//
// Distinct from the cap-typed forms (`with Alloc { ... }` for marker,
// `with Alloc = myAllocator { ... }` for satisfaction with value) —
// the parser disambiguates by the leading identifier's first letter
// (lowercase ⇒ name, uppercase ⇒ type), following Vestra's casing
// convention.
//
// The annex's MMIO views and DMA-descriptor patterns build on this
// shape (a typed view minted from a raw pointer, scoped to a block
// for the duration of the operation). v0.5 is the language primitive;
// the kernel-side library shapes layer on top.

module examples.with_binding

struct Region {
    var base: Int32
    var size: Int32
}

derive(Eq) for Region

func makeRegion(_ base: Int32, _ size: Int32) -> Region {
    return Region(base: base, size: size)
}

// The classic shape: bind a resource, use it, and let the binding go
// out of scope when the block ends. Inside the block, `r` is the
// resource's value type (the &&-binding keeps the lifetime to the
// block's brace; lifetime-extension rules on temporary objects apply
// per the C++ standard).
func totalSize() -> Int32 {
    var total: Int32 = 0
    with r = makeRegion(0x1000, 256) {
        total = total + r.size
    }
    with r = makeRegion(0x2000, 128) {
        total = total + r.size
    }
    return total
}

// Nested with-bindings — outer's name is in scope for the inner block.
func nested(_ a: Int32, _ b: Int32) -> Int32 {
    with outer = makeRegion(a, 10) {
        with inner = makeRegion(b, 20) {
            return outer.size + inner.size + outer.base + inner.base
        }
    }
}

// Type-annotated bindings: `with NAME: T = EXPR { ... }`. The
// annotation pins the binding's declared type at the C++ layer
// instead of the `auto&&`'s inferred form. Useful when:
//   - the expression is an integer literal whose width should
//     match the slot type (annotation pushes the expected type
//     down so `42` adopts `UInt64` instead of defaulting to `Int`),
//   - the user wants the binding's type visible at the source
//     for readability across longer blocks,
//   - sema should reject a value whose type doesn't match the
//     intent.
func annotated() -> Int32 {
    with size: Int32 = 100 {
        with width: Int32 = 32 {
            return size / width
        }
    }
}
