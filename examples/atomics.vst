// §A4 (§14.9) — `Atomic[T]` memory model, first slice.
//
// `Atomic[T]` is a compiler-known wrapper that lowers directly to
// `std::atomic<T>`. v0.5 supports primitive T (Int*/UInt*/Float*/
// Bool/Char) only — non-primitive payloads belong in Mutex/RwLock.
//
// The five orderings come from a builtin `Ordering` enum that
// lowers to `std::memory_order`; the cases map straight to the
// matching C++ name (`.acqRel` → `memory_order_acq_rel`, etc.).
//
// The core ops landed in this phase:
//   load, store, exchange, fetchAdd, fetchSub,
//   fetchAnd, fetchOr, fetchXor, compareExchange (strong)
//
// All take an `Ordering` argument explicitly in v0.5 — the spec's
// default-`.seqCst` ergonomic waits on synthetic-method default
// args. The kernel pattern of "say what you mean about memory
// ordering, every time" reads naturally enough that the missing
// default doesn't bite for the load-bearing call sites.
//
// `compareExchangeWeak` + the `@retry_loop` shape rule wait on a
// follow-up; they need a separate sema pass to enforce the loop
// shape predicate.

module examples.atomics

static counter: Atomic[UInt32] = 0
static flag:    Atomic[Bool]   = false

// Reset, bump by 7 (returning the previous value, which should be
// the post-reset 0), then re-read. The driver checks the final
// state — both the bump-result and the post-bump load.
func bump() -> UInt32 {
    counter.store(0, .release)
    let prev = counter.fetchAdd(7, .acqRel)
    let v = counter.load(.acquire)
    return prev + v
}

// Decrement back to 0 via fetchSub. Verifies the rename to
// std::atomic's snake_case `fetch_sub`.
func drain() -> UInt32 {
    let prev = counter.fetchSub(7, .release)
    return prev
}

// Exchange returns the prior value. .seqCst is the right default
// when you don't want to think about ordering — write it
// explicitly here so the call shape is clear in the e2e output.
func swap(_ v: UInt32) -> UInt32 {
    return counter.exchange(v, .seqCst)
}

// Atomic[Bool] exercises the primitive-T constraint with a
// non-integer; .relaxed is admitted on both load and store.
func raise() {
    flag.store(true, .relaxed)
}

func lowered() -> Bool {
    return flag.load(.relaxed) == false
}

// §A4 (§14.9.3) compareExchange returns CASResult[T] — a struct with
// `succeeded: Bool` and `actual: T`. The strong form succeeds iff
// the current value equals `expected`; on success it writes
// `desired` and `.actual` is the prior value; on failure it leaves
// the atomic unchanged and `.actual` is the observed current value.
static cas_target: Atomic[UInt32] = 0

func cas_success(_ desired: UInt32) -> UInt32 {
    let r = cas_target.compareExchange(0, desired, .seqCst, .acquire)
    if r.succeeded {
        return r.actual
    }
    return r.actual + 1000  // sentinel: shouldn't trip on success path
}

func cas_failure(_ wrong: UInt32, _ desired: UInt32) -> UInt32 {
    let r = cas_target.compareExchange(wrong, desired, .seqCst, .acquire)
    if r.succeeded {
        return 0
    }
    // On failure, .actual reports the observed value.
    return r.actual
}

// §A4 (§14.9.2) bitwise fetch ops. fetchAnd/Or/Xor return the
// pre-op value; the result is the new value formed by the op.
// Lowers to std::atomic's fetch_and / fetch_or / fetch_xor.
static bits: Atomic[UInt32] = 0

func bitwise_chain() -> UInt32 {
    bits.store(0xF0, .release)
    let a = bits.fetchOr(0x0F, .acqRel)    // 0xF0 → 0xFF, returns 0xF0
    let b = bits.fetchAnd(0xFE, .acqRel)   // 0xFF → 0xFE, returns 0xFF
    let c = bits.fetchXor(0x01, .acqRel)   // 0xFE → 0xFF, returns 0xFE
    let final = bits.load(.acquire)        // 0xFF
    return a + b + c + final               // 0xF0 + 0xFF + 0xFE + 0xFF = 0x3EC
}
